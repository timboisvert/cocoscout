<%# The uploader itself, the same on the request's no-login page and on My
    Contracts (Tim, 2026-11-19): the progress line, then a card per image in
    the organization's order, then the written items.
    Locals: assets, counts, organization, upload_url, text_url, can_replace,
    ask_name (whether to ask a signed-out visitor for their name). %>
<div class="space-y-8" data-asset-request-page>
  <%= render "asset_requests/progress", counts: counts, organization: organization %>

  <% if local_assigns[:ask_name] %>
    <div class="max-w-md">
      <label for="asset-uploader-name" class="block text-sm font-medium text-gray-700 mb-1">Your name</label>
      <input type="text" id="asset-uploader-name" maxlength="80" autocomplete="name" value="<%= session[:asset_uploader_name] %>"
             class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-base sm:text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
      <p class="text-xs text-gray-500 mt-1">So <%= organization.name %> knows who sent what.</p>
    </div>
  <% end %>

  <% if assets.image_specs.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <% assets.image_specs.each do |spec| %>
        <%= render "asset_requests/card", item: assets.item(spec), upload_url: upload_url, can_replace: can_replace, organization: organization %>
      <% end %>
    </div>
  <% end %>

  <% if assets.text_specs.any? %>
    <div class="space-y-5">
      <% assets.text_specs.each do |spec| %>
        <%= render "asset_requests/text_card", item: assets.item(spec), text_url: text_url, can_replace: can_replace, organization: organization %>
      <% end %>
    </div>
  <% end %>
</div>
