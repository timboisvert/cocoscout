<%#
  The action-card grid (icon + title + description) used by shared/module_header,
  and reusable on its own — e.g. under a breadcrumb without the big title.

  Locals:
    actions: array of { icon:, text:, description:, path:, data:, badge:, locked:, feature: }
%>
<% actions ||= [] %>
<% if actions.any? %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <% actions.each do |action| %>
      <% action_data = action[:data] || {} %>
      <% if action[:locked] && action[:feature].present? %>
        <% action_data = action_data.merge(action: "click->upgrade-modal#open", upgrade_feature: action[:feature]) %>
      <% end %>
      <%= link_to action[:path], class: "relative flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors border border-gray-200#{action[:locked] ? ' opacity-90' : ''}", data: action_data do %>
        <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center flex-shrink-0">
          <%= render "shared/module_header_icon", icon: action[:icon] %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="font-medium text-gray-900 flex items-center gap-1.5">
            <%= action[:text] %>
            <% if action[:badge].to_i.positive? %>
              <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full bg-pink-600 text-white text-[11px] font-semibold leading-none"><%= action[:badge] %></span>
            <% end %>
            <% if action[:locked] %>
              <svg class="w-3.5 h-3.5 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-label="Pro feature"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" /></svg>
            <% end %>
          </div>
          <% if action[:description].present? %>
            <div class="text-xs text-gray-500 truncate"><%= action[:locked] ? "Pro" : action[:description] %></div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
