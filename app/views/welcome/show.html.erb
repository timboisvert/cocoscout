<%# The Android app and the next iPhone build show no bar here
    (barlessPaths); the iPhone build in review (1.0, build 5) titles it this. %>
<% content_for :title, "Welcome" %>
<%
  points = [
    [ "Your calendar and call times", "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" ],
    [ "Messages from your productions", "M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" ],
    [ "Working the box office: scan and sell tickets", "M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" ]
  ]
%>
<div class="-mx-4 -mt-3 -mb-8 px-6 pt-10 pb-8 min-h-[100dvh] flex flex-col bg-gradient-to-b from-pink-50 via-white to-[#f9f9f7]">
  <div class="flex-1 flex flex-col items-center text-center">
    <%= render "shared/cocoscout_logo", size: :large %>
    <h1 class="mt-4 text-4xl coustard-regular text-pink-500">CocoScout</h1>
    <p class="mt-3 text-lg text-slate-700 max-w-xs">Your shows, your messages, your tickets. All in one place.</p>

    <ul class="mt-8 w-full max-w-sm space-y-3 text-left">
      <% points.each do |text, path| %>
        <li class="flex items-center gap-3 rounded-xl bg-white border border-pink-100 px-4 py-3 shadow-sm">
          <span class="flex-shrink-0 w-10 h-10 rounded-lg bg-pink-50 text-pink-600 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= path %>"/></svg>
          </span>
          <span class="text-sm font-medium text-slate-900"><%= text %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="mt-10 w-full max-w-sm mx-auto space-y-3">
    <%= render "shared/button", text: "Sign in", variant: "primary", size: "large", path: signin_path, classes: "w-full justify-center" %>
    <%= render "shared/button", text: "Create an account", variant: "secondary", size: "large", path: signup_path, classes: "w-full justify-center" %>
    <p class="pt-2 text-xs text-slate-500 text-center">Got an invitation? Open the link in your email and it'll bring you here.</p>
  </div>
</div>
