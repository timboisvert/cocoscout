<%# THE dismissible intro guide for teaching a module at a high level.
    Educational, not an alarm — don't use shared/_alert_panel for this, and
    don't invent another "here's how this works" box.

    Locals:
      guide_key       (required) — key in Manage::GuidesController::GUIDE_KEYS;
                                   drives per-user visibility + dismiss/restore.
      title           (required) — one line, e.g. "How casting works"
      body            (required) — html_safe fragment: a short paragraph and/or
                                   an ordered list of steps. Room here later for
                                   an embedded walkthrough video (video_url).
      actions         (optional) — array of hashes handed to shared/button
                                   (text:, path:, ...). First is pink, rest secondary.
      cards           (optional) — array of { icon:, text:, description:, path: }
                                   rendered as the boxed shared/module_actions
                                   grid. Use instead of (or after) a step list
                                   when the guide is a launchpad, not a how-to.
      variant         (optional) — "standard" (default) or "welcome": bigger
                                   coustard title on a soft pink wash, for the
                                   home-page greeting.
      default_visible (optional, default true) — what users with no stored
                                   state see.

    States (per user, users.dismissed_guides): visible -> the panel with a
    dismiss X; explicitly dismissed -> a tiny right-aligned "Show guide" link;
    default-hidden with no state -> nothing at all. %>
<%
  guide_key       = local_assigns.fetch(:guide_key).to_s
  title           = local_assigns.fetch(:title)
  body            = local_assigns.fetch(:body)
  actions         = local_assigns.fetch(:actions, [])
  cards           = local_assigns.fetch(:cards, [])
  variant         = local_assigns.fetch(:variant, "standard")
  default_visible = local_assigns.fetch(:default_visible, true)
  welcome         = variant == "welcome"

  panel_classes = if welcome
    "mb-8 rounded-xl border border-pink-200 bg-gradient-to-br from-pink-50 via-white to-white p-6 sm:p-8 shadow-sm"
  else
    "mb-6 rounded-lg border border-gray-200 border-l-4 border-l-pink-400 bg-white p-5 shadow-sm"
  end
  title_classes = welcome ? "text-2xl sm:text-3xl coustard-regular text-gray-900" : "text-lg font-semibold text-gray-900"
  body_classes  = welcome ? "mt-3 text-base text-gray-600 max-w-3xl" : "mt-2 text-sm text-gray-600 max-w-3xl"
%>
<% if Current.user.guide_visible?(guide_key, default_visible: default_visible) %>
  <div data-intro-guide="<%= guide_key %>" class="<%= panel_classes %>">
    <div class="flex items-start justify-between gap-4">
      <h2 class="<%= title_classes %>"><%= title %></h2>
      <%= button_to manage_guide_dismiss_path(guide_key), method: :post,
            class: "flex-shrink-0 text-gray-400 hover:text-gray-600 cursor-pointer p-1 -m-1",
            title: "Dismiss this guide", "aria-label": "Dismiss this guide" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      <% end %>
    </div>
    <div class="<%= body_classes %> [&_p]:mb-2 [&_ol]:list-decimal [&_ol]:my-3 [&_ol]:pl-5 [&_ol]:space-y-1 [&_li]:pl-1">
      <%= body %>
    </div>
    <% if cards.any? %>
      <div class="mt-5">
        <%= render "shared/module_actions", actions: cards %>
      </div>
    <% end %>
    <% if actions.any? %>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <% actions.each_with_index do |action, i| %>
          <%= render "shared/button", { variant: i.zero? ? "primary" : "secondary", size: "small" }.merge(action) %>
        <% end %>
      </div>
    <% end %>
  </div>
<% elsif Current.user.guide_dismissed?(guide_key) %>
  <div class="mb-2 flex justify-end">
    <%= button_to manage_guide_restore_path(guide_key), method: :post,
          class: "text-xs text-gray-400 hover:text-pink-600 cursor-pointer" do %>
      Show guide: <%= title %>
    <% end %>
  </div>
<% end %>
