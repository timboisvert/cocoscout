<% content_for :title, @contract.production_name.presence || @contract.contractor_name %>

<div class="w-full mb-10" data-controller="modal">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%# Status badge helper — e-sign signing states take precedence over the raw
     draft status so a sent contract reads "Awaiting Signature", not "Contract". %>
  <%
    status_badge =
      if @contract.signing_out_for_signature?
        { bg: "bg-amber-100", text: "text-amber-800", icon: "clock", label: "Awaiting Signature" }
      elsif @contract.signing_awaiting_send?
        { bg: "bg-blue-100", text: "text-blue-800", icon: "envelope", label: "Ready to Send" }
      else
        case @contract.status
        when "active"
          { bg: "bg-green-100", text: "text-green-800", icon: "check-circle", label: "Active" }
        when "completed"
          { bg: "bg-blue-100", text: "text-blue-800", icon: "check", label: "Completed" }
        when "cancelled"
          { bg: "bg-red-100", text: "text-red-800", icon: "x-circle", label: "Cancelled" }
        else
          { bg: "bg-gray-100", text: "text-gray-700", icon: "file-text", label: "Contract" }
        end
      end

    # Build breadcrumbs with optional contractor link
    breadcrumb_items = [
      ["Contracts", manage_contracts_path]
    ]
    if @contract.contractor.present?
      breadcrumb_items << [@contract.contractor_name, manage_contractor_path(@contract.contractor)]
    end
  %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: breadcrumb_items,
    text: @contract.production_name.presence || @contract.contractor_name,
    links: []
  } %>

  <%# Signing status banner — this contract isn't active yet; read-only until signed. %>
  <% if @contract.signing_out_for_signature? %>
    <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 flex items-start gap-3">
      <%= icon("clock", class: "w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5") %>
      <div class="text-sm text-amber-900">
        <p class="font-semibold">Awaiting signature — not active yet</p>
        <p class="mt-0.5">This contract is out for <%= @contract.contractor_name %> to review and sign. You can see everything here, but it can't be amended until it's signed. Need to change something? Revoke it in the <span class="font-medium">Signature</span> panel, make your edits, and send it again.</p>
      </div>
    </div>
  <% elsif @contract.signing_awaiting_send? %>
    <div class="mb-6 rounded-lg border border-blue-200 bg-blue-50 p-4 flex items-start gap-3">
      <%= icon("envelope", class: "w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5") %>
      <div class="text-sm text-blue-900">
        <p class="font-semibold">Signed by you — ready to send</p>
        <p class="mt-0.5">You've signed this contract. Send it to <%= @contract.contractor_name %> to sign, from the <span class="font-medium">Signature</span> panel.</p>
      </div>
    </div>
  <% end %>

  <%# Status and date info - show_row style %>
  <div class="flex items-stretch px-3 py-3 border border-gray-200 rounded-lg bg-white mb-6">
    <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-0 w-full">
      <%# Left: Date Box %>
      <div class="w-full md:w-1/3 flex items-center gap-4">
        <% if @contract.contract_start_date.present? %>
          <div class="flex-shrink-0 w-14 flex items-center gap-1.5">
            <span class="text-xl leading-none font-bold text-gray-900"><%= @contract.contract_start_date.strftime("%-d") %></span>
            <span class="text-[10px] leading-tight uppercase">
              <span class="block font-semibold text-pink-600"><%= @contract.contract_start_date.strftime("%b") %></span>
              <span class="block text-gray-500"><%= @contract.contract_start_date.strftime("%Y") %></span>
            </span>
          </div>
        <% end %>
        <div class="flex-1">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_badge[:bg] %> <%= status_badge[:text] %>">
              <%= icon(status_badge[:icon], class: "w-3 h-3 mr-1") %>
              <%= status_badge[:label] %>
            </span>
          </div>
          <% if @contract.date_range %>
            <div class="text-sm text-gray-600 mt-1"><%= @contract.date_range %></div>
          <% end %>
        </div>
      </div>

      <%# Middle: Contract Info %>
      <div class="w-full md:w-1/3 md:border-l md:border-gray-200 md:pl-4 mt-2 md:mt-0 pt-2 md:pt-0 border-t md:border-t-0">
        <div class="text-xs text-gray-400 uppercase tracking-wide">Contract Period</div>
        <div class="text-sm text-gray-700 mt-1">
          <% if @contract.contract_start_date && @contract.contract_end_date %>
            <%= (@contract.contract_end_date - @contract.contract_start_date).to_i + 1 %> days
          <% else %>
            Not set
          <% end %>
        </div>
      </div>

      <%# Right: what this contract made us vs cost us (gross model — for a
          rev-share where we sell, "made" is the ticket revenue on its shows and
          "cost" is the contractor's share; a rental just shows the rent in). %>
      <% money = @contract.money_display %>
      <div class="w-full md:w-1/3 md:border-l md:border-gray-200 md:pl-4 mt-2 md:mt-0 pt-2 md:pt-0 border-t md:border-t-0">
        <div class="text-xs text-gray-400 uppercase tracking-wide">This Contract</div>
        <div class="mt-1 flex items-baseline gap-3 flex-wrap">
          <span class="text-sm"><span class="text-gray-500">Made</span> <span class="font-bold text-green-600 tabular-nums"><%= number_to_currency(money[:made]) %></span></span>
          <span class="text-sm"><span class="text-gray-500">Cost</span> <span class="font-bold <%= money[:cost] > 0 ? 'text-red-600' : 'text-gray-400' %> tabular-nums"><%= number_to_currency(money[:cost]) %></span></span>
        </div>
        <div class="text-sm mt-0.5">
          <span class="text-gray-500">Net</span>
          <span class="font-bold <%= money[:net] >= 0 ? 'text-green-600' : 'text-red-600' %> tabular-nums"><%= number_to_currency(money[:net]) %></span>
          <% if money[:pending_shows] > 0 %>
            <span class="text-[11px] text-amber-600">· <%= pluralize(money[:pending_shows], "show") %> awaiting financials</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Main content %>
    <div class="lg:col-span-2 space-y-6">
      <%# Contractor Info %>
      <div class="border border-gray-200 rounded-lg overflow-hidden">
        <%= render "shared/card_header", title: "Contractor Information" %>
        <div class="p-4">
          <dl class="grid grid-cols-2 gap-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Company</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @contract.contractor.present? %>
                  <%= link_to @contract.contractor_name, manage_contractor_path(@contract.contractor), class: "text-pink-600 hover:text-pink-700" %>
                <% else %>
                  <%= @contract.contractor_name %>
                <% end %>
              </dd>
            </div>
            <% if @contract.production_name.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Production</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @contract.production_name %></dd>
              </div>
            <% end %>
            <% if @contract.contractor_email.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Email</dt>
                <dd class="mt-1 text-sm text-gray-900">
                  <%= mail_to @contract.contractor_email, class: "text-pink-600 hover:text-pink-700" %>
                </dd>
              </div>
            <% end %>
            <% if @contract.contractor_phone.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Phone</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @contract.contractor_phone %></dd>
              </div>
            <% end %>
            <% if @contract.contractor_address.present? %>
              <div class="col-span-2">
                <dt class="text-sm font-medium text-gray-500">Address</dt>
                <dd class="mt-1 text-sm text-gray-900 whitespace-pre-line"><%= @contract.contractor_address %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>

      <%# Ticketing %>
      <% tiers = (@ticketing["tiers"] || []) %>
      <% discounts = Contract.ticketing_discounts(@ticketing) %>
      <% if tiers.any? || discounts.any? %>
        <div class="border border-gray-200 rounded-lg overflow-hidden">
          <%= render "shared/card_header", title: "Ticketing" %>
          <div class="p-4">
            <% if tiers.any? %>
              <ul class="divide-y divide-gray-100">
                <% tiers.each do |tier| %>
                  <li class="flex items-center justify-between py-2 text-sm">
                    <span class="text-gray-900"><%= tier["name"] %></span>
                    <span class="font-medium text-gray-900"><%= number_to_currency(tier["price"]) %></span>
                  </li>
                <% end %>
              </ul>
            <% end %>
            <% discounts.each do |discount| %>
              <p class="text-sm text-gray-600 mt-3">
                Discount <span class="font-medium text-gray-900"><%= discount["code"] %></span>:
                <%= discount["amount_type"] == "percent" ? "#{discount["amount"]}% off" : "#{number_to_currency(discount["amount"])} off" %>
                <%= discount["applies_to"] == "specific" ? "(#{(discount["tier_names"] || []).join(", ")})" : "(all tickets)" %>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Tech %>
      <% if @tech["provider"].present? %>
        <div class="border border-gray-200 rounded-lg overflow-hidden">
          <%= render "shared/card_header", title: "Tech" %>
          <div class="p-4 text-sm">
            <% if @tech["provider"] == "us" %>
              <p class="text-gray-900">
                We provide tech:
                <span class="font-medium"><%= @tech["hours"] %> hr × <%= number_to_currency(@tech["hourly_rate"]) %>
                = <%= number_to_currency(@tech["hours"].to_f * @tech["hourly_rate"].to_f) %></span>
              </p>
              <p class="text-gray-600 mt-1">
                <%= @tech["payment_method"] == "from_cut" ? "Taken out of their cut" : "Paid in cash" %>
              </p>
            <% else %>
              <p class="text-gray-900">Contractor provides their own tech.</p>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Bookings %>
      <div class="border border-gray-200 rounded-lg overflow-hidden">
        <%= render "shared/card_header", title: "Space Bookings" %>
        <div class="p-4">
          <% if @rentals.any? %>
            <div class="space-y-2">
              <% @rentals.each do |rental| %>
                <%= render "booking_row", rental: rental %>
              <% end %>
            </div>
          <% else %>
            <p class="text-gray-500 text-sm">No bookings yet.</p>
          <% end %>
        </div>
      </div>

      <%# Payments %>
      <div class="border border-gray-200 rounded-lg overflow-hidden">
        <%= render "shared/card_header", title: "Payments" %>
        <div class="p-4">
          <% if @payments.any? %>
            <div class="space-y-2">
              <%# Charges that settle by deduction fold into the settlement that
                  nets them out — see Contract#payment_schedule_groups. %>
              <% @contract.payment_schedule_groups(@payments.to_a).each do |group| %>
                <%= render "contract_payment_row", payment: group[:payment], deductions: group[:deductions] %>
              <% end %>
            </div>
          <% else %>
            <p class="text-gray-500 text-sm">No payments scheduled.</p>
          <% end %>
        </div>
      </div>

      <%# Course Offering Payouts - show if contract has course offerings with payouts %>
      <% course_payouts = @contract.course_offerings.includes(:course_offering_payout).filter_map(&:course_offering_payout) %>
      <% if course_payouts.any? %>
        <div class="border border-gray-200 rounded-lg overflow-hidden">
          <%= render "shared/card_header", title: "Course Payouts" %>
          <div class="p-4 space-y-2">
            <% course_payouts.each do |payout| %>
              <div class="flex items-center justify-between px-3 py-2 border border-gray-200 rounded-lg bg-white">
                <div>
                  <div class="font-medium text-gray-900"><%= payout.course_offering.production&.name %></div>
                  <div class="text-sm text-gray-600">
                    <% if payout.total_payout_cents.to_i > 0 %>
                      Payout: <%= number_to_currency(payout.total_payout_cents / 100.0) %>
                    <% else %>
                      Payout not yet calculated
                    <% end %>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium
                    <%= case payout.status
                        when 'paid' then 'bg-green-100 text-green-700'
                        when 'calculated' then 'bg-amber-100 text-amber-700'
                        else 'bg-gray-100 text-gray-600'
                        end %>">
                    <%= payout.status.capitalize %>
                  </span>
                  <%= link_to manage_course_offering_payout_path(payout.course_offering) do %>
                    <%= render "shared/button", text: "View Payout", variant: "secondary", size: "small" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Revenue Projection - only for revenue share contracts %>
      <% if @contract.revenue_share? %>
        <%= render "revenue_projection_card", contract: @contract %>
      <% end %>

      <%# Associated Productions %>
      <% if @productions.any? %>
        <div class="border border-gray-200 rounded-lg overflow-hidden">
          <%= render "shared/card_header", title: "Associated Productions" %>
          <div class="p-4 space-y-2">
            <% @productions.each do |production| %>
              <div class="flex items-center justify-between px-3 py-2 border border-gray-200 rounded-lg hover:border-gray-400 transition-all bg-white">
                <div class="flex items-center gap-3">
                  <div class="flex-shrink-0">
                    <%= render "shared/production_image", production: production, width: "w-10", initials_class: "text-sm" %>
                  </div>
                  <div>
                    <div class="font-medium text-gray-900"><%= production.name %></div>
                    <div class="text-sm text-gray-500"><%= pluralize(production.shows.count, "show") %></div>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <%= link_to manage_money_production_financials_path(production) do %>
                    <%= render "shared/button", text: "Financials", variant: "secondary", size: "small" %>
                  <% end %>
                  <%= link_to manage_production_shows_path(production) do %>
                    <%= render "shared/button", text: "View Shows", variant: "secondary", size: "small" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Sidebar %>
    <div class="space-y-6">
      <%# E-signature status (only for contracts set up for native signing) %>
      <% if @contract.signing_mode_esign? %>
        <%= render "signature_panel" %>
      <% end %>

      <%# Financial Summary — the gross picture first (what the deal made vs
          cost us, ticket revenue included), then plain payment cash-flow. %>
      <% money ||= @contract.money_display %>
      <div class="border border-gray-200 rounded-lg overflow-hidden">
        <%= render "shared/card_header", title: "Financial Summary" %>
        <div class="p-4">
          <dl class="space-y-3">
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Made us</dt>
              <dd class="text-sm font-medium text-green-600 tabular-nums"><%= number_to_currency(money[:made]) %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Cost us</dt>
              <dd class="text-sm font-medium <%= money[:cost] > 0 ? 'text-red-600' : 'text-gray-400' %> tabular-nums"><%= number_to_currency(money[:cost]) %></dd>
            </div>
            <div class="flex justify-between border-t border-gray-200 pt-3">
              <dt class="text-sm font-medium text-gray-900">Net to us</dt>
              <dd class="text-sm font-bold <%= money[:net] >= 0 ? 'text-green-600' : 'text-red-600' %> tabular-nums">
                <%= number_to_currency(money[:net]) %>
              </dd>
            </div>
            <% if money[:pending_shows] > 0 %>
              <p class="text-[11px] text-amber-600"><%= pluralize(money[:pending_shows], "show") %> still awaiting financials — revenue so far only.</p>
            <% end %>
            <%# Cash flow through contract payments (subset of the above for
                ticket-based deals; the whole story for flat/rent deals). %>
            <div class="flex justify-between border-t border-gray-100 pt-3">
              <dt class="text-xs text-gray-400">Payments received</dt>
              <dd class="text-xs text-gray-600 tabular-nums"><%= number_to_currency(@contract.total_incoming) %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-xs text-gray-400">Payments scheduled out</dt>
              <dd class="text-xs text-gray-600 tabular-nums"><%= number_to_currency(@contract.total_outgoing) %></dd>
            </div>
          </dl>
        </div>
      </div>

      <%# Documents %>
      <div class="border border-gray-200 rounded-lg overflow-hidden" data-controller="modal">
        <div class="flex items-center justify-between px-4 py-3 bg-gray-50 border-b border-gray-200">
          <h3 class="text-sm font-semibold text-gray-700">Documents</h3>
          <button type="button" data-action="click->modal#open" data-modal-id="document-upload-modal" class="text-pink-600 hover:text-pink-700">
            <%= icon("plus", class: "w-4 h-4") %>
          </button>
        </div>
        <div class="p-4">
          <% if @documents.any? %>
            <div class="space-y-2">
              <% @documents.each do |doc| %>
                <div class="flex items-center justify-between p-2 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                  <% if doc.file.attached? %>
                    <%= link_to rails_blob_path(doc.file, disposition: "inline"), target: "_blank", class: "flex items-center gap-2 flex-1 min-w-0" do %>
                      <% content_type = doc.file.content_type %>
                      <% if content_type&.start_with?("image/") %>
                        <%= icon("image", class: "w-4 h-4 text-pink-500 flex-shrink-0") %>
                      <% elsif content_type == "application/pdf" %>
                        <%= icon("file-text", class: "w-4 h-4 text-red-500 flex-shrink-0") %>
                      <% else %>
                        <%= icon("file", class: "w-4 h-4 text-gray-400 flex-shrink-0") %>
                      <% end %>
                      <span class="text-sm text-gray-900 hover:text-pink-600 truncate"><%= doc.name %></span>
                    <% end %>
                  <% else %>
                    <div class="flex items-center gap-2 flex-1 min-w-0">
                      <%= icon("file-text", class: "w-4 h-4 text-gray-400 flex-shrink-0") %>
                      <span class="text-sm text-gray-500 truncate"><%= doc.name %></span>
                    </div>
                  <% end %>
                  <div class="flex items-center gap-2 flex-shrink-0">
                    <% if doc.file.attached? %>
                      <%= link_to rails_blob_path(doc.file, disposition: "attachment"), class: "text-gray-400 hover:text-pink-600", title: "Download" do %>
                        <%= icon("download", class: "w-4 h-4") %>
                      <% end %>
                    <% end %>
                    <button type="button"
                      data-controller="modal" data-action="click->modal#open" data-modal-id="confirm-delete-contract-doc-<%= doc.id %>"
                      class="text-gray-400 hover:text-red-600 bg-transparent border-0 cursor-pointer p-0"
                      title="Delete">
                      <%= icon("trash", class: "w-4 h-4") %>
                    </button>
                    <%= render "shared/confirm_modal",
                      id: "confirm-delete-contract-doc-#{doc.id}",
                      title: "Delete document?",
                      message: "Delete this document?",
                      confirm_text: "Delete",
                      url: manage_contract_contract_document_path(@contract, doc),
                      method: :delete %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-500 text-center py-4">No documents uploaded yet.</p>
          <% end %>
        </div>

        <%# Upload Modal %>
        <div id="document-upload-modal" class="hidden fixed inset-0 z-50 overflow-y-auto">
          <div class="flex min-h-full items-center justify-center p-4">
            <div class="fixed inset-0 bg-gray-500/75 transition-opacity" data-action="click->modal#close"></div>
            <div class="relative bg-white rounded-xl shadow-xl w-full max-w-md p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Upload Document</h3>
                <button type="button" data-action="click->modal#close" class="text-gray-400 hover:text-gray-500">
                  <%= icon("x", class: "w-5 h-5") %>
                </button>
              </div>

              <%= form_with model: [@contract, ContractDocument.new], url: manage_contract_contract_documents_path(@contract), multipart: true, data: { controller: "file-upload" } do |f| %>
                <div class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-pink-400 transition-colors mb-4">
                  <div class="space-y-3">
                    <%= icon("upload", class: "w-8 h-8 text-gray-400 mx-auto") %>
                    <div>
                      <label class="text-pink-600 hover:text-pink-700 cursor-pointer font-medium">
                        Choose a file
                        <%= f.file_field :file,
                          accept: ".pdf,.doc,.docx,.jpg,.jpeg,.png",
                          class: "sr-only",
                          data: { file_upload_target: "input", action: "change->file-upload#fileSelected" } %>
                      </label>
                      <p class="text-xs text-gray-500 mt-1">PDF, DOC, DOCX, or images up to 10MB</p>
                    </div>
                    <div data-file-upload-target="filename" class="hidden text-sm font-medium text-gray-900 bg-gray-100 rounded-lg px-3 py-2"></div>
                  </div>
                </div>

                <%= f.text_field :name, placeholder: "Document name (optional)", class: "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500 focus:border-pink-500 mb-4" %>

                <div class="flex justify-end gap-3">
                  <button type="button" data-action="click->modal#close" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">
                    Cancel
                  </button>
                  <%= render "shared/button", text: "Upload", variant: "primary", size: "medium", type: :submit %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <%# Notes %>
      <% if @contract.notes.present? || @contract.terms.present? %>
        <div class="border border-gray-200 rounded-lg overflow-hidden">
          <%= render "shared/card_header", title: "Notes & Terms" %>
          <div class="p-4">
            <% if @contract.notes.present? %>
              <div class="mb-4">
                <h4 class="text-xs font-medium text-gray-500 uppercase mb-1">Notes</h4>
                <p class="text-sm text-gray-700 whitespace-pre-line"><%= @contract.notes %></p>
              </div>
            <% end %>
            <% if @contract.terms.present? %>
              <div>
                <h4 class="text-xs font-medium text-gray-500 uppercase mb-1">Terms</h4>
                <p class="text-sm text-gray-700 whitespace-pre-line"><%= @contract.terms %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Actions %>
      <% if @contract.status_active? %>
        <div class="border border-gray-200 rounded-lg overflow-hidden">
          <%= render "shared/card_header", title: "Actions" %>
          <div class="p-4 space-y-2">
            <%= render "shared/button",
              text: "Amend Contract",
              variant: "primary",
              size: "small",
              icon: "edit",
              path: amend_bookings_manage_contract_path(@contract),
              classes: "w-full" %>
            <%= render "shared/button",
              text: "Cancel Contract",
              variant: "secondary",
              size: "small",
              icon: "x-circle",
              path: cancel_manage_contract_path(@contract),
              classes: "w-full" %>
          </div>
        </div>
      <% elsif @contract.status_completed? %>
        <div class="border border-gray-200 rounded-lg overflow-hidden">
          <%= render "shared/card_header", title: "Actions" %>
          <div class="p-4 space-y-2">
            <%= render "shared/button",
              text: "Reopen to Amend",
              variant: "primary",
              size: "small",
              icon: "edit",
              type: :button,
              data: { action: "click->modal#open", "modal-id": "reopen-contract-modal" },
              classes: "w-full" %>
            <p class="text-xs text-gray-500">Extend this contract — reopen it to add new dates (e.g. an August run) and amend terms. Once active again, you can select it when creating a course.</p>
          </div>
        </div>
      <% elsif @contract.status_cancelled? %>
        <div class="border border-gray-200 rounded-lg overflow-hidden">
          <%= render "shared/card_header", title: "Actions" %>
          <div class="p-4 space-y-2">
            <button type="button"
                data-controller="modal" data-action="click->modal#open" data-modal-id="confirm-delete-contract-<%= @contract.id %>"
                class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-pink-700 bg-pink-50 border border-pink-200 rounded-lg hover:bg-pink-100 transition cursor-pointer">
              <%= icon("trash", class: "w-4 h-4") %>
              Delete Forever
            </button>
            <%= render "shared/confirm_modal",
                id: "confirm-delete-contract-#{@contract.id}",
                title: "Delete contract forever?",
                message: "Are you sure you want to permanently delete this contract? This will also delete all payments, documents, and events. This cannot be undone.",
                confirm_text: "Delete Forever",
                confirm_icon: "trash",
                url: manage_contract_path(@contract),
                method: :delete %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Reopen contract confirmation modal %>
  <% if @contract.status_completed? %>
    <div id="reopen-contract-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
      <div class="fixed inset-0 bg-black/40" data-action="click->modal#close"></div>
      <div class="relative bg-white rounded-xl shadow-xl w-full max-w-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h3 class="text-lg font-semibold text-gray-900">Reopen this contract?</h3>
          <button type="button" data-action="click->modal#close" class="text-gray-400 hover:text-gray-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="px-6 py-5">
          <p class="text-sm text-gray-600 mb-4">Here's what happens when you reopen it:</p>
          <ul class="space-y-3 text-sm text-gray-700">
            <li class="flex items-start gap-2.5">
              <%= icon("check-circle", class: "w-5 h-5 text-green-500 flex-shrink-0") %>
              <span>The contract goes back to <strong>Active</strong>, and its production is un-archived.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <%= icon("check-circle", class: "w-5 h-5 text-green-500 flex-shrink-0") %>
              <span>You'll be taken to the <strong>amend flow</strong> to add new dates (e.g. an August run) and adjust terms.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <%= icon("check-circle", class: "w-5 h-5 text-green-500 flex-shrink-0") %>
              <span>Once active again, you can <strong>select it when creating a course</strong>.</span>
            </li>
          </ul>
          <p class="text-xs text-gray-500 mt-4">Nothing is deleted, and your existing dates, payments, and documents stay put. You can complete it again later.</p>
        </div>
        <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex items-center justify-end gap-2">
          <button type="button" data-action="click->modal#close" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</button>
          <%= render "shared/button", text: "Reopen contract", variant: "primary", size: "medium",
            path: reopen_manage_contract_path(@contract), method: :post %>
        </div>
      </div>
    </div>
  <% end %>
</div>
