<%# One bill's fields, for the check card, the edit modal and the add modal. Sits inside a form; names are company_expense[...].
    locals: expense (CompanyExpense), vendors (names already used), key (unique per form, for ids) %>
<% input = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
<% label = "block text-sm font-medium text-gray-700 mb-1" %>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
  <div>
    <%= label_tag "#{key}-vendor", "Who it's from", class: label %>
    <%= text_field_tag "company_expense[vendor]", expense.vendor, id: "#{key}-vendor", list: "#{key}-vendors", required: true, placeholder: "Amazon", class: input %>
    <datalist id="<%= key %>-vendors"><% vendors.each do |name| %><option value="<%= name %>"></option><% end %></datalist>
  </div>
  <div>
    <%= label_tag "#{key}-category", "Kind of cost", class: label %>
    <%= select_tag "company_expense[category]", options_for_select(CompanyExpense::CATEGORIES.map { |value, name| [ name, value ] }, expense.category), id: "#{key}-category", class: input %>
  </div>
  <div>
    <%= label_tag "#{key}-description", "What it's for", class: label %>
    <%= text_field_tag "company_expense[description]", expense.description, id: "#{key}-description", placeholder: "Amazon Web Services", class: input %>
  </div>
  <div>
    <%= label_tag "#{key}-number", "Bill or receipt number", class: label %>
    <%= text_field_tag "company_expense[bill_number]", expense.bill_number, id: "#{key}-number", class: input %>
  </div>
  <div>
    <%= label_tag "#{key}-total", "Bill total", class: label %>
    <div class="relative">
      <span class="absolute inset-y-0 left-3 flex items-center text-gray-500">$</span>
      <%= text_field_tag "company_expense[bill_total]", (format("%.2f", expense.bill_total_cents / 100.0) if expense.bill_total_cents.to_i.positive?), id: "#{key}-total",
            inputmode: "decimal", required: true, placeholder: "0.00", class: "#{input} pl-7 tabular-nums" %>
    </div>
  </div>
  <div>
    <%= label_tag "#{key}-share", "CocoScout's share (%)", class: label %>
    <%= text_field_tag "company_expense[share_percent]", expense.share_percent.to_d.to_s("F").sub(/\.0\z/, ""), id: "#{key}-share", inputmode: "decimal", class: "#{input} tabular-nums" %>
    <p class="mt-1 text-xs text-gray-500">100 unless only part of the bill is CocoScout's.</p>
  </div>
  <div>
    <%= label_tag "#{key}-month", "Month it's for", class: label %>
    <%= month_field_tag "company_expense[period_month]", expense.period_month&.strftime("%Y-%m"), id: "#{key}-month", required: true, class: input %>
  </div>
  <div>
    <%= label_tag "#{key}-paid-by", "Who paid", class: label %>
    <%= select_tag "company_expense[paid_by]", options_for_select(CompanyExpense::PAID_BY.map { |value, name| [ name, value ] }, expense.paid_by), id: "#{key}-paid-by", class: input %>
  </div>
  <div>
    <%= label_tag "#{key}-billed", "Billed on", class: label %>
    <%= date_field_tag "company_expense[billed_on]", expense.billed_on&.iso8601, id: "#{key}-billed", class: input %>
  </div>
  <div>
    <%= label_tag "#{key}-paid", "Paid on", class: label %>
    <%= date_field_tag "company_expense[paid_on]", expense.paid_on&.iso8601, id: "#{key}-paid", class: input %>
  </div>
  <div class="sm:col-span-2">
    <%= label_tag "#{key}-note", "Note", class: label %>
    <%= text_field_tag "company_expense[note]", expense.note, id: "#{key}-note", class: input %>
  </div>
</div>
