<%# Tickets on the show page: where this date's tickets are, as small as the
    Money box, for reading only (Round 9 §3; Tim: the show page shows, the
    edit pages change). Pro, like Money. Nothing is drawn when there's
    nothing to say: the production's answer lives on Production Settings →
    Tickets, a date's own on its Tickets tab. Locals: show, production. %>
<%
  listing = show.ticket_listing
  listing = nil if listing&.status == "canceled"
  link = TicketLink.for(show, listing: listing)
  today = show.date_and_time.to_date == Date.current && !show.canceled
  # Ticketing's pages are the organization's managers'; the door is theirs
  # and anyone with door access. Everyone else reads the tile, no link.
  can_manage_ticketing = Current.user&.superadmin? || Current.organization&.manageable_by?(Current.user)
  can_door = can_manage_ticketing || (Current.user && TicketingDoorAccess.level_for(Current.user, production.organization).present?)
  tile = lambda do |path, allowed, &block|
    if allowed
      link_to(path, class: "block rounded-lg border border-gray-200 p-3 hover:border-pink-300 hover:bg-gray-50 transition", &block)
    else
      tag.div(class: "rounded-lg border border-gray-200 p-3", &block)
    end
  end
%>
<% if listing || link.outside? %>
  <div class="border border-gray-200 rounded-lg overflow-hidden">
    <div class="bg-gray-50 px-4 py-3 border-b border-gray-200 flex items-center gap-2">
      <h3 class="text-md font-semibold text-gray-900 coustard-regular">Tickets</h3>
      <%= render "shared/pro_marker" %>
    </div>
    <div class="p-4 space-y-3">
      <div class="grid grid-cols-1 sm:grid-cols-<%= listing && today ? 2 : 1 %> gap-3">
        <% if listing %>
          <%
            stats = Ticketing::ListingStats.of(listing)
            label, classes = ticket_listing_status_badge(listing, stats.inventory)
          %>
          <%= tile.call(manage_ticket_listing_path(listing), can_manage_ticketing) do %>
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">On CocoScout</div>
            <div class="mt-1 text-lg font-semibold text-gray-900 tabular-nums"><%= stats.sold %><% if stats.capacity %> <span class="text-sm font-normal text-gray-500">of <%= stats.capacity %></span><% end %> sold</div>
            <div class="text-xs text-gray-500 mt-0.5 flex items-center gap-2"><span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium <%= classes %>"><%= label %></span><%= number_to_currency(stats.gross_cents / 100.0) %></div>
          <% end %>
          <% if today %>
            <%= tile.call(door_path(listing), can_door) do %>
              <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Door</div>
              <div class="mt-1 text-lg font-semibold text-gray-900 tabular-nums"><%= stats.checked_in %> <span class="text-sm font-normal text-gray-500">in</span></div>
              <div class="text-xs text-gray-500 mt-0.5">Tonight: check people in, sell at the door</div>
            <% end %>
          <% end %>
        <% else %>
          <div class="rounded-lg border border-gray-200 p-3">
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Sold on <%= link.site || "another site" %></div>
            <div class="text-xs text-gray-500 mt-1"><%= show.tickets_override? ? "This date's own link" : "The production's link" %></div>
          </div>
        <% end %>
      </div>
      <%= render "shared/copy_url", url: link.url, show_qr: true, qr_title: "Scan for tickets" %>
    </div>
  </div>
<% end %>
