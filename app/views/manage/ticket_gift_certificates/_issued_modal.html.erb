<%# Right after issuing: the code, big enough to read over the phone, with
    Copy. Opens on its own (the page came back with ?issued=). Locals: certificate. %>
<div id="issued-gift-certificate" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden" data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white">Gift certificate issued</h3>
      <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="p-6 space-y-4" data-controller="clipboard">
      <div class="rounded-lg border border-pink-200 bg-pink-50 px-4 py-4 text-center">
        <div class="font-mono text-2xl font-bold tracking-widest text-gray-900 break-all"><%= certificate.code %></div>
        <div class="mt-1 text-sm text-gray-600">
          <%= number_to_currency(certificate.amount_cents / 100.0) %><% if certificate.recipient_name.present? %> · for <%= certificate.recipient_name %><% end %>
        </div>
        <div class="text-sm text-gray-600">Good for <%= certificate.scope == "any" ? "any show you sell tickets to" : certificate.good_for_words %></div>
        <input type="hidden" value="<%= certificate.code %>" data-clipboard-target="textField">
      </div>
      <p class="text-sm text-gray-600">
        <% if local_assigns[:emailed] %>The email to <%= certificate.recipient_email %> is on its way, naming what it's good for.<% end %>
        The code is the only thing a buyer needs: they type it on the checkout page, under the total.
      </p>
      <div class="flex items-center justify-end gap-2">
        <%= render "shared/button", text: "Copy code", variant: "secondary", size: "medium", type: :button, data: { action: "click->clipboard#copy", clipboard_target: "button" } %>
        <%= render "shared/button", text: "Done", variant: "primary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
      </div>
    </div>
  </div>
</div>
