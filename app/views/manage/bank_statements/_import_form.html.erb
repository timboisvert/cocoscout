<%# The "Bring a statement in" card: the bank file and the button.
    title: the card's heading %>
<section class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <div class="bg-gradient-to-r from-pink-500 to-pink-600 px-5 py-3"><h2 class="text-base font-semibold text-white"><%= local_assigns[:title] || "Bring a statement in" %></h2></div>
  <%= form_with url: manage_money_bank_import_path, method: :post, multipart: true, data: { turbo: false } do %>
    <div class="px-5 py-4 space-y-3">
      <label class="block text-sm font-medium text-gray-700"><span>The file from your bank</span>
        <span class="mt-1 flex items-center gap-3 rounded-lg border border-dashed border-gray-300 bg-gray-50 px-3 py-3">
          <input type="file" name="file" accept=".csv,.ofx,.qfx,text/csv,application/x-ofx" required class="block w-full text-sm text-gray-700">
        </span>
        <span class="block mt-1 text-xs text-gray-500">CSV or OFX (QFX works too). Most banks offer both under Download or Export.</span>
      </label>
      <%= render "shared/button", text: "Read the file", variant: "primary", size: "medium", type: :submit, classes: "w-full justify-center" %>
    </div>
  <% end %>
</section>
