<%#
  One approved time entry as a compact calendar chip. `item` is a StaffTimeEntry.
  Approved (unpaid) entries link into the edit / re-approve modal; paid entries
  are locked (no link).
%>
<% e = item %>
<% hrs = number_with_precision(e.hours, precision: 2, strip_insignificant_zeros: true) %>
<% label = "#{e.person.name} · #{hrs}h" %>

<% if e.paid_offline? %>
  <%# Settled outside CocoScout — clicking offers to unmark (back to approved). %>
  <% unmark_cid = "confirm-unmark-offline-#{e.id}" %>
  <button type="button" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= unmark_cid %>"
          class="block w-full text-left text-[11px] leading-tight rounded px-1.5 py-1 mb-1 bg-blue-50 text-blue-700 hover:bg-blue-100 truncate cursor-pointer"
          title="<%= label %> · Paid outside CocoScout<%= " · #{e.offline_payment_note}" if e.offline_payment_note.present? %> — click to unmark">
    <%= label %>
  </button>
  <%= render "shared/confirm_modal", id: unmark_cid,
        title: "Unmark as already paid?",
        message: "#{e.person.name}'s #{hrs}h on #{e.started_at.strftime('%b %-d')} is marked as paid outside CocoScout#{" (#{e.offline_payment_note})" if e.offline_payment_note.present?}. Unmark it? The hours go back to approved and can be pulled into a pay run again.",
        confirm_text: "Unmark",
        url: manage_unmark_paid_offline_staffing_timesheet_path(e), method: :patch %>
<% elsif e.paid? %>
  <div class="block text-[11px] leading-tight rounded px-1.5 py-1 mb-1 bg-gray-100 text-gray-500 truncate"
       title="<%= label %> · Paid">
    <%= label %>
  </div>
<% else %>
  <%= link_to manage_edit_staffing_timesheet_path(e),
        data: { turbo_frame: "timesheet_edit_modal" },
        class: "block text-[11px] leading-tight rounded px-1.5 py-1 mb-1 bg-green-100 text-green-800 hover:bg-green-200 truncate",
        title: "#{label} — click to edit or send back for review" do %>
    <%= label %>
  <% end %>
<% end %>
