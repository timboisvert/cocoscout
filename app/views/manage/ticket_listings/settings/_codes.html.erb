<%# This date's discount codes: the production's work on it, or (switch on)
    it has its own instead (TicketListing#own_codes), listed below with a
    pink modal to add one. The one override control
    (manage/ticketing/own_switch); the switch saves as it's flipped.
    Locals: listing, setup. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  own = listing.own_codes?
  codes = listing.ticket_discount_codes.where(active: true).order(:code).to_a
  production_codes = listing.organization.ticket_discount_codes.where(production: listing.production, active: true).order(:code).to_a
  followed = production_codes.any? ? production_codes.map { |c| "#{c.code} (#{c.off_words})" }.to_sentence : "none yet"
  modal_id = "add-code-modal"
%>
<div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle" data-settings-card="codes">
  <%= form_with url: manage_ticket_listing_path(listing, section: "codes"), method: :patch, data: { controller: "auto-submit" } do %>
    <%= render "manage/ticketing/own_switch", title: "Discount codes", what: "discount codes", follows: listing.production.name, settings_path: manage_edit_production_ticketing_path(listing.production, section: "codes"),
          intro: "Codes buyers can enter at checkout. #{possessive(listing.production.name)} codes work on this date: #{followed}.",
          only: "this date", name: "ticket_listing[own_codes]", id: "ticket_listing_own_codes", checked: own,
          data: { action: "change->auto-submit#submit" } %>
  <% end %>
  <fieldset <%= "disabled" unless own %> data-fieldset-toggle-target="fields" class="disabled:opacity-50">
    <div class="px-6 py-3 border-b border-gray-100 flex flex-wrap items-center justify-between gap-3">
      <span class="text-sm font-medium text-gray-900">This date's own codes <span class="font-normal text-gray-500">· good for <%= ticket_listing_date_label(listing) %> only</span></span>
      <span class="flex items-center gap-2">
        <%= render "shared/button", text: "Add code", variant: "primary", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: modal_id } %>
        <%= render "shared/action_menu", id: "codes-actions", title: "Discount codes", items: [
              { text: "Export codes", path: "#", icon: "M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2", data: { controller: "modal", action: "click->modal#open click->dropdown#close", modal_id: "export-codes-modal" } },
              { text: "Import codes", path: "#", icon: "M12 15V3m0 0L8 7m4-4l4 4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2", data: { controller: "modal", action: "click->modal#open click->dropdown#close", modal_id: "import-codes-modal" } }
            ] %>
      </span>
    </div>
    <% if codes.any? %>
      <ul class="divide-y divide-gray-100">
        <% codes.each do |code| %>
          <%= render "manage/ticketing/code_row", code: code, share_form: manage_ticket_listing_code_path(listing, code_id: code.id), remove_modal_id: "confirm-remove-code-#{code.id}" %>
        <% end %>
      </ul>
    <% else %>
      <p class="px-6 py-5 text-sm text-gray-500">No codes of its own yet.</p>
    <% end %>
  </fieldset>
</div>
<%= render "manage/ticketing/code_modal", id: modal_id, url: manage_ticket_listing_codes_path(listing), what: "this date only", input_class: input_class %>
<%= render "manage/ticketing/code_transfer_modals", export_url: manage_ticket_listing_codes_export_path(listing), import_url: manage_ticket_listing_codes_import_path(listing),
      count: codes.size, what: "this date only", input_class: input_class %>
<% codes.each do |code| %>
  <%= render "shared/confirm_modal", id: "confirm-remove-code-#{code.id}", title: "Remove #{code.code}?",
        message: "Buyers won't be able to use it anymore. Orders that already used it keep their discount.",
        confirm_text: "Remove code", url: manage_ticket_listing_code_path(listing, code_id: code.id), method: :delete %>
<% end %>
