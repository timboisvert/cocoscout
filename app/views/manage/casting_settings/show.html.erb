<% content_for :title, "Casting Settings" %>

<%= render layout: "shared/settings_layout", locals: {
  title: "Casting Settings",
  breadcrumbs: [
    ["Casting", manage_casting_path],
    [@production.name, manage_casting_production_path(@production)]
  ],
  sections: sections,
  current: @section,
  intro: "#{@production.name} casts by #{@production.act_based? ? 'acts' : 'roles'}.",
  width: "max-w-4xl"
} do %>
  <%= render "manage/casting_settings/sections/#{@section}" %>
<% end %>
