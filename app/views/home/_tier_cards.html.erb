<%# The three pricing tiers (Producer / Pro / Enterprise). Self-contained and
    reused across /new, /pricing, and /for-producers. Enterprise "Talk to us"
    uses a mailto placeholder — confirm the address. %>
<div class="grid gap-6 md:grid-cols-3 items-stretch">
  <%# Producer %>
  <div class="border border-slate-200 rounded-2xl p-8 flex flex-col bg-white">
    <h3 class="text-xl font-bold text-slate-900">Producer</h3>
    <p class="mt-2 text-4xl font-bold text-slate-900">$0</p>
    <p class="mt-1 text-sm text-slate-500">Everything to run a production. For solo producers and small teams.</p>
    <ul class="mt-6 space-y-2 text-sm text-slate-700 flex-1">
      <% ["Shows, events &amp; rehearsals", "Casting, roles &amp; talent pools", "Auditions &amp; sign-ups", "Courses &amp; classes", "Contacts, documents &amp; messaging"].each do |f| %>
        <li class="flex items-start gap-2"><span class="text-green-500 mt-0.5"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></span><span><%= f.html_safe %></span></li>
      <% end %>
    </ul>
    <p class="mt-4 text-xs text-slate-400">1 production · 6 events / month</p>
    <div class="mt-6"><%= render "shared/button", text: "Start free", path: signup_path, variant: "outline", size: "large" %></div>
  </div>

  <%# Pro (recommended) %>
  <div class="border-2 border-pink-500 rounded-2xl p-8 flex flex-col bg-white relative shadow-lg">
    <span class="absolute -top-3 left-8 inline-flex items-center rounded-full bg-pink-500 px-3 py-1 text-xs font-semibold text-white">Recommended</span>
    <h3 class="text-xl font-bold text-slate-900">Pro</h3>
    <p class="mt-2 text-4xl font-bold text-slate-900">$20<span class="text-base font-medium text-slate-500">/mo</span></p>
    <p class="mt-1 text-sm text-slate-500">Plus simple and fair usage-based fees if you pay your staff and performers.</p>
    <ul class="mt-6 space-y-2 text-sm text-slate-700 flex-1">
      <% ["Everything in Producer", "Payouts, splits &amp; financials", "Contracts + e-signatures", "Reports &amp; analytics", "Multi-show casting tables", "Staffing, scheduling &amp; payroll", "Contractor payments + tax", "Unlimited productions &amp; events"].each do |f| %>
        <li class="flex items-start gap-2"><span class="text-pink-500 mt-0.5"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></span><span><%= f.html_safe %></span></li>
      <% end %>
    </ul>
    <div class="mt-6"><%= render "shared/button", text: "Go Pro", path: signup_path, variant: "primary", size: "large" %></div>
  </div>

  <%# Enterprise (dark premium) %>
  <div class="rounded-2xl p-8 flex flex-col bg-slate-900 text-white">
    <h3 class="text-xl font-bold text-white">Enterprise</h3>
    <p class="mt-2 text-4xl font-bold text-white">Custom</p>
    <p class="mt-1 text-sm text-slate-300">Large-scale staffing and payroll for major companies, theatres, and venues.</p>
    <ul class="mt-6 space-y-2 text-sm text-slate-200 flex-1">
      <% ["Everything in Pro", "W-2 employees &amp; full payroll", "High-volume staffing", "Dedicated onboarding", "Priority support", "Advanced roles &amp; permissions"].each do |f| %>
        <li class="flex items-start gap-2"><span class="text-pink-300 mt-0.5"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></span><span><%= f.html_safe %></span></li>
      <% end %>
    </ul>
    <%= link_to "Talk to us", "mailto:hello@cocoscout.com",
          class: "mt-6 inline-flex justify-center items-center px-6 py-3 rounded bg-white text-slate-900 font-medium hover:bg-slate-100 transition" %>
  </div>
</div>
