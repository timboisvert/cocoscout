<%# Where Stripe's Payment Element mounts (checkout_controller.js), and, for
    whoever can fix it, why it can't when the publishable key is missing. %>
<div class="rounded-2xl border border-gray-200 bg-white px-5 py-5">
  <h2 class="font-semibold text-gray-900 mb-4">Payment</h2>
  <%# Only pages that define superadmin_viewer? can single out a superadmin; a page without it keeps the buyer-facing line. %>
  <% if stripe_publishable_key.blank? && (Rails.env.development? || (respond_to?(:superadmin_viewer?) && superadmin_viewer?)) %>
    <div class="mb-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      <p class="font-medium">Stripe's publishable key isn't set.</p>
      <p class="mt-1">Card payments need it on this page. Add <code class="font-mono">STRIPE_PUBLISHABLE_KEY=pk_…</code> to <code class="font-mono">.env</code> from the same Stripe account as the secret key, then restart the server. See <code class="font-mono">docs/dev_setup_stripe.md</code>.</p>
    </div>
  <% end %>
  <div data-checkout-target="payment" class="min-h-[3rem]"></div>
</div>
