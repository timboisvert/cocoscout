<%#
  The steps after Apple or Google (SignIn::ProvidersController; the sign-in
  plan's "After Apple or Google"): connect, add_email, code, create.
%>
<%
  name = @provider_name
  superadmin = @step == "connect" && User.find_by(email_address: @email_address)&.superadmin?
  lifetime = SignIn::Code.lifetime_in_words
  code_problem = { wrong: "That code doesn't match. Check the email and try again.",
                   expired: "That code has expired or was already used. Send a new code below.",
                   locked: "That code has had too many tries. Send a new code below." }[@code_problem]
  start_over = signin_path(start_over: 1)
%>
<% notices = capture do %>
  <% if @error == :password %>
    <%= render "shared/auth/notice", kind: :error, body: "That password doesn't match. Try again#{superadmin ? '' : ', or use a code instead'}." %>
  <% elsif @error == :email %>
    <%= render "shared/auth/notice", kind: :error, body: "Enter the email address organizations know you by. A private Apple address can't be used for your account." %>
  <% elsif @error == :name %>
    <%= render "shared/auth/notice", kind: :error, body: "Enter your first and last name." %>
  <% elsif code_problem %>
    <%= render "shared/auth/notice", kind: :error, body: code_problem %>
  <% elsif @step == "code" && @pending["sent"] == "too_soon" %>
    <%= render "shared/auth/notice", body: "We sent a code to this address a moment ago, so use that one. It can take a minute to arrive." %>
  <% elsif @step == "code" && @pending["sent"] == "too_many" %>
    <%= render "shared/auth/notice", body: "We've sent this address several codes in the last hour. Use the newest one, or request another later." %>
  <% end %>
<% end %>

<% case @step %>
<% when "connect" %>
  <% content_for :title, "Connect your #{name} account" %>
  <%= render layout: "shared/auth/shell",
        locals: { title: "Connect your #{name} account",
                  lede: "You already have a CocoScout account at this address. Enter its password once, and #{name} signs you in from then on.",
                  notices: notices } do %>
    <%= form_with url: sign_in_provider_continue_path, class: "space-y-4" do |form| %>
      <%= hidden_field_tag :step, "password", id: nil %>
      <%= render "shared/auth/account_row", email: @email_address, change: start_over %>
      <input type="email" name="email_address" value="<%= @email_address %>" autocomplete="username" readonly tabindex="-1" aria-hidden="true"
             style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden">
      <%= render "shared/auth/password_field", form: form, autocomplete: "current-password", error: @error == :password %>
      <div class="pt-1">
        <%= render "shared/button", text: "Connect and sign in", variant: "primary", size: "jumbo", type: :submit %>
      </div>
    <% end %>
    <% unless superadmin %>
      <%= form_with url: sign_in_provider_continue_path, id: "provider-send-code" do %>
        <%= hidden_field_tag :step, "send_code", id: nil %>
      <% end %>
      <div class="flex flex-col items-center gap-1 text-center">
        <%= render "shared/button", text: "Email me a code instead", variant: "ghost", size: "small", type: :submit,
              form_id: "provider-send-code", classes: "!text-[15px] !text-pink-600 hover:!bg-pink-50 hover:!text-pink-700" %>
        <p class="text-[13px] leading-snug text-slate-500">With a code, your password stops working, and you can choose a new one on your Account page.</p>
      </div>
    <% end %>
  <% end %>

<% when "add_email" %>
  <% content_for :title, "Add your email address" %>
  <%= render layout: "shared/auth/shell",
        locals: { title: "Add your email address",
                  lede: "#{name} kept your address private. Enter the one organizations know you by, so your invitations, contracts, and tickets find you. We'll send it a code.",
                  notices: notices } do %>
    <%= form_with url: sign_in_provider_continue_path, class: "space-y-4" do %>
      <%= hidden_field_tag :step, "email", id: nil %>
      <div>
        <label for="email_address" class="mb-1.5 block text-sm font-medium text-slate-700">Email address</label>
        <%= email_field_tag :email_address, @typed_email, required: true, autofocus: true, autocomplete: "email",
              placeholder: "you@example.com", class: auth_input_class(error: @error == :email) %>
      </div>
      <div class="pt-1">
        <%= render "shared/button", text: "Send a code", variant: "primary", size: "jumbo", type: :submit %>
      </div>
    <% end %>
  <% end %>

<% when "code" %>
  <% content_for :title, "Enter your code" %>
  <% lede = capture do %>
    We sent a 6-digit code to <strong class="font-semibold text-slate-900"><%= @email_address %></strong>. It works for <%= lifetime %>.
  <% end %>
  <%= render layout: "shared/auth/shell", locals: { title: "Enter your code", lede: lede, notices: notices } do %>
    <%= form_with url: sign_in_provider_continue_path, class: "space-y-4" do %>
      <%= hidden_field_tag :step, "code", id: nil %>
      <%= render "shared/auth/account_row", email: @email_address, change: start_over %>
      <%= render "shared/auth/code_field", error: @code_problem.present?, autofocus: true %>
      <div class="pt-1">
        <%= render "shared/button", text: "Continue", variant: "primary", size: "jumbo", type: :submit %>
      </div>
    <% end %>
    <%= form_with url: sign_in_provider_continue_path, id: "provider-resend-code" do %>
      <%= hidden_field_tag :step, "send_code", id: nil %>
    <% end %>
    <div class="text-center">
      <%= render "shared/button", text: "Send a new code", variant: "ghost", size: "small", type: :submit,
            form_id: "provider-resend-code", classes: "!text-[15px] !text-pink-600 hover:!bg-pink-50 hover:!text-pink-700" %>
    </div>
  <% end %>

<% when "create" %>
  <% content_for :title, "Create your account" %>
  <%= render layout: "shared/auth/shell",
        locals: { title: "Create your account",
                  lede: "Enter your name the way organizations should see it on cast lists, messages, and contracts. #{name} signs you in from now on.",
                  pill: "Free to join · No card needed", notices: notices, legal: "creating an account" } do %>
    <%= form_with url: sign_in_provider_continue_path, class: "space-y-4" do %>
      <%= hidden_field_tag :step, "create", id: nil %>
      <%= render "shared/auth/account_row", email: @email_address, change: start_over %>
      <div>
        <label for="first_name" class="mb-1.5 block text-sm font-medium text-slate-700">First name</label>
        <%= text_field_tag :first_name, @first_name || @profile.first_name, required: true, autofocus: true, autocomplete: "given-name",
              maxlength: 60, class: auth_input_class(error: @error == :name && (@first_name || @profile.first_name).blank?) %>
      </div>
      <div>
        <label for="last_name" class="mb-1.5 block text-sm font-medium text-slate-700">Last name</label>
        <%= text_field_tag :last_name, @last_name || @profile.last_name, required: true, autocomplete: "family-name",
              maxlength: 60, class: auth_input_class(error: @error == :name && (@last_name || @profile.last_name).blank?) %>
      </div>
      <div class="pt-1">
        <%= render "shared/button", text: "Create account", variant: "primary", size: "jumbo", type: :submit %>
      </div>
    <% end %>
    <%= form_with url: sign_in_provider_continue_path, id: "provider-other-address" do %>
      <%= hidden_field_tag :step, "other_address", id: nil %>
    <% end %>
    <p class="text-center text-[13px] leading-snug text-slate-500">
      Already have an account under another address?
      <%= render "shared/button", text: "Connect it instead", variant: "ghost", size: "xs", type: :submit,
            form_id: "provider-other-address", classes: "!text-[13px] !text-pink-600 hover:!bg-pink-50 !px-1" %>
    </p>
  <% end %>
<% end %>
