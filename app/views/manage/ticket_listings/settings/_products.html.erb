<%# Whether this date sells the production's products. They're inherited —
    on by default — and one switch turns them off for this date alone.
    Locals: listing, setup (the production's ticketing, or nil). %>
<% offers = setup&.product_offers || [] %>
<div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="products">
  <%= render "shared/section_heading", title: "Products at checkout",
        intro: (offers.any? ? "#{possessive(listing.production.name)} products are offered at checkout on every date: #{offers.map(&:name).to_sentence}." : "Things buyers can add to their order.") %>
  <% if setup.nil? %>
    <p class="px-6 py-5 text-sm text-gray-600">Products are set up on a production's ticketing, and this date doesn't belong to one. It sells tickets only.</p>
  <% elsif offers.empty? %>
    <p class="px-6 py-5 text-sm text-gray-600">
      <%= listing.production.name %> doesn't offer any products yet.
      <%= link_to "Choose some on its Products tab", manage_edit_production_ticketing_path(listing.production, section: "products"), class: "font-medium text-pink-600 hover:text-pink-700" %>
      and every date, this one included, will offer them at checkout.
    </p>
  <% else %>
    <%= form_with model: listing, url: manage_ticket_listing_path(listing), method: :patch do |f| %>
      <%= hidden_field_tag :section, "products" %>
      <div class="px-6 py-4 flex items-center justify-between gap-4">
        <div>
          <div class="text-sm font-medium text-gray-900">Sell products for this date</div>
          <div class="text-xs text-gray-600 mt-0.5">Turn this off and buyers of <%= ticket_listing_date_label(listing) %> see tickets only, online and at the door. Orders that already bought a product keep it.</div>
        </div>
        <%= render "shared/toggle_switch", form: f, field: :sell_products %>
      </div>
      <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex flex-wrap items-center justify-between gap-3">
        <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
        <%= link_to "Change the products for every date", manage_edit_production_ticketing_path(listing.production, section: "products"), class: "text-xs font-medium text-pink-600 hover:text-pink-700" %>
      </div>
    <% end %>
  <% end %>
</div>
