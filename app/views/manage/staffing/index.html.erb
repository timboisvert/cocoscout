<% content_for :title, "Staffing" %>

<div class="w-full mb-10" data-controller="invite-preview">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render "shared/module_header",
    title: "Staffing",
    description: "<p>Your team — who works for you, what they do, and how they get paid. Add staff, schedule their shifts, and pay them, all in one place.</p>",
    actions: [
      { icon: "calendar", text: "Scheduling", description: "Build the week's shifts", path: manage_staffing_scheduling_path },
      { icon: "clipboard-list", text: "Approve Hours", description: "Sign off on submitted time", path: manage_staffing_timesheets_path, badge: @hours_to_approve_count },
      { icon: "dollar-sign", text: "Pay People", description: "Pay staff for hours worked", path: manage_staffing_pay_path },
      { icon: "user-group", text: "Add staff member", description: "Onboard someone new", path: manage_new_staffing_staff_wizard_path },
      { icon: "cog", text: "Settings", description: "Staff agreements & defaults", path: manage_staffing_settings_path }
    ] %>

  <%= render "manage/staffing/declined_alert" %>

  <%= render "manage/staffing/staff_list" %>
  <%= render "manage/staffing/org_chart_modal" %>
</div>
