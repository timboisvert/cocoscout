<%#
  The one Messages inbox (MessagesInbox, V1.1 plan §0a): the filters, the
  rows and the pages. Locals:
    base   :my or :manage: which frame the page is in (the pills' tones,
           the switch prompt's words)
    path   a lambda building the page's own path with filter overrides,
           e.g. ->(**o) { messages_path(**o) }

  The filters are the shared filter bar (Tim, 2026-10-21: no inbox-only
  way of filtering): Show (All / Unread / Sent / Archived), For (Everything /
  As a performer / each organization you run), the production dropdown with
  more than one production in the inbox, and two round pink icon buttons for
  newest-oldest and row density.

  A row under the production hat wears a pill with its organization (pink
  when it's the organization open in production mode, gray otherwise); a
  performer thread wears none. Every row opens through
  My::MessagesController#open; one that would switch organization (or into
  production mode from My) asks first (notification-open controller,
  shared/mode_switch_prompt), unless the person said not to.
%>
<%
  base = local_assigns.fetch(:base)
  current = { filter: @filter, q: @search.presence, production_id: @production_filter, order: @order, hat: @hat.presence }.compact
  own = local_assigns[:path] || ->(**overrides) { messages_path(**overrides) }
  path = ->(**overrides) { own.call(**current.merge(overrides)) }
  in_production_mode = base == :manage
  show_chips = [
    [ "All", path.call(filter: nil), @filter == "all" ],
    [ "Unread", path.call(filter: "unread"), @filter == "unread" ],
    [ "Sent", path.call(filter: "sent_by_me"), @filter == "sent_by_me" ],
    [ "Archived", path.call(filter: "archived"), @filter == "archived" ]
  ]
  hat_chips = [
    [ "Everything", path.call(hat: nil), @hat.blank? ],
    [ "As a performer", path.call(hat: "performer"), @hat == "performer" ]
  ] + @managed_organizations.map { |org| [ org.name, path.call(hat: "org:#{org.id}"), @hat == "org:#{org.id}" ] }
%>

<div data-controller="notification-open"
     data-notification-open-ask-value="<%= @ask_before_switching %>"
     data-notification-open-remember-url-value="<%= notifications_switch_without_asking_path %>">
  <%= form_with url: own.call, method: :get, data: { turbo_action: "advance" }, class: "mt-4" do |f| %>
    <%= render "shared/filters/search_input", placeholder: "Search messages...", value: @search, name: "q", full_width: true %>
    <%= f.hidden_field :filter, value: @filter %>
    <%= f.hidden_field :production_id, value: @production_filter %>
    <%= f.hidden_field :order, value: @order %>
    <%= f.hidden_field :hat, value: @hat %>
  <% end %>

  <%# The shared filter bar, as every list has (Tim, 2026-10-21): Show, For
      (with organizations to run), the production dropdown when there's more
      than one, and the two round icon buttons. %>
  <%= render "shared/filters/filter_bar",
        toggle_label: "Filters",
        wrapper_data_controller: "filter-select",
        filter_groups: [
          { label: "Show", filters: show_chips.map { |text, href, on| { text: text, path: href, active: on } } },
          (@managed_organizations.any? ? { separator: true } : nil),
          (@managed_organizations.any? ? { label: "For", filters: hat_chips.map { |text, href, on| { text: text, path: href, active: on } } } : nil),
          (@inbox_productions.many? ? { separator: true } : nil),
          (@inbox_productions.many? ? {
            partial: "shared/filters/production_dropdown_filter",
            locals: {
              label: "Production", name: "production_id",
              options: [ { value: "", text: "All Productions" } ] + @inbox_productions.map { |p| { value: p.id.to_s, text: p.name, type: p.production_type } },
              selected: @production_filter.to_s,
              data_attributes: { action: "change->filter-select#update", filter_select_filter_value: @filter, filter_select_q_value: @search,
                                 filter_select_order_value: @order, filter_select_hat_value: @hat }
            }
          } : nil),
          { separator: true },
          { partial: "shared/messages/filter_icons", locals: { newest_path: path.call(order: "newest"), oldest_path: path.call(order: "oldest"), current_order: @order } }
        ].compact %>

  <% if @messages.any? %>
    <div data-message-density-target="list" class="mt-4 msg-density-compact border border-gray-200 rounded-lg overflow-hidden bg-white">
      <% @messages.each do |thread| %>
        <%
          production_side = production_side_thread?(thread)
          organization = thread.organization || thread.production&.organization
          here = in_production_mode && Current.organization && organization&.id == Current.organization.id
          pill = if production_side && organization
            { text: organization.name, tone: here ? "bg-pink-50 text-pink-700" : "bg-gray-100 text-gray-700", title: "#{organization.name} · Production" }
          end
          switching = production_side && organization && !here
          link_data = { action: "click->notification-open#open" }
          if switching
            link_data[:switch] = true
            link_data[:organization_name] = organization.name
            if in_production_mode
              link_data[:switch_title] = "Switch to #{organization.name}?"
              link_data[:switch_body] = "This thread is #{organization.name}'s. You'll switch to that organization to read it."
            else
              link_data[:switch_title] = "Open in production mode?"
              link_data[:switch_body] = "This lives in production mode for #{organization.name}. You'll switch there to read it, and can exit from the account menu."
            end
          end
        %>
        <%= render "shared/messages/compact_row", message: thread, summary: @thread_summaries[thread.id],
              message_path: open_my_message_path(thread), pill: pill, link_data: link_data %>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-6 flex items-center justify-between">
        <div class="text-sm text-gray-500">Page <%= @pagy.page %> of <%= @pagy.pages %></div>
        <div class="flex gap-2">
          <%= render "shared/button", text: "← Previous", variant: "secondary", size: "small", **(@pagy.previous ? { path: path.call(page: @pagy.previous) } : { disabled: true }) %>
          <%= render "shared/button", text: "Next →", variant: "secondary", size: "small", **(@pagy.next ? { path: path.call(page: @pagy.next) } : { disabled: true }) %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="mt-8 text-center py-12">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      <%
        empty_title, empty_message = case @filter
        when "unread" then [ "All caught up!", "You have no unread messages." ]
        when "sent_by_me" then [ "No messages sent", "You haven't sent any messages yet." ]
        when "archived" then [ "No archived messages", "You haven't archived any messages yet." ]
        else
          if @search.present? then [ "No results", "No messages match \"#{@search}\"." ]
          elsif @production_filter.present? then [ "No messages", "No messages for this production yet." ]
          elsif @hat == "performer" then [ "No messages", "Nothing sent to you as a performer yet." ]
          elsif @hat.present? then [ "No messages", "No messages for this organization's productions yet." ]
          else [ "No messages", "Messages from your productions, and to you, will appear here." ]
          end
        end
      %>
      <h3 class="mt-2 text-sm font-medium text-gray-900"><%= empty_title %></h3>
      <p class="mt-1 text-sm text-gray-500"><%= empty_message %></p>
    </div>
  <% end %>

  <%= render "shared/mode_switch_prompt" %>
</div>
