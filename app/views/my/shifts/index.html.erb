<% content_for :title, "My Shifts" %>

<div class="w-full">

  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [],
    text: "My Shifts",
    links: []
  } %>

  <%# === Tabs: my own shifts vs. the whole staff schedule === %>
  <div class="border-b border-gray-200 mb-6">
    <nav class="flex gap-6 -mb-px">
      <% tab_base = "inline-flex items-center px-1 py-2.5 border-b-2 text-sm font-medium transition-colors" %>
      <%= link_to "Me", my_shifts_path,
            class: "#{tab_base} #{@tab == 'mine' ? 'border-pink-500 text-pink-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}" %>
      <%= link_to "Everyone", my_shifts_path(tab: "all_staff"),
            class: "#{tab_base} #{@tab == 'all_staff' ? 'border-pink-500 text-pink-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}" %>
    </nav>
  </div>

  <% if @tab == "mine" %>
    <%# The whole personal hub shares one modal + time-entry-form controller so
        the confirm / add / edit triggers (in several sections) all reach the
        one shared modal at the bottom. %>
    <div data-controller="modal time-entry-form">
      <%# 1. Glance — money owed, hours, shifts, availability %>
      <%= render "my/shifts/summary" %>

      <%# 2. Act — anything that needs the worker's attention %>
      <% if @unconfirmed_shifts.any? %>
        <%= render "my/shifts/confirm_hours" %>
      <% end %>

      <%# 3. Plan — what's coming up %>
      <section class="mb-6">
        <h2 class="text-base font-semibold text-gray-900 mb-3">Upcoming shifts</h2>
        <% if @has_any %>
          <div class="space-y-6">
            <% @rows_by_day.each do |day, rows| %>
              <div>
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">
                  <%= day.strftime("%A, %B %-d, %Y") %>
                </h3>
                <div class="space-y-2">
                  <% rows.each do |row| %>
                    <% shift = row[:shift] %>
                    <% person = row[:person] %>
                    <% assignment = row[:assignment] %>
                    <% org = shift.organization %>
                    <% location_name = shift.source.try(:location).try(:name) %>
                    <div class="p-3 bg-white border border-gray-200 rounded-lg shadow-sm">
                      <div class="flex items-center gap-4">
                        <div class="flex-shrink-0 w-14 text-center">
                          <div class="text-xs font-semibold text-pink-600 uppercase"><%= shift.starts_at.strftime("%b") %></div>
                          <div class="text-2xl font-bold text-gray-900"><%= shift.starts_at.strftime("%-d") %></div>
                          <div class="text-xs text-gray-500"><%= shift.starts_at.strftime("%a") %></div>
                        </div>
                        <div class="flex-1 min-w-0">
                          <div class="font-medium text-gray-900 truncate"><%= shift.role_label %></div>
                          <div class="text-sm text-gray-600">
                            <span class="tabular-nums"><%= shift.starts_at.strftime("%-l:%M %p") %>–<%= shift.ends_at.strftime("%-l:%M %p") %></span>
                            <% if org %>· <%= org.name %><% end %>
                          </div>
                          <% if location_name.present? %>
                            <div class="text-xs text-gray-500 truncate mt-0.5"><%= location_name %></div>
                          <% end %>
                        </div>
                        <div class="flex-shrink-0 text-right">
                          <% case assignment.response_status %>
                          <% when :accepted %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded bg-green-100 text-green-700 text-xs font-medium">Accepted</span>
                          <% when :declined %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded bg-red-100 text-red-700 text-xs font-medium">Declined</span>
                          <% else %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded bg-gray-100 text-gray-600 text-xs font-medium">Scheduled</span>
                          <% end %>
                          <% if @people.size > 1 %>
                            <div class="text-[11px] text-gray-400 mt-1 truncate max-w-[8rem]"><%= person.name %></div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-center">
            <p class="text-sm text-gray-500">You don't have any upcoming shifts. We'll show them here once your schedule is posted.</p>
          </div>
        <% end %>
      </section>

      <%# 4. Set — when you can work %>
      <%= render "my/shifts/availability" %>

      <%# 5. Track — your logged hours %>
      <%= render "my/shifts/my_hours" %>

      <%= render "my/shifts/time_entry_modal" %>
    </div>

  <% else %>
    <%# === Everyone tab: full schedule calendar === %>
    <% if @staff_org_ids.any? %>
      <p class="text-sm text-gray-500 mb-4">Everyone's shifts for finalized weeks, this week onward. Yours are highlighted.</p>

      <%= render "shared/month_calendar",
            current_month: @cal_month,
            month_link: ->(t) { my_shifts_path(tab: "all_staff", month: t.strftime("%Y-%m-01")) },
            items_by_date: @shifts_by_date,
            item_partial: "my/shifts/all_staff_shift",
            start_from_current_week: true,
            dim_past: true,
            can_go_prev: @cal_month > Date.current.beginning_of_month,
            min_cell: "min-h-[110px]",
            empty_text: "No staff shifts scheduled this month." %>
    <% else %>
      <p class="text-gray-500 text-sm">You're not listed on any organization's house staff yet.</p>
    <% end %>
  <% end %>

</div>
