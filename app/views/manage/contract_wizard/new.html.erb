<% content_for :title, "New Contract" %>

<div class="w-full mb-10" data-controller="new-contract-contractor"
     data-new-contract-contractor-create-url-value="<%= manage_contractors_path %>">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Contracts", manage_contracts_path]
    ],
    text: "New Contract",
    links: []
  } %>

  <div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <div class="text-center mb-6">
        <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <%= icon("file-text", class: "w-8 h-8 text-pink-600") %>
        </div>
        <h2 class="text-xl font-bold text-gray-900">Who is this contract with?</h2>
        <p class="text-gray-600 mt-2">
          Choose the contractor. Next you'll say what the contract is for and how it gets signed.
        </p>
      </div>

      <%= form_with url: manage_create_draft_contract_wizard_path, method: :post, local: true,
                    data: { new_contract_contractor_target: "form" } do |form| %>
        <div class="space-y-5">
          <div data-new-contract-contractor-target="contractorSection">
            <% if @contractors.any? %>
              <label for="contractor_id" class="block text-sm font-medium text-gray-900 mb-1.5">
                Contractor
                <span class="text-pink-500">*</span>
              </label>

              <select name="contract[contractor_id]"
                      id="contractor_id"
                      required
                      data-new-contract-contractor-target="select"
                      class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
                <option value="">-- Choose a contractor --</option>
                <% @contractors.each do |contractor| %>
                  <option value="<%= contractor.id %>" <%= "selected" if contractor.id == @preselected_contractor_id %>><%= contractor.name %></option>
                <% end %>
              </select>

              <div class="mt-2">
                <%= render "shared/button", text: "Create new contractor", variant: "ghost", size: "small", icon: "plus", type: :button, data: { action: "click->new-contract-contractor#openModal" } %>
              </div>
            <% else %>
              <div class="border border-dashed border-gray-300 rounded-lg p-5 text-center">
                <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3">
                  <%= icon("users", class: "w-5 h-5 text-gray-400") %>
                </div>
                <p class="text-sm font-medium text-gray-900 mb-1">No contractors yet</p>
                <p class="text-xs text-gray-500 mb-4">Create a contractor first, then you can set up their contract.</p>
                <%= render "shared/button", text: "Create Contractor", variant: "primary", size: "medium", icon: "plus", type: :button, data: { action: "click->new-contract-contractor#openModal" } %>
              </div>
              <input type="hidden" name="contract[contractor_id]" value="" data-new-contract-contractor-target="select">
            <% end %>
          </div>
        </div>

        <div class="mt-8 flex justify-end">
          <%= render "shared/button", text: "Start Contract", variant: "primary", size: "medium", type: :submit %>
        </div>
      <% end %>
    </div>

    <div class="mt-4 text-center">
      <%= link_to "Cancel", manage_contracts_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    </div>
  </div>

  <%# New Contractor Modal %>
  <div id="new-contractor-modal"
       class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4"
       data-new-contract-contractor-target="modal"
       data-action="click->new-contract-contractor#closeOnBackdrop keydown.esc@window->new-contract-contractor#closeModal">
    <div class="bg-white rounded-lg shadow-xl max-w-lg w-full max-h-[90vh] overflow-y-auto"
         data-action="click->new-contract-contractor#stopPropagation">

      <%# Header %>
      <div class="flex items-center justify-between px-6 py-4 bg-gradient-to-r from-pink-500 to-pink-600">
        <h3 class="text-lg font-bold text-white">New Contractor</h3>
        <button type="button" data-action="click->new-contract-contractor#closeModal"
                class="text-white/80 hover:text-white">
          <%= icon("x-mark", class: "w-5 h-5") %>
        </button>
      </div>

      <%# The same questions as the full New Contractor page — name, email, and
          who they are on CocoScout — rendered from the same partials so the two
          can't drift. Submitted over fetch so the wizard keeps its place. %>
      <%= form_with model: Contractor.new, url: manage_contractors_path, method: :post,
                    data: { new_contract_contractor_target: "modalForm",
                            action: "submit->new-contract-contractor#createContractor" } do |f| %>
        <div class="px-6 py-5 space-y-5">
          <div>
            <label for="contractor_name" class="block text-sm font-medium text-gray-900 mb-1.5">
              Contractor name
              <span class="text-pink-500">*</span>
            </label>
            <%= f.text_field :name,
              placeholder: "e.g., Nuns4Fun Entertainment",
              required: true,
              data: { new_contract_contractor_target: "name" },
              class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
          </div>

          <div>
            <label for="contractor_email" class="block text-sm font-medium text-gray-900 mb-1.5">
              Email
            </label>
            <%= f.email_field :email,
              placeholder: "contact@example.com",
              class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
          </div>

          <%= render "manage/contractors/person_link_fields" %>

          <%= render "manage/contractors/more_details_fields", form: f %>

          <%# Error message %>
          <div data-new-contract-contractor-target="error" class="hidden text-sm text-red-600 bg-red-50 p-3 rounded-lg"></div>
        </div>

        <%# Footer %>
        <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-3">
          <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->new-contract-contractor#closeModal" } %>
          <%= render "shared/button", text: "Create Contractor", variant: "primary", size: "medium", type: :submit, data: { "new-contract-contractor-target": "submitBtn" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
