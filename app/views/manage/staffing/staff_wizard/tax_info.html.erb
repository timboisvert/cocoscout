<%= render layout: "manage/staffing/staff_wizard/wizard_layout", locals: { current_step: 9, step_name: "Tax info" } do %>
  <h2 class="text-xl font-bold text-gray-900 mb-2 coustard-regular">Their W-9</h2>
  <p class="text-gray-600 mb-6">
    <%= Current.organization.name %> pays staff as independent contractors, so you need a W-9 from
    <%= @staff_member.display_name %> to send their 1099.
  </p>

  <%= form_with url: manage_save_tax_info_staffing_staff_wizard_path, method: :post, multipart: true,
        data: { controller: "radio-toggle", "radio-toggle-show-value": "upload" } do %>
    <div class="space-y-2 mb-6">
      <% [
           [ "ask", "Ask them to fill it out while onboarding", "They'll get it as a step in their onboarding, and a weekly reminder until it's done." ],
           [ "upload", "I already have their W-9", "Upload the one they gave you (on paper, or through another system)." ],
           [ "exempt", "They don't need one", "For example, you pay them through payroll." ]
         ].each do |value, title, help| %>
        <label class="flex items-start gap-3 p-4 border border-gray-300 rounded-lg cursor-pointer has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 transition-colors">
          <input type="radio" name="w9_choice" value="<%= value %>" <%= "checked" if @w9_choice == value %>
                 class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500"
                 data-action="change->radio-toggle#update">
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-gray-900"><%= title %></span>
            <span class="block text-sm text-gray-600 mt-0.5"><%= help %></span>
          </span>
        </label>
      <% end %>
    </div>

    <div data-radio-toggle-target="content" class="<%= "hidden" unless @w9_choice == "upload" %> rounded-lg border border-gray-200 bg-gray-50 p-5 mb-6">
      <% if @staff_member.w9_received? && @w9_values.blank? %>
        <p class="text-sm text-green-700 mb-4">
          A W-9 is already on file for them (<%= @staff_member.current_w9.signed_at.strftime("%B %-d, %Y") %>). Upload another only to replace it.
        </p>
      <% end %>
      <%= render "manage/staffing/taxes/w9_upload_fields", values: @w9_values, required: false %>
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-gray-200">
      <%= link_to "← Back", manage_agreement_staffing_staff_wizard_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
      <%= render "shared/button", text: "Continue", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>
