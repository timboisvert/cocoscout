<% content_for :title, "Payouts Summary" %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <%= render "manage/reports/header", title: "Payouts Summary", subtitle: "Show payouts across your productions by status." %>

    <div class="grid gap-4 sm:grid-cols-3 mb-6">
      <div class="bg-white border border-gray-200 rounded-lg p-5">
        <div class="text-sm text-gray-500">Total payouts</div>
        <div class="text-3xl font-bold text-gray-900"><%= number_to_currency(@total_amount) %></div>
      </div>
      <div class="bg-white border border-gray-200 rounded-lg p-5">
        <div class="text-sm text-gray-500">Paid</div>
        <div class="text-3xl font-bold text-green-600"><%= number_to_currency(@paid_amount) %></div>
      </div>
      <div class="bg-white border border-gray-200 rounded-lg p-5">
        <div class="text-sm text-gray-500">Outstanding</div>
        <div class="text-3xl font-bold text-amber-600"><%= number_to_currency(@outstanding) %></div>
      </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <table class="w-full text-left text-sm">
        <thead class="bg-gray-50 text-gray-500">
          <tr>
            <th class="px-5 py-3 font-medium">Status</th>
            <th class="px-5 py-3 font-medium text-right">Count</th>
            <th class="px-5 py-3 font-medium text-right">Amount</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @by_status.each do |status, count| %>
            <tr>
              <td class="px-5 py-3 text-gray-900"><%= status.to_s.humanize %></td>
              <td class="px-5 py-3 text-right text-gray-600"><%= count %></td>
              <td class="px-5 py-3 text-right font-semibold text-gray-900"><%= number_to_currency(@amount_by_status[status] || 0) %></td>
            </tr>
          <% end %>
          <% if @by_status.empty? %>
            <tr><td colspan="3" class="px-5 py-8 text-center text-gray-400">No payouts recorded yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
