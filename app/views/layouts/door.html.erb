<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Door" %></title>
    <%# Full-bleed in a browser; inside the app its bars keep the page in the safe area. %>
    <meta name="viewport" content="<%= native_viewport(cover: true) %>">
    <meta name="robots" content="noindex">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# The door on show night: a phone-first page with nothing in the way.
      The header (Tim, 2026-10-18) says what this is, "Work the door", and
      whose door: the organization's name, as a link to its box office, with
      the date and time. Never a person's picture: someone handing over money
      should see the organization, not a stranger's face. In the app the native
      bar holds the title and the way back, so the header is just the
      organization and the time. %>
  <%
    door_organization = @listing&.organization || (@organizations&.one? ? @organizations.first : nil)
    door_profile = door_organization&.ticketing_profile
    door_org_link = door_profile&.enabled? ? tickets_box_office_path(org: door_profile.slug) : nil
    native = turbo_native_app?
  %>
  <body class="inter-regular text-slate-700 bg-gray-50">
    <header class="<%= native ? '' : 'sticky top-0 z-10' %> border-b border-gray-200 bg-white" style="padding-top: env(safe-area-inset-top)">
      <%# On a phone the organization and the time take their own line under
          the title (Tim, 2026-10-18); side by side only when there's room. %>
      <div class="mx-auto max-w-2xl px-3 py-2 min-h-[3.5rem] flex flex-wrap items-center gap-x-3 gap-y-0.5">
        <div class="flex items-center gap-2 flex-1 min-w-0">
          <%# A page that is one step inside a show (paying at the door) names
              itself and the way back; every other page is "Work the door". %>
          <% if content_for?(:door_header) %>
            <%= yield :door_header %>
          <% else %>
            <% if @listing && !native %>
              <%= link_to door_index_path, class: "flex-shrink-0 p-2 -ml-1 rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100", "aria-label": "All your shows" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              <% end %>
            <% end %>
            <% unless native %>
              <div class="min-w-0 flex-1 <%= 'pl-1' unless @listing %>">
                <div class="coustard-regular text-xl leading-tight text-gray-900">Work the door</div>
              </div>
            <% end %>
          <% end %>
        </div>
        <div class="basis-full sm:basis-auto min-w-0 flex items-baseline gap-x-2 sm:flex-col sm:items-end sm:gap-0 <%= 'pl-1' if !native && !@listing %> <%= 'pl-9' if !native && @listing && !content_for?(:door_header) %>">
          <% if door_organization %>
            <% if door_org_link %>
              <%= link_to door_organization.name, door_org_link, class: "text-sm font-semibold text-pink-600 hover:text-pink-700 truncate" %>
            <% else %>
              <span class="text-sm font-semibold text-gray-900 truncate"><%= door_organization.name %></span>
            <% end %>
          <% elsif @organizations&.many? %>
            <span class="text-sm font-semibold text-gray-900 truncate"><%= pluralize(@organizations.size, "organization") %></span>
          <% end %>
          <span class="text-xs text-gray-500 tabular-nums whitespace-nowrap"><span class="sm:hidden"><%= "· " if door_organization || @organizations&.many? %></span><%= Time.current.strftime("%a, %b %-d · %-l:%M %p") %></span>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-2xl px-4 py-5">
      <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
      <%= yield %>
    </main>
    <%= render "shared/native/bridge" %>
  </body>
</html>
