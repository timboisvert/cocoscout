<%# Inside the cancel form: the students registered for the class sessions
    being canceled, and the email they'd get (editable, {{first_name}} and
    friends filled in per student). On by default. Locals: students
    ({ scope => CourseSessionCancellation::Summary }), subject, body. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  this = students["this"]
  scope_lines = { "this" => "This session", "this_and_future" => "This and future sessions", "all" => "Every session" }
%>
<div class="py-3 border-b border-gray-100">
  <div class="flex items-center justify-between gap-4">
    <div>
      <p class="text-sm font-medium text-gray-700">Email the students</p>
      <p class="text-xs text-gray-500 mt-1">Everyone registered for the course hears which sessions are canceled. The rest of the course goes ahead.</p>
    </div>
    <label class="relative inline-flex items-center cursor-pointer">
      <input type="hidden" name="email_students" value="0">
      <input type="checkbox" name="email_students" value="1" checked class="sr-only peer">
      <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-pink-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-pink-500"></div>
    </label>
  </div>

  <%# Only the scope picked above (cancel-show#toggleScope shows the matching line). %>
  <div class="mt-3 rounded-lg bg-gray-50 border border-gray-200 px-4 py-3 text-sm">
    <% students.each do |scope, summary| %>
      <div class="flex justify-between gap-4 <%= 'hidden' unless scope == 'this' %>" data-cancel-show-target="refundScope" data-scope="<%= scope %>">
        <span class="text-gray-700"><%= scope_lines.fetch(scope) %></span>
        <span class="tabular-nums text-gray-900"><%= pluralize(summary.registrations.size, "student") %></span>
      </div>
    <% end %>
  </div>

  <% if this.any? %>
    <details class="mt-3">
      <summary class="cursor-pointer text-sm font-medium text-pink-600 hover:text-pink-700">Who's registered</summary>
      <ul class="mt-2 divide-y divide-gray-100 max-h-56 overflow-y-auto text-sm">
        <% this.registrations.each do |registration| %>
          <li class="py-1.5 truncate text-gray-900"><%= registration.person&.name || "No name" %> <span class="text-gray-500"><%= registration.person&.email %></span></li>
        <% end %>
      </ul>
    </details>
  <% end %>

  <div class="mt-4 space-y-3">
    <p class="text-xs text-gray-500">The email each student gets. Words in double braces, like {{first_name}} and {{sessions}}, are filled in for each person.</p>
    <div>
      <label for="course_email_subject" class="block text-sm font-medium text-gray-700 mb-1.5">Subject</label>
      <%= text_field_tag :course_email_subject, subject, class: input_class %>
    </div>
    <div>
      <label for="course_email_body" class="block text-sm font-medium text-gray-700 mb-1.5">Message</label>
      <%= text_area_tag :course_email_body, body, rows: 6, class: input_class %>
    </div>
  </div>
</div>
