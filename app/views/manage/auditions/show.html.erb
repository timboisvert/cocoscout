<% content_for :title, "Audition" %>
<% audition_session = @audition.audition_session %>
<% can_vote = current_user_can_review?(@production) && @audition_cycle.audition_voting_enabled && @audition_cycle.active %>
<div class="w-full <%= can_vote ? 'pb-48 lg:pb-40' : 'pb-8' %> relative">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%# Archived stamp - inky rubber stamp effect %>
  <% unless @audition_cycle.active %>
    <div class="absolute top-20 right-24 z-30 pointer-events-none">
      <div class="transform rotate-12 px-6 py-3 relative" style="filter: url(#inkFilter);">
        <svg class="absolute" width="0" height="0">
          <defs>
            <filter id="inkFilter" x="-20%" y="-20%" width="140%" height="140%">
              <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="5" result="noise"/>
              <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
          </defs>
        </svg>
        <div class="border-4 border-red-400/60 rounded px-5 py-2 bg-transparent text-center" style="border-style: double; border-width: 4px;">
          <span class="text-red-400/70 font-black text-3xl tracking-widest uppercase block" style="font-family: 'Courier New', monospace; text-shadow: 1px 1px 0 rgba(239,68,68,0.2), -1px -1px 0 rgba(239,68,68,0.1);">ARCHIVED</span>
          <span class="text-red-400/50 text-xs tracking-wide block mt-1" style="font-family: 'Courier New', monospace;"><%= @audition_cycle.updated_at.strftime("%b %-d, %Y") %></span>
        </div>
        <div class="absolute -top-1 -left-1 w-2 h-2 bg-red-400/30 rounded-full blur-[1px]"></div>
        <div class="absolute -bottom-1 -right-2 w-3 h-1 bg-red-400/20 rounded-full blur-[1px]"></div>
        <div class="absolute top-1/2 -left-2 w-1 h-3 bg-red-400/25 rounded-full blur-[1px]"></div>
      </div>
    </div>
  <% end %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Sign-ups", manage_signups_path],
      [@production.name, manage_signups_production_path(@production)],
      ["Auditions", manage_signups_auditions_path(@production)],
      ["Sessions", manage_signups_auditions_cycle_sessions_path(@production, @audition_cycle)],
      [audition_session.start_at.strftime("%b %-d, %Y at %-l:%M %p"), manage_signups_auditions_cycle_session_path(@production, @audition_cycle, audition_session)]
    ],
    text: @auditionable&.name&.truncate(40, omission: "...") || "Audition",
    links: []
  } %>

  <%# Hero Section %>
  <% if @auditionable.present? %>
    <div class="flex flex-col md:flex-row md:items-center gap-3 md:gap-4 mb-4">
      <div class="flex items-center gap-4 flex-1 min-w-0">
        <% if @auditionable.respond_to?(:safe_headshot_variant) %>
          <% headshot_variant = @auditionable.safe_headshot_variant(:thumb) %>
          <% if headshot_variant %>
            <%= image_tag headshot_variant, class: "w-12 h-12 rounded-lg object-cover flex-shrink-0" %>
          <% else %>
            <div class="w-12 h-12 rounded-lg bg-gray-100 flex items-center justify-center text-black font-bold flex-shrink-0">
              <%= @auditionable.respond_to?(:initials) ? @auditionable.initials : @auditionable.name[0..1].upcase %>
            </div>
          <% end %>
        <% end %>
        <div class="flex-1 min-w-0">
          <div class="flex items-baseline gap-2 min-w-0">
            <div class="font-bold text-xl text-gray-900 truncate flex-shrink"><%= @auditionable.name %></div>
            <% if @auditionable.respond_to?(:pronouns) && @auditionable.pronouns.present? %>
              <div class="text-sm text-gray-500 flex-shrink-0">(<%= @auditionable.pronouns %>)</div>
            <% end %>
          </div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500">
            <% if @auditionable.respond_to?(:email) && @auditionable.email.present? %>
              <%= link_to @auditionable.email, "mailto:#{@auditionable.email}", class: "text-pink-500 hover:underline" %>
            <% end %>
          </div>
        </div>
      </div>
      <% if @auditionable.respond_to?(:public_key) && @auditionable.public_key.present? %>
        <div class="flex items-center gap-2 flex-shrink-0"
             data-controller="compose-message"
             data-compose-message-recipient-type-value="person"
             data-compose-message-recipient-id-value="<%= @auditionable.id %>"
             data-compose-message-recipient-name-value="<%= @auditionable.name %>"
             data-compose-message-recipient-headshot-value="<%= @auditionable.safe_headshot_variant(:thumb) ? url_for(@auditionable.safe_headshot_variant(:thumb)) : '' %>">
          <% if @auditionable.is_a?(Person) %>
            <%= render "shared/button", text: "Contact", variant: "outline", size: "small", type: :button, data: { action: "click->compose-message#open" } %>
          <% end %>
          <%= render partial: "shared/button", locals: { text: "Public Profile", path: public_profile_path(@auditionable.public_key), variant: "outline", size: "small", target: "_blank" } %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="space-y-4">

    <%# Headshots, Resume, Socials, History %>
    <% if @auditionable.present? %>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="border border-gray-200 rounded-lg p-3">
          <%= render "shared/media_thumbnails", items: @profile_headshots, type: "headshot", label: "Headshots" %>
        </div>
        <div class="border border-gray-200 rounded-lg p-3">
          <%= render "shared/media_thumbnails", items: @profile_resumes, type: "resume", label: "Resume" %>
        </div>
        <div class="border border-gray-200 rounded-lg p-3">
          <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Socials</div>
          <% if @socials.any? %>
            <div class="space-y-1.5">
              <% @socials.each do |social| %>
                <div class="flex items-center gap-2">
                  <span class="text-gray-400 flex-shrink-0"><%= social.icon(18) %></span>
                  <% if social.url.present? %>
                    <%= link_to social.display_name, social.url, target: "_blank", rel: "noopener", class: "text-sm text-pink-500 hover:underline truncate" %>
                  <% else %>
                    <span class="text-sm text-gray-700 truncate"><%= social.display_name %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-400 italic">No socials</p>
          <% end %>
        </div>
        <% if @auditionable.is_a?(Person) %>
          <%= render partial: "manage/people/history_box",
                    locals: { person: @auditionable, entry: PersonHistoryFeed.new(@auditionable).most_recent } %>
        <% else %>
          <div class="border border-gray-200 rounded-lg p-3">
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">History</div>
            <p class="text-sm text-gray-400">Group history not available yet</p>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Video %>
    <% if @audition_request&.audition_cycle&.accepts_video_submissions? && @audition_request&.video_url.present? %>
      <div class="border border-gray-200 rounded-lg p-3">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Video</div>
        <%= render "manage/audition_requests/video", audition_request: @audition_request %>
      </div>
    <% end %>

    <%# Questions & Availability side by side %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <%# Audition Questions %>
      <div class="border border-gray-200 rounded-lg p-3">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Audition Questions</div>
        <% if @answers.any? %>
          <%= render "manage/audition_requests/answers", answers: @answers %>
        <% else %>
          <p class="text-sm text-gray-400 italic">No questions answered</p>
        <% end %>
      </div>

      <%# Availability %>
      <div class="border border-gray-200 rounded-lg p-3">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Availability</div>
        <% has_show_availability = @audition_cycle.include_availability_section && @shows&.present? %>
        <% has_session_availability = @audition_cycle.include_audition_availability_section && @audition_sessions_list&.present? %>
        <% if has_show_availability || has_session_availability %>
          <div class="divide-y divide-gray-100">
            <% if has_show_availability %>
              <% @shows.each do |show| %>
                <% availability = @show_availabilities[show.id] %>
                <div class="flex items-center justify-between py-1.5 gap-2 text-xs">
                  <div class="flex items-center gap-1.5 min-w-0 flex-1">
                    <span class="text-gray-500 flex-shrink-0 w-12"><%= show.date_and_time.strftime("%b %-d") %></span>
                    <span class="text-gray-900 truncate"><%= show.display_name %></span>
                  </div>
                  <% if availability %>
                    <span class="flex-shrink-0 text-xs font-medium <%= availability.status == 'available' ? 'text-pink-500' : 'text-gray-400' %>"><%= availability.status == 'available' ? 'A' : 'U' %></span>
                  <% else %>
                    <span class="flex-shrink-0 text-xs font-medium text-gray-300">&ndash;</span>
                  <% end %>
                </div>
              <% end %>
            <% end %>

            <% if has_session_availability %>
              <% if has_show_availability %>
                <div class="pt-2 pb-1">
                  <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-wide">Audition Sessions</span>
                </div>
              <% end %>
              <% @audition_sessions_list.each do |session| %>
                <% current_status = @audition_availability&.dig("#{session.id}") %>
                <div class="flex items-center justify-between py-1.5 gap-2 text-xs">
                  <div class="flex items-center gap-1.5 min-w-0 flex-1">
                    <span class="text-gray-500 flex-shrink-0 w-12"><%= session.start_at.strftime("%b %-d") %></span>
                    <span class="text-gray-900 truncate"><%= session.start_at.strftime("%l:%M %p").strip %></span>
                  </div>
                  <% if current_status.present? %>
                    <span class="flex-shrink-0 text-xs font-medium <%= current_status == 'available' ? 'text-pink-500' : 'text-gray-400' %>"><%= current_status == 'available' ? 'A' : 'U' %></span>
                  <% else %>
                    <span class="flex-shrink-0 text-xs font-medium text-gray-300">&ndash;</span>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-400 italic">No availability requested</p>
        <% end %>
      </div>
    </div>

    <%# Votes box %>
    <div id="votes-list-container" class="<%= 'hidden' unless @votes.any? %> border border-gray-200 rounded-lg p-3">
      <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Votes</div>
      <div id="votes-list">
        <%= render partial: "manage/audition_requests/votes_list", locals: { votes: @votes } %>
      </div>
    </div>

  </div>
</div>

<% if can_vote %>
  <%# The shared vote bar (shared/_vote_bar): the same one as a request's page. %>
  <%= render "shared/vote_bar",
        title: "Should this #{@auditionable.is_a?(Person) ? "person" : "group"} be added to #{@production.name}'s talent pool?",
        vote_url: manage_cast_vote_signups_auditions_cycle_session_audition_path(@production, @audition_cycle, audition_session, @audition),
        current_vote: @audition.vote_for(Current.user), vote_counts: @audition.vote_counts,
        previous_path: (@prev_audition && manage_signups_auditions_cycle_session_audition_path(@production, @audition_cycle, audition_session, @prev_audition)),
        next_path: (@next_audition && manage_signups_auditions_cycle_session_audition_path(@production, @audition_cycle, audition_session, @next_audition)) %>
<% end %>

<%# Compose Message Modal %>
<%= render "shared/compose_message_modal" %>
