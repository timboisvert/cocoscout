<% content_for :title, "Create Contract - #{local_assigns[:step_name] || 'Setup'}" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Contracts", manage_contracts_path]
    ],
    text: "New Contract",
    links: []
  } %>

  <%
    # Settlement-first flow. Schedule merges bookings + preview (internal steps 2 &
    # 3 both read as "Schedule"); Financials comes before everything downstream;
    # Ticketing only appears once we're the ones selling; e-sign contracts skip the
    # Documents (upload) step since they generate their PDF.
    persisted = defined?(@contract) && @contract.persisted?
    esign = persisted && @contract.signing_mode_esign?
    # The data-collection steps, in order.
    data_steps = [
      # "About" (step 1) covers the two setup micro-steps: production + signing.
      { num: 1, name: "About", path: persisted ? manage_production_contract_wizard_path(@contract) : nil },
      { num: 2, name: "Schedule", path: persisted ? manage_bookings_contract_wizard_path(@contract) : nil },
      { num: 4, name: "Financials", path: persisted ? manage_payments_contract_wizard_path(@contract) : nil }
    ]
    data_steps << { num: 5, name: "Ticketing", path: manage_ticketing_contract_wizard_path(@contract) } if persisted && @contract.org_sells_tickets?
    data_steps << { num: 6, name: "Services", path: persisted ? manage_tech_contract_wizard_path(@contract) : nil }
    data_steps << { num: 7, name: "Documents", path: persisted ? manage_documents_contract_wizard_path(@contract) : nil } unless esign
    data_steps << { num: 8, name: esign ? "Review" : "Review", path: persisted ? manage_review_contract_wizard_path(@contract) : nil }

    if esign && @step && @step >= 9
      # Document phase (Prepare/Sign/Send): the whole data journey compresses into a
      # single clickable "Set up" group, followed by the three document steps.
      wizard_steps = [
        { name: "Set up", path: manage_review_contract_wizard_path(@contract), substeps: data_steps },
        { name: "Prepare", path: manage_prepare_contract_wizard_path(@contract) },
        { name: "Sign", path: manage_sign_contract_wizard_path(@contract) },
        { name: "Send", path: manage_send_contract_wizard_path(@contract) }
      ]
      current_index = { 9 => 1, 10 => 2, 11 => 3 }[@step] || 0
    else
      # Data phase: the collection steps, expanded. (Normalize schedule-preview 3→2.)
      current_step = @step == 3 ? 2 : @step
      wizard_steps = data_steps
      current_index = wizard_steps.index { |s| s[:num] == current_step } || 0
    end
  %>
  <%# Full-width step bar, directly below the breadcrumb. %>
  <%= render "shared/wizard_steps", steps: wizard_steps, current_index: current_index %>

  <div class="<%= local_assigns[:width].presence || "max-w-2xl" %> mx-auto">
    <!-- Step Content -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <%= yield %>
    </div>

    <!-- Cancel Link -->
    <% if defined?(@contract) && @contract.persisted? %>
      <div class="mt-4 text-center">
        <button type="button"
            data-controller="modal" data-action="click->modal#open" data-modal-id="confirm-cancel-contract-wizard-<%= @contract.id %>"
            class="text-sm text-gray-500 hover:text-gray-700 bg-transparent border-0 cursor-pointer p-0">Cancel</button>
        <%= render "shared/confirm_modal",
            id: "confirm-cancel-contract-wizard-#{@contract.id}",
            title: "Cancel?",
            message: "Are you sure you want to cancel? This draft will be deleted.",
            confirm_text: "Cancel",
            url: manage_cancel_contract_wizard_path(@contract),
            method: :delete %>
      </div>
    <% end %>
  </div>
</div>
