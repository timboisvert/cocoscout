<%#
  The kind of event a night is (Tim, 2026-11-22), as colored badges.
  Locals: event_types (array of event type keys; one per kind, usually one).
%>
<% Array(event_types).compact.uniq.each do |event_type| %>
  <span class="ml-1 inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset <%= event_type_badge_classes(event_type) %>"><%= event_type_label(event_type) %></span>
<% end %>
