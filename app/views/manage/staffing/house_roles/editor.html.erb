<%= turbo_frame_tag "house_roles_manager" do %>
  <div class="space-y-2">
    <% if @house_roles.any? %>
      <% @house_roles.each do |role| %>
        <div class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-lg px-3 py-2"
             data-role-id="<%= role.id %>" data-role-name="<%= role.name %>"
             data-role-default-rate="<%= (d = role.flat? ? role.default_flat_rate_dollars : role.default_hourly_rate_dollars) ? format("%.2f", d) : "" %>"
             data-role-unit="<%= role.flat? ? "/shift" : "/hr" %>">
          <span class="text-sm text-gray-900 flex items-center gap-2">
            <%= role.name %>
            <% if role.show_specific? %><span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-50 text-purple-700">Per-show</span><% end %>
          </span>
          <% role_cid = "confirm-remove-role-#{role.id}" %>
          <%= render "shared/button", text: "", icon: "trash", variant: "ghost", size: "small", type: :button,
                data: { controller: "modal", action: "click->modal#open", modal_id: role_cid } %>
          <%= render "shared/confirm_modal", id: role_cid,
                title: "Remove role?",
                message: "Remove the #{role.name} role?",
                confirm_text: "Remove",
                url: manage_destroy_staffing_house_role_path(role, return_to: "editor"), method: :delete %>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-400 py-2">No roles yet — add your first below.</p>
    <% end %>
  </div>

  <div class="mt-5 pt-4 border-t border-gray-200">
    <h4 class="text-sm font-semibold text-gray-900 mb-3">Add a role</h4>
    <%= form_with url: manage_create_staffing_house_role_path, method: :post, class: "space-y-4" do %>
      <input type="hidden" name="return_to" value="editor">

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Role name</label>
        <input type="text" name="house_role[name]" placeholder="e.g. Bartender" required
               class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">How many needed by default</label>
        <input type="number" name="house_role[default_required_count]" value="1" min="1"
               class="w-24 px-3 py-2 border border-gray-300 rounded-lg text-sm text-center focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
        <p class="mt-1 text-xs text-gray-500">How many people this role usually needs per show. You can change it per shift later.</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Default hourly pay</label>
        <div class="relative w-32">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">$</span>
          <input type="text" inputmode="decimal" name="house_role[default_hourly_rate_dollars]" placeholder="0.00"
                 class="w-full pl-7 pr-3 py-2 border border-gray-300 rounded-lg text-sm text-right focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
        </div>
        <p class="mt-1 text-xs text-gray-500">Pre-fills each staff member's rate for this role. Leave blank for none.</p>
      </div>

      <label class="flex items-start gap-2.5 p-3 rounded-lg border border-gray-200 cursor-pointer hover:border-pink-300">
        <input type="checkbox" name="house_role[role_type]" value="show_specific" class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
        <span class="text-sm text-gray-700">
          <span class="block font-medium text-gray-900">Per-show role</span>
          <span class="block text-xs text-gray-500 mt-0.5">One shift per show, rather than one shift for the whole evening.</span>
        </span>
      </label>

      <div class="flex justify-end">
        <%= render "shared/button", text: "Add role", variant: "primary", size: "small", type: :submit %>
      </div>
    <% end %>
  </div>
<% end %>
