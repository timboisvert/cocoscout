<% content_for :title, "#{@show.display_name} - #{show_display_name(@show)}" %>
<%# A show's money as a record to read (Tim, 2026-11-04): the card its day
    shows on Settle up, read-only, and what was left after everything.
    Nothing is entered here; the day is where the money is typed, confirmed
    and paid. A show from before the Settle up start date says how to bring
    it in. %>
<%
  money = ->(cents) { cents.negative? ? "−#{number_to_currency(-cents / 100.0)}" : number_to_currency(cents / 100.0) }
  fin = @show_financials
  pay = @piece.pay
  starts = Current.organization.settle_up_starts_on
  day_words = @date.strftime("%A, %B %-d")
  day_button = { text: "Settle up, #{@date.strftime('%b %-d')}", path: manage_money_settle_up_day_path(@date.iso8601, open: @show.id, anchor: "show-#{@show.id}") }
  page_title = @show.name_subtitle.presence || "#{@show.event_type.titleize}: #{@show.date_and_time.strftime('%B %-d, %Y')} at #{@show.date_and_time.strftime('%-I:%M %p')}"

  # What was left: what came in, less what the show cost and what it paid out.
  revenue_cents = @piece.in_cents
  expenses_cents = @piece.expenses_cents
  allocations = @production_expense_allocations.to_a
  production_cents = allocations.sum { |a| (a.allocated_amount.to_f * 100).round }
  paid_label, paid_cents = if pay.contract?
    names = pay.payments.filter_map { |p| p.contract&.contractor&.name }.uniq
    [ "By contract#{names.any? ? " to #{names.to_sentence}" : ''}", pay.total_cents ]
  elsif pay.performers? && @show_payout&.calculated_at.present?
    [ "Paid to #{pluralize(pay.rows.size, 'performer')}", pay.total_cents ]
  else
    [ nil, 0 ]
  end
  left_cents = revenue_cents - expenses_cents - production_cents - paid_cents
  notes = fin.notes.to_s.strip
  row = ->(label, note, value, strong: false) { %(<div class="flex items-baseline justify-between gap-3 py-1.5 text-sm #{strong ? 'font-semibold border-t border-gray-200 mt-1 pt-2.5' : ''}"><span class="#{strong ? 'text-gray-900' : 'text-gray-700'}">#{ERB::Util.html_escape(label)}#{note.present? ? %( <span class="text-xs font-normal text-gray-500">#{ERB::Util.html_escape(note)}</span>) : ''}</span><span class="tabular-nums text-gray-900">#{value}</span></div>).html_safe }
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Money", manage_money_index_path],
      ["Financials", manage_money_financials_path],
      [@production.name, manage_money_production_financials_path(@production)]
    ],
    text: page_title,
    links: []
  } %>

  <% if !@show.revenue_event? && !@piece.non_revenue? %>
    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 text-sm text-gray-600">
      <%= @show.event_type.titleize %>s don't take money, so there's nothing on record for this one.
    </div>
  <% else %>
    <% if @in_settle_up && @day.settled? %>
      <%= render "shared/alert_panel",
            eyebrow: "Settled",
            headline: "Settled with #{day_words}",
            body: "This is the record of the show's money. To change anything, reopen the day.",
            actions: [ day_button ] %>
    <% elsif @in_settle_up %>
      <%= render "shared/alert_panel", tone: :amber,
            eyebrow: "Not settled yet",
            headline: "Settles with #{day_words}",
            body: "Its money is entered, confirmed and paid from the day. This page is the record of it.",
            actions: [ day_button ] %>
    <% elsif starts %>
      <%= render "shared/alert_panel", tone: :amber,
            eyebrow: "Before Settle up",
            headline: "From before Settle up started",
            body: "Settle up starts on #{starts.strftime('%B %-d, %Y')}, so this show stays as it was left. To change it, move the start date earlier: days already confirmed come in settled, and you reopen the one you need.",
            actions: (module_change?(:settle_up) ? [ { text: "Change the start date", path: manage_money_settings_section_path(section: "settle_up") } ] : []) %>
    <% end %>

    <div class="space-y-4">
      <%= render "manage/settlement_days/show_piece", piece: @piece, day: @day, can_change: false, open_show_id: @show.id %>

      <section class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-200">
          <h2 class="text-base font-semibold text-gray-900">What was left</h2>
        </div>
        <div class="px-5 py-3 max-w-xl">
          <%= row.call("Came in", (@piece.non_revenue? ? "this show had no revenue" : nil), money.call(revenue_cents)) %>
          <% if expenses_cents.positive? %>
            <%= row.call("Show expenses", nil, money.call(-expenses_cents)) %>
          <% end %>
          <% if production_cents.positive? %>
            <%= row.call("Its share of production expenses", allocations.map { |a| a.production_expense.name }.to_sentence, money.call(-production_cents)) %>
          <% end %>
          <% if paid_label && paid_cents.positive? %>
            <%= row.call(paid_label, nil, money.call(-paid_cents)) %>
          <% end %>
          <%= row.call("What was left", nil, money.call(left_cents), strong: true) %>
        </div>
      </section>

      <% if notes.length > 70 %>
        <section class="bg-white border border-gray-200 rounded-xl overflow-hidden">
          <div class="px-5 py-3 border-b border-gray-200">
            <h2 class="text-base font-semibold text-gray-900">Notes</h2>
          </div>
          <p class="px-5 py-3 text-sm text-gray-700 whitespace-pre-wrap"><%= notes %></p>
        </section>
      <% end %>
    </div>
  <% end %>
</div>
