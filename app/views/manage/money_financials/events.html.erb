<%# Slim inline detail for one production, loaded lazily into the accordion on the
    all-productions financials list. For a course: its revenue basics. Otherwise:
    per-show revenue rows whose columns line up with the parent (Revenue / Costs /
    Profit). Row links use _top so they escape the Turbo frame. %>
<%= turbo_frame_tag "prod-events-#{@production.id}" do %>
  <% if @production.type_course? %>
    <% if @course.blank? %>
      <div class="py-2 pl-7 pr-3 text-xs text-gray-500">No course set up yet.</div>
    <% else %>
      <%# Same money-in / money-out breakdown as a production, in the same columns. %>
      <div class="divide-y divide-gray-100">
        <%= render "shared/slim_list_row",
          title: "Registrations",
          subtitle: "#{@course[:confirmed_count]} confirmed#{@course[:refunded_count].to_i.positive? ? " · #{@course[:refunded_count]} refunded" : ''}",
          cells: [
            { value: number_to_currency(@course[:gross_cents] / 100.0) },
            { value: "" },
            { value: "" }
          ] %>
        <%= render "shared/slim_list_row",
          title: "Platform fee",
          cells: [
            { value: "" },
            { value: "−#{number_to_currency(@course[:fee_cents] / 100.0)}", class: "text-red-600" },
            { value: "" }
          ] %>
        <% if @course[:payout_cents].to_i.positive? %>
          <%= render "shared/slim_list_row",
            title: "Payouts",
            cells: [
              { value: "" },
              { value: "−#{number_to_currency(@course[:payout_cents] / 100.0)}", class: "text-red-600" },
              { value: "" }
            ] %>
        <% end %>
      </div>
    <% end %>
  <% elsif @shows.any? %>
    <div class="divide-y divide-gray-100">
      <% @shows.each do |show| %>
        <%
          financials = show.show_financials
          revenue = financials&.total_revenue || 0
          costs = (financials&.calculated_expenses || 0) + (financials&.calculated_production_expenses || 0)
          profit = revenue - costs

          if show.canceled?
            status = "Canceled"
          elsif financials&.data_confirmed?
            status = "Complete"
          elsif financials&.has_data?
            status = "Needs review"
          else
            status = "Needs data"
          end

          title = "#{show.date_and_time.strftime('%b %-d, %Y')} · #{show.display_name}"
        %>
        <%= render "shared/slim_list_row",
          title: title,
          subtitle: status,
          href: manage_money_show_financials_path(show),
          href_data: { turbo_frame: "_top" },
          cells: [
            { value: number_to_currency(revenue) },
            { value: number_to_currency(costs), class: costs > 0 ? "text-red-600" : "text-gray-400" },
            { value: number_to_currency(profit), class: (profit > 0 ? "text-green-600" : profit < 0 ? "text-red-600" : "text-gray-900") }
          ] %>
      <% end %>
    </div>
  <% else %>
    <div class="py-2 pl-7 pr-3 text-xs text-gray-500">No revenue events yet.</div>
  <% end %>
<% end %>
