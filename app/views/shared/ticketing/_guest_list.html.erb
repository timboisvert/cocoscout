<%# Who's coming to a show: one row per order still holding tickets.
    Locals: orders (TicketOrder, tickets loaded), read_only (producers see
    names and counts, never emails or links to orders), changeable_ids
    (optional: the comps the reader may change, TicketComps.changeable_ids;
    each gets a dot menu with Edit and Remove, whose modals
    shared/ticketing/own_comp_modals renders beside the list; the card
    around the list must not clip, or the menu is cut off on the last row). %>
<%
  read_only = local_assigns.fetch(:read_only, false)
  changeable_ids = local_assigns[:changeable_ids] || []
  channel_badges = { "comp" => [ "Comp", "bg-blue-100 text-blue-700" ], "door_cash" => [ "Door", "bg-green-100 text-green-700" ],
                     "door_card" => [ "Door", "bg-green-100 text-green-700" ], "door_tap" => [ "Door", "bg-green-100 text-green-700" ] }
%>
<% if orders.empty? %>
  <p class="px-5 py-6 text-sm text-gray-500">Nobody yet.</p>
<% else %>
  <ul class="divide-y divide-gray-100">
    <% orders.each do |order| %>
      <% held = order.tickets.select { |t| Ticket::SOLD_STATUSES.include?(t.status) } %>
      <% inside = held.count(&:checked_in?) %>
      <% by_tier = held.group_by(&:type_label).map { |label, ts| "#{ts.size} × #{label}" }.join(", ") %>
      <% items = order.ticket_order_items.select(&:sold?) %>
      <% badge = channel_badges[order.channel] %>
      <% undone = held.empty? %>
      <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 py-2.5">
        <div class="min-w-[12rem] flex-1">
          <div class="text-sm font-medium <%= undone ? 'text-gray-500' : 'text-gray-900' %>">
            <% if read_only %>
              <span class="<%= 'line-through decoration-gray-300' if undone %>"><%= order.buyer_name.presence || "No name" %></span>
            <% else %>
              <%= link_to order.buyer_name.presence || "No name", manage_ticket_order_path(order.id), class: "hover:text-pink-600 #{'line-through decoration-gray-300' if undone}" %>
            <% end %>
            <% if undone %>
              <span class="ml-1 inline-block"><%= render "manage/ticket_orders/status_badge", order: order %></span>
            <% elsif badge %>
              <span class="ml-1 inline-flex rounded-md px-1.5 py-0.5 text-xs font-medium <%= badge[1] %>"><%= badge[0] %></span>
            <% end %>
          </div>
          <% unless read_only %>
            <div class="text-xs text-gray-500"><%= [ order.code, order.buyer_email ].compact_blank.join(" · ") %><%= " · #{order.note}" if order.note.present? %></div>
          <% end %>
        </div>
        <div class="text-sm text-gray-700">
          <%= by_tier.presence || order.tickets.group_by(&:type_label).map { |label, ts| "#{ts.size} × #{label}" }.join(", ") %>
          <% items.each do |item| %>
            <span class="ml-1 inline-flex rounded-md px-1.5 py-0.5 text-xs font-medium <%= item.fulfilled? ? 'bg-gray-100 text-gray-600' : 'bg-pink-100 text-pink-700' %>"><%= item.label %></span>
          <% end %>
        </div>
        <div class="sm:w-28 sm:text-right text-xs <%= inside == held.size && held.any? ? 'text-green-700 font-medium' : 'text-gray-500' %>">
          <%= held.empty? ? "" : (inside.zero? ? "Not checked in yet" : "#{inside} of #{held.size} checked in") %>
        </div>
        <% if changeable_ids.include?(order.id) && held.any? %>
          <%# A comp the reader may change: Edit and Remove behind the row's
              dot menu, each opening its modal (shared/ticketing/own_comp_modals).
              No word on who issued it (Tim, 2026-11-17: it doesn't matter). %>
          <div class="ml-auto" data-changeable-comp="<%= order.id %>">
            <%= render "shared/action_menu", id: "comp-#{order.id}-actions", title: order.buyer_name.presence || "This comp", label: "Edit or remove this comp", items: [
                  { text: "Edit", path: "#", icon: "M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z",
                    data: { controller: "modal", action: "click->modal#open click->dropdown#close", modal_id: "edit-comp-#{order.id}" } },
                  { text: "Remove", path: "#", icon: "M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16",
                    data: { controller: "modal", action: "click->modal#open click->dropdown#close", modal_id: "remove-comp-#{order.id}" } }
                ] %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
