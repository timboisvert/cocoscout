<%= render layout: "manage/contracts/amend_layout", locals: { step_name: "Change the room", width: "max-w-3xl" } do %>
    <p class="text-gray-600 mb-2">
      Same nights, same deal — a different space at the same venue. Nothing about the money or the
      contract changes, so there's nothing to re-sign.
    </p>
    <p class="text-sm text-gray-500 mb-6">
      Only nights still to come. A show that's already happened was in the room it was in.
    </p>

    <% if @conflicts.any? %>
      <div class="border border-amber-200 bg-amber-50 rounded-lg p-4 mb-6">
        <p class="font-semibold text-amber-900 mb-2">Something else is already in there</p>
        <ul class="space-y-2">
          <% @conflicts.each do |conflict| %>
            <li class="text-sm text-amber-900">
              <span class="font-medium"><%= conflict[:rental].starts_at.strftime("%a, %b %-d") %> → <%= conflict[:space_name] %>:</span>
              <%= conflict[:reasons].to_sentence %>.
            </li>
          <% end %>
        </ul>
        <p class="text-sm text-amber-800 mt-3">
          Move them anyway if you know the room can take both — the other booking is left alone either way.
        </p>
      </div>
    <% end %>

    <%= form_with url: apply_amend_space_manage_contract_path(@contract), method: :post,
          html: { novalidate: true }, data: { controller: "amend-space" } do %>
      <input type="hidden" name="force" value="" data-amend-space-target="force">

      <% @rentals.group_by(&:location).each do |location, rentals| %>
        <% spaces = @spaces_by_location[location&.id] || [] %>

        <div class="mb-6">
          <div class="flex items-end justify-between gap-4 flex-wrap mb-3">
            <div>
              <p class="font-semibold text-gray-900"><%= location&.name || "No venue" %></p>
              <p class="text-xs text-gray-500"><%= pluralize(rentals.size, "date") %> still to come</p>
            </div>

            <% if spaces.any? && rentals.size > 1 %>
              <%# The whole point: change the room on a run of nights in one move. %>
              <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Put every date here in</label>
                <select data-action="change->amend-space#applyAll" data-location-id="<%= location&.id %>"
                        class="block w-full sm:w-64 px-3 py-2.5 border border-gray-300 rounded-lg shadow-sm text-sm bg-white focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
                  <option value="__none__">Choose per date</option>
                  <option value="">Entire Venue</option>
                  <% spaces.each do |space| %>
                    <option value="<%= space.id %>"><%= space.name %></option>
                  <% end %>
                </select>
              </div>
            <% end %>
          </div>

          <% if spaces.empty? %>
            <p class="text-sm text-gray-500 border border-gray-200 rounded-lg p-4 bg-gray-50">
              <%= location&.name || "This venue" %> has no rooms set up yet, so every date is the whole venue.
              <% if location %>
                <%= link_to "Add rooms to #{location.name}", manage_location_path(location),
                      class: "text-pink-600 hover:text-pink-700 underline" %>
                and they'll show up here.
              <% end %>
            </p>
          <% end %>

          <div class="space-y-3">
            <% rentals.each do |rental| %>
              <%
                current = @selected.key?(rental.id) ? @selected[rental.id] : rental.location_space_id
                clashing = @conflicts.any? { |c| c[:rental].id == rental.id }
              %>
              <div class="border <%= clashing ? "border-amber-300 bg-amber-50/50" : "border-gray-200 bg-gray-50" %> rounded-lg p-4">
                <div class="flex items-start justify-between gap-4 flex-wrap">
                  <div class="min-w-0">
                    <p class="font-medium text-gray-900">
                      <%= rental.starts_at.strftime("%A, %b %-d, %Y") %>
                      <span class="text-gray-400 font-normal">· <%= rental.starts_at.strftime("%-l:%M %p") %>–<%= rental.ends_at.strftime("%-l:%M %p") %></span>
                    </p>
                    <p class="text-xs text-gray-500 mt-0.5">Currently in <%= rental.space_name %></p>
                  </div>

                  <div class="flex-shrink-0">
                    <label class="block text-xs font-medium text-gray-600 mb-1">Room</label>
                    <select name="spaces[<%= rental.id %>]"
                            data-amend-space-target="select" data-location-id="<%= location&.id %>"
                            class="block w-full sm:w-56 px-3 py-2.5 border border-gray-300 rounded-lg shadow-sm text-sm bg-white focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
                      <option value="" <%= "selected" if current.blank? %>>Entire Venue</option>
                      <% spaces.each do |space| %>
                        <option value="<%= space.id %>" <%= "selected" if current == space.id %>><%= space.name %></option>
                      <% end %>
                    </select>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @rentals.empty? %>
        <p class="text-sm text-gray-500">
          <% if @past_rental_count.positive? %>
            Every date on this contract has already happened, so there's no room left to change.
          <% else %>
            This contract has no dates on it yet.
          <% end %>
        </p>
      <% end %>

      <div class="flex items-center justify-between gap-3 mt-6 flex-wrap">
        <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", icon: "arrow-left",
              path: amend_choose_manage_contract_path(@contract) %>
        <% if @rentals.any? %>
          <% if @conflicts.any? %>
            <%= render "shared/button", text: "Change it anyway", variant: "primary", size: "medium", type: :submit,
                  data: { action: "click->amend-space#force" } %>
          <% else %>
            <%= render "shared/button", text: "Change the room", variant: "primary", size: "medium", type: :submit %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <p class="text-xs text-gray-500 mt-4">
      Moving them to a different venue is a change to the deal — use
      <%= link_to "Change the deal", amend_bookings_manage_contract_path(@contract), class: "text-pink-600 hover:text-pink-700 underline" %>.
    </p>
<% end %>
