<%= render layout: "manage/producer_setup/setup_layout", locals: { current_step: 0, step_name: "Genre" } do %>
  <div class="text-center mb-8">
    <p class="text-xs font-semibold uppercase tracking-widest text-pink-500 mb-3">Welcome to the production side of CocoScout</p>
    <h2 class="text-2xl sm:text-3xl coustard-regular text-gray-900">What are you creating?</h2>
    <p class="text-gray-500 mt-3 max-w-xl mx-auto">
      This is where you run your own shows — schedule events, hold auditions, build casts,
      and keep your people in the loop. Tell us what you're making and we'll set things up
      to fit; you can change any of it later.
    </p>
  </div>

  <%= form_with url: manage_producer_setup_save_genre_path, method: :post, local: true do %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      <% ProductionGenres.keys.each do |genre_key| %>
        <label class="group relative flex flex-col items-center text-center gap-3 p-4 sm:p-5 bg-white border border-gray-200 rounded-2xl cursor-pointer transition-all duration-150 hover:border-pink-300 hover:shadow-md hover:-translate-y-0.5 has-[:checked]:border-pink-500 has-[:checked]:ring-2 has-[:checked]:ring-pink-500/20 has-[:checked]:bg-pink-50/60 has-[:checked]:shadow-md">
          <%= radio_button_tag "genre", genre_key, @setup_state[:genre] == genre_key,
                class: "sr-only", required: true %>
          <span class="w-12 h-12 rounded-xl bg-pink-50 text-pink-500 group-has-[:checked]:bg-pink-100 group-has-[:checked]:text-pink-600 flex items-center justify-center transition-colors">
            <%= render "manage/producer_setup/genre_icon", icon: ProductionGenres.icon(genre_key) %>
          </span>
          <span>
            <span class="block text-sm font-semibold text-gray-900"><%= ProductionGenres.label(genre_key) %></span>
            <span class="mt-1 hidden sm:block text-xs text-gray-500 leading-snug"><%= ProductionGenres.description(genre_key) %></span>
          </span>
          <span class="absolute top-3 right-3 flex w-5 h-5 items-center justify-center rounded-full bg-pink-500 text-white opacity-0 scale-75 group-has-[:checked]:opacity-100 group-has-[:checked]:scale-100 transition-all duration-150">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
          </span>
        </label>
      <% end %>
    </div>

    <div class="mt-8">
      <%= render "shared/button", text: "Next", variant: "primary", size: "jumbo", type: :submit %>
    </div>
  <% end %>
<% end %>
