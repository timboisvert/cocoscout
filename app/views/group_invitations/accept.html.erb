<% content_for :title, "Join #{@invitation.group.name}" %>
<%
  # An invitation into a group (a shared profile). Someone signed in accepts;
  # anyone else chooses a password here (the controller creates or claims the
  # account for the invited email).
  inv = @invitation
  group = inv.group
  accept_path = do_accept_group_invitation_path(inv.token)
%>
<% strip = capture do %>
  <%= render layout: "shared/auth/strip", locals: { image: group.safe_headshot_variant(:thumb), initial: group.name } do %>
    <% if inv.invited_by.present? %>
      <strong class="font-semibold text-slate-900"><%= inv.invited_by.name %></strong> invited you to join
      <strong class="font-semibold text-slate-900"><%= group.name %></strong> on CocoScout.
    <% else %>
      You've been invited to join <strong class="font-semibold text-slate-900"><%= group.name %></strong> on CocoScout.
    <% end %>
  <% end %>
<% end %>

<% if Current.user.present? %>
  <%= render layout: "shared/auth/shell",
        locals: { title: "Join #{group.name}?", strip: strip, legal: "joining",
                  lede: "You're signed in as #{Current.user.person&.name.presence || Current.user.email_address} (#{Current.user.email_address}). Joining adds you to the group's shared profile." } do %>
    <%= form_with url: accept_path, method: :post, local: true do %>
      <%= render "shared/button", text: "Join #{group.name}", variant: "primary", size: "jumbo", type: :submit %>
    <% end %>
    <div class="border-t border-slate-200 pt-4 text-center text-sm leading-[1.8] text-slate-600">
      Not you? <%= link_to "Sign out", signout_path, class: "font-medium text-pink-600 hover:text-pink-700" %> and use a different account.
    </div>
  <% end %>

<% else %>
  <% notices = capture do %>
    <% if @user&.errors&.any? %>
      <%= render "shared/auth/notice", kind: :error, title: "That password didn't work.", body: @user.errors.full_messages.to_sentence + "." %>
    <% end %>
  <% end %>

  <%= render layout: "shared/auth/shell",
        locals: { title: "Choose your password", strip: strip, notices: notices, legal: "joining",
                  lede: "Your account is ready; it just needs a password. Once it's set, you share #{group.name}'s profile, headshots and history with the rest of the group." } do %>
    <%= form_with url: accept_path, method: :post, local: true, class: "space-y-4", data: { controller: "password-strength" } do |form| %>
      <%= render "shared/auth/account_row", email: inv.email %>

      <%= render "shared/auth/password_field", form: form, strength: true, autocomplete: "new-password",
            error: @user&.errors&.[](:password)&.any? || false %>

      <div class="pt-1">
        <%= render "shared/button",
            text: "Join #{group.name}",
            variant: "primary",
            size: "jumbo",
            type: :submit,
            disabled: true,
            classes: "!opacity-50 !cursor-not-allowed",
            data: { password_strength_target: "submit" } %>
      </div>
    <% end %>

    <div class="border-t border-slate-200 pt-4 text-center text-sm leading-[1.8] text-slate-600">
      Already set a password?
      <%= link_to "Sign in", signin_path(redirect_to: accept_group_invitation_path(inv.token)), class: "font-medium text-pink-600 hover:text-pink-700" %>
    </div>
  <% end %>
<% end %>
