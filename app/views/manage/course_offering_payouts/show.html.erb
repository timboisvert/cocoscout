<% content_for :title, "Payout: #{@course_offering.title}" %>

<%
  registrations_count = @registrations.where(status: :confirmed).count
  refunded_count = @registrations.where(status: :refunded).count

  rows = @payout_rows || []
  ready_rows = rows.select { |r| r[:status] == :ready }
  needs_bank_rows = rows.select { |r| r[:status] == :needs_bank }
  in_run_rows = rows.select { |r| r[:status] == :in_run }
  ready_total_cents = ready_rows.sum { |r| r[:amount_cents] }

  if rows.any? && rows.all? { |r| r[:status] == :paid }
    status_label, status_class = "Paid", "bg-green-100 text-green-700"
  elsif in_run_rows.any?
    status_label, status_class = "In payout run", "bg-pink-100 text-pink-700"
  elsif ready_rows.any?
    status_label, status_class = "Ready to pay", "bg-amber-100 text-amber-700"
  else
    status_label, status_class = "Not settled", "bg-gray-100 text-gray-700"
  end
%>

<%# One payout row: headshot/initials + name + kind, amount, and run-status badge. %>
<% row_badge = ->(status) do
     case status
     when :paid then ['Paid', 'bg-green-100 text-green-700']
     when :in_run then ['In payout run', 'bg-pink-100 text-pink-700']
     when :needs_bank then ['Needs bank', 'bg-amber-100 text-amber-700']
     else ['Ready', 'bg-gray-100 text-gray-600']
     end
   end %>

<div class="w-full mb-10" data-controller="modal">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Courses", manage_course_offerings_path],
      [@course_offering.title, manage_course_offering_path(@course_offering)]
    ],
    text: "Payout",
    links: [ { text: "Money statement", path: manage_course_money_path(@course_offering) } ]
  } %>

  <% unless Current.organization.can_receive_payouts? %>
    <div class="mb-6 bg-amber-50 border border-amber-200 rounded-xl px-5 py-4 flex items-start gap-3">
      <%= icon("exclamation-circle", class: "w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5") %>
      <div class="flex-1">
        <p class="text-sm font-medium text-amber-900">Connect your organization's bank to get paid</p>
        <p class="text-sm text-amber-700 mt-0.5">Your organization can't receive course payouts until you connect a bank account.</p>
      </div>
      <%= link_to manage_course_settings_path, class: "flex-shrink-0" do %>
        <%= render "shared/button", text: "Set up payouts", variant: "primary", size: "small" %>
      <% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">

      <!-- Revenue Summary Card -->
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Revenue Summary</h2>
          <span class="px-3 py-1 text-sm font-medium rounded-full <%= status_class %>"><%= status_label %></span>
        </div>
        <div class="px-6 py-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <div class="text-sm text-gray-500">Confirmed Registrations</div>
              <div class="text-2xl font-bold text-gray-900"><%= registrations_count %></div>
            </div>
            <div>
              <div class="text-sm text-gray-500">Refunded</div>
              <div class="text-2xl font-bold text-gray-900"><%= refunded_count %></div>
            </div>
          </div>

          <%
            org_keeps_cents = @payout.net_revenue_cents.to_i - @payout.total_payout_cents.to_i
          %>
          <div class="mt-4 border-t border-gray-100 pt-4 space-y-3">
            <% if @refunds_cents.to_i > 0 && @payout.total_revenue_override_cents.blank? %>
              <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600">Gross revenue</span>
                <span class="text-sm text-gray-900"><%= number_to_currency(@gross_cents / 100.0) %></span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600">Refunds</span>
                <span class="text-sm text-gray-900">−<%= number_to_currency(@refunds_cents / 100.0) %></span>
              </div>
              <div class="flex justify-between items-center border-t border-gray-100 pt-3">
                <span class="text-sm text-gray-600">Revenue</span>
                <span class="text-sm font-semibold text-gray-900"><%= @payout.formatted_total_revenue %></span>
              </div>
            <% else %>
              <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600">Revenue<% if @payout.total_revenue_override_cents.present? %> <span class="text-amber-600">(adjusted)</span><% end %></span>
                <span class="text-sm font-semibold text-gray-900"><%= @payout.formatted_total_revenue %></span>
              </div>
            <% end %>
            <div class="flex justify-between items-center">
              <span class="text-sm text-gray-600">
                Platform fee
                <% if @coverage_type == "full" %>
                  <span class="text-green-600 font-medium">(waived)</span>
                <% elsif @coverage_type == "platform_only" %>
                  <span class="text-green-600 font-medium">(processing only)</span>
                <% else %>
                  (5%)
                <% end %>
              </span>
              <span class="text-sm text-gray-900">−<%= @payout.formatted_platform_fee %></span>
            </div>
            <div class="flex justify-between items-center border-t border-gray-100 pt-3">
              <span class="text-sm text-gray-600">Net revenue</span>
              <span class="text-sm font-semibold text-gray-900"><%= @payout.formatted_net_revenue %></span>
            </div>
            <% if @payout.total_payout_cents.to_i > 0 %>
              <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600">Instructor &amp; other payments</span>
                <span class="text-sm text-gray-900">−<%= @payout.formatted_total_payout %></span>
              </div>
            <% end %>
            <div class="flex justify-between items-center border-t border-gray-100 pt-3">
              <div>
                <span class="text-sm font-semibold text-gray-900">Organization keeps</span>
                <p class="text-xs text-gray-500">Paid to your organization's bank</p>
              </div>
              <span class="text-lg font-bold <%= org_keeps_cents >= 0 ? 'text-gray-900' : 'text-red-600' %>"><%= number_to_currency(org_keeps_cents / 100.0) %></span>
            </div>
          </div>

          <% if @has_contract %>
            <div class="mt-4 bg-gray-50 rounded-lg p-3">
              <div class="flex items-center gap-2 text-sm text-gray-600">
                <%= icon("file-text", class: "w-4 h-4 flex-shrink-0") %>
                <span>Contract with <strong><%= @contract.contractor_name %></strong> ·
                  <% if @contract.revenue_share? %>
                    <%= @contract.contractor_share_percentage.to_i %>% to them / <%= @contract.revenue_share_percentage.to_i %>% to you
                  <% elsif @contract.ticket_revenue_minus_fee? %>
                    Revenue minus <%= number_to_currency(@contract.flat_fee_amount) %> fee
                  <% end %>
                </span>
              </div>
            </div>
          <% else %>
            <p class="mt-4 text-sm text-gray-500">
              Your organization keeps the net revenue, after paying anyone below — like the instructor. Add everyone to a payout run to get them paid to their bank.
            </p>
          <% end %>
        </div>
      </div>

      <!-- Payouts -->
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">Payouts</h2>
            <p class="text-sm text-gray-500 mt-0.5">Everyone who gets paid from this course — added to a payout run and paid to their bank.</p>
          </div>
        </div>

        <% if rows.any? %>
          <div class="divide-y divide-gray-100">
            <% rows.each do |row| %>
              <% payee = row[:payee] %>
              <% label, badge_class = row_badge.call(row[:status]) %>
              <div class="px-6 py-4 flex items-start justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <% if row[:is_org] %>
                    <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center flex-shrink-0">
                      <%= icon("dollar-sign", class: "w-5 h-5 text-pink-600") %>
                    </div>
                  <% elsif payee.respond_to?(:safe_headshot_variant) && payee.safe_headshot_variant(:thumb) %>
                    <%= image_tag payee.safe_headshot_variant(:thumb), alt: row[:name], class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
                  <% else %>
                    <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-sm flex-shrink-0">
                      <%= payee.respond_to?(:initials) ? payee.initials : row[:name].to_s[0..1].upcase %>
                    </div>
                  <% end %>
                  <div class="min-w-0">
                    <div class="font-medium text-gray-900 truncate"><%= row[:name] %></div>
                    <div class="text-sm text-gray-500"><%= row[:kind] %></div>
                  </div>
                </div>
                <div class="flex flex-col items-end gap-2 flex-shrink-0">
                  <div class="flex items-center gap-3">
                    <span class="text-lg font-semibold text-gray-900"><%= number_to_currency(row[:amount_cents] / 100.0) %></span>
                    <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full <%= badge_class %>"><%= label %></span>
                  </div>
                  <%# Needs a bank? Hand them a no-login setup link (copy or QR). Org
                      remainder connects via course settings, so only Person/Contractor. %>
                  <% if row[:status] == :needs_bank && payee && %w[Person Contractor].include?(payee.class.name) %>
                    <%= render "payment_setup_actions", setup_url: payee_onboarding_url(token: PayeeOnboardingToken.generate(payee)) %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="px-6 py-8 text-center text-gray-500 text-sm">
            Nothing to pay out yet.
          </div>
        <% end %>

        <% if needs_bank_rows.any? %>
          <div class="px-6 py-3 border-t border-gray-100 bg-amber-50 text-sm text-amber-800 flex items-start gap-2">
            <%= icon("exclamation-circle", class: "w-4 h-4 flex-shrink-0 mt-0.5") %>
            <span><%= pluralize(needs_bank_rows.size, "payee") %> can't be paid until they connect a bank. Send each of them their setup link above — copy it or show the QR, no login needed — then add them to a run once they're ready.</span>
          </div>
        <% end %>

        <%# Set what each instructor is paid, before adding to the run. %>
        <% if @instructors.any? %>
          <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
            <button type="button"
              data-action="click->modal#open" data-modal-id="pay-instructors-modal"
              class="inline-flex items-center gap-2 text-sm font-medium text-pink-600 hover:text-pink-700">
              <%= icon("plus-circle", class: "w-5 h-5") %>
              <%= @line_items.any? { |li| li.calculation_details["type"] == "instructor" } ? "Edit instructor payments" : "Pay instructors" %>
            </button>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-4">
      <!-- Actions Card -->
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-200">
          <h3 class="text-sm font-semibold text-gray-900">Actions</h3>
        </div>
        <div class="p-4 space-y-3">
          <% if @has_contract && @payout.can_recalculate? %>
            <%= form_with url: manage_course_offering_payout_recalculate_path(@course_offering), method: :post do %>
              <%= render "shared/button", text: "Recalculate from Contract", variant: "secondary", size: "medium", type: :submit %>
            <% end %>
          <% end %>

          <% if ready_rows.any? %>
            <%= form_with url: manage_course_offering_payout_add_to_run_path(@course_offering), method: :post do %>
              <%= render "shared/button", text: "Add to payout run", variant: "primary", size: "medium", type: :submit %>
            <% end %>
            <p class="text-xs text-gray-500 text-center">
              <%= pluralize(ready_rows.size, "payout") %> · <%= number_to_currency(ready_total_cents / 100.0) %> ready
            </p>
          <% elsif in_run_rows.any? %>
            <div class="text-center py-1">
              <span class="inline-flex items-center gap-1.5 text-pink-600 font-medium text-sm">
                <%= icon("check-circle", class: "w-5 h-5") %>
                In the payout run
              </span>
              <p class="text-xs text-gray-500 mt-1 mb-3">Pay everyone at once from the course payout run.</p>
              <%= link_to manage_course_payout_run_path do %>
                <%= render "shared/button", text: "Go to payout run", variant: "primary", size: "small" %>
              <% end %>
            </div>
          <% elsif needs_bank_rows.any? %>
            <p class="text-sm text-gray-500 text-center py-1">Waiting on payees to connect a bank before they can be added to a run.</p>
          <% else %>
            <p class="text-sm text-gray-500 text-center py-1">Nothing to pay out yet.</p>
          <% end %>
        </div>
      </div>

      <!-- Adjust revenue (advanced, collapsed) -->
      <% unless @payout.paid? %>
        <details class="bg-white rounded-xl border border-gray-200 overflow-hidden group" <%= "open" if @payout.total_revenue_override_cents.present? %>>
          <summary class="px-4 py-3 cursor-pointer text-sm font-semibold text-gray-900 flex items-center justify-between list-none [&::-webkit-details-marker]:hidden">
            Adjust revenue
            <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-4 pb-4 border-t border-gray-100 pt-3">
            <p class="text-xs text-gray-500 mb-3">Only if you collected money for this course outside CocoScout — set the real total here to override what registrations show.</p>
            <%= form_with url: manage_course_offering_payout_revenue_override_path(@course_offering), method: :patch, class: "space-y-2" do |f| %>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
                <%= f.text_field :total_revenue_override_cents,
                  value: @payout.total_revenue_override_cents ? ("%.2f" % (@payout.total_revenue_override_cents / 100.0)) : "",
                  placeholder: "Leave blank to use registrations",
                  class: "w-full pl-7 text-sm border-gray-300 rounded-lg focus:ring-pink-500 focus:border-pink-500" %>
              </div>
              <%= render "shared/button", text: "Update", variant: "secondary", size: "small", type: :submit %>
            <% end %>
          </div>
        </details>
      <% end %>

      <!-- Details Card -->
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-200">
          <h3 class="text-sm font-semibold text-gray-900">Details</h3>
        </div>
        <div class="p-4 space-y-2 text-sm text-gray-600">
          <div class="flex justify-between">
            <span>Payout Type</span>
            <span class="font-medium text-gray-900"><%= @has_contract ? "Contract-based" : "Standard" %></span>
          </div>
          <div class="flex justify-between">
            <span>Last Calculated</span>
            <span class="font-medium text-gray-900">
              <%= @payout.calculated_at ? @payout.calculated_at.strftime("%b %-d, %Y %l:%M %p") : "Never" %>
            </span>
          </div>
          <div class="flex justify-between">
            <span>Registrations</span>
            <span class="font-medium text-gray-900"><%= registrations_count %></span>
          </div>
          <% if @course_offering.price_cents > 0 %>
            <div class="flex justify-between">
              <span>Price per Student</span>
              <span class="font-medium text-gray-900"><%= number_to_currency(@course_offering.price_cents / 100.0) %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# Pay instructors modal %>
  <% if @instructors.any? && !@payout.paid? %>
    <div id="pay-instructors-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
      <div class="fixed inset-0 bg-black/40" data-action="click->modal#close"></div>
      <div class="relative bg-white rounded-xl shadow-xl w-full max-w-lg max-h-[90vh] flex flex-col overflow-hidden"
           data-controller="instructor-payments">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h3 class="text-lg font-semibold text-gray-900">Pay instructors</h3>
          <button type="button" data-action="click->modal#close" class="text-gray-400 hover:text-gray-600">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </button>
        </div>

        <%= form_with url: manage_course_offering_payout_pay_instructors_path(@course_offering), method: :post, class: "flex flex-col flex-1 overflow-hidden" do %>
          <div class="px-6 py-4 overflow-y-auto space-y-3">
            <p class="text-sm text-gray-600">Enter what you're paying each instructor for this course. Leave anyone at $0 to skip them.</p>
            <% @instructors.each do |person| %>
              <% existing = @line_items.find { |li| li.payee_type == "Person" && li.payee_id == person.id } %>
              <div class="flex items-center gap-3">
                <% headshot_variant = person.safe_headshot_variant(:thumb) %>
                <% if headshot_variant %>
                  <%= image_tag headshot_variant, alt: person.name, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
                <% else %>
                  <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-sm flex-shrink-0"><%= person.initials %></div>
                <% end %>
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-gray-900 truncate"><%= person.name %></div>
                  <div class="text-xs text-gray-500">Instructor</div>
                </div>
                <div class="w-32 relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none">$</span>
                  <input type="number" step="0.01" min="0" inputmode="decimal"
                    name="instructor_amounts[<%= person.id %>]"
                    value="<%= existing ? ('%.2f' % (existing.amount_cents / 100.0)) : '' %>"
                    placeholder="0.00"
                    data-instructor-payments-target="amount"
                    data-action="input->instructor-payments#recalculate"
                    class="block w-full pl-7 pr-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
                </div>
              </div>
            <% end %>
          </div>

          <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex items-center justify-between">
            <div>
              <span class="text-sm text-gray-600">Subtotal</span>
              <span data-instructor-payments-target="subtotal" class="ml-2 text-lg font-bold text-gray-900">$0.00</span>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" data-action="click->modal#close" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</button>
              <%= render "shared/button", text: "Save Payments", variant: "primary", size: "medium", type: :submit %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
