<%#
  Settings Layout

  The shell for a module's settings page — Contract Settings, Course Settings,
  and anything else that grows a second topic. Sections are real URLs rendered
  as a tab strip, so a link can point at one section, only that section's data
  loads, and reordering the strip never breaks a saved link.

  Render it with `render layout: "shared/settings_layout", locals: {...} do`
  and put the section body in the block. See
  manage/contract_settings/show.html.erb for a worked example.

  Locals:
    title       — page title (also the top_menu's current-page text)
    breadcrumbs — array of [name, path] pairs, as shared/top_menu expects
    sections    — array of { key:, label:, path:, badge: }; the strip is hidden
                  when there's only one, so a single-topic page looks plain
    current     — key of the section being shown
    intro       — optional sentence under the title, for the whole page
    banner      — optional html_safe content for a bar above the tabs, for a
                  page that changes one thing within something bigger (one
                  date's ticket settings within its production's)
    width       — optional max-width class for the body. The default,
                  max-w-5xl, is every settings page's width: they all use
                  the content space (Tim, 2026-10-20). Pass one only for a
                  page that truly needs another.
    show_single_tab — pass true to show the strip even with one section, for a
                  page that should look tabbed like its sibling settings pages
%>
<%
  sections ||= []
  breadcrumbs ||= []
  intro = local_assigns[:intro]
  width = local_assigns[:width].presence || "max-w-5xl"
  show_single_tab = local_assigns[:show_single_tab]
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: breadcrumbs,
    text: title,
    links: []
  } %>

  <% if intro.present? %>
    <p class="text-sm text-gray-600 max-w-2xl -mt-2 mb-5"><%= intro %></p>
  <% end %>

  <% if local_assigns[:banner].present? %>
    <div class="mb-5 rounded-lg border border-pink-200 bg-pink-50 px-4 py-3 text-sm text-pink-900"><%= local_assigns[:banner] %></div>
  <% end %>

  <% if sections.size > 1 || (show_single_tab && sections.any?) %>
    <%# On a phone the current section is a row; tapping it opens the
        sections in a sheet (V1.1 plan §5, Section list), so none hides off
        the edge and each is a real link. %>
    <% current_section = sections.find { |section| section[:key].to_s == current.to_s } || sections.first %>
    <div class="sm:hidden mb-5" data-settings-sections>
      <button type="button" data-controller="modal" data-action="click->modal#open" data-modal-id="settings-sections-sheet"
              class="w-full flex items-center justify-between gap-3 px-4 min-h-[48px] bg-white border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-900 cursor-pointer">
        <span class="flex items-center gap-2 min-w-0">
          <span class="text-xs text-gray-500 flex-shrink-0">Section</span>
          <span class="truncate"><%= current_section[:label] %></span>
          <% if current_section[:feature].present? %><%= render "shared/pro_marker" %><% end %>
        </span>
        <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <%= render layout: "shared/sheet", locals: { id: "settings-sections-sheet", title: "Sections" } do %>
        <div class="-mx-4 -my-5 divide-y divide-gray-100">
          <% sections.each do |section| %>
            <% active = section[:key].to_s == current.to_s %>
            <%= link_to section[:path], aria: { current: active ? "page" : nil },
                  class: "flex items-center justify-between gap-3 w-full min-h-[52px] px-5 text-[15px] hover:bg-gray-50 #{active ? 'text-pink-600 font-medium' : 'text-gray-800'}" do %>
              <span class="flex items-center gap-2 min-w-0">
                <span class="truncate"><%= section[:label] %></span>
                <% if section[:feature].present? %>
                  <%= render "shared/pro_marker" %>
                  <% if section[:locked] %><%= render "shared/pro_marker", kind: :lock %><% end %>
                <% end %>
                <% if section[:badge].to_i.positive? %>
                  <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full bg-gray-100 text-gray-600 text-[11px] font-semibold leading-none"><%= section[:badge] %></span>
                <% end %>
              </span>
              <% if active %>
                <svg class="w-4 h-4 text-pink-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
    <nav class="hidden sm:flex gap-1 border-b border-gray-200 mb-6 overflow-x-auto" aria-label="Settings sections">
      <% sections.each do |section| %>
        <% active = section[:key].to_s == current.to_s %>
        <%= link_to section[:path],
              aria: { current: active ? "page" : nil },
              class: "px-4 py-2 -mb-px text-sm font-medium whitespace-nowrap border-b-2 transition-colors #{active ? 'border-pink-500 text-pink-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}" do %>
          <%= section[:label] %>
          <%# A Pro section: `feature:` marks it; `locked: true` adds the padlock (the page shows the locked card). %>
          <% if section[:feature].present? %>
            <%= render "shared/pro_marker", classes: "ml-1.5" %>
            <% if section[:locked] %><%= render "shared/pro_marker", kind: :lock, classes: "ml-1 inline-block align-middle" %><% end %>
          <% end %>
          <% if section[:badge].to_i.positive? %>
            <span class="ml-1.5 inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full bg-gray-100 text-gray-600 text-[11px] font-semibold leading-none"><%= section[:badge] %></span>
          <% end %>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <div class="<%= width %> space-y-6">
    <%= yield %>
  </div>
</div>
