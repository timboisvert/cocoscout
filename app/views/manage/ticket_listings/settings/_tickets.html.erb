<%# One date's ticket types. Under a production's ticketing, a switch at the
    top says whether this date has its own: off, the production's types and
    prices show grayed out; on, they come alive to edit for this date only,
    and switching off again goes back to the production's. Without a
    production setup the date simply has its own. Locals: listing, setup
    (the production's ticketing, or nil). %>
<%
  inventory = listing.inventory
  own = setup.nil? || !listing.inherits_tiers
  rows = listing.ticket_tiers.active.to_a
  rows = [ TicketTier.new(position: 0) ] if rows.empty?
  bases = rows.select { |t| t.persisted? && !t.bundle? }.map { |t| [ t.name, t.id ] }
%>
<%= form_with model: listing, url: manage_ticket_listing_path(listing), method: :patch do |f| %>
  <%= hidden_field_tag :section, "tickets" %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle" data-settings-card="tickets">
    <% if setup %>
      <%# The one override control (manage/ticketing/own_switch): off, the
          production's types and prices show greyed; on, they're this date's. %>
      <%= render "manage/ticketing/own_switch", title: "Ticket types and prices", what: "ticket types and prices", follows: listing.production.name, settings_path: manage_edit_production_ticketing_path(listing.production, section: "tickets"),
            intro: "Once this date has its own, changes to the production's won't reach it. Stop overriding and it goes back to the production's; tickets already sold keep theirs.",
            only: "this date", name: "ticket_listing[own_prices]", id: "ticket_listing_own_prices", checked: own %>
    <% else %>
      <%= render "shared/section_heading", title: "Ticket types and prices", intro: "This date's own." %>
    <% end %>
  <fieldset <%= "disabled" unless own %> data-fieldset-toggle-target="fields"
            class="min-w-0 px-6 py-5 space-y-3 disabled:opacity-50 disabled:pointer-events-none transition-opacity"
            data-controller="reorderable nested-form" data-reorderable-handle-value=".tier-drag-handle" data-reorderable-auto-save-value="false">
    <div class="space-y-3" data-reorderable-target="list" data-nested-form-target="children">
      <%= f.fields_for :ticket_tiers, rows do |tf| %>
        <%= render "manage/ticketing/tier_row", tf: tf, bases: bases, sold: (tf.object.persisted? ? inventory.sold(tier: tf.object) : 0) %>
      <% end %>
    </div>
    <template data-nested-form-target="template">
      <%= f.fields_for :ticket_tiers, TicketTier.new(position: 999), child_index: "NEW_CHILD_RECORD" do |tf| %>
        <%= render "manage/ticketing/tier_row", tf: tf, bases: bases %>
      <% end %>
    </template>
      <template data-nested-form-target="bundleTemplate">
      <%= f.fields_for :ticket_tiers, TicketTier.new(position: 999), child_index: "NEW_CHILD_RECORD" do |tf| %>
        <%= render "manage/ticketing/tier_row", tf: tf, bundle: true, bases: bases %>
      <% end %>
    </template>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <%= render "shared/button", text: "Add a ticket type", variant: "secondary", size: "small", type: :button, icon: "plus",
              data: { action: "nested-form#add" } %>
        <%= render "shared/button", text: "Add a bundle", variant: "secondary", size: "small", type: :button, icon: "plus",
              title: "One price for a set of tickets, like 4 for $70, or a ticket plus a swag bag", data: { action: "nested-form#addBundle" } %>
      </div>
      <p class="text-xs text-gray-500">A type that has sold is kept for its buyers when you remove it. Leave seats blank for no limit.</p>
    </div>
  </fieldset>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
    </div>
  </div>
<% end %>
