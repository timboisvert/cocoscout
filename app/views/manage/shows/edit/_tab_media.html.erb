<%# Visual Assets: this event's poster and wide image, drawn the way the
    production's Visual Assets tab draws its own. Each shows the picture in
    use, the event's own or the production's it falls back to (the order
    ticket pages use, Show#ticket_page_image). A new one, or going back to
    the production's, takes effect on Save Changes. Locals: form. %>
<%
  kind = @show.event_type.titleize.downcase
  production = @show.production
  name = possessive(production.name)
  file_class = "block w-full sm:w-auto text-sm text-gray-600 file:mr-3 file:rounded-lg file:border-0 file:bg-pink-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-pink-700 hover:file:bg-pink-100"
  production_poster = production.primary_poster
  production_poster_variant = production_poster&.safe_image_variant(:large) || production_poster&.safe_image_variant(:small)
  production_poster_url = production_poster_variant && url_for(production_poster_variant)
  production_wide_url = production.wide_image.attached? ? url_for(production.safe_wide_image_variant || production.wide_image) : nil
  own_poster = @show.poster.attached? && @show.poster.blob&.persisted?
  own_wide = @show.wide_image.attached? && @show.wide_image.blob&.persisted?
  cards = [
    { field: :poster, remove: "remove_poster", title: "Poster (3:4)", own: own_poster,
      url: own_poster ? url_for(@show.safe_poster_variant(:large) || @show.poster) : production_poster_url,
      inherited_url: production_poster_url, noun: "poster",
      empty: "No poster yet, here or on #{production.name}.",
      accept: "image/jpeg,image/png", spec: "3:4, ideally 1200×1600. JPG or PNG.", min: [ 0, 0 ],
      img_class: "max-h-80 w-auto h-auto rounded shadow-sm" },
    { field: :wide_image, remove: "remove_wide_image", title: "Wide image (16:9)", own: own_wide,
      url: own_wide ? url_for(@show.safe_wide_image_variant || @show.wide_image) : production_wide_url,
      inherited_url: production_wide_url, noun: "wide image",
      empty: "No wide image yet, here or on #{production.name}. Ticket pages and shared links use the poster.",
      accept: "image/jpeg,image/png,image/webp", spec: "16:9, ideally 1920×1080 (at least 1200×675). JPG, PNG or WebP up to 10 MB.", min: [ 1200, 675 ],
      img_class: "w-full h-auto rounded shadow-sm" }
  ]
%>
<%# What these are for, said the way the production's tab says it, with
    the same two shapes. %>
<div class="bg-white border border-gray-200 rounded-lg p-6">
  <h2 class="text-lg font-semibold text-gray-900">How this <%= kind %> looks</h2>
  <p class="text-sm text-gray-600 mt-1 max-w-3xl">
    It uses <%= name %> poster and wide image unless you give it its own here, for a special guest night, say.
  </p>
  <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-5 text-sm">
    <div class="flex gap-3">
      <div class="w-9 h-12 flex-shrink-0 rounded border-2 border-pink-300 bg-pink-50"></div>
      <div>
        <div class="font-medium text-gray-900">Poster · 3:4, tall</div>
        <div class="text-gray-600 mt-0.5">What people see while browsing: show lists, sign-ups, casting, messages and the public listing.</div>
      </div>
    </div>
    <div class="flex gap-3">
      <div class="w-16 h-9 flex-shrink-0 rounded border-2 border-pink-300 bg-pink-50 mt-1.5"></div>
      <div>
        <div class="font-medium text-gray-900">Wide image · 16:9</div>
        <div class="text-gray-600 mt-0.5">The banner across the top of this date's ticket page, and the preview when its link is shared.</div>
      </div>
    </div>
  </div>
  <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
    <p class="text-xs text-gray-500">Both are always shown whole, never cropped. Without a wide image, the ticket page uses the poster.</p>
    <%= link_to "Change #{name} images in its Visual Assets", edit_manage_production_path(production, tab: 1), class: "text-sm font-medium text-pink-600 hover:text-pink-700" %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <% cards.each do |card| %>
    <% inherited_words = card[:inherited_url] ? "Goes back to #{name} #{card[:noun]}" : "Goes back to no #{card[:noun]}" %>
    <div class="bg-white border border-gray-200 rounded-lg flex flex-col"
         data-controller="event-image"
         data-event-image-inherited-src-value="<%= card[:inherited_url] %>"
         data-event-image-inherited-words-value="<%= inherited_words %>"
         data-event-image-min-width-value="<%= card[:min][0] %>"
         data-event-image-min-height-value="<%= card[:min][1] %>">
      <%= render "shared/section_heading", title: card[:title] %>
      <div class="p-6 pt-4 flex-1 flex flex-col">
        <div class="flex-1 flex items-center justify-center rounded-lg bg-gray-50 border border-gray-200 min-h-[18rem] p-4">
          <img src="<%= card[:url] %>" alt="" class="<%= card[:img_class] %> <%= 'hidden' unless card[:url] %>" data-event-image-target="frame">
          <p class="text-sm text-amber-700 text-center <%= 'hidden' if card[:url] %>" data-event-image-target="empty"><%= card[:empty] %></p>
        </div>
        <p class="text-xs text-gray-500 mt-2">
          <% if card[:own] %>
            This <%= kind %>'s own <%= card[:noun] %>.
          <% elsif card[:url] %>
            <%= name %> <%= card[:noun] %>, until this <%= kind %> has its own.
          <% end %>
        </p>
        <%= hidden_field_tag "show[#{card[:remove]}]", "0", id: nil, data: { event_image_target: "removeFlag" } %>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <%= form.file_field card[:field], accept: card[:accept], class: file_class,
                data: { event_image_target: "input", action: "change->event-image#choose" } %>
          <% if card[:own] %>
            <%= render "shared/button", text: "Use #{name} instead", variant: "secondary", size: "small", type: :button,
                  data: { event_image_target: "useProduction", action: "click->event-image#useProduction" } %>
          <% end %>
        </div>
        <p class="hidden text-xs font-medium text-pink-700 mt-2" data-event-image-target="status"></p>
        <p class="hidden text-xs text-amber-700 mt-2" data-event-image-target="warning"></p>
        <p class="text-xs text-gray-500 mt-2"><%= card[:spec] %></p>
      </div>
    </div>
  <% end %>
</div>
