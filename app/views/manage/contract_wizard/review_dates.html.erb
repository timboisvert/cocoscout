<%= render layout: "manage/contract_wizard/wizard_layout", locals: { step_name: "Financials", width: "max-w-5xl" } do %>
  <%= render "manage/contracts/review_dates", contract: @contract,
        rows: contract_date_rows(@contract, @bookings, locations_map: @locations_map, spaces_map: @spaces_map),
        edit_path: manage_review_dates_contract_wizard_path(@contract),
        schedule_path: manage_bookings_contract_wizard_path(@contract),
        deal_path: manage_payments_contract_wizard_path(@contract),
        next_label: @contract.org_sells_tickets? ? "Next: Ticketing" : "Next: Services",
        footnote: "Services come later, on the Services step, with the same list." %>
<% end %>
