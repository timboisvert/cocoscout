<% content_for :title, "Revenue by Production" %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <%= render "manage/reports/header", title: "Revenue by Production", subtitle: "Ticket and other revenue recorded per production." %>

    <div class="grid gap-4 sm:grid-cols-2 mb-6">
      <div class="bg-white border border-gray-200 rounded-lg p-5">
        <div class="text-sm text-gray-500">Total revenue</div>
        <div class="text-3xl font-bold text-gray-900"><%= number_to_currency(@total_revenue) %></div>
      </div>
      <div class="bg-white border border-gray-200 rounded-lg p-5">
        <div class="text-sm text-gray-500">Total tickets</div>
        <div class="text-3xl font-bold text-gray-900"><%= number_with_delimiter(@total_tickets) %></div>
      </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[32rem] text-left text-sm">
          <thead class="bg-gray-50 text-gray-500">
            <tr>
              <th class="px-5 py-3 font-medium">Production</th>
              <th class="px-5 py-3 font-medium text-right">Events with financials</th>
              <th class="px-5 py-3 font-medium text-right">Tickets</th>
              <th class="px-5 py-3 font-medium text-right">Revenue</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @rows.each do |row| %>
              <tr>
                <td class="px-5 py-3 font-medium text-gray-900"><%= link_to row[:production].name, [:manage, row[:production]], class: "hover:text-pink-600" %></td>
                <td class="px-5 py-3 text-right text-gray-600"><%= row[:events_with_financials] %></td>
                <td class="px-5 py-3 text-right text-gray-600"><%= number_with_delimiter(row[:tickets]) %></td>
                <td class="px-5 py-3 text-right font-semibold text-gray-900"><%= number_to_currency(row[:revenue]) %></td>
              </tr>
            <% end %>
            <% if @rows.empty? %>
              <tr><td colspan="4" class="px-5 py-8 text-center text-gray-400">No revenue recorded yet.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
