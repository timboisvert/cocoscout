<%# Products still to deliver tonight, as one line; each party's row in the
    list carries its own Delivered tap. Refreshed with the counts. Locals: listing. %>
<%
  items = listing.ticket_order_items.sold.to_a
  waiting = items.reject(&:fulfilled?)
%>
<% if items.any? %>
  <span class="font-semibold text-gray-900">To deliver</span>
  <span class="text-gray-500">· <%= waiting.sum(&:quantity) %> of <%= items.sum(&:quantity) %> left<% if waiting.empty? %>. Everything's delivered.<% end %></span>
<% end %>
