<%#
  The rule builder (Segment): a name, all or any, and rows of rules. Each
  row shows the fields its kind needs (segment-builder); the count on the
  right updates as the rules change (SegmentsController#count).
%>
<%
  rule = segment.rule.presence || { "match" => "all", "conditions" => [] }
  rows = Array(rule["conditions"]).presence || [ { "type" => "bought", "target" => "any" } ]
  types = [ [ "Is on the list", "on_list" ], [ "Bought tickets to", "bought" ], [ "Never bought tickets to", "never_bought" ],
            [ "Came at least", "times_at_least" ], [ "Last bought", "last_bought" ], [ "Joined from", "joined_from" ] ]
  kinds = [ [ "Ticket checkout", "checkout" ], [ "Added by hand", "manual" ], [ "A pasted list", "paste" ], [ "Contacts", "contacts" ] ]
  select_class = "px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
  row_html = lambda do |index, condition|
    capture do
      %>
      <div class="flex flex-wrap items-center gap-2 p-3 bg-gray-50 border border-gray-200 rounded-lg" data-segment-builder-target="row">
        <%= select_tag "conditions[#{index}][type]", options_for_select(types, condition["type"]), class: "#{select_class} w-full sm:w-56",
              data: { action: "change->segment-builder#changed", role: "type" }, "aria-label": "Rule" %>
        <span data-for="bought never_bought" class="contents"><%= select_tag "conditions[#{index}][target]", options_for_select(targets, condition["target"]), class: "#{select_class} w-full sm:w-64", data: { action: "change->segment-builder#changed" }, "aria-label": "What they bought" %></span>
        <span data-for="on_list" class="contents"><%= select_tag "conditions[#{index}][list_id]", options_for_select(lists.map { |l| [ l.name, l.id ] }, condition["list_id"]), class: "#{select_class} w-full sm:w-64", data: { action: "change->segment-builder#changed" }, "aria-label": "Which list" %></span>
        <span data-for="times_at_least" class="contents"><%= number_field_tag "conditions[#{index}][count]", condition["count"] || 3, min: 1, class: "#{select_class} w-24", data: { action: "input->segment-builder#changed" }, "aria-label": "How many times" %><span class="text-sm text-gray-700">times</span></span>
        <span data-for="last_bought" class="contents"><%= select_tag "conditions[#{index}][when]", options_for_select([ [ "before", "before" ], [ "after", "after" ] ], condition["when"]), class: "#{select_class} w-28", data: { action: "change->segment-builder#changed" }, "aria-label": "Before or after" %><%= date_field_tag "conditions[#{index}][date]", condition["date"] || 3.months.ago.to_date, class: "#{select_class} w-44", data: { action: "change->segment-builder#changed" }, "aria-label": "Date" %></span>
        <span data-for="joined_from" class="contents"><%= select_tag "conditions[#{index}][kind]", options_for_select(kinds, condition["kind"]), class: "#{select_class} w-full sm:w-56", data: { action: "change->segment-builder#changed" }, "aria-label": "How they joined" %></span>
        <button type="button" class="ml-auto text-xs text-gray-500 hover:text-gray-700 cursor-pointer" data-action="segment-builder#remove">Remove</button>
      </div>
      <%
    end
  end
%>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 items-start" data-controller="segment-builder" data-segment-builder-count-url-value="<%= manage_segments_count_path %>">
  <%= form_with url: form_url, method: form_method, id: "segment-form", data: { turbo: false, segment_builder_target: "form" }, class: "lg:col-span-2 bg-white rounded-lg border border-gray-200 overflow-visible" do %>
    <%= render "shared/section_heading", title: "Who's in it", intro: "Followers on any of your lists who match" %>
    <div class="p-5 space-y-4">
      <div class="max-w-md">
        <label for="segment_name" class="block text-sm font-medium text-gray-700 mb-1.5">Name</label>
        <%= text_field_tag "segment[name]", segment.name, id: "segment_name", required: true, placeholder: "Regulars", class: follower_input_class %>
      </div>
      <div class="flex items-center gap-2 text-sm text-gray-700">
        Match <%= select_tag :match, options_for_select([ [ "all", "all" ], [ "any", "any" ] ], rule["match"]), class: select_class, data: { action: "change->segment-builder#changed" }, "aria-label": "All or any" %> of these
      </div>
      <div class="space-y-3" data-segment-builder-target="rows">
        <% rows.each_with_index do |condition, index| %><%= row_html.call(index, condition) %><% end %>
      </div>
      <template data-segment-builder-target="template"><%= row_html.call("INDEX", { "type" => "bought", "target" => "any" }) %></template>
      <button type="button" class="text-sm font-medium text-pink-600 hover:text-pink-700 cursor-pointer" data-action="segment-builder#add">+ Add a rule</button>
      <div class="pt-2 flex flex-wrap gap-2">
        <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
      </div>
    </div>
  <% end %>

  <div class="space-y-4">
    <div class="rounded-lg border border-pink-200 bg-pink-50 px-5 py-4">
      <div class="text-3xl font-bold tabular-nums text-pink-700" data-segment-builder-target="count">…</div>
      <div class="text-sm text-gray-600">following you match right now</div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-5">
      <h3 class="font-semibold text-gray-900 mb-3">A few of them</h3>
      <div class="space-y-2 text-sm" data-segment-builder-target="sample"><p class="text-gray-500">…</p></div>
    </div>
  </div>
</div>
