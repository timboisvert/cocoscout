<%# Staff hub: searchable, toggleable roster split into active staff and people
    still pending onboarding. Rendered inside a data-controller="invite-preview"
    wrapper. Uses @active_staff, @pending_staff. Editing a member opens a full
    page (not a modal); the only modal here is the onboarding email preview. %>

<div data-controller="staff-hub">
  <%# ---- Toolbar: search + list/grid toggle ---- %>
  <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-4">
    <div class="relative flex-1">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input type="text"
             data-staff-hub-target="search"
             data-action="input->staff-hub#search"
             placeholder="Search staff by name, email, or title…"
             class="w-full pl-9 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
    </div>
    <div class="inline-flex rounded-lg border border-gray-300 overflow-hidden self-start">
      <button type="button" data-action="click->staff-hub#showList" data-staff-hub-target="listBtn"
              class="px-3 py-2 text-sm text-gray-700 bg-pink-50 flex items-center gap-1.5" title="List view">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <button type="button" data-action="click->staff-hub#showGrid" data-staff-hub-target="gridBtn"
              class="px-3 py-2 text-sm text-gray-500 bg-white flex items-center gap-1.5 border-l border-gray-300" title="Grid view">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
      </button>
    </div>
  </div>

  <%# ---- Pending onboarding (people still setting up their account) ---- %>
  <% if @pending_staff.any? %>
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500">Pending onboarding</h3>
        <span class="inline-flex items-center px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-700 text-[11px] font-medium"><%= @pending_staff.size %></span>
      </div>
      <p class="text-xs text-gray-500 mb-2">Invited but haven't finished signing up. They'll move to your roster once they create their account.</p>
      <div data-staff-hub-target="container" class="flex flex-col gap-2">
        <% @pending_staff.each do |member| %>
          <%= render "manage/staffing/staff_card", member: member, pending: true %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ---- Active roster ---- %>
  <% if @active_staff.any? %>
    <div class="flex items-center gap-2 mb-2">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500">Staff</h3>
      <span class="inline-flex items-center px-1.5 py-0.5 rounded-full bg-gray-100 text-gray-600 text-[11px] font-medium"><%= @active_staff.size %></span>
    </div>
    <div data-staff-hub-target="container" class="flex flex-col gap-2">
      <% @active_staff.each do |member| %>
        <%= render "manage/staffing/staff_card", member: member, pending: false %>
      <% end %>
    </div>
  <% elsif @pending_staff.empty? %>
    <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-6 text-center">
      <p class="text-sm text-gray-600 mb-3">No staff added yet.</p>
      <%= link_to manage_new_staffing_staff_wizard_path, class: "inline-flex" do %>
        <%= render "shared/button", text: "Add your first staff member", variant: "primary", size: "small", type: :button %>
      <% end %>
    </div>
  <% end %>

  <%# Shown by JS when a search matches nobody. %>
  <div data-staff-hub-target="empty" class="hidden bg-gray-50 border border-dashed border-gray-300 rounded-lg p-6 text-center">
    <p class="text-sm text-gray-500">No staff match your search.</p>
  </div>
</div>

<%= render "manage/staffing/invite_preview_modal" %>
