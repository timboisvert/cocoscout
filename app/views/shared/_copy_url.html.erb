<%
  # Required parameters:
  # - url: The URL to display and copy
  #
  # Optional parameters:
  # - label: Label text above the URL (default: nil)
  # - help_text: Help text below the URL box (default: nil)
  # - copy_button_text: Text for the copy button (default: "Copy")
  # - show_qr: Show QR code button (default: false)
  # - qr_title: Heading on the QR code modal (default: "Scan to Sign Up")
  # - layout: :tile draws it as a page tile (bordered, the label as the tile's
  #   small heading, the address without https:// over the buttons), to sit
  #   beside the tiles of a box like the show page's Tickets (default: the bar)
%>

<%
  label ||= nil
  help_text ||= nil
  copy_button_text ||= "Copy"
  show_qr ||= false
  qr_title ||= "Scan to Sign Up"
  main_url = url
  tile = local_assigns[:layout].to_s == "tile"
%>

<% buttons = capture do %>
  <%= render "shared/button",
    text: "Visit",
    variant: "outline-pink",
    size: "small",
    type: :button,
    icon: "eye",
    path: url,
    target: "_blank" %>
  <div data-copy-url-target="button" data-url="<%= main_url %>">
    <%= render "shared/button",
      text: copy_button_text,
      variant: "outline-pink",
      size: "small",
      type: :button,
      icon: "clipboard",
      data: { action: "click->copy-url#copy" } %>
  </div>
  <% if show_qr %>
    <%= render "shared/button",
      text: "QR",
      variant: "outline-pink",
      size: "small",
      type: :button,
      icon: "qr-code",
      data: { action: "click->qr-code#open" } %>
  <% end %>
<% end %>

<div data-controller="copy-url<%= ' qr-code' if show_qr %>"
     <% if show_qr %>
     data-qr-code-url-value="<%= main_url %>"
     <% end %>
     <% if tile %>class="h-full rounded-lg border border-gray-200 p-3 min-w-0"<% end %>>
  <% if tile %>
    <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide"><%= label || "Link" %></div>
    <div class="mt-1 text-sm font-mono text-gray-700 truncate" title="<%= main_url %>"><%= main_url.to_s.sub(%r{\Ahttps?://}, "") %></div>
    <div class="mt-2 flex flex-wrap items-center gap-1"><%= buttons %></div>
  <% else %>
    <% if label %>
      <label class="block text-sm font-medium text-gray-700 mb-2"><%= label %></label>
    <% end %>

    <div class="flex flex-wrap items-center gap-2 p-3 sm:pl-3 sm:pr-1 sm:py-1.5 bg-gray-50 rounded border border-gray-200">
      <div class="flex-1 min-w-[180px] overflow-hidden">
        <div class="text-sm font-mono text-gray-700 truncate">
          <%= main_url %>
        </div>
      </div>
      <div class="flex items-center gap-1 flex-shrink-0">
        <%= buttons %>
      </div>
    </div>
  <% end %>

  <% if help_text %>
    <p class="mt-2 text-xs text-gray-600"><%= help_text %></p>
  <% end %>

  <% if show_qr %>
    <%= render "shared/qr_modal", url: main_url, title: qr_title %>
  <% end %>
</div>
