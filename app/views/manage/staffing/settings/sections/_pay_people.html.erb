<%# Who's hidden from the Pay People grid. Salaried managers etc. are never
    paid there except the odd reimbursement — hide them by default; the pay
    grid keeps a reveal list at the bottom for the rare one-offs. %>
<div class="bg-white border border-gray-200 rounded-xl p-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold text-gray-900 mb-1">Pay People list</h2>
      <% excluded_count = @active_staff_members.count(&:excluded_from_pay?) %>
      <p class="text-sm text-gray-600">Hide staff who are never paid through Pay People (like salaried managers) so they don't clog the list. Hidden people — and inactive staff — can still be revealed there one at a time for a one-off payment or reimbursement.</p>
      <p class="text-sm text-gray-500 mt-2">
        <% if excluded_count.positive? %>
          Currently hidden: <span class="font-medium text-gray-700"><%= @active_staff_members.select(&:excluded_from_pay?).map(&:display_name).join(", ") %></span>
        <% else %>
          No one is hidden right now.
        <% end %>
      </p>
    </div>
    <%= render "shared/button", text: "Choose who's hidden", variant: "primary", size: "small", type: :button,
          data: { controller: "modal", action: "click->modal#open", modal_id: "pay-exclusions-modal" } %>
  </div>

  <div id="pay-exclusions-modal"
       class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
       data-controller="modal" data-action="click->modal#closeOnBackdrop">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden text-left" data-action="click->modal#stopPropagation">
      <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
        <h3 class="text-lg font-semibold text-white">Hide from Pay People</h3>
        <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <%= form_with url: manage_staffing_settings_path, method: :patch do %>
        <%= hidden_field_tag :excluding_from_pay, "1" %>
        <div class="px-6 py-4">
          <p class="text-sm text-gray-600 mb-3">Checked people stay off the Pay People list. You can still reveal them there for a one-off payment.</p>
          <div class="max-h-72 overflow-y-auto divide-y divide-gray-100 border border-gray-200 rounded-lg">
            <% @active_staff_members.each do |member| %>
              <label class="flex items-center gap-3 px-3 py-2.5 cursor-pointer hover:bg-gray-50">
                <%= check_box_tag "excluded_staff_member_ids[]", member.id, member.excluded_from_pay?,
                      id: "exclude-member-#{member.id}",
                      class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
                <span class="text-sm text-gray-900"><%= member.display_name %></span>
              </label>
            <% end %>
          </div>
        </div>
        <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
          <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
          <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
        </div>
      <% end %>
    </div>
  </div>
</div>
