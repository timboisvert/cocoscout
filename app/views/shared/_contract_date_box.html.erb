<%# The Contract box for one date (Tim, 2026-10-17): a small reminder that
    the date is under contract. The contractor, their share and its amount,
    one Services row that opens to show each service (negative when they
    come out of the share), what they get and when, and the rest of what's
    owed. The same box on the event page (voice :them, "They get") and on a
    contract person's My show page (voice :you, "You get").
    Locals:
      contract, show
      picture       contract_date_picture(contract, show), or nil without Pro (name and link only)
      voice         :them or :you
      heading_link  html for the right of the first line (a link), optional
      payment_link  lambda(payment) -> html, for the organization's managers, optional
      pro_marker    :pill / :lock for the heading (the event page), optional
      payee_note    one line under the box, e.g. "Payments go to Dan Feltey Presents.", optional %>
<%
  voice = local_assigns.fetch(:voice, :them)
  heading_link = local_assigns[:heading_link]
  payment_link = local_assigns[:payment_link] || ->(_payment) { nil }
  pro_marker = local_assigns[:pro_marker]
  payee_note = local_assigns[:payee_note]
  org_name = contract.organization.name
  words = if voice == :you
    { get: "You get", paid_it: "You paid it.", pay_us: "You pay #{org_name}" }
  else
    { get: "They get", paid_it: "They paid it.", pay_us: "They pay us" }
  end
  money = ->(n) { number_to_currency(n) }
  when_words = ->(payment) { payment.awaiting_amount? ? "Known once ticket sales are final." : (payment.status_paid? ? "Paid." : "Due #{payment.due_date.strftime('%b %-d')}.") }
%>
<div class="border border-gray-200 rounded-lg overflow-hidden bg-white" data-contract-box>
  <%= render "shared/section_heading", padding: "px-4 py-3", title: "Contract" do %>
    <% if pro_marker %><%= render "shared/pro_marker", kind: pro_marker %><% end %>
  <% end %>
  <div class="px-4 py-3 text-sm">
    <div class="flex items-baseline justify-between gap-3">
      <span class="font-medium text-gray-900 min-w-0 truncate"><%= contract.contractor_name %></span>
      <%= heading_link %>
    </div>

    <% if picture %>
      <% terms = picture[:terms] %>
      <% payout = picture[:payout] %>
      <% deducted = picture[:deducted_total] %>
      <div class="mt-2 divide-y divide-gray-100">
        <% if terms %>
          <div class="py-1.5 flex items-baseline justify-between gap-3" data-contract-payout>
            <span class="text-gray-600 min-w-0"><%= picture[:their_share] || terms[0] %><% if picture[:their_share].nil? && terms[1].present? %> <span class="text-xs text-gray-500"><%= terms[1] %></span><% end %></span>
            <% if payout %><span class="text-gray-900 tabular-nums flex-shrink-0"><%= payout.awaiting_amount? ? "TBD" : money.(payout.amount) %></span><% end %>
          </div>
        <% end %>

        <% if picture[:services].any? %>
          <%# The services, one row that opens to show each one and how it's settled. %>
          <details class="group py-1.5" data-contract-services>
            <summary class="flex items-baseline justify-between gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <span class="text-gray-600 inline-flex items-center gap-1">
                Services
                <svg class="w-3.5 h-3.5 text-gray-400 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
              <span class="text-gray-900 tabular-nums flex-shrink-0"><%= deducted.positive? ? "−#{money.(deducted)}" : money.(picture[:services].sum { |row| row[:amount].to_f }) %></span>
            </summary>
            <div class="mt-1 pl-3 space-y-1">
              <% picture[:services].each do |row| %>
                <%
                  hours = row[:hours] && ", #{row[:hours] % 1 == 0 ? row[:hours].to_i : row[:hours]} #{'hr'.pluralize(row[:hours])}"
                  how = case row[:how]
                        when :paid then words[:paid_it]
                        when :direct then "#{words[:pay_us]}. Due #{row[:charge].due_date.strftime('%b %-d')}."
                        end
                %>
                <div class="text-xs">
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="text-gray-500 min-w-0"><%= row[:name] %><%= hours %></span>
                    <span class="text-gray-700 tabular-nums flex-shrink-0"><%= money.(row[:amount]) %></span>
                  </div>
                  <% if how %><p class="text-gray-500"><%= how %> <%= payment_link.call(row[:charge]) %></p><% end %>
                </div>
              <% end %>
            </div>
          </details>
        <% end %>

        <% if payout %>
          <div class="py-1.5 flex items-baseline justify-between gap-3">
            <span class="text-gray-600 min-w-0"><%= words[:get] %> <span class="text-xs text-gray-500"><%= when_words.(payout) %></span></span>
            <span class="font-semibold text-gray-900 tabular-nums flex-shrink-0"><%= payout.awaiting_amount? ? "TBD" : money.([ payout.amount.to_f - deducted, 0 ].max) %></span>
          </div>
        <% end %>

        <% picture[:other_incoming].each do |payment| %>
          <%# Money owed for this date that isn't a service: rent, a fee. %>
          <div class="py-1.5 flex items-baseline justify-between gap-3">
            <span class="text-gray-600 min-w-0"><%= words[:pay_us] %><%= " · #{payment.description}" if picture[:other_incoming].many? %> <span class="text-xs text-gray-500"><%= when_words.(payment) %></span></span>
            <span class="font-semibold text-gray-900 tabular-nums flex-shrink-0"><%= payment.awaiting_amount? ? "TBD" : money.(payment.amount) %></span>
          </div>
        <% end %>
      </div>
      <% if picture[:note] %><p class="mt-1 text-xs italic text-gray-500"><%= picture[:note] %></p><% end %>
    <% end %>
    <% if payee_note %><p class="mt-2 text-xs text-gray-500" data-contract-payee><%= payee_note %></p><% end %>
  </div>
</div>
