<% genre = @setup_state[:genre] %>
<% noun = ProductionGenres.noun(genre) %>

<%= render layout: "manage/producer_setup/setup_layout", locals: { current_step: 1, step_name: "Name" } do %>
  <div class="text-center mb-8">
    <h2 class="text-2xl sm:text-3xl coustard-regular text-gray-900">What's your <%= noun %> called?</h2>
    <p class="text-gray-500 mt-2">The name your cast and audience will see. You can change it anytime.</p>
  </div>

  <%= form_with url: manage_producer_setup_save_name_path, method: :post, local: true do %>
    <div class="max-w-md mx-auto">
      <label for="name" class="sr-only"><%= "#{noun.capitalize} name" %></label>
      <input type="text"
             name="name"
             id="name"
             value="<%= @setup_state[:name] %>"
             placeholder="<%= ProductionGenres.name_placeholder(genre) %>"
             autofocus
             required
             class="block w-full text-center text-lg px-4 py-3.5 bg-white border border-gray-300 rounded-2xl shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
    </div>

    <div class="mt-8">
      <%= render "shared/button", text: "Next", variant: "primary", size: "jumbo", type: :submit %>
    </div>
  <% end %>

  <div class="mt-4 text-center">
    <%= link_to "← Back", manage_producer_setup_path,
          class: "text-sm text-gray-400 hover:text-gray-600 underline-offset-2 hover:underline" %>
  </div>
<% end %>
