<%# Danger Zone tab, triggers only. The form-bearing modals are rendered
   outside the edit form (see edit/_danger_modals), opened here by id. %>
<% event_label = @show.event_type.titleize %>
<div class="space-y-4">
  <%# Move %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden [&>div:last-child]:border-b-0">
    <%= render "shared/section_heading", title: "Move to another production",
          intro: "Move this #{@show.event_type} to a different production you have access to. Assignments and vacancies move with it." do %>
      <%= render "shared/button", text: "Move #{event_label}", variant: "secondary", size: "small", type: :button,
            data: { action: "show-edit#openMoveModal" } %>
    <% end %>
  </div>

  <% if @show.canceled %>
    <%# Restore %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden [&>div:last-child]:border-b-0">
      <%= render "shared/section_heading", title: "Restore this #{@show.event_type}",
            intro: "This event is canceled. Restore it to the calendar." do %>
        <%= render "shared/button", text: "Uncancel", variant: "secondary", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: "danger-uncancel-modal" } %>
      <% end %>
    </div>
  <% else %>
    <%# Cancel %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden [&>div:last-child]:border-b-0">
      <%= render "shared/section_heading", title: "Cancel this #{@show.event_type}",
            intro: "Mark it canceled but keep it on the calendar (preserves history). You can uncancel later." do %>
        <%= render "shared/button", text: "Cancel #{event_label}", variant: "primary", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: "danger-cancel-modal" } %>
      <% end %>
    </div>
  <% end %>

  <%# Delete %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden [&>div:last-child]:border-b-0">
    <%= render "shared/section_heading", title: "Permanently delete",
          intro: "Remove this #{@show.event_type} and all its data. This can't be undone." do %>
      <%= render "shared/button", text: "Delete #{event_label}", variant: "primary", size: "small", type: :button,
            data: { controller: "modal", action: "click->modal#open", modal_id: "danger-delete-modal" } %>
    <% end %>
  </div>
</div>
