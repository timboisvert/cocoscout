<% content_for :title, "Welcome to #{@organization.name}" %>

<%
  acknowledged = @staff_member.acknowledged?
  bank_done = @staff_member.bank_connected?
  first_name = @staff_member.preferred_first_name.presence || @staff_member.first_name.presence || @person.name.to_s.split(" ").first
%>

<div class="max-w-2xl mx-auto px-4 py-10"
     data-controller="unavailability"
     data-unavailability-entries-value="<%= @unavailability_entries.to_json %>"
     data-unavailability-create-url-value="<%= my_create_shift_unavailability_path %>"
     data-unavailability-mode-value="<%= @availability_mode %>"
     data-unavailability-day-parts-value="<%= @availability_day_parts.to_json %>"
     data-unavailability-set-mode-url-value="<%= my_set_shift_availability_mode_path %>">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%# Warm welcome header %>
  <div class="text-center mb-8">
    <div class="w-16 h-16 rounded-2xl bg-pink-100 flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 0 0 0 6.364L12 20.364l7.682-7.682a4.5 4.5 0 0 0-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 0 0-6.364 0Z"/></svg>
    </div>
    <h1 class="text-3xl coustard-regular text-gray-900">Welcome to the team<%= ", #{first_name}" if first_name.present? %>!</h1>
    <p class="text-gray-600 mt-2 max-w-lg mx-auto">
      <span class="font-medium text-gray-900"><%= @organization.name %></span> has added you to their staff.
      Here are a couple of quick things to get you set up and ready to be paid.
    </p>
  </div>

  <div class="space-y-4 mt-8">
    <%# Step 1 — accept %>
    <div class="bg-white border <%= acknowledged ? "border-green-200" : "border-gray-200" %> rounded-lg p-5">
      <div class="flex items-start gap-4">
        <%= render "my/onboarding/step_marker", done: acknowledged, number: 1 %>
        <div class="flex-1 min-w-0">
          <% agreement_template = @staff_member.effective_agreement_template %>
          <% agreement_html = @staff_member.rendered_agreement_html %>
          <h3 class="font-semibold text-gray-900">Accept your spot on the team</h3>
          <% if acknowledged %>
            <p class="text-sm text-gray-600 mt-1">
              <% if agreement_template %>You've reviewed and agreed to your agreement with <%= @organization.name %>.<% else %>You've accepted your spot with <%= @organization.name %>.<% end %>
            </p>
            <p class="text-sm text-green-700 font-medium mt-2">You're in — thanks!</p>
          <% elsif agreement_html.present? %>
            <p class="text-sm text-gray-600 mt-1">Review your agreement with <%= @organization.name %>, then confirm you're on board.</p>
            <div class="mt-3">
              <%= render "shared/button", text: "Review & accept agreement", variant: "primary", size: "medium", type: :button,
                    data: { controller: "modal", action: "click->modal#open", modal_id: "staff-agreement-modal" } %>
            </div>

            <%# The agreement, popped in a modal; agreeing here is the acknowledgement. %>
            <div id="staff-agreement-modal"
                 class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
                 data-controller="modal"
                 data-action="click->modal#closeOnBackdrop">
              <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl mx-4 max-h-[85vh] flex flex-col overflow-hidden"
                   data-action="click->modal#stopPropagation">
                <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4 flex-shrink-0">
                  <h3 class="text-lg font-semibold text-white truncate"><%= agreement_template.name %></h3>
                  <button type="button" data-action="click->modal#close"
                          class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </button>
                </div>
                <div class="px-6 py-5 overflow-y-auto prose prose-sm max-w-none [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:my-1">
                  <%= agreement_html %>
                </div>
                <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2 flex-shrink-0">
                  <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button,
                        data: { action: "click->modal#close" } %>
                  <%= render "shared/button", text: "I agree & I'm in", variant: "primary", size: "medium",
                        path: my_acknowledge_onboarding_path(@organization.id), method: :post %>
                </div>
              </div>
            </div>
          <% else %>
            <p class="text-sm text-gray-600 mt-1">Let <%= @organization.name %> know you're on board.</p>
            <div class="mt-3">
              <%= render "shared/button", text: "I'm in", variant: "primary", size: "medium",
                    path: my_acknowledge_onboarding_path(@organization.id), method: :post %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Step 2 — get paid %>
    <div class="bg-white border <%= bank_done ? "border-green-200" : "border-gray-200" %> rounded-lg p-5">
      <div class="flex items-start gap-4">
        <%= render "my/onboarding/step_marker", done: bank_done, number: 2 %>
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold text-gray-900">Set up how you get paid</h3>
          <p class="text-sm text-gray-600 mt-1">Add your legal name and connect your bank so payments land automatically.</p>
          <div class="mt-3">
            <%= link_to my_payments_setup_path do %>
              <%= render "shared/button",
                    text: bank_done ? "Review payment details" : "Set up payments",
                    variant: bank_done ? "secondary" : "primary", size: "medium", type: :button %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# Step 3 — initial work availability. Marked done once anything is set;
        flips live when the calendar modal is closed with days marked. %>
    <% availability_set = @unavailability_entries.any? %>
    <div data-onboarding-step3-card class="bg-white border <%= availability_set ? "border-green-200" : "border-gray-200" %> rounded-lg p-5">
      <div class="flex items-start gap-4">
        <span data-onboarding-step3-pending class="<%= "hidden" if availability_set %>"><%= render "my/onboarding/step_marker", done: false, number: 3 %></span>
        <span data-onboarding-step3-done class="<%= "hidden" unless availability_set %>"><%= render "my/onboarding/step_marker", done: true, number: 3 %></span>
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold text-gray-900">Set your initial work availability</h3>
          <p class="text-sm text-gray-600 mt-1">Tell <%= @organization.name %> when you can work so they can schedule you. You can update this any time from My Shifts.</p>

          <div data-onboarding-step3-pending class="mt-3 <%= "hidden" if availability_set %>">
            <%= render "shared/button", text: "Set work availability", variant: "primary", size: "medium", type: :button,
                  data: { action: "click->unavailability#open" } %>
          </div>

          <div data-onboarding-step3-done class="mt-2 <%= "hidden" unless availability_set %>">
            <p class="text-sm text-green-700 font-medium">Availability set — thanks!</p>
            <button type="button" data-action="click->unavailability#open"
                    class="text-sm text-pink-600 hover:text-pink-700 mt-1 bg-transparent border-0 p-0 cursor-pointer">Update availability</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if acknowledged && bank_done %>
    <div class="mt-8 rounded-lg bg-green-50 border border-green-200 p-5 text-center">
      <p class="text-sm font-medium text-green-800">You're all set — <%= @organization.name %> can now schedule and pay you. 🎉</p>
    </div>
  <% end %>

  <%# The work-availability calendar modal (step 3 opens it in place). %>
  <%= render "my/shifts/availability_modal" %>

  <%# Celebration overlay, revealed when they finish availability and everything
      else is already done. %>
  <div id="onboarding-complete-overlay"
       class="hidden fixed inset-0 z-[80] bg-gray-900/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-8 text-center">
      <div class="w-16 h-16 rounded-2xl bg-green-100 flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      </div>
      <h2 class="text-2xl coustard-regular text-gray-900">Nice work — you're all set! 🎉</h2>
      <p class="text-gray-600 mt-2">
        You've accepted your spot, set up how you get paid, and told <%= @organization.name %> when you can work.
        Head to My Shifts to see your assignments.
      </p>
      <div class="mt-6 flex flex-col gap-2">
        <%= link_to my_shifts_path do %>
          <%= render "shared/button", text: "Go to My Shifts", variant: "primary", size: "large", type: :button, classes: "w-full" %>
        <% end %>
        <button type="button" onclick="document.getElementById('onboarding-complete-overlay').classList.add('hidden')"
                class="text-sm text-gray-500 hover:text-gray-700 bg-transparent border-0 cursor-pointer py-1">
          Keep looking around here
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    // Whether everything except availability is already done — decides if
    // finishing availability completes the whole onboarding.
    var allElseDone = <%= (acknowledged && bank_done).to_json.html_safe %>;

    document.addEventListener("unavailability:closed", function (event) {
      if (!event.detail || !event.detail.hasEntries) return;

      // Availability is set now — reflect that in step 3 without a reload.
      document.querySelectorAll("[data-onboarding-step3-pending]").forEach(function (el) { el.classList.add("hidden"); });
      document.querySelectorAll("[data-onboarding-step3-done]").forEach(function (el) { el.classList.remove("hidden"); });
      var card = document.querySelector("[data-onboarding-step3-card]");
      if (card) { card.classList.remove("border-gray-200"); card.classList.add("border-green-200"); }

      // If the other steps were already done, this was the last one — celebrate.
      if (allElseDone) {
        var overlay = document.getElementById("onboarding-complete-overlay");
        if (overlay) overlay.classList.remove("hidden");
      }
    });
  })();
</script>
