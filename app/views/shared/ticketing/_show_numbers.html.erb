<%# One show's ticket numbers (Ticketing::ListingStats): tiles, sales by
    ticket type, and discount codes used. The manager's show page and the
    producer view both render it. Locals: stats, read_only (producers see
    sales, not what the organization keeps), comps_modal / outside_modal (ids:
    the Comps and Sold elsewhere tiles open them; nil shows plain tiles). %>
<%
  read_only = local_assigns.fetch(:read_only, false)
  comps_modal = local_assigns[:comps_modal]
  outside_modal = local_assigns[:outside_modal]
  listing = stats.listing
  money = ->(cents) { number_to_currency(cents / 100.0) }
  # For the small lines under a number: whole dollars without the cents.
  brief = ->(cents) { number_to_currency(cents / 100.0, precision: (cents % 100).zero? ? 0 : 2) }
  started = listing.show.date_and_time <= Time.current
  outside = stats.outside_sold
  elsewhere_cents = stats.outside_cents
  seats = stats.seats_to_sell
  elsewhere = outside_modal || outside.positive? || elsewhere_cents.positive?
  amounts = stats.outside_amounts
  # The tiles, two rows (Tim, 2026-10-09): what sold here and its money, then
  # refunds; under them what sold elsewhere and its money, then comps. The
  # whole picture ("14 of 49 sold in all") rides under Sold here, what you
  # keep under Ticket sales here.
  # On a phone they pair up two by two instead: here, elsewhere, then
  # refunds and comps (the order classes; literal, so Tailwind sees them).
  # [label, value, note, tint, modal it opens, order]
  tiles = [
    [ "Sold here", stats.paid_sold.to_s,
      seats ? "#{stats.sold_anywhere} of #{seats} sold in all" : (stats.sold_anywhere == stats.paid_sold ? "No seat limit" : "#{stats.sold_anywhere} sold in all"), nil, nil, "order-1" ],
    [ "Ticket sales here", money.call(stats.gross_cents),
      read_only ? "Before fees and tax" : "You keep #{money.call(stats.net_cents)}#{stats.tax_cents.positive? ? ", plus #{money.call(stats.tax_cents)} tax to pay" : ' after fees'}", nil, nil, "order-2" ],
    [ "Refunded", stats.refunded_tickets.to_s, stats.refunded_cents.positive? ? "#{money.call(stats.refunded_cents)} back" : "None",
      stats.refunded_tickets.positive? ? "bg-amber-50 border-amber-200" : nil, nil, "order-5 lg:order-3" ],
    (elsewhere ? [ "Sold elsewhere", outside.to_s, outside.positive? ? stats.outside_words : "On other sites, off these seats",
                   outside.positive? ? "bg-violet-50 border-violet-200" : nil, outside_modal, "order-3 lg:order-4" ] : nil),
    (elsewhere ? [ "Ticket sales elsewhere", money.call(elsewhere_cents),
                   if amounts.any? then amounts.map { |name, cents| "#{brief.call(cents)} on #{name}" }.to_sentence
                   elsif outside.positive? then "Add the amounts in Sold elsewhere"
                   else "What other sites took, as you enter it"
                   end,
                   elsewhere_cents.positive? ? "bg-violet-50 border-violet-200" : nil, outside_modal, "order-4 lg:order-5" ] : nil),
    [ "Comps", stats.comps.to_s, comps_modal ? "Given away free · give tickets" : "Given away free", stats.comps.positive? ? "bg-blue-50 border-blue-200" : nil, comps_modal, "order-6" ],
    (started ? [ "Checked in", "#{stats.checked_in} of #{stats.sold}", stats.no_shows.to_i.positive? ? "#{stats.no_shows} didn't come" : "Everyone came", nil, nil, "order-7" ] : nil),
    (stats.products_sold.positive? ? [ "Products", stats.products_sold.to_s, "#{money.call(stats.product_cents)} before tax", "bg-pink-50 border-pink-200", nil, "order-8" ] : nil)
  ].compact
  codes = stats.discount_uses
%>
<div class="space-y-6">
  <%# Four tiles sit in one row; five or six go three to a row (3+2, 3+3), so
      none of them is squeezed. Literal class names, so Tailwind sees each. %>
  <div class="grid grid-cols-2 <%= tiles.size == 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3' %> gap-3">
    <% tiles.each do |label, value, note, tint, modal, order| %>
      <% inner = capture do %>
        <div class="text-xs text-gray-500"><%= label %></div>
        <div class="text-xl font-bold tabular-nums text-gray-900 mt-0.5"><%= value %></div>
        <div class="text-xs <%= modal ? 'text-pink-600' : 'text-gray-500' %> mt-0.5"><%= note %></div>
      <% end %>
      <% if modal %>
        <%# A tile that opens its modal: the thing to do is right where the number is. %>
        <%= link_to "#", class: "block rounded-lg border px-4 py-3 text-left hover:border-pink-400 transition-colors #{order} #{tint || 'bg-white border-gray-200'}",
              data: { controller: "modal", action: "click->modal#open", modal_id: modal } do %><%= inner %><% end %>
      <% else %>
        <div class="rounded-lg border px-4 py-3 <%= order %> <%= tint || 'bg-white border-gray-200' %>"><%= inner %></div>
      <% end %>
    <% end %>
  </div>
  <% if stats.capacity.to_i.positive? %>
    <div class="h-2 rounded-full bg-gray-100 overflow-hidden" aria-hidden="true">
      <div class="h-full bg-pink-500" style="width: <%= [ (stats.sold + outside) * 100.0 / stats.capacity, 100 ].min.round(1) %>%"></div>
    </div>
  <% end %>

  <%# By ticket type. Each row wears its state (Tim: colors, not badges):
      gray when it's hidden or no longer sold; red when it's sold out, marked
      so or out of seats (sold here, sold elsewhere and comps all count). A
      type no longer sold shows only while someone holds a ticket on it. %>
  <%
    # Under a type's Sold, when some sold elsewhere: how many here, then each
    # other site, a line each. Under its Sales, the money, each line saying
    # whose it is ("$450 on HotTix"), for the sites with an amount typed.
    shown = stats.by_tier.reject { |row| row.tier.archived_at && row.sold.zero? }
    # Bundles that sold, by the type they use: "4-Pack".
    bundle_names = shown.select { |r| r.tier.bundle? && r.sold.positive? }.group_by { |r| r.tier.bundle_of_tier_id }
                        .transform_values { |rs| rs.map { |r| r.tier.name }.to_sentence }
    breakdown = lambda do |row|
      sites = row.tier.bundle? ? [] : stats.outside_by_site(tier: row.tier)
      sold = []
      labeled = []
      if sites.any?
        sold.push("#{row.sold_here} here", *sites.map { |name, n, _| "#{n} on #{name}" })
        if sites.any? { |_, _, cents| cents.positive? }
          labeled.push("#{brief.call(row.gross_cents)} here", *sites.select { |_, _, cents| cents.positive? }.map { |name, _, cents| "#{brief.call(cents)} on #{name}" })
        end
      end
      # Its tickets sold in a bundle are already in its count and its money; say so.
      if row.in_bundles.positive?
        sold << "incl. #{row.in_bundles} in #{bundle_names[row.tier.id] || 'bundles'}"
        labeled << "incl. #{brief.call(row.bundle_cents)} in #{bundle_names[row.tier.id] || 'bundles'}"
      end
      { sold: sold, labeled: labeled, total: row.gross_cents + sites.sum { |_, _, cents| cents } }
    end
    # A bundle sits under the type it uses, counting purchases; its tickets
    # and money are the type's, so it adds nothing to the columns' totals.
    bases = shown.reject { |r| r.tier.bundle? }
    ordered = bases.flat_map { |b| [ b, *shown.select { |r| r.tier.bundle? && r.tier.bundle_of_tier_id == b.tier.id } ] }
    ordered += shown - ordered
    type_rows = ordered.map do |row|
      out_of_seats = row.tier.archived_at.nil? && row.remaining == 0
      tone = if row.tier.archived_at || row.tier.unlisted? then "text-gray-400"
             elsif row.tier.marked_sold_out? || out_of_seats then "text-red-700"
             end
      state = if row.tier.archived_at then nil
              elsif row.tier.unlisted? then "Hidden"
              elsif row.tier.marked_sold_out? || out_of_seats then "Sold out"
              end
      menu = (render("shared/ticketing/tier_menu", listing: listing, row: row) unless read_only || row.tier.archived_at)
      { row: row, tone: tone, state: state, menu: menu }
    end
  %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-4 sm:px-5 py-3 border-b border-gray-200"><h2 class="text-sm font-semibold text-gray-900">By ticket type</h2></div>

    <%# A phone: one block per type, every number on it, nothing to scroll. %>
    <ul class="sm:hidden divide-y divide-gray-100">
      <% type_rows.each do |r| %>
        <% row = r[:row] %>
        <% if row.tier.bundle? %>
          <%# A bundle, under its type: purchases, its tickets in the type's count. %>
          <li class="pl-8 pr-4 py-2.5 flex items-start gap-3 <%= r[:tone] %>">
            <div class="min-w-0 flex-1">
              <div class="text-sm <%= r[:tone] || 'text-gray-700' %>">
                <%= row.tier.name %><% if r[:state] %><span class="text-xs font-medium"> · <%= r[:state] %></span><% end %>
              </div>
              <div class="mt-0.5 text-xs tabular-nums text-gray-500">
                <%= ticket_price(row.tier.price_cents) %> · <%= row.sold %> sold<% if row.sold.positive? %>, <%= pluralize(row.sold * [ row.tier.admits.to_i, 1 ].max, "ticket") %> in <%= row.tier.bundle_of&.name %><% end %><%= " · #{row.remaining} remaining" unless row.remaining.nil? %>
              </div>
            </div>
            <% if r[:menu] %><div class="-my-1"><%= r[:menu] %></div><% end %>
          </li>
          <% next %>
        <% end %>
        <li class="px-4 py-3 flex items-start gap-3 <%= r[:tone] %>">
          <div class="min-w-0 flex-1">
            <div class="text-sm font-medium <%= r[:tone] || 'text-gray-900' %>">
              <%= row.tier.name %><%= " (no longer sold)" if row.tier.archived_at %>
              <% if r[:state] %><span class="text-xs font-medium">· <%= r[:state] %></span><% end %>
            </div>
            <div class="mt-0.5 text-xs tabular-nums <%= r[:tone] || 'text-gray-600' %>">
              <%= ticket_price(row.tier.price_cents) %> · <%= row.seats ? "#{row.seats} listed" : "no limit" %> · <%= row.sold_anywhere %> sold<%= " · #{pluralize(row.comps, 'comp')}" if row.comps.positive? %><%= " · #{row.remaining} remaining" unless row.remaining.nil? %>
            </div>
            <% b = breakdown.call(row) %>
            <% b[:sold].each do |line| %><div class="text-xs text-gray-500"><%= line %></div><% end %>
          </div>
          <div class="text-right">
            <div class="text-sm font-semibold tabular-nums <%= r[:tone] || 'text-gray-900' %>"><%= money.call(b[:total]) %></div>
            <% b[:labeled].each do |line| %><div class="text-xs text-gray-500 whitespace-nowrap"><%= line %></div><% end %>
          </div>
          <% if r[:menu] %><div class="-my-1"><%= r[:menu] %></div><% end %>
        </li>
      <% end %>
    </ul>

    <div class="hidden sm:block overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500">
          <tr>
            <th class="pl-4 pr-2 py-2 text-left font-medium">Ticket</th>
            <%# Left-aligned under their headings, except Sales: the money lines
                up on the right (Tim, 2026-10-09). %>
            <%# What it's listed at and how many, then what became of them: sold
                (here or elsewhere), comped, remaining (Tim, 2026-10-09). %>
            <th class="px-2 py-2 text-left font-medium">Price</th>
            <th class="px-2 py-2 text-left font-medium">Listed</th>
            <th class="px-2 py-2 text-left font-medium">Sold</th>
            <th class="px-2 py-2 text-left font-medium">Comps</th>
            <th class="px-2 py-2 text-left font-medium">Remaining</th>
            <th class="pl-2 pr-3 py-2 text-right font-medium">Sales</th>
            <% unless read_only %><th class="w-10"><span class="sr-only">Actions</span></th><% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% type_rows.each do |r| %>
            <% row = r[:row] %>
            <% if row.tier.bundle? %>
              <%# A bundle, under its type: purchases; its tickets and money are
                  already in the type's row, so nothing here adds to the totals. %>
              <tr class="align-top <%= r[:tone] %>">
                <td class="pl-8 pr-2 py-2 <%= r[:tone] || 'text-gray-700' %>">
                  <%= row.tier.name %><% if r[:state] %><span class="ml-1 text-xs font-medium">· <%= r[:state] %></span><% end %>
                </td>
                <td class="px-2 py-2 tabular-nums whitespace-nowrap"><%= ticket_price(row.tier.price_cents) %></td>
                <td class="px-2 py-2 text-gray-400">—</td>
                <td class="px-2 py-2 tabular-nums">
                  <%= row.sold %>
                  <% if row.sold.positive? %><div class="text-xs font-normal text-gray-500 whitespace-nowrap"><%= pluralize(row.sold * [ row.tier.admits.to_i, 1 ].max, "ticket") %>, in <%= row.tier.bundle_of&.name %></div><% end %>
                </td>
                <td class="px-2 py-2 text-gray-400">—</td>
                <td class="px-2 py-2 tabular-nums whitespace-nowrap"><%= row.remaining.nil? ? "No limit" : row.remaining %></td>
                <td class="pl-2 pr-3 py-2 text-right text-xs text-gray-400 whitespace-nowrap">in <%= row.tier.bundle_of&.name %></td>
                <% unless read_only %><td class="pr-2 py-1.5 text-right"><%= r[:menu] %></td><% end %>
              </tr>
              <% next %>
            <% end %>
            <tr class="align-top <%= r[:tone] %>">
              <td class="pl-4 pr-2 py-2.5 <%= r[:tone] || 'text-gray-900' %>">
                <%= row.tier.name %><%= " (no longer sold)" if row.tier.archived_at %>
                <% if r[:state] %><span class="ml-1 text-xs font-medium">· <%= r[:state] %></span><% end %>
              </td>
              <td class="px-2 py-2.5 tabular-nums whitespace-nowrap"><%= ticket_price(row.tier.price_cents) %></td>
              <td class="px-2 py-2.5 tabular-nums whitespace-nowrap"><%= row.seats || "No limit" %></td>
              <% b = breakdown.call(row) %>
              <td class="px-2 py-2.5 tabular-nums">
                <%= row.sold_anywhere %>
                <% b[:sold].each do |line| %><div class="text-xs font-normal text-gray-500 whitespace-nowrap"><%= line %></div><% end %>
              </td>
              <td class="px-2 py-2.5 tabular-nums"><%= row.comps %></td>
              <td class="px-2 py-2.5 tabular-nums whitespace-nowrap"><%= row.remaining.nil? ? "No limit" : row.remaining %></td>
              <td class="pl-2 pr-3 py-2.5 text-right tabular-nums whitespace-nowrap">
                <%= money.call(b[:total]) %>
                <% b[:labeled].each do |line| %><div class="text-xs font-normal text-gray-500"><%= line %></div><% end %>
              </td>
              <% unless read_only %><td class="pr-2 py-1.5 text-right"><%= r[:menu] %></td><% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if stats.products_sold.positive? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-200"><h2 class="text-sm font-semibold text-gray-900">Products</h2></div>
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500">
          <tr>
            <th class="px-5 py-2 text-left font-medium">Product</th>
            <th class="px-3 py-2 text-right font-medium">Sold</th>
            <th class="px-3 py-2 text-right font-medium">Delivered</th>
            <th class="px-5 py-2 text-right font-medium">Sales</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% stats.by_product.each do |row| %>
            <tr class="whitespace-nowrap">
              <td class="px-5 py-2.5 text-gray-900"><%= row.name %></td>
              <td class="px-3 py-2.5 text-right tabular-nums"><%= row.sold %></td>
              <td class="px-3 py-2.5 text-right tabular-nums"><%= row.handed_over %></td>
              <td class="px-3 sm:px-5 py-2.5 text-right tabular-nums"><%= money.call(row.gross_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if codes.any? %>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <h2 class="text-sm font-semibold text-gray-900">Discount codes</h2>
      <ul class="mt-2 space-y-1 text-sm">
        <% codes.each do |code, orders, cents| %>
          <li class="flex justify-between gap-3"><span class="text-gray-900"><%= code %> <span class="text-gray-500">· <%= pluralize(orders, "order") %></span></span><span class="tabular-nums text-gray-600">−<%= money.call(cents) %></span></li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
