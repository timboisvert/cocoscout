<%# Details tab — event type + the show's name. Mirrors the wizard's Type step. %>
<div class="space-y-6">
  <div>
    <%= form.label :event_type, "Event Type", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= render "shared/radio_card_grid",
          name: "show[event_type]",
          options: EventTypes.for_cards,
          selected: @show.event_type,
          columns: 3,
          action: "change->location-modal#updateEventType" %>
  </div>

  <div>
    <%= form.label :secondary_name, "Show Name", class: "block text-sm font-medium text-gray-700" %>
    <p class="text-sm text-gray-500 mt-0.5">What this event is called. We've suggested one from the production and the event type — change it to anything you like ("Opening Night", "Special Guest Performance").</p>
    <%# Pre-filled with the suggestion, so an unnamed show gets a real name the
        moment anyone saves it rather than one derived on every screen. %>
    <%= form.text_field :secondary_name,
          value: @show.display_name,
          class: "mt-2 block w-full rounded-lg border px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500 #{@show.errors[:secondary_name].any? ? 'border-pink-500' : 'border-gray-300'}" %>
  </div>
</div>
