
  <!-- Audition Session Modal -->
  <div id="auditionSessionModal" data-audition-session-modal-target="modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" data-action="click->audition-session-modal#closeOnBackdrop keydown.esc@window->audition-session-modal#close">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md max-h-[90vh] overflow-y-auto" data-action="click->audition-session-modal#stopPropagation">
      <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between">
        <h2 class="text-xl font-semibold text-gray-900 coustard-regular" data-audition-session-modal-target="title">New Audition Session</h2>
        <button type="button" data-action="click->audition-session-modal#close" class="text-gray-500 hover:text-gray-700">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="px-6 py-6" data-audition-session-modal-target="formContainer">
        <!-- Form will be loaded here -->
      </div>
    </div>
  </div>

  <!-- Location Modal -->
  <%= render "manage/locations/add_location_modal" %>
