<%#
  Slim, spreadsheet-style contracts list — mirrors the production list on
  manage/money. Left column is the contractor (production shown underneath their
  name); the three right columns carry Dates, Type, and Value + status.

  Locals:
    contracts: array of Contract objects
%>
<%= render layout: "shared/slim_list", locals: { label: "Contractor", columns: [ "Dates", "Type", "Value" ], col_class: "w-32", min_width: "min-w-[640px]" } do %>
  <% contracts.each do |contract| %>
    <%
      is_draft = contract.status_draft?
      contract_path = is_draft ? manage_resume_contract_wizard_path(contract) : manage_contract_path(contract)

      # Payment status
      pending_payments = contract.contract_payments.select(&:status_pending?)
      late_payments = pending_payments.select(&:overdue?)
      is_paid = pending_payments.empty? && contract.contract_payments.any?
      is_behind = late_payments.any?
      total_value = contract.contract_payments.sum(&:amount)

      # Revenue share
      payment_structure = contract.draft_payment_structure
      is_revenue_share = payment_structure == "revenue_share"
      payment_config = contract.draft_payment_config
      our_share = payment_config["revenue_our_share"].to_i if is_revenue_share
      their_share = payment_config["revenue_their_share"].to_i if is_revenue_share

      # Space bookings
      bookings_count = contract.space_rentals.count.positive? ? contract.space_rentals.count : contract.draft_bookings.count
      has_space_rental = bookings_count > 0

      # ---- Column 1: Dates ----
      dates_label = contract.date_range.presence || "—"

      # Production now sits under the contractor name (subtitle), not in a column.
      production_label = contract.production_name.presence || contract.production&.name

      # ---- Column 2: Type ----
      type_label = if has_space_rental
        "Rental · #{pluralize(bookings_count, 'booking')}"
      elsif is_revenue_share
        "#{our_share}/#{their_share} share"
      else
        "—"
      end

      # ---- Column 3: Value (+ status color) ----
      if is_revenue_share && contract.has_revenue_projection?
        our_range = contract.projected_our_revenue_range
        value_label = "#{number_to_currency(our_range[:low], precision: 0)}–#{number_to_currency(our_range[:high], precision: 0)}"
        value_class = "text-pink-600"
      elsif is_revenue_share
        value_label = "#{our_share}% of sales"
        value_class = "text-gray-900"
      elsif total_value > 0
        status_suffix = if is_paid
          " · paid"
        elsif is_behind
          " · #{pluralize(late_payments.size, 'late')}"
        elsif pending_payments.any?
          " · #{pending_payments.size} pending"
        else
          ""
        end
        value_label = "#{number_to_currency(total_value)}#{status_suffix}"
        value_class = is_paid ? "text-green-600" : (is_behind ? "text-red-600" : "text-gray-900")
      elsif is_draft
        value_label = "Not configured"
        value_class = "text-gray-400"
      else
        value_label = number_to_currency(0)
        value_class = "text-gray-400"
      end

      badge = is_draft ? { text: (contract.wizard_step > 1 ? "Draft · Step #{contract.wizard_step}/8" : "Draft"), color: "gray" } : nil
      subtitle = production_label.presence || contract.contractor_email.presence
    %>
    <%= render "shared/slim_list_row",
          title: contract.contractor_name,
          subtitle: subtitle,
          badge: badge,
          col_class: "w-32",
          href: contract_path,
          cells: [
            { value: dates_label, class: "text-gray-600 truncate" },
            { value: type_label, class: "text-gray-600" },
            { value: value_label, class: value_class }
          ] %>
  <% end %>
<% end %>
