<%#
  Settings Layout

  The shell for a module's settings page — Contract Settings, Course Settings,
  and anything else that grows a second topic. Sections are real URLs rendered
  as a list down the side, so a link can point at one section, only that section's data
  loads, and reordering the list never breaks a saved link.

  Render it with `render layout: "shared/settings_layout", locals: {...} do`
  and put the section body in the block. See
  manage/contract_settings/show.html.erb for a worked example.

  Locals:
    title       — page title (also the top_menu's current-page text)
    breadcrumbs — array of [name, path] pairs, as shared/top_menu expects
    sections    — array of { key:, label:, path:, badge:, feature:, locked:, group: };
                  `group:` puts a section under a heading, for pages with many
                  (SectionNavHelper#section_groups). The list is hidden
                  when there's only one, so a single-topic page looks plain
    current     — key of the section being shown
    intro       — optional sentence under the title, for the whole page
    banner      — optional html_safe content for a bar above the sections, for a
                  page that changes one thing within something bigger (one
                  date's ticket settings within its production's)
    width       — optional max-width class for the body. The default,
                  max-w-5xl, is every settings page's width: they all use
                  the content space (Tim, 2026-10-20). Pass one only for a
                  page that truly needs another.
    show_single_tab — pass true to show the list even with one section, for a
                  page that should look like its sibling settings pages
%>
<%
  sections ||= []
  breadcrumbs ||= []
  intro = local_assigns[:intro]
  width = local_assigns[:width].presence || "max-w-5xl"
  show_single_tab = local_assigns[:show_single_tab]
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: breadcrumbs,
    text: title,
    links: []
  } %>

  <% if intro.present? %>
    <p class="text-sm text-gray-600 max-w-2xl -mt-2 mb-5"><%= intro %></p>
  <% end %>

  <% if local_assigns[:banner].present? %>
    <div class="mb-5 rounded-lg border border-pink-200 bg-pink-50 px-4 py-3 text-sm text-pink-900"><%= local_assigns[:banner] %></div>
  <% end %>

  <%# The sections: a list down the left from md up (shared/section_list),
      and on a phone a row that opens them in a sheet (shared/section_picker),
      so none hides off the edge and each is a real link. It was a tab strip
      until 2026-11-20, which ran off the page once a page had more tabs
      than fit. %>
  <% show_sections = sections.size > 1 || (show_single_tab && sections.any?) %>
  <%
    nav_sections = sections.map { |section|
      { label: section[:label], path: section[:path], badge: section[:badge], pro: section[:feature].present?, locked: section[:locked],
        group: section[:group], danger: section[:danger], active: section[:key].to_s == current.to_s }
    }
  %>
  <% if show_sections %>
    <div data-settings-sections>
      <%= render "shared/section_picker", id: "settings-sections-sheet", list_from: "md", sections: nav_sections %>
    </div>
  <% end %>

  <div class="md:flex md:items-start md:gap-8">
    <% if show_sections %>
      <div class="contents" data-settings-tabs><%= render "shared/section_list", sections: nav_sections %></div>
    <% end %>
    <div class="flex-1 min-w-0">
      <div class="<%= width %> space-y-6">
        <%= yield %>
      </div>
    </div>
  </div>
</div>
