<%# Location tab — in-person venue/space or online. Mirrors the wizard's Location step. %>
<div class="space-y-4">
  <%= form.hidden_field :is_online, value: @show.is_online, data: { "location-modal-target": "isOnlineField" } %>

  <%# In-person %>
  <div data-location-modal-target="inPersonContainer" class="<%= @show.is_online ? 'hidden' : '' %>">
    <%= form.label :location_id, "Location", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.collection_select :location_id, Current.organization.locations.order(:created_at), :id, :name,
          { prompt: "Select a location" },
          {
            class: "block w-full rounded-lg border px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500 #{@show.errors[:location_id].any? ? 'border-pink-500' : 'border-gray-300'}",
            data: { "location-modal-target": "locationSelect", action: "change->location-modal#handleLocationChange" }
          } %>
    <div class="mt-2 flex gap-2 text-sm">
      <a href="#" data-action="click->location-modal#openModal" class="text-pink-500 hover:text-pink-600 underline">Add a location</a>
      <span class="text-gray-300">|</span>
      <a href="#" data-action="click->location-modal#toggleLocationType" class="text-pink-500 hover:text-pink-600 underline" data-location-modal-target="toggleLink">
        <span data-location-modal-target="toggleLinkText">Host <%= @show.event_type&.titleize&.downcase || 'event' %> online</span>
      </a>
    </div>

    <% current_spaces = location_spaces_map[@show.location_id] || [] %>
    <div data-location-modal-target="spaceContainer" class="mt-4 <%= 'hidden' if current_spaces.empty? %>">
      <%= form.label :location_space_id, "Space", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :location_space_id,
            options_for_select(current_spaces.map { |s| [ s[:name], s[:id] ] }, @show.location_space_id),
            { include_blank: "Entire venue" },
            { class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500",
              data: { "location-modal-target": "spaceSelect" } } %>
    </div>
  </div>

  <%# Online %>
  <div data-location-modal-target="onlineContainer" class="<%= @show.is_online ? '' : 'hidden' %>">
    <%= form.label :online_location_info, "Online details", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_field :online_location_info,
          placeholder: "e.g. Zoom link, YouTube Live URL, or 'Link will be emailed'",
          class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500" %>
    <div class="mt-2 flex gap-2 text-sm">
      <span class="text-gray-500">Optional — a URL or instructions for joining online.</span>
      <span class="text-gray-300">|</span>
      <a href="#" data-action="click->location-modal#toggleLocationType" class="text-pink-500 hover:text-pink-600 underline" data-location-modal-target="toggleLink">
        <span data-location-modal-target="toggleLinkText">Host <%= @show.event_type&.titleize&.downcase || 'event' %> in person</span>
      </a>
    </div>
  </div>
</div>
