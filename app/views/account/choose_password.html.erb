<%
  # Choosing a first password, or changing it (AccountController). The person
  # proves it's them with their current password or with a 6-digit code sent
  # to their email; someone who never chose a password only has the code.
  chosen    = Current.user.password_chosen?
  title     = chosen ? "Change your password" : "Choose a password"
  code_out  = @with_code && @code_sent.present?
  intro =
    if !@with_code
      "Enter your current password, then the new one. Saving it signs you out everywhere else."
    elsif code_out
      "Enter the code we emailed you, then your new password. Saving it signs you out everywhere else."
    elsif chosen
      "We'll email a 6-digit code to #{Current.user.email_address} to confirm it's you. Then you choose the new password."
    else
      "A password is optional: a code sent to your email always signs you in. To choose one, first confirm it's you with a 6-digit code sent to #{Current.user.email_address}."
    end
  problem = @proof_problem || @password_errors
%>
<% content_for :title, title %>

<div class="w-full">
  <div id="notice-container">
    <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-6">
    <%= render "shared/section_heading", title: title, intro: intro, padding: "px-4 py-3 sm:px-6 sm:py-4" do %>
      <%= render "shared/button", text: "Back to account", path: account_path, variant: "secondary", size: "small" %>
    <% end %>

    <div class="p-4 sm:p-6">
      <div class="max-w-md space-y-4">
        <% if problem.present? %>
          <%= render "shared/auth/notice", kind: :error, body: "#{problem.to_s.chomp('.')}." %>
        <% elsif code_out && @code_sent == "too_soon" %>
          <%= render "shared/auth/notice", body: "We sent you a code a moment ago, so use that one. It can take a minute to arrive." %>
        <% elsif code_out && @code_sent == "too_many" %>
          <%= render "shared/auth/notice", body: "We've sent you several codes in the last hour. Use the newest one, or request another later." %>
        <% end %>

        <% if @with_code && !code_out %>
          <%# Nothing has been sent yet: one button sends the code. %>
          <%= form_with url: password_code_account_path, class: "pt-1" do %>
            <%= render "shared/button", text: "Email me a code", variant: "primary", size: "medium", type: :submit %>
          <% end %>
        <% else %>
          <%= form_with url: choose_password_account_path, method: :patch, class: "space-y-4", data: { controller: "password-strength" } do |form| %>
            <% if @with_code %>
              <%= hidden_field_tag :with, "code", id: nil %>
              <%= render "shared/auth/code_field", error: @proof_problem.present? %>
            <% else %>
              <div data-controller="password-visibility">
                <label for="current_password" class="mb-1.5 block text-sm font-medium text-slate-700">Current password</label>
                <%= password_field_tag :current_password, nil, required: true, autocomplete: "current-password", maxlength: 72,
                      class: auth_input_class(error: @proof_problem.present?), data: { password_visibility_target: "input" } %>
              </div>
            <% end %>

            <%= render "shared/auth/password_field", form: form, label: "New password", strength: true, autocomplete: "new-password",
                  error: @password_errors.present? %>

            <div class="pt-1">
              <%= render "shared/button", text: "Save password", variant: "primary", size: "medium", type: :submit,
                    disabled: true, classes: "!opacity-50 !cursor-not-allowed", data: { password_strength_target: "submit" } %>
            </div>
          <% end %>

          <%= form_with url: password_code_account_path, id: "password-code-form" do %><% end %>
          <div>
            <%= render "shared/button", text: (@with_code ? "Send a new code" : "Forgot it? Email me a code instead"),
                  variant: "ghost", size: "small", type: :submit, form_id: "password-code-form",
                  classes: "!px-0 !text-pink-600 hover:!bg-transparent hover:!text-pink-700" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
