<%# Images, Links & Notes: this event's own poster and wide image (when it
    doesn't use the production's), its links, and notes for the people in
    it. Locals: form, input_class. %>
<%
  file_class = "w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:text-white file:bg-pink-500 hover:file:bg-pink-600"
  own_poster = @show.poster.attached? && @show.poster.blob&.persisted?
  own_wide = @show.wide_image.attached? && @show.wide_image.blob&.persisted?
  production_wide = @show.production&.wide_image&.attached?
  wide_src = own_wide ? url_for(@show.safe_wide_image_variant || @show.wide_image) : (production_wide ? url_for(@show.production.safe_wide_image_variant || @show.production.wide_image) : nil)
%>
<%= render layout: "manage/shows/edit/card", locals: { title: "Images", intro: "Pictures for this event only. Without them it uses the production's, from its Visual Assets." } do %>
  <%# Poster (3:4) %>
  <div class="poster-container">
    <div class="flex items-center gap-3 mb-1.5">
      <p class="text-sm font-medium text-gray-700">Poster</p>
      <% if own_poster %>
        <%= render "shared/button", text: "Remove", variant: "secondary", size: "xs", type: :button, data: { action: "click->show-edit#removePoster" } %>
      <% end %>
    </div>
    <% if own_poster %>
      <div class="mb-3 poster-image">
        <div class="w-full max-w-48 aspect-[3/4] rounded-lg overflow-hidden border border-gray-200 bg-white">
          <%= image_tag url_for(@show.poster), class: "w-full h-full object-cover" %>
        </div>
      </div>
      <%= form.hidden_field :remove_poster, value: "0", class: "remove-poster-hidden" %>
    <% end %>
    <div class="block w-full max-w-md rounded-lg border border-gray-300 bg-white px-3 py-2.5 shadow-sm">
      <%= form.file_field :poster, class: file_class %>
    </div>
    <p class="text-xs text-gray-500 mt-1">JPG or PNG.</p>
  </div>

  <%# Wide image (16:9): shown whole, never cropped. %>
  <div class="pt-4 border-t border-gray-100" data-controller="image-crops">
    <div class="flex items-center gap-3 mb-1.5">
      <p class="text-sm font-medium text-gray-700">Wide image (16:9)</p>
      <% if own_wide %>
        <label class="inline-flex items-center gap-1.5 text-xs text-gray-600">
          <%= form.check_box :remove_wide_image, { class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" }, "1", "0" %>
          Remove this event's wide image
        </label>
      <% end %>
    </div>
    <p class="text-xs text-gray-500 mb-2">
      <% if own_wide %>
        This event uses its own wide image.
      <% elsif production_wide %>
        Using the production's. Upload one to use a different picture for this date.
      <% else %>
        None yet. Add one here for this date, or for every date in the production's Visual Assets.
      <% end %>
    </p>
    <div class="mb-3 max-w-md <%= 'hidden' unless wide_src %>" data-image-crops-target="preview">
      <img src="<%= wide_src %>" alt="" class="w-full h-auto rounded-lg border border-gray-200 bg-gray-50" data-image-crops-target="frame">
    </div>
    <div class="block w-full max-w-md rounded-lg border border-gray-300 bg-white px-3 py-2.5 shadow-sm">
      <%= form.file_field :wide_image, accept: "image/jpeg,image/png,image/webp",
            data: { image_crops_target: "input", action: "change->image-crops#choose" }, class: file_class %>
    </div>
    <p class="hidden text-xs text-amber-700 mt-2" data-image-crops-target="warning"></p>
    <p class="text-xs text-gray-500 mt-1">Ideally 1920×1080. JPG, PNG or WebP up to 10 MB.</p>
  </div>
<% end %>

<%= render layout: "manage/shows/edit/card", locals: { title: "Links", intro: "Pages about this event, like a social post or a press listing. They show on its public page and to the cast." } do %>
  <div data-controller="show-links" class="space-y-2">
    <div id="show-links-fields" class="space-y-2" data-show-links-target="list">
      <%= form.fields_for :show_links do |show_link_form| %>
        <div class="flex items-start gap-2 show-links-fields-row" data-show-links-target="row">
          <%= show_link_form.hidden_field :id %>
          <%= show_link_form.hidden_field :_destroy, value: 0, class: "destroy-flag" %>
          <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-2">
            <%= show_link_form.text_field :text, placeholder: "What it says, like Press release", class: input_class %>
            <%= show_link_form.text_field :url, placeholder: "https://…", class: input_class %>
          </div>
          <%= link_to "Remove", "#", class: "remove-show-link mt-2.5 text-sm font-medium text-pink-600 hover:text-pink-700 whitespace-nowrap", data: { action: "show-links#remove" } %>
        </div>
      <% end %>
    </div>
    <%= link_to "Add a link", "#", class: "inline-block text-sm font-medium text-pink-600 hover:text-pink-700", data: { action: "show-links#add" } %>
    <template data-show-links-target="template">
      <div class="flex items-start gap-2 show-links-fields-row" data-show-links-target="row">
        <input type="hidden" name="show[show_links_attributes][new_show_links][id]" />
        <input type="hidden" name="show[show_links_attributes][new_show_links][_destroy]" value="0" class="destroy-flag" />
        <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-2">
          <input type="text" name="show[show_links_attributes][new_show_links][text]" placeholder="What it says, like Press release" class="<%= input_class %>" />
          <input type="text" name="show[show_links_attributes][new_show_links][url]" placeholder="https://…" class="<%= input_class %>" />
        </div>
        <a href="#" class="remove-show-link mt-2.5 text-sm font-medium text-pink-600 hover:text-pink-700 whitespace-nowrap" data-action="show-links#remove">Remove</a>
      </div>
    </template>
  </div>
<% end %>

<%= render layout: "manage/shows/edit/card", locals: { title: "Notes", intro: "For the cast and the production team, on this event's page. The public never sees them." } do %>
  <%= form.label :notes, "Notes", class: "sr-only" %>
  <%= form.text_area :notes, placeholder: "A family is celebrating a birthday in the audience. Bring your own water.", rows: 5, class: input_class %>
<% end %>
