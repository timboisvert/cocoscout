<%= render layout: "manage/staffing/staff_wizard/wizard_layout", locals: { current_step: 6, step_name: "Roles" } do %>
  <div class="flex items-start justify-between gap-4 mb-2">
    <div>
      <h2 class="text-xl font-bold text-gray-900 coustard-regular">What can they do?</h2>
      <p class="text-gray-600 mt-1">Pick the house roles <%= @staff_member.display_name.presence || "they" %> can fill. You can change these anytime.</p>
    </div>
  </div>

  <%= form_with url: manage_save_roles_staffing_staff_wizard_path, method: :post, class: "space-y-4" do %>
    <%= render "manage/staffing/roles_field", house_roles: @house_roles,
          assigned_ids: Array(@wizard_state[:house_role_ids]).map(&:to_i),
          role_rates: @wizard_state[:role_rates] || {},
          default_rate_dollars: @staff_member.hourly_rate_dollars %>

    <div class="flex items-center justify-between pt-4 border-t border-gray-200">
      <%= link_to "← Back", manage_pay_staffing_staff_wizard_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
      <%= render "shared/button", text: "Continue", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>

  <%= yield :staffing_modals %>
<% end %>
