<div data-controller="production-team-modals">
  <div class="mt-4">
    <%# A production under contract (docs/contract_people_plan.md): the
        contractor's side isn't on this team. They see the production on My
        through the contract, and that's where they're added or dropped. The
        team below is for the organization's own people, usually nobody. %>
    <% live_contracts = @production.contracts.where.not(status: %w[draft cancelled]).includes(:contractor, contract_people: :person).order(:id).to_a %>
    <% can_manage_contracts = Current.user&.superadmin? || Current.organization.manageable_by?(Current.user) %>
    <% live_contracts.each do |contract| %>
      <% people = ([ contract.contractor&.person ] + contract.contract_people.map(&:person)).compact.uniq %>
      <div class="mb-3 rounded-lg border border-pink-200 bg-pink-50 px-4 py-3 text-sm" data-contract-people-panel>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <span class="text-gray-800">
            <span class="font-medium text-gray-900"><%= contract.contractor_name %></span> sees this production through
            <%= can_manage_contracts ? link_to("their contract", manage_contract_path(contract), class: "font-medium text-pink-600 hover:text-pink-700") : "their contract" %>, not this team<%= people.any? ? ": #{people.map(&:name).to_sentence}." : "." %>
          </span>
          <% if contract.status_active? && can_manage_contracts %>
            <%= link_to "Change who's on it", amend_people_manage_contract_path(contract), class: "text-[13px] font-medium text-pink-600 hover:text-pink-700 flex-shrink-0" %>
          <% end %>
        </div>
      </div>
    <% end %>
    <%#
      One tile per person (Tim, 2026-11-11): who they are here, and whether
      this production notifies them. Clicking a tile opens the one modal
      that changes both. The production's own team first, then the
      organization's owner and managers, who manage every production and are
      listed so their notifications for this one can be turned off.
    %>
    <%
      ProductionNotificationSetting.ensure_settings_for(@production)
      notify_on = @production.production_notification_settings.where(enabled: true).pluck(:user_id).to_set
      organization = @production.organization
      permissions = @production.production_permissions
                               .includes(user: { default_person: { profile_headshots: { image_attachment: :blob } } })
                               .sort_by { |perm| (perm.user.person&.name || perm.user.email_address).downcase }
      team_ids = permissions.map(&:user_id).to_set
      org_roles = organization.organization_roles.where(company_role: %w[manager viewer]).pluck(:user_id, :company_role).to_h
      org_user_ids = (org_roles.keys + [ organization.owner_id ]).compact.uniq - team_ids.to_a
      org_users = User.where(id: org_user_ids)
                      .includes(default_person: { profile_headshots: { image_attachment: :blob } })
                      .sort_by { |u| (u.person&.name || u.email_address).downcase }

      team_tiles = permissions.map { |perm| { user: perm.user, role: perm.role, role_label: perm.role.capitalize, on_team: true } }
      org_tiles = org_users.map do |u|
        label = u.id == organization.owner_id ? "Organization owner" : "Organization #{org_roles[u.id]}"
        { user: u, role: nil, role_label: label, on_team: false }
      end
      can_edit_team = current_user_can_manage?(@production)
    %>

    <% [ [ "Production team", team_tiles ], [ "From #{organization.name}", org_tiles ] ].each do |heading, tiles| %>
      <% next if tiles.empty? && heading != "Production team" %>
      <div class="flex items-center justify-between gap-3 mb-2 <%= 'mt-8' unless heading == 'Production team' %>">
        <h3 class="text-sm font-semibold text-gray-900"><%= heading %></h3>
        <% if heading == "Production team" && can_edit_team %>
          <%= render "shared/button", text: "Add someone", variant: "primary", size: "small", type: :button,
                data: { action: "click->production-team-modals#openAddModal" } %>
        <% end %>
      </div>
      <% unless heading == "Production team" %>
        <p class="text-sm text-gray-500 mb-3">They manage every production in the organization. Choose here whether this one notifies them.</p>
      <% end %>

      <% if tiles.empty? %>
        <p class="text-sm text-gray-400 mb-4"><%= live_contracts.any? ? "Nobody from #{Current.organization.name} on this team. The contract's people see the production on My." : "Nobody on this production's own team yet." %></p>
      <% else %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <% tiles.each do |tile| %>
            <%
              user = tile[:user]
              person = user.person
              name = person&.name.presence || user.email_address
              notified = notify_on.include?(user.id)
              headshot_variant = person&.safe_headshot_variant(:thumb)
            %>
            <%= content_tag(can_edit_team ? :button : :div,
                  type: (can_edit_team ? "button" : nil),
                  class: "text-left w-full bg-white border border-gray-200 rounded-lg p-3 flex items-center gap-3 #{'cursor-pointer hover:border-pink-400 focus:outline-none focus:ring-2 focus:ring-pink-500 transition-colors' if can_edit_team}",
                  data: { team_tile: true, action: ("click->production-team-modals#openEditModal" if can_edit_team),
                          user_id: user.id, user_name: name, role: tile[:role], role_label: tile[:role_label],
                          on_team: tile[:on_team], notified: notified }) do %>
              <% if headshot_variant %>
                <%= image_tag headshot_variant, alt: name, class: "w-12 h-12 rounded-lg object-cover flex-shrink-0" %>
              <% else %>
                <div class="w-12 h-12 rounded-lg bg-gray-200 flex items-center justify-center flex-shrink-0 text-gray-600 font-bold text-sm">
                  <%= person&.initials.presence || name.first.upcase %>
                </div>
              <% end %>
              <div class="min-w-0 flex-1">
                <div class="text-sm font-medium text-gray-900 truncate"><%= name %></div>
                <div class="text-xs font-medium text-pink-600 truncate"><%= tile[:role_label] %></div>
                <div class="mt-1 flex items-center gap-1 text-xs <%= notified ? 'text-gray-700' : 'text-gray-400' %>">
                  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <% if notified %>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
                    <% else %>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.143 17.082a24.248 24.248 0 0 0 3.844.148m-3.844-.148a23.856 23.856 0 0 1-5.455-1.31 8.964 8.964 0 0 0 2.3-5.542m3.155 6.852a3 3 0 0 0 5.667 1.97m1.965-2.277L21 21m-4.225-4.225a23.81 23.81 0 0 0 3.536-1.003A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6.53 6.53m10.245 10.245L6.53 6.53M3 3l3.53 3.53" />
                    <% end %>
                  </svg>
                  <span><%= notified ? "Notified" : "Not notified" %></span>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <% if heading == "Production team" %>
        <%# Pending invitations for this production %>
        <% pending_invitations = @production.team_invitations.where(accepted_at: nil) %>
        <% if pending_invitations.any? %>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-3">
            <% pending_invitations.each do |invite| %>
              <div class="bg-white border border-dashed border-gray-300 rounded-lg p-3 flex items-center gap-3">
                <div class="w-12 h-12 rounded-lg bg-yellow-100 flex items-center justify-center flex-shrink-0 text-yellow-700 font-bold text-sm">
                  <%= invite.email.first.upcase %>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="text-sm font-medium text-gray-900 truncate"><%= invite.email %></div>
                  <div class="text-xs font-medium text-yellow-700 truncate">Invited as <%= (invite.invitation_role || "viewer").downcase %></div>
                  <div class="mt-1 text-xs text-gray-400"><%= time_ago_in_words(invite.created_at) %> ago</div>
                </div>
                <% if can_edit_team %>
                  <% revoke_prod_invite_cid = "confirm-revoke-prod-invite-#{invite.id}" %>
                  <%= render "shared/button", text: "Revoke", variant: "secondary", size: "small", type: :button,
                        data: { controller: "modal", action: "click->modal#open", modal_id: revoke_prod_invite_cid } %>
                  <%= render "shared/confirm_modal",
                        id: revoke_prod_invite_cid,
                        title: "Revoke invitation?",
                        message: "#{h invite.email} won't be able to use the link they were sent.",
                        confirm_text: "Revoke",
                        url: revoke_production_invite_manage_production_path(@production, invite_id: invite.id),
                        method: :delete,
                        form_data: { turbo: false } %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <!-- Add Team Member Modal -->
  <div data-production-team-modals-target="addModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" data-action="click->production-team-modals#closeAddModal">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full max-h-[85vh] flex flex-col overflow-hidden" data-action="click->production-team-modals#stopPropagation" data-controller="production-team-search">
      <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4 flex-shrink-0">
        <h2 class="text-lg font-semibold text-white">Add to the production team</h2>
      </div>
      <div class="p-6 overflow-y-auto">
        <%= form_with url: add_team_member_manage_production_path(@production), method: :post, data: { turbo: false } do |f| %>
          <input type="hidden" name="user_id" value="" data-production-team-search-target="userIdInput">
          <input type="hidden" name="email" value="" data-production-team-search-target="emailInput">

          <%# Who: the shared People Picker (V1.1 plan §5): someone here with an
              account, anyone on CocoScout by name or exact email, or an email
              to invite. %>
          <div data-production-team-search-target="searchSection">
            <p class="text-sm text-gray-600 mb-3">Someone in your organization, anyone on CocoScout, or an email to invite.</p>
            <%= render "shared/button", text: "Choose a person", variant: "primary", size: "medium", type: :button,
                  data: { controller: "people-picker-trigger", action: "click->people-picker-trigger#open",
                          "people-picker-trigger-id-value": "team-picker", "people-picker-trigger-title-value": "Add to the production team" } %>
          </div>
          <%= render "shared/people_picker", id: "team-picker", title: "Add to the production team", scope: "users",
                production_id: @production.id, outside: true, invite: true,
                hint: "Someone here, anyone on CocoScout by name or exact email, or an email to invite",
                pick_action: "people-picker:pick->production-team-search#picked" %>

          <%# Selected user display (hidden initially) %>
          <div data-production-team-search-target="selectedUser" class="hidden">
            <div class="flex items-center gap-3 p-3 border border-green-300 bg-green-50 rounded-lg mb-4">
              <div class="flex-grow min-w-0">
                <span class="font-medium text-sm block truncate" data-production-team-search-target="selectedUserName"></span>
                <span class="text-xs text-gray-500 block truncate" data-production-team-search-target="selectedUserEmail"></span>
              </div>
              <button type="button" class="text-xs text-gray-500 hover:text-gray-700 cursor-pointer flex-shrink-0" data-action="production-team-search#backToSearch">Change</button>
            </div>
          </div>

          <%# Invite section (hidden initially) %>
          <div data-production-team-search-target="inviteSection" class="hidden">
            <div class="p-3 border border-yellow-300 bg-yellow-50 rounded-lg mb-4">
              <p class="text-sm font-medium text-gray-900 mb-1">Invite by email</p>
              <p class="text-xs text-gray-500 mb-2">This person isn't on CocoScout yet. They'll receive an invitation email.</p>
              <div class="mt-2">
                <button type="button" class="text-xs text-gray-500 hover:text-gray-700 cursor-pointer" data-action="production-team-search#backToSearch">Back to search</button>
              </div>
            </div>
          </div>

          <%# Role (hidden until user selected) %>
          <div data-production-team-search-target="roleSection" class="hidden space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Role</label>
              <%= select_tag :role,
                  options_for_select([["Manager", "manager"], ["Viewer", "viewer"]], "manager"),
                  class: "w-full text-sm rounded-lg border border-gray-300 px-3 py-2"
              %>
            </div>
            <div class="mt-6 flex justify-end gap-3">
              <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->production-team-modals#closeAddModal" } %>
              <%= render "shared/button", text: "Add to Production", variant: "primary", size: "medium", type: :submit %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Edit Team Member Modal: role and notifications in one place -->
  <div data-production-team-modals-target="editModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center sm:p-4" data-action="click->production-team-modals#closeEditModal">
    <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full sm:max-w-md overflow-hidden" data-action="click->production-team-modals#stopPropagation">
      <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
        <h2 class="text-lg font-semibold text-white truncate" data-production-team-modals-target="editUserName"></h2>
        <button type="button" data-action="click->production-team-modals#closeEditModal" aria-label="Close"
                class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <%= form_with url: update_team_permission_manage_production_path(@production), method: :patch, id: "edit-team-member-form", data: { turbo: false, "production-team-modals-target": "editForm" } do |f| %>
        <input type="hidden" name="user_id" data-production-team-modals-target="editUserId">
        <div class="px-6 py-5 space-y-5">
          <div data-production-team-modals-target="editRoleSection">
            <label for="edit-team-role" class="block text-sm font-medium text-gray-700 mb-2">Role on this production</label>
            <%= select_tag :role,
                options_for_select([["Manager", "manager"], ["Viewer", "viewer"]]),
                id: "edit-team-role",
                class: "w-full text-sm rounded-lg border border-gray-300 px-3 py-2",
                data: { "production-team-modals-target": "editRole" } %>
            <p class="text-xs text-gray-500 mt-1.5">A manager can change things. A viewer can only look.</p>
          </div>
          <div class="hidden" data-production-team-modals-target="editOrgRoleSection">
            <div class="text-sm font-medium text-gray-700 mb-1">Role</div>
            <p class="text-sm text-gray-900" data-production-team-modals-target="editOrgRole"></p>
            <p class="text-xs text-gray-500 mt-1.5">Set for the whole organization, on its Team page. It can't be changed for one production.</p>
          </div>
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="text-sm font-medium text-gray-700">Notifications</div>
              <p class="text-xs text-gray-500 mt-1">Messages people send to this production, audition requests, sign-ups, and people who can't make a show. With them off, the messages are still in the inbox.</p>
            </div>
            <%= render "shared/toggle_switch", name: "notifications", checked: false, hidden_false: true,
                  aria_label: "Notifications for this production",
                  data: { "production-team-modals-target": "editNotifications" } %>
          </div>
        </div>
      <% end %>
      <div class="px-4 sm:px-6 pt-3 pb-[calc(env(safe-area-inset-bottom)+12px)] sm:py-4 bg-gray-50 border-t border-gray-200 flex flex-col-reverse sm:flex-row sm:items-center gap-2 [&_button]:w-full sm:[&_button]:w-auto">
        <div data-production-team-modals-target="editRemove">
          <%= render "shared/button", text: "Remove from team", variant: "secondary", size: "medium", type: :button,
                data: { action: "click->production-team-modals#removeFromEdit" } %>
        </div>
        <div class="sm:ml-auto flex flex-col-reverse sm:flex-row gap-2">
          <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->production-team-modals#closeEditModal" } %>
          <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit, form_id: "edit-team-member-form" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Remove Confirmation Modal -->
  <div data-production-team-modals-target="removeModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" data-action="click->production-team-modals#closeRemoveModal">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full overflow-hidden" data-action="click->production-team-modals#stopPropagation">
      <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4 flex-shrink-0">
        <h2 class="text-lg font-semibold text-white">Remove from the team?</h2>
      </div>
      <div class="p-6">
        <p class="text-sm text-gray-600 mb-4">
          Are you sure you want to remove <strong data-production-team-modals-target="removeUserName"></strong> from this production?
        </p>
        <p class="text-xs text-gray-500 mb-6">They will no longer have access to manage or view this production.</p>
        <%= form_with url: remove_team_member_manage_production_path(@production), method: :delete, data: { turbo: false, "production-team-modals-target": "removeForm" } do |f| %>
          <input type="hidden" name="user_id" data-production-team-modals-target="removeUserId">
          <div class="flex justify-end gap-3">
            <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->production-team-modals#closeRemoveModal" } %>
            <%= render "shared/button", text: "Remove", variant: "primary", size: "medium", type: :submit %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
