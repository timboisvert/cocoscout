<%# The production team as headshot squares, the reader's own ringed pink,
    then the invitations still waiting as dashed squares; one dashed square
    when there's nobody. Locals: page, size (Tailwind size classes). %>
<% size = local_assigns.fetch(:size, "w-10 h-10") %>
<span class="inline-flex flex-wrap items-center gap-1" data-production-team-faces>
  <% page.team.each do |permission| %>
    <%
      user = permission.user
      person = user.default_person || user.person
      me = user.id == page.user.id
      tip = "#{me ? 'You' : (person&.name || user.email_address)} · #{ProductionPageHelper::TEAM_ROLES[permission.role]&.downcase}"
      headshot = person&.safe_headshot_variant(:thumb)
      ring = me ? " ring-2 ring-pink-400" : ""
    %>
    <% if headshot %>
      <span class="inline-flex" data-controller="tooltip" data-tooltip-text="<%= tip %>"><%= image_tag headshot, alt: person.name, class: "#{size} rounded-lg object-cover#{ring}" %></span>
    <% else %>
      <span class="<%= size %> rounded-lg bg-gray-200 text-gray-700 inline-flex items-center justify-center font-bold text-xs<%= ring %>" data-controller="tooltip" data-tooltip-text="<%= tip %>"><%= person&.initials.presence || user.email_address.first.upcase %></span>
    <% end %>
  <% end %>
  <% if page.manager? %>
    <% page.invitations.each do |invite| %>
      <span class="<%= size %> rounded-lg bg-gray-50 border border-dashed border-gray-300 text-gray-500 inline-flex items-center justify-center font-bold text-xs"
            data-controller="tooltip" data-tooltip-text="<%= invite.email %> · invited, not yet accepted"><%= invite.person&.initials.presence || invite.email.first.upcase %></span>
    <% end %>
  <% end %>
  <% if page.team.empty? && page.invitations.empty? %>
    <span class="<%= size %> rounded-lg bg-gray-50 border border-dashed border-gray-300 inline-flex items-center justify-center text-gray-300" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
    </span>
  <% end %>
</span>
