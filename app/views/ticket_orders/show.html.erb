<%
  show = @listing.show
  tickets = @order.tickets.select { |t| Ticket::SOLD_STATUSES.include?(t.status) }.sort_by(&:id)
  place = [ show.location&.name, show.location_space&.name ].compact.uniq.join(" · ")
  waiting = @order.pending? && @order.stripe_payment_intent_id.present?
  moved = @order.exchanges_out.includes(to_order: { ticket_listing: :show }).order(:id).to_a
  items = @order.ticket_order_items.sold.order(:id).to_a
%>
<% content_for :title, "Your tickets · #{@listing.display_title}" %>
<% content_for :head do %>
  <%# Waiting on Stripe to confirm: look again in a few seconds. %>
  <% if waiting %><meta http-equiv="refresh" content="4"><% end %>
  <meta name="robots" content="noindex">
<% end %>

<div class="mx-auto max-w-lg">
  <% if @order.paid? %>
    <h1 class="text-2xl sm:text-3xl coustard-regular text-gray-900">You're going!</h1>
  <% elsif waiting %>
    <h1 class="text-2xl sm:text-3xl coustard-regular text-gray-900">Confirming your payment…</h1>
    <p class="mt-2 text-gray-600">This usually takes a few seconds. This page updates by itself.</p>
  <% elsif @order.status == "canceled" %>
    <h1 class="text-2xl sm:text-3xl coustard-regular text-gray-900">This order was canceled</h1>
    <p class="mt-2 text-gray-600">The seats were gone by the time your payment arrived, so it was refunded in full.</p>
  <% elsif @order.status == "refunded" %>
    <h1 class="text-2xl sm:text-3xl coustard-regular text-gray-900"><%= @order.money_path == "none" ? "These tickets were canceled" : "This order was refunded" %></h1>
  <% elsif @order.status == "exchanged" %>
    <h1 class="text-2xl sm:text-3xl coustard-regular text-gray-900">Your tickets moved</h1>
    <p class="mt-2 text-gray-600"><%= @listing.organization.name %> moved these tickets to another date. The ones below are the old date; your new tickets are here:</p>
  <% else %>
    <h1 class="text-2xl sm:text-3xl coustard-regular text-gray-900">This order wasn't completed</h1>
    <div class="mt-4">
      <%= render "shared/button", text: "Back to tickets", variant: "primary", size: "medium",
            path: tickets_event_path(org: @ticketing_profile.slug, event: @listing.slug, **embed_params) %>
    </div>
  <% end %>

  <% moved.each do |exchange| %>
    <% new_order = exchange.to_order %>
    <div class="mt-4 rounded-xl border border-pink-200 bg-pink-50 px-5 py-4 flex flex-wrap items-center justify-between gap-3">
      <div class="text-sm text-gray-900">
        <%= pluralize(exchange.ticket_ids.size, "ticket") %> moved to <strong><%= new_order.ticket_listing.show.date_and_time.strftime("%A, %B %-d · %-l:%M %p") %></strong>
      </div>
      <%= render "shared/button", text: "See the new tickets", variant: "primary", size: "small",
            path: tickets_order_path(token: new_order.token, **embed_params) %>
    </div>
  <% end %>

  <div class="mt-6 rounded-xl border border-gray-200 p-5">
    <div class="text-sm font-medium text-pink-600"><%= @listing.organization.name %></div>
    <div class="mt-1 text-lg font-semibold text-gray-900"><%= @listing.display_title %></div>
    <div class="mt-1 text-gray-700"><%= show.date_and_time.strftime("%A, %B %-d · %-l:%M %p") %></div>
    <% if place.present? %><div class="text-sm text-gray-500"><%= place %></div><% end %>
    <% if @order.paid? %>
      <div class="mt-3 flex flex-wrap gap-3 text-sm">
        <%= link_to "Add to calendar", tickets_order_calendar_path(token: @order.token), class: "text-pink-600 hover:text-pink-700" %>
        <% if show.location&.address1.present? %>
          <%= link_to "Directions", "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode([ show.location.name, show.location.address1, show.location.city ].compact.join(', '))}",
                target: "_blank", rel: "noopener", class: "text-pink-600 hover:text-pink-700" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @order.paid? %>
    <p class="mt-6 text-sm text-gray-600">Show these at the door — on your phone or printed. We also emailed them to <%= @order.buyer_email %>.</p>
    <div class="mt-3 grid gap-4 sm:grid-cols-2">
      <% tickets.each_with_index do |ticket, index| %>
        <div class="rounded-xl border border-gray-200 p-4 text-center">
          <div class="text-xs text-gray-500">Ticket <%= index + 1 %> of <%= tickets.size %> · <%= ticket.ticket_tier.name %></div>
          <div class="mx-auto mt-3 w-40"><%= ticket_qr_svg(ticket) %></div>
          <% if ticket.checked_in? %><div class="mt-2 text-xs font-medium text-gray-500">Checked in</div><% end %>
        </div>
      <% end %>
    </div>

    <% if items.any? %>
      <div class="mt-6 rounded-xl border border-gray-200 p-5">
        <div class="text-sm font-semibold text-gray-900">Also with this order</div>
        <ul class="mt-2 space-y-1.5">
          <% items.each do |item| %>
            <li class="text-sm text-gray-700">
              <span class="font-medium text-gray-900"><%= item.quantity %> × <%= item.name %></span>
              <% if item.description.present? %><span class="text-gray-500">· <%= item.description %></span><% end %>
              <% if item.fulfilled? %><span class="ml-1 text-xs font-medium text-green-700">Delivered</span><% end %>
            </li>
          <% end %>
        </ul>
        <p class="mt-2 text-xs text-gray-500">Waiting for you at the show. The door has it on your order.</p>
      </div>
    <% end %>

    <% if @deals.present? %>
      <%= render "ticket_orders/deals", order: @order, deals: @deals %>
    <% end %>

    <%# A pass (or any checkout with several shows): each show's tickets live on
        its own order page, one tap away. %>
    <% siblings = @order.ticket_purchase ? @order.ticket_purchase.ticket_orders.where.not(id: @order.id).includes(ticket_listing: :show).to_a : [] %>
    <% if siblings.any? %>
      <% pass = tickets.first&.ticket_pass %>
      <div class="mt-6 rounded-xl border border-pink-200 bg-pink-50 p-5">
        <div class="text-sm font-semibold text-gray-900"><%= pass ? "Your #{pass.name} also covers" : "Also in this purchase" %></div>
        <ul class="mt-2 space-y-2">
          <% siblings.each do |sibling| %>
            <li class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-sm text-gray-800">
                <span class="font-medium"><%= sibling.ticket_listing.display_title %></span>
                · <%= sibling.ticket_listing.show.date_and_time.strftime("%a, %b %-d · %-l:%M %p") %>
              </span>
              <%= render "shared/button", text: "See these tickets", variant: "secondary", size: "small",
                    path: tickets_order_path(token: sibling.token, **embed_params) %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# The policy they bought under, and how to ask. %>
    <% if (refund_words = @order.refund_policy_words) %>
      <div class="mt-6 rounded-xl border border-gray-200 bg-white p-5 text-sm text-gray-700">
        <div class="font-semibold text-gray-900">Refund policy</div>
        <p class="mt-1"><%= refund_words %></p>
        <p class="mt-2 text-gray-600">To ask for a refund, reply to your confirmation email.</p>
      </div>
    <% end %>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 text-sm text-gray-600">
      <span>Order <%= @order.code %> · <%= number_to_currency(@order.total_cents / 100.0) %></span>
      <%= render "shared/button", text: "Email my tickets again", variant: "secondary", size: "small",
            path: tickets_order_resend_path(token: @order.token, **embed_params), method: :post %>
    </div>
  <% end %>
</div>
