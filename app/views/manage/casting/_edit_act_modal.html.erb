<%# The board's pencil: rename an act, or rename/resize a show role.
    running_order_controller fills the fields and swaps the vocabulary. %>
<div id="edit-act-modal" data-running-order-target="editActModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" data-action="click->running-order#closeEditModal">
  <div class="bg-white w-full max-w-md rounded-lg shadow-xl overflow-hidden" data-action="click->running-order#stopPropagation">
    <div class="bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-white" data-running-order-target="editActTitle">Edit Act</h2>
      <button type="button" data-action="click->running-order#closeEditModal" class="text-white/80 hover:text-white p-1 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <form data-action="submit->running-order#saveEdit">
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1" for="edit-act-name">Name</label>
          <input type="text" id="edit-act-name" data-running-order-target="editActNameInput" list="act-name-suggestions"
                 class="w-full rounded-md border border-gray-300 py-2.5 px-3 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500 text-sm" />
        </div>
        <div data-running-order-target="editActQuantityField" class="hidden">
          <label class="block text-sm font-medium text-gray-700 mb-1" for="edit-act-quantity">How many people?</label>
          <input type="number" id="edit-act-quantity" data-running-order-target="editActQuantityInput"
                 min="1" max="20" value="1"
                 class="w-24 rounded-md border border-gray-300 py-2.5 px-3 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500 text-sm" />
        </div>
      </div>

      <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-3">
        <%= render "shared/button", text: "Cancel", variant: "secondary", type: :button, data: { action: "click->running-order#closeEditModal" } %>
        <%= render "shared/button", text: "Save", variant: "primary", type: :submit %>
      </div>
    </form>
  </div>
</div>
