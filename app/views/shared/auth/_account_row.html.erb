<%#
  The read-only "Account" row on pages where the email is already decided
  (an invitation, a reset link): the address with a small lock.
  Locals: email, label (default "Account").
%>
<div>
  <div class="mb-1.5 block text-sm font-medium text-slate-700"><%= local_assigns[:label] || "Account" %></div>
  <div class="flex items-center justify-between gap-3 rounded-lg border border-slate-200 bg-slate-100 px-3 py-2.5">
    <span class="truncate text-base text-slate-900"><%= local_assigns.fetch(:email) %></span>
    <svg class="h-[18px] w-[18px] flex-shrink-0 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
  </div>
</div>
