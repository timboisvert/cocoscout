<% content_for :title, "Create Show - #{step_name}" %>

<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Shows & Events", manage_shows_path],
      [@production.name, manage_production_shows_path(@production)]
    ],
    text: "Create Show",
    links: []
  } %>

  <%
    wizard_steps = [
      { name: "Type", path: manage_shows_wizard_path(@production) },
      { name: "Schedule", path: manage_shows_wizard_schedule_path(@production) },
      { name: "Location", path: manage_shows_wizard_location_path(@production) },
      { name: "Details", path: manage_shows_wizard_details_path(@production) },
      { name: "Review", path: manage_shows_wizard_review_path(@production) }
    ]
    current_index = current_step - 1
  %>
  <%# Full-width step bar, directly below the breadcrumb. %>
  <%= render "shared/wizard_steps", steps: wizard_steps, current_index: current_index %>

  <div class="max-w-2xl mx-auto mt-8">
    <!-- Step Content -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <%= yield %>
    </div>

    <!-- Cancel Link -->
    <div class="mt-4 text-center">
      <% wizard_cancel_cid = "confirm-#{SecureRandom.hex(6)}" %>
      <button type="button"
          data-controller="modal" data-action="click->modal#open" data-modal-id="<%= wizard_cancel_cid %>"
          class="text-sm text-gray-500 hover:text-gray-700 bg-transparent border-0 cursor-pointer">Cancel</button>
      <%= render "shared/confirm_modal", id: wizard_cancel_cid, title: "Discard this event?",
            message: "Your progress will be lost.", confirm_text: "Discard", cancel_text: "Keep editing",
            url: manage_shows_wizard_cancel_path(@production), method: :delete %>
    </div>
  </div>
</div>
