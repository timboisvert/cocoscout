<% content_for :title, "Create Course - #{local_assigns[:step_name] || 'Setup'}" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Courses", manage_course_offerings_path]
    ],
    text: "Add a Course",
    links: []
  } %>

  <%
    wizard_steps = [
      { num: 1, name: "Basics", path: manage_course_wizard_basics_path },
      { num: 2, name: "Instructor", path: manage_course_wizard_instructor_path },
      { num: 3, name: "Schedule", path: manage_course_wizard_schedule_path },
      { num: 4, name: "Pricing", path: manage_course_wizard_pricing_path },
      { num: 5, name: "Details", path: manage_course_wizard_details_path },
      { num: 6, name: "Review", path: manage_course_wizard_review_path }
    ]
    current_index = wizard_steps.index { |s| s[:num] == @step } || 0
  %>
  <%# Full-width step bar, directly below the breadcrumb. %>
  <%= render "shared/wizard_steps", steps: wizard_steps, current_index: current_index %>

  <div class="max-w-2xl mx-auto">
    <!-- Step Content -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <%= yield %>
    </div>

    <!-- Cancel Link -->
    <div class="mt-4 text-center">
      <% cancel_cid = "confirm-#{SecureRandom.hex(6)}" %>
      <button type="button"
              data-controller="modal"
              data-action="click->modal#open"
              data-modal-id="<%= cancel_cid %>"
              class="text-sm text-gray-500 hover:text-gray-700 bg-transparent border-0 cursor-pointer">Cancel</button>
      <%= render "shared/confirm_modal",
            id: cancel_cid,
            title: "Discard this course?",
            message: "Your progress will be lost.",
            confirm_text: "Discard",
            cancel_text: "Keep editing",
            url: manage_course_wizard_cancel_path,
            method: :delete %>
    </div>
  </div>
</div>
