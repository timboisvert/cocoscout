<% content_for :title, "Assign Slots - #{@sign_up_form.name}" %>

<%
  is_open_list = @sign_up_form.slot_generation_mode == "open_list"
  show_slot_label = !%w[simple_capacity open_list].include?(@sign_up_form.slot_generation_mode)
  supports_drag = show_slot_label  # Drag-drop for numbered, time_based, named lists
%>

<div class="w-full"
     data-controller="<%= supports_drag ? 'assign-drag' : '' %> add-sign-up-person"
     data-add-sign-up-person-register-url-value="<%= manage_register_signups_form_path(@production, @sign_up_form) %>"
     data-add-sign-up-person-register-queue-url-value="<%= manage_register_to_queue_signups_form_path(@production, @sign_up_form) %>">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: flash[:alert] } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Sign-ups", manage_signups_path],
      [@production.name, manage_signups_production_path(@production)],
      ["Forms", manage_signups_forms_path(@production)],
      [@sign_up_form.name, manage_signups_form_path(@production, @sign_up_form)]
    ],
    text: "Assign Slots",
    links: []
  } %>

  <div class="mb-6">
    <p class="text-gray-600">Assign people from the queue to slots</p>
  </div>

  <% if @sign_up_form.repeated? %>
    <%# Instance selector for repeated forms %>
    <div class="mb-6">
      <label class="block text-sm font-medium text-gray-700 mb-2">Select Event</label>
      <div class="flex flex-wrap gap-2">
        <% @sign_up_form.sign_up_form_instances.joins(:show).where("shows.date_and_time > ?", 1.week.ago).order("shows.date_and_time ASC, sign_up_form_instances.id ASC").limit(10).each do |inst| %>
          <% is_current = @instance&.id == inst.id %>
          <%= link_to manage_assign_signups_form_path(@production, @sign_up_form, instance_id: inst.id),
              class: "px-3 py-2 rounded-lg border text-sm #{is_current ? 'bg-pink-500 text-white border-pink-500' : 'bg-white text-gray-700 border-gray-300 hover:border-pink-400'}" do %>
            <%= inst.show.date_and_time.strftime("%b %-d") %>
            <span class="text-xs opacity-75">(<%= inst.queue_count %> queued)</span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @instance.nil? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 text-center">
      <p class="text-yellow-800">No instance found. Create an event first.</p>
    </div>
  <% else %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <%# Left panel: Slots/Assigned - matches _registration_list.html.erb style %>
      <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
        <%= render "shared/section_heading", padding: "px-5 py-4", title: is_open_list ? "Assigned" : "Slots" do %>
          <span class="text-sm text-gray-500"><%= @assigned.count %> assigned</span>
        <% end %>

        <% if is_open_list %>
          <%# Open list mode: flat list matching _registration_list style %>
          <% if @assigned.empty? %>
            <div class="p-8 text-center">
              <p class="text-sm text-gray-400 italic">No one assigned yet</p>
            </div>
          <% else %>
            <div class="divide-y divide-gray-100">
              <% @assigned.each do |reg| %>
                <div class="flex items-center justify-between group px-4 py-2 hover:bg-gray-50">
                  <div class="flex items-center gap-3">
                    <% headshot = reg.person&.safe_headshot_variant(:thumb) %>
                    <% if headshot %>
                      <%= image_tag headshot, class: "w-7 h-7 rounded-lg object-cover" %>
                    <% else %>
                      <div class="w-7 h-7 rounded-lg bg-gray-200 flex items-center justify-center text-gray-500 text-xs font-medium">
                        <%= reg.display_name.first.upcase %>
                      </div>
                    <% end %>
                    <% if reg.person.present? %>
                      <%= link_to reg.display_name, manage_person_path(reg.person), class: "text-sm text-gray-900 hover:text-pink-600 hover:underline" %>
                    <% else %>
                      <span class="text-sm text-gray-900"><%= reg.display_name %></span>
                    <% end %>
                  </div>
                  <% return_queue_cid = "confirm-return-queue-multi-#{slot.id}-#{reg.id}" %>
                  <div class="pointer-fine:opacity-0 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-within:opacity-100 transition-opacity">
                    <%= render "shared/button",
                        text: "Return to Queue",
                        variant: "ghost",
                        size: "small",
                        type: :button,
                        data: { controller: "modal", action: "click->modal#open", modal_id: return_queue_cid } %>
                  </div>
                  <%= render "shared/confirm_modal", id: return_queue_cid, title: "Return to queue?",
                        message: "Return #{reg.display_name} to queue?", confirm_text: "Return to Queue",
                        url: manage_unassign_registration_signups_form_path(@production, @sign_up_form, registration_id: reg.id, instance_id: @instance.id), method: :patch %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <%# Slot-based mode: matches _registration_list.html.erb structure %>
          <%
            label_width_class = case @sign_up_form.slot_generation_mode
              when 'time_based' then 'w-28'
              when 'named' then 'w-32'
              else 'w-16'
            end
          %>
          <div class="divide-y divide-gray-100" data-assign-drag-target="slotList">
            <% @slots.each do |slot| %>
              <% slot_registrations = slot.sign_up_registrations.active.order(:position).to_a %>

              <% if slot.is_held %>
                <%# Held slot - grayed out %>
                <div class="px-4 py-3 bg-gray-100 text-center">
                  <span class="text-gray-500 text-sm"><%= slot.held_reason.presence || "Unavailable" %></span>
                </div>
              <% elsif slot.capacity > 1 && show_slot_label %>
                <%# Multi-capacity slot: show label on left, individual rows on right %>
                <div class="flex">
                  <div class="flex-shrink-0 <%= label_width_class %> flex items-center border-r border-gray-100 bg-gray-50 px-3">
                    <span class="text-sm font-medium <%= slot_registrations.any? ? 'text-gray-500' : 'text-gray-400' %>"><%= slot.name.presence || slot.position %></span>
                  </div>
                  <div class="flex-1 divide-y divide-gray-50"
                       data-assign-drag-target="dropZone"
                       data-slot-id="<%= slot.id %>"
                       data-slot-capacity="<%= slot.capacity %>"
                       data-slot-count="<%= slot_registrations.size %>">
                    <% slot_registrations.each do |reg| %>
                      <div class="flex items-center justify-between group px-4 py-2 hover:bg-gray-50"
                           draggable="<%= supports_drag %>"
                           data-assign-drag-target="draggable"
                           data-registration-id="<%= reg.id %>"
                           data-current-slot-id="<%= slot.id %>">
                        <div class="flex items-center gap-3">
                          <% if supports_drag %>
                            <svg class="w-4 h-4 text-gray-400 cursor-grab" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/>
                            </svg>
                          <% end %>
                          <% headshot = reg.person&.safe_headshot_variant(:thumb) %>
                          <% if headshot %>
                            <%= image_tag headshot, class: "w-7 h-7 rounded-lg object-cover" %>
                          <% else %>
                            <div class="w-7 h-7 rounded-lg bg-gray-200 flex items-center justify-center text-gray-500 text-xs font-medium">
                              <%= reg.display_name.first.upcase %>
                            </div>
                          <% end %>
                          <% if reg.person.present? %>
                            <%= link_to reg.display_name, manage_person_path(reg.person), class: "text-sm text-gray-900 hover:text-pink-600 hover:underline" %>
                          <% else %>
                            <span class="text-sm text-gray-900"><%= reg.display_name %></span>
                          <% end %>
                        </div>
                        <% return_queue_cid2 = "confirm-return-queue-multi2-#{slot.id}-#{reg.id}" %>
                        <div class="pointer-fine:opacity-0 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-within:opacity-100 transition-opacity flex items-center gap-1">
                          <%= render "shared/button",
                              text: "Move",
                              variant: "ghost",
                              size: "small",
                              type: :button,
                              data: { action: "click->assign-drag#openPicker", registration_id: reg.id, current_slot_id: slot.id, name: reg.display_name } %>
                          <%= render "shared/button",
                              text: "Return to Queue",
                              variant: "ghost",
                              size: "small",
                              type: :button,
                              data: { controller: "modal", action: "click->modal#open", modal_id: return_queue_cid2 } %>
                        </div>
                        <%= render "shared/confirm_modal", id: return_queue_cid2, title: "Return to queue?",
                              message: "Return #{reg.display_name} to queue?", confirm_text: "Return to Queue",
                              url: manage_unassign_registration_signups_form_path(@production, @sign_up_form, registration_id: reg.id, instance_id: @instance.id), method: :patch %>
                      </div>
                    <% end %>
                    <% available_count = [slot.capacity - slot_registrations.size, 0].max %>
                    <% available_count.times do %>
                      <div class="px-4 py-2 min-h-[40px]" data-assign-drag-target="emptySlot" data-slot-id="<%= slot.id %>">
                        <span class="text-sm text-gray-400 italic">Available</span>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% elsif slot_registrations.any? %>
                <%# Single-capacity slot with registrations %>
                <div class="flex"
                     data-assign-drag-target="dropZone"
                     data-slot-id="<%= slot.id %>"
                     data-slot-capacity="<%= slot.capacity %>"
                     data-slot-count="<%= slot_registrations.size %>">
                  <% if show_slot_label %>
                    <div class="flex-shrink-0 <%= label_width_class %> flex items-center border-r border-gray-100 bg-gray-50 px-3 py-2">
                      <span class="text-sm font-medium text-gray-500"><%= slot.name.presence || slot.position %></span>
                    </div>
                  <% end %>
                  <div class="flex-1 divide-y divide-gray-50">
                    <% slot_registrations.each do |reg| %>
                      <div class="flex items-center justify-between group px-4 py-2 hover:bg-gray-50"
                           draggable="<%= supports_drag %>"
                           data-assign-drag-target="draggable"
                           data-registration-id="<%= reg.id %>"
                           data-current-slot-id="<%= slot.id %>">
                        <div class="flex items-center gap-3">
                          <% if supports_drag %>
                            <svg class="w-4 h-4 text-gray-400 cursor-grab" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/>
                            </svg>
                          <% end %>
                          <% headshot = reg.person&.safe_headshot_variant(:thumb) %>
                          <% if headshot %>
                            <%= image_tag headshot, class: "w-7 h-7 rounded-lg object-cover" %>
                          <% else %>
                            <div class="w-7 h-7 rounded-lg bg-gray-200 flex items-center justify-center text-gray-500 text-xs font-medium">
                              <%= reg.display_name.first.upcase %>
                            </div>
                          <% end %>
                          <% if reg.person.present? %>
                            <%= link_to reg.display_name, manage_person_path(reg.person), class: "text-sm text-gray-900 hover:text-pink-600 hover:underline" %>
                          <% else %>
                            <span class="text-sm text-gray-900"><%= reg.display_name %></span>
                          <% end %>
                        </div>
                        <% return_queue_cid3 = "confirm-return-queue-single-#{slot.id}-#{reg.id}" %>
                        <div class="pointer-fine:opacity-0 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-within:opacity-100 transition-opacity flex items-center gap-1">
                          <%= render "shared/button",
                              text: "Move",
                              variant: "ghost",
                              size: "small",
                              type: :button,
                              data: { action: "click->assign-drag#openPicker", registration_id: reg.id, current_slot_id: slot.id, name: reg.display_name } %>
                          <%= render "shared/button",
                              text: "Return to Queue",
                              variant: "ghost",
                              size: "small",
                              type: :button,
                              data: { controller: "modal", action: "click->modal#open", modal_id: return_queue_cid3 } %>
                        </div>
                        <%= render "shared/confirm_modal", id: return_queue_cid3, title: "Return to queue?",
                              message: "Return #{reg.display_name} to queue?", confirm_text: "Return to Queue",
                              url: manage_unassign_registration_signups_form_path(@production, @sign_up_form, registration_id: reg.id, instance_id: @instance.id), method: :patch %>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% else %>
                <%# Empty slot %>
                <div class="flex"
                     data-assign-drag-target="dropZone"
                     data-slot-id="<%= slot.id %>"
                     data-slot-capacity="<%= slot.capacity %>"
                     data-slot-count="0">
                  <% if show_slot_label %>
                    <div class="flex-shrink-0 <%= label_width_class %> flex items-center border-r border-gray-100 bg-gray-50 px-3 py-2">
                      <span class="text-sm font-medium text-gray-400"><%= slot.name.presence || slot.position %></span>
                    </div>
                  <% end %>
                  <div class="flex-1 px-4 py-2 min-h-[40px]" data-assign-drag-target="emptySlot" data-slot-id="<%= slot.id %>">
                    <span class="text-sm text-gray-400 italic">Available</span>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# Right panel: Queue. First on a phone (V1.1 plan §4): tap someone in
          the queue, then pick their slot. %>
      <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden order-first lg:order-none" data-assign-queue-panel>
        <%= render "shared/section_heading", padding: "px-5 py-4", title: "Queue", intro: "#{@queue.count} waiting" do %>
          <%= render "shared/button", text: "Add", variant: "secondary", size: "small", icon: "plus", type: :button,
                data: { action: "click->add-sign-up-person#openQueue", instance_id: @instance&.id } %>
          <%= render "shared/button",
              text: "Auto-assign All",
              variant: "primary",
              size: "small",
              path: manage_auto_assign_queue_signups_form_path(@production, @sign_up_form, instance_id: @instance&.id),
              method: :post,
              disabled: @queue.empty?,
              data: { turbo_method: :post } %>
        <% end %>

        <% if @queue.empty? %>
          <div class="p-8 text-center">
            <p class="text-gray-500">No one in the queue</p>
          </div>
        <% else %>
          <div class="divide-y divide-gray-100" data-assign-drag-target="queueList">
            <% @queue.each do |registration| %>
              <div class="flex flex-wrap items-center justify-between group px-4 py-2 hover:bg-gray-50"
                   draggable="<%= supports_drag %>"
                   data-assign-drag-target="queueItem"
                   data-registration-id="<%= registration.id %>">
                <div class="flex items-start gap-3">
                  <% if supports_drag %>
                    <svg class="w-4 h-4 mt-1.5 text-gray-400 cursor-grab" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/>
                    </svg>
                  <% end %>
                  <% headshot = registration.person&.safe_headshot_variant(:thumb) %>
                  <% if headshot %>
                    <%= image_tag headshot, class: "w-7 h-7 rounded-lg object-cover" %>
                  <% else %>
                    <div class="w-7 h-7 rounded-lg bg-gray-200 flex items-center justify-center text-gray-500 text-xs font-medium">
                      <%= registration.display_name.first.upcase %>
                    </div>
                  <% end %>
                  <div class="min-w-0">
                    <% if registration.person.present? %>
                      <%= link_to registration.display_name, manage_person_path(registration.person), class: "text-sm leading-7 text-gray-900 hover:text-pink-600 hover:underline" %>
                    <% else %>
                      <span class="text-sm leading-7 text-gray-900"><%= registration.display_name %></span>
                    <% end %>
                    <% if registration.guest? %>
                      <span class="text-xs text-gray-500 ml-1">(Guest)</span>
                    <% end %>
                    <%= render "manage/sign_up_forms/registration_answers", registration: registration %>
                  </div>
                </div>
                <% remove_queue_cid = "confirm-remove-queue-#{registration.id}" %>
                <div class="pointer-fine:opacity-0 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-within:opacity-100 transition-opacity flex items-center gap-1 max-sm:basis-full max-sm:justify-end max-sm:pt-1">
                  <% if supports_drag %>
                    <%= render "shared/button",
                        text: "Pick a slot",
                        variant: "secondary",
                        size: "small",
                        type: :button,
                        data: { action: "click->assign-drag#openPicker", registration_id: registration.id, name: registration.display_name } %>
                  <% end %>
                  <%= render "shared/button",
                      text: "Auto-assign",
                      variant: "primary",
                      size: "small",
                      path: manage_auto_assign_one_signups_form_path(@production, @sign_up_form, registration_id: registration.id, instance_id: @instance.id),
                      method: :post,
                      data: { turbo_method: :post } %>
                  <%= render "shared/button",
                      text: "Remove",
                      variant: "ghost",
                      size: "small",
                      type: :button,
                      data: { controller: "modal", action: "click->modal#open", modal_id: remove_queue_cid } %>
                </div>
                <%= render "shared/confirm_modal", id: remove_queue_cid, title: "Remove from queue?",
                      message: "Remove #{registration.display_name} from the queue?", confirm_text: "Remove",
                      url: manage_cancel_registration_signups_form_path(@production, @sign_up_form, registration_id: registration.id), method: :delete %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @instance && @queue.any? %>
    <%# Phone: Auto-assign all pinned to the bottom (V1.1 plan §4), clear of
        the Coco button in the app. %>
    <div class="lg:hidden h-24" aria-hidden="true"></div>
    <div class="lg:hidden fixed inset-x-0 bottom-0 z-30 bg-white/95 backdrop-blur border-t border-gray-200 pl-4 <%= turbo_native_app? ? 'pr-[96px]' : 'pr-4' %> pt-3 pb-[calc(env(safe-area-inset-bottom)+12px)] flex items-center gap-3" data-assign-phone-bar>
      <span class="text-sm text-gray-600 flex-1 min-w-0 truncate"><%= pluralize(@queue.count, "person") %> waiting</span>
      <%= render "shared/button",
          text: "Auto-assign All",
          variant: "primary",
          size: "medium",
          path: manage_auto_assign_queue_signups_form_path(@production, @sign_up_form, instance_id: @instance.id),
          method: :post,
          data: { turbo_method: :post } %>
    </div>
  <% end %>

  <% if @instance && supports_drag %>
    <%# The slot picker (V1.1 plan §5, Slot Picker sheet): tap someone, then
        the slot. Full slots and the one they're already in are hidden by JS. %>
    <%= render layout: "shared/sheet", locals: { id: "slot-picker", title: "Pick a slot" } do %>
      <p class="text-sm text-gray-600 mb-3" data-assign-drag-target="pickerName"></p>
      <div class="rounded-lg border border-gray-200 divide-y divide-gray-100 overflow-hidden" data-slot-picker-list>
        <% @slots.each do |slot| %>
          <% taken = slot.sign_up_registrations.active.size %>
          <% free = slot.is_held ? 0 : [ slot.capacity - taken, 0 ].max %>
          <button type="button"
                  data-assign-drag-target="pickSlot" data-slot-id="<%= slot.id %>" data-free="<%= free %>"
                  data-action="click->assign-drag#pickSlot"
                  class="w-full flex items-center justify-between gap-3 px-4 min-h-[52px] text-left cursor-pointer hover:bg-pink-50 <%= 'hidden' if free.zero? %>">
            <span class="text-sm font-medium text-gray-900"><%= slot.display_name %></span>
            <span class="text-xs text-gray-500"><%= slot.capacity > 1 ? "#{free} of #{slot.capacity} free" : "free" %></span>
          </button>
        <% end %>
        <p class="hidden px-4 py-4 text-sm text-gray-500 text-center" data-assign-drag-target="pickerEmpty">Every slot is full.</p>
      </div>
    <% end %>
  <% end %>

  <%# Add person: the shared People Picker (V1.1 plan §5). %>
  <%= render "shared/people_picker", id: "sign-up-picker", title: "Add to Queue", scope: "people",
        production_id: @production.id, hint: "Someone in your organization",
        pick_action: "people-picker:pick->add-sign-up-person#picked" %>
</div>
