<% content_for :title, "#{ticket_listing_date_label(@listing)} · Ticketing settings" %>
<%
  setup = @listing.production_ticketing
  banner = if setup
    safe_join([
      tag.strong("Settings for #{ticket_listing_date_label(@listing)} only."), " ",
      "Anything you leave as it is uses #{possessive(@listing.production.name)} ticketing. ",
      link_to("Change them for every date", manage_edit_production_ticketing_path(@listing.production), class: "font-medium underline hover:text-pink-700")
    ])
  else
    safe_join([ tag.strong("Settings for #{ticket_listing_date_label(@listing)} only."), " ",
                "#{@listing.production.name} doesn't have ticketing set up for all its dates, so this date has its own." ])
  end
%>

<%= render layout: "shared/settings_layout", locals: {
  title: "Settings",
  breadcrumbs: ticket_listing_breadcrumbs(@listing),
  sections: settings_sections,
  current: @section,
  banner: banner,
  width: "max-w-3xl"
} do %>
  <% case @section %>
  <% when "sales" %>
    <%= render "manage/ticket_listings/settings/sales", listing: @listing, setup: setup %>
  <% when "page" %>
    <%= render "manage/ticket_listings/settings/page", listing: @listing, setup: setup %>
  <% when "codes" %>
    <%= render "manage/ticket_listings/settings/codes", listing: @listing, setup: setup %>
  <% else %>
    <%= render "manage/ticket_listings/settings/tickets", listing: @listing, setup: setup %>
  <% end %>
<% end %>
