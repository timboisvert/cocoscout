<%# One invoice as a page: the same InvoiceDocument its PDF (InvoicePdf) draws,
    so the two always agree. locals: document %>
<%
  doc = document
  badge = {
    paid: "bg-green-100 text-green-800", void: "bg-gray-100 text-gray-600", overdue: "bg-red-100 text-red-700",
    due: "bg-amber-100 text-amber-800", collecting: "bg-blue-100 text-blue-800", failed: "bg-red-100 text-red-700"
  }[doc.status]
  badge_text = { paid: "Paid", void: "Void", overdue: "Overdue", due: "Due", collecting: "Being collected", failed: "Payment failed" }[doc.status]
  logo = doc.logo
  logo_src =
    if logo.is_a?(String) || logo.is_a?(Pathname) then "cocoscoutsmall.png"
    elsif logo.respond_to?(:attached?) && logo.attached? then logo.variant(resize_to_limit: [ 320, 120 ])
    end
%>
<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
  <div class="p-6 sm:p-8">
    <div class="flex flex-col-reverse sm:flex-row sm:items-start sm:justify-between gap-6">
      <div class="min-w-0">
        <% if logo_src %>
          <%= image_tag logo_src, alt: doc.seller.name, class: "h-12 w-auto max-w-[10rem] object-contain mb-3" %>
        <% end %>
        <div class="text-base font-semibold text-gray-900"><%= doc.seller.name %></div>
        <% [ *doc.seller.lines, doc.seller.email, doc.seller.phone ].compact_blank.each do |line| %>
          <div class="text-sm text-gray-500"><%= line %></div>
        <% end %>
      </div>
      <div class="sm:text-right flex-shrink-0">
        <div class="text-2xl font-bold tracking-wide text-gray-900 uppercase"><%= doc.title %></div>
        <div class="text-sm font-medium text-gray-700 tabular-nums"><%= doc.number %></div>
        <% if doc.issued_on %><div class="text-xs text-gray-500 mt-1">Issued <%= doc.issued_on.strftime("%B %-d, %Y") %></div><% end %>
        <% if doc.due_on %><div class="text-xs text-gray-500">Due <%= doc.due_on.strftime("%B %-d, %Y") %></div><% end %>
        <span class="inline-flex mt-2 rounded-md px-2 py-0.5 text-xs font-semibold <%= badge %>"><%= badge_text %></span>
      </div>
    </div>

    <div class="mt-6 pt-6 border-t border-gray-100 grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm">
      <div>
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Bill to</div>
        <div class="font-medium text-gray-900"><%= doc.bill_to.name %></div>
        <% [ *doc.bill_to.lines, doc.bill_to.email, doc.bill_to.phone ].compact_blank.each do |line| %>
          <div class="text-gray-500"><%= line %></div>
        <% end %>
      </div>
      <% if doc.reference.any? %>
        <div>
          <div class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">For</div>
          <% doc.reference.each do |label, value| %>
            <div class="text-gray-700"><span class="text-gray-500"><%= label %>:</span> <%= value %></div>
          <% end %>
        </div>
      <% end %>
    </div>

    <table class="mt-6 w-full text-sm">
      <thead>
        <tr class="border-b border-gray-200 text-xs font-semibold text-gray-400 uppercase tracking-wide">
          <th class="py-2 text-left font-semibold">Description</th>
          <th class="py-2 text-right font-semibold">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% doc.items.each do |item| %>
          <tr class="border-b border-gray-100 align-top">
            <td class="py-2.5 pr-4 text-gray-900">
              <%= item.description %>
              <% if item.detail %><div class="text-xs text-gray-500"><%= item.detail %></div><% end %>
            </td>
            <td class="py-2.5 text-right tabular-nums text-gray-900 whitespace-nowrap"><%= number_to_currency(item.amount_cents / 100.0) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td class="pt-3 font-semibold text-gray-900">Total</td>
          <td class="pt-3 text-right font-bold text-gray-900 tabular-nums text-base whitespace-nowrap"><%= number_to_currency(doc.total_cents / 100.0) %></td>
        </tr>
      </tfoot>
    </table>

    <% if doc.status_line.present? %>
      <p class="mt-4 text-sm font-semibold <%= doc.paid? ? 'text-green-700' : 'text-gray-800' %>"><%= doc.status_line %></p>
    <% end %>
    <% doc.notes.each do |note| %>
      <p class="mt-2 text-sm text-gray-600"><%= note %></p>
    <% end %>
    <% doc.sections.each do |title, lines| %>
      <div class="mt-5">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1"><%= title %></div>
        <p class="text-sm text-gray-700"><%= lines.join(", ") %></p>
      </div>
    <% end %>
  </div>
  <% if doc.footer.present? %>
    <div class="px-6 sm:px-8 py-3 bg-gray-50 border-t border-gray-100 text-xs text-gray-400"><%= doc.footer %></div>
  <% end %>
</div>
