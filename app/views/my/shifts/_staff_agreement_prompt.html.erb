<%# Sign-to-continue prompt for staff who owe a signature on their org's required
    staff agreement (retroactive enforcement). `memberships` = OrganizationStaffMembers
    where needs_to_sign_agreement?. Pink banner + one agree-modal per org; the first
    modal auto-opens on load (soft enforcement — the account isn't hard-locked). %>
<% return if memberships.blank? %>

<div class="border border-pink-200 rounded-lg overflow-hidden mb-6 bg-pink-50">
  <div class="bg-pink-100 px-4 py-3 border-b border-pink-200 flex items-center gap-2">
    <%= icon("file-text", class: "w-5 h-5 text-pink-600") %>
    <h3 class="text-base coustard-regular text-gray-900">
      Sign your staff <%= "agreement".pluralize(memberships.size) %> to keep working
    </h3>
  </div>
  <div class="divide-y divide-pink-100">
    <% memberships.each do |member| %>
      <% org = member.organization %>
      <% template = member.required_agreement_template %>
      <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
        <div class="min-w-0">
          <div class="font-medium text-gray-900 truncate"><%= org.name %></div>
          <div class="text-sm text-gray-600">
            <%= org.name %> requires all staff to sign
            <span class="font-medium text-gray-900"><%= template.name %></span> before working.
          </div>
        </div>
        <%= render "shared/button", text: "Review & sign", variant: "primary", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: "sign-agreement-#{member.id}" } %>
      </div>
    <% end %>
  </div>
</div>

<%# One agree-modal per org needing a signature — opened only when the staffer
    clicks "Review & sign" on the banner above (no forced pop-up). %>
<% memberships.each do |member| %>
  <% template = member.required_agreement_template %>
  <div id="sign-agreement-<%= member.id %>"
       class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
       data-controller="modal"
       data-action="click->modal#closeOnBackdrop">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl mx-4 max-h-[85vh] flex flex-col overflow-hidden"
         data-action="click->modal#stopPropagation">
      <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4 flex-shrink-0">
        <h3 class="text-lg font-semibold text-white truncate"><%= template.name %></h3>
        <button type="button" data-action="click->modal#close"
                class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="px-6 py-5 overflow-y-auto prose prose-sm max-w-none [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:my-1">
        <%= member.rendered_agreement_html(template) %>
      </div>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-between gap-2 flex-shrink-0">
        <p class="text-xs text-gray-500 min-w-0">By signing you agree to the terms above for <%= member.organization.name %>.</p>
        <div class="flex items-center gap-2 flex-shrink-0">
          <%= render "shared/button", text: "Not now", variant: "secondary", size: "medium", type: :button,
                data: { action: "click->modal#close" } %>
          <%= render "shared/button", text: "I agree", variant: "primary", size: "medium",
                path: my_sign_staff_agreement_path(member.organization_id), method: :post %>
        </div>
      </div>
    </div>
  </div>
<% end %>
