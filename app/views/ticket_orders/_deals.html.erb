<%# Deals on another show still open to this buyer after paying
    (TicketCheckout.deals_after): pick how many and go to checkout. Locals:
    order, deals ([[offer, listing, tier]]). %>
<div id="deals" class="mt-6 rounded-xl border border-pink-200 bg-pink-50 p-5">
  <div class="text-sm font-semibold text-gray-900">Make it a night</div>
  <p class="text-xs text-gray-600 mt-0.5">Add another show for less, for a few days after your order.</p>
  <% if flash[:alert] %><p class="mt-2 text-sm text-red-700"><%= flash[:alert] %></p><% end %>
  <ul class="mt-3 space-y-3">
    <% deals.each do |offer, listing, tier| %>
      <%
        deal = offer.deal_price_cents(tier)
        tax = TaxCalculator.for_ticket(listing, tier, deal).added_cents
        deal_all_in = TicketPricing.quote(items: [ { price_cents: deal, discount_cents: 0, tax_cents: tax } ], fee_mode: listing.effective_fee_mode).total_cents
        normal_all_in = TicketPricing.all_in_price_cents(listing, tier)
        room = TicketCheckout.deal_room(order, offer)
        left = listing.inventory.remaining(tier: tier)
        most = left.nil? ? room : [ room, left ].min
      %>
      <% next unless most.positive? %>
      <li class="rounded-lg bg-white border border-gray-200 px-4 py-3">
        <%= form_with url: tickets_order_add_deal_path(token: order.token, offer: offer.id, **embed_params), method: :post, data: { turbo: false },
              class: "flex flex-wrap items-center justify-between gap-3" do %>
          <div class="min-w-0">
            <div class="font-medium text-gray-900"><%= listing.display_title %></div>
            <div class="text-sm text-gray-600"><%= listing.show.date_and_time.strftime("%a, %b %-d · %-l:%M %p") %> · <%= tier.name %></div>
            <div class="text-sm">
              <span class="font-semibold text-gray-900"><%= number_to_currency(deal_all_in / 100.0) %> each</span>
              <% if normal_all_in > deal_all_in %><span class="text-gray-500"> · normally <%= number_to_currency(normal_all_in / 100.0) %></span><% end %>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <%= select_tag :quantity, options_for_select((1..most).to_a, most), "aria-label": "How many",
                  class: "px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
            <%= render "shared/button", text: "Add to my night", variant: "primary", size: "small", type: :submit %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
