<%# What someone said about the vacancy's date, beside their name (V1.1 plan §4). Local: status. %>
<% if status == "available" %>
  <span class="ml-1 inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">Available</span>
<% elsif status == "unavailable" %>
  <span class="ml-1 inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Unavailable</span>
<% end %>
