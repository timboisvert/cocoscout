<%# Organization settings → Services (after-V1 #6): what the organization
    offers productions, the roles that do each, and its default price. Our own
    productions pick from this list, Contract Settings chooses which contracts
    offer, and Role Call checks the ones someone on staff does. Pro; the
    section isn't in the strip without it. %>
<%
  input = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-base sm:text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  check = "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500"
  unit_options = [ [ "Flat", "flat" ], [ "Per hour", "hourly" ] ]
  contracts_path = manage_contract_settings_section_path(section: "services")
%>
<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
  <%= render "shared/section_heading", title: "Services",
        intro: "What your organization offers productions, which roles do each, and its default price. Your own productions pick from this list, and contracts charge the default price unless Contract Settings sets another." %>

  <% if @house_services.any? %>
    <div class="hidden sm:grid grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_8rem_minmax(0,1fr)_5rem] gap-4 px-6 pt-3 pb-2 text-xs font-medium text-gray-500">
      <span>Service</span><span>Roles that do it</span><span>Default price</span><span>On contracts</span><span></span>
    </div>
    <div class="divide-y divide-gray-100 border-t border-gray-100 sm:border-t-0">
      <% @house_services.each do |service| %>
        <% remove_cid = "confirm-remove-house-service-#{service.id}" %>
        <div data-controller="disclosure">
          <div class="px-4 sm:px-6 py-3 flex flex-col gap-2 sm:grid sm:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_8rem_minmax(0,1fr)_5rem] sm:gap-4 sm:items-center">
            <div class="flex items-center justify-between gap-3">
              <span class="text-[15px] font-medium text-gray-900"><%= service.name %></span>
              <span class="sm:hidden">
                <%= render "shared/button", text: "Edit", variant: "secondary", size: "small", type: :button, data: { action: "click->disclosure#toggle" } %>
              </span>
            </div>
            <div class="flex flex-wrap gap-1.5">
              <% if service.house_roles.any? %>
                <% service.house_roles.sort_by(&:name).each do |role| %>
                  <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-sm font-medium text-gray-900"><%= role.name %></span>
                <% end %>
              <% else %>
                <span class="inline-flex items-center rounded-full border border-dashed border-gray-300 px-2.5 py-0.5 text-sm text-gray-500">No one: equipment or a fee</span>
              <% end %>
            </div>
            <span class="text-sm text-gray-900 tabular-nums"><%= service.price_label %></span>
            <span class="text-sm text-gray-500">
              <% if !service.offered_on_contracts? %>
                Not offered
              <% elsif service.contract_price_cents && service.contract_price_cents != service.default_price_cents %>
                Offered at <%= service.price_label(service.contract_price_cents) %>
              <% else %>
                Offered
              <% end %>
            </span>
            <span class="hidden sm:flex justify-end">
              <%= render "shared/button", text: "Edit", variant: "secondary", size: "small", type: :button, data: { action: "click->disclosure#toggle" } %>
            </span>
          </div>

          <div class="hidden px-4 sm:px-6 pb-4" data-disclosure-target="content">
            <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 space-y-4">
              <%= form_with url: manage_house_service_path(service), method: :patch, class: "space-y-4", id: "house-service-#{service.id}" do %>
                <%= render "manage/organizations/sections/house_service_fields", service: service, input: input, check: check, unit_options: unit_options %>
              <% end %>
              <div class="flex flex-wrap items-center justify-between gap-3">
                <%= render "shared/button", text: "Remove", variant: "secondary", size: "small", type: :button,
                      data: { controller: "modal", action: "click->modal#open", modal_id: remove_cid } %>
                <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit, form_id: "house-service-#{service.id}" %>
              </div>
            </div>
          </div>
        </div>
        <%= render "shared/confirm_modal", id: remove_cid,
              title: "Remove #{service.name}?",
              message: "Productions and shows that need it stop needing it. Contracts already written keep their own line for it.",
              confirm_text: "Remove",
              url: manage_house_service_path(service), method: :delete %>
      <% end %>
    </div>
  <% else %>
    <p class="px-6 py-6 text-sm text-gray-500 border-t border-gray-100">No services yet. Add the first one below: a booth tech, ticket taking, a projector.</p>
  <% end %>

  <div class="px-4 sm:px-6 py-5 bg-gray-50 border-t border-gray-200">
    <h3 class="text-sm font-semibold text-gray-900 mb-3">Add a service</h3>
    <%= form_with url: manage_house_services_path, method: :post, class: "space-y-4" do %>
      <%= render "manage/organizations/sections/house_service_fields", service: HouseService.new(unit: "flat"), input: input, check: check, unit_options: unit_options %>
      <div class="flex justify-end">
        <%= render "shared/button", text: "Add service", variant: "primary", size: "small", type: :submit %>
      </div>
    <% end %>
  </div>

  <div class="px-4 sm:px-6 py-4 border-t border-gray-200 text-sm text-gray-500 space-y-1">
    <p>
      A role can do several services, or none: bartenders are scheduled but aren't a service you offer.
      Roles are on Staffing's <%= link_to "Roles page", manage_staffing_house_roles_path, class: "font-medium text-pink-600 hover:text-pink-700" %>.
    </p>
    <p><%= link_to "Choose which are offered on contracts", contracts_path, class: "font-medium text-pink-600 hover:text-pink-700" %></p>
  </div>
</div>
