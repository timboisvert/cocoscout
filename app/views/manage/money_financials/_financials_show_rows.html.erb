<%#
  Slim rows for what still needs its financials: shows that have started with
  no confirmed numbers (each opens its financials worksheet), and course runs
  still to settle (each opens the course's own financials page, never a show
  worksheet). Built by MoneyTodoService.financials_section.

  Locals: rows — [{ title:, subtitle:, badge:, href: }, ...]
%>
<% rows.each do |row| %>
  <%= render "shared/slim_list_row",
        title: row[:title],
        subtitle: row[:subtitle],
        badge: row[:badge],
        href: row[:href] %>
<% end %>
