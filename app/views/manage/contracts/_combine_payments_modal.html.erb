<%#
  Combine payments modal — fold other pending payments this contract's payer
  owes into the host payment: one amount, one pay link, one row on their side,
  due on the host's date. Reversible from the row's menu (Split).

  Locals:
    id          unique DOM id, matches the trigger's data-modal-id
    payment     the host ContractPayment (absorbs the others)
    contract    the contract
    candidates  other combinable ContractPayments offered as checkboxes
%>
<div id="<%= id %>"
     class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
     data-controller="modal"
     data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden"
       data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white">Combine payments</h3>
      <button type="button"
              data-action="click->modal#close"
              class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <%= form_with url: combine_manage_contract_contract_payment_path(contract, payment), method: :post do %>
      <div class="px-6 py-5">
        <p class="text-sm text-gray-600">
          Fold other payments <%= contract.contractor_name %> owes into this one —
          one combined amount, one pay link, due
          <span class="font-medium text-gray-900"><%= payment.due_date.strftime("%b %-d, %Y") %></span>.
        </p>

        <div class="mt-4 bg-gray-50 rounded-lg px-4 py-3 flex items-baseline justify-between">
          <div class="text-sm text-gray-700 truncate pr-3">
            <span class="font-medium">This payment</span>
            &middot; <%= payment.description.presence || "Payment" %>
          </div>
          <div class="text-sm font-semibold text-gray-900 tabular-nums flex-shrink-0"><%= number_to_currency(payment.amount) %></div>
        </div>

        <div class="mt-3 space-y-1.5 max-h-64 overflow-y-auto">
          <% candidates.each do |candidate| %>
            <label class="flex items-center gap-3 px-4 py-2.5 border border-gray-200 rounded-lg cursor-pointer hover:border-pink-300 transition-colors">
              <%= check_box_tag "payment_ids[]", candidate.id, false,
                    id: "#{id}-candidate-#{candidate.id}",
                    class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
              <span class="flex-1 min-w-0 text-sm text-gray-700">
                <span class="block truncate"><%= candidate.description.presence || "Payment" %></span>
                <span class="block text-xs text-gray-400">due <%= candidate.due_date.strftime("%b %-d, %Y") %></span>
              </span>
              <span class="text-sm font-semibold text-gray-900 tabular-nums flex-shrink-0"><%= number_to_currency(candidate.amount) %></span>
            </label>
          <% end %>
        </div>

        <p class="mt-3 text-xs text-gray-500">
          The folded-in payments disappear as separate rows — for them too — and any
          pay links already shared for them stop working. You can split them back
          out later from this payment's menu.
        </p>
      </div>

      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
        <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button,
              data: { action: "click->modal#close" } %>
        <%= render "shared/button", text: "Combine", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
  </div>
</div>
