<%# The usual week, beside the calendar: all seven days, each with its
    answer. A day opens the week sheet on that day, filled in; ticking more
    days there gives them the same answer ("never on Sundays"). Local: picture. %>
<section class="rounded-lg border border-gray-200 bg-white overflow-hidden">
  <div class="px-4 py-3 border-b border-gray-200 bg-gray-50">
    <h2 class="text-sm font-semibold text-gray-900">My usual week</h2>
    <p class="text-xs text-gray-500 mt-0.5">
      <% if picture.week_said? %>
        Every week starts out like this. Tap a day to change it; changing a date on the calendar doesn't touch it.
      <% else %>
        Not set yet, so you're counted as free any time. Tap a day to set the hours you usually work, or that you never do.
      <% end %>
    </p>
  </div>

  <ul class="divide-y divide-gray-100">
    <% picture.week.each do |day| %>
      <% answer = day.answer %>
      <li>
        <div role="button" tabindex="0"
             class="flex items-center gap-3 px-4 py-2 cursor-pointer hover:bg-pink-50 focus:bg-pink-50 focus:outline-none transition-colors"
             data-action="click->work-availability#editWeek keydown.enter->work-availability#editWeek"
             data-wdays="<%= [ day.wday ].to_json %>"
             data-state="<%= answer.editable_state %>"
             data-windows="<%= answer.window_fields.to_json %>">
          <span class="w-12 flex-shrink-0 text-sm font-medium text-gray-900"><%= day.short_name %></span>
          <span class="flex-1 min-w-0 text-sm <%= !answer.said ? "text-gray-400" : { anytime: "text-green-700", off: "text-gray-500", hours: "text-gray-900" }[answer.state] %>">
            <%= answer.label %>
            <% if answer.set_by %>
              <span class="block text-xs text-gray-400">Set by <%= answer.set_by.person&.name || "a manager" %></span>
            <% end %>
          </span>
          <svg class="w-4 h-4 text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
        </div>
      </li>
    <% end %>
  </ul>
</section>
