<%#
  Pink iOS-style toggle switch: the one way to turn a saved setting on or off.
  Replaces the hand-rolled `sr-only peer` block that was duplicated across
  forms. Picking items from a list, and one-time options on an action form,
  stay plain checkboxes.

  Bound to a form builder:
    form  - the form builder (required unless name/tag mode)
    field - checkbox attribute name (required with form)
    checked         - force checked state (optional; omit to use the model value)
    data            - data attributes for the checkbox (optional)
    unchecked_value - paired hidden-field false value (optional)
    checked_value   - the value sent when on (optional, default "1")

  Or a bare checkbox (no form builder):
    name         - the input's name (optional: a JS-only switch can have none)
    checked      - true/false (required)
    id, data, aria_label - optional
    hidden_false - also send "0" when off, like form.check_box does (optional)
%>
<%
  cb_options = { class: "sr-only peer" }
  cb_options[:checked] = local_assigns[:checked] if local_assigns.key?(:checked)
  cb_options[:data] = local_assigns[:data] if local_assigns[:data].present?
  checked_value = local_assigns[:checked_value] || "1"
  unchecked_value = local_assigns[:unchecked_value]
  form = local_assigns[:form]
%>
<label class="relative inline-flex items-center cursor-pointer">
  <% if form.nil? %>
    <% if local_assigns[:name] && local_assigns[:hidden_false] %>
      <%= hidden_field_tag local_assigns[:name], "0", id: nil %>
    <% end %>
    <%= tag.input type: "checkbox", name: local_assigns[:name], value: checked_value, id: local_assigns[:id],
          checked: local_assigns[:checked], "aria-label": local_assigns[:aria_label], **cb_options %>
  <% elsif unchecked_value %>
    <%= form.check_box field, cb_options, checked_value, unchecked_value %>
  <% else %>
    <%= form.check_box field, cb_options %>
  <% end %>
  <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-pink-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-pink-500"></div>
</label>
