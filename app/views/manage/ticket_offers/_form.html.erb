<%# A deal's editor: when it's offered, what it offers, the deal itself, and
    how long it runs. Locals: offer. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  option_class = "flex items-start gap-3 p-3 border border-gray-300 rounded-lg cursor-pointer has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 transition-colors"
  dollars = ->(cents) { cents.nil? ? nil : format("%.2f", cents / 100.0) }
%>
<%= form_with model: offer, url: (offer.persisted? ? manage_ticket_offer_path(offer) : manage_ticket_offers_path),
      method: (offer.persisted? ? :patch : :post), class: "space-y-6" do |f| %>
  <% if offer.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= offer.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-lg p-5">
    <%= f.label :name, "Name (for you)", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
    <%= f.text_field :name, placeholder: "Boylesque → late Laugh Along Live", required: true, class: input_class %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-2">
    <h2 class="text-sm font-semibold text-gray-900">Offer it to someone buying</h2>
    <label class="<%= option_class %>">
      <%= f.radio_button :trigger_scope, "production", class: "mt-0.5 accent-pink-500" %>
      <span class="flex-1 space-y-2">
        <span class="block text-sm font-medium text-gray-900">Any date of a production</span>
        <%= f.select :trigger_production_id, production_choices, { include_blank: "Pick a production" }, class: input_class %>
      </span>
    </label>
    <label class="<%= option_class %>">
      <%= f.radio_button :trigger_scope, "listing", class: "mt-0.5 accent-pink-500" %>
      <span class="flex-1 space-y-2">
        <span class="block text-sm font-medium text-gray-900">One date</span>
        <%= f.select :trigger_listing_id, grouped_options_for_select(listing_choices, offer.trigger_listing_id), { include_blank: "Pick a date" }, class: input_class %>
      </span>
    </label>
    <label class="<%= option_class %>">
      <%= f.radio_button :trigger_scope, "any", class: "mt-0.5 accent-pink-500" %>
      <span class="block text-sm font-medium text-gray-900">Anything you sell</span>
    </label>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-2">
    <h2 class="text-sm font-semibold text-gray-900">What it offers</h2>
    <label class="<%= option_class %>">
      <%= f.radio_button :target_scope, "same_night", class: "mt-0.5 accent-pink-500" %>
      <span class="flex-1 space-y-2">
        <span class="block text-sm font-medium text-gray-900">The same night at a production</span>
        <span class="block text-xs text-gray-600">Whatever date of it is on the night they're buying. Nothing shows on a night it isn't on.</span>
        <%= f.select :target_production_id, production_choices, { include_blank: "Pick a production" }, class: input_class %>
        <%= f.text_field :target_tier_name, placeholder: "Ticket type, like General (blank: its first)", class: input_class %>
      </span>
    </label>
    <label class="<%= option_class %>">
      <%= f.radio_button :target_scope, "listing", class: "mt-0.5 accent-pink-500" %>
      <span class="flex-1 space-y-2">
        <span class="block text-sm font-medium text-gray-900">One date</span>
        <%= f.select :target_tier_id, grouped_options_for_select(tier_choices, offer.target_tier_id), { include_blank: "Pick a date and ticket type" }, class: input_class %>
      </span>
    </label>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-2">
    <h2 class="text-sm font-semibold text-gray-900">The deal</h2>
    <p class="text-xs text-gray-600">The show it's for counts the deal price, in its financials and any contract's revenue share.</p>
    <label class="<%= option_class %>">
      <%= f.radio_button :deal_kind, "amount_off", class: "mt-0.5 accent-pink-500" %>
      <span class="flex-1 flex items-center gap-3">
        <span class="text-sm font-medium text-gray-900 w-28">An amount off</span>
        <span class="relative w-32">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">$</span>
          <%= f.text_field :amount, value: dollars.call(offer.amount_cents), inputmode: "decimal", placeholder: "5.00", class: "#{input_class} pl-7" %>
        </span>
      </span>
    </label>
    <label class="<%= option_class %>">
      <%= f.radio_button :deal_kind, "percent_off", class: "mt-0.5 accent-pink-500" %>
      <span class="flex-1 flex items-center gap-3">
        <span class="text-sm font-medium text-gray-900 w-28">A percent off</span>
        <span class="relative w-32">
          <%= f.text_field :percent, inputmode: "decimal", placeholder: "20", class: "#{input_class} pr-7" %>
          <span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">%</span>
        </span>
      </span>
    </label>
    <label class="<%= option_class %>">
      <%= f.radio_button :deal_kind, "price", class: "mt-0.5 accent-pink-500" %>
      <span class="flex-1 flex items-center gap-3">
        <span class="text-sm font-medium text-gray-900 w-28">A set price</span>
        <span class="relative w-32">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">$</span>
          <%= f.text_field :price, value: dollars.call(offer.price_cents), inputmode: "decimal", placeholder: "12.00", class: "#{input_class} pl-7" %>
        </span>
      </span>
    </label>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
    <h2 class="text-sm font-semibold text-gray-900">Running it</h2>
    <label class="flex items-start gap-3">
      <%= f.check_box :active, class: "h-4 w-4 mt-0.5 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
      <span>
        <span class="block text-sm font-medium text-gray-900">On</span>
        <span class="block text-xs text-gray-600 mt-0.5">Off, nobody sees it. Tickets already bought with it keep their price.</span>
      </span>
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :max_per_order, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
          Most per order <span class="font-normal text-gray-500">(optional)</span>
        <% end %>
        <%= f.number_field :max_per_order, min: 1, placeholder: "One per ticket they buy", class: input_class %>
      </div>
      <div>
        <%= f.label :after_purchase_days, "After they buy, offer it for", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.select :after_purchase_days, [ [ "Not after buying", 0 ], [ "1 day", 1 ], [ "2 days", 2 ], [ "3 days", 3 ], [ "A week", 7 ] ], {}, class: input_class %>
        <p class="mt-1 text-xs text-gray-500">On their order page and in their confirmation email.</p>
      </div>
      <div>
        <%= f.label :starts_at, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
          Starts <span class="font-normal text-gray-500">(optional)</span>
        <% end %>
        <%= f.datetime_local_field :starts_at, class: input_class %>
      </div>
      <div>
        <%= f.label :ends_at, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
          Ends <span class="font-normal text-gray-500">(optional)</span>
        <% end %>
        <%= f.datetime_local_field :ends_at, class: input_class %>
      </div>
      <div>
        <%= f.label :max_uses, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
          Most tickets in all <span class="font-normal text-gray-500">(optional)</span>
        <% end %>
        <%= f.number_field :max_uses, min: 1, placeholder: "No limit", class: input_class %>
      </div>
    </div>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= render "shared/button", text: (offer.persisted? ? "Save" : "Save deal"), variant: "primary", size: "medium", type: :submit %>
    <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", path: manage_ticket_offers_path %>
  </div>
<% end %>
