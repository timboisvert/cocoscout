<%# Heads-up for staff who declined an upcoming shift ("can't make it"). Needs
    @declined_assignments (ShiftAssignments, declined, upcoming, org-scoped). %>
<% if @declined_assignments.present? %>
  <div class="rounded-lg border border-pink-300 bg-pink-50 p-4 mb-4">
    <div class="flex items-start gap-2 mb-2">
      <svg class="w-5 h-5 text-pink-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <div>
        <h3 class="text-sm font-semibold text-pink-900"><%= pluralize(@declined_assignments.size, "person") %> can't make an upcoming shift</h3>
        <p class="text-xs text-pink-700">They've been scheduled but told you they can't make it. Reassign or find cover as needed.</p>
      </div>
    </div>
    <div class="space-y-1.5">
      <% @declined_assignments.each do |a| %>
        <% s = a.shift %>
        <% show_names = s.covered_shows.map { |cs| cs.production&.name }.compact.uniq %>
        <div class="flex items-center flex-wrap gap-x-2 gap-y-0.5 text-sm bg-white border border-pink-200 rounded px-3 py-2">
          <span class="font-medium text-gray-900"><%= a.person.name %></span>
          <span class="text-gray-400">·</span>
          <span class="text-gray-700"><%= s.role_label %></span>
          <span class="text-gray-400">·</span>
          <span class="text-gray-600 tabular-nums"><%= s.starts_at.strftime("%a %b %-d, %-l:%M %p") %>–<%= s.ends_at.strftime("%-l:%M %p") %></span>
          <% if show_names.any? %>
            <span class="text-gray-400">·</span>
            <span class="text-purple-700 truncate"><%= show_names.join(", ") %></span>
          <% end %>
          <% if a.decline_reason.present? %>
            <span class="w-full text-xs text-pink-700 mt-0.5">“<%= a.decline_reason %>”</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
