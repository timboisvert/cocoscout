<%# Balance-aware payout status for the current person. Shows what they're owed
    across all their productions, whether any of it is already on its way (in a
    submitted payout run, with the expected deposit window), and turns the rest
    into the reason to connect a bank. When money is owed this box IS the bank
    nudge — the generic connect banner stays hidden so the ask has a number on
    it. Self-guarding: renders nothing when there's nothing worth showing.
    Works on any "my" page (uses Current.user's person if @person isn't set). %>
<% ps_person = @person || Current.user&.person %>
<% if ps_person %>
  <% owed_cents = ps_person.payout_balance_cents %>
  <% if owed_cents.positive? %>
    <%
      owed = number_to_currency(owed_cents / 100.0)
      # Money already staged in submitted (in-flight) runs — funded, just
      # waiting on the bank rails or on this person's bank details.
      submitted_items = PayoutBatchItem.where(payee: ps_person, status: "pending")
                                       .joins(:payout_batch)
                                       .where(payout_batches: { status: PayoutBatchService::UNSETTLED_BATCH_STATUSES })
                                       .includes(:payout_batch).to_a
                                       .select { |i| i.payout_batch.in_flight? }
      submitted_cents = submitted_items.sum(&:amount_cents)
      windows = submitted_items.map { |i| i.payout_batch.expected_deposit_range }
      window_text = if windows.any?
        "#{windows.map(&:first).min.strftime('%b %-d')} – #{windows.map(&:last).max.strftime('%b %-d')}"
      end
      rest_cents = owed_cents - submitted_cents
    %>
    <%
      # One small line under the amount, and one button. Which pair depends on
      # whether they can actually be paid yet.
      bold = ->(text) { tag.span(text, class: "font-semibold") }
      body =
        if ps_person.can_receive_payouts?
          if submitted_cents.positive?
            safe_join([ bold.call(number_to_currency(submitted_cents / 100.0)), " is on its way — expect it in your bank ",
                        bold.call(window_text), ".",
                        (" The other #{number_to_currency(rest_cents / 100.0)} goes out on a future payout run." if rest_cents.positive?) ].compact)
          else
            "Heading to your bank on the next payout run."
          end
        elsif submitted_cents.positive?
          # Their money is literally funded and parked — the strongest possible
          # reason to connect. Lead with it.
          safe_join([ bold.call("#{number_to_currency(submitted_cents / 100.0)} of this is already funded and waiting on you"),
                      " — it heads to your bank within days of you connecting one.",
                      (" The rest follows on future payout runs." if rest_cents.positive?) ].compact)
        else
          safe_join([ "Connect your bank and you'll get this ", bold.call(owed),
                      " automatically, straight to your account — no chasing checks." ])
        end
      action =
        if ps_person.can_receive_payouts?
          { text: "Go to My Payments", path: my_payments_path }
        else
          { text: "Connect your bank & get paid", path: my_payments_connect_bank_path,
            method: :post, form: { data: { turbo: false } } }
        end
    %>
    <%= render "shared/alert_panel",
          eyebrow: "You're owed",
          headline: owed,
          body: body,
          actions: [ action ] %>
  <% elsif local_assigns.fetch(:banner_fallback, true) %>
    <%# Nothing owed right now — fall back to the general "connect your bank" nudge
        (self-guards on needs_bank_connection?). Suppressed where the page already
        carries the connect message (e.g. the setup page's August 1 callout). %>
    <%= render "my/payments/bank_connect_banner" %>
  <% end %>
<% end %>
