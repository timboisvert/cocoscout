<% content_for :title, "Amend Contract - Review" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Contracts", manage_contracts_path],
      [@contract.contractor_name, manage_contract_path(@contract)]
    ],
    text: "Review Amendments",
    links: []
  } %>

  <%= render "manage/contracts/amend_steps", current: 5 %>

  <div class="max-w-2xl mx-auto mt-6">
    <p class="text-gray-600 mb-6">Review and confirm your changes before applying.</p>

  <% if @has_changes %>
    <%# Events Changes %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
      <div class="px-4 py-3 bg-gray-50 border-b border-gray-200">
        <h3 class="text-sm font-semibold text-gray-700">Event Changes</h3>
      </div>
      <div class="p-4 space-y-4">
        <% if @rentals_to_remove.any? %>
          <div>
            <h4 class="text-sm font-medium text-red-600 mb-2 flex items-center gap-2">
              <%= icon("minus-circle", class: "w-4 h-4") %>
              Events to Remove (<%= @rentals_to_remove.count %>)
            </h4>
            <div class="space-y-2">
              <% @rentals_to_remove.each do |rental| %>
                <div class="flex items-center gap-3 p-3 bg-red-50 border border-red-200 rounded-lg">
                  <div class="flex-shrink-0 w-12 flex items-center gap-1">
                    <span class="text-lg leading-none font-bold text-gray-900"><%= rental.starts_at.strftime("%-d") %></span>
                    <span class="text-[9px] leading-tight font-semibold text-red-600 uppercase"><%= rental.starts_at.strftime("%b") %></span>
                  </div>
                  <div>
                    <div class="font-medium text-gray-900">
                      <%= rental.space_name %>
                    </div>
                    <div class="text-sm text-gray-500">
                      <%= rental.starts_at.strftime("%l:%M %p").strip %> - <%= rental.ends_at.strftime("%l:%M %p").strip %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @new_bookings.any? %>
          <div>
            <h4 class="text-sm font-medium text-green-600 mb-2 flex items-center gap-2">
              <%= icon("plus-circle", class: "w-4 h-4") %>
              Events to Add (<%= @new_bookings.count %>)
            </h4>
            <div class="space-y-2">
              <% @new_bookings.each do |booking| %>
                <% starts_at = Time.zone.parse(booking["starts_at"]) %>
                <% location = @locations_map[booking["location_id"].to_i] %>
                <% space = @spaces_map[booking["space_id"].to_i] %>
                <div class="flex items-center gap-3 p-3 bg-green-50 border border-green-200 rounded-lg">
                  <div class="flex-shrink-0 w-12 flex items-center gap-1">
                    <span class="text-lg leading-none font-bold text-gray-900"><%= starts_at.strftime("%-d") %></span>
                    <span class="text-[9px] leading-tight font-semibold text-green-600 uppercase"><%= starts_at.strftime("%b") %></span>
                  </div>
                  <div>
                    <div class="font-medium text-gray-900">
                      <%= space&.name || location&.name || "Location" %>
                    </div>
                    <div class="text-sm text-gray-500">
                      <%= starts_at.strftime("%l:%M %p").strip %> · <%= booking["duration"] || 2 %> hours
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @removed_rental_ids.empty? && @new_bookings.empty? %>
          <p class="text-sm text-gray-500">No changes to events.</p>
        <% end %>
      </div>
    </div>

    <%# Payment Changes — the full set of payments after this amendment (paid
        payments are preserved; the pending ones are replaced by this list). %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
      <div class="px-4 py-3 bg-gray-50 border-b border-gray-200">
        <h3 class="text-sm font-semibold text-gray-700">Payments</h3>
      </div>
      <div class="p-4 space-y-2">
        <% if @financials_changed %>
          <% staged_payments = @amend_data["payments"] || [] %>
          <% if staged_payments.any? %>
            <% staged_payments.each do |payment| %>
              <% incoming = payment["direction"] == "incoming" %>
              <div class="flex items-center justify-between p-3 bg-gray-50 border border-gray-200 rounded-lg">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full flex items-center justify-center <%= incoming ? 'bg-green-100' : 'bg-red-100' %>">
                    <%= icon(incoming ? "arrow-down-left" : "arrow-up-right", class: "w-4 h-4 #{incoming ? 'text-green-600' : 'text-red-600'}") %>
                  </div>
                  <div>
                    <div class="font-medium text-gray-900"><%= payment["description"] %></div>
                    <div class="text-sm text-gray-500">Due: <%= Date.parse(payment["due_date"].to_s).strftime("%b %-d, %Y") rescue "TBD" %></div>
                  </div>
                </div>
                <div class="font-semibold <%= incoming ? 'text-green-600' : 'text-red-600' %>">
                  <%= incoming ? '+' : '-' %><% if payment["amount_tbd"] %>TBD<% else %><%= number_to_currency(payment["amount"].to_f) %><% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-gray-500">No payments on this contract.</p>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-500">No changes to the financials.</p>
        <% end %>
      </div>
    </div>

    <%# Production Name Change %>
    <% if @production_name_changed %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
        <div class="px-4 py-3 bg-gray-50 border-b border-gray-200">
          <h3 class="text-sm font-semibold text-gray-700">Production Name Change</h3>
        </div>
        <div class="p-4 flex items-center gap-3 text-sm">
          <span class="text-gray-500 line-through"><%= @contract.production_name.presence || "(unnamed)" %></span>
          <%= icon("arrow-right", class: "w-4 h-4 text-gray-400") %>
          <span class="font-medium text-gray-900"><%= @new_production_name %></span>
        </div>
      </div>
    <% end %>

    <%# Ticketing & Services Changes %>
    <% if @ticketing_changed || @services_changed %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
        <div class="px-4 py-3 bg-gray-50 border-b border-gray-200">
          <h3 class="text-sm font-semibold text-gray-700">Ticketing &amp; Services Changes</h3>
        </div>
        <div class="p-4 space-y-4">
          <% if @ticketing_changed %>
            <% tiers = @new_ticketing["tiers"] || [] %>
            <% discounts = Contract.ticketing_discounts(@new_ticketing) %>
            <div>
              <h4 class="text-sm font-medium text-gray-900 mb-2">New ticketing</h4>
              <% if tiers.any? %>
                <ul class="space-y-1 text-sm text-gray-700">
                  <% tiers.each do |tier| %>
                    <li class="flex items-center justify-between">
                      <span><%= tier["name"] %></span>
                      <span class="font-medium"><%= number_to_currency(tier["price"]) %></span>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-sm text-gray-500">No ticket tiers.</p>
              <% end %>
              <% discounts.each do |discount| %>
                <p class="text-sm text-gray-600 mt-2">
                  Discount <span class="font-medium"><%= discount["code"] %></span>:
                  <%= discount["amount_type"] == "percent" ? "#{discount["amount"]}% off" : "#{number_to_currency(discount["amount"])} off" %>
                  <%= discount["applies_to"] == "specific" ? "(#{(discount["tier_names"] || []).join(", ")})" : "(all tickets)" %>
                </p>
              <% end %>
            </div>
          <% end %>

          <% if @services_changed %>
            <div>
              <h4 class="text-sm font-medium text-gray-900 mb-2">Services</h4>
              <% if @new_services.any? %>
                <ul class="space-y-1 text-sm text-gray-700">
                  <% @new_services.each do |service| %>
                    <% qty = service["quantity"].to_f %>
                    <% total = qty * service["unit_price"].to_f %>
                    <% incoming = (service["direction"].presence || "incoming") == "incoming" %>
                    <li class="flex items-center justify-between gap-3">
                      <span><%= service["name"] %> <span class="text-xs text-gray-500"><%= qty %><%= service["unit"] == "hourly" ? " hr" : "" %> × <%= number_to_currency(service["unit_price"]) %></span></span>
                      <span class="font-medium <%= incoming ? 'text-green-600' : 'text-red-600' %>"><%= incoming ? "They pay us" : "We pay them" %> <%= number_to_currency(total) %></span>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-sm text-gray-500">No services on this contract.</p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Summary %>
    <div class="bg-pink-50 border border-pink-200 rounded-lg p-4 mb-6">
      <h3 class="text-sm font-semibold text-pink-800 mb-2">Amendment Summary</h3>
      <div class="grid grid-cols-2 gap-4 text-sm">
        <div>
          <span class="text-pink-700">Events:</span>
          <span class="font-medium text-pink-900">
            <% if @removed_rental_ids.any? %>-<%= @removed_rental_ids.count %><% end %>
            <% if @new_bookings.any? %><%= @removed_rental_ids.any? ? ', ' : '' %>+<%= @new_bookings.count %><% end %>
            <% if @removed_rental_ids.empty? && @new_bookings.empty? %>No changes<% end %>
          </span>
        </div>
        <div>
          <span class="text-pink-700">Financials:</span>
          <span class="font-medium text-pink-900"><%= @financials_changed ? "Updated" : "No changes" %></span>
        </div>
        <div>
          <span class="text-pink-700">Production name:</span>
          <span class="font-medium text-pink-900"><%= @production_name_changed ? "Updated" : "No changes" %></span>
        </div>
        <div>
          <span class="text-pink-700">Ticketing:</span>
          <span class="font-medium text-pink-900"><%= @ticketing_changed ? "Updated" : "No changes" %></span>
        </div>
        <div>
          <span class="text-pink-700">Services:</span>
          <span class="font-medium text-pink-900"><%= @services_changed ? "Updated" : "No changes" %></span>
        </div>
      </div>
    </div>

    <%# Navigation. When the new events genuinely collide with something already
        booked, Apply is locked behind a "view the conflict" modal that has to be
        acknowledged first. %>
    <div<%= ' data-controller="contract-conflict"'.html_safe if @conflicts.any? %>>
      <% if @conflicts.any? %>
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3">
          <div class="flex items-center gap-2 text-sm text-amber-900">
            <%= icon("alert-triangle", class: "w-5 h-5 text-amber-500 flex-shrink-0") %>
            <span>
              <span class="font-semibold"><%= pluralize(@conflicts.sum { |c| c[:against].size }, "scheduling conflict") %>.</span>
              A new event lands in a room that's already booked at that time.
            </span>
          </div>
          <button type="button" data-action="contract-conflict#open"
                  class="inline-flex items-center gap-1.5 rounded-md bg-amber-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-amber-700 transition-colors flex-shrink-0">
            <%= icon("eye", class: "w-4 h-4") %>
            View the conflict
          </button>
        </div>
      <% end %>

      <div class="flex justify-between items-end pt-4 border-t border-gray-200">
        <%= render "shared/button", text: "Back: Ticketing & Services", variant: "secondary", size: "medium", icon: "arrow-left", path: amend_ticketing_tech_manage_contract_path(@contract) %>
        <%= form_with url: apply_amendments_manage_contract_path(@contract), method: :post, local: true do %>
          <input type="hidden" name="force_overlap" value="" data-contract-conflict-target="flag">
          <div data-contract-conflict-target="submit">
            <%= render "shared/button", text: "Apply Amendments", variant: "primary", size: "medium", icon: "check", type: :submit %>
          </div>
        <% end %>
      </div>

      <%# Conflict modal — lists exactly what's double-booked, and the acknowledge
          checkbox that unlocks Apply. %>
      <% if @conflicts.any? %>
        <div data-contract-conflict-target="modal" class="hidden fixed inset-0 z-50">
          <div class="fixed inset-0 bg-black/50" data-action="click->contract-conflict#closeOnBackdrop">
            <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
              <div class="bg-white rounded-xl shadow-xl max-w-lg w-full overflow-hidden pointer-events-auto max-h-[85vh] flex flex-col">
                <div class="flex items-center justify-between px-6 py-4 bg-pink-600 flex-shrink-0">
                  <h3 class="text-lg font-bold text-white">Scheduling conflicts</h3>
                  <button type="button" data-action="contract-conflict#close" class="text-white/80 hover:text-white">
                    <%= icon("x", class: "w-5 h-5") %>
                  </button>
                </div>

                <div class="p-6 space-y-4 overflow-y-auto">
                  <p class="text-sm text-gray-600">These new events are booked into a room that already has something scheduled at the same time:</p>
                  <% @conflicts.each do |conflict| %>
                    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
                      <div class="text-sm font-semibold text-gray-900">
                        <%= conflict[:space_name] %><% if conflict[:location_name] %> <span class="text-gray-500 font-normal">· <%= conflict[:location_name] %></span><% end %>
                      </div>
                      <div class="text-sm text-gray-700 mt-0.5">New event: <span class="font-medium"><%= conflict[:when] %></span></div>
                      <div class="mt-2 pt-2 border-t border-amber-200 space-y-1">
                        <% conflict[:against].each do |clash| %>
                          <div class="flex items-center justify-between gap-3 text-sm">
                            <span class="text-gray-600"><%= clash[:label] %></span>
                            <span class="text-gray-900 font-medium"><%= clash[:when] %></span>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>

                  <label class="flex items-start gap-3 rounded-lg border border-gray-200 bg-gray-50 p-3 cursor-pointer">
                    <input type="checkbox" data-action="change->contract-conflict#toggle"
                           class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
                    <span class="text-sm text-gray-700">I understand these events will be double-booked in the same room at the same time, and I want to schedule them anyway.</span>
                  </label>
                </div>

                <div class="flex gap-3 px-6 py-4 border-t border-gray-200 flex-shrink-0">
                  <button type="button" data-action="contract-conflict#close"
                          class="flex-1 px-4 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                    Done
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# No Changes %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 text-center mb-6">
      <%= icon("alert-triangle", class: "w-12 h-12 text-yellow-500 mx-auto mb-3") %>
      <h3 class="text-lg font-semibold text-yellow-800 mb-2">No Changes to Apply</h3>
      <p class="text-yellow-700 mb-4">You haven't made any changes to this contract.</p>
      <%= render "shared/button", text: "Go Back to Events", variant: "secondary", size: "medium", path: amend_bookings_manage_contract_path(@contract) %>
    </div>

    <div class="flex justify-center">
      <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", path: manage_contract_path(@contract) %>
    </div>
  <% end %>

  </div>
</div>