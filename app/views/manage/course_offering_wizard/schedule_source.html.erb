<%= render layout: "manage/course_offering_wizard/wizard_layout", locals: { step_name: "Schedule" } do %>
  <% contract_selected = @wizard_state[:schedule_mode] == "contract" && @has_active_contracts %>
  <div class="text-center mb-6">
    <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
      </svg>
    </div>
    <h2 class="text-xl font-bold text-gray-900">Where does the schedule come from?</h2>
    <p class="text-gray-600 mt-2">Your organization is on the Pro plan, so this course can pull its schedule straight from a contract's booked time slots &mdash; or you can build a fresh one.</p>
  </div>

  <%= form_with url: manage_course_wizard_schedule_source_path, method: :post, local: true do %>
    <div class="space-y-3" data-controller="radio-toggle">
      <% if @has_active_contracts %>
        <label class="block cursor-pointer">
          <div data-radio-toggle-target="card" data-value="contract"
               class="flex items-start gap-3 rounded-lg border p-4 <%= contract_selected ? 'border-pink-500 bg-pink-50' : 'border-gray-200 bg-gray-50' %>">
            <input type="radio" name="schedule_source" value="contract" <%= "checked" if contract_selected %>
                   data-action="change->radio-toggle#update"
                   class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500">
            <div>
              <div class="flex items-center gap-2">
                <span class="font-medium text-gray-900">Part of an existing contract</span>
                <span class="text-[9px] font-bold uppercase tracking-wide text-pink-600 bg-white border border-pink-200 rounded px-1 py-0.5 leading-none">Pro</span>
              </div>
              <div class="text-sm text-gray-600">The time slots booked on the contract become this course's class sessions.</div>
            </div>
          </div>
        </label>
      <% else %>
        <div class="flex items-start gap-3 rounded-lg border border-gray-200 bg-gray-50 p-4 opacity-70">
          <svg class="mt-0.5 w-4 h-4 text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-label="No active contracts">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
          </svg>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-medium text-gray-500">Part of an existing contract</span>
              <span class="text-[9px] font-bold uppercase tracking-wide text-pink-600 bg-white border border-pink-200 rounded px-1 py-0.5 leading-none">Pro</span>
            </div>
            <div class="text-sm text-gray-500">You don't have any active contracts yet. Once you create one in <%= link_to "Contracts", manage_contracts_path, class: "text-pink-600 hover:text-pink-700 font-medium" %>, its booked time slots can become class sessions.</div>
          </div>
        </div>
      <% end %>

      <label class="block cursor-pointer">
        <div data-radio-toggle-target="card" data-value="independent"
             class="flex items-start gap-3 rounded-lg border p-4 <%= contract_selected ? 'border-gray-200 bg-gray-50' : 'border-pink-500 bg-pink-50' %>">
          <input type="radio" name="schedule_source" value="independent" <%= "checked" unless contract_selected %>
                 data-action="change->radio-toggle#update"
                 class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500">
          <div>
            <div class="font-medium text-gray-900">A fresh schedule</div>
            <div class="text-sm text-gray-600">Pick a location and enter the session dates yourself.</div>
          </div>
        </div>
      </label>
    </div>

    <div class="mt-8 flex items-center justify-between">
      <%= link_to manage_course_wizard_instructor_path, class: "text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Back
      <% end %>
      <%= render "shared/button", text: "Continue", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>
