<%# In the iOS/Android app only: tells the native shell which tabs this person
    gets and their badge counts (bridge/tabs_controller.js). Rendered by every
    layout the app can land on. %>
<% if turbo_native_app? %>
  <%= tag.div hidden: true, data: { controller: "bridge--tabs", "bridge--tabs-tabs-value": native_tabs.to_json } %>
<% end %>
