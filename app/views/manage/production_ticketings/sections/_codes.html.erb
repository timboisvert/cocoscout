<%# Discount codes for every date of the production (Tim, 2026-10-17): the
    list, or that there are none yet, and a pink modal to add one. A date
    can have its own instead, on its Codes tab. Locals: setup, production. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  codes = production.organization.ticket_discount_codes.where(production: production, active: true).order(:code).to_a
  modal_id = "add-code-modal"
%>
<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
  <%= render "shared/section_heading", title: "Discount codes",
        intro: "Codes buyers can enter at checkout, good for every date of #{production.name}. A single date can have its own instead, on its Settings." do %>
    <%= render "shared/button", text: "Add code", variant: "primary", size: "small", type: :button,
          data: { controller: "modal", action: "click->modal#open", modal_id: modal_id } %>
  <% end %>
  <% if codes.any? %>
    <ul class="divide-y divide-gray-100">
      <% codes.each do |code| %>
        <%= render "manage/ticketing/code_row", code: code, share_form: manage_production_ticketing_code_path(production, code_id: code.id), remove_modal_id: "confirm-remove-code-#{code.id}" %>
      <% end %>
    </ul>
  <% else %>
    <p class="px-6 py-5 text-sm text-gray-500">No codes yet. Add one and buyers can enter it at checkout.</p>
  <% end %>
</div>
<%= render "manage/ticketing/code_modal", id: modal_id, url: manage_production_ticketing_codes_path(production), what: "every date of #{production.name}", input_class: input_class %>
<% codes.each do |code| %>
  <%= render "shared/confirm_modal", id: "confirm-remove-code-#{code.id}", title: "Remove #{code.code}?",
        message: "Buyers won't be able to use it anymore. Orders that already used it keep their discount.",
        confirm_text: "Remove code", url: manage_production_ticketing_code_path(production, code_id: code.id), method: :delete %>
<% end %>
