<%# What the buyer is paying for, line by line, adding up to the total. Rendered
    again (over JSON) whenever they add or take off a product. Locals: order. %>
<%
  tickets = order.tickets.to_a
  by_tier = tickets.group_by(&:ticket_tier)
  items = order.ticket_order_items.to_a
  added_tax = TaxLine.where(taxable: tickets + items, included: false).group(:name, :rate_bps).sum(:tax_cents).select { |_, cents| cents.positive? }
%>
<div class="border-t border-gray-100 px-5 py-4 space-y-2 text-sm">
  <% by_tier.each do |tier, rows| %>
    <div class="flex items-baseline justify-between gap-3">
      <span class="text-gray-900"><%= rows.size %> × <%= tier.name %></span>
      <span class="tabular-nums text-gray-900"><%= number_to_currency(rows.sum(&:price_cents) / 100.0) %></span>
    </div>
  <% end %>
  <% items.each do |item| %>
    <div class="flex items-baseline justify-between gap-3">
      <span class="text-gray-900"><%= item.quantity %> × <%= item.name %></span>
      <span class="tabular-nums text-gray-900"><%= number_to_currency(item.price_cents / 100.0) %></span>
    </div>
  <% end %>
  <% if order.discount_cents.positive? %>
    <div class="flex items-baseline justify-between gap-3">
      <span class="text-gray-600">Discount<%= " (#{order.ticket_discount_code.code})" if order.ticket_discount_code %></span>
      <span class="tabular-nums text-gray-900">−<%= number_to_currency(order.discount_cents / 100.0) %></span>
    </div>
  <% end %>
  <% if order.buyer_fee_cents.positive? %>
    <div class="flex items-baseline justify-between gap-3">
      <span class="text-gray-600">Fees</span>
      <span class="tabular-nums text-gray-900"><%= number_to_currency(order.buyer_fee_cents / 100.0) %></span>
    </div>
  <% end %>
  <% added_tax.each do |(name, rate_bps), cents| %>
    <div class="flex items-baseline justify-between gap-3">
      <span class="text-gray-600"><%= name %> <%= format("%g", rate_bps / 100.0) %>%</span>
      <span class="tabular-nums text-gray-900"><%= number_to_currency(cents / 100.0) %></span>
    </div>
  <% end %>
  <div class="flex items-baseline justify-between gap-3 pt-2 border-t border-gray-100">
    <span class="font-semibold text-gray-900">Total</span>
    <span class="text-lg font-bold tabular-nums text-gray-900"><%= number_to_currency(order.total_cents / 100.0) %></span>
  </div>
</div>
