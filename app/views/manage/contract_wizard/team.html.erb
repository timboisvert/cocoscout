<%# Step "Team" (Tim, 2026-10-16): the production's team, added or invited the
    moment the contract is activated. The contract's signer is suggested
    first; anyone else is found by name or email (invite-search), and
    invited by email only after a search finds nobody. Everyone joins as a
    viewer (Tim, 2026-10-17: someone under contract sees the production,
    never changes it); the organization can make someone a manager later
    on the production's Team tab. %>
<%
  production_name = @contract.production_name.presence || "the production"
  org = Current.organization
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  initials = ->(name) { name.to_s.split.first(2).map { |w| w[0] }.join.upcase.presence || "?" }
%>
<%= render layout: "manage/contract_wizard/wizard_layout", locals: { step_name: "Team", width: "max-w-3xl" } do %>
  <h2 class="text-xl font-bold text-gray-900 mb-2">Production team</h2>
  <p class="text-gray-600 mb-6">
    The people on <%= possessive(production_name) %> side. They see the production from their own Production Dashboard: shows, casting, sign-ups, and how tickets are selling, without changing any of it.
    Everyone here is invited the moment the contract is activated.
  </p>

  <%# Who's on it so far. %>
  <div class="border border-gray-200 rounded-lg overflow-hidden mb-6" data-team-list>
    <% if @team.empty? %>
      <p class="px-5 py-5 text-sm text-gray-500">Nobody yet. The people who signed usually run the production.</p>
    <% else %>
      <ul class="divide-y divide-gray-100">
        <% @team.each do |member| %>
          <%
            user = member["user_id"] && @team_users[member["user_id"].to_i]
            name = member["name"].presence || user&.person&.name.presence || member["email"]
            detail = if member["suggested"] then "Signs this contract for #{@contract.contractor_name}"
                     elsif member["email"].present? then "Will be invited by email"
                     elsif user && user.organization_roles.any? { |r| r.organization_id == org.id } then "Member of #{org.name}"
                     else "On CocoScout"
                     end
          %>
          <li class="flex flex-wrap items-center gap-3 px-5 py-3">
            <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-sm flex-shrink-0"><%= initials.call(name) %></div>
            <div class="min-w-[9rem] flex-1">
              <div class="text-sm font-medium text-gray-900 truncate"><%= name %></div>
              <div class="text-xs text-gray-500 truncate"><%= detail %></div>
            </div>
            <span class="text-xs font-medium text-gray-700">Viewer</span>
            <% if member["suggested"] %>
              <span class="inline-flex items-center rounded-md bg-pink-50 border border-pink-200 px-1.5 py-0.5 text-[11px] font-medium text-pink-700">From the contract</span>
            <% end %>
            <% if member["email"].present? %>
              <span class="inline-flex items-center rounded-md bg-gray-100 px-1.5 py-0.5 text-[11px] font-medium text-gray-600">Will be invited by email</span>
            <% end %>
            <%= button_to manage_team_members_contract_wizard_path(@contract), method: :delete,
                  params: { user_id: member["user_id"], email: member["email"] }.compact, class: "inline" do %>
              <%= render "shared/button", text: "Remove", variant: "secondary", size: "small", type: :submit %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <%# Adding someone: search first; the invite form only after a search finds nobody. %>
  <div class="border border-gray-200 rounded-lg overflow-hidden mb-6"
       data-controller="invite-search" data-invite-search-url-value="<%= search_for_invite_manage_people_path(mode: "link") %>">
    <div class="px-5 py-4" data-invite-search-target="searchSection">
      <label for="team-search" class="block text-sm font-medium text-gray-900 mb-1.5">Who else is on the team? <span class="font-normal text-gray-500">Find them by name or email</span></label>
      <input id="team-search" type="search" autocomplete="off" placeholder="Name or email" class="<%= input_class %>"
             data-invite-search-target="input" data-action="input->invite-search#search">
      <div class="mt-3" data-invite-search-target="results"></div>
    </div>

    <%= form_with url: manage_team_members_contract_wizard_path(@contract), method: :post, class: "hidden", data: { invite_search_target: "inviteForm" } do %>
      <%= hidden_field_tag :person_id, nil, data: { invite_search_target: "selectedPersonIdInput" } %>
      <div class="hidden px-5 pt-4 flex items-center justify-between gap-3" data-invite-search-target="selectedPerson">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900 truncate" data-invite-search-target="selectedPersonName"></div>
          <div class="text-xs text-gray-500 truncate" data-invite-search-target="selectedPersonEmail"></div>
        </div>
        <%= render "shared/button", text: "Choose someone else", variant: "ghost", size: "small", type: :button, data: { action: "click->invite-search#backToSearch" } %>
      </div>
      <div class="px-5 pt-4 space-y-3" data-invite-search-target="personDetailsSection">
        <p class="text-sm text-gray-700">No one on CocoScout has that address. Invite them: they get an email, make a free account, and find <%= production_name %> waiting.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="team_invite_name" class="block text-sm font-medium text-gray-700 mb-1.5">Name</label>
            <%= text_field_tag :name, nil, id: "team_invite_name", placeholder: "Their name", class: input_class, data: { invite_search_target: "inviteName" } %>
          </div>
          <div>
            <label for="team_invite_email" class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
            <%= email_field_tag :email, nil, id: "team_invite_email", class: input_class, data: { invite_search_target: "inviteEmail" } %>
          </div>
        </div>
        <%= render "shared/button", text: "Choose someone else", variant: "ghost", size: "small", type: :button, data: { action: "click->invite-search#backToSearch" } %>
      </div>
      <div class="px-5 py-4 border-t border-gray-200 bg-gray-50">
        <div data-invite-search-target="pickSubmit">
          <%= render "shared/button", text: "Add to the team", variant: "primary", size: "small", type: :submit %>
        </div>
        <div class="hidden" data-invite-search-target="inviteSubmit">
          <%= render "shared/button", text: "Invite and add to the team", variant: "primary", size: "small", type: :submit %>
        </div>
      </div>
    <% end %>
  </div>

  <%= form_with url: manage_team_contract_wizard_path(@contract), method: :post, local: true do %>
    <div class="flex items-center justify-between">
      <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", icon: "arrow-left", path: manage_signing_contract_wizard_path(@contract) %>
      <%= render "shared/button", text: "Next: Schedule", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>
