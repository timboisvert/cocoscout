<% content_for :title, @production ? "#{@production.name} — Incoming" : "Incoming Payments" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: @production ? [
      ["Money", manage_money_index_path],
      ["Incoming Payments", manage_money_incoming_path]
    ] : [
      ["Money", manage_money_index_path]
    ],
    text: @production ? @production.name : "Incoming Payments",
    links: []
  } %>

  <%# ---- Window filter ---------------------------------------------------- %>
  <% window_path = ->(key) { @production ? manage_money_production_incoming_path(@production, window: key) : manage_money_incoming_path(window: key, group: @group_by) } %>
  <%= render "shared/filters/filter_bar", filter_groups: [
        { label: "Show next", filters: @windows.map { |w| { text: w[:label], path: window_path.call(w[:key]), active: @window_key == w[:key] } } }
      ] %>

  <%# ---- Summary ---------------------------------------------------------- %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-4 mb-6">
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="text-xs font-medium text-gray-500 uppercase tracking-wide">Outstanding</div>
      <div class="text-2xl font-bold text-gray-900 mt-1 tabular-nums"><%= number_to_currency(@total_outstanding) %></div>
      <div class="text-xs text-gray-400 mt-0.5">total still owed to you</div>
    </div>
    <div class="bg-white rounded-lg border <%= @overdue_count.positive? ? 'border-red-200' : 'border-gray-200' %> p-4">
      <div class="text-xs font-medium text-gray-500 uppercase tracking-wide">Overdue</div>
      <div class="text-2xl font-bold mt-1 tabular-nums <%= @overdue_count.positive? ? 'text-red-600' : 'text-gray-400' %>"><%= number_to_currency(@total_overdue) %></div>
      <div class="text-xs text-gray-400 mt-0.5"><%= pluralize(@overdue_count, "payment") %> past due</div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="text-xs font-medium text-gray-500 uppercase tracking-wide">Expected · <%= @window_end ? "next #{@window_label.downcase}" : "all upcoming" %></div>
      <div class="text-2xl font-bold text-green-600 mt-1 tabular-nums"><%= number_to_currency(@expected_in_window) %></div>
      <div class="text-xs text-gray-400 mt-0.5"><%= pluralize(@upcoming_count, "payment") %> upcoming</div>
    </div>
  </div>

  <%# ---- Cash-flow forecast (by month) ------------------------------------ %>
  <% if @monthly_forecast.any? || @total_overdue.positive? %>
    <% max_bar = [ (@monthly_forecast.map { |m| m[:total] }.max || 0), @total_overdue ].max %>
    <% max_bar = 1 if max_bar <= 0 %>
    <div class="bg-white rounded-lg border border-gray-200 p-5 mb-6">
      <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-4">Expected income by month</h3>
      <div class="space-y-1.5">
        <% if @total_overdue.positive? %>
          <div class="flex items-center gap-3">
            <div class="w-20 sm:w-24 flex-shrink-0 text-sm font-medium text-red-600">Overdue</div>
            <div class="flex-1 h-6 bg-gray-100 rounded overflow-hidden">
              <div class="h-full bg-red-400 rounded" style="width: <%= [ (@total_overdue / max_bar * 100).round, 2 ].max %>%"></div>
            </div>
            <div class="w-24 sm:w-28 flex-shrink-0 text-right text-sm font-semibold text-red-600 tabular-nums"><%= number_to_currency(@total_overdue) %></div>
          </div>
        <% end %>
        <% @monthly_forecast.each do |m| %>
          <div class="flex items-center gap-3">
            <div class="w-20 sm:w-24 flex-shrink-0 text-sm text-gray-700"><%= m[:month].strftime("%b %Y") %></div>
            <div class="flex-1 h-6 bg-gray-100 rounded overflow-hidden">
              <% if m[:total].positive? %>
                <div class="h-full bg-green-400 rounded" style="width: <%= [ (m[:total] / max_bar * 100).round, 2 ].max %>%"></div>
              <% end %>
            </div>
            <div class="w-24 sm:w-28 flex-shrink-0 text-right text-sm tabular-nums <%= m[:total].positive? ? 'text-gray-900 font-medium' : 'text-gray-300' %>">
              <%= m[:total].positive? ? number_to_currency(m[:total]) : "—" %>
              <% if m[:tbd_count].positive? %>
                <span class="block text-[10px] text-amber-600 font-normal"><%= pluralize(m[:tbd_count], "TBD") %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <% if @monthly_forecast.any? { |m| m[:tbd_count].positive? } %>
        <p class="text-xs text-gray-400 mt-4">TBD = revenue-share payments whose amount settles once show sales are entered — not included in the totals.</p>
      <% end %>
    </div>
  <% end %>

  <% if @production %>
    <%# ---- Single production: slim grid of its incoming payments ---------- %>
    <% if @payments.any? %>
      <%= render layout: "shared/slim_list", locals: { label: "Payment", columns: ["Due", "Amount"] } do %>
        <% @payments.each do |payment| %>
          <%= render "payment_slim_row", payment: payment %>
        <% end %>
      <% end %>
    <% elsif @total_outstanding.positive? %>
      <%= render "windowed_empty", show_all_path: window_path.call("all") %>
    <% else %>
      <%= render "empty" %>
    <% end %>
  <% else %>
    <%# ---- Org-wide: list-by filter directly above the list ---------------- %>
    <div class="mb-3">
      <%= render "shared/filters/filter_bar", bare: true, filter_groups: [
            {
              label: "List by",
              filters: [
                { text: "Due date",   path: manage_money_incoming_path(window: @window_key, group: "due_date"),   active: @group_by == "due_date" },
                { text: "Production", path: manage_money_incoming_path(window: @window_key, group: "production"), active: @group_by == "production" }
              ]
            }
          ] %>
    </div>

    <% if @group_by == "due_date" %>
      <%# One slim grid, every payment as a row, overdue/soonest due first. %>
      <% if @payments.any? %>
        <%= render layout: "shared/slim_list", locals: { label: "Payment", columns: ["Due", "Amount"] } do %>
          <% @payments.each do |payment| %>
            <%= render "payment_slim_row", payment: payment, show_production: true %>
          <% end %>
        <% end %>
      <% elsif @total_outstanding.positive? %>
        <%= render "windowed_empty", show_all_path: window_path.call("all") %>
      <% else %>
        <%= render "empty" %>
      <% end %>
    <% else %>
      <%# Grouped by production, same slim grid. %>
      <% if @production_summaries.any? %>
        <%= render layout: "shared/slim_list", locals: { label: "Production", columns: ["Outstanding", "Overdue"] } do %>
          <% @production_summaries.each do |s| %>
            <%= render "shared/slim_list_row",
                  title: s[:production].name,
                  subtitle: "#{pluralize(s[:count], 'payment')} owed",
                  expand_src: manage_money_production_incoming_payments_path(s[:production], window: @window_key),
                  expand_id: "prod-incoming-#{s[:production].id}",
                  col_labels: [ "Outstanding", "Overdue" ],
                  cells: [
                    { value: number_to_currency(s[:outstanding]) },
                    { value: s[:overdue_count].positive? ? number_to_currency(s[:overdue_amount]) : "—",
                      class: s[:overdue_count].positive? ? "text-red-600 font-medium" : "text-gray-400" }
                  ] %>
          <% end %>
        <% end %>
      <% end %>

      <% if @orphan_payments.any? %>
        <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3 mt-8">Not tied to a production</h3>
        <%= render layout: "shared/slim_list", locals: { label: "Payment", columns: ["Due", "Amount"] } do %>
          <% @orphan_payments.each do |payment| %>
            <%= render "payment_slim_row", payment: payment %>
          <% end %>
        <% end %>
      <% end %>

      <% if @production_summaries.empty? && @orphan_payments.empty? %>
        <% if @total_outstanding.positive? %>
          <%= render "windowed_empty", show_all_path: window_path.call("all") %>
        <% else %>
          <%= render "empty" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%# ---- Received — the money that already came in. The page is the record
      of this org's receivables, not just the chase list; every row still
      links to its payment page (QR, reference, how it was recorded). %>
  <% if @received_payments.any? %>
    <div class="flex items-baseline justify-between gap-3 mb-3 mt-10">
      <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">
        Received
        <span class="ml-1 text-gray-400 font-normal normal-case tracking-normal">(<%= @received_count %>)</span>
      </h3>
      <span class="text-sm text-gray-500"><%= number_to_currency(@received_total) %> collected all time</span>
    </div>
    <%= render layout: "shared/slim_list", locals: { label: "Payment", columns: [ "Paid", "Amount" ] } do %>
      <% @received_payments.each do |payment| %>
        <%= render "payment_slim_row", payment: payment, show_production: @production.nil? %>
      <% end %>
    <% end %>
    <% if @received_count > @received_payments.size %>
      <p class="text-xs text-gray-400 mt-2">Showing the <%= @received_payments.size %> most recent — the total above counts all <%= @received_count %>.</p>
    <% end %>
  <% end %>
</div>
