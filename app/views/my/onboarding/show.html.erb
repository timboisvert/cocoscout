<% content_for :title, "Welcome to #{@organization.name}" %>

<%
  acknowledged = @staff_member.acknowledged?
  bank_done = @staff_member.bank_connected?
  first_name = @staff_member.preferred_first_name.presence || @staff_member.first_name.presence || @person.name.to_s.split(" ").first
  steps_done = [ acknowledged, bank_done ].count(true)
%>

<div class="max-w-2xl mx-auto px-4 py-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%# Warm welcome header %>
  <div class="text-center mb-8">
    <div class="w-16 h-16 rounded-2xl bg-pink-100 flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 0 0 0 6.364L12 20.364l7.682-7.682a4.5 4.5 0 0 0-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 0 0-6.364 0Z"/></svg>
    </div>
    <h1 class="text-3xl coustard-regular text-gray-900">Welcome to the team<%= ", #{first_name}" if first_name.present? %>!</h1>
    <p class="text-gray-600 mt-2 max-w-lg mx-auto">
      <span class="font-medium text-gray-900"><%= @organization.name %></span> has added you to their staff.
      Here are a couple of quick things to get you set up and ready to be paid.
    </p>
  </div>

  <%# Progress %>
  <div class="flex items-center justify-center gap-2 mb-8 text-sm text-gray-500">
    <span class="font-semibold text-gray-900"><%= steps_done %></span> of 2 essentials done
  </div>

  <div class="space-y-4">
    <%# Step 1 — accept %>
    <div class="bg-white border <%= acknowledged ? "border-green-200" : "border-gray-200" %> rounded-lg p-5">
      <div class="flex items-start gap-4">
        <%= render "my/onboarding/step_marker", done: acknowledged, number: 1 %>
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold text-gray-900">Accept your spot on the team</h3>
          <p class="text-sm text-gray-600 mt-1">Let <%= @organization.name %> know you're on board.</p>
          <% if acknowledged %>
            <p class="text-sm text-green-700 font-medium mt-2">You're in — thanks!</p>
          <% else %>
            <div class="mt-3">
              <%= button_to my_acknowledge_onboarding_path(@organization.id), method: :post, class: "inline-block" do %>
                <%= render "shared/button", text: "I'm in", variant: "primary", size: "medium", type: :button %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Step 2 — get paid %>
    <div class="bg-white border <%= bank_done ? "border-green-200" : "border-gray-200" %> rounded-lg p-5">
      <div class="flex items-start gap-4">
        <%= render "my/onboarding/step_marker", done: bank_done, number: 2 %>
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold text-gray-900">Set up how you get paid</h3>
          <p class="text-sm text-gray-600 mt-1">Add your legal name and connect your bank so payments land automatically.</p>
          <div class="mt-3">
            <%= link_to my_payments_setup_path do %>
              <%= render "shared/button",
                    text: bank_done ? "Review payment details" : "Set up payments",
                    variant: bank_done ? "secondary" : "primary", size: "medium", type: :button %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# Step 3 — availability (encouraged, not a hard gate) %>
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <div class="flex items-start gap-4">
        <div class="w-8 h-8 rounded-full bg-pink-100 text-pink-600 flex items-center justify-center flex-shrink-0 text-sm font-semibold">3</div>
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold text-gray-900">Add your availability</h3>
          <p class="text-sm text-gray-600 mt-1">Tell them when you can work over the next couple of weeks so they can schedule you.</p>
          <div class="mt-3">
            <%= link_to my_requests_path do %>
              <%= render "shared/button", text: "Set your availability", variant: "secondary", size: "medium", type: :button %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if acknowledged && bank_done %>
    <div class="mt-8 rounded-lg bg-green-50 border border-green-200 p-5 text-center">
      <p class="text-sm font-medium text-green-800">You're all set — <%= @organization.name %> can now schedule and pay you. 🎉</p>
    </div>
  <% end %>
</div>
