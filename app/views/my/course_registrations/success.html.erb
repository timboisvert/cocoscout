<%# The receipt: you're registered, every session, what you paid, the
    calendar file, directions, and the email again. Rendered by success. %>
<%
  offering = @course_offering
  registration = @registration
  sessions = offering.sessions.includes(:location, :location_space).to_a
  first = sessions.find { |s| s.date_and_time >= Time.current } || sessions.first
  venue = first && [ first.location&.name, first.location_space&.name ].compact.uniq.join(" · ")
  location = sessions.map(&:location).compact.first
  address = location && [ location.address1, location.city, location.state ].compact_blank.join(", ")
  map_url = address.present? ? "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode([ location.name, address ].compact.join(', '))}" : nil
%>
<% content_for :title, "You're registered · #{offering.title}" %>

<div class="mx-auto max-w-xl space-y-5">
  <div class="text-center space-y-1.5">
    <h1 class="text-3xl sm:text-4xl coustard-regular text-gray-900">You're registered</h1>
    <p class="text-base text-gray-700"><%= offering.title %> · <%= @production.organization.name %></p>
    <% if offering.success_text.present? %>
      <div class="text-sm text-gray-600 space-y-2"><%= simple_format(offering.success_text) %></div>
    <% else %>
      <p class="text-sm text-gray-600">A confirmation with everything below is on its way to <%= registration.person&.email.presence || Current.user.email_address %>.</p>
    <% end %>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <% if first %>
      <div class="px-5 py-4 text-center">
        <p class="text-base text-gray-800">
          <%= sessions.size > 1 ? "Starts " : "" %><%= first.date_and_time.strftime("%A, %B %-d") %> · <%= course_session_time(first) %>
          <% if sessions.size > 1 %><span class="text-gray-600">· <%= pluralize(sessions.size, "session") %></span><% end %>
        </p>
        <% if first.is_online %>
          <p class="text-sm text-gray-600">Online</p>
        <% elsif venue.present? %>
          <p class="text-sm text-gray-600"><%= venue %><% if address.present? %> · <%= address %><% end %></p>
        <% end %>
        <div class="mt-3 flex flex-wrap justify-center gap-2">
          <%= render "shared/button", text: "Add to calendar", variant: "outline-pink", size: "small",
                path: my_course_calendar_path(code: offering.short_code, token: registration.token) %>
          <% if map_url %>
            <%= render "shared/button", text: "Directions", variant: "outline-pink", size: "small", path: map_url, target: "_blank" %>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if sessions.size > 1 %>
      <ul class="border-t border-gray-100 divide-y divide-gray-100">
        <% sessions.each do |session| %>
          <li class="flex items-baseline justify-between gap-3 px-5 py-2.5 text-sm">
            <span class="text-gray-900"><%= session.date_and_time.strftime("%a, %b %-d") %><% if session.name_subtitle.present? %> <span class="text-gray-500">· <%= session.name_subtitle %></span><% end %></span>
            <span class="text-gray-600 tabular-nums flex-shrink-0"><%= course_session_time(session) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <% if registration.total_cents.positive? %>
    <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="px-5 pt-4 font-semibold text-gray-900">What you paid</div>
      <%= render "shared/checkout/summary", lines: course_registration_lines(registration), total_cents: registration.total_cents %>
      <div class="border-t border-gray-100 bg-gray-50 px-5 py-2.5 text-xs text-gray-500">
        Paid <%= registration.paid_at&.strftime("%B %-d, %Y") %> · sold by <%= @production.organization.name %>, payment processed by CocoScout
      </div>
    </div>
  <% end %>

  <div class="flex flex-wrap justify-center gap-2">
    <%= render "shared/button", text: "Your courses", variant: "primary", size: "medium", path: my_courses_path %>
    <%= form_with url: my_course_resend_path(code: offering.short_code, token: registration.token), method: :post do %>
      <%= render "shared/button", text: "Email this again", variant: "secondary", size: "medium", type: :submit %>
    <% end %>
  </div>
</div>
