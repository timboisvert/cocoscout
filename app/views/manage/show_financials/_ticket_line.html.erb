<%#
  One row of the ticket-sales grid on the financials worksheet: a ticket
  source (named in Money settings), how many it sold, and for how much. The
  source is fixed by the row — there's no picker; every source gets its own
  row. Leaving both blank means that source sold nothing (a saved row left
  blank is removed on save, see ShowFinancialsController).

  Locals:
    line       the fields_for builder for this ticket_sales_lines row
    label      what the row is called ("Ticket Tailor", "Other", "Tickets")
    line_input shared input class string
    persisted  whether this row already exists (only those carry an id)
%>
<div class="grid grid-cols-[minmax(0,1fr)_6rem_8rem] sm:grid-cols-[minmax(0,1fr)_7rem_9rem] items-center gap-2 px-3 py-2" data-ticket-line>
  <% if persisted %>
    <%= line.hidden_field :id %>
  <% end %>
  <%= line.hidden_field :ticket_source_id %>

  <span class="min-w-0 truncate text-sm font-medium text-gray-900"><%= label %></span>

  <%# Blank rather than 0 / 0.0 when a source sold nothing, so the placeholder
      shows; money always to the cent. %>
  <% tickets = line.object.tickets_sold.to_i %>
  <% amount = line.object.amount.to_f %>
  <%= line.number_field :tickets_sold, value: (tickets.positive? ? tickets : nil), min: 0, placeholder: "0", "aria-label": "#{label} tickets",
        class: "#{line_input} tabular-nums text-right",
        data: { action: "input->financials-form#recalcTicketTotal", financials_form_target: "ticketCount" } %>

  <div class="relative">
    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm pointer-events-none">$</span>
    <%= line.number_field :amount, value: (amount.positive? ? format("%.2f", amount) : nil), min: 0, step: 0.01, placeholder: "0.00", "aria-label": "#{label} amount",
          class: "#{line_input} pl-7 tabular-nums text-right",
          data: { action: "input->financials-form#recalcTicketTotal", financials_form_target: "ticketAmount" } %>
  </div>
</div>
