<%#
  The organization menu (the band's ▾ on desktop, the phone's organization
  sheet), rethought 2026-10-21 (Tim): it opens from the band that says
  you're in production mode, so it answers, in order, where you are (the
  organization, your role, its plan), how you leave (Exit production mode,
  the CocoScout-pink bar), where else you could be (the other organizations,
  one tap each), and this organization's own pages (its settings, plan and
  billing, productions). New organization sits last, quiet.
%>
<% org = Current.organization %>
<% organizations = Current.user.accessible_organizations.order(:name).to_a %>
<% roles = OrganizationRole.where(user: Current.user, organization_id: organizations.map(&:id)).pluck(:organization_id, :company_role).to_h %>
<% role_words = ->(o) { o.owner_id == Current.user.id ? "Owner" : roles[o.id].to_s.humanize.presence || "Team" } %>
<% plan_words = ->(o) { o.on_paid_plan? ? "Pro" : "Producer plan" } %>
<% item = "flex items-center gap-3 px-3.5 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors" %>
<% label = "px-3.5 pt-3 pb-1 text-[10px] font-semibold uppercase tracking-wider text-gray-500" %>

<%# Where you are %>
<div class="px-3.5 py-3 flex items-center gap-3 bg-gray-50" data-organization-menu-current>
  <%= render "shared/navigation/organization_monogram", organization: org, size: 36 %>
  <span class="min-w-0 flex-1">
    <span class="block text-sm font-bold text-gray-900 truncate"><%= org.name %></span>
    <span class="block text-xs text-gray-500"><%= role_words.call(org) %> · <%= plan_words.call(org) %></span>
  </span>
</div>

<%# The way out: the same pink bar as the account menu had (Tim, 2026-10-21: it belongs where you see you're in production mode). %>
<% if (switch = panel_mode_switch(production_mode: true)) %>
  <%= render "shared/navigation/mode_switch", switch: switch, size: :menu %>
<% end %>

<%# Where else you could be %>
<% others = organizations.reject { |o| o.id == org.id } %>
<% if others.any? %>
  <div class="<%= label %> border-t border-gray-100">Switch to</div>
  <% others.each do |o| %>
    <%= form_with url: set_organization_path, method: :post, data: { turbo: false } do %>
      <%= hidden_field_tag :id, o.id, id: nil %>
      <button type="submit" role="menuitem" class="w-full flex items-center gap-3 px-3.5 py-2.5 text-left cursor-pointer hover:bg-gray-50 transition-colors">
        <%= render "shared/navigation/organization_monogram", organization: o, size: 32 %>
        <span class="min-w-0 flex-1">
          <span class="block text-sm font-semibold text-gray-900 truncate"><%= o.name %></span>
          <span class="block text-xs text-gray-500"><%= role_words.call(o) %> · <%= plan_words.call(o) %></span>
        </span>
        <svg class="w-4 h-4 text-gray-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    <% end %>
  <% end %>
<% end %>

<%# This organization's own pages %>
<div class="<%= label %> border-t border-gray-100">This organization</div>
<% if current_user_is_global_manager? %>
  <%= link_to "Organization settings", manage_organization_path(org), class: item, role: "menuitem" %>
<% end %>
<% if Current.user.superadmin? || org.manageable_by?(Current.user) %>
  <%= link_to "Plan and billing", section_manage_organization_path(org, section: "billing"), class: item, role: "menuitem" %>
<% end %>
<% if org.on_paid_plan? %>
  <%= link_to "Productions", manage_productions_path, class: item, role: "menuitem" %>
<% elsif (production = Current.user.accessible_productions.where(organization: org).order(:name).first) %>
  <%= link_to "#{production.name} settings", edit_manage_production_path(production), class: item, role: "menuitem" %>
<% end %>
<% if current_user_is_global_manager? %>
  <% if org.at_production_limit? %>
    <span class="<%= item %> text-gray-400 cursor-default" role="menuitem" aria-disabled="true">Add a production <%= render "shared/pro_marker", kind: :lock, classes: "ml-auto" %></span>
  <% else %>
    <%= link_to "Add a production", manage_productions_wizard_path, class: item, role: "menuitem" %>
  <% end %>
<% end %>

<div class="border-t border-gray-100"></div>
<%= link_to "New organization", new_manage_organization_path, class: "#{item} text-gray-500", role: "menuitem" %>
