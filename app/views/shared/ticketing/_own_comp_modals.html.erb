<%# Edit and Remove for the comps someone issued themselves, opened from the
    dot menu on their rows on the guest list (shared/ticketing/guest_list, own_ids). The giver
    changes the guest's name and email, or takes the comp back, until the
    show starts (TicketComps.theirs?).
    Locals: orders (the comps, TicketOrder with tickets loaded),
    comp_url (a lambda: order to its PATCH and DELETE address, by the
    order's id: an order's own address is its buyer's token). %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  label_class = "block text-sm font-medium text-gray-700 mb-1.5"
%>
<% orders.each do |order| %>
  <%
    url = comp_url.call(order)
    name = order.buyer_name.presence || "this guest"
    count = order.tickets.count { |t| Ticket::SOLD_STATUSES.include?(t.status) }
    tickets = pluralize(count, "ticket")
  %>
  <div id="edit-comp-<%= order.id %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center sm:p-4"
       data-controller="modal" data-action="click->modal#closeOnBackdrop">
    <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full sm:max-w-md sm:mx-4 overflow-hidden pb-[env(safe-area-inset-bottom)] sm:pb-0" data-action="click->modal#stopPropagation">
      <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
        <h3 class="text-lg font-semibold text-white">Edit this comp</h3>
        <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" aria-label="Close">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <%= form_with url: url, method: :patch, data: { turbo: false } do %>
        <div class="p-6 space-y-5">
          <p class="text-sm text-gray-600">You issued <%= tickets %> to <%= name %>. You can change who <%= count == 1 ? "it is" : "they are" %> for until the show starts. To change how many, remove this comp and issue a new one.</p>
          <div>
            <label for="edit_comp_name_<%= order.id %>" class="<%= label_class %>">Name</label>
            <%= text_field_tag :name, order.buyer_name, id: "edit_comp_name_#{order.id}", required: true, autocomplete: "off", class: input_class %>
          </div>
          <div>
            <label for="edit_comp_email_<%= order.id %>" class="<%= label_class %>">Their email <span class="font-normal text-gray-500">(optional)</span></label>
            <%= email_field_tag :email, order.buyer_email, id: "edit_comp_email_#{order.id}", placeholder: "their@email.com", autocomplete: "off", class: input_class %>
          </div>
          <label class="flex items-start gap-3 cursor-pointer">
            <%= check_box_tag :send_tickets, "1", false, id: "edit_comp_send_#{order.id}", class: "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
            <span class="text-sm text-gray-700">Email the tickets to this address when I save.</span>
          </label>
        </div>
        <div class="flex justify-end gap-2 px-6 py-4 border-t border-gray-200 bg-gray-50">
          <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
          <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "shared/confirm_modal", id: "remove-comp-#{order.id}",
        title: "Remove this comp?",
        message: "#{name.upcase_first} will lose #{count == 1 ? 'the ticket' : "the #{tickets}"} you issued them. #{count == 1 ? 'The ticket stops' : 'The tickets stop'} working at the door, and #{count == 1 ? 'the seat is' : 'the seats are'} free again.#{' They will be notified by email.' if order.buyer_email.present?} This can't be undone, but you can issue them a new comp.",
        confirm_text: "Remove", url: url, method: :delete %>
<% end %>
