<%#
  Recurring series modal. Header says what the series is; a tab strip right
  under it holds the three things you can do — look at the events, extend the
  run, or change the schedule from a date onward — so the actions never sink
  below a long list of dates.

  Extend keeps the rhythm and only moves the end. Change schedule replaces
  every event from a chosen date with a fresh run (new first event, pattern,
  end); events before that date are untouched.
%>
<%
  pattern_phrase = series_pattern_phrase(@pattern, @first_show)
  first_upcoming = @upcoming_shows.first
  input_cls = "w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-500"
  tab_cls = ->(active) { "px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors cursor-pointer whitespace-nowrap #{active ? 'border-pink-500 text-pink-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}" }
%>
<%= turbo_frame_tag "recurring_series_modal" do %>
  <div class="fixed inset-0 bg-black/60 backdrop-blur-sm overflow-y-auto h-full w-full z-50 flex items-center justify-center p-4"
       data-controller="recurring-series-modal"
       data-recurring-series-modal-preview-url-value="<%= preview_extend_series_manage_production_shows_path(@production) %>"
       data-recurring-series-modal-preview-reschedule-url-value="<%= preview_reschedule_manage_production_shows_path(@production) %>"
       data-action="click->recurring-series-modal#closeOnBackdrop keydown.esc@window->recurring-series-modal#close">
    <div class="relative w-full max-w-2xl bg-white rounded-xl shadow-2xl max-h-[85vh] flex flex-col overflow-hidden" data-action="click->recurring-series-modal#stopPropagation">
      <%# Header — the pink standard %>
      <div class="flex items-start justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4 flex-shrink-0">
        <div class="min-w-0">
          <h3 class="text-lg font-semibold text-white">Recurring Series</h3>
          <p class="text-sm text-pink-100 mt-0.5 truncate">
            <%= pattern_phrase %> at <%= @first_show.date_and_time.strftime("%-I:%M %p") %>
            · <%= @first_show.is_online ? "Online" : (@first_show.location&.name || "Location TBD") %>
          </p>
        </div>
        <button type="button" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 cursor-pointer flex-shrink-0" data-action="click->recurring-series-modal#close">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <%# At-a-glance: how many, first, last %>
      <div class="px-6 py-3 border-b border-gray-200 bg-gray-50 flex-shrink-0">
        <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
          <div><span class="text-gray-500">Events</span> <span class="font-medium text-gray-900 ml-1"><%= @shows_in_series.length %></span><% if @upcoming_shows.any? %> <span class="text-gray-400">(<%= @upcoming_shows.length %> upcoming)</span><% end %></div>
          <div><span class="text-gray-500">First</span> <span class="font-medium text-gray-900 ml-1"><%= @first_show.date_and_time.strftime("%b %-d, %Y") %></span></div>
          <div><span class="text-gray-500">Last</span> <span class="font-medium text-gray-900 ml-1"><%= @last_show.date_and_time.strftime("%b %-d, %Y") %></span></div>
        </div>
      </div>

      <%# Tabs — always visible, whatever the list length %>
      <div class="px-6 border-b border-gray-200 flex-shrink-0 overflow-x-auto">
        <div class="flex items-end gap-1" role="tablist">
          <button type="button" role="tab" data-recurring-series-modal-target="tab" data-recurring-series-modal-tab-param="events"
                  data-action="click->recurring-series-modal#showTab" class="<%= tab_cls.call(true) %>">Events</button>
          <button type="button" role="tab" data-recurring-series-modal-target="tab" data-recurring-series-modal-tab-param="extend"
                  data-action="click->recurring-series-modal#showTab" class="<%= tab_cls.call(false) %>">Extend</button>
          <button type="button" role="tab" data-recurring-series-modal-target="tab" data-recurring-series-modal-tab-param="reschedule"
                  data-action="click->recurring-series-modal#showTab" class="<%= tab_cls.call(false) %>">Change schedule</button>
        </div>
      </div>

      <%# Body — scrollable %>
      <div class="flex-1 overflow-y-auto p-6">

        <%# ---- Events ---- %>
        <div data-recurring-series-modal-target="panel" data-panel="events">
          <% if @upcoming_shows.any? %>
            <div class="mb-6">
              <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Upcoming (<%= @upcoming_shows.length %>)</h4>
              <div class="space-y-1 border border-gray-200 rounded-lg">
                <% @upcoming_shows.each do |show| %>
                  <%= render partial: "shared/show_row", locals: {
                    show: show,
                    link_path: manage_show_path(@production, show),
                    show_canceled: true,
                    show_recurring: false,
                    show_linked: false,
                    show_location: false
                  } %>
                <% end %>
              </div>
            </div>
          <% else %>
            <p class="text-sm text-gray-500 mb-6">No upcoming events — every date in this series has passed. Extend it to add more.</p>
          <% end %>

          <% if @past_shows.any? %>
            <details>
              <summary class="text-xs font-semibold text-gray-500 uppercase tracking-wide cursor-pointer hover:text-gray-700">Past (<%= @past_shows.length %>)</summary>
              <div class="mt-2 space-y-1 border border-gray-200 rounded-lg opacity-60">
                <% @past_shows.each do |show| %>
                  <%= render partial: "shared/show_row", locals: {
                    show: show,
                    link_path: manage_show_path(@production, show),
                    show_canceled: true,
                    show_recurring: false,
                    show_linked: false,
                    show_location: false
                  } %>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>

        <%# ---- Extend ---- %>
        <div data-recurring-series-modal-target="panel" data-panel="extend" class="hidden">
          <p class="text-sm text-gray-700 mb-4">
            Adds more events after <strong><%= @last_show.date_and_time.strftime("%B %-d, %Y") %></strong>, keeping the same schedule —
            <strong><%= pattern_phrase.downcase %> at <%= @last_show.date_and_time.strftime("%-I:%M %p") %></strong>. Nothing already on the calendar changes.
          </p>

          <form id="extend-preview-form" data-recurring-series-modal-target="extendForm" data-action="submit->recurring-series-modal#previewExtend">
            <input type="hidden" name="recurrence_group_id" value="<%= @recurrence_group_id %>">
            <div class="sm:w-72">
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Extend until</label>
              <input type="date"
                     name="extend_until" required
                     min="<%= (@last_show.date_and_time.to_date + 1.day).to_s %>"
                     value="<%= (@last_show.date_and_time.to_date + 1.month).to_s %>"
                     data-action="change->recurring-series-modal#extendDateChanged"
                     class="<%= input_cls %>">
              <p class="text-xs text-gray-500 mt-1.5">The last date a new event can fall on.</p>
            </div>
            <div class="flex justify-end pt-4">
              <%= render "shared/button", text: "Preview new dates", variant: "primary", type: :submit, data: { "recurring-series-modal-target": "previewButton" } %>
            </div>
          </form>

          <p data-recurring-series-modal-target="previewError" class="hidden text-sm text-red-600 mt-2"></p>

          <div data-recurring-series-modal-target="previewContainer" class="hidden">
            <p class="text-sm text-gray-700 mb-3">
              <strong data-recurring-series-modal-target="previewCount"></strong> will be added, through <strong data-recurring-series-modal-target="previewThrough"></strong>:
            </p>
            <div class="max-h-64 overflow-y-auto border border-gray-200 rounded-lg bg-white">
              <ul data-recurring-series-modal-target="previewList" class="divide-y divide-gray-100"></ul>
            </div>
            <div class="flex items-center justify-between pt-4">
              <button type="button" class="text-sm text-gray-500 hover:text-gray-700 cursor-pointer" data-action="click->recurring-series-modal#backToOptions">← Change the date</button>
              <%= form_with url: extend_series_manage_production_shows_path(@production), method: :post, local: true, data: { "recurring-series-modal-target": "confirmForm" } do %>
                <%= render "shared/button", text: "Add these events", variant: "primary", type: :submit %>
              <% end %>
            </div>
          </div>
        </div>

        <%# ---- Change schedule ---- %>
        <div data-recurring-series-modal-target="panel" data-panel="reschedule" class="hidden">
          <p class="text-sm text-gray-700 mb-4">
            Pick the first event on the new schedule. Every event <strong>on or after that date</strong> is replaced by the new run;
            events before it stay exactly as they are. Use this to move the series to a different day or time, change how often it repeats, or both.
          </p>

          <form data-recurring-series-modal-target="rescheduleForm" data-action="submit->recurring-series-modal#previewReschedule">
            <input type="hidden" name="recurrence_group_id" value="<%= @recurrence_group_id %>">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">First event on the new schedule</label>
                <input type="datetime-local" name="reschedule_from" required
                       min="<%= Date.current.strftime('%Y-%m-%dT00:00') %>"
                       value="<%= (first_upcoming || @last_show).date_and_time.strftime('%Y-%m-%dT%H:%M') %>"
                       data-recurring-series-modal-target="rescheduleFrom"
                       data-action="change->recurring-series-modal#rescheduleChanged change->recurring-series-modal#relabelPatterns"
                       class="<%= input_cls %>">
                <p class="text-xs text-gray-500 mt-1.5">Its weekday and time set the rhythm from here on.</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Repeats</label>
                <%# Option labels are rewritten client-side from the first-event date:
                    "Weekly on Saturdays", "Monthly on the 17th", "Monthly on the third Saturday". %>
                <select name="new_pattern" required data-recurring-series-modal-target="patternSelect"
                        data-action="change->recurring-series-modal#rescheduleChanged" class="<%= input_cls %>">
                  <% Manage::ShowsHelper::RECURRENCE_PATTERNS.each do |label, value| %>
                    <option value="<%= value %>" <%= "selected" if @pattern == value %>><%= label %></option>
                  <% end %>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Until</label>
                <input type="date" name="reschedule_until" required
                       value="<%= @last_show.date_and_time.to_date.to_s %>"
                       min="<%= Date.current.to_s %>"
                       data-action="change->recurring-series-modal#rescheduleChanged"
                       class="<%= input_cls %>">
                <p class="text-xs text-gray-500 mt-1.5">Currently <%= @last_show.date_and_time.strftime("%B %-d, %Y") %>. Move it to run longer or shorter.</p>
              </div>
            </div>
            <div class="flex justify-end pt-4">
              <%= render "shared/button", text: "Preview changes", variant: "primary", type: :submit, data: { "recurring-series-modal-target": "reschedulePreviewButton" } %>
            </div>
          </form>

          <p data-recurring-series-modal-target="rescheduleError" class="hidden text-sm text-red-600 mt-2"></p>

          <div data-recurring-series-modal-target="reschedulePreviewContainer" class="hidden">
            <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 mb-3">
              <span data-recurring-series-modal-target="rescheduleRemoving"></span> from
              <strong data-recurring-series-modal-target="rescheduleFromLabel"></strong> onward will be removed
              <span data-recurring-series-modal-target="rescheduleKeeping"></span>
              and replaced with <strong data-recurring-series-modal-target="rescheduleAdding"></strong> —
              <span data-recurring-series-modal-target="reschedulePattern"></span> at <span data-recurring-series-modal-target="rescheduleTime"></span>,
              through <span data-recurring-series-modal-target="rescheduleUntil"></span>.
              Cast assignments and per-event edits on the removed events are lost.
            </div>
            <div class="max-h-64 overflow-y-auto border border-gray-200 rounded-lg bg-white">
              <ul data-recurring-series-modal-target="rescheduleList" class="divide-y divide-gray-100"></ul>
            </div>
            <div class="flex items-center justify-between pt-4">
              <button type="button" class="text-sm text-gray-500 hover:text-gray-700 cursor-pointer" data-action="click->recurring-series-modal#backToRescheduleOptions">← Change options</button>
              <% reschedule_cid = "confirm-reschedule-series" %>
              <%= render "shared/button", text: "Change schedule", variant: "primary", type: :button,
                    data: { controller: "modal", action: "click->modal#open", modal_id: reschedule_cid } %>
              <%= render "shared/confirm_modal", id: reschedule_cid, title: "Change the schedule?",
                    message: "The events from the chosen date onward will be deleted and replaced with the new run. Cast assignments and per-event edits on them are lost. Earlier events aren't touched.",
                    confirm_text: "Change schedule",
                    url: reschedule_future_manage_production_shows_path(@production), method: :post,
                    form_data: { "recurring-series-modal-target": "rescheduleConfirmForm" } %>
            </div>
          </div>
        </div>
      </div>

      <%# Footer %>
      <div class="px-6 py-3 border-t border-gray-200 bg-gray-50 flex justify-end flex-shrink-0">
        <%= render "shared/button", text: "Done", variant: "secondary", type: :button, data: { action: "click->recurring-series-modal#close" } %>
      </div>
    </div>
  </div>
<% end %>
