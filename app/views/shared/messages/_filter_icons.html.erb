<%#
  The inbox's icon control in the shared filter bar, a round pink button
  (Tim, 2026-10-21): newest or oldest first. Its arrow shows the way the
  list runs now (down = newest first, up = oldest first); a tap flips it.
  Locals: newest_path, oldest_path, current_order.
%>
<% oldest = current_order.to_s == "oldest" %>
<div class="flex items-center gap-2" data-inbox-icons>
  <%= link_to (oldest ? newest_path : oldest_path),
        class: "inline-flex items-center justify-center w-8 h-8 rounded-full bg-pink-500 hover:bg-pink-600 text-white transition cursor-pointer",
        title: (oldest ? "Oldest first. Show newest first" : "Newest first. Show oldest first"),
        aria: { label: (oldest ? "Oldest first" : "Newest first") }, data: { turbo_prefetch: false, turbo_action: "replace", inbox_order: (oldest ? "oldest" : "newest") } do %>
    <% if oldest %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5M5 12l7-7 7 7"/></svg>
    <% else %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12l7 7 7-7"/></svg>
    <% end %>
  <% end %>
</div>
