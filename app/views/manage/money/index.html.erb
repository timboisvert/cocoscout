<% content_for :title, "Money" %>

<%
  money_description = <<~HTML
    <p>
      This is your organization's financial hub — the central place to track revenue, manage payouts,
      and understand your show economics across all productions.
    </p>
  HTML

  # Financials, Payouts and Incoming are things to do; Books is what happened,
  # in dollars. Each card shows only to someone whose access opens it.
  # Books starts with its categories: until a manager has set them up, the card goes there.
  books_setup_needed = Current.organization.books_categories_set_up_at.nil? && OrganizationAccess.allows?(Current.user, Current.organization, :books, :manage)
  money_actions = [
    (module_access?(:settle_up) ? { icon: "chart-bar", text: "Settle up", description: "Each day, checked off: shows, door cash, expenses", path: manage_money_settle_up_path } : nil),
    (module_access?(:payouts) ? { icon: "dollar-sign", text: "Payouts", description: "Calculate and distribute payments", path: manage_money_payouts_path } : nil),
    (module_access?(:bills_invoices) ? { icon: "banknotes", text: "Incoming Payments", description: "Track and collect money owed to you", path: manage_money_incoming_path } : nil),
    (module_access?(:bills_invoices) ? { icon: "file", text: "Bills", description: "What you owe and have not paid yet", path: manage_money_bills_path } : nil),
    (module_access?(:books) ? (books_setup_needed ? { icon: "book", text: "Books", description: "Start by setting up your categories", path: manage_money_books_setup_path } : { icon: "book", text: "Books", description: "All your money, and every dollar in and out", path: manage_money_books_path }) : nil),
    (module_access?(:money_settings) ? { icon: "cog", text: "Settings", description: "How you pay people", path: manage_money_settings_path } : nil)
  ].compact

  payout_columns = @todo.payouts.columns.map { |c| Manage::MoneyPayoutsHelper::AWAITING_PAYOUT_COLUMNS[c][:label] }

  # Lead with what's late, since that's the part that needs a phone call.
  incoming = @todo.incoming
  incoming_subtitle = if incoming.overdue_count.positive?
    "#{number_to_currency(incoming.overdue_amount)} overdue of #{number_to_currency(incoming.amount)}"
  else
    "#{number_to_currency(incoming.amount)} due"
  end
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render "shared/module_header",
    title: "Money",
    description: money_description,
    actions: money_actions
  %>

  <div class="mt-4 mb-8">
    <%= render "shared/money_summary",
      title: "Money",
      money_in: @org_summary[:gross_revenue],
      money_out: @org_summary[:cost_of_shows],
      profit: @org_summary[:gross_profit],
      selected_period: @selected_period,
      period_path: manage_money_index_path,
      refresh_url: manage_refresh_money_path(period: @selected_period) %>
  </div>

  <%# The to-do strip (plan §9.2): the same list as the Money line on Home.
      Days to settle first, then money going out, then money coming in. %>
  <% if @todo.settle_days.any? %>
    <% oldest = @todo.settle_days.items.first %>
    <%= render "shared/alert_panel",
          eyebrow: "Settle up",
          headline: "#{pluralize(@todo.settle_days.count, 'day')} to settle up",
          body: "Oldest is #{oldest.date.strftime('%A, %b %-d')}: #{oldest.pieces.map(&:first).to_sentence}.",
          actions: [ { text: "Settle up", path: manage_money_settle_up_day_path(oldest.param) } ] %>
  <% end %>
  <% if @todo.payouts.any? && @todo.payouts.due_soon_amount.to_f > 0.004 %>
    <%= render "shared/alert_panel", tone: :amber,
          eyebrow: "To pay",
          headline: "#{number_to_currency(@todo.payouts.due_soon_amount)} due now",
          body: "#{number_to_currency(@todo.payouts.amount)} unpaid in all, across #{pluralize(@todo.payouts.count, 'production, course or contract')}.",
          actions: [ { text: "Payouts", path: manage_money_payouts_path } ] %>
  <% end %>
  <% if @todo.bills.overdue_count.to_i.positive? %>
    <%= render "shared/alert_panel",
          eyebrow: "Bills",
          headline: "#{number_to_currency(@todo.bills.overdue_amount)} in bills past due",
          body: "#{pluralize(@todo.bills.overdue_count, 'bill')} due before today. Mark each paid once the money goes out.",
          actions: [ { text: "Bills", path: manage_money_bills_path } ] %>
  <% end %>
  <% if @todo.incoming.overdue_count.to_i.positive? %>
    <%= render "shared/alert_panel",
          eyebrow: "Overdue to you",
          headline: "#{number_to_currency(@todo.incoming.overdue_amount)} overdue",
          body: "#{pluralize(@todo.incoming.overdue_count, 'payment')} past due. A reminder from the Incoming Payments page usually does it.",
          actions: [ { text: "Incoming Payments", path: manage_money_incoming_path(window: "1m") } ] %>
  <% end %>

  <%# What needs doing, in the order it costs you: numbers you owe yourself,
      money you owe other people, money other people owe you. Each section is a
      window onto its own page and links there for the rest. %>

  <%= render layout: "manage/money/todo_section",
        locals: { title: "Days to settle", section: @todo.settle_days, label: "Day",
                  columns: [ "Pieces", "So far" ], min_width: "min-w-[420px]",
                  path: manage_money_settle_up_path, link_text: "Settle up",
                  empty: "Every day is settled." } do %>
    <% @todo.settle_days.items.each do |day| %>
      <%= link_to manage_money_settle_up_day_path(day.param), class: "grid grid-cols-[1fr_auto_auto] gap-3 items-center px-4 py-2.5 text-sm hover:bg-gray-50" do %>
        <span class="min-w-0"><span class="block font-medium text-gray-900"><%= day.date.strftime("%a, %b %-d") %></span><span class="block text-xs text-gray-500 truncate"><%= day.shows.map { |s| s.show.display_name }.to_sentence %></span></span>
        <span class="flex flex-wrap gap-1 justify-end">
          <% day.pieces.each do |label, state| %>
            <% dot = { ok: "bg-green-500", wait: "bg-amber-500", miss: "bg-red-500" }.fetch(state) %>
            <span class="inline-block w-2 h-2 rounded-full <%= dot %>" title="<%= label %>"></span>
          <% end %>
        </span>
        <span class="tabular-nums text-gray-900"><%= number_to_currency(day.in_cents / 100.0) %></span>
      <% end %>
    <% end %>
  <% end %>

  <% if @todo.courses.any? %>
    <%= render layout: "manage/money/todo_section",
          locals: { title: "Courses to settle", section: @todo.courses, label: "Course",
                    path: manage_money_all_financials_path(type: "courses"), link_text: "All courses",
                    empty: "" } do %>
      <%= render "manage/money_financials/financials_show_rows", rows: @todo.courses.items %>
    <% end %>
  <% end %>

  <%= render layout: "manage/money/todo_section",
        locals: { title: "To pay", section: @todo.payouts, label: "To pay",
                  columns: payout_columns, min_width: "min-w-[360px]",
                  subtitle: "#{number_to_currency(@todo.payouts.amount)} still unpaid",
                  path: manage_money_payouts_path, link_text: "Payouts",
                  empty: "Nothing waiting to be paid." } do %>
    <%# Same partial the Payouts page renders, so the rows can't differ. The
        totals row sums the whole set even though only the first few show. %>
    <%= render "manage/money_payouts/awaiting_payout_rows",
          items: @todo.payouts.items, columns: @todo.payouts.columns %>
  <% end %>

  <%= render layout: "manage/money/todo_section",
        locals: { title: "Bills due", section: @todo.bills, label: "Bill",
                  columns: [ "Due", "Amount" ], min_width: "min-w-[420px]",
                  subtitle: "#{number_to_currency(@todo.bills.amount)} to pay in the next 30 days",
                  path: manage_money_bills_path, link_text: "Bills",
                  empty: "No bills due in the next 30 days." } do %>
    <% @todo.bills.items.each do |bill| %>
      <%= render "shared/slim_list_row",
            title: bill.vendor_name, subtitle: [ bill.production&.name, bill.memo.presence || bill.category_label ].compact.join(" · "),
            badge: (bill.overdue? ? { text: "Overdue", color: "red" } : nil),
            href: manage_money_bill_path(bill), col_labels: [ "Due", "Amount" ],
            cells: [ { value: bill.due_on.strftime("%b %-d, %Y"), class: bill.overdue? ? "text-red-600 font-medium" : "text-gray-700" },
                     { value: number_to_currency(bill.unpaid_cents / 100.0), class: "text-gray-900 font-semibold" } ] %>
    <% end %>
  <% end %>

  <%= render layout: "manage/money/todo_section",
        locals: { title: "Owed to you", section: @todo.incoming, label: "Payer",
                  columns: [ "Due", "Amount" ], min_width: "min-w-[420px]",
                  subtitle: incoming_subtitle,
                  # The window param is what makes this count match the page it
                  # lands on — Incoming defaults to three months, the hub to 30 days.
                  path: manage_money_incoming_path(window: "1m"), link_text: "Incoming Payments",
                  empty: "Nothing owed to you in the next 30 days." } do %>
    <% @todo.incoming.items.each do |item| %>
      <%= render "manage/money_incoming/owed_row", item: item, show_production: true %>
    <% end %>
  <% end %>

  <%# Browsing, not doing: the full grids live on the All Financials page, which
      already carries both productions and courses behind a type filter. %>
  <div class="space-y-2">
    <%= link_to manage_money_all_financials_path(type: "productions"), class: "block bg-white rounded-lg border border-gray-200 p-5 hover:bg-gray-50 transition-colors" do %>
      <div class="flex items-center justify-between gap-3">
        <div>
          <h3 class="font-semibold text-gray-900">All productions</h3>
          <p class="text-sm text-gray-500 mt-0.5">Every production's revenue, costs, and profit, show by show.</p>
        </div>
        <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </div>
    <% end %>

    <%= link_to manage_money_all_financials_path(type: "courses"), class: "block bg-white rounded-lg border border-gray-200 p-5 hover:bg-gray-50 transition-colors" do %>
      <div class="flex items-center justify-between gap-3">
        <div>
          <h3 class="font-semibold text-gray-900">All courses</h3>
          <p class="text-sm text-gray-500 mt-0.5">What each course has taken in, and what's left after payouts.</p>
        </div>
        <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </div>
    <% end %>
  </div>
</div>
