<% if @custom_message.present? %>
  <%= simple_format(auto_link(@custom_message, html: { target: '_blank' }), {}, sanitize: false) %>
  <p style="margin-top: 20px;">
    <%= link_to "Set your password", manage_accept_person_invitations_url(token: @token), target: "_blank", class: "button", style: EmailButton::STYLE %>
  </p>
<% else %>
  <h1>Welcome to CocoScout</h1>
  <% if @organization %>
    <p><%= @organization.name %> is using CocoScout to manage its productions, auditions, and casting.</p>
  <% else %>
    <p>You've been invited to join CocoScout, the platform for managing productions, auditions, and casting.</p>
  <% end %>
  <p>To get started, please click the link below to set a password:</p>
  <p><%= link_to "Set your password", manage_accept_person_invitations_url(token: @token), target: "_blank", class: "button", style: EmailButton::STYLE %></p>
<% end %>