<%# Who can come: the minimum age as one row of radio cards (AgeLimit), the
    typed age appearing under the row only when "Another age" is picked
    (Tim, 2026-11-07: one line, not a column), and an optional note about
    ages. Shared by a production's Sales & page tab and a date's Page tab,
    where the first card follows the production. Brings its own radio-card
    controller.
    Locals: scope (the param prefix), age (what's stored), note, input_class,
    inherit (a date: true), inherited_age (the production's), note_placeholder. %>
<%
  inherit = local_assigns[:inherit] || false
  choice = AgeLimit.choice_for(age, inherit: inherit)
  choices = AgeLimit.choices(inherit: inherit, inherited_age: local_assigns[:inherited_age])
  columns = inherit ? "grid-cols-2 sm:grid-cols-3 lg:grid-cols-6" : "grid-cols-2 sm:grid-cols-5"
%>
<div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4" data-controller="radio-card">
  <div>
    <h3 class="font-semibold text-gray-900">Ages</h3>
    <p class="text-sm text-gray-600 mt-1">Buyers see it on the ticket page, at checkout, with their tickets and in their emails, and the door sees it too.</p>
  </div>
  <div>
    <div class="grid <%= columns %> gap-2">
      <% choices.each do |value, title, hint| %>
        <%= render layout: "shared/choice_card", locals: { name: "#{scope}[age_choice]", value: value, selected: choice, title: title, hint: hint } do %><% end %>
      <% end %>
    </div>
    <div class="mt-2 ml-4 pl-4 border-l-2 border-pink-200 flex items-center gap-2 <%= 'hidden' unless choice == AgeLimit::OTHER %>"
         data-radio-card-target="extras" data-for="<%= AgeLimit::OTHER %>">
      <label for="<%= scope %>_age_other" class="text-sm text-gray-700">Ages</label>
      <%= number_field_tag "#{scope}[age_other]", (choice == AgeLimit::OTHER ? age : nil), min: AgeLimit::AGES.min, max: AgeLimit::AGES.max,
            id: "#{scope}_age_other", placeholder: "16", class: "#{input_class} max-w-[6rem]" %>
      <span class="text-sm text-gray-600">and over</span>
    </div>
  </div>
  <div>
    <label for="<%= scope %>_age_note" class="block text-sm font-medium text-gray-700 mb-1.5">Anything else about ages <span class="font-normal text-gray-500">(optional)</span></label>
    <%= text_field_tag "#{scope}[age_note]", note, id: "#{scope}_age_note", maxlength: 200,
          placeholder: local_assigns[:note_placeholder].presence || "Under 21 welcome with a parent", class: input_class %>
  </div>
</div>
