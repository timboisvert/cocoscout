<%# locals: title, subtitle (optional) %>
<div class="mb-8">
  <div class="flex items-center gap-2 text-sm text-gray-600 mb-4">
    <%= link_to "Home", manage_path, class: "hover:text-pink-600" %>
    <span>/</span>
    <%= link_to "Reports", manage_reports_path, class: "hover:text-pink-600" %>
    <span>/</span>
    <span class="text-gray-900"><%= title %></span>
  </div>
  <h1 class="text-3xl coustard-regular text-gray-900"><%= title %></h1>
  <% if local_assigns[:subtitle].present? %>
    <p class="mt-2 text-gray-600"><%= subtitle %></p>
  <% end %>
</div>
