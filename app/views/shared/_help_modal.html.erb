<%# Reusable help pop-up with the solid-pink modal header. Render it as a layout
    (render layout: "shared/help_modal", locals: { title: ... } do ... end) so the
    help body is passed as the block. Requires an ancestor element with
    data-controller="help-modal" and a trigger inside it using
    data-action="click->help-modal#open". %>
<div data-help-modal-target="modal"
     class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm overflow-y-auto h-full w-full z-[60]"
     data-action="click->help-modal#closeOnBackdrop keydown.esc@window->help-modal#close">
  <div class="relative top-16 mx-auto mb-16 p-5 border w-full max-w-lg shadow-lg rounded-lg bg-white"
       data-action="click->help-modal#stop">
    <%# Header — solid pink, matching the sign-up form modals. %>
    <div class="flex items-center justify-between -mx-5 -mt-5 px-5 py-4 bg-pink-500 rounded-t-lg">
      <h3 class="text-lg font-semibold text-white"><%= title %></h3>
      <button type="button" class="text-white/70 hover:text-white cursor-pointer" data-action="help-modal#close">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="mt-5">
      <%= yield %>
    </div>
  </div>
</div>
