<%# "Ask for W-9s": who gets it and the draft they'll get, before anything is
    sent. Everyone missing a W-9 who can be asked is listed and ticked (untick
    anyone to leave them out); people without an account aren't listed —
    onboarding asks them. The draft keeps {{first_name}}, which each send
    fills with that person's name (StaffW9Requester#copy).
    Locals: id, members (the requestable missing), draft ({ subject:, body: }). %>
<% input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
<div id="<%= id %>" class="hidden fixed inset-0 z-[65] bg-black/60 backdrop-blur-sm overflow-y-auto"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="flex min-h-full items-start justify-center p-4 py-12" data-action="click->modal#closeOnBackdrop">
    <div class="relative w-full max-w-2xl bg-white rounded-xl shadow-2xl overflow-hidden" data-action="click->modal#stopPropagation">
      <div class="flex items-center justify-between gap-3 bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
        <h3 class="text-lg font-semibold text-white">Ask for W-9s</h3>
        <button type="button" data-action="click->modal#close"
                class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <%= form_with url: manage_request_w9s_staffing_taxes_path, method: :post do %>
        <div class="px-6 py-5 space-y-5">
          <div>
            <p class="text-sm font-medium text-gray-900 mb-2">
              Sending to <%= pluralize(members.size, "person") %>
              <span class="font-normal text-gray-500">— untick anyone to leave them out</span>
            </p>
            <ul class="max-h-56 overflow-y-auto border border-gray-200 rounded-lg divide-y divide-gray-100">
              <% members.each do |member| %>
                <li>
                  <label class="flex items-center gap-3 px-3 py-2 cursor-pointer hover:bg-gray-50">
                    <%= check_box_tag "staff_member_ids[]", member.id, true, id: "w9-ask-#{member.id}",
                          class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
                    <span class="flex-1 min-w-0">
                      <span class="block text-sm font-medium text-gray-900 truncate"><%= member.display_name %></span>
                      <span class="block text-xs text-gray-500 truncate"><%= StaffW9Requester.preview(staff_member: member)[:to_email] %></span>
                    </span>
                    <% if member.w9_requested_at %>
                      <span class="flex-shrink-0 text-[11px] text-gray-400">Asked <%= member.w9_requested_at.strftime("%b %-d") %></span>
                    <% end %>
                  </label>
                </li>
              <% end %>
            </ul>
          </div>

          <div>
            <label for="bulk_w9_subject" class="block text-sm font-medium text-gray-900 mb-1">Subject</label>
            <%= text_field_tag :email_subject, draft[:subject], id: "bulk_w9_subject", class: input_class %>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-900 mb-1">Message</label>
            <input type="hidden" name="email_body" id="bulk_w9_body" value="<%= draft[:body] %>">
            <trix-editor input="bulk_w9_body"
                         class="trix-content block w-full bg-white border border-gray-300 rounded-lg shadow-sm min-h-[220px] px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"></trix-editor>
            <p class="mt-1 text-xs text-gray-500">
              {{first_name}} becomes each person's first name. It goes out by email and as a CocoScout message,
              with a reminder each week until they fill it in.
            </p>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 px-6 py-4 bg-gray-50 border-t border-gray-200">
          <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button,
                data: { action: "click->modal#close" } %>
          <%= render "shared/button", text: "Send requests", variant: "primary", size: "medium", type: :submit %>
        </div>
      <% end %>
    </div>
  </div>
</div>
