<% content_for :title, "Choose Payout Scheme Preset" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Money", manage_money_index_path],
      ["Payout Schemes", manage_money_payout_schemes_path]
    ],
    text: "Choose a Preset",
    links: []
  } %>

  <%
    # An act-based production sends people here pointed at the Per Act preset:
    # it goes first, lit up, and the scheme it makes becomes that production's
    # default.
    highlighted = @highlighted_preset
    default_production = @default_production
    presets = PayoutScheme::PRESETS.to_a
    presets = presets.sort_by { |key, _| key == highlighted ? 0 : 1 } if highlighted
  %>
  <% if default_production %>
    <p class="text-gray-600 mb-6">
      <span class="font-medium text-gray-900"><%= default_production.name %></span> casts by acts, so it usually pays per act — the scheme you pick here becomes its default. Start with a preset and customize it to fit your needs.
    </p>
  <% else %>
    <p class="text-gray-600 mb-6">Start with a preset and customize it to fit your needs.</p>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% presets.each do |key, preset| %>
      <% is_highlighted = highlighted == key %>
      <div class="bg-white rounded-lg border p-5 transition-colors <%= is_highlighted ? 'border-pink-500 ring-2 ring-pink-200 bg-pink-50/40' : 'border-gray-200 hover:border-pink-300' %>" data-preset="<%= key %>">
        <div class="flex items-center justify-between gap-2 mb-2">
          <h3 class="font-semibold text-gray-900"><%= preset[:name] %></h3>
          <% if is_highlighted %>
            <span class="text-[10px] font-bold uppercase tracking-wide text-pink-600 bg-pink-100 border border-pink-200 rounded px-1.5 py-0.5 leading-none">Recommended</span>
          <% end %>
        </div>
        <p class="text-sm text-gray-600 mb-4"><%= preset[:description] %></p>

        <div class="text-xs text-gray-500 mb-4 p-3 bg-gray-50 rounded">
          <% case key %>
          <% when :no_pay %>
            <div class="space-y-1">
              <div>$0 for all performers</div>
              <div class="text-gray-400">Non-revenue events, rehearsals, etc.</div>
            </div>
          <% when :even_split %>
            <div class="space-y-1">
              <div>50% → House</div>
              <div>50% → Split equally among performers</div>
            </div>
          <% when :per_ticket %>
            <div class="space-y-1">
              <div>$1.00 per ticket per performer</div>
            </div>
          <% when :per_ticket_guaranteed %>
            <div class="space-y-1">
              <div>$1.00 per ticket (min $25) per performer</div>
            </div>
          <% when :flat_fee %>
            <div class="space-y-1">
              <div>$50.00 flat per performer</div>
            </div>
          <% when :per_act %>
            <div class="space-y-1">
              <div>1st act → $75.00</div>
              <div>2nd act → $50.00</div>
              <div>Every act after that → $50.00</div>
              <div class="text-gray-400">These add up, and you can switch to a flat rate or a single total instead.</div>
            </div>
          <% when :share_based %>
            <div class="space-y-1">
              <div>40% → House</div>
              <div>60% → Split by shares</div>
            </div>
          <% end %>
        </div>

        <%= form_with url: manage_create_from_preset_money_payout_schemes_path, method: :post, local: true do |f| %>
          <%= hidden_field_tag :preset_key, key %>
          <%= hidden_field_tag :production_id, default_production.id if default_production %>
          <%= render "shared/button", text: "Use This Preset", variant: is_highlighted ? "primary" : "secondary", size: "small", type: :submit %>
        <% end %>
      </div>
    <% end %>

    <!-- Custom option -->
    <div class="bg-white rounded-lg border border-dashed border-gray-300 p-5 flex flex-col justify-center items-center">
      <svg class="w-8 h-8 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/>
      </svg>
      <h3 class="font-semibold text-gray-900 mb-1">Custom Scheme</h3>
      <p class="text-sm text-gray-500 text-center mb-4">Build your own from scratch</p>
      <%= link_to manage_new_money_payout_scheme_path(default_production ? { production_id: default_production.id } : {}) do %>
        <%= render "shared/button", text: "Create Custom", variant: "outline", size: "small" %>
      <% end %>
    </div>
  </div>
</div>
