<%# Ticketing settings → Comps: the box office's comp rules (CompRules), the
    defaults for every production and date. A production can override them
    on its Comps tab, and a date again on its own, except the house limit. %>
<%= form_with url: manage_ticketing_settings_comps_path, method: :patch do %>
  <%= render "manage/ticketing_settings/comp_rules_fields", scope: "ticketing_profile", rules: ticketing_profile, level: :house, save: true %>
<% end %>
