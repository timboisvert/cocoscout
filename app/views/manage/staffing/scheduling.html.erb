<% content_for :title, "Scheduling" %>

<%# Assigning someone, adding a shift, splitting one — every action here posts
    and comes straight back to this same URL. Declaring morph means Turbo patches
    only the nodes that actually changed instead of re-rendering the page, and
    preserve keeps the scroll exactly where the manager left it. Scoped to this
    page: the rest of the app still navigates normally. %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<%
  days = (@week_start..@week_end).to_a
  assign_url_template = manage_assign_staffing_shift_path(":id")
%>

<div class="w-full mb-10"
     data-controller="shift-assign shift-edit shift-split shift-add staffing-finalize"
     data-shift-assign-staff-by-role-value="<%= @staff_by_role_payload.to_json %>"
     data-shift-assign-assign-url-template-value="<%= assign_url_template %>"
     data-shift-assign-shift-times-value="<%= @shift_times_payload.to_json %>"
     data-shift-assign-person-busy-value="<%= @person_busy_payload.to_json %>"
     data-shift-assign-staff-unavailability-value="<%= @staff_unavailability_payload.to_json %>"
     data-shift-assign-cast-by-day-value="<%= @cast_by_day_payload.to_json %>"
     data-shift-edit-update-url-template-value="<%= manage_update_staffing_shift_path(":id") %>"
     data-shift-edit-unassign-url-template-value="<%= manage_unassign_staffing_shift_path(id: "SHIFT_ID", person_id: "PERSON_ID") %>"
     data-shift-split-split-url-template-value="<%= manage_split_staffing_shift_path(":id") %>"
     data-shift-add-create-url-value="<%= manage_create_staffing_shift_path %>">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%
    top_links = [
      { text: "Availability", icon: "calendar", type: :button,
        data: { controller: "modal", modal_id: "staff-availability-modal" },
        data_action: "click->modal#open" },
      { text: "Manage roles", icon: "cog", path: manage_staffing_house_roles_path }
    ]
    top_links.unshift({ text: "Regulars", icon: "star", path: manage_staffing_scheduling_rules_path }) if @regulars_enabled
  %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Staffing", manage_staffing_index_path]
    ],
    text: "Scheduling",
    links: top_links
  } %>

  <%= render "manage/staffing/availability_overview_modal" %>

  <%= render "manage/staffing/regulars_apply_modal" if @regulars_enabled %>

  <%= render "manage/staffing/declined_alert" %>

  <div class="border-t border-gray-200 pt-4 mt-2">

  <%# === Week navigation === %>
  <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
    <div class="flex items-center gap-2">
      <%= link_to manage_staffing_scheduling_path(week_start: (@week_start - 7.days).to_s),
            class: "px-3 py-1.5 text-sm rounded border border-gray-300 bg-white hover:border-gray-400" do %>
        ← Prev
      <% end %>
      <%= link_to "This week", manage_staffing_scheduling_path,
            class: "px-3 py-1.5 text-sm rounded border border-gray-300 bg-white hover:border-gray-400" %>
      <%= link_to manage_staffing_scheduling_path(week_start: (@week_start + 7.days).to_s),
            class: "px-3 py-1.5 text-sm rounded border border-gray-300 bg-white hover:border-gray-400" do %>
        Next →
      <% end %>
      <div class="hidden sm:block text-base font-medium text-gray-900 px-3">
        Week of <%= @week_start.strftime("%b %-d, %Y") %>
      </div>
    </div>
    <div class="flex items-center gap-2 flex-wrap">
      <% if @house_role_count.zero? %>
        <%= link_to "Add staffing roles to begin →", manage_staffing_house_roles_path,
              class: "text-sm text-pink-600 hover:text-pink-700 underline" %>
      <% end %>
      <% if @regulars_enabled && @regulars_matches.any? %>
        <%= render "shared/button", text: "Apply regulars (#{@regulars_matches.size})",
              variant: "outline-pink", size: "small", icon: "star", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: "regulars-apply-modal" } %>
      <% end %>
    </div>
  </div>
  <%# Mobile-only week label (kept off the button row so the nav stays tidy). %>
  <div class="sm:hidden -mt-2 mb-3 text-sm font-semibold text-gray-900">
    Week of <%= @week_start.strftime("%b %-d, %Y") %>
  </div>

  <%# === Communications band — its own full-width row above the schedule. Clean
      two-tier: status + actions on top, the "who needs an update" chips below. %>
  <% if @shifts_by_day.any? %>
    <% reason_dot = { new: "bg-green-500", changed: "bg-amber-500", removed: "bg-red-500" } %>
    <% reason_label = { new: "new shift", changed: "shift changed", removed: "shift removed" } %>

    <% if !@week_finalized %>
      <%# Draft — never published. Publishing notifies everyone assigned. %>
      <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-amber-100 flex-shrink-0">
            <svg class="w-4 h-4 text-amber-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/></svg>
          </span>
          <div class="min-w-0">
            <div class="text-sm font-semibold text-gray-900">Draft schedule — not published yet</div>
            <div class="text-xs text-gray-600 mt-0.5">Staff can't see their shifts until you publish · <%= pluralize(@comms[:total], "person") %> assigned</div>
          </div>
        </div>
        <button type="button" data-action="staffing-finalize#open"
                class="bg-green-600 hover:bg-green-700 text-white inline-flex items-center justify-center gap-1.5 font-medium rounded-md transition-colors cursor-pointer px-3.5 py-2 text-sm flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
          Publish &amp; notify
        </button>
      </div>

    <% elsif @comms[:update].empty? %>
      <%# Published and everyone's current. Quiet resend option only. %>
      <div class="mb-4 rounded-lg border border-gray-200 bg-white px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <span class="text-sm text-gray-700">Everyone has been notified for this week.</span>
        <% resend_cid = "confirm-resend-all" %>
        <button type="button" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= resend_cid %>"
                class="text-[11px] text-gray-400 hover:text-gray-600 cursor-pointer bg-transparent border-0 flex-shrink-0">
          Resend notifications
        </button>
        <%= render "shared/confirm_modal", id: resend_cid,
              title: "Resend notifications?",
              message: "Resend the current schedule to all #{pluralize(@comms[:total], 'assigned staff member')}.",
              confirm_text: "Resend",
              url: manage_finalize_staffing_path(week_start: @week_start.to_s, notify_all: 1),
              method: :post %>
      </div>

    <% else %>
      <%# Published, but some people have a new/changed/removed shift to be told. %>
      <div class="mb-4 rounded-lg border border-gray-200 bg-white overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
          <span class="text-sm font-semibold text-gray-900"><%= pluralize(@comms[:update].size, "update") %> to send</span>
          <% notify_cid = "confirm-notify-updates" %>
          <%= render "shared/button", text: "Notify updates", variant: "primary", size: "small", type: :button,
                data: { controller: "modal", action: "click->modal#open", modal_id: notify_cid } %>
        </div>

        <div class="border-t border-gray-100 bg-gray-50 px-4 py-2.5 flex flex-wrap items-center gap-1.5">
          <span class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mr-1">Needs an update</span>
          <% @comms[:update].each do |u| %>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white border border-gray-200 shadow-sm pl-2 pr-2.5 py-1 text-xs">
              <span class="w-1.5 h-1.5 rounded-full <%= reason_dot[u[:reason]] %>"></span>
              <span class="font-medium text-gray-800"><%= u[:person].name %></span>
              <span class="text-gray-400"><%= reason_label[u[:reason]] %></span>
            </span>
          <% end %>
        </div>
      </div>

      <%= render "shared/confirm_modal", id: "confirm-notify-updates",
            title: "Notify the staff whose shifts changed?",
            message: "We'll message the #{pluralize(@comms[:update].size, 'person')} with a new, changed, or removed shift this week — everyone else is left alone.",
            confirm_text: "Notify updates",
            url: manage_finalize_staffing_path(week_start: @week_start.to_s),
            method: :post %>
    <% end %>
  <% end %>

  <%# === Day rows === %>
  <div class="space-y-4">
    <% days.each do |day| %>
      <% day_shows  = @shows_by_day[day] || [] %>
      <% day_shifts = @shifts_by_day[day] || [] %>
      <% next if day_shows.empty? && day_shifts.empty? %>

      <%# The id is the scroll anchor every shift action redirects back to, so
          assigning/editing doesn't dump the manager at the top of the week. %>
      <div id="day-<%= day.iso8601 %>"
           class="bg-white border border-gray-300 rounded-lg shadow-sm overflow-hidden scroll-mt-4"
           data-controller="day-view"
           data-day-view-mode-value="cards">
        <%# Stacks on mobile (date/shows/toggle on top, shifts below); sidebar on desktop. %>
        <div class="flex flex-col sm:flex-row sm:items-stretch">
          <%# Date / shows / view-toggle %>
          <div class="flex-shrink-0 sm:w-36 px-3 py-2.5 sm:py-3 border-b sm:border-b-0 sm:border-r border-gray-200 bg-gray-50
                      flex sm:block items-center justify-between gap-3">
            <div class="flex sm:block items-baseline gap-1.5">
              <span class="text-xs font-semibold text-pink-600 uppercase"><%= day.strftime("%a") %></span>
              <span class="text-xl font-bold text-gray-900 sm:block"><%= day.strftime("%-d") %></span>
              <span class="text-xs text-gray-500"><%= day.strftime("%b %Y") %></span>
              <% if day == Date.current %>
                <span class="text-[10px] inline-block px-1.5 py-0.5 rounded bg-pink-100 text-pink-700 font-medium sm:mt-1">Today</span>
              <% end %>
            </div>
            <% if day_shows.any? %>
              <div class="text-[11px] text-gray-600 leading-tight sm:mt-2 sm:pt-2 sm:border-t sm:border-gray-200">
                <%= pluralize(day_shows.size, "show") %><span class="text-gray-500 hidden sm:inline"><br/><%= day_shows.first.date_and_time.strftime("%-l:%M %p") %>–<%= day_shows.last.ends_at.strftime("%-l:%M %p") %></span>
              </div>
            <% end %>

            <%# View toggle: cards · gantt-by-role · gantt-by-people. %>
            <div class="flex items-center gap-1 sm:mt-2 sm:pt-2 sm:border-t sm:border-gray-200">
              <button type="button" data-day-view-target="toggle" data-mode="cards"
                      data-action="click->day-view#setMode"
                      title="Cards view"
                      class="w-6 h-6 rounded inline-flex items-center justify-center bg-pink-100 text-pink-700 hover:bg-pink-200 cursor-pointer">
                <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="1.5" y="2" width="4.5" height="12" rx="1"/><rect x="10" y="2" width="4.5" height="12" rx="1"/>
                </svg>
              </button>
              <button type="button" data-day-view-target="toggle" data-mode="gantt-roles"
                      data-action="click->day-view#setMode"
                      title="Gantt by role"
                      class="w-6 h-6 rounded inline-flex items-center justify-center text-gray-400 hover:bg-gray-100 cursor-pointer">
                <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
                  <rect x="1" y="3"  width="9"  height="2.4" rx="1"/>
                  <rect x="4" y="6.8" width="11" height="2.4" rx="1"/>
                  <rect x="2" y="10.6" width="7"  height="2.4" rx="1"/>
                </svg>
              </button>
              <button type="button" data-day-view-target="toggle" data-mode="gantt-people"
                      data-action="click->day-view#setMode"
                      title="Gantt by person"
                      class="w-6 h-6 rounded inline-flex items-center justify-center text-gray-400 hover:bg-gray-100 cursor-pointer">
                <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
                  <circle cx="3" cy="4"  r="1.6"/><rect x="6" y="3.2" width="9" height="1.6" rx="0.8"/>
                  <circle cx="3" cy="8"  r="1.6"/><rect x="6" y="7.2" width="7" height="1.6" rx="0.8"/>
                  <circle cx="3" cy="12" r="1.6"/><rect x="6" y="11.2" width="8" height="1.6" rx="0.8"/>
                </svg>
              </button>
            </div>
          </div>

          <%# Role columns — same-role shifts stack vertically; columns ordered by HouseRole position. %>
          <div class="flex-1 min-w-0 p-2">
            <%
              # Per-role default times for "+ Add shift" — same math the generator uses, so
              # adding a removed role back gets the identical window without re-running Generate.
              # Shifts run for the show's own hours (no offsets). No-show days fall back to 5–11pm.
              role_defaults_for_day = @house_roles.each_with_object({}) do |r, h|
                if day_shows.any?
                  # Show-specific roles default to the first show's window; house
                  # roles span the whole evening (first start → last end).
                  end_anchor = r.show_specific? ? day_shows.first : day_shows.last
                  starts_at = day_shows.first.date_and_time
                  ends_at   = end_anchor.ends_at
                else
                  starts_at = day.in_time_zone.change(hour: 17)
                  ends_at   = day.in_time_zone.change(hour: 23)
                end
                h[r.id.to_s] = {
                  starts_at: starts_at.strftime("%Y-%m-%dT%H:%M"),
                  ends_at:   ends_at.strftime("%Y-%m-%dT%H:%M")
                }
              end

              # For show-specific roles, the per-show window (start→end of each
              # show) so the Add-shift modal can ask which show and anchor to it.
              show_defaults_for_day = {}
              @house_roles.select(&:show_specific?).each do |r|
                next if day_shows.empty?
                show_defaults_for_day[r.id.to_s] = day_shows.each_with_object({}) do |show, hh|
                  hh[show.id.to_s] = {
                    starts_at: show.date_and_time.strftime("%Y-%m-%dT%H:%M"),
                    ends_at:   show.ends_at.strftime("%Y-%m-%dT%H:%M")
                  }
                end
              end
              day_shows_options = day_shows.map do |s|
                { id: s.id.to_s, label: [ s.production&.name, s.date_and_time.strftime("%-l:%M %p") ].compact.join(" · ") }
              end
              day_label = day.strftime("%A, %b %-d")
            %>
            <% role_order = @house_roles.each_with_index.to_h { |r, i| [r.id, i] } %>
            <% if day_shifts.any? %>
              <% role_groups = day_shifts.group_by(&:house_role)
                                         .sort_by { |role, _| role_order[role.id] || 9_999 } %>
              <% same_role_starts = role_groups.to_h { |role, arr| [role.id, arr.map(&:starts_at)] } %>
              <%# === Cards mode === %>
              <div data-day-view-target="cards">
              <div class="flex flex-col sm:flex-row sm:flex-nowrap gap-3 items-stretch sm:items-start sm:overflow-x-auto pb-2">
                <% role_groups.each do |role, role_shifts| %>
                  <% sorted_role_shifts = role_shifts.sort_by(&:starts_at) %>
                  <div class="w-full sm:w-56 sm:flex-shrink-0 flex flex-col gap-2">
                    <%# Column header — role name lifted out of each individual card. %>
                    <div class="px-1 text-sm font-semibold text-gray-900 truncate">
                      <%= role.name %>
                    </div>
                    <% sorted_role_shifts.each_with_index do |shift, shift_idx| %>
                  <% assigned_ids = shift.shift_assignments.map(&:person_id) %>
                  <% has_assignments = shift.shift_assignments.any? %>
                  <% covered_by_renter = shift.coverage_mode == "covered_by_renter" %>
                  <% not_needed = shift.coverage_mode == "not_needed" %>
                  <% has_declined = shift.shift_assignments.any?(&:declined?) %>
                  <%# A shift has a "next" sibling if another same-role shift on this day starts exactly when this one ends. %>
                  <% has_mergeable_next = (same_role_starts[role.id] || []).include?(shift.ends_at) %>

                  <%
                    card_classes =
                      if has_declined then "border-red-300 bg-red-50 ring-1 ring-red-200"
                      elsif covered_by_renter then "border-blue-300 bg-blue-50"
                      elsif not_needed then "border-gray-200 bg-gray-50"
                      elsif shift.needs_assignment? && shift.fully_staffed? then "border-pink-300 bg-pink-50"
                      else "border-gray-200 bg-white"
                      end
                  %>

                  <div class="border <%= card_classes %> rounded-md overflow-hidden">
                    <%# Time + delete row. Role name is now the column header above. %>
                    <div class="flex items-center border-b border-black/5">
                      <button type="button"
                              data-action="click->shift-edit#open"
                              data-shift-id="<%= shift.id %>"
                              data-shift-starts-at="<%= shift.starts_at.strftime("%Y-%m-%dT%H:%M") %>"
                              data-shift-ends-at="<%= shift.ends_at.strftime("%Y-%m-%dT%H:%M") %>"
                              data-shift-role-name="<%= role.name %>"
                              data-shift-additional-role-ids="<%= shift.additional_role_ids.to_json %>"
                              data-shift-house-role-id="<%= shift.house_role_id %>"
                              class="flex-1 min-w-0 px-3 py-2 text-sm text-left text-gray-900 font-medium hover:bg-black/5 cursor-pointer flex items-center justify-between gap-2">
                        <span class="truncate"><%= shift.starts_at.strftime("%-l:%M") %>–<%= shift.ends_at.strftime("%-l:%M %p") %></span>
                        <span class="text-[10px] text-gray-400 flex-shrink-0">edit</span>
                      </button>
                      <% remove_shift_cid = "confirm-remove-shift-#{shift.id}" %>
                      <button type="button"
                              data-controller="modal"
                              data-action="click->modal#open"
                              data-modal-id="<%= remove_shift_cid %>"
                              class="text-gray-400 hover:text-pink-600 cursor-pointer bg-transparent border-0 leading-none text-xl w-8 h-8 inline-flex items-center justify-center flex-shrink-0">×</button>
                      <%= render "shared/confirm_modal", id: remove_shift_cid,
                            title: "Remove shift?",
                            message: "Remove this #{role.name} shift?",
                            confirm_text: "Remove",
                            url: manage_destroy_staffing_shift_path(shift), method: :delete %>
                    </div>

                    <%# Show-specific shifts name the show(s) they cover — a merged
                        shift spans several, so list all of them. %>
                    <% if role.show_specific? %>
                      <% covered = shift.covered_shows %>
                      <% if covered.any? %>
                        <div class="px-3 py-1 bg-purple-50 border-b border-purple-100 text-[11px] text-purple-800 flex flex-wrap gap-x-2 gap-y-0.5">
                          <% covered.each do |cs| %>
                            <span class="whitespace-nowrap">
                              <span class="font-medium"><%= cs.production&.name %></span>
                              <span class="text-purple-500"><%= cs.date_and_time.strftime("%-l:%M %p") %></span>
                            </span>
                          <% end %>
                        </div>
                      <% end %>
                    <% end %>

                    <% if covered_by_renter %>
                      <div class="px-3 py-2 text-sm text-blue-800">
                        Renter: <%= shift.renter_name.presence || "covered" %>
                      </div>
                    <% elsif not_needed %>
                      <div class="px-3 py-2 text-sm text-gray-500 italic">Not needed</div>
                    <% else %>
                      <div class="px-3 py-2 space-y-1.5">
                        <% shift.shift_assignments.each do |a| %>
                          <% person_headshot = a.person.safe_headshot_variant(:thumb) %>
                          <div class="flex items-center justify-between gap-2 text-sm">
                            <div class="flex items-center gap-2 min-w-0 flex-1">
                              <% if person_headshot %>
                                <%= image_tag person_headshot, alt: a.person.name,
                                      class: "w-6 h-6 rounded-lg object-cover flex-shrink-0" %>
                              <% else %>
                                <div class="w-6 h-6 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-[9px] flex-shrink-0">
                                  <%= a.person.initials %>
                                </div>
                              <% end %>
                              <span class="truncate text-gray-900"><%= a.person.name %></span>
                            </div>
                            <% unassign_cid = "confirm-unassign-#{shift.id}-#{a.person_id}" %>
                            <button type="button"
                                    data-controller="modal"
                                    data-action="click->modal#open"
                                    data-modal-id="<%= unassign_cid %>"
                                    class="text-gray-400 hover:text-pink-600 cursor-pointer bg-transparent border-0 p-0 leading-none flex-shrink-0 w-5 h-5 inline-flex items-center justify-center text-base">×</button>
                            <%= render "shared/confirm_modal", id: unassign_cid,
                                  title: "Remove from shift?",
                                  message: "Remove #{a.person.name} from this shift?",
                                  confirm_text: "Remove",
                                  url: manage_unassign_staffing_shift_path(shift, person_id: a.person_id), method: :delete %>
                          </div>
                          <% if a.declined? %>
                            <div class="flex items-start gap-1 text-[11px] text-red-600 font-medium pl-8 -mt-0.5">
                              <svg class="w-3.5 h-3.5 flex-shrink-0 mt-px" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                              <span>Can't make it<% if a.decline_reason.present? %> — “<%= a.decline_reason %>”<% end %></span>
                            </div>
                          <% end %>
                        <% end %>
                        <% shift.remaining_slots.times do %>
                          <button type="button"
                                  data-action="click->shift-assign#open"
                                  data-shift-id="<%= shift.id %>"
                                  data-role-id="<%= role.id %>"
                                  data-role-name="<%= role.name %>"
                                  data-time-range="<%= shift.starts_at.strftime("%-l:%M") %>–<%= shift.ends_at.strftime("%-l:%M %p") %>"
                                  data-assigned-ids="<%= assigned_ids.to_json %>"
                                  class="w-full text-left text-xs px-2 py-1 rounded border border-dashed border-pink-400 text-pink-700 hover:bg-pink-100 transition-colors cursor-pointer">
                            + Click to add a staff member
                          </button>
                        <% end %>
                        <%# Over-staffing prompt: only meaningful once at least one person is on the shift. %>
                        <% if has_assignments %>
                          <button type="button"
                                  data-action="click->shift-assign#open"
                                  data-shift-id="<%= shift.id %>"
                                  data-role-id="<%= role.id %>"
                                  data-role-name="<%= role.name %>"
                                  data-time-range="<%= shift.starts_at.strftime("%-l:%M") %>–<%= shift.ends_at.strftime("%-l:%M %p") %>"
                                  data-assigned-ids="<%= assigned_ids.to_json %>"
                                  class="w-full text-left text-[11px] px-2 py-0.5 text-gray-500 hover:text-pink-600 cursor-pointer bg-transparent border-0">
                            + Add another person
                          </button>
                        <% end %>

                        <%# Other roles this same shift/person also covers. Click to
                            edit the set in the shift modal. %>
                        <% if shift.additional_roles.any? %>
                          <button type="button"
                                  data-action="click->shift-edit#open"
                                  data-shift-id="<%= shift.id %>"
                                  data-shift-starts-at="<%= shift.starts_at.strftime("%Y-%m-%dT%H:%M") %>"
                                  data-shift-ends-at="<%= shift.ends_at.strftime("%Y-%m-%dT%H:%M") %>"
                                  data-shift-role-name="<%= role.name %>"
                                  data-shift-additional-role-ids="<%= shift.additional_role_ids.to_json %>"
                              data-shift-house-role-id="<%= shift.house_role_id %>"
                                  class="w-full text-left mt-1 pt-1.5 border-t border-black/5 cursor-pointer bg-transparent border-x-0 border-b-0 hover:bg-black/5 rounded-b px-1">
                            <span class="block text-[10px] uppercase tracking-wide text-gray-400 font-semibold mb-0.5">Also covers</span>
                            <div class="flex flex-wrap gap-1">
                              <% shift.additional_roles.each do |extra| %>
                                <span class="inline-flex items-center text-[10px] px-1.5 py-0.5 rounded bg-indigo-50 text-indigo-700 font-medium"><%= extra.name %></span>
                              <% end %>
                            </div>
                          </button>
                        <% end %>
                      </div>
                    <% end %>

                    <%# Footer: split + (conditional) merge %>
                    <div class="px-3 py-1.5 border-t border-black/5 flex items-center justify-end gap-3 text-xs text-gray-500">
                      <%# Show-based shifts split only back into their shows; house
                          shifts split by time. A single-show shift can't be split. %>
                      <% split_covered = role.show_specific? ? shift.covered_shows : [] %>
                      <% if !role.show_specific? || split_covered.size > 1 %>
                        <button type="button"
                                data-action="click->shift-split#open"
                                data-shift-id="<%= shift.id %>"
                                data-shift-starts-at="<%= shift.starts_at.strftime("%Y-%m-%dT%H:%M") %>"
                                data-shift-ends-at="<%= shift.ends_at.strftime("%Y-%m-%dT%H:%M") %>"
                                data-shift-role-name="<%= role.name %>"
                                data-shift-time-range="<%= shift.starts_at.strftime("%-l:%M") %>–<%= shift.ends_at.strftime("%-l:%M %p") %>"
                                data-shift-show-specific="<%= role.show_specific? %>"
                                data-shift-covered-show-count="<%= split_covered.size %>"
                                data-shift-covered-shows="<%= split_covered.map { |s| [ s.production&.name, s.date_and_time.strftime("%-l:%M %p") ].compact.join(" · ") }.to_json %>"
                                class="hover:text-pink-600 underline cursor-pointer bg-transparent border-0 p-0">
                          Split
                        </button>
                      <% end %>
                      <% merge_siblings = sorted_role_shifts.reject { |s| s.id == shift.id } %>
                      <% if merge_siblings.any? %>
                        <% merge_cid = "merge-#{shift.id}" %>
                        <button type="button"
                                data-controller="modal"
                                data-action="click->modal#open"
                                data-modal-id="<%= merge_cid %>"
                                class="hover:text-pink-600 underline cursor-pointer bg-transparent border-0 p-0">Merge</button>
                        <div id="<%= merge_cid %>" class="hidden fixed inset-0 bg-black/50 z-[60] flex items-center justify-center p-4"
                             data-controller="modal" data-action="click->modal#closeOnBackdrop">
                          <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden text-left" data-action="click->modal#stopPropagation">
                            <div class="flex items-center justify-between bg-pink-500 px-5 py-4">
                              <h3 class="text-lg font-semibold text-white">Merge <%= role.name %> shifts</h3>
                              <button type="button" data-action="click->modal#close" class="text-white/70 hover:text-white cursor-pointer">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                              </button>
                            </div>
                            <%= form_with url: manage_merge_staffing_shift_path(shift), method: :post do %>
                              <div class="px-5 py-4">
                                <% this_shows = shift.covered_shows.map { |s| s.production&.name }.compact.uniq %>
                                <p class="text-sm text-gray-600 mb-3">Pick the shifts to merge into this one (<%= shift.starts_at.strftime("%-l:%M") %>–<%= shift.ends_at.strftime("%-l:%M %p") %><% if this_shows.any? %> · <%= this_shows.join(", ") %><% end %>). They become one shift and everyone assigned comes along.</p>
                                <div class="space-y-1 max-h-64 overflow-y-auto">
                                  <% merge_siblings.each do |sib| %>
                                    <% names = sib.shift_assignments.map { |a| a.person&.name }.compact %>
                                    <% sib_shows = sib.covered_shows.map { |s| s.production&.name }.compact.uniq %>
                                    <label class="flex items-center gap-2 px-2 py-1.5 rounded hover:bg-gray-50 cursor-pointer">
                                      <input type="checkbox" name="shift_ids[]" value="<%= sib.id %>" class="h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500 flex-shrink-0">
                                      <span class="text-sm text-gray-900 tabular-nums whitespace-nowrap"><%= sib.starts_at.strftime("%-l:%M") %>–<%= sib.ends_at.strftime("%-l:%M %p") %></span>
                                      <% if sib_shows.any? %><span class="text-xs text-purple-700 truncate">· <%= sib_shows.join(", ") %></span><% end %>
                                      <% if names.any? %><span class="text-xs text-gray-500 truncate flex-shrink-0">· <%= names.join(", ") %></span><% end %>
                                    </label>
                                  <% end %>
                                </div>
                              </div>
                              <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
                                <button type="button" data-action="click->modal#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
                                <%= render "shared/button", text: "Merge selected", variant: "primary", size: "small", type: :submit %>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </div>

                    <% end %>
                  </div>
                <% end %>

                <%# + Add shift — appended to the same scroller so it sits to the right of role columns. %>
                <button type="button"
                        data-action="click->shift-add#open"
                        data-day-label="<%= day_label %>"
                        data-day-iso="<%= day.iso8601 %>"
                        data-role-defaults="<%= role_defaults_for_day.to_json %>"
                        data-source-show-id="<%= day_shows.first&.id %>"
                        data-show-defaults="<%= show_defaults_for_day.to_json %>"
                        data-day-shows="<%= day_shows_options.to_json %>"
                        class="w-48 sm:w-56 flex-shrink-0 self-start text-sm px-3 py-2 rounded-md border border-dashed border-gray-300 text-gray-500 hover:border-pink-400 hover:text-pink-600 hover:bg-pink-50 transition-colors cursor-pointer">
                  + Add shift
                </button>
              </div>
              <%# Mobile scroll affordance — the scroller is hard to spot otherwise. %>
              <% if role_groups.size > 1 %>
                <div class="sm:hidden mt-1.5 flex items-center gap-1 text-[11px] text-gray-400">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5 15.75 12l-7.5 7.5"/></svg>
                  Swipe to see all <%= role_groups.size %> roles
                </div>
              <% end %>
              </div>

              <%# === Gantt modes (toggled by the day-view controller). === %>
              <div data-day-view-target="ganttRoles" class="hidden">
                <%= render "manage/staffing/day_gantt",
                      mode: "roles", day_shifts: day_shifts, day_shows: day_shows, role_order: role_order %>
              </div>
              <div data-day-view-target="ganttPeople" class="hidden">
                <%= render "manage/staffing/day_gantt",
                      mode: "people", day_shifts: day_shifts, day_shows: day_shows, role_order: role_order %>
              </div>
            <% else %>
              <div class="flex items-center gap-3">
                <div class="text-sm text-gray-400 italic px-2 py-2">No shifts scheduled.</div>
                <% if @house_role_count.positive? %>
                  <button type="button"
                          data-action="click->shift-add#open"
                          data-day-label="<%= day_label %>"
                        data-day-iso="<%= day.iso8601 %>"
                          data-role-defaults="<%= role_defaults_for_day.to_json %>"
                          data-source-show-id="<%= day_shows.first&.id %>"
                          data-show-defaults="<%= show_defaults_for_day.to_json %>"
                          data-day-shows="<%= day_shows_options.to_json %>"
                          class="text-sm px-3 py-1.5 rounded-md border border-dashed border-gray-300 text-gray-500 hover:border-pink-400 hover:text-pink-600 hover:bg-pink-50 transition-colors cursor-pointer">
                    + Add shift
                  </button>
                <% end %>
              </div>
            <% end %>

            <% if day_shows.any? %>
              <%# Tagged as a "cards" target so it hides in the Gantt modes
                  (where shows are drawn as their own row inside the chart). %>
              <div data-day-view-target="cards" class="px-1 mt-2 pt-2 border-t border-gray-100 text-[11px] text-gray-500 flex flex-wrap gap-x-3 gap-y-1">
                <% day_shows.each do |show| %>
                  <%
                    cast = @show_cast[show.id] || []
                    uncovered = @uncovered_roles_by_show[show.id]
                    coverage = @show_coverage[show.id]
                    rental = show.space_rental
                    show_time = "#{show.date_and_time.strftime("%-l:%M %p")}–#{show.ends_at.strftime("%-l:%M %p")}"
                    event_type_label = EventTypes.labels[show.event_type] || "Show"
                    call_time = show.call_time_enabled? && show.call_time ? show.call_time.strftime("%-l:%M %p") : nil
                    # The contract's booked window, when it's wider than the show itself.
                    booked_range = if rental && (rental.starts_at != show.date_and_time || rental.ends_at != show.ends_at)
                      "#{rental.starts_at.strftime("%-l:%M %p")}–#{rental.ends_at.strftime("%-l:%M %p")}"
                    end
                    detail_cid = "show-detail-#{show.id}"
                  %>
                  <%# Hover for the schedule, cast and Role Call summary; click for
                      the full panel. The hover panel is promoted to position:fixed
                      by cast-popover so the day card's overflow-hidden can't clip it. %>
                  <span class="relative inline-flex items-center gap-1 cursor-pointer hover:text-gray-700 <%= 'rounded bg-amber-50 border border-amber-300 px-1.5 py-0.5' if uncovered %>"
                        data-controller="cast-popover modal"
                        data-action="click->modal#open" data-modal-id="<%= detail_cid %>">
                    <span class="font-medium text-gray-700"><%= show.date_and_time.strftime("%-l:%M %p") %></span>
                    <%= show.production&.name %>
                    <% if cast.any? %>
                      <span class="inline-flex items-center justify-center min-w-[16px] h-4 px-1 rounded-full bg-purple-100 text-purple-700 text-[9px] font-semibold"><%= cast.size %></span>
                    <% end %>
                    <% if uncovered %>
                      <%# Coverage assistant (Staffing settings): this show still
                          needs these show-specific roles staffed. %>
                      <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-amber-800">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>
                        needs <%= uncovered.to_sentence %>
                      </span>
                    <% end %>
                    <span data-cast-popover-target="panel"
                          class="invisible opacity-0 transition-opacity absolute z-50 left-0 bottom-full mb-1 w-64 max-h-72 overflow-y-auto rounded-lg border border-gray-200 bg-white shadow-xl p-2.5 text-left">
                      <span class="block text-xs font-semibold text-gray-900 mb-1.5"><%= show.display_name %></span>
                      <span class="block space-y-0.5 mb-1.5">
                        <span class="flex justify-between gap-3 text-[11px]"><span class="text-gray-500"><%= event_type_label %></span><span class="text-gray-800 font-medium tabular-nums"><%= show_time %></span></span>
                        <% if call_time %>
                          <span class="flex justify-between gap-3 text-[11px]"><span class="text-gray-500">Call</span><span class="text-gray-800 font-medium tabular-nums"><%= call_time %></span></span>
                        <% end %>
                        <% if booked_range %>
                          <span class="flex justify-between gap-3 text-[11px]"><span class="text-gray-500">Space booked</span><span class="text-gray-800 font-medium tabular-nums"><%= booked_range %></span></span>
                        <% end %>
                      </span>
                      <span class="block text-[10px] uppercase tracking-wide text-gray-400 font-semibold mb-1 pt-1.5 border-t border-gray-100">Cast</span>
                      <% if cast.any? %>
                        <% cast.sort_by { |p| p.name.to_s }.each do |person| %>
                          <span class="flex items-center gap-2 px-1 py-0.5">
                            <% v = person.safe_headshot_variant(:thumb) %>
                            <% if v %>
                              <%= image_tag v, alt: person.name, class: "w-5 h-5 rounded-lg object-cover flex-shrink-0" %>
                            <% else %>
                              <span class="w-5 h-5 rounded-lg bg-gray-200 text-gray-600 flex items-center justify-center text-[8px] font-bold flex-shrink-0"><%= person.initials %></span>
                            <% end %>
                            <span class="text-xs text-gray-800 truncate"><%= person.name %></span>
                          </span>
                        <% end %>
                      <% else %>
                        <span class="block text-xs text-gray-400 italic px-1 py-0.5">No cast assigned</span>
                      <% end %>

                      <% if coverage %>
                        <%# Role Call, branded — the named feature gets its own
                            tinted block rather than reading as one more line. %>
                        <%
                          rc_needed = coverage[:roles].reject { |r| r[:covered] || r[:exempt] }
                          rc_counted = coverage[:roles].reject { |r| r[:exempt] }
                        %>
                        <span class="block mt-2 rounded-lg border <%= rc_needed.any? ? "border-amber-200 bg-amber-50" : "border-pink-100 bg-pink-50" %> px-2 py-1.5">
                          <span class="flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5 <%= rc_needed.any? ? "text-amber-600" : "text-pink-600" %> flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span class="text-[11px] font-semibold <%= rc_needed.any? ? "text-amber-900" : "text-pink-900" %>">Role Call</span>
                            <span class="ml-auto text-[10px] <%= rc_needed.any? ? "text-amber-700" : "text-pink-700" %> tabular-nums">
                              <%= rc_counted.count { |r| r[:covered] } %>/<%= rc_counted.size %>
                            </span>
                          </span>
                          <span class="block text-[10px] <%= rc_needed.any? ? "text-amber-800" : "text-pink-800" %> mt-0.5">
                            <%= rc_needed.any? ? "Still needs #{rc_needed.map { |r| r[:name] }.to_sentence}" : "Every role covered" %>
                          </span>
                        </span>
                      <% end %>
                      <span class="block text-[10px] text-gray-400 mt-1.5 pt-1.5 border-t border-gray-100">Click for details</span>
                    </span>
                  </span>

                  <%# The click panel — a sibling of the chip (a trigger wrapping its
                      own modal would re-open it on every backdrop click). %>
                  <div id="<%= detail_cid %>" class="hidden fixed inset-0 bg-black/50 z-[60] flex items-center justify-center p-4"
                       data-controller="modal" data-action="click->modal#closeOnBackdrop">
                    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden text-left" data-action="click->modal#stopPropagation">
                      <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-5 py-4">
                        <h3 class="text-lg font-semibold text-white truncate"><%= show.display_name %> · <%= show.date_and_time.strftime("%a, %b %-d") %></h3>
                        <button type="button" data-action="click->modal#close" class="text-white/70 hover:text-white cursor-pointer flex-shrink-0 ml-3">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                      </div>
                      <div class="px-5 py-4 space-y-4 max-h-[70vh] overflow-y-auto">
                        <div class="space-y-1">
                          <div class="flex justify-between gap-4 text-sm"><span class="text-gray-500"><%= event_type_label %></span><span class="text-gray-900 font-medium tabular-nums"><%= show_time %></span></div>
                          <% if call_time %>
                            <div class="flex justify-between gap-4 text-sm"><span class="text-gray-500">Call time</span><span class="text-gray-900 font-medium tabular-nums"><%= call_time %></span></div>
                          <% end %>
                          <% if booked_range %>
                            <div class="flex justify-between gap-4 text-sm"><span class="text-gray-500">Space booked</span><span class="text-gray-900 font-medium tabular-nums"><%= booked_range %></span></div>
                          <% end %>
                        </div>

                        <div>
                          <p class="text-[10px] uppercase tracking-wide text-gray-400 font-semibold mb-1.5">Cast</p>
                          <% if cast.any? %>
                            <div class="space-y-1">
                              <% cast.sort_by { |p| p.name.to_s }.each do |person| %>
                                <div class="flex items-center gap-2">
                                  <% v = person.safe_headshot_variant(:thumb) %>
                                  <% if v %>
                                    <%= image_tag v, alt: person.name, class: "w-6 h-6 rounded-lg object-cover flex-shrink-0" %>
                                  <% else %>
                                    <span class="w-6 h-6 rounded-lg bg-gray-200 text-gray-600 flex items-center justify-center text-[9px] font-bold flex-shrink-0"><%= person.initials %></span>
                                  <% end %>
                                  <span class="text-sm text-gray-900"><%= person.name %></span>
                                </div>
                              <% end %>
                            </div>
                          <% else %>
                            <p class="text-sm text-gray-400 italic">No cast assigned</p>
                          <% end %>
                        </div>

                        <%# Role Call — the named feature, so it gets a badge, its own
                            framed block and a way through to its settings. Only here
                            when Role Call is switched on for the org. %>
                        <% if coverage %>
                          <div class="pt-4 border-t border-gray-200">
                            <div class="flex items-center gap-2 mb-1">
                              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-pink-100 text-pink-600 flex-shrink-0">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                              </span>
                              <span class="text-base text-gray-900 coustard-regular">Role Call</span>
                              <%= link_to "Settings", manage_staffing_settings_section_path(section: "role_call"),
                                    class: "ml-auto text-xs text-pink-600 hover:text-pink-700 underline" %>
                            </div>
                            <p class="text-xs text-gray-500 mb-2.5">The show-specific roles this show is checked for. Excuse any this show genuinely doesn't need.</p>

                            <%# Each role flips on its own — a show can skip the booth
                                tech and still be checked for the door person. %>
                            <div class="rounded-lg border border-gray-200 divide-y divide-gray-100 overflow-hidden">
                              <% coverage[:roles].each do |role| %>
                                <div class="flex items-center gap-2 text-sm px-3 py-2 <%= "bg-gray-50/60" if role[:exempt] %>">
                                  <% if role[:exempt] %>
                                    <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/></svg>
                                    <span class="text-gray-500"><%= role[:name] %></span>
                                    <span class="text-xs text-gray-400">not needed for this show</span>
                                    <%= form_with url: manage_staffing_show_coverage_exempt_path(show, role_id: role[:id]), method: :patch, class: "ml-auto flex-shrink-0" do %>
                                      <button type="submit" class="text-xs text-gray-500 hover:text-pink-600 underline cursor-pointer bg-transparent border-0 p-0">Needs it again</button>
                                    <% end %>
                                  <% elsif role[:covered] %>
                                    <svg class="w-4 h-4 text-green-600 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                                    <span class="text-gray-900"><%= role[:name] %></span>
                                    <span class="text-xs text-gray-400">covered</span>
                                  <% else %>
                                    <svg class="w-4 h-4 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>
                                    <span class="text-gray-900"><%= role[:name] %></span>
                                    <span class="text-xs text-amber-700 font-medium">not covered yet</span>
                                    <%# Straight into the Add-shift modal with this role and
                                        show preselected — the day payloads ride on the button
                                        exactly like the "+ Add shift" trigger. %>
                                    <button type="button"
                                            data-action="click->modal#close click->shift-add#openToStaff"
                                            data-preselect-role-id="<%= role[:id] %>"
                                            data-day-label="<%= day_label %>"
                                            data-day-iso="<%= day.iso8601 %>"
                                            data-role-defaults="<%= role_defaults_for_day.to_json %>"
                                            data-source-show-id="<%= show.id %>"
                                            data-show-defaults="<%= show_defaults_for_day.to_json %>"
                                            data-day-shows="<%= day_shows_options.to_json %>"
                                            class="ml-auto text-xs text-pink-600 hover:text-pink-700 font-medium underline cursor-pointer bg-transparent border-0 p-0 flex-shrink-0">Staff it</button>
                                    <%= form_with url: manage_staffing_show_coverage_exempt_path(show, role_id: role[:id], exempt: "1"), method: :patch, class: "flex-shrink-0" do %>
                                      <button type="submit" class="text-xs text-gray-500 hover:text-pink-600 underline cursor-pointer bg-transparent border-0 p-0">Not needed here</button>
                                    <% end %>
                                  <% end %>
                                </div>
                              <% end %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if @shows_by_day.empty? && @shifts_by_day.empty? %>
      <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-8 text-center text-sm text-gray-600">
        <p class="mb-3">No shows or shifts in this week.</p>
        <% if @house_role_count.zero? %>
          <%= link_to "Set up your staffing roles first", manage_staffing_house_roles_path, class: "text-pink-600 hover:text-pink-700 underline" %>
        <% elsif @staff_count.zero? %>
          <%= link_to "Add your staff", manage_staffing_staff_path, class: "text-pink-600 hover:text-pink-700 underline" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# === Assignment modal === %>
  <div data-shift-assign-target="modal"
       class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->shift-assign#backdropClose keydown.esc@window->shift-assign#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-2xl bg-white rounded-xl shadow-2xl"
           data-action="click->shift-assign#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <div>
            <h3 class="text-lg font-semibold text-white" data-shift-assign-target="title">Assign</h3>
            <div class="text-xs text-white/80" data-shift-assign-target="subtitle"></div>
          </div>
          <button type="button" data-action="click->shift-assign#close" class="text-white/70 hover:text-white cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <%# JS rewrites this form's action; pass the session CSRF token — the default per-form token is minted for "#" and gets rejected. %>
        <%= form_with url: "#", method: :post, local: true,
                      authenticity_token: form_authenticity_token,
                      data: { "shift-assign-target": "form" } do %>
          <input type="hidden" name="person_id" data-shift-assign-target="personIdInput">
        <% end %>

        <div class="px-5 pt-3 flex items-center gap-2">
          <span class="text-xs text-gray-500 mr-1">Show</span>
          <button type="button" data-shift-assign-target="filterAll" data-action="click->shift-assign#showAll"
                  class="px-3 py-1.5 rounded text-xs font-medium transition bg-pink-500 text-white">Everyone</button>
          <button type="button" data-shift-assign-target="filterAvailable" data-action="click->shift-assign#showAvailableOnly"
                  class="px-3 py-1.5 rounded text-xs font-medium transition bg-gray-100 text-gray-700 hover:bg-gray-200">Available only</button>
        </div>

        <div class="px-5 py-4 max-h-[60vh] overflow-y-auto" data-shift-assign-target="results">
          <%# populated by JS %>
        </div>
      </div>
    </div>
  </div>

  <%# === Scheduling-conflict modal (shown when assigning would double-book) === %>
  <div data-shift-assign-target="collisionModal"
       class="hidden fixed inset-0 z-[80] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->shift-assign#collisionBackdropClose keydown.esc@window->shift-assign#cancelCollision">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl"
           data-action="click->shift-assign#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <h3 class="text-lg font-semibold text-white">Scheduling conflict</h3>
          <button type="button" data-action="click->shift-assign#cancelCollision" class="text-white/70 hover:text-white cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="px-5 py-4" data-shift-assign-target="collisionBody">
          <%# populated by JS %>
        </div>

        <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
          <button type="button" data-action="click->shift-assign#cancelCollision" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
          <button type="button" data-action="click->shift-assign#confirmCollision"
                  class="px-4 py-2 text-sm font-medium rounded bg-pink-500 hover:bg-pink-600 text-white cursor-pointer transition-colors">
            Assign anyway
          </button>
        </div>
      </div>
    </div>
  </div>

  <%# === Edit time modal === %>
  <div data-shift-edit-target="modal"
       class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->shift-edit#backdropClose keydown.esc@window->shift-edit#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-sm bg-white rounded-xl shadow-2xl"
           data-action="click->shift-edit#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <h3 class="text-lg font-semibold text-white" data-shift-edit-target="title">Edit shift</h3>
          <button type="button" data-action="click->shift-edit#close" class="text-white/70 hover:text-white cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <%# JS rewrites this form's action; pass the session CSRF token — the default per-form token is minted for "#" and gets rejected. %>
        <%= form_with url: "#", method: :patch, local: true,
                      authenticity_token: form_authenticity_token,
                      data: { "shift-edit-target": "form" }, scope: :shift do |f| %>
          <div class="px-5 py-4">
            <div class="text-xs text-gray-500 mb-2" data-shift-edit-target="dayLabel"></div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Starts</label>
                <input type="time" step="300"
                       data-shift-edit-target="startTimeInput"
                       data-action="input->shift-edit#syncHiddenFields"
                       class="block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Ends</label>
                <input type="time" step="300"
                       data-shift-edit-target="endTimeInput"
                       data-action="input->shift-edit#syncHiddenFields"
                       class="block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500">
              </div>
            </div>
            <p class="text-[11px] text-gray-500 mt-2">End time can roll past midnight onto the next day.</p>

            <%# Double-up: this one shift can also cover any number of other roles. %>
            <div class="mt-4">
              <label class="block text-xs font-medium text-gray-700 mb-1">Also covers (optional)</label>
              <%# Empty value so unchecking every box still submits the key and clears the set. %>
              <input type="hidden" name="shift[additional_role_ids][]" value="">
              <div class="space-y-1 max-h-48 overflow-y-auto rounded border border-gray-200 p-2">
                <% @house_roles.each do |r| %>
                  <label class="flex items-center gap-2 text-sm text-gray-800 px-1 py-0.5 rounded hover:bg-gray-50 cursor-pointer">
                    <input type="checkbox" name="shift[additional_role_ids][]" value="<%= r.id %>"
                           data-shift-edit-target="additionalRoleCheckbox" data-role-id="<%= r.id %>"
                           class="h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
                    <span class="truncate"><%= r.name %></span>
                  </label>
                <% end %>
              </div>
              <p class="text-[11px] text-gray-500 mt-1">Check every extra role this person works this shift (e.g. a bartender who's also managing and on security).</p>
            </div>

            <%# Hidden full-datetime fields submitted to the server; JS keeps them in sync with the time inputs above. %>
            <%= f.hidden_field :starts_at, data: { "shift-edit-target": "startInput" } %>
            <%= f.hidden_field :ends_at,   data: { "shift-edit-target": "endInput" } %>
          </div>
          <%# Shown only when the modal was opened by clicking a specific person. %>
          <div data-shift-edit-target="removeSection"
               class="hidden border-t border-gray-200 px-5 py-3 flex items-center justify-between gap-3">
            <span class="text-xs text-gray-600">
              Remove <span class="font-medium text-gray-900" data-shift-edit-target="removePersonName"></span> from this shift?
            </span>
            <button type="button"
                    data-shift-edit-target="removeButton"
                    data-action="click->shift-edit#removePerson"
                    class="px-3 py-1.5 text-xs font-medium rounded border border-red-300 text-red-700 bg-white hover:bg-red-50 cursor-pointer transition-colors">
              Remove
            </button>
          </div>
          <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
            <button type="button" data-action="click->shift-edit#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
            <%= render "shared/button", text: "Save time", variant: "primary", size: "small", type: :submit %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# === Split modal === %>
  <div data-shift-split-target="modal"
       class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->shift-split#backdropClose keydown.esc@window->shift-split#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl"
           data-action="click->shift-split#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <div>
            <h3 class="text-lg font-semibold text-white" data-shift-split-target="title">Split shift</h3>
            <div class="text-xs text-white/80" data-shift-split-target="subtitle"></div>
          </div>
          <button type="button" data-action="click->shift-split#close" class="text-white/70 hover:text-white cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <%# JS rewrites this form's action; pass the session CSRF token — the default per-form token is minted for "#" and gets rejected. %>
        <%= form_with url: "#", method: :post, local: true,
                      authenticity_token: form_authenticity_token,
                      data: { "shift-split-target": "form" } do %>
          <%# Per-show split — shown by JS for show-based shifts. Splits back into
              one distinct shift per show; no time slicing for this type. %>
          <div class="hidden" data-shift-split-target="byShowRow">
            <div class="px-5 py-4">
              <p class="text-sm text-gray-600 mb-3">This shift covers these shows. Split it back into a separate shift for each.</p>
              <div class="space-y-1 mb-4" data-shift-split-target="byShowList"></div>
              <div class="bg-amber-50 border border-amber-200 rounded text-xs text-amber-900 p-2.5">
                The people assigned stay on the first show's shift; the others come back empty to staff per show.
              </div>
            </div>
            <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
              <button type="button" data-action="click->shift-split#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
              <button type="submit" name="by_show" value="1"
                      class="px-3 py-1.5 text-sm rounded bg-pink-500 text-white hover:bg-pink-600 font-medium cursor-pointer"
                      data-shift-split-target="byShowLabel">Split into separate shows</button>
            </div>
          </div>

          <%# Time-based split — shown by JS for house (evening) shifts. %>
          <div data-shift-split-target="timeSplitRow">
            <div class="px-5 py-4 space-y-5">
              <%# Big +/- counter %>
              <div class="flex items-center justify-center gap-6">
                <button type="button" data-action="click->shift-split#decrement"
                        class="w-10 h-10 rounded-full border border-gray-300 bg-white hover:bg-gray-50 hover:border-gray-400 text-xl font-medium text-gray-700 cursor-pointer flex items-center justify-center transition-colors">
                  −
                </button>
                <div class="text-center min-w-[80px]">
                  <div class="text-5xl font-bold text-gray-900 tabular-nums leading-none" data-shift-split-target="countDisplay">2</div>
                  <div class="text-[11px] text-gray-500 uppercase tracking-wider mt-1">Segments</div>
                </div>
                <button type="button" data-action="click->shift-split#increment"
                        class="w-10 h-10 rounded-full border border-gray-300 bg-white hover:bg-gray-50 hover:border-gray-400 text-xl font-medium text-gray-700 cursor-pointer flex items-center justify-center transition-colors">
                  +
                </button>
              </div>

              <div class="space-y-4" data-shift-split-target="segmentsContainer">
                <%# Populated by JS — each segment is a dual-handle slider. %>
              </div>

              <div class="bg-amber-50 border border-amber-200 rounded text-xs text-amber-900 p-2.5">
                Existing assignments stay on segment #1. New segments start empty.
              </div>
            </div>
            <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
              <button type="button" data-action="click->shift-split#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
              <%= render "shared/button", text: "Split", variant: "primary", size: "small", type: :submit %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# === Add shift modal — progressive: pick a role, and the rest of the form
      reveals itself already filled in (suggested times you can edit, the show
      for per-show roles, and the qualified people so you can staff it in the
      same breath). %>
  <div data-shift-add-target="modal"
       class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->shift-add#backdropClose keydown.esc@window->shift-add#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl"
           data-action="click->shift-add#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <div>
            <h3 class="text-lg font-semibold text-white">Add shift</h3>
            <div class="text-xs text-white/80" data-shift-add-target="subtitle"></div>
          </div>
          <button type="button" data-action="click->shift-add#close" class="text-white/70 hover:text-white cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <%= form_with url: manage_create_staffing_shift_path, method: :post, local: true,
                      data: { "shift-add-target": "form" }, scope: :shift do |f| %>
          <div class="px-5 py-4 space-y-3">
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">Role</label>
              <%= f.select :house_role_id,
                    @house_roles.map { |r| [r.name, r.id] },
                    { include_blank: "Choose a role…" },
                    data: { "shift-add-target": "roleSelect", action: "change->shift-add#roleChanged" },
                    class: "block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500" %>
            </div>

            <%# Everything below reveals once a role is chosen. %>
            <div data-shift-add-target="details" class="hidden space-y-3">
              <%# Which shows — per-show roles only; the day's shows render as a
                  checkbox list so one shift can cover several back-to-back shows
                  (one tech working all three). The first checked show is the
                  anchor (source); the rest ride along as extra covered shows. %>
              <div data-shift-add-target="showRow" class="hidden">
                <label class="block text-xs font-medium text-gray-700 mb-1">Shows</label>
                <div data-shift-add-target="showList"
                     class="space-y-1.5 rounded border border-gray-300 shadow-sm px-3 py-2 max-h-36 overflow-y-auto"></div>
                <p class="text-[11px] text-gray-500 mt-1">Check every show this shift covers.</p>
              </div>

              <%# Suggested times, fully editable. %>
              <div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Starts</label>
                    <input type="time" step="300"
                           data-shift-add-target="startTimeInput"
                           data-action="input->shift-add#timesEdited"
                           class="block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500">
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Ends</label>
                    <input type="time" step="300"
                           data-shift-add-target="endTimeInput"
                           data-action="input->shift-add#timesEdited"
                           class="block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500">
                  </div>
                </div>
                <p class="text-[11px] text-gray-500 mt-1" data-shift-add-target="timeHint"></p>
              </div>

              <%# Staff it now (optional). Qualified people for the chosen role,
                  rendered by JS with busy/unavailable badges. %>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Who's working it <span class="font-normal text-gray-400">(optional — leave blank to staff later)</span></label>
                <div data-shift-add-target="people" class="grid grid-cols-2 gap-1.5 max-h-44 overflow-y-auto"></div>
              </div>
            </div>

            <%# Hidden full datetimes — kept in sync with the time inputs. %>
            <%= f.hidden_field :starts_at, data: { "shift-add-target": "startInput" } %>
            <%= f.hidden_field :ends_at,   data: { "shift-add-target": "endInput" } %>
            <%# Anchors the shift to a show so it groups on that show's day even
                when its hours cross midnight. Blank for no-show days. %>
            <%= f.hidden_field :source_type, data: { "shift-add-target": "sourceTypeInput" } %>
            <%= f.hidden_field :source_id,   data: { "shift-add-target": "sourceIdInput" } %>
            <%# Extra covered shows beyond the source anchor — filled by JS when
                more than one show is checked. %>
            <span data-shift-add-target="showIdsWrap"></span>
            <%= hidden_field_tag :person_id, nil, data: { "shift-add-target": "personIdInput" } %>
            <%= f.hidden_field :required_count, value: 1 %>
            <%= f.hidden_field :coverage_mode,  value: "needs_assignment" %>
          </div>
          <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
            <button type="button" data-action="click->shift-add#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
            <span data-shift-add-target="submitWrap" class="opacity-40 pointer-events-none">
              <%= render "shared/button", text: "Add shift", variant: "primary", size: "small", type: :submit %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# === Finalize & notify modal === %>
  <div data-staffing-finalize-target="modal"
       class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->staffing-finalize#backdropClose keydown.esc@window->staffing-finalize#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-xl bg-white rounded-xl shadow-2xl"
           data-action="click->staffing-finalize#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <div>
            <h3 class="text-lg font-semibold text-white">Publish &amp; notify</h3>
            <div class="text-xs text-white/80">Week of <%= @week_start.strftime("%b %-d, %Y") %></div>
          </div>
          <button type="button" data-action="click->staffing-finalize#close" class="text-white/70 hover:text-white cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <%= form_with url: manage_finalize_staffing_path(week_start: @week_start.to_s), method: :post, local: true do %>
          <div class="px-5 py-4 space-y-4">
            <%# Who's being notified. %>
            <div>
              <div class="text-xs font-semibold text-gray-500 uppercase mb-2">
                Notifying <%= pluralize(@finalize_recipients.count { |r| r[:notifiable] }, "staff member") %>
              </div>
              <% if @finalize_recipients.any? %>
                <div class="border border-gray-200 rounded-lg divide-y divide-gray-100 max-h-44 overflow-y-auto">
                  <% @finalize_recipients.each do |r| %>
                    <div class="flex items-center gap-2.5 px-3 py-2">
                      <% v = r[:person].safe_headshot_variant(:thumb) %>
                      <% if v %>
                        <%= image_tag v, alt: r[:person].name, class: "w-7 h-7 rounded-lg object-cover flex-shrink-0" %>
                      <% else %>
                        <span class="w-7 h-7 rounded-lg bg-gray-200 text-gray-600 flex items-center justify-center text-[10px] font-bold flex-shrink-0"><%= r[:person].initials %></span>
                      <% end %>
                      <span class="text-sm <%= r[:notifiable] ? "text-gray-900" : "text-gray-400" %> flex-1 min-w-0 truncate"><%= r[:person].name %></span>
                      <span class="text-xs text-gray-500 flex-shrink-0"><%= pluralize(r[:shift_count], "shift") %></span>
                      <% unless r[:notifiable] %>
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-gray-200 text-gray-600 flex-shrink-0" title="No CocoScout login — can't be notified. Invite them from the Staff page.">won't be notified</span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
                <% if @finalize_recipients.any? { |r| !r[:notifiable] } %>
                  <p class="text-[11px] text-amber-700 mt-2">
                    Some staff have no CocoScout account, so they won't get this notification.
                    <%= link_to "Invite them from the Staff page", manage_staffing_staff_path, class: "underline hover:text-amber-800" %>.
                  </p>
                <% end %>
              <% else %>
                <p class="text-sm text-gray-500 italic">No staff are assigned this week yet. Finalizing will mark the week ready, but no one will be notified.</p>
              <% end %>
            </div>

            <%# Editable message template. Each person additionally receives their
                own shift list + a My Shifts link appended automatically. %>
            <div>
              <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Subject</label>
              <input type="text" name="subject" value="<%= default_finalize_subject %>"
                     class="block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Message</label>
              <textarea name="message" rows="3"
                        class="block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500"><%= default_finalize_intro %></textarea>
              <p class="text-[11px] text-gray-500 mt-1">
                Sent from CocoScout as an automated notification. Each person's own list of shifts and a link to their
                <strong>My Shifts</strong> page are added automatically below your message.
              </p>
            </div>
          </div>
          <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
            <button type="button" data-action="click->staffing-finalize#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
            <%= render "shared/button", text: "Publish & send", variant: "primary", size: "small", type: :submit %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  </div>
</div>
