<% content_for :title, "Put #{@production.name} on sale" %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  open_shows = @shows.reject(&:ticket_listing)
  rooms = @shows.filter_map(&:location_space).uniq.select { |space| space.capacity.to_i.positive? }
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Ticketing", manage_ticketing_path ], [ "Shows on sale", manage_ticket_listings_path ] ],
    text: "Put #{@production.name} on sale",
    links: []
  } %>

  <% if @shows.empty? %>
    <div class="max-w-2xl bg-white border border-dashed border-gray-300 rounded-xl px-6 py-10 text-center">
      <p class="text-sm text-gray-600"><%= @production.name %> has no upcoming shows to sell. Rehearsals and other unticketed events don't appear here.</p>
    </div>
  <% else %>
    <%= form_with url: manage_ticket_listings_path, method: :post, class: "max-w-2xl space-y-6" do %>
      <%= hidden_field_tag :production_id, @production.id %>

      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="select-all">
        <div class="flex items-start justify-between gap-3 px-6 py-4 border-b border-gray-200">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">Which dates?</h2>
            <p class="text-sm text-gray-600 mt-1">Each date gets its own page and its own seats.</p>
          </div>
          <% if open_shows.size > 1 %>
            <%= render "shared/button", text: "Select all", variant: "secondary", size: "small", type: :button,
                  data: { action: "click->select-all#toggleAll", "select-all-target" => "toggleButton" } %>
          <% end %>
        </div>
        <div class="divide-y divide-gray-100">
          <% @shows.each do |show| %>
            <% listed = show.ticket_listing.present? %>
            <label class="flex items-center gap-3 px-6 py-3 <%= listed ? 'opacity-60' : 'cursor-pointer hover:bg-gray-50' %>">
              <input type="checkbox" name="show_ids[]" value="<%= show.id %>" <%= "disabled" if listed %>
                     data-select-all-target="checkbox" data-action="change->select-all#updateButtonText"
                     class="h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-medium text-gray-900"><%= show.date_and_time.strftime("%a, %b %-d · %-l:%M %p") %></span>
                <span class="block text-xs text-gray-500 truncate"><%= [ show.display_name, show.location_space&.name ].compact.join(" · ") %></span>
              </span>
              <% if listed %>
                <span class="text-xs text-gray-500">Already in Ticketing</span>
              <% end %>
            </label>
          <% end %>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Ticket prices</h2>
          <p class="text-sm text-gray-600 mt-1">The same prices for every date you picked; you can change any date afterwards. Leave seats blank for no limit. Empty rows are skipped.</p>
          <% if rooms.any? %>
            <p class="text-xs text-gray-500 mt-1"><%= rooms.map { |room| "#{room.name} seats #{room.capacity}" }.to_sentence %>.</p>
          <% end %>
        </div>
        <div class="px-6 py-5">
          <div class="hidden sm:grid grid-cols-[minmax(0,1fr)_7rem_6rem] gap-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500 mb-1.5">
            <span>Name</span><span>Price</span><span>Seats</span>
          </div>
          <div class="space-y-2">
            <% @tier_rows.each_with_index do |row, i| %>
              <%# Phones: the name gets its own line; price and seats sit under it. %>
              <div class="grid grid-cols-2 sm:grid-cols-[minmax(0,1fr)_7rem_6rem] gap-2 <%= 'pt-3 border-t border-gray-100 sm:pt-0 sm:border-0' unless i.zero? %>">
                <input type="text" name="tiers[<%= i %>][name]" value="<%= row[:name] %>" placeholder="<%= i.zero? ? 'General admission' : 'e.g. VIP' %>" aria-label="Ticket name" class="<%= input_class %> col-span-2 sm:col-span-1">
                <div>
                  <span class="sm:hidden block text-[11px] font-semibold uppercase tracking-wide text-gray-500 mb-1">Price</span>
                  <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">$</span>
                    <input type="text" inputmode="decimal" name="tiers[<%= i %>][price]" value="<%= row[:price] %>" placeholder="0.00" aria-label="Price" class="<%= input_class %> pl-7">
                  </div>
                </div>
                <div>
                  <span class="sm:hidden block text-[11px] font-semibold uppercase tracking-wide text-gray-500 mb-1">Seats</span>
                  <input type="number" min="1" name="tiers[<%= i %>][quantity]" value="<%= row[:quantity] %>" placeholder="Any" aria-label="Seats" class="<%= input_class %>">
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">When do sales open?</h2>
          <p class="text-sm text-gray-600 mt-1">Online sales close at showtime unless you change a date later.</p>
        </div>
        <div class="px-6 py-5 space-y-2">
          <% [ [ "draft", "Keep them as drafts", "Check everything over, then put them on sale." ],
               [ "now", "Put them on sale now", "Buyers can buy as soon as ticketing is on for your organization." ],
               [ "scheduled", "Open sales at a set time", nil ] ].each do |value, title, explanation| %>
            <label class="flex items-start gap-3 rounded-lg border border-gray-200 px-4 py-3 cursor-pointer has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50">
              <input type="radio" name="opening" value="<%= value %>" <%= "checked" if value == "draft" %>
                     class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500">
              <span class="flex-1">
                <span class="block text-sm font-medium text-gray-900"><%= title %></span>
                <% if explanation %>
                  <span class="block text-xs text-gray-600 mt-0.5"><%= explanation %></span>
                <% else %>
                  <input type="datetime-local" name="on_sale_at" aria-label="When sales open" class="<%= input_class %> mt-2 max-w-xs">
                <% end %>
              </span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <%= render "shared/button", text: "Create", variant: "primary", size: "medium", type: :submit %>
        <%= link_to "Cancel", manage_ticket_listings_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
      </div>
    <% end %>
  <% end %>
</div>
