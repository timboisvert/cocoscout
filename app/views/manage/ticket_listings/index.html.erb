<% content_for :title, "Productions" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Ticketing", manage_ticketing_path ] ],
    text: "Productions",
    links: [ { text: "Sell tickets for a production", path: manage_new_production_ticketing_path } ]
  } %>

  <%# Every production that sells, soonest next date first: one slim line
      each, its picture and name, then its next date and how it's selling,
      the dates after it in a drawer underneath. Productions with no dates
      coming follow. %>
  <% if @productions.any? %>
    <% selling, quiet = @productions.partition { |production| @coming_up[production.id] } %>
    <div class="space-y-1.5">
      <% selling.each do |production| %>
        <%= render "manage/ticket_listings/production_row", production: production, row: @coming_up[production.id] %>
      <% end %>
    </div>

    <% if quiet.any? %>
      <h2 class="mt-8 mb-2 text-xs font-semibold uppercase tracking-wide text-gray-500">No dates coming up</h2>
      <div class="space-y-1.5">
        <% quiet.each do |production| %>
          <% setup = production.production_ticketing %>
          <%= link_to manage_production_ticketing_path(production), class: "group flex items-center gap-3 bg-white rounded-lg border border-gray-200 px-3 py-2 hover:bg-gray-50 transition-colors" do %>
            <%= render "shared/production_image", production: production, width: "w-8", initials_class: "text-[10px]" %>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-semibold text-gray-900 truncate group-hover:text-pink-600 transition-colors"><%= production.name %></span>
              <span class="block text-xs text-gray-500">No upcoming dates<% if setup && !setup.enabled? %> · Off<% end %></span>
            </span>
            <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white border border-dashed border-gray-300 rounded-lg px-6 py-10 text-center">
      <p class="text-sm text-gray-600">No productions are selling tickets yet. Set one up once and every date you choose goes on sale.</p>
      <div class="mt-4 inline-block">
        <%= render "shared/button", text: "Sell tickets for a production", variant: "primary", size: "small", path: manage_new_production_ticketing_path %>
      </div>
    </div>
  <% end %>
</div>
