<%# One production on Ticketing's Productions page, in one slim line: its
    wide image and name (opening the production), then its next date (opening
    the date), with the dates after it in a drawer hanging underneath, the
    same drawer as Ticketing home (Tim, 2026-10-16).
    Locals: production, row (Ticketing::ComingUp::ProductionDates). %>
<% setup = production.production_ticketing %>
<div>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden flex flex-col sm:flex-row sm:items-center">
    <%= link_to manage_production_ticketing_path(production), class: "group flex items-center gap-3 px-3 py-2 sm:w-80 sm:flex-shrink-0 min-w-0 hover:bg-gray-50 transition-colors sm:border-r border-gray-100" do %>
      <%= render "shared/wide_thumb", image: production.safe_wide_image_variant(:small), name: production.name, width: "w-16" %>
      <span class="min-w-0">
        <span class="block text-sm font-semibold text-gray-900 truncate group-hover:text-pink-600 transition-colors"><%= production.name %></span>
        <span class="block text-xs text-gray-500">
          <%= pluralize(row.total, "date") %><% if setup && !setup.enabled? %> · <span class="text-gray-600 font-medium">Off</span><% end %>
        </span>
      </span>
    <% end %>
    <%= render "manage/ticketing/date_line", listing: row.next_listing, stats: row.next_stats %>
  </div>
  <%= render "manage/ticketing/more_dates", row: row %>
</div>
