<%# Modal to adjust a 1099 draft. `id` matches its trigger's data-modal-id.
    The adjustment is added to the computed year amount (positive or negative),
    e.g. money paid entirely outside CocoScout the manager wants included. %>
<div id="<%= id %>"
     class="hidden fixed inset-0 z-[65] bg-black/60 backdrop-blur-sm overflow-y-auto"
     data-controller="modal" data-action="click->modal#closeOnBackdrop keydown.esc@window->modal#close">
  <div class="flex min-h-full items-start justify-center p-4 py-12">
    <div class="relative w-full max-w-lg bg-white rounded-xl shadow-2xl" data-action="click->modal#stopPropagation">
      <div class="flex items-center justify-between px-6 py-4 bg-gradient-to-r from-pink-500 to-pink-600 rounded-t-xl">
        <h3 class="text-lg font-semibold text-white">Edit <%= form.recipient_name %>'s <%= form.tax_year %> 1099</h3>
        <button type="button" data-action="click->modal#close" class="text-white/80 hover:text-white cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <%= form_with url: manage_update_1099_staffing_tax_path(form), method: :patch do %>
        <div class="px-6 py-5 space-y-4">
          <dl class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
            <dt class="text-gray-500">Computed from payout runs</dt>
            <dd class="text-gray-900 tabular-nums text-right">$<%= format("%.2f", form.nec_box1_cents / 100.0) %></dd>
          </dl>
          <div>
            <label for="adjustment_dollars_<%= form.id %>" class="block text-sm font-medium text-gray-700 mb-1">Adjustment (payments made outside CocoScout)</label>
            <%= number_field_tag :adjustment_dollars, format("%.2f", form.adjustment_cents / 100.0), step: "0.01",
                  id: "adjustment_dollars_#{form.id}",
                  class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
            <p class="mt-1 text-xs text-gray-500">Positive to add, negative to subtract. It gets added to Box 1.</p>
          </div>
          <div>
            <label for="adjustment_note_<%= form.id %>" class="block text-sm font-medium text-gray-700 mb-1">Note</label>
            <%= text_field_tag :adjustment_note, form.adjustment_note, id: "adjustment_note_#{form.id}",
                  placeholder: "e.g. Q3 cash bonus not run through CocoScout",
                  class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
          </div>
          <div>
            <label for="federal_withheld_dollars_<%= form.id %>" class="block text-sm font-medium text-gray-700 mb-1">Federal income tax withheld (Box 4)</label>
            <%= number_field_tag :federal_withheld_dollars, format("%.2f", form.federal_withheld_cents / 100.0), step: "0.01",
                  id: "federal_withheld_dollars_#{form.id}",
                  class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
            <p class="mt-1 text-xs text-gray-500">Only if you were required to withhold (rare — e.g. backup withholding).</p>
          </div>
          <label class="flex items-start gap-2">
            <%= check_box_tag :mark_ready, "1", form.status == "ready",
                  class: "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
            <span class="text-sm text-gray-700">Mark this 1099 <span class="font-medium">ready to send</span></span>
          </label>
        </div>
        <div class="flex items-center justify-end gap-2 px-6 py-3 border-t border-gray-200">
          <%= render "shared/button", text: "Cancel", variant: "ghost-cancel", size: "small", type: :button,
                data: { action: "click->modal#close" } %>
          <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
        </div>
      <% end %>
    </div>
  </div>
</div>
