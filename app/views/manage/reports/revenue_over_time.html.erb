<% content_for :title, "Revenue Over Time" %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <%= render "manage/reports/header", title: "Revenue Over Time", subtitle: "Recorded revenue for each of the last 12 months." %>

    <div class="bg-white border border-gray-200 rounded-lg p-5 mb-6">
      <div class="text-sm text-gray-500">Total (13 months)</div>
      <div class="text-3xl font-bold text-gray-900"><%= number_to_currency(@total) %></div>
    </div>

    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <div class="space-y-3">
        <% @months.each do |month, amount| %>
          <div>
            <div class="flex items-center justify-between text-sm mb-1">
              <span class="text-gray-600"><%= month.strftime("%b %Y") %></span>
              <span class="font-medium text-gray-900"><%= number_to_currency(amount) %></span>
            </div>
            <div class="h-2 w-full rounded-full bg-gray-100 overflow-hidden">
              <div class="h-full rounded-full bg-pink-500" style="width: <%= @peak.positive? ? (amount / @peak * 100).round : 0 %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
