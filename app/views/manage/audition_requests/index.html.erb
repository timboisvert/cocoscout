<% content_for :title, "Open Sign-ups" %>
<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Sign-ups", manage_signups_path],
      [@production.name, manage_signups_production_path(@production)],
      ["Auditions", manage_signups_auditions_path(@production)]
    ],
    text: "Requests",
    links: []
  } %>

  <%= render partial: "manage/auditions/cycle_status_panel" %>
  <%= render partial: "manage/auditions/topical_nav", locals: { current_topic: :requests } %>

  <% if current_user_can_manage?(@production) %>
    <div class="mb-4 p-4 bg-white border border-gray-200 rounded-lg shadow-sm">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="flex-shrink-0">
            <% if @audition_cycle.voting_enabled %>
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
              </span>
            <% else %>
              <span class="relative flex h-3 w-3">
                <span class="relative inline-flex rounded-full h-3 w-3 bg-gray-400"></span>
              </span>
            <% end %>
          </div>
          <div>
            <p class="text-base font-semibold <%= @audition_cycle.voting_enabled ? 'text-green-700' : 'text-gray-700' %>">
              Voting is <%= @audition_cycle.voting_enabled ? 'live' : 'paused' %>
            </p>
            <p class="text-sm text-gray-600">
              <% if @audition_cycle.voting_enabled %>
                <%= @audition_cycle.reviewer_count %> <%= 'reviewer'.pluralize(@audition_cycle.reviewer_count) %> can vote
              <% else %>
                Voting bar is hidden
              <% end %>
            </p>
          </div>
        </div>
        <label class="flex items-center gap-2 cursor-pointer"
               data-controller="toggle-voting"
               data-toggle-voting-cycle-id-value="<%= @audition_cycle.id %>"
               data-toggle-voting-enabled-value="<%= @audition_cycle.voting_enabled %>"
               data-toggle-voting-url-value="<%= manage_toggle_voting_signups_auditions_cycle_path(@production, @audition_cycle) %>">
          <span class="text-sm font-semibold <%= @audition_cycle.voting_enabled ? 'text-gray-700' : 'text-gray-400' %>">
            <%= @audition_cycle.voting_enabled ? 'Enabled' : 'Disabled' %>
          </span>
          <div class="relative inline-block w-10 h-6 transition duration-200 ease-in-out">
            <input type="checkbox"
                   <%= 'checked' if @audition_cycle.voting_enabled %>
                   data-action="change->toggle-voting#change"
                   class="sr-only peer">
            <div class="block w-10 h-6 rounded-full <%= @audition_cycle.voting_enabled ? 'bg-pink-500' : 'bg-gray-300' %> peer-focus:ring-2 peer-focus:ring-pink-300"></div>
            <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform <%= @audition_cycle.voting_enabled ? 'translate-x-4' : 'translate-x-0' %>"></div>
          </div>
        </label>
      </div>
    </div>
  <% end %>

  <%# Sort and filter (V1.1 plan §4): links, so the address carries them.
      Select reveals the checkboxes on a phone, where there's no hover to
      find them by; desktop always shows them. %>
  <div data-controller="bulk-select" class="mb-4">
  <% if @audition_cycle.audition_requests.active.any? %>
    <% chip = ->(on) { "inline-flex items-center min-h-[36px] px-3 rounded-full border text-sm whitespace-nowrap #{on ? 'border-pink-500 bg-pink-50 text-pink-700 font-medium' : 'border-gray-300 bg-white text-gray-700'}" } %>
    <% here = ->(opts) { manage_signups_auditions_cycle_requests_path(@production, @audition_cycle, { filter: @filter, sort: @sort }.merge(opts).reject { |k, v| (k == :filter && v == "all") || (k == :sort && v == "signed_up") }) } %>
    <div class="mb-3 flex items-center gap-2 overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap" data-requests-filters>
      <%= link_to "Everyone", here.call(filter: "all"), class: chip.call(@filter == "all") %>
      <% if current_user_can_review?(@production) %>
        <%= link_to "Not voted by me#{" (#{@unvoted_count})" if @unvoted_count.positive?}", here.call(filter: "unvoted"), class: chip.call(@filter == "unvoted"), data: { filter: "unvoted" } %>
        <span class="w-px h-5 bg-gray-200 flex-shrink-0" aria-hidden="true"></span>
        <%= link_to "Most yes first", here.call(sort: @sort == "most_yes" ? "signed_up" : "most_yes"), class: chip.call(@sort == "most_yes"), data: { sort: "most_yes" } %>
      <% end %>
      <% if current_user_can_manage?(@production) %>
        <span class="flex-1" aria-hidden="true"></span>
        <button type="button" class="<%= chip.call(false) %> sm:hidden cursor-pointer" data-action="click->bulk-select#toggleSelectMode" data-bulk-select-target="selectModeButton" data-select-mode-button>Select</button>
      <% end %>
    </div>
  <% end %>

    <div class="space-y-1">
      <% if @audition_requests.any? %>
        <% @audition_requests.each do |audition_request| %>
          <% requestable = audition_request.requestable %>
          <% vote_counts = audition_request.vote_counts if current_user_can_review?(@production) %>

          <div class="flex items-stretch px-3 py-2 min-h-[56px] sm:min-h-0 border rounded-lg hover:border-pink-400 transition-all group bg-white border-gray-200 cursor-pointer [&_*]:cursor-pointer" data-request-row>
            <% if current_user_can_manage?(@production) %>
              <div class="flex items-center mr-3 max-sm:hidden" data-bulk-select-target="selectCell">
                <input type="checkbox"
                       value="<%= audition_request.id %>"
                       name="ids[]"
                       form="bulk-archive-form"
                       data-bulk-select-target="checkbox"
                       data-action="change->bulk-select#toggle"
                       class="h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
              </div>
            <% end %>

            <%= link_to manage_signups_auditions_cycle_request_path(@production, @audition_cycle, audition_request),
                class: "flex items-stretch flex-1 min-w-0 cursor-pointer",
                data: { turbo_prefetch: false } do %>

              <%# The review card: headshot, name, votes (chips on a phone, thirds from sm up). %>
              <%= render "shared/review_card", member: requestable, size: :sm,
                    vote_counts: (current_user_can_review?(@production) ? vote_counts : nil) %>
            <% end %>
          </div>
        <% end %>

        <% if current_user_can_manage?(@production) %>
          <!-- Bulk Archive Action Bar -->
          <div data-bulk-select-target="actionBar" class="hidden mt-4 p-3 bg-gray-50 border border-gray-200 rounded-lg flex items-center justify-between max-sm:fixed max-sm:inset-x-0 max-sm:bottom-0 max-sm:z-30 max-sm:mt-0 max-sm:rounded-none max-sm:border-x-0 max-sm:border-b-0 max-sm:bg-white/95 max-sm:backdrop-blur max-sm:pl-4 <%= turbo_native_app? ? 'max-sm:pr-[96px]' : 'max-sm:pr-4' %> max-sm:pt-3 max-sm:pb-[calc(env(safe-area-inset-bottom)+12px)]">
            <div class="flex items-center gap-3">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox"
                       data-bulk-select-target="selectAllCheckbox"
                       data-action="change->bulk-select#toggleAll"
                       class="h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
                <span class="text-sm text-gray-600">Select all</span>
              </label>
              <span data-bulk-select-target="count" class="text-sm font-medium text-gray-700"></span>
            </div>

            <%= form_tag manage_confirm_bulk_archive_signups_auditions_cycle_requests_path(@production, @audition_cycle), method: :post, id: "bulk-archive-form", data: { turbo: false } do %>
              <%= render "shared/button", text: "Archive Selected", variant: "secondary", size: "small", type: :submit %>
            <% end %>
          </div>
        <% end %>
      <% else %>

      <p class="text-gray-500 text-sm pt-2">
        <% if @filter == "unvoted" %>
          You've voted on every one.
        <% elsif @audition_cycle.video_only? %>
          No one has submitted a video audition yet.
        <% else %>
          No one has signed up for an audition yet.
        <% end %>
      </p>
    <% end %>
  </div>

  <div class="mt-6 text-center">
    <%= link_to manage_archived_signups_auditions_cycle_requests_path(@production, @audition_cycle), class: "text-sm text-gray-500 hover:underline" do %>
      <% if @archived_count && @archived_count > 0 %>
        View <%= @archived_count %> archived <%= 'sign-up'.pluralize(@archived_count) %>
      <% else %>
        View archived sign-ups
      <% end %>
    <% end %>
  </div>
</div>
