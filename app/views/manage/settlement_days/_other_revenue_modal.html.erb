<%# A show's other revenue, on the day's worksheet (Tim, 2026-11-03: the old
    Financials worksheet goes; each thing opens its own). Rows of what it
    was and how much; the CocoScout products row Ticketing keeps up stays as
    it is, out of sight. Locals: id, show, financials, return_to %>
<%
  input = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-base sm:text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  items = financials&.normalized_other_revenue_details&.select { |i| i.is_a?(Hash) } || []
  products = items.select { |i| i["description"] == TicketSalesSync::PRODUCTS_LABEL }
  rows = items.reject { |i| i["description"] == TicketSalesSync::PRODUCTS_LABEL }
  row = lambda do |index, description, amount|
    capture do
%>
      <div class="nested-fields flex items-start gap-2">
        <%= text_field_tag "show_financials[other_revenue_details][#{index}][description]", description, id: nil, placeholder: "What it was, like a raffle or a sponsor", class: "#{input} min-w-0 flex-1" %>
        <div class="relative w-32 flex-none">
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-sm text-gray-500">$</span>
          <%= number_field_tag "show_financials[other_revenue_details][#{index}][amount]", amount, id: nil, step: "0.01", min: 0, placeholder: "0.00", class: "#{input} pl-7 tabular-nums" %>
        </div>
        <button type="button" data-action="click->nested-form#remove" class="mt-2.5 text-gray-400 hover:text-red-600 cursor-pointer" aria-label="Remove this line">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
        <input type="hidden" name="show_financials[other_revenue_details][<%= index %>][_destroy]" value="0">
      </div>
<%
    end
  end
%>
<div id="<%= id %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end justify-center sm:items-center sm:p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col max-h-[92vh] sm:max-h-[85vh]" data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-5 sm:px-6 py-4 flex-shrink-0">
      <h3 class="text-lg font-semibold text-white">Other revenue</h3>
      <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <%= form_with url: manage_update_money_show_financials_path(show), method: :patch, class: "flex flex-col min-h-0 flex-1", data: { turbo_action: "replace", controller: "nested-form" } do %>
      <%= hidden_field_tag :return_to, return_to, id: nil %>
      <%= hidden_field_tag "show_financials[other_revenue_details_cleared]", "1", id: nil %>
      <%# Rows are numbered from 0, the products row first: a key that is not a number stops Rails reading them as a list. %>
      <% products.each_with_index do |item, i| %>
        <%= hidden_field_tag "show_financials[other_revenue_details][#{i}][description]", item["description"], id: nil %>
        <%= hidden_field_tag "show_financials[other_revenue_details][#{i}][amount]", item["amount"], id: nil %>
      <% end %>
      <template data-nested-form-target="template"><%= row.call("NEW_CHILD_RECORD", nil, nil) %></template>
      <div class="p-5 sm:p-6 space-y-3 overflow-y-auto min-h-0 flex-1">
        <p class="text-sm text-gray-600">Money this show took in besides tickets: a raffle, a sponsor, a program ad, a cover. <% if products.any? %>Products sold at the door are counted on their own line and are not here.<% end %></p>
        <div class="space-y-2" data-nested-form-target="children">
          <% rows.each_with_index { |item, i| concat row.call(products.size + i, item["description"], item["amount"]) } %>
          <% if rows.empty? %><%= row.call(products.size, nil, nil) %><% end %>
        </div>
        <%= render "shared/button", text: "Another line", variant: "secondary", size: "xs", type: :button, icon: "plus", data: { action: "click->nested-form#add" } %>
      </div>
      <div class="px-5 sm:px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2 flex-shrink-0">
        <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
        <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
  </div>
</div>
