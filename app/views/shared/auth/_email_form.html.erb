<%#
  The first step of signing in or creating an account: the email address.
  Used by /signin and by every page that embeds it (sign-up and audition
  entry, course registration), so they all carry the bot defenses
  (AuthController#signup_gate_passed?): a signed "form served at" stamp and
  an off-screen honeypot.

  Posts to /signin, which shows the next step for that address: a password,
  a code, or (after the code) a new account's name.

  The password field is collapsed out of sight on purpose: a password manager
  that knows this address fills both and signs in with one submit, and
  everyone else never sees it.

  Locals:
    signup_token  from SignupFormToken.generate (a fresh one is minted when
                  the page didn't set one)
    submit_text   default "Continue"
    email_value   prefill
    autofocus     default false
    error         true to draw the pink border
%>
<%
  signup_token = local_assigns[:signup_token] || SignupFormToken.generate
  submit_text  = local_assigns[:submit_text] || "Continue"
%>
<%= form_with url: handle_signin_path, class: "space-y-4" do |form| %>
  <%= hidden_field_tag :step, "start", id: nil %>
  <%= hidden_field_tag :signup_token, signup_token, id: nil %>
  <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true">
    <label for="signup_website">Website</label>
    <input type="text" name="website" id="signup_website" tabindex="-1" autocomplete="off" value="">
  </div>

  <div>
    <label for="email_address" class="mb-1.5 block text-sm font-medium text-slate-700">Email address</label>
    <%= form.email_field :email_address,
        required: true,
        autofocus: local_assigns[:autofocus] || false,
        autocomplete: "username",
        autocapitalize: "none",
        placeholder: "you@example.com",
        value: local_assigns[:email_value],
        class: auth_input_class(error: local_assigns[:error] || false) %>
  </div>

  <div style="height:0;overflow:hidden;opacity:0" aria-hidden="true">
    <input type="password" name="password" id="collapsed_password" tabindex="-1" autocomplete="current-password" maxlength="72">
  </div>

  <div class="pt-1">
    <%= render "shared/button", text: submit_text, variant: "primary", size: "jumbo", type: :submit %>
  </div>
<% end %>
