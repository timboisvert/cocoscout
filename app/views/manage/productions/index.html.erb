<% content_for :title, "Productions" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%= render "shared/module_header", title: "Productions",
        actions: current_user_is_global_manager? ? [ { icon: "calendar", text: "Add a Production", path: manage_productions_wizard_path } ] : [] %>

  <% archived_view = @status == "archived" %>
  <% status_param = archived_view ? "archived" : nil %>
  <%# The filters are for the organization's people, who see every production;
      a production team member just gets their productions (Tim, 2026-10-17). %>
  <% org_wide = Current.user&.superadmin? || %w[manager viewer].include?(Current.user&.default_role) %>
  <% filter_groups = [
    {
      label: "Type",
      filters: [
        { text: "All", path: manage_productions_path(filter: "all", status: status_param), active: @filter == "all" },
        { text: "First-party", path: manage_productions_path(filter: "first_party", status: status_param), active: @filter == "first_party" },
        { text: "Contract", path: manage_productions_path(filter: "contract", status: status_param), active: @filter == "contract" },
        { text: "Course", path: manage_productions_path(filter: "course", status: status_param), active: @filter == "course" }
      ]
    }
  ] %>
  <% if @can_archive %>
    <% filter_groups << {
      label: "Status",
      filters: [
        { text: "Active", path: manage_productions_path(filter: @filter), active: !archived_view },
        { text: "Archived", path: manage_productions_path(filter: @filter, status: "archived"), active: archived_view }
      ]
    } %>
  <% end %>
  <% if org_wide %>
    <%= render "shared/filters/filter_bar", filter_groups: filter_groups %>
  <% end %>

<% if @productions.any? %>
  <%# One row per production (Tim, 2026-10-17): the poster and the name on the
      left, the production team's headshots on the right the way a casting row
      carries the cast, names on hover. A team-less production says so. %>
  <% type_words = { "in_house" => "First-party", "third_party" => "Contract", "course" => "Course" } %>
  <% role_words = { "manager" => "production team manager", "viewer" => "production team viewer" } %>
  <div class="space-y-2">
    <% @productions.each do |production| %>
      <%
        team = @team_by_production[production.id] || []
        invites = @invites_by_production[production.id] || []
        contract_people = @contract_people_by_production[production.id] || []
        next_at = @next_show_by_production[production.id]
        details = []
        details << type_words[production.production_type] if org_wide
        details << (next_at ? "Next date #{next_at.strftime('%b %-d')}" : "No upcoming dates")
        team_path = "#{edit_manage_production_path(production)}#tab-3"
      %>
      <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4 rounded-lg border border-gray-200 bg-white px-4 py-2.5">
        <%= link_to "#{edit_manage_production_path(production)}#tab-0", class: "flex items-center gap-3 min-w-0 flex-1 group #{'opacity-60 hover:opacity-100 transition-opacity' if archived_view}" do %>
          <%= render "shared/production_image", production: production, width: "w-12", classes: "flex-shrink-0", initials_class: "text-base", fallback_aspect: "poster" %>
          <div class="min-w-0">
            <div class="text-sm font-medium text-gray-900 truncate group-hover:text-pink-600"><%= production.name %></div>
            <div class="text-xs text-gray-500"><%= details.join(" · ") %></div>
          </div>
        <% end %>

        <%= link_to team_path, class: "flex items-center gap-1 flex-wrap md:w-80 md:flex-shrink-0 md:border-l border-gray-200 md:pl-4 border-t md:border-t-0 pt-2 md:pt-0" do %>
          <% if contract_people.any? && (team.any? || invites.any?) %>
            <span class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mr-1">Team</span>
          <% end %>
          <% team.each do |permission| %>
            <%
              user = permission.user
              person = user.default_person || user.person
              mine = user == Current.user
              tooltip = "#{mine ? 'You' : (person&.name || user.email_address)} · #{role_words[permission.role]}"
              headshot = person&.safe_headshot_variant(:thumb)
              ring = mine ? " ring-2 ring-pink-400" : ""
            %>
            <% if headshot %>
              <div data-controller="tooltip" data-tooltip-text="<%= tooltip %>">
                <%= image_tag headshot, alt: person.name, class: "w-10 h-10 rounded-lg object-cover#{ring}" %>
              </div>
            <% else %>
              <div class="w-10 h-10 rounded-lg bg-gray-200 text-gray-700 flex items-center justify-center font-bold text-xs<%= ring %>"
                   data-controller="tooltip" data-tooltip-text="<%= tooltip %>">
                <%= person&.initials.presence || user.email_address.first.upcase %>
              </div>
            <% end %>
          <% end %>
          <% invites.each do |invite| %>
            <div class="w-10 h-10 rounded-lg bg-gray-50 border border-dashed border-gray-300 text-gray-400 flex items-center justify-center font-bold text-xs"
                 data-controller="tooltip" data-tooltip-text="<%= invite.email %> · invited as a <%= role_words[invite.invitation_role] || 'production team viewer' %>, not yet accepted">
              <%= invite.person&.initials.presence || invite.email.first.upcase %>
            </div>
          <% end %>
          <% if team.empty? && invites.empty? && contract_people.empty? %>
            <div class="w-10 h-10 rounded-lg bg-gray-50 border border-dashed border-gray-300 flex items-center justify-center text-gray-300">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
              </svg>
            </div>
            <span class="text-xs text-gray-400 ml-1">No production team assigned</span>
          <% end %>
        <% end %>

        <%# The people on its contracts (docs/contract_people_plan.md): the
            contractor's side, who see the production on My. Not the team;
            each head opens their contract. %>
        <% if contract_people.any? %>
          <div class="flex items-center gap-1 flex-wrap md:flex-shrink-0" data-contract-people>
            <span class="text-[10px] font-semibold uppercase tracking-wide text-pink-500 mr-1">Contract</span>
            <% contract_people.each do |person, contract| %>
              <%
                mine = person.user_id.present? && person.user_id == Current.user.id
                tooltip = "#{mine ? 'You' : person.name} · on the contract with #{contract.contractor_name}"
                headshot = person.safe_headshot_variant(:thumb)
                ring = mine ? " ring-2 ring-pink-400" : ""
              %>
              <%= link_to manage_contract_path(contract), data: { controller: "tooltip", tooltip_text: tooltip } do %>
                <% if headshot %>
                  <%= image_tag headshot, alt: person.name, class: "w-10 h-10 rounded-lg object-cover#{ring}" %>
                <% else %>
                  <div class="w-10 h-10 rounded-lg bg-pink-50 text-pink-700 flex items-center justify-center font-bold text-xs<%= ring %>"><%= person.initials %></div>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <% if archived_view %>
          <div class="flex-shrink-0 md:ml-2">
            <%= render "shared/button", text: "Unarchive", variant: "secondary", size: "small",
                  path: unarchive_manage_production_path(production), method: :post %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% elsif archived_view %>
    <%= render "shared/empty_state", icon: "clipboard", title: "No archived productions" %>    <div class="bg-gray-50 rounded-lg border border-dashed border-gray-300 p-8 text-center">
    <p class="text-gray-600">No archived productions.</p>
    </div>
<% else %>
    <%= render "shared/empty_state", icon: "calendar", title: "No productions yet", body: "A production is a show, a run, a festival or a class with a cast and crew.",
          actions: (current_user_is_global_manager? ? [ { text: "Create your first production", path: manage_productions_wizard_path } ] : []) %>
<% end %>
</div>
