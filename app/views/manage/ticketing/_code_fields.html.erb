<%# A new discount code's fields, each with its label, shared by a
    production's and a date's Discount codes tabs. On a phone the code has
    its own line, then the kind and amount, then the most uses.
    Locals: cf (the form builder), input_class. %>
<% label_class = "block text-xs font-medium text-gray-600 mb-1" %>
<div class="grid grid-cols-2 sm:grid-cols-[minmax(0,1fr)_7rem_7rem_7rem] gap-x-2 gap-y-3">
  <div class="col-span-2 sm:col-span-1">
    <%= cf.label :code, "Code", class: label_class %>
    <%= cf.text_field :code, placeholder: "FRIENDS", class: "#{input_class} uppercase" %>
  </div>
  <div>
    <%= cf.label :kind, "Kind", class: label_class %>
    <%= cf.select :kind, options_for_select([ [ "$ off", "fixed" ], [ "% off", "percent" ] ]), {}, class: input_class %>
  </div>
  <div>
    <%= cf.label :amount, "Amount", class: label_class %>
    <%= cf.text_field :amount, inputmode: "decimal", placeholder: "5", class: input_class %>
  </div>
  <div class="col-span-2 sm:col-span-1">
    <%= cf.label :max_uses, "Most uses", class: label_class %>
    <%= cf.number_field :max_uses, min: 1, placeholder: "No limit", class: input_class %>
  </div>
</div>
<%# Who sees the code beside the ticket link on their pages (Tim, 2026-10-17). %>
<fieldset class="mt-3">
  <legend class="<%= label_class %>">Share it with</legend>
  <div class="flex flex-wrap gap-x-5 gap-y-2">
    <% TicketDiscountCode::SHARED_WITH.each do |value| %>
      <label class="flex items-center gap-2 text-sm text-gray-900">
        <%= cf.radio_button :shared_with, value, checked: value == "team_and_cast", class: "h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500" %>
        <%= TicketDiscountCode::SHARED_WITH_LABELS[value] %>
      </label>
    <% end %>
  </div>
  <p class="mt-1 text-xs text-gray-500">They see it beside the ticket link on their pages, to pass along. Buyers only see it when someone gives it to them.</p>
</fieldset>
