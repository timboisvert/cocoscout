<% content_for :title, "Add Everyone Owed" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Money", manage_money_index_path],
      ["Payout Runs", manage_payout_batches_path]
    ],
    text: "Add everyone owed",
    links: []
  } %>

  <div class="max-w-3xl">
    <%# There's one payout run: this adds the balances not on it yet. %>
    <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 mb-6 flex items-start gap-2.5">
      <svg class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <p class="text-sm text-gray-600">
        These are balances owed that aren't on your payout run yet. Adding them puts them on the run beside everything
        already there — nothing is paid until you review the run and fund it.
      </p>
    </div>

    <% unless Current.organization.funding_payment_method_id.present? %>
      <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 mb-6 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-amber-900">Connect a bank account to fund payouts before you run one.</p>
        <%= render "shared/button", text: "Connect a bank account", variant: "primary", size: "small",
              path: manage_connect_payout_funding_path, method: :post, form: { data: { turbo: false } } %>
      </div>
    <% end %>

    <% if @ready.any? %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
        <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between">
          <h3 class="font-semibold text-gray-900">Ready to pay</h3>
          <div class="text-right">
            <div class="text-xs text-gray-500 uppercase tracking-wide">Total</div>
            <div class="text-xl font-bold text-gray-900 tabular-nums"><%= number_to_currency(@ready_total_cents / 100.0) %></div>
          </div>
        </div>
        <div class="divide-y divide-gray-100">
          <% @ready.each do |row| %>
            <details class="group">
              <summary class="px-5 py-3 flex items-center justify-between gap-4 cursor-pointer list-none hover:bg-gray-50">
                <div class="flex items-center gap-2 min-w-0">
                  <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-90 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  <span class="text-gray-900 truncate"><%= row[:payee].name %></span>
                </div>
                <span class="font-semibold text-gray-900 tabular-nums flex-shrink-0"><%= number_to_currency(row[:cents] / 100.0) %></span>
              </summary>
              <div class="bg-gray-50 border-t border-gray-100 px-5 py-1.5 pl-11">
                <% row[:lines].each do |l| %>
                  <div class="flex items-center justify-between gap-4 py-1.5 text-sm">
                    <span class="<%= l[:cents].negative? ? "text-gray-400" : "text-gray-600" %> truncate"><%= l[:label] %></span>
                    <span class="tabular-nums flex-shrink-0 <%= l[:cents].negative? ? "text-gray-400" : "text-gray-800" %>"><%= number_to_currency(l[:cents] / 100.0) %></span>
                  </div>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      </div>

      <%= form_with url: manage_create_payout_batch_path, method: :post, class: "bg-white border border-gray-200 rounded-lg p-5 mb-6 flex flex-wrap items-center justify-between gap-3" do %>
        <p class="text-sm text-gray-600">You'll review the whole run and choose how to fund it before anything is paid.</p>
        <%= render "shared/button", text: "Add to payout run — #{number_to_currency(@ready_total_cents / 100.0)}", variant: "primary", size: "medium", type: :submit %>
      <% end %>
    <% else %>
      <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-8 text-center mb-6">
        <p class="text-gray-600">No one's ready to be paid yet.</p>
        <p class="text-sm text-gray-500 mt-1">Payees show up here once they've connected a bank and have a balance owed.</p>
      </div>
    <% end %>

    <% if @not_ready.any? %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-200">
          <h3 class="font-semibold text-gray-900">Waiting on bank setup</h3>
          <p class="text-sm text-gray-500 mt-0.5">You owe these payees but they haven't connected a bank.</p>
        </div>
        <div class="divide-y divide-gray-100">
          <% @not_ready.each do |row| %>
            <div class="px-5 py-3 flex items-center justify-between">
              <span class="text-gray-700"><%= row[:payee].name %></span>
              <span class="text-gray-500 tabular-nums"><%= number_to_currency(row[:cents] / 100.0) %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
