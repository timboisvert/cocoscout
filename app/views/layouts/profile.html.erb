<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "CocoScout" %></title>
    <meta name="viewport" content="<%= native_viewport %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caprasimo&family=Coustard:wght@400;900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <% show_impersonation_bar = impersonating? && !turbo_native_app? %>

  <body class="inter-regular text-slate-700 bg-[#f9f9f7] <%= "impersonating" if show_impersonation_bar %>" data-controller="profile-visibility profile-nav">

    <%= render "shared/impersonation_bar" if show_impersonation_bar %>

    <div class="flex min-h-screen">

        <% hide_nav = @hide_sidebar || turbo_native_app? %>
        <% unless hide_nav %>
          <% if @show_group_sidebar %>
            <%= render "shared/navigation/profile_group_mobile" %>
            <%= render "shared/navigation/profile_group_header" %>
            <%= render "shared/navigation/profile_group" %>
          <% else %>
            <%= render "shared/navigation/profile_person_mobile" %>
            <%= render "shared/navigation/profile_person" %>
          <% end %>
        <% end %>
        <main class="flex-1 <%= if turbo_native_app? then "px-4 pt-3 pb-8" elsif @hide_sidebar then "" else "px-5 pt-14 lg:ml-64 #{@show_group_sidebar ? 'lg:pt-20' : 'lg:pt-6'}" end %> overflow-x-hidden">
            <%= yield %>
        </main>
        <%= render "shared/native/bridge" %>

    </div>
  </body>
</html>
