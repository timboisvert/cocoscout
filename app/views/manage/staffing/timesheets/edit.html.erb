<%# Loaded into the "timesheet_edit_modal" frame on the approved-hours page. Two
    states: the edit form, and — after saving — a confirmation that the entry has
    gone back to review, offering an in-place re-approve. %>
<%= turbo_frame_tag "timesheet_edit_modal" do %>
  <% if @saved %>
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm overflow-y-auto h-full w-full z-50 flex items-center justify-center p-4"
         data-controller="timesheet-edit-modal"
         data-action="click->timesheet-edit-modal#reloadOnBackdrop keydown.esc@window->timesheet-edit-modal#reload">
      <div class="relative w-full max-w-md bg-white rounded-lg shadow-lg" data-action="click->timesheet-edit-modal#stopPropagation">
        <div class="px-6 py-4 bg-pink-500 rounded-t-lg">
          <h3 class="text-lg font-semibold text-white">Hours updated</h3>
        </div>
        <div class="p-6">
          <div class="flex items-start gap-3">
            <div class="w-9 h-9 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"/></svg>
            </div>
            <div class="text-sm text-gray-600">
              <% if @was_approved %>
                You changed <span class="font-medium text-gray-900"><%= @entry.person.name %></span>'s hours
                (now <span class="font-medium text-gray-900"><%= number_with_precision(@entry.hours, precision: 2, strip_insignificant_zeros: true) %>h</span>),
                so they've gone back to review. Approve them again to make them payable, or leave them in the queue for now.
              <% else %>
                <span class="font-medium text-gray-900"><%= @entry.person.name %></span>'s hours are now
                <span class="font-medium text-gray-900"><%= number_with_precision(@entry.hours, precision: 2, strip_insignificant_zeros: true) %>h</span>.
                Approve them to make them payable, or leave them in the queue for now.
              <% end %>
            </div>
          </div>
          <div class="flex items-center gap-2 mt-6">
            <%= render "shared/button", text: @was_approved ? "Re-approve now" : "Approve now", variant: "primary", size: "medium",
                  path: manage_reapprove_staffing_timesheet_path(@entry), method: :patch,
                  form: { data: { turbo_frame: "_top" } } %>
            <%= render "shared/button", text: @was_approved ? "Keep in review" : "Back to queue", variant: "secondary", size: "medium",
                  path: manage_staffing_timesheets_path, data: { turbo_frame: "_top" } %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm overflow-y-auto h-full w-full z-50 flex items-center justify-center p-4"
         data-controller="timesheet-edit-modal"
         data-action="click->timesheet-edit-modal#closeOnBackdrop keydown.esc@window->timesheet-edit-modal#close">
      <div class="relative w-full max-w-md bg-white rounded-lg shadow-lg" data-action="click->timesheet-edit-modal#stopPropagation">
        <div class="flex items-center justify-between px-6 py-4 bg-pink-500 rounded-t-lg">
          <h3 class="text-lg font-semibold text-white">Edit hours</h3>
          <button type="button" class="text-white/70 hover:text-white cursor-pointer" data-action="click->timesheet-edit-modal#close">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="p-6">
          <div class="flex items-center gap-3 mb-5">
            <% headshot_variant = @entry.person.safe_headshot_variant(:thumb) %>
            <% if headshot_variant %>
              <%= image_tag headshot_variant, alt: @entry.person.name, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
            <% else %>
              <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-sm flex-shrink-0">
                <%= @entry.person.initials %>
              </div>
            <% end %>
            <div class="min-w-0">
              <div class="font-medium text-gray-900 truncate"><%= @entry.person.name %></div>
              <div class="text-xs text-gray-500"><%= @entry.started_at.strftime("%a %b %-d, %Y") %></div>
            </div>
          </div>

          <% if @entry.errors.any? %>
            <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
              <%= @entry.errors.full_messages.to_sentence %>
            </div>
          <% end %>

          <%= form_with model: @entry, url: manage_staffing_timesheet_path(@entry), method: :patch do |f| %>
            <div class="space-y-4">
              <div>
                <%= f.label :started_at, "Clock in", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.datetime_field :started_at, value: @entry.started_at&.strftime("%Y-%m-%dT%H:%M"),
                      class: "w-full rounded-lg border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500" %>
              </div>
              <div>
                <%= f.label :ended_at, "Clock out", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.datetime_field :ended_at, value: @entry.ended_at&.strftime("%Y-%m-%dT%H:%M"),
                      class: "w-full rounded-lg border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500" %>
              </div>
              <div>
                <%= f.label :notes, "Notes", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_area :notes, rows: 2,
                      class: "w-full rounded-lg border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500" %>
              </div>
            </div>

            <p class="text-xs text-gray-500 mt-4">Saving sends this entry back to review so you can re-approve the corrected hours.</p>

            <div class="flex items-center gap-2 mt-5">
              <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
              <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->timesheet-edit-modal#close" } %>
            </div>
          <% end %>

          <%# Actions for an already-approved entry, without editing the hours:
              settle them as paid outside CocoScout (keeps them "approved" in the
              worker's eyes — no bounce back through review), or unapprove to send
              them back to the queue. A still-pending entry is either adjusted or
              rejected, so neither applies. %>
          <% if @entry.approved_at.present? %>
            <div class="flex flex-wrap items-center gap-2 mt-4 pt-4 border-t border-gray-200">
              <% edit_already_paid_cid = "already-paid-edit-#{@entry.id}" %>
              <%= render "shared/button", text: "Already paid", variant: "secondary", size: "medium", type: :button, icon: "check-circle",
                    data: { controller: "modal", action: "click->modal#open", modal_id: edit_already_paid_cid } %>
              <%= render "manage/staffing/timesheets/already_paid_modal", entry: @entry, id: edit_already_paid_cid %>
              <% unapprove_cid = "confirm-unapprove-#{@entry.id}" %>
              <%= render "shared/button", text: "Unapprove & return for review", variant: "secondary", size: "medium", type: :button,
                    data: { controller: "modal", action: "click->modal#open", modal_id: unapprove_cid } %>
              <%= render "shared/confirm_modal", id: unapprove_cid,
                    title: "Send back for review?",
                    message: "Send this entry back to the review queue? You'll need to approve it again.",
                    confirm_text: "Send back",
                    url: manage_unapprove_staffing_timesheet_path(@entry), method: :patch,
                    form_data: { turbo_frame: "_top" } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
