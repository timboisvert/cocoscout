<%# A Codes tab's Export and Import, each a pink modal opened from the ⋯
    menu beside Add code (Tim, 2026-11-07; DiscountCodeCsv). Export says
    what the spreadsheet holds and downloads it; Import takes a CSV file or
    pasted lines. Locals: export_url, import_url, count (the codes listed),
    what ("every date of Stargazers" / "this date only"), input_class. %>
<%
  header_class = "flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4"
  close_class = "rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
%>
<div id="export-codes-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden" data-action="click->modal#stopPropagation">
    <div class="<%= header_class %>">
      <h3 class="text-lg font-semibold text-white">Export discount codes</h3>
      <button type="button" data-action="click->modal#close" class="<%= close_class %>" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="p-6 space-y-3 text-sm text-gray-600">
      <% if count.zero? %>
        <p>There are no codes to export yet: this spreadsheet would be empty.</p>
      <% else %>
        <p>A spreadsheet (CSV) of the <%= pluralize(count, "code") %> good for <%= what %>: each code, what it takes off, its most uses and who it's shared with.</p>
      <% end %>
      <p>Open it in Excel or Numbers, or import it onto another production or date.</p>
    </div>
    <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
      <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
      <%= link_to export_url, data: { turbo: false, action: "click->modal#close" } do %>
        <%= render "shared/button", text: "Download", variant: "primary", size: "medium" %>
      <% end %>
    </div>
  </div>
</div>

<div id="import-codes-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden" data-action="click->modal#stopPropagation">
    <div class="<%= header_class %>">
      <h3 class="text-lg font-semibold text-white">Import discount codes</h3>
      <button type="button" data-action="click->modal#close" class="<%= close_class %>" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <%= form_with url: import_url, method: :post, multipart: true, data: { turbo: false } do %>
      <div class="p-6 space-y-4">
        <p class="text-sm text-gray-600">Adds codes for <%= what %> from a spreadsheet (CSV) with a Code column, and if you have them, Kind ($ off or % off), Amount, Most uses and Shared with: the shape Export makes. A code already here is skipped.</p>
        <div>
          <label for="import-codes-file" class="block text-sm font-medium text-gray-700 mb-1.5">The file</label>
          <%= file_field_tag :file, id: "import-codes-file", accept: ".csv,text/csv", class: "block w-full text-sm text-gray-700" %>
        </div>
        <div>
          <label for="import-codes-text" class="block text-sm font-medium text-gray-700 mb-1.5">Or paste the lines</label>
          <%= text_area_tag :text, nil, id: "import-codes-text", rows: 4, placeholder: "Code,Kind,Amount\nFRIENDS,$ off,5\nCAST,% off,20", class: "#{input_class} font-mono" %>
        </div>
      </div>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
        <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
        <%= render "shared/button", text: "Import codes", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
  </div>
</div>
