<%# "Connect your bank" nudge. Shows to anyone who hasn't finished connecting a
    bank. Works on any "my" page (uses Current.user's person). %>
<% banner_person = @person || Current.user&.person %>
<% if banner_person&.needs_bank_connection? %>
  <%= render "shared/alert_panel",
        eyebrow: "Getting paid",
        headline: "We've upgraded how you get paid",
        body: "Your payments are now more secure, with clearer visibility into what you're owed and when you're paid. If you'd entered payment details before, you'll need to add them again to keep getting paid.",
        actions: [ { text: "Set up payments", path: my_payments_connect_bank_path,
                     method: :post, form: { data: { turbo: false } } } ] %>
<% end %>
