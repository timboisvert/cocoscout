<% content_for :title, "Pricing — CocoScout" %>

<div class="min-h-screen bg-[#f9f9f7]">
  <%= render "shared/marketing/header" %>

  <main class="flex flex-col min-w-full">

    <%# ============================ HERO ============================ %>
    <section class="w-full px-6 pt-16 pb-12 sm:pt-24 sm:pb-16 bg-gradient-to-br from-pink-50 via-white to-slate-50">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-900 mb-5 coustard-regular leading-tight">
          Start free. Pay as you grow.
        </h1>
        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed">
          Run your whole production for free. Add ticketing, payments, contracts, and payroll when
          you're ready — and only pay for what you actually use. Tickets are 50¢ a ticket.
        </p>
      </div>
    </section>

    <%# ============================ TIERS ============================ %>
    <section class="w-full px-6 py-14 sm:py-16">
      <div class="max-w-6xl mx-auto">
        <%= render "home/tier_cards" %>
        <p class="mt-6 text-center text-sm text-slate-500 max-w-2xl mx-auto">
          When you pay your staff and performers through CocoScout, simple usage-based fees apply —
          you only pay for the people you actually pay. No seat licenses, no lock-in.
        </p>
      </div>
    </section>

    <%# ==================== TICKETING FEES ==================== %>
    <section id="ticketing" class="w-full px-6 py-16 sm:py-20 border-t border-slate-100 bg-gradient-to-br from-pink-50 via-white to-slate-50">
      <div class="max-w-5xl mx-auto">
        <div class="max-w-3xl mb-8">
          <p class="text-pink-500 font-bold text-sm uppercase tracking-wide mb-3">Ticketing</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 coustard-regular leading-tight mb-4">50¢ a ticket. Free tickets are free.</h2>
          <p class="text-lg text-slate-600 leading-relaxed">
            Other ticketing sites usually charge a dollar or more per ticket, then add card processing on top.
            CocoScout charges 50¢ per paid ticket, with card processing passed through at cost — the same
            processing every ticketing site charges, just without the markup.
          </p>
        </div>
        <%= render "home/ticketing_fees" %>
      </div>
    </section>

    <%# ==================== FULL COMPARISON ==================== %>
    <section class="w-full px-6 py-16 sm:py-20 border-t border-slate-100 bg-white">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 coustard-regular mb-8">Compare every tier</h2>
        <%= render "home/tier_comparison" %>
      </div>
    </section>

    <%# ============================ FAQ ============================ %>
    <section class="w-full px-6 py-16 sm:py-20 border-t border-slate-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 coustard-regular mb-8">Common questions</h2>
        <div class="space-y-4">
          <% [
            ["Is it really free to start?", "Yes. The Producer tier is free forever — build a production, cast it, take sign-ups, and run courses at no cost."],
            ["When do I need Pro?", "When you want to sell tickets, pay your people, send contracts, or run staffing and payroll for your team."],
            ["What does ticketing cost?", "50¢ per paid ticket, and nothing on free tickets, comps, or cash at the door. There's no monthly ticketing fee and no percentage of the sale. Card processing passes through at cost, and you choose whether the buyer pays it or you absorb it."],
            ["Do you take a cut of the card processing?", "No. Every ticketing site has card processing — ours passes through at exactly what the processor charges, with nothing added on top — and once per order rather than once per ticket."],
            ["How do the usage-based fees work?", "You only pay for the staff and performers you actually pay through CocoScout. Don't pay anyone in a month, and there's nothing extra that month."],
            ["What's Enterprise for?", "Large-scale staffing and full W-2 payroll for major production companies, theatres, and venues. Talk to us and we'll tailor it to your operation."],
            ["Is it free for performers and staff?", "Always. Performers and staff members never pay to use CocoScout."]
          ].each do |q, a| %>
            <div class="rounded-2xl border border-slate-200 bg-white p-6">
              <div class="font-bold text-slate-900 coustard-regular"><%= q %></div>
              <div class="text-slate-600 mt-2 leading-relaxed"><%= a %></div>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <%# ============================ CTA BAND ============================ %>
    <section class="w-full bg-pink-500 text-white px-6 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl coustard-regular mb-3">Run your production for free today.</h2>
        <p class="text-pink-100 text-lg mb-8 max-w-2xl mx-auto">No credit card. Upgrade when you're ready to get paid and pay your team.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <%= link_to "Start free", signup_path(intent: "producer"),
                class: "inline-flex justify-center items-center px-8 py-3 rounded bg-white text-pink-700 font-semibold hover:bg-pink-50 transition" %>
          <%= link_to "Talk to us about Enterprise", "mailto:hello@cocoscout.com",
                class: "inline-flex justify-center items-center px-8 py-3 rounded border border-white/70 text-white font-medium hover:bg-white/10 transition" %>
        </div>
      </div>
    </section>

  </main>

  <%= render "shared/marketing/footer" %>
</div>
