<%# Nudges legacy Venmo/Zelle users to connect a bank for automatic payouts.
    Renders only when the person still needs to connect. Their Venmo/Zelle keeps
    working in the meantime. Works on any "my" page (uses Current.user's person). %>
<% banner_person = @person || Current.user&.person %>
<% if banner_person&.needs_bank_migration_prompt? %>
  <div class="mb-6 rounded-lg border border-pink-200 bg-gradient-to-r from-pink-50 to-white p-4">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-lg bg-pink-100 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11m16-11v11M8 14v3m4-3v3m4-3v3" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-pink-900">We're upgrading how you get paid</p>
          <p class="text-sm text-pink-800/80 mt-0.5 max-w-xl">
            Connect your bank to get paid automatically, straight to your account. Your Venmo/Zelle still works in the meantime.
          </p>
        </div>
      </div>
      <div class="flex-shrink-0">
        <%= render "shared/button", text: "Connect your bank", variant: "primary", size: "small", path: my_payments_connect_bank_path, method: :post, form: { data: { turbo: false } } %>
      </div>
    </div>
  </div>
<% end %>
