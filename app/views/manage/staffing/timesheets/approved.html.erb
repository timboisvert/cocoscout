<% content_for :title, "Approved Hours" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ ["Staffing", manage_staffing_index_path], ["Approve Hours", manage_staffing_timesheets_path] ],
    text: "Approved Hours",
    links: []
  } %>

  <%# Month summary line %>
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-700 mt-6 mb-4">
    <% if @month_entries.zero? %>
      <span class="text-gray-500">No approved hours in <%= @current_month.strftime("%B %Y") %>.</span>
    <% else %>
      <span class="font-semibold text-gray-900"><%= number_with_precision(@month_hours, precision: 2, strip_insignificant_zeros: true) %> hrs</span>
      approved across <span class="font-semibold text-gray-900"><%= pluralize(@month_entries, "entry") %></span>
      in <%= @current_month.strftime("%B %Y") %>
    <% end %>
  </div>

  <%= render "shared/month_calendar",
        current_month: @current_month.to_time,
        month_link: ->(m) { manage_approved_staffing_timesheets_path(month: m.strftime("%Y-%m")) },
        items_by_date: @items_by_date,
        item_partial: "manage/staffing/timesheets/approved_calendar_entry",
        can_go_next: @current_month < Date.current.beginning_of_month,
        empty_text: "No approved hours this month.",
        min_cell: "min-h-[96px]",
        mobile_show_past: true %>

  <p class="text-xs text-gray-500 -mt-4">
    Click an approved entry to correct the hours (which sends it back for review) or send it back to the approval queue.
    Paid entries are locked.
  </p>
</div>

<%# Host frame for the edit / re-approve modal (populated by the entry links). %>
<%= turbo_frame_tag "timesheet_edit_modal" %>
