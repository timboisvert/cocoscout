<%#
  The one way to show an empty list (Tim, 2026-10-21: the "You're all caught
  up" box on My Tasks and the "No upcoming auditions" box are the model):
  a dashed box with a gray icon, a short title, a line that says what would
  fill it, and sometimes a button that does. Used wherever a list that could
  have things has none, in both modes.

  Locals:
    title    the short line ("No shows yet", "You're all caught up")
    body     what would fill it, or what to do (optional)
    icon     check (default: all caught up), inbox, calendar, people, ticket,
             document, bell, search, clipboard, money, star, clock, chat
    actions  [{ text:, path:, method: (optional), data: (optional), type: (optional,
             :button for a modal trigger with no path) }] — the first is pink,
             the rest white (optional)
    compact  true for a smaller box inside a card (py-8, no dashed border)
%>
<%
  icon = local_assigns.fetch(:icon, "check").to_s
  compact = local_assigns[:compact] == true
  actions = local_assigns[:actions] || []
  paths = {
    "check" => "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
    "inbox" => "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    "calendar" => "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
    "people" => "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
    "ticket" => "M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z",
    "document" => "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
    "bell" => "M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9",
    "search" => "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
    "clipboard" => "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01",
    "money" => "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    "star" => "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z",
    "clock" => "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    "chat" => "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
  }
  path = paths.fetch(icon) { paths["check"] }
%>
<div class="<%= compact ? 'rounded-lg' : 'border-2 border-dashed border-gray-200 rounded-lg' %>" data-empty-state="<%= icon %>">
  <div class="text-center <%= compact ? 'py-8 px-4' : 'py-12 px-4' %>">
    <svg class="mx-auto <%= compact ? 'h-10 w-10' : 'h-12 w-12' %> text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= path %>"/>
    </svg>
    <h3 class="mt-2 text-sm font-medium text-gray-900"><%= title %></h3>
    <% if local_assigns[:body].present? %>
      <p class="mt-1 text-sm text-gray-500 max-w-md mx-auto"><%= body %></p>
    <% end %>
    <% if actions.any? %>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        <% actions.each_with_index do |action, i| %>
          <%= render "shared/button", text: action[:text], path: action[:path], method: action[:method], data: action[:data] || {},
                type: action[:type] || :button, variant: action[:variant] || (i.zero? ? "primary" : "secondary"), size: "small" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
