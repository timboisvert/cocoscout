<%# When students get their reminder before each class session. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
%>
<div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
  <%= render "shared/section_heading", title: "Reminders", intro: "Students get the time and the place again, once per session, sent at 10am." %>
  <%= form_with url: manage_course_settings_reminders_path, method: :patch do %>
    <div class="px-6 py-5">
      <label for="course_reminder_days_before" class="block text-sm font-medium text-gray-700 mb-1.5">Reminder email</label>
      <%= select_tag :course_reminder_days_before,
            options_for_select([ [ "Off", "" ] ] + (1..30).map { |days| [ "#{pluralize(days, 'day')} before each session", days ] }, @organization.course_reminder_days_before),
            class: "#{input_class} max-w-xs" %>
    </div>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
    </div>
  <% end %>
</div>
