<%#
  Pull in tips: the same window as Pull in approved hours (Tim, 2026-11-11).
  Everyone with tips waiting from settled days, checked by default, with the
  days and the amount. Confirming puts each chosen person's shares on their
  tips worksheet (pay-tips#pull); nothing is saved until the pay is added.

  Locals:
    members_with_tips - [[member, [TipShare]]]
%>
<div id="pull-tips-modal" class="hidden fixed inset-0 z-50" data-pay-tips-target="pullModal">
  <div class="fixed inset-0 bg-black/50" data-action="click->pay-tips#closePull"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4 max-sm:items-end max-sm:p-0">
    <div class="bg-white rounded-xl shadow-xl max-w-2xl w-full overflow-hidden flex flex-col max-h-[85vh] max-sm:max-w-none max-sm:rounded-b-none max-sm:pb-[env(safe-area-inset-bottom)]" data-pay-sheet>
      <div class="flex items-center justify-between px-6 py-4 bg-gradient-to-r from-pink-500 to-pink-600 flex-shrink-0">
        <h3 class="text-lg font-bold text-white">Pull in tips</h3>
        <button type="button" data-action="click->pay-tips#closePull" class="text-white/80 hover:text-white cursor-pointer" aria-label="Close">
          <%= icon("x-mark", class: "w-5 h-5") %>
        </button>
      </div>

      <div class="px-6 py-4 overflow-y-auto">
        <div class="flex items-center justify-between mb-3">
          <p class="text-sm text-gray-600">
            Everyone with tips waiting from days you've settled. Uncheck anyone you're not paying this time.
          </p>
          <div class="flex items-center gap-2 flex-shrink-0 ml-4">
            <button type="button" data-action="click->pay-tips#pullSelectAll"
                    class="text-xs text-pink-600 hover:text-pink-700 underline cursor-pointer bg-transparent border-0 p-0">All</button>
            <span class="text-gray-300">·</span>
            <button type="button" data-action="click->pay-tips#pullSelectNone"
                    class="text-xs text-gray-500 hover:text-gray-700 underline cursor-pointer bg-transparent border-0 p-0">None</button>
          </div>
        </div>

        <div class="rounded-lg border border-gray-200 divide-y divide-gray-100">
          <% members_with_tips.each do |member, shares| %>
            <%
              through_us = shares.select(&:payout?).sum(&:owed_cents)
              in_cash = shares.select(&:cash?).sum(&:owed_cents)
              amounts = [ (number_to_currency(through_us / 100.0) if through_us.positive?), ("#{number_to_currency(in_cash / 100.0)} cash, for the record" if in_cash.positive?) ].compact
            %>
            <label class="flex items-start gap-3 px-3 py-2.5 cursor-pointer hover:bg-gray-50">
              <input type="checkbox" checked
                     class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500"
                     data-pay-tips-target="pullCheckbox"
                     data-member-id="<%= member.id %>">
              <span class="flex-1 min-w-0">
                <span class="flex items-baseline justify-between gap-3">
                  <span class="text-sm font-medium text-gray-900 truncate"><%= member.person&.name %></span>
                  <span class="text-sm text-gray-900 tabular-nums flex-shrink-0"><%= amounts.join(" · ") %></span>
                </span>
                <span class="block text-xs text-gray-500 mt-0.5">
                  <%= shares.map { |share| "#{share.day_label} #{number_to_currency(share.owed_cents / 100.0)}" }.first(4).to_sentence %><%= " and more" if shares.size > 4 %>
                </span>
              </span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 px-6 py-3 border-t border-gray-200 flex-shrink-0">
        <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->pay-tips#closePull" } %>
        <%= render "shared/button", text: "Add these tips", variant: "primary", size: "medium", type: :button,
              data: { action: "click->pay-tips#pullConfirm" } %>
      </div>
    </div>
  </div>
</div>
