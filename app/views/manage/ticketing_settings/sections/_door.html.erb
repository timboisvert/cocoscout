<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  select_class = "px-3 py-2 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
  # Two levels, the second including the first (Tim, 2026-10-16).
  level_choices = [
    [ "check_in", TicketingAccessGrant::LEVEL_LABELS["check_in"], "Scan tickets, find people by name, and check them in." ],
    [ "box_office", TicketingAccessGrant::LEVEL_LABELS["box_office"], "All of that, plus cash sales and comps at the door." ]
  ]
  staff_with_accounts, staff_without_accounts = @door_staff.partition { |member| member.person&.user_id.present? }
  in_app_choices = [
    [ "smart", "On show days", "From the morning of a show with tickets until an hour after it ends, or 2 AM when it has no end time." ],
    [ "always", "All the time", "For selling ahead or trying the door out. When nothing's on, it opens the list of your coming shows." ]
  ]
%>

<div class="space-y-6">
  <%# When the Door shows in the app's menu (DoorTonight). %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">In the CocoScout app</h2>
      <p class="text-sm text-gray-600 mt-1">Door people find the Door at the bottom of the app's menu. Choose when it's there. In a phone's browser, cocoscout.com/door always works.</p>
    </div>
    <%= form_with model: ticketing_profile, url: manage_ticketing_door_in_app_path, method: :patch do |f| %>
      <fieldset class="px-6 py-4">
        <legend class="sr-only">When the Door shows in the app</legend>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <% in_app_choices.each do |value, title, explanation| %>
            <label class="flex items-start gap-3 rounded-lg border border-gray-200 px-4 py-3 cursor-pointer has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50">
              <%= f.radio_button :door_in_app, value, class: "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500" %>
              <span>
                <span class="block text-sm font-medium text-gray-900"><%= title %></span>
                <span class="block text-xs text-gray-600 mt-0.5"><%= explanation %></span>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>
      <div class="px-6 pb-4">
        <label for="ticketing_profile_door_hours_before" class="block text-sm font-medium text-gray-700 mb-1.5">On show days, it appears</label>
        <%= f.select :door_hours_before,
              [ [ "The morning of the show", "" ] ] + TicketingProfile::DOOR_HOURS_BEFORE.map { |hours| [ "#{pluralize(hours, 'hour')} before the show", hours ] },
              {}, class: "#{select_class} w-full max-w-xs" %>
      </div>
      <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
        <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
      </div>
    <% end %>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Who can work the door</h2>
      <p class="text-sm text-gray-600 mt-1">Give access to anyone who checks people in or sells on show nights. They sign in to CocoScout on their phone and open <span class="font-medium text-gray-900">cocoscout.com/door</span>. Refunds, prices and settings stay with managers.</p>
    </div>

    <%# The organization's managers, first and greyed: always the whole door
        (Tim, 2026-10-16). Who they are is the organization's team page. %>
    <div class="px-6 py-3 bg-gray-50 border-b border-gray-100 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-xs text-gray-500" data-door-managers>
      <span class="min-w-0"><span class="font-medium text-gray-600"><%= @door_managers.to_sentence %></span> · organization managers can always check people in and sell tickets.</span>
      <%= link_to "Organization team", section_manage_organization_path(Current.organization, section: "team"), class: "text-pink-600 hover:text-pink-700 underline flex-shrink-0" %>
    </div>

    <% if @door_grants.any? %>
      <ul class="divide-y divide-gray-100">
        <% @door_grants.each do |grant| %>
          <% person = grant.user&.person %>
          <% name = grant.display_name %>
          <% headshot_variant = person&.safe_headshot_variant(:thumb) %>
          <li class="flex flex-wrap items-center gap-3 px-6 py-3">
            <% if headshot_variant %>
              <%= image_tag headshot_variant, alt: name, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
            <% else %>
              <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-sm flex-shrink-0"><%= person&.initials %></div>
            <% end %>
            <div class="min-w-[9rem] flex-1">
              <div class="text-sm font-medium text-gray-900 truncate"><%= name %></div>
              <div class="text-xs text-gray-500 truncate">
                <% if grant.pending? %>
                  Invited <%= grant.invited_at&.strftime("%b %-d") %> · <%= grant.invited_email %> · hasn't accepted yet
                <% else %>
                  <%= grant.user.email_address %>
                <% end %>
              </div>
            </div>
            <% if grant.pending? %>
              <%= render "shared/button", text: "Resend", variant: "ghost", size: "small", path: manage_ticketing_door_invite_resend_path(grant), method: :post %>
            <% end %>
            <%= form_with url: manage_ticketing_door_access_grant_path(grant), method: :patch, data: { controller: "auto-submit" } do %>
              <%= select_tag :access_level, options_for_select(TicketingAccessGrant::LEVEL_LABELS.invert, grant.access_level),
                    "aria-label": "What #{name} can do", class: select_class, data: { action: "change->auto-submit#submit" } %>
            <% end %>
            <% modal_id = "revoke-door-access-#{grant.id}" %>
            <%= render "shared/button", text: "Remove", variant: "secondary", size: "small", type: :button,
                  data: { controller: "modal", action: "click->modal#open", modal_id: modal_id } %>
            <%= render "shared/confirm_modal", id: modal_id,
                  title: "Remove door access?",
                  message: grant.pending? ? "The invitation to #{grant.invited_email} stops working." : "#{name} won't be able to check people in or sell at the door. You can add them again any time.",
                  confirm_text: grant.pending? ? "Withdraw invitation" : "Remove access",
                  url: manage_ticketing_door_access_grant_path(grant), method: :delete %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-6 py-5 text-sm text-gray-500">Nobody else yet. Add staff or anyone on CocoScout below.</p>
    <% end %>
  </div>

  <%# Staff: tick several at once. %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Add staff</h2>
    </div>
    <% if staff_with_accounts.any? %>
      <%= form_with url: manage_ticketing_door_access_path, method: :post do %>
        <div class="px-6 py-4 max-h-80 overflow-y-auto space-y-1">
          <% staff_with_accounts.each do |member| %>
            <label class="flex items-center gap-3 rounded-lg px-2 py-1.5 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "staff_member_ids[]", member.id, false, id: "door_staff_#{member.id}",
                    class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
              <span class="text-sm text-gray-900"><%= staff_name_with_pronouns(member) %></span>
            </label>
          <% end %>
          <% if staff_without_accounts.any? %>
            <p class="px-2 pt-3 text-xs text-gray-500">Not on CocoScout yet, so they can't be added: <%= staff_without_accounts.map(&:display_name).to_sentence %>.</p>
          <% end %>
        </div>
        <%= render "manage/ticketing_settings/door_level_choice", level_choices: level_choices, prefix: "staff" %>
        <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
          <%= render "shared/button", text: "Give door access", variant: "primary", size: "small", type: :submit %>
        </div>
      <% end %>
    <% else %>
      <p class="px-6 py-5 text-sm text-gray-500">
        <% if staff_without_accounts.any? %>
          Your staff who aren't managers or already listed above don't have CocoScout accounts yet.
        <% else %>
          Every staff member is a manager or already has door access.
        <% end %>
      </p>
    <% end %>
  </div>

  <%# Anyone else on CocoScout: search, choose, pick a level. %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden"
       data-controller="door-access-search" data-door-access-search-url-value="<%= manage_ticketing_door_search_path %>">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Add someone else</h2>
      <p class="text-sm text-gray-600 mt-1">A volunteer or a friend of your organization: anyone with a CocoScout account.</p>
    </div>
    <div class="px-6 py-4" data-door-access-search-target="searchSection">
      <label for="door-access-search" class="block text-sm font-medium text-gray-700 mb-1.5">Find them by name or email</label>
      <input id="door-access-search" type="search" autocomplete="off" class="<%= input_class %>"
             data-door-access-search-target="input" data-action="input->door-access-search#search">
      <div class="mt-3" data-door-access-search-target="results"></div>
    </div>
    <%= form_with url: manage_ticketing_door_access_path, method: :post, class: "hidden", data: { door_access_search_target: "form" } do %>
      <%= hidden_field_tag :person_id, nil, data: { door_access_search_target: "personId" } %>
      <div class="px-6 pt-4 flex items-center justify-between gap-3">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900 truncate" data-door-access-search-target="selectedName"></div>
          <div class="text-xs text-gray-500 truncate" data-door-access-search-target="selectedEmail"></div>
        </div>
        <%= render "shared/button", text: "Choose someone else", variant: "ghost", size: "small", type: :button,
              data: { action: "click->door-access-search#back" } %>
      </div>
      <%= render "manage/ticketing_settings/door_level_choice", level_choices: level_choices, prefix: "person" %>
      <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
        <%= render "shared/button", text: "Give door access", variant: "primary", size: "small", type: :submit %>
      </div>
    <% end %>
  </div>
</div>
