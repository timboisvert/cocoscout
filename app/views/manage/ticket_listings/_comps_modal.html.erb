<%# Give tickets (comps): one person at a time, from the Comps tile on the
    show's page. Free, no fees; they take seats. Name, how many and which
    ticket on one line (no choosing when there's one type), a note, then
    "Email them their tickets", which asks for their email and needs it
    (Tim, 2026-10-09). Locals: id, listing. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  label_class = "block text-sm font-medium text-gray-700 mb-1.5"
  tiers = listing.ticket_tiers.active.reject(&:bundle?)
  inventory = listing.inventory
  remaining = inventory.remaining
  # Seats left per type: sold here, sold elsewhere and comps all take them.
  left_of = tiers.to_h { |t| [ t.id, inventory.remaining(tier: t) ] }
  full_ids = left_of.select { |_, left| left == 0 }.keys
  open_tiers = tiers.reject { |t| full_ids.include?(t.id) }
  default_tier = (open_tiers.find { |t| t.price_cents.zero? } || open_tiers.first)&.id
  tier_label = lambda do |t|
    left = left_of[t.id]
    note = if left == 0 then "no seats left"
           elsif !t.available? then "#{TicketTier::AVAILABILITY_LABELS[t.effective_availability].downcase} here#{", #{left} left" if left}"
           elsif left then "#{left} left"
           end
    "#{t.name} (#{ticket_price(t.price_cents)})#{" · #{note}" if note}"
  end
  most = [ 20, remaining ].compact.min.clamp(1, 20)
%>
<div id="<%= id %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden" data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white">Give tickets</h3>
      <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <%= form_with url: manage_ticket_listing_comps_path(listing), method: :post, data: { turbo: false } do %>
      <div class="p-6 space-y-5">
        <p class="text-sm text-gray-600">
          Free tickets for a guest, with no fees. They take seats<%= remaining ? " (#{remaining} left)" : "" %>.
        </p>

        <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] sm:grid-cols-[minmax(0,1fr)_7rem_minmax(0,1fr)] gap-4">
          <div class="col-span-2 sm:col-span-1">
            <label for="comp_name" class="<%= label_class %>">Name</label>
            <%= text_field_tag :name, nil, id: "comp_name", placeholder: "Their name", required: true, autocomplete: "off", class: input_class %>
          </div>
          <div>
            <label for="comp_quantity" class="<%= label_class %>">How many</label>
            <%= select_tag :quantity, options_for_select((1..most).to_a, 1), id: "comp_quantity", class: input_class %>
          </div>
          <div>
            <% if tiers.one? %>
              <%# One ticket type: nothing to choose. %>
              <p class="<%= label_class %>">Ticket</p>
              <%= hidden_field_tag :tier_id, tiers.first.id, id: "comp_tier_id" %>
              <p class="py-2.5 text-sm text-gray-900"><%= tier_label.call(tiers.first) %></p>
            <% else %>
              <label for="comp_tier_id" class="<%= label_class %>">Ticket</label>
              <%= select_tag :tier_id, options_for_select(tiers.map { |t| [ tier_label.call(t), t.id ] }, selected: default_tier, disabled: full_ids), id: "comp_tier_id", class: input_class %>
            <% end %>
          </div>
        </div>

        <div>
          <label for="comp_note" class="<%= label_class %>">Note for your records <span class="font-normal text-gray-500">(optional)</span></label>
          <%= text_field_tag :note, nil, id: "comp_note", placeholder: "Guest of the cast", class: input_class %>
        </div>

        <%# Emailing their tickets needs their email: off, there's nothing to fill in. %>
        <div class="pt-5 border-t border-gray-200 space-y-4" data-controller="toggle-section fieldset-toggle">
          <div class="flex items-center justify-between gap-4">
            <div>
              <div class="text-sm font-medium text-gray-900">Email them their tickets</div>
              <div class="text-xs text-gray-600 mt-0.5">The usual email with their QR codes. Off, you hand them over yourself.</div>
            </div>
            <%= render "shared/toggle_switch", name: "email_them", checked: true, hidden_false: true, id: "comp_email_them", aria_label: "Email them their tickets",
                  data: { toggle_section_target: "toggle", fieldset_toggle_target: "switch", action: "change->toggle-section#toggle change->fieldset-toggle#toggle" } %>
          </div>
          <fieldset data-toggle-section-target="content" data-fieldset-toggle-target="fields" class="min-w-0">
            <label for="comp_email" class="<%= label_class %>">Their email</label>
            <%= email_field_tag :email, nil, id: "comp_email", placeholder: "their@email.com", required: true, autocomplete: "off", class: input_class %>
          </fieldset>
        </div>
      </div>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
        <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
        <%= render "shared/button", text: "Give tickets", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
  </div>
</div>
