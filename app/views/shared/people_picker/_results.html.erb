<%# What the People Picker found (Manage::PeoplePickerController#search).
    Locals: query, listing (the pool before a search), people, groups,
    outside, already ({ "Person_1" => label }), badges ({ "Person_1" =>
    [labels] }), ineligible (keys), invite_email, invite_name, guest,
    extras ({ "Person_1" => { pick: { more for the pick }, detail: words
    under the name } }), heading, empty. %>
<% rows = (people + groups) %>
<% if query.to_s.length < 2 && !listing %>
  <p class="text-sm text-gray-400 text-center py-6">Type a name to find someone.</p>
<% elsif rows.empty? && outside.empty? && invite_email.blank? && !(guest && !listing) %>
  <div class="text-center py-6">
    <p class="text-sm text-gray-500"><%= local_assigns[:empty] || (listing ? "Nobody's in the talent pool yet." : "Nobody found for \"#{query}\".") %></p>
    <% if query.include?("@") %>
      <p class="text-xs text-gray-400 mt-1">Search by their exact email to find someone on CocoScout.</p>
    <% end %>
  </div>
<% else %>
  <% section = ->(label) { tag.div(label, class: "text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-1 pt-3 pb-1.5 first:pt-0") } %>
  <% if rows.any? %>
    <%= section.call(local_assigns[:heading] || (listing ? "In the talent pool" : "In your organization")) %>
    <div class="rounded-lg border border-gray-200 divide-y divide-gray-100 overflow-hidden">
      <% (listing ? rows : rows.sort_by { |m| m.name.to_s.downcase }).each do |member| %>
        <% key = "#{member.class.name}_#{member.id}" %>
        <% extra = (local_assigns[:extras] || {})[key] || {} %>
        <%= render "shared/people_picker/row", member: member, query: query, connected: true,
              taken: already[key], badges: badges[key], eligible: !ineligible.include?(key), extra: extra[:pick], detail: extra[:detail] %>
      <% end %>
    </div>
  <% end %>
  <% if outside.any? %>
    <%= section.call("On CocoScout, not in your organization") %>
    <div class="rounded-lg border border-pink-200 divide-y divide-pink-100 overflow-hidden">
      <% outside.each do |person| %>
        <%= render "shared/people_picker/row", member: person, query: query, connected: false, taken: already["Person_#{person.id}"], badges: [], eligible: true, extra: nil, detail: nil %>
      <% end %>
    </div>
  <% end %>
  <% if invite_email.present? %>
    <%= section.call("Not on CocoScout yet") %>
    <div class="rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 p-3" data-people-picker-invite>
      <p class="text-sm text-gray-600">Nobody has <span class="font-medium text-gray-900"><%= invite_email %></span>. Invite them and they'll be added when they accept.</p>
      <% if invite_name %>
        <input type="text" placeholder="Their name" data-people-picker-target="inviteName"
               class="mt-2 block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
      <% end %>
      <div class="mt-2">
        <%= render "shared/button", text: "Invite #{invite_email}", variant: "primary", size: "small", type: :button,
              data: { action: "click->people-picker#invite", email: invite_email } %>
      </div>
    </div>
  <% end %>
  <% if guest && !listing %>
    <%= section.call("Not on the list") %>
    <div class="rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 p-3" data-people-picker-guest>
      <p class="text-sm text-gray-600">Add a guest by name; an email lets them be reached.</p>
      <input type="text" value="<%= query unless query.include?("@") %>" placeholder="Their name" data-people-picker-target="guestName"
             class="mt-2 block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
      <input type="email" value="<%= query if query.include?("@") %>" placeholder="Email (optional)" data-people-picker-target="guestEmail"
             class="mt-2 block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
      <div class="mt-2">
        <%= render "shared/button", text: "Add as a guest", variant: "secondary", size: "small", type: :button,
              data: { action: "click->people-picker#guest" } %>
      </div>
    </div>
  <% end %>
<% end %>
