<% content_for :title, "Add Staff Member - #{step_name}" %>

<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Staffing", manage_staffing_index_path]
    ],
    text: "Add Staff Member",
    links: []
  } %>

  <%
    # The data-collection steps. On the staged steps (Invite/Agreement/Send) they
    # collapse into a single "Set up" group node, exactly like the contract wizard.
    setup_steps = [
      { name: "Details", path: manage_new_staffing_staff_wizard_path },
      { name: "Job", path: manage_job_staffing_staff_wizard_path },
      { name: "Manager", path: manage_manager_staffing_staff_wizard_path },
      { name: "Start", path: manage_start_staffing_staff_wizard_path },
      { name: "Roles", path: manage_roles_staffing_staff_wizard_path },
      { name: "Review", path: manage_review_staffing_staff_wizard_path }
    ]

    if current_step >= 7
      wizard_steps = [
        { name: "Set up", path: manage_review_staffing_staff_wizard_path, substeps: setup_steps },
        { name: "Invite", path: manage_invite_staffing_staff_wizard_path },
        { name: "Agreement", path: manage_agreement_staffing_staff_wizard_path },
        { name: "Send", path: manage_send_staffing_staff_wizard_path }
      ]
      current_index = { 7 => 1, 8 => 2, 9 => 3 }[current_step] || 0
    else
      wizard_steps = setup_steps
      current_index = current_step - 1
    end
  %>
  <%# Full-width step bar, directly below the breadcrumb. %>
  <%= render "shared/wizard_steps", steps: wizard_steps, current_index: current_index %>

  <div class="max-w-2xl mx-auto mt-8">
    <!-- Step Content -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <%= yield %>
    </div>

    <!-- Cancel Link -->
    <div class="mt-4 text-center">
      <% cancel_wizard_cid = "confirm-cancel-wizard" %>
      <button type="button"
              data-controller="modal"
              data-action="click->modal#open"
              data-modal-id="<%= cancel_wizard_cid %>"
              class="text-sm text-gray-500 hover:text-gray-700 cursor-pointer bg-transparent border-0">Cancel</button>
      <%= render "shared/confirm_modal", id: cancel_wizard_cid,
            title: "Discard this staff member?",
            message: "Your progress will be lost.",
            confirm_text: "Discard",
            cancel_text: "Keep editing",
            url: manage_cancel_staffing_staff_wizard_path, method: :delete %>
    </div>
  </div>
</div>
