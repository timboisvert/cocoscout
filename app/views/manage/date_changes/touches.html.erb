<% content_for :title, @change.cancel? ? "Cancel: what it touches" : "Move: what it touches" %>
<%#
  Step 3: everything the change touches, each with what CocoScout will do
  about it, a default for each, and every message read and editable before
  it goes. On a phone each part is one row that opens as a sheet.
%>
<%
  show = @change.show
  name = show.display_name.presence || @production.name
  back = @change.cancel? ? manage_date_change_dates_path(@change) : manage_date_change_when_path(@change)
%>
<div class="w-full mb-10">
  <%= render "manage/date_changes/header", change: @change, show: show, production: @production,
        title: "#{@change.cancel? ? 'Cancel' : 'Move'} #{name}", index: 2 %>

  <%= form_with url: manage_date_change_touches_path(@change), method: :patch, data: { controller: "auto-submit", turbo_action: "replace" } do %>
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="space-y-4 sm:space-y-6 min-w-0">
        <p class="text-sm text-gray-600">
          <% if @change.cancel? %>
            Everything canceling <%= @plan.acting_shows.size == 1 ? "this date" : "these #{@plan.acting_shows.size} dates" %> touches, with what CocoScout will do about each. Change anything that's wrong.
          <% else %>
            Everything moving <%= @plan.acting_shows.size == 1 ? "this date" : "these #{@plan.acting_shows.size} dates" %> touches, with what CocoScout will do about each. Change anything that's wrong.
          <% end %>
          <span class="sm:hidden">Tap a row to change what happens.</span>
        </p>
        <%= render(@change.cancel? ? "manage/date_changes/touches_cancel" : "manage/date_changes/touches_move", change: @change, plan: @plan, previews: @previews) %>

        <% automatic = @change.cancel? ? @plan.automatic : move_automatic(@change, @dests) %>
        <% if automatic.any? %>
          <div class="bg-gray-50 border border-gray-200 rounded-xl px-6 py-4 max-sm:px-4">
            <p class="text-sm font-semibold text-gray-900 mb-2">These happen on their own</p>
            <ul class="space-y-1 text-sm text-gray-700 list-disc pl-5">
              <% automatic.each do |line| %><li><%= line %></li><% end %>
            </ul>
          </div>
        <% end %>
      </div>

      <aside class="hidden sm:block">
        <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 lg:sticky lg:top-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">When you confirm</p>
          <% review = ShowChangePlan::Review.new(@change, @plan, dests: @dests) %>
          <p class="mt-1 text-lg font-semibold text-gray-900"><%= review.headline.sub(/\AReady to /, "").upcase_first %></p>
          <ul class="mt-3 space-y-1.5 text-sm text-gray-700 list-disc pl-5">
            <% review.sentences.first(6).each do |line| %><li><%= line %></li><% end %>
          </ul>
          <div class="mt-4 hidden sm:flex flex-col gap-2">
            <%= render "shared/button", text: "Review", variant: "primary", size: "medium", type: :submit, name: "commit", value: "review", data: { turbo_action: "advance" }, classes: "w-full" %>
            <%= link_to back do %>
              <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", type: :button, classes: "w-full" %>
            <% end %>
          </div>
        </div>
      </aside>
    </div>

    <div class="sm:hidden sticky bottom-0 -mx-4 mt-6 px-4 py-3 bg-white border-t border-gray-200 flex gap-3 z-40">
      <%= link_to back, class: "flex-1" do %>
        <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", type: :button, classes: "w-full" %>
      <% end %>
      <%= render "shared/button", text: "Review", variant: "primary", size: "medium", type: :submit, name: "commit", value: "review", data: { turbo_action: "advance" }, classes: "flex-[2] w-full" %>
    </div>
  <% end %>
</div>
