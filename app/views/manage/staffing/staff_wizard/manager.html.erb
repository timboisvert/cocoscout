<%= render layout: "manage/staffing/staff_wizard/wizard_layout", locals: { current_step: 3, step_name: "Manager" } do %>
  <h2 class="text-xl font-bold text-gray-900 mb-2 coustard-regular">Do they have a manager?</h2>
  <p class="text-gray-600 mb-6">Who they report to on your team. You can skip this if they don't report to anyone.</p>

  <%= form_with url: manage_save_manager_staffing_staff_wizard_path, method: :post, class: "space-y-6" do %>
    <%= render "manage/staffing/manager_picker", staff: @managers, selected: @selected_manager %>

    <div class="flex items-center justify-between pt-4 border-t border-gray-200">
      <%= link_to "← Back", manage_job_staffing_staff_wizard_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
      <%= render "shared/button", text: "Continue", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>
