<% content_for :title, @production ? "#{@production.name} Financials" : "Financials" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%
    if @production && @is_course
      top_links = [
        { text: "View Course", path: manage_course_offering_path(@course_offering) }
      ]
      if @course_offering&.course_offering_payout
        top_links << { text: "Manage Payout", path: manage_course_offering_payout_path(@course_offering) }
      end
      if @course_offering&.contract
        top_links << { text: "View Contract", path: manage_contract_path(@course_offering.contract) }
      end
    elsif @production && !@is_third_party
      top_links = [{ text: "Production Expenses", path: manage_money_financials_production_expenses_path(@production) }]
    elsif @is_third_party && @contract
      top_links = [
        { text: "View Contract", path: manage_contract_path(@contract) },
        { text: "Production Expenses", path: manage_money_financials_production_expenses_path(@production) }
      ]
    else
      top_links = []
    end
  %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: @production ? [
      ["Money", manage_money_index_path],
      ["Financials", manage_money_financials_path]
    ] : [
      ["Money", manage_money_index_path]
    ],
    text: @production ? (@is_course && @course_offering ? @course_offering.title : @production.name) : "Financials",
    links: top_links
  } %>

  <% if @production && @is_course %>
    <%# Course financials — money in (registrations) − money out (platform fee +
        instructor payouts) = profit. Same shape as a production. %>
    <%= render "shared/money_summary",
      title: "Financials",
      money_in: @money_in,
      money_out: @money_out,
      profit: @money_profit %>

    <% if @course_offering&.contract %>
      <div class="mb-2"><%= render "manage/money_financials/contract_bar", contract: @course_offering.contract %></div>
    <% end %>

    <%= render layout: "shared/slim_list", locals: { label: "Course", columns: [ "Revenue", "Costs", "Profit" ] } do %>
      <%= render "shared/slim_list_row",
        title: "Registrations",
        subtitle: "#{@course[:confirmed_count]} confirmed#{@course[:refunded_count].to_i.positive? ? " · #{@course[:refunded_count]} refunded" : ''}",
        cells: [
          { value: number_to_currency((@course[:gross_cents] || 0) / 100.0) },
          { value: "" },
          { value: "" }
        ] %>
      <%= render "shared/slim_list_row",
        title: "Platform fee",
        subtitle: "CocoScout",
        cells: [
          { value: "" },
          { value: "−#{number_to_currency((@course[:fee_cents] || 0) / 100.0)}", class: "text-red-600" },
          { value: "" }
        ] %>
      <% @course_offering&.course_offering_payout&.line_items&.each do |li| %>
        <%= render "shared/slim_list_row",
          title: li.payee_name,
          subtitle: "Instructor payout#{li.paid? ? ' · paid' : ''}",
          cells: [
            { value: "" },
            { value: "−#{number_to_currency(li.amount_cents / 100.0)}", class: "text-red-600" },
            { value: "" }
          ] %>
      <% end %>
    <% end %>

    <% if @course_offering %>
      <div class="mt-3">
        <%= link_to "Manage course payouts →", manage_course_offering_payout_path(@course_offering), class: "text-sm font-medium text-pink-600 hover:text-pink-700" %>
      </div>
    <% end %>

  <% elsif @production %>
    <%# Single production — ours or a contract (venue rental / co-pro). Same money
        in/out/profit + slim events list as the accordion on the list page. %>
    <%= render "shared/money_summary",
      title: "Financials",
      money_in: @money_in,
      money_out: @money_out,
      profit: @money_profit,
      selected_period: @selected_period,
      period_path: manage_money_production_financials_path(@production),
      refresh_url: manage_refresh_money_path %>

    <% if @production.contract %>
      <div class="mb-2"><%= render "manage/money_financials/contract_bar", contract: @production.contract %></div>
    <% end %>

    <%= render layout: "shared/slim_list", locals: { label: "Event", columns: [ "Revenue", "Costs", "Profit" ] } do %>
      <%= render "manage/money_financials/event_rows", shows: @shows || [] %>
    <% end %>
  <% else %>
    <%# All Productions View - Production List %>
    <%= render "shared/money_summary",
      title: "Financials",
      money_in: @financial_summary[:gross_revenue],
      money_out: @financial_summary[:cost_of_shows],
      profit: @financial_summary[:gross_profit],
      selected_period: @selected_period,
      period_path: manage_money_financials_path,
      refresh_url: manage_refresh_money_path %>

    <%# Filter Bar — Type (productions vs courses) first, then Status %>
    <div class="mb-3">
      <%= render "shared/filters/filter_bar", bare: true, filter_groups: [
        {
          label: "Type",
          filters: [
            { text: "All",         path: manage_money_financials_path(type: "all", filter: @financials_filter),         active: @type_filter == "all" },
            { text: "Productions", path: manage_money_financials_path(type: "productions", filter: @financials_filter), active: @type_filter == "productions" },
            { text: "Courses",     path: manage_money_financials_path(type: "courses", filter: @financials_filter),     active: @type_filter == "courses" }
          ]
        },
        { separator: true },
        {
          label: "Status",
          filters: [
            { text: "All",              path: manage_money_financials_path(type: @type_filter, filter: "all"),     active: @financials_filter.blank? || @financials_filter == "all" },
            { text: "Pending Financials", path: manage_money_financials_path(type: @type_filter, filter: "pending"), active: @financials_filter == "pending" }
          ]
        }
      ] %>
    </div>

    <div class="">
      <% if @production_summaries.any? %>
        <%= render "manage/money/slim_grid", summaries: @production_summaries %>
      <% else %>
        <div class="bg-gray-50 rounded-lg border border-dashed border-gray-300 p-8 text-center">
          <p class="text-gray-600">
            <% if @financials_filter == "pending" %>
              All past revenue shows have financial data entered.
            <% else %>
              No productions yet.
            <% end %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
