<%#
  An in-page window for the mailing list pages, in the confirm modal's pink
  standard (shared/confirm_modal): a bottom sheet on a phone, a card from sm
  up. Opened by a trigger with data-controller="modal" data-action="click->modal#open"
  data-modal-id="<id>". Locals: id, title, body (html), footer (html,
  optional), wide (true for a wider card), open (true to show it on load).
%>
<div id="<%= id %>" class="<%= 'hidden' unless local_assigns[:open] %> fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center sm:p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full <%= local_assigns[:wide] ? 'sm:max-w-2xl' : 'sm:max-w-lg' %> sm:mx-4 overflow-hidden max-h-[92vh] flex flex-col"
       data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4 flex-shrink-0">
      <h3 class="text-lg font-semibold text-white"><%= title %></h3>
      <button type="button" data-action="click->modal#close" aria-label="Close"
              class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="px-6 py-5 overflow-y-auto"><%= body %></div>
    <% if local_assigns[:footer].present? %>
      <div class="px-4 sm:px-6 pt-3 pb-[calc(env(safe-area-inset-bottom)+12px)] sm:py-4 bg-gray-50 border-t border-gray-200 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-2 [&>*]:w-full sm:[&>*]:w-auto [&_button]:w-full sm:[&_button]:w-auto flex-shrink-0">
        <%= footer %>
      </div>
    <% end %>
  </div>
</div>
