<% content_for :title, "Your CocoScout invitation" %>
<%
  # The invitation an organization sends when it adds someone to its people
  # (and the standard "set up your account" email for manager-created
  # accounts, see StaffOnboardingInviter). The account already exists with a
  # random password, so the job here is choosing one. Someone already signed
  # in as that email just accepts.
  inv = @person_invitation
  org = inv.organization
  accept_path = manage_do_accept_person_invitations_path(token: inv.token)
  decline_cid = "confirm-decline-invite"
%>
<% strip = capture do %>
  <% if org %>
    <%= render layout: "shared/auth/strip", locals: { image: (org.logo if org.logo.attached?), initial: org.name } do %>
      <strong class="font-semibold text-slate-900"><%= org.name %></strong> added you to their people and set up your CocoScout account.
    <% end %>
  <% end %>
<% end %>

<% if @existing_user %>
  <%= render layout: "shared/auth/shell",
        locals: { title: (org ? "Join #{org.name}?" : "Accept the invitation?"), strip: strip, legal: "joining",
                  lede: "You're signed in as #{inv.email}.#{" Joining lets #{org.name} add you to their productions and events." if org}" } do %>
    <%= render "shared/button", text: (org ? "Join #{org.name}" : "Accept invitation"), variant: "primary", size: "jumbo",
          path: accept_path, method: :post, classes: "w-full" %>
    <% if org %>
      <div class="text-center">
        <%= render "shared/button", text: "Decline invitation", variant: "ghost-cancel", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: decline_cid } %>
      </div>
    <% end %>
  <% end %>

<% else %>
  <% notices = capture do %>
    <% if @user&.errors&.any? %>
      <%= render "shared/auth/notice", kind: :error, title: "That password didn't work.", body: @user.errors.full_messages.to_sentence + "." %>
    <% end %>
  <% end %>
  <%
    lede = if org
      "It's the one thing your account still needs. Once it's set, everything #{org.name} sends you lands here: call times, cast messages, contracts and pay."
    else
      "It's the one thing your account still needs. Once it's set, everything your organizations send you lands here: call times, cast messages, contracts and pay."
    end
  %>

  <%= render layout: "shared/auth/shell",
        locals: { title: "Choose your password", strip: strip, notices: notices, lede: lede, legal: "joining" } do %>
    <%= form_with url: accept_path, method: :post, local: true, class: "space-y-4", data: { controller: "password-strength" } do |form| %>
      <%= render "shared/auth/account_row", email: inv.email %>

      <%= render "shared/auth/password_field", form: form, strength: true, autocomplete: "new-password",
            error: @user&.errors&.[](:password)&.any? || false %>

      <div class="pt-1">
        <%= render "shared/button",
            text: (org ? "Join #{org.name}" : "Join CocoScout"),
            variant: "primary",
            size: "jumbo",
            type: :submit,
            disabled: true,
            classes: "!opacity-50 !cursor-not-allowed",
            data: { password_strength_target: "submit" } %>
      </div>
    <% end %>

    <div class="border-t border-slate-200 pt-4 text-center text-sm leading-[1.8] text-slate-600">
      Already set a password?
      <%= link_to "Sign in", signin_path(redirect_to: manage_accept_person_invitations_path(token: inv.token)), class: "font-medium text-pink-600 hover:text-pink-700" %>
      <% if org %>
        <br>
        <%= render "shared/button", text: "Decline this invitation", variant: "ghost-cancel", size: "xs", type: :button,
              classes: "!px-0 font-medium text-slate-500", data: { controller: "modal", action: "click->modal#open", modal_id: decline_cid } %>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if org %>
  <%= render "shared/confirm_modal",
        id: decline_cid,
        title: "Decline invitation?",
        message: "Are you sure you want to decline this invitation?",
        confirm_text: "Decline invitation",
        url: manage_decline_person_invitations_path(token: inv.token),
        method: :post %>
<% end %>
