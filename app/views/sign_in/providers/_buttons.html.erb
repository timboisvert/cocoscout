<%#
  Continue with Apple and Continue with Google, below the email field: the
  email is the main way in, and these are the quick extra (Tim, 2026-11-22).
  SignIn::Providers.shown decides which and in what order; both are the same
  size, as Apple's guidelines require. Each posts to /auth/:provider, which
  leaves for the provider's own page. Locals: providers (["apple", "google"]).
%>
<% if providers.any? %>
  <div class="my-5 flex items-center gap-3 text-sm text-slate-500" role="separator">
    <span class="h-px flex-1 bg-slate-200"></span>
    <span>or</span>
    <span class="h-px flex-1 bg-slate-200"></span>
  </div>
  <div class="space-y-3" data-provider-buttons>
    <% providers.each do |provider| %>
      <%= render "shared/button", text: "Continue with #{SignIn::Providers.name(provider)}", variant: provider, size: "jumbo", icon: provider,
            path: sign_in_provider_path(provider), method: :post, form: { data: { turbo: false } }, classes: "!text-base" %>
    <% end %>
  </div>
<% end %>
