<%# The connect flow's header: breadcrumbs and the app's shared step bar
    (My::ContractConnectionsController). The flow is laid out as the other
    wizards are, at the page's full width (Tim, 2026-11-18).

    Locals:
      step — 1 to 4: what connecting does, choose a production, check your dates, review and send %>
<%
  bar = [
    { name: "What connecting does", path: my_connect_contract_path(@contract) },
    { name: "Choose a production", path: (my_connect_contract_production_path(@contract, organization_id: @organization.id) if @organization) },
    { name: "Check your dates" },
    { name: "Review and send" }
  ]
%>
<%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
<%= render partial: "shared/top_menu", locals: {
  breadcrumbs: [ [ "My Contracts", my_contracts_path ] ],
  text: "Connect",
  links: []
} %>
<%= render "shared/wizard_steps", steps: bar, current_index: step - 1 %>
