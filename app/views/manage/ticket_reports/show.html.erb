<% content_for :title, "Ticket sales" %>
<%
  r = @report
  s = r.summary
  select_class = "px-3 py-2 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
  money = ->(cents) { number_to_currency(cents / 100.0) }
  series = r.by_day
  tiles = [
    [ "Tickets sold", s.tickets.to_s, "#{pluralize(s.orders, 'order')}#{"; #{s.comps} comps" if s.comps.positive?}" ],
    [ "Ticket sales", money.call(s.gross_cents), "Before fees and tax" ],
    [ "Products", money.call(s.product_cents), "Before tax" ],
    [ "Refunded", money.call(s.refunded_cents), "Back to buyers" ],
    [ "You keep", money.call(s.net_cents), s.tax_cents.positive? ? "Plus #{money.call(s.tax_cents)} tax to pay" : "After fees and refunds" ]
  ]
  fee_rows = [
    [ "CocoScout's 50¢ a ticket", s.platform_fee_cents ],
    [ "Card processing", s.processing_cents ],
    [ "Of which buyers paid", s.buyer_fee_cents ]
  ]
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Ticketing", manage_ticketing_path ] ],
    text: "Ticket sales",
    links: [
      { text: "Buyers (CSV)", path: manage_ticket_report_buyers_path(period: @period[:key], basis: r.basis), data: { turbo: false } },
      { text: "Download (CSV)", path: manage_ticket_reports_path(format: :csv, period: @period[:key], basis: r.basis), data: { turbo: false } }
    ]
  } %>

  <div class="max-w-5xl space-y-6">
    <%= form_with url: manage_ticket_reports_path, method: :get, class: "flex flex-wrap items-end gap-3", data: { controller: "auto-submit" } do %>
      <div>
        <label for="period" class="block text-sm font-medium text-gray-700 mb-1.5">Period</label>
        <%= select_tag :period, options_for_select(@periods.map { |p| [ p[:label], p[:key] ] }, @period[:key]),
              class: select_class, data: { action: "change->auto-submit#submit" } %>
      </div>
      <div>
        <label for="basis" class="block text-sm font-medium text-gray-700 mb-1.5">Count each sale by</label>
        <%= select_tag :basis, options_for_select([ [ "The day it sold", "sale" ], [ "The day of the show", "event" ] ], r.basis),
              class: select_class, data: { action: "change->auto-submit#submit" } %>
      </div>
    <% end %>

    <div class="grid grid-cols-2 lg:grid-cols-5 gap-3">
      <% tiles.each do |label, value, note| %>
        <div class="rounded-lg border border-gray-200 bg-white px-4 py-3">
          <div class="text-xs text-gray-500"><%= label %></div>
          <div class="text-xl font-bold tabular-nums text-gray-900 mt-0.5"><%= value %></div>
          <div class="text-xs text-gray-500 mt-0.5"><%= note %></div>
        </div>
      <% end %>
    </div>

    <% if series.values.sum.positive? %>
      <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
        <h2 class="text-sm font-semibold text-gray-900">Tickets by day</h2>
        <div class="mt-3 h-40" data-controller="line-chart" data-line-chart-data-value="<%= series.to_json %>" data-line-chart-label-value="tickets">
          <canvas data-line-chart-target="canvas"></canvas>
        </div>
      </div>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-200"><h2 class="text-sm font-semibold text-gray-900">By show</h2></div>
      <% if r.by_show.empty? %>
        <p class="px-5 py-6 text-sm text-gray-500">No sales in <%= @period[:label] %>.</p>
      <% else %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-gray-50 text-xs text-gray-500">
              <tr>
                <th class="px-5 py-2 text-left font-medium">Show</th>
                <th class="px-3 py-2 text-right font-medium">Tickets</th>
                <th class="px-3 py-2 text-right font-medium">Ticket sales</th>
                <th class="px-3 py-2 text-right font-medium">Products</th>
                <th class="px-3 py-2 text-right font-medium">Refunded</th>
                <th class="px-3 py-2 text-right font-medium">You keep</th>
                <th class="px-5 py-2 text-left font-medium">Money</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% r.by_show.each do |row| %>
                <tr class="whitespace-nowrap">
                  <td class="px-5 py-2.5">
                    <%= link_to row.listing.display_title, manage_ticket_listing_path(row.listing), class: "font-medium text-gray-900 hover:text-pink-600" %>
                    <span class="text-gray-500">· <%= row.listing.show.date_and_time.strftime("%a %b %-d") %></span>
                  </td>
                  <td class="px-3 py-2.5 text-right tabular-nums"><%= row.tickets %><%= " (+#{row.comps} comps)" if row.comps.positive? %></td>
                  <td class="px-3 py-2.5 text-right tabular-nums"><%= money.call(row.gross_cents) %></td>
                  <td class="px-3 py-2.5 text-right tabular-nums"><%= row.product_cents.positive? ? money.call(row.product_cents) : "—" %></td>
                  <td class="px-3 py-2.5 text-right tabular-nums"><%= row.refunded_cents.positive? ? money.call(row.refunded_cents) : "—" %></td>
                  <td class="px-3 py-2.5 text-right tabular-nums font-medium text-gray-900"><%= money.call(row.net_cents) %></td>
                  <td class="px-5 py-2.5 text-xs text-gray-500"><%= row.money_state %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot class="bg-gray-50 text-sm font-semibold text-gray-900">
              <tr class="whitespace-nowrap">
                <td class="px-5 py-2.5">Total</td>
                <td class="px-3 py-2.5 text-right tabular-nums"><%= s.tickets %></td>
                <td class="px-3 py-2.5 text-right tabular-nums"><%= money.call(s.gross_cents) %></td>
                <td class="px-3 py-2.5 text-right tabular-nums"><%= money.call(s.product_cents) %></td>
                <td class="px-3 py-2.5 text-right tabular-nums"><%= money.call(s.refunded_cents) %></td>
                <td class="px-3 py-2.5 text-right tabular-nums"><%= money.call(s.net_cents) %></td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% end %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-200"><h2 class="text-sm font-semibold text-gray-900">By ticket type</h2></div>
        <% if r.by_type.empty? %>
          <p class="px-5 py-4 text-sm text-gray-500">Nothing yet.</p>
        <% else %>
          <ul class="divide-y divide-gray-100 text-sm">
            <% r.by_type.each do |row| %>
              <li class="flex justify-between gap-3 px-5 py-2.5">
                <span class="text-gray-900"><%= row.name %> <span class="text-gray-500">· <%= row.tickets %></span></span>
                <span class="tabular-nums text-gray-700"><%= money.call(row.gross_cents) %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-200"><h2 class="text-sm font-semibold text-gray-900">Where they bought</h2></div>
        <% if r.by_channel.empty? %>
          <p class="px-5 py-4 text-sm text-gray-500">Nothing yet.</p>
        <% else %>
          <ul class="divide-y divide-gray-100 text-sm">
            <% r.by_channel.each do |row| %>
              <li class="flex justify-between gap-3 px-5 py-2.5">
                <span class="text-gray-900"><%= row.label %> <span class="text-gray-500">· <%= pluralize(row.tickets, "ticket") %></span></span>
                <span class="tabular-nums text-gray-700"><%= money.call(row.gross_cents) %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-200"><h2 class="text-sm font-semibold text-gray-900">Fees</h2></div>
        <ul class="divide-y divide-gray-100 text-sm">
          <% fee_rows.each do |label, cents| %>
            <li class="flex justify-between gap-3 px-5 py-2.5">
              <span class="text-gray-900"><%= label %></span>
              <span class="tabular-nums text-gray-700"><%= money.call(cents) %></span>
            </li>
          <% end %>
        </ul>
        <p class="px-5 py-3 text-xs text-gray-500 border-t border-gray-100">Our 50¢ comes back on every refunded ticket. Card processing doesn't.</p>
      </div>
    </div>
  </div>
</div>
