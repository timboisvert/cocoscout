<%#
  The account button at the bottom of the panel and its menu, the same in
  both modes: My profile, Account settings, Superadmin, Sign out, then the
  mode switch as a CocoScout-pink bar at the very bottom (Tim, 2026-10-20:
  it's used rarely and shouldn't be in the way). Someone with no production
  access gets a quiet "Start producing" there instead. Local: production_mode.
%>
<% switch = panel_mode_switch(production_mode: production_mode) %>
<div class="px-2.5 pb-2.5 pt-2">
  <div class="relative" data-controller="dropdown">
    <div data-dropdown-target="menu" role="menu" class="hidden absolute left-0 bottom-full mb-2 w-[300px] bg-white border border-gray-200 rounded-xl shadow-[0_16px_40px_rgba(17,24,39,0.16)] overflow-hidden z-50">
      <div class="px-3.5 py-3 bg-gray-50 text-xs text-gray-500 truncate">Signed in as <%= Current.user.email_address %></div>
      <% item = "flex items-center gap-3 px-3.5 py-3 text-sm text-gray-700 hover:bg-gray-50 border-t border-gray-100 transition-colors" %>
      <%= link_to profile_path, class: item, role: "menuitem" do %>
        <svg class="w-[18px] h-[18px] text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>My profile
      <% end %>
      <%= link_to account_path, class: item, role: "menuitem" do %>
        <svg class="w-[18px] h-[18px] text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>Account settings
      <% end %>
      <% if Current.user.superadmin? %>
        <%= link_to superadmin_path, class: item, role: "menuitem" do %>
          <svg class="w-[18px] h-[18px] text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg>Superadmin
        <% end %>
      <% end %>
      <%= link_to signout_path, class: item, role: "menuitem", data: { turbo_prefetch: false } do %>
        <svg class="w-[18px] h-[18px] text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4M10 16l-4-4 4-4M6 12h11"/></svg>Sign out
      <% end %>
      <% if switch %>
        <%= render "shared/navigation/mode_switch", switch: switch, size: :menu %>
      <% elsif !turbo_native_app? %>
        <%# Website only: the apps never pitch producing (Tim, 2026-10-20). %>
        <%= link_to manage_producer_setup_path, class: "flex items-center gap-3 px-3.5 py-3 border-t border-gray-100 bg-gray-50 hover:bg-gray-100 transition-colors", role: "menuitem" do %>
          <svg class="w-[18px] h-[18px] text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16M15 9h4a1 1 0 0 1 1 1v11M3 21h18"/></svg>
          <span class="flex flex-col min-w-0"><span class="text-sm font-semibold text-gray-700">Start producing</span><span class="text-xs text-gray-500 truncate">Run your own shows on CocoScout</span></span>
        <% end %>
      <% end %>
    </div>

    <button type="button" data-action="click->dropdown#toggle click@window->dropdown#hide"
            class="w-full flex items-center gap-2.5 p-2.5 rounded-xl bg-[#f9f9f7] hover:bg-gray-100 text-left cursor-pointer transition-colors"
            aria-label="Account menu for <%= Current.user.person&.name || Current.user.email_address %>" aria-haspopup="menu">
      <% headshot = Current.user.person&.safe_headshot_variant(:tiny) %>
      <% if headshot %>
        <%= image_tag headshot, alt: "", class: "w-9 h-9 rounded-lg object-cover flex-shrink-0" %>
      <% else %>
        <span class="w-9 h-9 rounded-lg bg-pink-100 text-pink-700 font-bold text-[13px] flex items-center justify-center flex-shrink-0"><%= Current.user.person&.initials || Current.user.email_address[0].upcase %></span>
      <% end %>
      <span class="min-w-0 flex-1 flex flex-col">
        <span class="text-sm font-semibold text-gray-900 truncate"><%= Current.user.person&.name || Current.user.email_address %></span>
        <span class="text-xs text-gray-500 truncate"><%= Current.user.email_address %></span>
      </span>
      <svg class="w-4 h-4 text-gray-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
    </button>
  </div>
</div>
