<%# When students get their reminder before each class session. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
%>
<%= form_with url: manage_course_settings_reminders_path, method: :patch, class: "space-y-4" do %>
  <div>
    <label for="course_reminder_days_before" class="block text-sm font-medium text-gray-700 mb-1.5">Reminder email</label>
    <%= select_tag :course_reminder_days_before,
          options_for_select([ [ "Off", "" ] ] + (1..30).map { |days| [ "#{pluralize(days, 'day')} before each session", days ] }, @organization.course_reminder_days_before),
          class: "#{input_class} max-w-xs" %>
    <p class="text-xs text-gray-500 mt-1">Students get the time and the place again, once per session, sent at 10am.</p>
  </div>
  <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
<% end %>
