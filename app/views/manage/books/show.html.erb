<% content_for :title, "Books" %>
<%
  basis_param = @report.basis == :cash ? "cash" : nil
  period_param = (@period unless @period == "this_month")
  # A section's page, carrying the period and basis along.
  section_path = ->(section, extra = {}) { manage_money_books_section_path({ section: section, basis: basis_param, period: period_param }.merge(extra).compact) }
  # This page, with other filters.
  page_path = ->(extra = {}) { @tab == "overview" ? manage_money_books_path(extra.compact) : manage_money_books_section_path(extra.merge(section: @tab).compact) }
  section_titles = { "accounts" => "Accounts", "entries" => "Entries", "shows" => "By show", "checks" => "Checks" }
  books_description = <<~HTML
    <p>What happened, in dollars. Every ticket, class, contract, payout run, bill and receipt lands here the moment it happens, on real double-entry books you never have to look at.</p>
    <p>Financials and Payouts are what to do next; Books is the record. Money is counted when it was earned, or when it moved if you switch.</p>
  HTML
  money = ->(cents) { cents.negative? ? "−#{number_to_currency(-cents / 100.0)}" : number_to_currency(cents / 100.0) }
  # Where an entry came from, as a link a manager can follow.
  refund_orders = @entries ? TicketRefund.where(id: @entries.select { |e| e.source_type == "TicketRefund" }.map(&:source_id)).pluck(:id, :ticket_order_id).to_h : {}
  source_link = lambda do |entry|
    case entry.source_type
    when "TicketOrder" then [ "Order", manage_ticket_order_path(entry.source_id) ]
    when "TicketRefund" then refund_orders[entry.source_id] && [ "Order", manage_ticket_order_path(refund_orders[entry.source_id]) ]
    when "TicketListing" then [ "Show", manage_edit_ticket_listing_path(entry.source_id) ]
    when "BalanceWithdrawal" then [ "Balance", manage_ticket_balance_path ]
    when "MoneyRecord" then [ "Open", manage_money_record_path(entry.source_id) ]
    end
  end
  top_links = []
  top_links << record_money_link if module_change?(:books)
  # The filters, each shown in the part of the page it changes: never above
  # the boxes that stay the same whatever the period (Tim, 2026-11-02).
  period_filter = { partial: "shared/filters/dropdown_filter", locals: {
    label: "Period", name: "period", selected: @period,
    options: BooksReport::PERIOD_LABELS.map { |k, v| { value: k, text: v } },
    extra_url_params: { section: (@tab unless @tab == "overview"), basis: basis_param, production: @production_id }.compact } }
  production_filter = { partial: "shared/filters/production_dropdown_filter", locals: {
    label: "Production", name: "production", selected: @production_id.to_s,
    options: [ { value: "", text: "All productions" } ] + Array(@productions).map { |pr| { value: pr.id, text: pr.name, type: pr.production_type } },
    extra_url_params: { section: (@tab unless @tab == "overview"), basis: basis_param, period: @period }.compact } }
  basis_filter = { label: "Count money", filters: [
    { text: "When earned", path: page_path.call(period: period_param, production: @production_id), active: @report.basis == :accrual },
    { text: "When it moved", path: page_path.call(basis: "cash", period: period_param, production: @production_id), active: @report.basis == :cash }
  ] }
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <% if @tab == "overview" %>
    <%# The landing page: the sections as cards, the way Money has them. %>
    <%= render "shared/module_header", title: "Books", description: books_description, actions: books_section_cards(mismatches: @mismatches) %>
  <% else %>
    <%= render partial: "shared/top_menu", locals: { breadcrumbs: books_breadcrumbs, text: section_titles[@tab], links: top_links } %>
  <% end %>

  <div>
  <% case @tab %>
  <% when "overview" %>
    <%
      # All your money, wherever it sits: four boxes, tax inside the balance (decision 22).
      spendable = @balance.available_cents
      total_balance = spendable + @balance.tax_set_aside_cents
      balance_note = if @balance.tax_set_aside_cents.positive?
        "#{number_to_currency(@balance.tax_set_aside_cents / 100.0)} of that is set aside for sales tax you owe; #{number_to_currency(spendable / 100.0)} to spend or withdraw"
      else
        "To spend, pay people with, or withdraw"
      end
      strip = [
        { label: "CocoScout balance", cents: total_balance, note: balance_note, path: manage_ticket_balance_path, tint: total_balance.positive? ? "bg-green-50 border-green-200" : "bg-white border-gray-200" },
        { label: "Waiting on upcoming shows", cents: @balance.upcoming_cents, note: "Yours the day after each show", path: manage_ticket_balance_path, tint: @balance.upcoming_cents.positive? ? "bg-blue-50 border-blue-200" : "bg-white border-gray-200" },
        { label: "Owed to performers and staff", cents: @owed_to_payees_cents, note: "Goes out on the next payout run", path: (module_access?(:payouts) ? manage_money_payouts_path : nil), tint: "bg-white border-gray-200" },
        ({ label: "Owed to contractors", cents: @owed_to_contractors_cents, note: "Contract money due and not paid yet", path: (module_access?(:payouts) ? manage_money_payouts_path : nil), tint: "bg-white border-gray-200" } if @owed_to_contractors_cents.positive?),
        ({ label: "Bank, per your books", cents: @bank_cents, note: "What the books say is in the bank, checked against your last statement", path: manage_money_bank_path, tint: "bg-white border-gray-200" } if @bank_known)
      ].compact
      period_label = BooksReport::PERIOD_LABELS[@period]
      tile = ->(label, cents, color = "text-gray-900") { "<div class='rounded-xl border border-gray-200 bg-white px-5 py-4'><div class='text-[11px] font-medium uppercase tracking-wide text-gray-500'>#{label}</div><div class='mt-0.5 text-2xl font-bold tabular-nums #{color}'>#{money.call(cents)}</div></div>".html_safe }
    %>

    <h2 class="text-sm font-semibold text-gray-900 mb-2">All your money, wherever it sits</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 <%= strip.size == 4 ? 'xl:grid-cols-4' : 'xl:grid-cols-3' %> gap-3 mb-8">
      <% strip.each do |box| %>
        <% inner = capture do %>
          <span class="block text-[11px] font-medium uppercase tracking-wide text-gray-500"><%= box[:label] %></span>
          <span class="block mt-0.5 text-2xl font-bold tabular-nums text-gray-900"><%= money.call(box[:cents]) %></span>
          <span class="block mt-0.5 text-xs text-gray-600"><%= box[:note] %></span>
        <% end %>
        <% if box[:path] %>
          <%= link_to box[:path], class: "block rounded-xl border px-5 py-4 transition-colors hover:border-pink-400 #{box[:tint]}" do %><%= inner %><% end %>
        <% else %>
          <div class="rounded-xl border px-5 py-4 <%= box[:tint] %>"><%= inner %></div>
        <% end %>
      <% end %>
    </div>

    <%# The period's filters. The landing page is for seeing and going on to a
        section: Record money lives on the sections' top menus, the period's
        line-by-line download on Statements. %>
    <div class="mb-4">
      <%= render "shared/filters/filter_bar", bare: true, filter_groups: [ period_filter, production_filter, { separator: true }, basis_filter ] %>
    </div>

    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
      <h2 class="text-sm font-semibold text-gray-900">Money in, money out · <%= period_label %><% if @production_id %> · <%= @productions.find { |pr| pr.id == @production_id }&.name %><% end %></h2>
      <span class="text-xs text-gray-500">Counted <%= @report.basis == :cash ? "when it moved" : "when it was earned" %></span>
    </div>

    <% if @overview.empty? %>
      <%= render "shared/empty_state", icon: "money", title: "Nothing on the books for #{period_label.downcase}", body: "Ticket sales, classes, contracts and payout runs land here by themselves. Money that happened elsewhere, a sponsor's check or a receipt, you record by hand on Entries." %>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-5">
        <%= tile.call("Money in", @overview.in_cents) %>
        <%= tile.call("Money out", @overview.out_cents) %>
        <%= tile.call("What's left", @overview.left_cents, @overview.left_cents.negative? ? "text-red-600" : "text-green-600") %>
      </div>

      <% weeks = @overview.weeks %>
      <% if weeks.size > 1 %>
        <%
          w, h, left, bottom, top = 900, 180, 40, 30, 12
          max = [ weeks.map(&:in_cents).max, weeks.map(&:out_cents).max, 1 ].max
          step = (w - left - 20).to_f / [ weeks.size - 1, 1 ].max
          x = ->(i) { left + 10 + i * step }
          y = ->(cents) { h - bottom - (cents.to_f / max) * (h - bottom - top) }
          pts = ->(sel) { weeks.each_with_index.map { |wk, i| "#{x.call(i).round(1)},#{y.call(wk.public_send(sel)).round(1)}" }.join(" ") }
          labels_every = weeks.size > 10 ? (weeks.size / 8.0).ceil : 1
          short = ->(cents) { cents >= 100_000 ? "$#{(cents / 100_000.0).round(1).to_s.sub(/\.0$/, '')}k" : number_to_currency(cents / 100.0, precision: 0) }
        %>
        <figure class="rounded-xl border border-gray-200 bg-white px-5 py-4 mb-5">
          <figcaption class="flex items-center justify-between text-xs text-gray-500 mb-2">
            <span class="font-medium text-gray-700">By week</span>
            <span class="flex gap-4"><span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-0.5 bg-pink-500"></span>In</span><span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-0.5 bg-gray-500"></span>Out</span></span>
          </figcaption>
          <svg viewBox="0 0 <%= w %> <%= h %>" width="100%" height="<%= h %>" role="img" aria-label="Money in and out by week, <%= period_label.downcase %>">
            <% [ 0, 0.5, 1 ].each do |f| %>
              <line x1="<%= left %>" y1="<%= y.call(max * f).round(1) %>" x2="<%= w - 10 %>" y2="<%= y.call(max * f).round(1) %>" stroke="<%= f.zero? ? '#e5e7eb' : '#f3f4f6' %>"></line>
              <text x="0" y="<%= (y.call(max * f) + 4).round(1) %>" font-size="11" fill="#6a7282"><%= short.call((max * f).round) %></text>
            <% end %>
            <polyline points="<%= pts.call(:in_cents) %>" fill="none" stroke="#f6339a" stroke-width="2.5" stroke-linejoin="round"></polyline>
            <polyline points="<%= pts.call(:out_cents) %>" fill="none" stroke="#6a7282" stroke-width="2.5" stroke-linejoin="round"></polyline>
            <g fill="#f6339a"><% weeks.each_with_index do |wk, i| %><circle cx="<%= x.call(i).round(1) %>" cy="<%= y.call(wk.in_cents).round(1) %>" r="3.5"><title><%= wk.label %>: <%= money.call(wk.in_cents) %> in</title></circle><% end %></g>
            <g fill="#6a7282"><% weeks.each_with_index do |wk, i| %><circle cx="<%= x.call(i).round(1) %>" cy="<%= y.call(wk.out_cents).round(1) %>" r="3.5"><title><%= wk.label %>: <%= money.call(wk.out_cents) %> out</title></circle><% end %></g>
            <g font-size="11" fill="#6a7282" text-anchor="middle">
              <% weeks.each_with_index do |wk, i| %>
                <% next unless (i % labels_every).zero? || i == weeks.size - 1 %>
                <text x="<%= x.call(i).round(1) %>" y="<%= h - 8 %>"><%= wk.label %></text>
              <% end %>
            </g>
          </svg>
        </figure>
      <% end %>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-5">
        <% [ [ "Money in, by kind", @overview.in_rows, @overview.in_cents ], [ "Money out, by category", @overview.out_rows, @overview.out_cents ] ].each do |title, rows, total| %>
          <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
            <%= render "shared/section_heading", padding: "px-5 py-3", title: title do %>
              <span class="text-sm font-semibold tabular-nums text-gray-900"><%= money.call(total) %></span>
            <% end %>
            <% if rows.empty? %>
              <p class="px-5 py-4 text-sm text-gray-500">Nothing <%= period_label.downcase %>.</p>
            <% else %>
              <ul class="divide-y divide-gray-100">
                <% rows.each do |row| %>
                  <li>
                    <%= link_to section_path.call("entries", account_id: row.account.id), class: "flex items-center justify-between gap-4 px-5 py-2.5 text-sm hover:bg-gray-50" do %>
                      <span class="text-gray-900"><%= row.account.name %></span>
                      <span class="tabular-nums text-gray-900"><%= money.call(row.cents) %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if @overview.productions.any? && @production_id.nil? %>
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-5">
          <%= render "shared/section_heading", padding: "px-5 py-3", title: "What's left, by production" %>
          <div class="hidden sm:grid grid-cols-[1fr_120px_120px_120px] gap-3 px-5 py-2 bg-gray-50 text-[11px] font-medium uppercase tracking-wide text-gray-500 border-b border-gray-100">
            <span>Production</span><span class="text-right">Money in</span><span class="text-right">Money out</span><span class="text-right">What's left</span>
          </div>
          <ul class="divide-y divide-gray-100">
            <% @overview.productions.each do |row| %>
              <li>
                <% body = capture do %>
                  <span class="text-gray-900 font-medium sm:font-normal"><%= row.name %></span>
                  <span class="text-right tabular-nums text-gray-700 sm:text-gray-900"><span class="sm:hidden text-xs text-gray-500">In </span><%= money.call(row.in_cents) %></span>
                  <span class="text-right tabular-nums text-gray-700 sm:text-gray-900"><span class="sm:hidden text-xs text-gray-500">Out </span><%= money.call(row.out_cents) %></span>
                  <span class="text-right tabular-nums font-semibold <%= row.left_cents.negative? ? 'text-red-600' : (row.left_cents.positive? ? 'text-green-600' : 'text-gray-900') %>"><%= money.call(row.left_cents) %></span>
                <% end %>
                <% if row.production %>
                  <%= link_to manage_money_books_path(period: @period, basis: basis_param, production: row.production.id), class: "grid grid-cols-2 sm:grid-cols-[1fr_120px_120px_120px] gap-x-3 gap-y-1 px-5 py-2.5 text-sm hover:bg-gray-50" do %><%= body %><% end %>
                <% else %>
                  <div class="grid grid-cols-2 sm:grid-cols-[1fr_120px_120px_120px] gap-x-3 gap-y-1 px-5 py-2.5 text-sm"><%= body %></div>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm border-t border-gray-200 pt-4">
      <% if @mismatches.empty? %>
        <span class="inline-flex items-center gap-1.5 text-xs text-green-700"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5"/></svg>The books agree with every record behind them</span>
      <% else %>
        <%= link_to section_path.call("checks"), class: "inline-flex items-center gap-1.5 text-xs text-red-700" do %><%= pluralize(@mismatches.size, "account") %> disagree with the records behind them<% end %>
      <% end %>
    </div>

  <% when "accounts" %>
    <div class="mb-4">
      <%= render "shared/filters/filter_bar", bare: true, filter_groups: [ basis_filter ] %>
    </div>
    <% groups = @report.groups %>
    <% if groups.empty? %>
      <%= render "shared/empty_state", icon: "money", title: "Nothing on the books yet", body: "The first ticket sale starts them." %>
    <% else %>
      <div class="max-w-3xl space-y-4">
        <% groups.each do |label, rows, total| %>
          <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
            <%= render "shared/section_heading", padding: "px-5 py-3", title: label do %>
              <span class="text-sm font-semibold tabular-nums text-gray-900"><%= money.call(total) %></span>
            <% end %>
            <ul class="divide-y divide-gray-100">
              <% rows.each do |row| %>
                <li>
                  <%= link_to section_path.call("entries", account_id: row.account.id), class: "flex items-center justify-between gap-4 px-5 py-2.5 text-sm hover:bg-gray-50" do %>
                    <span class="text-gray-900"><%= row.account.name %></span>
                    <span class="tabular-nums <%= row.cents.zero? ? 'text-gray-400' : 'text-gray-900' %>"><%= money.call(row.cents) %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="bg-white border border-gray-200 rounded-xl px-5 py-3 flex items-center justify-between text-sm">
          <span class="font-semibold text-gray-900">Profit (income less spending)</span>
          <span class="font-semibold tabular-nums text-gray-900"><%= money.call(@report.profit_cents) %></span>
        </div>
      </div>
    <% end %>

  <% when "entries" %>
    <% if @account %>
      <p class="text-sm text-gray-700 mb-3">Entries touching <span class="font-medium"><%= @account.name %></span> · <%= link_to "Show all entries", section_path.call("entries"), class: "text-pink-600 hover:text-pink-700" %></p>
    <% end %>
    <% if @entries.any? %>
      <div class="max-w-4xl bg-white border border-gray-200 rounded-xl divide-y divide-gray-100">
        <% month = nil %>
        <% @entries.each do |entry| %>
          <% link = source_link.call(entry) %>
          <%# A month header where the month changes (V1.1 plan §4). %>
          <% if entry.entry_date.beginning_of_month != month %>
            <% month = entry.entry_date.beginning_of_month %>
            <div class="px-5 py-1.5 bg-gray-50 text-[11px] font-semibold uppercase tracking-wide text-gray-500 sticky top-0" data-books-month><%= month.strftime("%B %Y") %></div>
          <% end %>
          <details class="group">
            <summary class="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3 cursor-pointer list-none hover:bg-gray-50">
              <span class="w-24 text-sm text-gray-500 tabular-nums"><%= entry.entry_date.strftime("%b %-d, %Y") %></span>
              <span class="min-w-[12rem] flex-1 text-sm text-gray-900">
                <%= BooksReport::KIND_LABELS.fetch(entry.kind, entry.kind.humanize) %>
                <% unless entry.kind == "withdrawal" %><span class="text-gray-500"><%= entry.memo %></span><% end %>
                <% if entry.source_type == "MoneyRecord" && @records[entry.source_id]&.receipt&.attached? %><svg class="inline-block w-3.5 h-3.5 text-gray-400 ml-1 -mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-label="Has a receipt"><title>Has a receipt</title><path stroke-linecap="round" stroke-linejoin="round" d="M7 3h8l4 4v14H7zM15 3v4h4"/></svg><% end %>
                <% if entry.reversal_of_id %><span class="ml-1 inline-flex rounded-md bg-gray-100 px-1.5 py-0.5 text-xs text-gray-600">Reverses an earlier entry</span><% end %>
                <% if entry.reversed_at %><span class="ml-1 inline-flex rounded-md bg-gray-100 px-1.5 py-0.5 text-xs text-gray-600">Reversed</span><% end %>
              </span>
              <% if link %>
                <%= link_to link[0], link[1], class: "text-sm text-pink-600 hover:text-pink-700" %>
              <% end %>
            </summary>
            <table class="w-full text-sm mb-3">
              <tbody>
                <% entry.journal_lines.sort_by { |l| -l.amount_cents }.each do |line| %>
                  <tr>
                    <td class="pl-5 sm:pl-[8.25rem] pr-3 py-1 text-gray-700"><%= line.ledger_account.name %></td>
                    <td class="px-3 py-1 text-right tabular-nums text-gray-900 w-28"><%= line.amount_cents.positive? ? number_to_currency(line.amount_cents / 100.0) : "" %></td>
                    <td class="px-5 py-1 text-right tabular-nums text-gray-900 w-28"><%= line.amount_cents.negative? ? number_to_currency(-line.amount_cents / 100.0) : "" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </details>
        <% end %>
      </div>
      <% if @pagy.pages > 1 %>
        <div class="max-w-4xl mt-4 flex items-center justify-between">
          <div class="text-sm text-gray-500">Page <%= @pagy.page %> of <%= @pagy.pages %></div>
          <div class="flex gap-2">
            <% if @pagy.previous %><%= render "shared/button", text: "Previous", variant: "secondary", size: "small", path: section_path.call("entries", account_id: @account&.id, page: @pagy.previous) %><% end %>
            <% if @pagy.next %><%= render "shared/button", text: "Next", variant: "secondary", size: "small", path: section_path.call("entries", account_id: @account&.id, page: @pagy.next) %><% end %>
          </div>
        </div>
      <% end %>
      <p class="max-w-4xl mt-2 text-xs text-gray-500">Open an entry to see its lines: money coming into an account on the left, going out on the right. Every entry balances.</p>
    <% else %>
      <%= render "shared/empty_state", icon: "money", title: "No entries yet" %>
    <% end %>

  <% when "shows" %>
    <% if @show_rows.any? %>
      <%# Phone: a card per show (V1.1 plan §5, Responsive data table). %>
      <div class="sm:hidden space-y-3" data-books-show-cards>
        <% @show_rows.each do |row| %>
          <div class="rounded-lg border border-gray-200 bg-white p-4">
            <div class="text-sm font-semibold text-gray-900"><%= row.show.date_and_time.strftime("%b %-d, %Y") %> · <%= row.show.secondary_name.presence || row.show.production&.name %></div>
            <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5">
              <div><dt class="text-[11px] uppercase tracking-wide text-gray-500">Waiting on the show</dt><dd class="text-sm tabular-nums text-gray-900"><%= money.call(row.waiting_cents) %></dd></div>
              <div><dt class="text-[11px] uppercase tracking-wide text-gray-500">Ticket income</dt><dd class="text-sm tabular-nums text-gray-900"><%= money.call(row.income_cents) %></dd></div>
              <div><dt class="text-[11px] uppercase tracking-wide text-gray-500">Tax collected</dt><dd class="text-sm tabular-nums text-gray-900"><%= money.call(row.tax_cents) %></dd></div>
            </dl>
          </div>
        <% end %>
      </div>
      <div class="max-sm:hidden max-w-4xl bg-white border border-gray-200 rounded-xl overflow-x-auto" data-books-show-table>
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-xs text-gray-500">
            <tr>
              <th class="px-5 py-2 text-left font-medium">Show</th>
              <th class="px-3 py-2 text-right font-medium">Waiting on the show</th>
              <th class="px-3 py-2 text-right font-medium">Ticket income</th>
              <th class="px-5 py-2 text-right font-medium">Tax collected</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @show_rows.each do |row| %>
              <tr>
                <td class="px-5 py-2.5 text-gray-900"><%= row.show.date_and_time.strftime("%b %-d, %Y") %> · <%= row.show.secondary_name.presence || row.show.production&.name %></td>
                <td class="px-3 py-2.5 text-right tabular-nums"><%= money.call(row.waiting_cents) %></td>
                <td class="px-3 py-2.5 text-right tabular-nums"><%= money.call(row.income_cents) %></td>
                <td class="px-5 py-2.5 text-right tabular-nums"><%= money.call(row.tax_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="max-w-4xl mt-2 text-xs text-gray-500">Ticket money waits as "Tickets sold for upcoming shows" until the day after the show, then becomes income.</p>
    <% else %>
      <%= render "shared/empty_state", icon: "ticket", title: "No ticket money on the books yet" %>
    <% end %>

  <% when "checks" %>
    <div class="max-w-3xl space-y-4">
      <% trial = @report.trial_balance_cents %>
      <div class="rounded-xl border px-5 py-4 <%= trial.zero? ? 'bg-green-50 border-green-200' : 'bg-red-50 border-red-200' %>">
        <div class="text-sm font-semibold text-gray-900"><%= trial.zero? ? "The books balance" : "The books are out of balance by #{money.call(trial)}" %></div>
        <p class="text-xs text-gray-600 mt-1">Every entry's lines add up to zero, so all of them together must too.</p>
      </div>
      <div class="rounded-xl border px-5 py-4 <%= @mismatches.empty? ? 'bg-green-50 border-green-200' : 'bg-red-50 border-red-200' %>">
        <div class="text-sm font-semibold text-gray-900"><%= @mismatches.empty? ? "The books agree with the records behind them" : "#{pluralize(@mismatches.size, 'account')} disagree with the records behind them" %></div>
        <p class="text-xs text-gray-600 mt-1">The CocoScout balance is checked against every row of the cash ledger; what's owed to performers and staff against every row of the payout ledger; tax to pay against the tax on every paid ticket, product and course registration. This also runs every night.</p>
        <% if @mismatches.any? %>
          <ul class="mt-3 space-y-1 text-sm text-gray-900">
            <% @mismatches.each do |m| %>
              <li><%= ChartOfAccounts::SYSTEM.dig(m.account.to_sym, :name) || m.account %>: books say <%= money.call(m.books_cents) %>, records say <%= money.call(m.expected_cents) %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
      <div class="pt-2">
        <%= render "shared/filters/filter_bar", bare: true, filter_groups: [ period_filter ] %>
      </div>
      <div class="rounded-xl border px-5 py-4 <%= @disagreements.empty? ? 'bg-green-50 border-green-200' : 'bg-amber-50 border-amber-200' %>">
        <div class="text-sm font-semibold text-gray-900"><%= @disagreements.empty? ? "Financials and Books agree, #{BooksReport::PERIOD_LABELS[@period].downcase}" : "#{pluralize(@disagreements.size, 'production')} where Financials and Books disagree, #{BooksReport::PERIOD_LABELS[@period].downcase}" %></div>
        <p class="text-xs text-gray-600 mt-1">The Money hub's revenue and costs for each production, against the books' income and spending for the same period, through today. Usually a number typed into Show Financials that the books haven't caught up with, or money the books know about that Financials doesn't.</p>
        <% if @disagreements.any? %>
          <ul class="mt-3 space-y-1 text-sm text-gray-900">
            <% @disagreements.each do |d| %>
              <li>
                <%= link_to d.production.name, manage_money_books_path(period: @period, production: d.production.id), class: "font-medium text-pink-600 hover:text-pink-700" %>:
                Financials say <%= money.call(d.financials_in_cents) %> in and <%= money.call(d.financials_out_cents) %> out; Books say <%= money.call(d.books_in_cents) %> in and <%= money.call(d.books_out_cents) %> out
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  <% end %>
  </div>
  <% if @tab != "overview" && module_change?(:books) %><%= render "manage/money_records/modal", productions: @record_productions, shows: @record_shows %><% end %>
</div>
