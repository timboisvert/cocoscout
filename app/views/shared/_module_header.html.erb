<%#
  Module Header: the one page-top model for every landing page in both
  modes (V1.1, Tim 2026-10-21): the title in Coustard, an optional
  description, and the page's actions. The same partial draws differently
  by width:

    desktop   large title, the description, the actions as cards
              (shared/module_actions) when there are three or more
    phone     a small title (the size of shared/top_menu's), no description,
              the actions as icon tiles in one row that scrolls sideways with
              arrows (shared/section_tiles)
    the app   no title (the nav bar has it); the rest as on a phone

  One or two actions are buttons in the title row at every width (the first
  primary, the rest secondary, unless an action says `variant:`), never
  cards: Messages has Send a message and Mark all read, not sections.

  Usage:
    render "shared/module_header",
      title: "Casting",
      description: "<p>First paragraph...</p>",           # desktop only
      lead: capture { ... },                               # optional, under the title at every width
      actions: [
        { icon: "calendar", text: "Availability", description: "Track who can make each show", path: some_path, badge: 2 },
        ...
      ],
      buttons: true   # optional: force the title-row buttons even with 3+ actions

  Action keys: icon, text, description (cards only), path, data, badge,
  locked, feature, variant, method (:post, for a button).
  Icons: shared/_module_header_icon.
%>
<% actions ||= [] %>
<% buttons = local_assigns[:buttons] == true || (actions.any? && actions.size <= 2) %>
<%# In the app the nav bar already says the title, so the page doesn't repeat it. %>
<% show_title = !turbo_native_app? %>

<div class="<%= show_title ? 'pt-1 sm:pt-2' : '' %> mb-4 sm:mb-6" data-module-header>
  <div class="flex items-start justify-between gap-3">
    <% if show_title %>
      <h1 class="text-xl sm:text-4xl coustard-regular text-gray-900 min-w-0"><%= title %></h1>
    <% end %>
    <% if buttons %>
      <div class="flex items-center gap-2 flex-shrink-0 <%= show_title ? '' : 'ml-auto' %>" data-module-buttons>
        <% actions.each_with_index do |action, i| %>
          <% action_data = action[:data] || {} %>
          <% if action[:locked] && action[:feature].present? %>
            <% action_data = action_data.merge(action: "click->upgrade-modal#open", upgrade_feature: action[:feature]) %>
          <% end %>
          <%= render "shared/button", text: action[:text], badge: action[:badge].to_i.positive? ? action[:badge] : nil,
                variant: action[:variant] || (i.zero? ? "primary" : "secondary"), size: "small", method: action[:method],
                path: action[:path], data: action_data, disabled: action[:disabled] %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# lead: something that matters more right now than the description and
      sections (Ticketing's Door open now), right under the title. %>
  <% if local_assigns[:lead].present? %>
    <div class="<%= 'mt-3 sm:mt-4' if show_title %>"><%= lead %></div>
  <% end %>

  <%# Description: desktop only; a phone goes straight to the sections. %>
  <% if local_assigns[:description] && description.present? %>
    <div class="hidden sm:block text-sm text-gray-600 max-w-3xl space-y-2 <%= 'mt-4' if show_title %>">
      <%= raw description %>
    </div>
  <% end %>

  <% if actions.any? && !buttons %>
    <div class="sm:hidden <%= show_title ? 'mt-3' : 'mt-1' %>"><%= render "shared/section_tiles", actions: actions %></div>
    <div class="hidden sm:block mt-6"><%= render "shared/module_actions", actions: actions %></div>
  <% end %>
</div>
