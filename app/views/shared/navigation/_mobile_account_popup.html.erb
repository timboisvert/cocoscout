<%# Account bottom-sheet for the mobile nav (opened via mobile-nav#showUserPopup).
    Shared by every dashboard's mobile grid nav. %>
<div data-mobile-nav-target="userPopup" class="hidden fixed inset-0 z-50">
  <div class="absolute inset-0 bg-black/40" data-action="click->mobile-nav#hideUserPopup"></div>
  <div class="absolute bottom-0 inset-x-0 bg-white rounded-t-2xl shadow-xl">
    <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
      <h3 class="text-lg font-bold text-gray-900">Account</h3>
      <button type="button" data-action="click->mobile-nav#hideUserPopup" class="p-1 rounded-lg hover:bg-gray-100 transition cursor-pointer">
        <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="px-5 py-3">
      <%= link_to profile_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-50 transition text-base font-medium text-gray-700" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-400">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
        My Profile
      <% end %>
      <%= link_to account_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-50 transition text-base font-medium text-gray-700" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-400">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
        My Account
      <% end %>

      <%# Production + Organization (org context only) — mirrors the desktop
          account menu so mobile users have the same switching/management. %>
      <% if Current.organization.present? %>
        <% org = Current.organization %>
        <div class="mt-2 pt-3 border-t border-gray-100">
          <div class="px-4 text-[10px] text-gray-400 font-semibold uppercase tracking-wider mb-1"><%= org.on_paid_plan? ? "Productions" : "Production" %></div>
          <% if org.on_paid_plan? %>
            <%= link_to "My Productions", manage_productions_path, class: "block px-4 py-2 rounded-lg hover:bg-gray-50 text-sm font-medium text-gray-700" %>
            <% if current_user_is_global_manager? %>
              <%= link_to "Add a Production", manage_productions_wizard_path, class: "block px-4 py-2 rounded-lg hover:bg-gray-50 text-sm text-gray-600" %>
            <% end %>
          <% else %>
            <% my_production = Current.user.accessible_productions.where(organization: org).order(:name).first %>
            <% if my_production %>
              <%= link_to my_production.name, edit_manage_production_path(my_production), class: "block px-4 py-2 rounded-lg hover:bg-gray-50 text-sm font-medium text-gray-700 truncate" %>
            <% elsif current_user_is_global_manager? && !org.at_production_limit? %>
              <%= link_to "Add a Production", manage_productions_wizard_path, class: "block px-4 py-2 rounded-lg hover:bg-gray-50 text-sm text-gray-600" %>
            <% end %>
          <% end %>

          <div class="px-4 mt-2 text-[10px] text-gray-400 font-semibold uppercase tracking-wider mb-1">Organization</div>
          <div class="px-4 text-sm font-medium text-gray-800 truncate mb-1"><%= org.name %></div>
          <% if current_user_is_global_manager? %>
            <%= link_to "Manage My Organization", manage_organization_path(org), class: "block px-4 py-2 rounded-lg hover:bg-gray-50 text-sm text-gray-600" %>
          <% end %>
          <% if Current.user.accessible_organizations.count > 1 %>
            <%= link_to "All My Organizations", manage_organizations_path, class: "block px-4 py-2 rounded-lg hover:bg-gray-50 text-sm text-gray-600" %>
          <% else %>
            <%= link_to "Add Another Organization", new_manage_organization_path, class: "block px-4 py-2 rounded-lg hover:bg-gray-50 text-sm text-gray-600" %>
          <% end %>
        </div>
      <% end %>

      <% if Current.user.superadmin? %>
        <%= link_to superadmin_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-50 transition text-base font-medium text-purple-600" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-purple-400">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
          </svg>
          Superadmin
        <% end %>
      <% end %>
      <div class="mt-2 pt-3 border-t border-gray-100">
        <%= link_to signout_path, data: { turbo_prefetch: false }, class: "flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-50 transition text-base font-medium text-pink-600" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-pink-400">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
          </svg>
          Sign Out
        <% end %>
      </div>
    </div>
  </div>
</div>
