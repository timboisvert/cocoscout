<%# The usual week: seven rows, each one an answer. Tapping a row opens the
    week sheet on that day with its answer filled in. %>
<section class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <div class="px-5 py-4 border-b border-gray-200">
    <h2 class="text-base font-semibold text-gray-900">Your usual week</h2>
    <p class="text-sm text-gray-500 mt-0.5">
      <% if picture.week_said? %>
        What a normal week looks like for you. Tap a day to change it.
      <% else %>
        You haven't set this yet, so you're counted as free any time. Tap a day to change it.
      <% end %>
    </p>
  </div>

  <ul class="divide-y divide-gray-100">
    <% picture.week.each do |day| %>
      <% answer = day.answer %>
      <li>
        <div role="button" tabindex="0"
             class="flex items-center gap-3 px-5 py-3 cursor-pointer hover:bg-pink-50 focus:bg-pink-50 focus:outline-none transition-colors"
             data-action="click->work-availability#editDay keydown.enter->work-availability#editDay"
             data-wday="<%= day.wday %>"
             data-day-name="<%= day.name %>"
             data-state="<%= answer.editable_state %>"
             data-windows="<%= answer.window_fields.to_json %>">
          <span class="w-12 sm:w-28 flex-shrink-0 text-sm font-medium text-gray-900">
            <span class="sm:hidden"><%= day.short_name %></span><span class="hidden sm:inline"><%= day.name %></span>
          </span>
          <span class="flex-1 min-w-0">
            <span class="block text-sm <%= { anytime: answer.said ? "text-green-700" : "text-gray-400", off: "text-gray-500", hours: "text-gray-900" }[answer.state] %>">
              <%= answer.state == :off ? "Not working" : answer.label %>
            </span>
            <% if answer.set_by %>
              <span class="block text-xs text-gray-400 mt-0.5">Set by <%= answer.set_by.person&.name || "a manager" %></span>
            <% end %>
          </span>
          <svg class="w-4 h-4 text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
        </div>
      </li>
    <% end %>
  </ul>
</section>
