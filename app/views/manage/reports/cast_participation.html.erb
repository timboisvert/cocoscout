<% content_for :title, "Cast Participation" %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <%= render "manage/reports/header", title: "Cast Participation", subtitle: "Performers and groups ranked by how many shows they're cast in." %>

    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[32rem] text-left text-sm">
          <thead class="bg-gray-50 text-gray-500">
            <tr>
              <th class="px-5 py-3 font-medium">Performer / group</th>
              <th class="px-5 py-3 font-medium">Type</th>
              <th class="px-5 py-3 font-medium text-right">Shows</th>
              <th class="px-5 py-3 font-medium text-right">Role assignments</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @rows.each do |row| %>
              <tr>
                <td class="px-5 py-3 font-medium text-gray-900"><%= row[:name] %></td>
                <td class="px-5 py-3 text-gray-500"><%= row[:type] %></td>
                <td class="px-5 py-3 text-right font-semibold text-gray-900"><%= row[:shows] %></td>
                <td class="px-5 py-3 text-right text-gray-600"><%= row[:assignments] %></td>
              </tr>
            <% end %>
            <% if @rows.empty? %>
              <tr><td colspan="4" class="px-5 py-8 text-center text-gray-400">No cast assignments yet.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
