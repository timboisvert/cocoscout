<%#
  Customize this event's calculation — the show payout page's modal for paying
  this one event differently from its calculation: everyone the same amount, or
  each person their own amount (prefilled with what they'd be paid right now).
  Inline, hidden, opened by a trigger with data-controller="modal"
  data-action="click->modal#open" data-modal-id="customize-calculation".
  NOTE: keep ERB tags out of this comment.

  Expects: @show, @show_payout (its base_scheme is the calculation started from).
%>
<%
  modal_id = "customize-calculation"
  base_scheme = @show_payout.base_scheme
  base_rules = @show_payout.base_rules
  override = @show_payout.has_overrides? ? @show_payout.override_rules.deep_stringify_keys : {}
  performer_overrides = override["performer_overrides"] || {}
  # How this event was customized last time, if it was — so the modal reopens
  # on the same choice.
  mode = if performer_overrides.any?
    "different"
  elsif override.dig("distribution", "method").to_s == "flat_fee"
    "same"
  end
  same_amount = if mode == "same"
    override.dig("distribution", "flat_amount")
  elsif base_rules.dig("distribution", "method").to_s == "flat_fee"
    base_rules.dig("distribution", "flat_amount")
  end
  payees = @show_payout.act_payees
  # What each person is paid as things stand (customization included), and the
  # calculation's own total — what the amounts are checked against.
  current_amounts = @show_payout.current_amounts
  expected_total = @show_payout.calculated_total
  fixed_pot = @show_payout.fixed_pot?
  input_classes = "px-3 py-2.5 border border-gray-300 rounded-md text-sm shadow-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500 tabular-nums"
  row_classes = "flex items-start gap-3 p-3 rounded-lg border-2 cursor-pointer transition-colors hover:border-pink-300"
  radio_classes = "mt-1 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500"
  amount_value = ->(value) { value.nil? ? "" : format("%.2f", value.to_f) }
%>
<div id="<%= modal_id %>"
     class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
     data-controller="modal payout-customize"
     data-payout-customize-expected-value="<%= expected_total.to_f %>"
     data-payout-customize-has-expected-value="<%= expected_total.present? %>"
     data-payout-customize-fixed-pot-value="<%= fixed_pot %>"
     data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden flex flex-col max-h-[90vh]"
       data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white">Customize this event's calculation</h3>
      <button type="button" data-action="click->modal#close"
              class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <%= form_with url: manage_save_override_money_show_payout_path(@show), method: :patch, local: true, class: "contents", id: "#{modal_id}-form" do %>
      <div class="px-6 py-5 overflow-y-auto space-y-3">
        <p class="text-sm text-gray-600">
          Starting from <strong class="text-gray-900"><%= base_scheme&.name || "the calculation this show uses" %></strong>.
          Just this event pays differently; the calculation itself doesn't change.
        </p>

        <div class="space-y-2" role="radiogroup">
          <div>
            <label class="<%= row_classes %> <%= mode == 'same' ? 'border-pink-500 bg-pink-50' : 'border-gray-200' %>"
                   data-payout-customize-target="row" data-mode="same">
              <input type="radio" name="customize[mode]" value="same" <%= "checked" if mode == "same" %>
                     data-payout-customize-target="mode" data-action="change->payout-customize#update"
                     class="<%= radio_classes %>">
              <span class="min-w-0 flex-1">
                <span class="font-medium text-gray-900">Pay everyone the same amount</span>
                <span class="block text-sm text-gray-500 mt-0.5">One amount for each person cast on this event.</span>
              </span>
            </label>
            <div class="hidden mt-2 ml-8" data-payout-customize-target="samePanel">
              <div class="flex items-center gap-2">
                <span class="text-gray-500">$</span>
                <input type="number" name="customize[amount]" value="<%= amount_value.call(same_amount) %>" min="0" step="0.01" required
                       class="w-32 <%= input_classes %>" aria-label="Amount per person">
                <span class="text-sm text-gray-600">per person</span>
              </div>
            </div>
          </div>

          <div>
            <label class="<%= row_classes %> <%= mode == 'different' ? 'border-pink-500 bg-pink-50' : 'border-gray-200' %>"
                   data-payout-customize-target="row" data-mode="different">
              <input type="radio" name="customize[mode]" value="different" <%= "checked" if mode == "different" %>
                     data-payout-customize-target="mode" data-action="change->payout-customize#update"
                     class="<%= radio_classes %>">
              <span class="min-w-0 flex-1">
                <span class="font-medium text-gray-900">Pay people different amounts</span>
                <span class="block text-sm text-gray-500 mt-0.5">Each person starts at what they'd be paid now — change whoever you like.</span>
              </span>
            </label>
            <div class="hidden mt-2" data-payout-customize-target="differentPanel">
              <% if payees.empty? %>
                <p class="text-sm text-gray-500 px-1">Nobody is cast on this show yet.</p>
              <% else %>
                <div class="divide-y divide-gray-100 border border-gray-200 rounded-lg overflow-hidden">
                  <% payees.each do |payee| %>
                    <%
                      is_guest = payee.is_a?(ShowPersonRoleAssignment)
                      key = ShowPayout.act_key(payee)
                      name = is_guest ? payee.guest_name : payee.name
                      headshot_variant = is_guest ? nil : payee.safe_headshot_variant(:thumb)
                      value = @show_payout.override_amount_for(payee) || current_amounts[key]
                    %>
                    <div class="flex items-center gap-3 px-3 py-2.5 bg-white">
                      <% if headshot_variant %>
                        <%= image_tag headshot_variant, alt: name, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
                      <% else %>
                        <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-sm flex-shrink-0">
                          <%= is_guest ? name.to_s.split.map(&:first).first(2).join.upcase : payee.initials %>
                        </div>
                      <% end %>
                      <div class="flex-1 min-w-0">
                        <div class="text-sm font-medium text-gray-900 truncate"><%= name %></div>
                        <% if is_guest %>
                          <div class="text-xs text-gray-500">Guest</div>
                        <% end %>
                      </div>
                      <div class="flex items-center gap-2">
                        <span class="text-gray-500">$</span>
                        <input type="number" name="customize[amounts][<%= key %>]" value="<%= amount_value.call(value) %>"
                               min="0" step="0.01" required
                               data-payout-customize-target="amount" data-action="input->payout-customize#recalc"
                               class="w-28 <%= input_classes %>" aria-label="Amount for <%= name %>">
                      </div>
                    </div>
                  <% end %>
                </div>
                <div class="flex items-center justify-between gap-3 px-1 pt-3 text-sm">
                  <span class="font-medium text-gray-700">Total</span>
                  <span class="tabular-nums text-right">
                    <strong class="text-gray-900" data-payout-customize-target="total"></strong>
                    <% if expected_total %>
                      <span class="text-gray-500">&mdash; calculated <%= number_to_currency(expected_total) %></span>
                    <% end %>
                    <span class="block text-xs text-pink-700" data-payout-customize-target="difference"></span>
                  </span>
                </div>
                <% if expected_total && fixed_pot %>
                  <p class="hidden px-1 pt-1 text-sm text-pink-700" data-payout-customize-target="warning">
                    Adjust the amounts so they add up to <%= number_to_currency(expected_total) %> — this calculation splits a fixed pot.
                  </p>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
        <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
        <%= render "shared/button", text: "Save for this event", variant: "primary", size: "medium", type: :submit,
              classes: "disabled:opacity-50 disabled:cursor-not-allowed",
              data: { "payout-customize-target": "submit" } %>
      </div>
    <% end %>
  </div>
</div>
