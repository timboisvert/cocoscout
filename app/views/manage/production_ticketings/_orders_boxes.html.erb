<%# Under the dates on a production's Basic info (Tim, 2026-11-13): how many
    tickets one order can take, the box office's or (the one override
    control) its own, and the low seats note. Saved by the ticket page's
    action, which comes back here (from: "dates").
    Locals: setup, production. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  own_orders = setup.max_per_order.present?
%>
<%= form_with model: setup, scope: :production_ticketing, url: manage_update_production_ticketing_path(production, section: "sales"), method: :patch, class: "space-y-6" do |f| %>
  <%= hidden_field_tag :from, "dates", id: nil %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle" data-settings-card="orders">
    <%= render "manage/ticketing/own_switch", title: "Orders", what: "order limit", follows: "your box office",
          settings_path: manage_ticketing_settings_section_path(section: "box_office"), intro: "How much one buyer can take at once.",
          only: production.name, name: "production_ticketing[own_orders]", id: "production_ticketing_own_orders", checked: own_orders %>
    <fieldset <%= "disabled" unless own_orders %> data-fieldset-toggle-target="fields" class="px-6 py-5 disabled:opacity-50">
      <label for="production_ticketing_max_per_order" class="block text-sm font-medium text-gray-700 mb-1.5">Most tickets in one order</label>
      <%= f.number_field :max_per_order, min: 1, max: 100, value: setup.max_per_order || ticketing_profile.default_max_per_order, class: "#{input_class} max-w-[8rem]" %>
    </fieldset>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="low-seats">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Low seats note</h2>
      <p class="text-sm text-gray-600 mt-1">The "Only N left" note appears beside a ticket type on your ticket page once that few seats remain, for example "Only 3 left". You also get one email when a date gets that low.</p>
    </div>
    <div class="px-6 py-5">
      <label for="production_ticketing_low_stock_threshold" class="block text-sm font-medium text-gray-700 mb-1.5">Show an "Only N left" note</label>
      <%= f.select :low_stock_threshold, options_for_select(low_stock_choices(setup.low_stock_threshold), setup.low_stock_threshold || TicketListing::LOW_STOCK_DEFAULT), {}, class: "#{input_class} max-w-sm" %>
    </div>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
    </div>
  </div>
<% end %>
