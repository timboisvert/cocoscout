<% content_for :title, "New Payout Run" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Money", manage_money_index_path],
      ["Payout Runs", manage_payout_batches_path]
    ],
    text: "New Payout Run",
    links: []
  } %>

  <div class="max-w-3xl">
    <% unless Current.organization.funding_payment_method_id.present? %>
      <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 mb-6 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-amber-900">Connect a bank or card to fund payouts before you run one.</p>
        <%= render "shared/button", text: "Connect a funding source", variant: "primary", size: "small",
              path: manage_connect_payout_funding_path, method: :post %>
      </div>
    <% end %>

    <% if @ready.any? %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
        <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between">
          <h3 class="font-semibold text-gray-900">Ready to pay</h3>
          <div class="text-right">
            <div class="text-xs text-gray-500 uppercase tracking-wide">Total</div>
            <div class="text-xl font-bold text-gray-900 tabular-nums"><%= number_to_currency(@ready_total_cents / 100.0) %></div>
          </div>
        </div>
        <div class="divide-y divide-gray-100">
          <% @ready.each do |row| %>
            <div class="px-5 py-3 flex items-center justify-between">
              <span class="text-gray-900"><%= row[:payee].name %></span>
              <span class="font-semibold text-gray-900 tabular-nums"><%= number_to_currency(row[:cents] / 100.0) %></span>
            </div>
          <% end %>
        </div>
      </div>

      <%= form_with url: manage_create_payout_batch_path, method: :post, class: "bg-white border border-gray-200 rounded-lg p-5 mb-6" do %>
        <h3 class="font-semibold text-gray-900 mb-1">How do you want to fund it?</h3>
        <p class="text-sm text-gray-500 mb-4">We debit your organization for the total, then deposit each person's share to their bank.</p>
        <div class="space-y-2 mb-5">
          <label class="flex items-start gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-pink-300 has-[:checked]:border-pink-500 has-[:checked]:ring-1 has-[:checked]:ring-pink-500">
            <%= radio_button_tag "funding_method", "ach", true, class: "mt-1 h-4 w-4 accent-pink-500" %>
            <span>
              <span class="block text-sm font-semibold text-gray-900">Bank debit (ACH)</span>
              <span class="block text-xs text-gray-500">Lowest cost. Funds settle in a few business days, then payouts go out.</span>
            </span>
          </label>
          <label class="flex items-start gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-pink-300 has-[:checked]:border-pink-500 has-[:checked]:ring-1 has-[:checked]:ring-pink-500">
            <%= radio_button_tag "funding_method", "card", false, class: "mt-1 h-4 w-4 accent-pink-500" %>
            <span>
              <span class="block text-sm font-semibold text-gray-900">Card (instant)</span>
              <span class="block text-xs text-gray-500">Pay now — a card processing fee applies.</span>
            </span>
          </label>
        </div>
        <%= render "shared/button", text: "Run payout — #{number_to_currency(@ready_total_cents / 100.0)}", variant: "primary", size: "medium", type: :submit %>
      <% end %>
    <% else %>
      <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-8 text-center mb-6">
        <p class="text-gray-600">No one's ready to be paid yet.</p>
        <p class="text-sm text-gray-500 mt-1">People show up here once they've connected a bank and have a balance owed.</p>
      </div>
    <% end %>

    <% if @not_ready.any? %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-200">
          <h3 class="font-semibold text-gray-900">Waiting on bank setup</h3>
          <p class="text-sm text-gray-500 mt-0.5">You owe these people, but they haven't connected a bank — pay them the usual way for now.</p>
        </div>
        <div class="divide-y divide-gray-100">
          <% @not_ready.each do |row| %>
            <div class="px-5 py-3 flex items-center justify-between">
              <span class="text-gray-700"><%= row[:payee].name %></span>
              <span class="text-gray-500 tabular-nums"><%= number_to_currency(row[:cents] / 100.0) %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
