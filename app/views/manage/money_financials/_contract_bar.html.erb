<%#
  Shown above a production's/course's events when it's governed by a contract —
  from our side it's still just a production (or course) we don't own outright.
  Full-width box with the contract type, its value, and a link to the contract.

  Locals:
    contract: Contract
%>
<%
  contractor = contract.contractor

  if contract.respond_to?(:revenue_share?) && contract.revenue_share?
    type_label = "Revenue share (you keep #{contract.revenue_share_percentage.to_i}%)"
    value = "TBD"
    range = contract.respond_to?(:projected_our_revenue_range) ? contract.projected_our_revenue_range : nil
    projection = range ? "#{number_to_currency(range[:low])}–#{number_to_currency(range[:high])} projected" : nil
  else
    type_label = "Flat fee"
    fee = contract.flat_fee_amount
    value = fee.to_f.positive? ? number_to_currency(fee) : "TBD"
    projection = nil
  end
%>
<div class="w-full rounded-lg border border-gray-200 bg-gray-50 px-4 py-3">
  <dl class="space-y-1">
    <div class="flex gap-2 text-sm">
      <dt class="w-28 flex-shrink-0 text-gray-500">Contractor</dt>
      <dd class="min-w-0 text-gray-900">
        <% if contractor %>
          <%= link_to contract.contractor_name, manage_contractor_path(contractor), class: "font-medium text-pink-600 hover:text-pink-700" %>
        <% else %>
          <%= contract.contractor_name %>
        <% end %>
      </dd>
    </div>
    <div class="flex gap-2 text-sm">
      <dt class="w-28 flex-shrink-0 text-gray-500">Type</dt>
      <dd class="text-gray-900"><%= type_label %></dd>
    </div>
    <div class="flex gap-2 text-sm">
      <dt class="w-28 flex-shrink-0 text-gray-500">Contract value</dt>
      <dd class="text-gray-900 tabular-nums">
        <%= value %><% if projection %> <span class="text-gray-500">(<%= projection %>)</span><% end %>
      </dd>
    </div>
  </dl>
  <%= link_to "View contract →", manage_contract_path(contract), data: { turbo_frame: "_top" }, class: "inline-block mt-2 text-sm font-medium text-pink-600 hover:text-pink-700" %>
</div>
