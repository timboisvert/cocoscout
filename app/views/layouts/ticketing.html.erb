<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Tickets" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=5">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Coustard:wght@400;900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# The public box office: one standard design for every theater. Their name
      and the show's image carry the page; CocoScout is a quiet footer line. %>
  <body class="inter-regular text-slate-700 bg-white">
    <% if @ticketing_profile %>
      <header class="border-b border-gray-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
          <%= link_to @ticketing_profile.organization.name, tickets_box_office_path(org: @ticketing_profile.slug),
                class: "text-lg font-semibold text-gray-900 hover:text-pink-600 truncate" %>
          <% if @preview %>
            <span class="flex-shrink-0 inline-flex items-center rounded-md bg-amber-100 px-2 py-1 text-xs font-medium text-amber-800">Preview — not public yet</span>
          <% end %>
        </div>
      </header>
    <% end %>

    <main class="mx-auto max-w-4xl px-4 sm:px-6 py-6 sm:py-10">
      <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
      <%= yield %>
    </main>

    <footer class="border-t border-gray-100">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 py-6 text-xs text-gray-400 flex flex-wrap items-center justify-between gap-2">
        <span><% if @ticketing_profile %>Tickets sold by <%= @ticketing_profile.organization.name %><% end %></span>
        <%= link_to "Tickets by CocoScout", root_url, class: "hover:text-gray-600" %>
      </div>
    </footer>
  </body>
</html>
