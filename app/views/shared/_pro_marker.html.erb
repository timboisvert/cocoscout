<%#
  THE way to say "this is Pro" anywhere in the app — one partial, three shapes,
  so every tab, card, nav item and link marks a Pro feature the same way.

    render "shared/pro_marker"                      # small "Pro" pill (default)
    render "shared/pro_marker", kind: :lock         # grey padlock — the org doesn't have it (locked)
    render "shared/pro_marker", kind: :header       # "Pro feature" pill with padlock, for card headers

  Optional: classes (extra classes on the outer element).

  Rule of thumb, mirroring the production Pay tab: a Pro surface always shows
  the pill; when the org's plan doesn't include it, add the lock beside it and
  make the surface open the upgrade modal (data-action="click->upgrade-modal#open"
  data-upgrade-feature="money"). NOTE: keep ERB tags out of this comment.
%>
<%
  kind = (local_assigns[:kind] || :pill).to_sym
  extra = local_assigns[:classes].to_s
  lock_path = "M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
%>
<% case kind %>
<% when :lock %>
  <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0 <%= extra %>" fill="currentColor" viewBox="0 0 20 20" aria-label="Pro feature"><path fill-rule="evenodd" d="<%= lock_path %>" clip-rule="evenodd"/></svg>
<% when :header %>
  <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wide text-pink-600 bg-pink-50 border border-pink-200 rounded px-1.5 py-0.5 leading-none <%= extra %>">
    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="<%= lock_path %>" clip-rule="evenodd"/></svg>
    Pro feature
  </span>
<% else %>
  <span class="inline-flex items-center text-[9px] font-bold uppercase tracking-wide text-pink-600 bg-pink-50 border border-pink-200 rounded px-1 py-0.5 leading-none <%= extra %>">Pro</span>
<% end %>
