<% content_for :title, "Superadmin" %>

<div class="w-full mb-10">

  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [],
    text: "Superadmin",
    links: []
  } %>

  <%# ===== Headline: the three core things — People, Organizations, Mics ===== %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mt-4">
    <%= render "superadmin/metric_column",
      title: "People",
      view_all_path: people_list_path,
      chart_title: "New people over time",
      chart_label: "people",
      daily: @people_daily_data, weekly: @people_weekly_data, monthly: @people_monthly_data,
      stats: [
        { value: number_with_delimiter(@people_total), label: "Total", color: "text-gray-900" },
        { value: number_with_delimiter(@people_active), label: "Active (30d)", color: "text-green-600" },
        { value: @people_new_today, label: "New today", color: "text-pink-600" },
        { value: @people_new_past_7_days, label: "Past 7 days", color: "text-blue-600" }
      ] %>

    <%= render "superadmin/metric_column",
      title: "Organizations",
      view_all_path: organizations_list_path,
      chart_title: "New organizations over time",
      chart_label: "organizations",
      daily: @organizations_daily_data, weekly: @organizations_weekly_data, monthly: @organizations_monthly_data,
      stats: [
        { value: number_with_delimiter(@organizations_total), label: "Total", color: "text-gray-900" },
        { value: number_with_delimiter(@organizations_active), label: "Active (30d)", color: "text-green-600" },
        { value: @organizations_new_today, label: "New today", color: "text-pink-600" },
        { value: @organizations_new_past_7_days, label: "Past 7 days", color: "text-blue-600" }
      ] %>

    <%= render "superadmin/metric_column",
      title: "Mics",
      view_all_path: mics_index_path,
      chart_title: "New mics over time",
      chart_label: "mics",
      daily: @mics_daily_data, weekly: @mics_weekly_data, monthly: @mics_monthly_data,
      stats: [
        { value: number_with_delimiter(@mics_total), label: "Total", color: "text-gray-900" },
        { value: number_with_delimiter(@mics_pending), label: "Pending", color: "text-amber-600" },
        { value: @mics_new_today, label: "New today", color: "text-pink-600" },
        { value: @mics_new_past_7_days, label: "Past 7 days", color: "text-blue-600" }
      ] %>
  </div>

  <%# ===== Business ===== %>
  <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 mt-8 mb-3">Business</h2>
  <div class="grid grid-cols-2 lg:grid-cols-6 gap-4">
    <%= render "superadmin/tool_card", title: "Finances", subtitle: "Revenue & expenses", path: finances_path,
      icon_bg: "bg-green-100", icon_color: "text-green-600",
      icon_path: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" %>
    <%= render "superadmin/tool_card", title: "Promo Codes", subtitle: "Fee waivers & credits", path: promo_codes_path,
      icon_bg: "bg-amber-100", icon_color: "text-amber-600",
      icon_path: "M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z" %>
    <%= render "superadmin/tool_card", title: "Demo Users", subtitle: "Manage demo org access", path: demo_users_path,
      icon_bg: "bg-violet-100", icon_color: "text-violet-600",
      icon_path: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" %>
  </div>

  <%# ===== Content ===== %>
  <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 mt-8 mb-3">Content</h2>
  <div class="grid grid-cols-2 lg:grid-cols-6 gap-4">
    <%= render "superadmin/tool_card", title: "Profiles Monitor", subtitle: "Sign-ins & completeness", path: profiles_monitor_path,
      icon_bg: "bg-pink-100", icon_color: "text-pink-600",
      icon_path: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" %>
    <%= render "superadmin/tool_card", title: "Email Logs", subtitle: "Sent emails & status", path: email_logs_path,
      icon_bg: "bg-pink-100", icon_color: "text-pink-600",
      icon_path: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" %>
    <%= render "superadmin/tool_card", title: "Messages Monitor", subtitle: "All in-app messages", path: messages_list_path,
      icon_bg: "bg-cyan-100", icon_color: "text-cyan-600",
      icon_path: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" %>
    <%= render "superadmin/tool_card", title: "Content Templates", subtitle: "Manage templates", path: content_templates_path,
      icon_bg: "bg-indigo-100", icon_color: "text-indigo-600",
      icon_path: "M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" %>
    <%= render "superadmin/tool_card", title: "Agreements", subtitle: "Stats & default template", path: agreements_monitor_path,
      icon_bg: "bg-emerald-100", icon_color: "text-emerald-600",
      icon_path: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" %>
    <%= render "superadmin/tool_card", title: "Key Monitor", subtitle: "Short URL keys (/a/, /s/)", path: keys_monitor_path,
      icon_bg: "bg-purple-100", icon_color: "text-purple-600",
      icon_path: "M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" %>
  </div>

  <%# ===== Technical ===== %>
  <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 mt-8 mb-3">Technical</h2>
  <div class="grid grid-cols-2 lg:grid-cols-6 gap-4">
    <%= render "superadmin/tool_card", title: "Data Monitor", subtitle: "Database tables & stats", path: data_monitor_path,
      icon_bg: "bg-blue-100", icon_color: "text-blue-600",
      icon_path: "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" %>
    <%= render "superadmin/tool_card", title: "Cable Monitor", subtitle: "WebSocket & real-time", path: cable_monitor_path,
      icon_bg: "bg-yellow-100", icon_color: "text-yellow-600",
      icon_path: "M13 10V3L4 14h7v7l9-11h-7z" %>
    <%= render "superadmin/tool_card", title: "Cache Monitor", subtitle: "Cache stats & clear", path: cache_monitor_path,
      icon_bg: "bg-purple-100", icon_color: "text-purple-600",
      icon_path: "M13 10V3L4 14h7v7l9-11h-7z" %>
    <%= render "superadmin/tool_card", title: "Storage Monitor", subtitle: "S3 stats & cleanup", path: storage_monitor_path,
      icon_bg: "bg-amber-100", icon_color: "text-amber-600",
      icon_path: "M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" %>
    <%= render "superadmin/tool_card", title: "Queue Monitor", subtitle: "Jobs & failed tasks", path: queue_monitor_path,
      icon_bg: "bg-green-100", icon_color: "text-green-600",
      icon_path: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" %>
  </div>

</div>
