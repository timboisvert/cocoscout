<% content_for :title, "#{@report[:title]} — Reports" %>

<%
  # Format a cell value according to its column format.
  fmt = ->(value, format) {
    return "" if value.nil?
    case format
    when :currency then number_to_currency(value)
    when :number   then number_with_delimiter(value)
    else value.to_s
    end
  }
  align = ->(format) { format == :text ? "text-left" : "text-right tabular-nums" }
%>

<div class="w-full mb-10 report-printable">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%# Standard breadcrumb header (screen only — hidden when printing). %>
  <% print_button = capture do %>
    <%= render "shared/button", text: "Print / PDF", variant: "secondary", size: "small", type: :button, icon: "print", onclick: "window.print()" %>
  <% end %>
  <div class="no-print">
    <%= render partial: "shared/top_menu", locals: {
      breadcrumbs: [ [ "Reports", manage_reports_path ] ],
      text: @report[:title],
      extra_buttons: print_button,
      links: [
        { text: "Download spreadsheet", icon: "download", path: @report[:csv_path], variant: "primary" }
      ]
    } %>
  </div>

  <%# Title (printed pages only — the breadcrumb carries it on screen) + subtitle. %>
  <div class="mb-6 mt-2">
    <h1 class="report-print-title text-2xl coustard-regular text-gray-900"><%= @report[:title] %></h1>
    <% if @report[:subtitle].present? %>
      <p class="text-sm text-gray-600"><%= @report[:subtitle] %></p>
    <% end %>
  </div>

  <%# A period to report on (ticket reports): the selects submit by themselves. %>
  <% if @report[:filters] %>
    <% f = @report[:filters] %>
    <% select_class = "px-3 py-2 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
    <%= form_with url: request.path, method: :get, class: "no-print flex flex-wrap items-end gap-3 mb-6", data: { controller: "auto-submit" } do %>
      <div>
        <label for="period" class="block text-sm font-medium text-gray-700 mb-1.5">Period</label>
        <%= select_tag :period, options_for_select(f[:periods].map { |p| [ p[:label], p[:key] ] }, f[:period][:key]),
              class: select_class, data: { action: "change->auto-submit#submit" } %>
      </div>
      <div>
        <label for="basis" class="block text-sm font-medium text-gray-700 mb-1.5">Count each sale by</label>
        <%= select_tag :basis, options_for_select([ [ "The day it sold", "sale" ], [ "The day of the show", "event" ] ], f[:basis]),
              class: select_class, data: { action: "change->auto-submit#submit" } %>
      </div>
    <% end %>
  <% end %>

  <%# Headline stats %>
  <% if @report[:stats].present? %>
    <div class="grid gap-4 grid-cols-2 sm:grid-cols-4 mb-6">
      <% @report[:stats].each do |stat| %>
        <div class="rounded-lg border border-gray-200 bg-white p-4">
          <div class="text-xs uppercase tracking-wide text-gray-500"><%= stat[:label] %></div>
          <div class="mt-1 text-2xl font-bold text-gray-900 tabular-nums"><%= stat[:value] %></div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Phone (V1.1 plan §5, Responsive data table): each row is a card led
      by its first column, the other columns as label and figure pairs, and
      the total as a card of its own. Printing uses the table. %>
  <div class="sm:hidden print:hidden space-y-3" data-report-cards>
    <% if @report[:rows].any? %>
      <% @report[:rows].each do |row| %>
        <div class="rounded-lg border border-gray-200 bg-white p-4" data-report-card>
          <div class="text-sm font-semibold text-gray-900 break-words"><%= fmt.call(row[0], @report[:columns][0][:format]) %></div>
          <% if row.size > 1 %>
            <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5">
              <% row.each_with_index do |value, i| %>
                <% next if i.zero? %>
                <% c = @report[:columns][i] %>
                <div class="min-w-0">
                  <dt class="text-[11px] uppercase tracking-wide text-gray-500 truncate"><%= c[:label] %></dt>
                  <dd class="text-sm text-gray-900 tabular-nums break-words"><%= fmt.call(value, c[:format]) %></dd>
                </div>
              <% end %>
            </dl>
          <% end %>
        </div>
      <% end %>
      <% if @report[:total_row] %>
        <div class="rounded-lg border-2 border-gray-300 bg-gray-50 p-4" data-report-total-card>
          <div class="text-sm font-semibold text-gray-900"><%= fmt.call(@report[:total_row][0], @report[:columns][0][:format]) %></div>
          <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5">
            <% @report[:total_row].each_with_index do |value, i| %>
              <% next if i.zero? %>
              <% c = @report[:columns][i] %>
              <div class="min-w-0">
                <dt class="text-[11px] uppercase tracking-wide text-gray-500 truncate"><%= c[:label] %></dt>
                <dd class="text-sm font-semibold text-gray-900 tabular-nums"><%= fmt.call(value, c[:format]) %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      <% end %>
    <% else %>
      <div class="rounded-lg border border-gray-200 bg-white px-4 py-10 text-center text-gray-500">No data for this report yet.</div>
    <% end %>
  </div>

  <%# Standardized table %>
  <div class="max-sm:hidden print:block bg-white border border-gray-200 rounded-lg overflow-x-auto" data-report-table>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-200 bg-gray-50">
          <% @report[:columns].each do |c| %>
            <th class="px-4 py-2.5 font-semibold text-gray-700 <%= align.call(c[:format]) %>"><%= c[:label] %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% if @report[:rows].any? %>
          <% @report[:rows].each do |row| %>
            <tr>
              <% row.each_with_index do |value, i| %>
                <% c = @report[:columns][i] %>
                <td class="px-4 py-2.5 text-gray-900 <%= align.call(c[:format]) %>"><%= fmt.call(value, c[:format]) %></td>
              <% end %>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="<%= @report[:columns].size %>" class="px-4 py-10 text-center text-gray-500">No data for this report yet.</td></tr>
        <% end %>
      </tbody>
      <% if @report[:total_row] %>
        <tfoot>
          <tr class="border-t-2 border-gray-300 bg-gray-50 font-semibold">
            <% @report[:total_row].each_with_index do |value, i| %>
              <% c = @report[:columns][i] %>
              <td class="px-4 py-2.5 text-gray-900 <%= align.call(c[:format]) %>"><%= fmt.call(value, c[:format]) %></td>
            <% end %>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </div>
</div>

<style>
  .report-print-title { display: none; }
  @media print {
    body * { visibility: hidden !important; }
    .report-printable, .report-printable * { visibility: visible !important; }
    .report-printable { position: absolute; left: 0; top: 0; width: 100%; padding: 0; }
    .no-print { display: none !important; }
    .report-print-title { display: block !important; }
  }
</style>
