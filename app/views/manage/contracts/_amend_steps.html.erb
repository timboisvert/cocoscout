<%#
  Amend-flow progress header. Local: current (1-5).
  Renders the shared full-width wizard-steps component (the same one the create
  wizard uses) so amending looks and behaves like the rest of the system.
  Completed steps are clickable to jump back.
%>
<%
  current = (local_assigns[:current] || 1).to_i
  steps = [
    { name: "Events",               path: amend_bookings_manage_contract_path(@contract) },
    { name: "Review Events",        path: amend_events_manage_contract_path(@contract) },
    { name: "Financials",           path: amend_payments_manage_contract_path(@contract) },
    { name: "Ticketing & Services", path: amend_ticketing_tech_manage_contract_path(@contract) },
    { name: "Confirm",              path: amend_review_manage_contract_path(@contract) }
  ]
%>
<%= render "shared/wizard_steps", steps: steps, current_index: current - 1 %>
