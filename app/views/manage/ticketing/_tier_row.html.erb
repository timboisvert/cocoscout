<%# One ticket type in a Tickets form, shared by a production's setup and a
    single date's own prices: drag handle and arrows to reorder, name, price,
    seats, a short description, and remove. Locals: tf (the fields builder),
    sold (optional: how many this type has sold, on a date). %>
<%
  tier = tf.object
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  sold = local_assigns[:sold].to_i
%>
<div class="rounded-lg border border-gray-200 bg-white p-3 nested-fields" data-position="<%= tier.position %>">
  <%= tf.hidden_field :position %>
  <div class="flex items-start gap-2">
    <div class="flex flex-col items-center gap-0.5 pt-1">
      <span class="tier-drag-handle cursor-grab text-gray-400 hover:text-gray-600 p-1" title="Drag to reorder" aria-hidden="true">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M7 4a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zm0 6a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zm0 6a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zm9-12a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zm0 6a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zm0 6a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/></svg>
      </span>
      <%= render "shared/button", text: "", variant: "ghost", size: "xs", type: :button, title: "Move up", icon: "chevron-up",
            classes: "!p-1 text-gray-400 hover:text-gray-700", data: { action: "reorderable#moveUp" } %>
      <%= render "shared/button", text: "", variant: "ghost", size: "xs", type: :button, title: "Move down", icon: "chevron-down",
            classes: "!p-1 text-gray-400 hover:text-gray-700", data: { action: "reorderable#moveDown" } %>
    </div>
    <div class="flex-1 min-w-0 space-y-2">
      <div class="grid grid-cols-[minmax(0,1fr)_7rem_6rem] gap-2">
        <%= tf.text_field :name, placeholder: "Ticket type, like General", "aria-label": "Ticket name", class: input_class %>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">$</span>
          <%= tf.text_field :price, value: (tier.persisted? || tier.name.present? ? format("%.2f", tier.price_cents / 100.0) : nil), inputmode: "decimal", placeholder: "0.00", "aria-label": "Price", class: "#{input_class} pl-7" %>
        </div>
        <%= tf.number_field :quantity, min: 1, placeholder: "Seats", "aria-label": "Seats", class: input_class %>
      </div>
      <%= tf.text_field :description, placeholder: "Short description (optional), like “Front row and a drink”", "aria-label": "Description", class: input_class %>
      <% if sold.positive? %><p class="text-xs text-gray-500"><%= sold %> sold</p><% end %>
    </div>
    <% if tier.persisted? %>
      <label class="flex h-10 items-center justify-center cursor-pointer text-gray-400 hover:text-pink-600" title="Remove this ticket type">
        <%= tf.check_box :_destroy, class: "sr-only peer" %>
        <svg class="w-5 h-5 peer-checked:text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </label>
    <% else %>
      <%= tf.hidden_field :_destroy, value: "0" %>
      <%= render "shared/button", text: "", variant: "ghost", size: "xs", type: :button, title: "Remove this row", icon: "x-mark",
            classes: "!p-2 text-gray-400 hover:text-pink-600", data: { action: "nested-form#remove" } %>
    <% end %>
  </div>
</div>
