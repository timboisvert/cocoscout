<% content_for :title, "Home" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%# Home at the very top, then what needs attention, then the week (Tim, 2026-10-21). %>
  <%= render "shared/module_header", title: "Home" %>

  <% if @production_dashboards.any? %>
    <%# Actions (one line per thing waiting), the welcome guide, then the
        week show by show (one day at a time on a phone). %>
    <%= render "manage/manage/actions" %>

    <%
      # Shown to anyone with a production until they dismiss it. Creating a
      # production also re-activates it (see producer setup / production wizard),
      # so a second production brings the greeting back even after a dismissal.
      next_steps_body = <<~HTML.html_safe
        <p>
          Everything your production needs lives here now — your calendar, your cast, your
          auditions, your people, all in one place. There's a lot you can do, and no wrong
          place to start. Here are the paths most producers take first:
        </p>
      HTML
    %>
    <%= render "shared/intro_guide",
          guide_key: "production_next_steps",
          variant: "welcome",
          default_visible: @productions.any?,
          title: "Welcome to running your production on CocoScout",
          body: next_steps_body,
          cards: [
            { icon: "calendar", text: "Schedule your shows", description: "Put dates on the calendar — everything else points at them", path: manage_shows_new_wizard_path },
            { icon: "clipboard-list", text: "Run auditions", description: "Collect sign-ups, review, and build your cast", path: manage_signups_auditions_new_wizard_path },
            { icon: "user-group", text: "Cast your shows", description: "Assign people to roles, show by show", path: manage_casting_path },
            { icon: "user-plus", text: "Invite your people", description: "Bring in your performers and staff", path: manage_contacts_path }
          ] %>

    <%# The week, show by show (Design B, Tim 2026-10-27). %>
    <%= render "manage/manage/home_week" %>
    <%= render "manage/manage/home_day" %>

    <%# Each show's modal, once; its row opens it on every width. %>
    <% @home.rows.each do |row| %>
      <%= render "manage/manage/show_modal", row: row %>
    <% end %>
  <% else %>
    <!-- Empty state: new org, no productions yet -->
    <div class="max-w-2xl mx-auto mt-10">
      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-gray-900 coustard-regular mb-2">Welcome to <%= Current.organization.name %></h1>
        <p class="text-sm text-gray-600">
          This is your production dashboard — where you manage the shows, courses, and events that <strong>you're</strong> producing.
          Get started by creating your first production or course.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
        <%# Create a Production card %>
        <%= link_to manage_productions_wizard_path, class: "block bg-white border border-gray-200 rounded-lg p-6 hover:border-pink-300 hover:shadow-sm transition group" do %>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-pink-100 flex items-center justify-center flex-shrink-0 group-hover:bg-pink-200 transition">
              <svg class="w-5 h-5 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2m0 2a2 2 0 012-2h6a2 2 0 012 2m-8 0v2m8-2v2m-8 4h8m-8 4h4m4-4a4 4 0 110 8 4 4 0 010-8z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Create a Production</h3>
              <p class="text-xs text-gray-500 leading-relaxed">
                For shows, theater runs, festivals, or any event with a cast and crew.
                Manage auditions, casting, scheduling, and availability.
              </p>
            </div>
          </div>
        <% end %>

        <%# Create a Course card %>
        <%= link_to manage_course_wizard_start_path, class: "block bg-white border border-gray-200 rounded-lg p-6 hover:border-pink-300 hover:shadow-sm transition group" do %>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-pink-100 flex items-center justify-center flex-shrink-0 group-hover:bg-pink-200 transition">
              <svg class="w-5 h-5 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Create a Course</h3>
              <p class="text-xs text-gray-500 leading-relaxed">
                For workshops, classes, and training programs.
                Set up scheduling, registration, payments, and a listing in the course directory.
              </p>
            </div>
          </div>
        <% end %>
      </div>

      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-center">
        <p class="text-xs text-gray-500">
          <strong>Already performing in someone else's production?</strong>
          That lives outside production mode, in <%= link_to "My Shows & Events", my_shows_path, class: "text-pink-600 underline hover:text-pink-700" %>.
          This section is just for the things you're producing yourself.
        </p>
      </div>
    </div>
  <% end %>
</div>
