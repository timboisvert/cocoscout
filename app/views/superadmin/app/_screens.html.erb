<%
  views = report.page_views
  pages = report.top_pages
  total = views.sum(&:last)
  peak = [ views.map(&:last).max.to_i, 1 ].max
  top = [ pages.map(&:last).max.to_i, 1 ].max
%>
<div class="bg-white border border-gray-200 rounded-lg p-5">
  <h2 class="font-semibold text-gray-900 mb-1">Screens opened each day</h2>
  <p class="text-xs text-gray-500 mb-4"><%= number_with_delimiter(total) %> in the last <%= report.days %> days.</p>
  <div class="flex items-end gap-1 h-28">
    <% views.each do |date, count| %>
      <div class="flex-1 flex flex-col justify-end h-full" title="<%= date.strftime('%a %b %-d') %>: <%= number_with_delimiter(count) %>">
        <div class="bg-pink-500 rounded-t-sm" style="height: <%= (count * 100.0 / peak).round(1) %>%"></div>
        <% if count.zero? %><div class="bg-gray-100 h-px"></div><% end %>
      </div>
    <% end %>
  </div>
  <div class="flex justify-between text-[11px] text-gray-400 mt-1"><span><%= views.first.first.strftime("%b %-d") %></span><span>Today</span></div>
</div>

<div class="bg-white border border-gray-200 rounded-lg p-5" data-top-pages>
  <h2 class="font-semibold text-gray-900 mb-3">Most-used app pages, last <%= report.days %> days</h2>
  <% if pages.any? %>
    <table class="w-full text-sm">
      <tbody class="divide-y divide-gray-100">
        <% pages.each do |page, count| %>
          <tr>
            <td class="py-1.5 font-mono text-xs text-gray-700 truncate max-w-0 w-1/2"><%= page %></td>
            <td class="py-1.5 pl-3 w-1/3"><div class="h-2 rounded-sm bg-pink-200" style="width: <%= (count * 100.0 / top).round(1) %>%"></div></td>
            <td class="py-1.5 pl-3 text-right tabular-nums"><%= number_with_delimiter(count) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-sm text-gray-500">No app pages loaded yet.</p>
  <% end %>
</div>
