<%# A day on the month calendar inside the day page's header: a tick when
    settled, a dot when there's something to settle. Locals: item (SettleUp::Day) %>
<%= link_to manage_money_settle_up_day_path(item.param), class: "block mt-1", title: "#{item.date.strftime('%b %-d')}: #{item.settled? ? 'settled' : 'to settle'}" do %>
  <% if item.settled? %>
    <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-green-100 text-green-700"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5"/></svg></span>
  <% else %>
    <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-500"></span>
  <% end %>
<% end %>
