<% content_for :title, @list.name %>
<%
  path = ->(**o) { manage_mailing_list_path(@list, **{ filter: (@filter == "subscribed" ? nil : @filter), source: @source, q: @q.presence }.merge(o).compact) }
  source_options = [ { value: "", text: "All sources" }, { value: "checkout", text: "Tickets" }, { value: "manual", text: "Added by hand" },
                     { value: "paste", text: "Pasted" }, { value: "contacts", text: "From Contacts" } ]
  status_counts = @status_counts
  bounced_count = status_counts["bounced"].to_i + status_counts["complained"].to_i
%>

<div class="w-full pb-10">
  <%= render "shared/notice", notice: notice, alert: alert %>
  <%= render "shared/top_menu",
        breadcrumbs: [ [ "Mailing lists", manage_mailing_lists_path ] ],
        text: @list.name,
        links: [
          { text: "Write an email", path: manage_new_follower_email_path(list_id: @list.id) },
          { text: "Add people", path: "#", color: "white", data: { controller: "modal", action: "click->modal#open", modal_id: "add-people-modal" } }
        ] %>

  <div class="flex flex-wrap items-center gap-2 mb-4">
    <% if @list.main? %><span class="inline-flex items-center rounded-full border border-pink-200 bg-pink-50 px-2.5 py-0.5 text-xs font-medium text-pink-700">Main list</span><% end %>
    <% if @list.archived? %><span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700">Archived</span><% end %>
    <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700"><%= follower_count_words(status_counts["subscribed"].to_i) %></span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 items-start">
    <div class="lg:col-span-2 min-w-0 space-y-3">
      <%= form_with url: manage_mailing_list_path(@list), method: :get, data: { turbo_action: "advance" } do |f| %>
        <%= render "shared/filters/search_input", placeholder: "Search by name or email...", value: @q, name: "q", full_width: true %>
        <%= hidden_field_tag :filter, @filter unless @filter == "subscribed" %>
        <%= hidden_field_tag :source, @source if @source %>
      <% end %>
      <%= render "shared/filters/filter_bar",
            toggle_label: "Filters",
            filter_groups: [
              { label: "Show", filters: [
                { text: "Subscribed", path: path.call(filter: nil), active: @filter == "subscribed" },
                { text: "Unsubscribed#{" (#{status_counts['unsubscribed']})" if status_counts['unsubscribed'].to_i.positive?}", path: path.call(filter: "unsubscribed"), active: @filter == "unsubscribed" },
                { text: "Bounced#{" (#{bounced_count})" if bounced_count.positive?}", path: path.call(filter: "bounced"), active: @filter == "bounced" }
              ] },
              { separator: true },
              { partial: "shared/filters/dropdown_filter",
                locals: { label: "From", name: "source", options: source_options, selected: @source.to_s,
                          extra_url_params: { filter: (@filter == "subscribed" ? nil : @filter), q: @q.presence } } }
            ] %>

      <% if @followers.any? %>
        <div class="bg-white rounded-lg border border-gray-200 overflow-hidden divide-y divide-gray-100" data-followers>
          <% @followers.each do |follower| %>
            <% chip = follower_status_chip(follower) %>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 px-4 sm:px-5 py-3">
              <div class="min-w-0 sm:w-64 sm:flex-shrink-0">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="font-semibold text-gray-900 truncate"><%= follower.name.presence || follower.email %></span>
                  <% if follower.person&.user_id %><span class="inline-flex items-center rounded-full border border-pink-200 bg-pink-50 px-1.5 py-0.5 text-[10px] font-medium text-pink-700">CocoScout</span><% end %>
                </div>
                <% if follower.name.present? %><div class="text-xs text-gray-500 truncate"><%= follower.email %></div><% end %>
              </div>
              <div class="min-w-0 flex-1 flex flex-wrap gap-1.5">
                <% sources = follower.follower_sources.sort_by(&:occurred_at).reverse %>
                <% sources.first(2).each do |source| %>
                  <span class="inline-flex items-center rounded-full <%= source.kind == 'added_by_share' ? 'bg-blue-50 text-blue-700' : 'bg-gray-100 text-gray-700' %> px-2 py-0.5 text-[11px] font-medium"><%= source.label(viewer: Current.user.person) %></span>
                <% end %>
                <% if sources.size > 2 %><span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-700">+<%= sources.size - 2 %></span><% end %>
                <% if chip %><span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium <%= chip.last %>"><%= chip.first %></span><% end %>
              </div>
              <div class="flex items-center gap-3 sm:flex-shrink-0">
                <span class="text-xs text-gray-500 tabular-nums"><%= sources.last&.occurred_at&.strftime("%b %-d") || follower.created_at.strftime("%b %-d") %></span>
                <% cid = "remove-follower-#{follower.id}" %>
                <button type="button" class="text-xs text-gray-500 hover:text-gray-700 cursor-pointer" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= cid %>">Remove</button>
              </div>
            </div>
          <% end %>
        </div>
        <% pages = (@total / Manage::MailingListsController::PER_PAGE.to_f).ceil %>
        <div class="flex items-center justify-between text-xs text-gray-500">
          <span><%= number_with_delimiter(@total) %> <%= @filter == "subscribed" ? "subscribed" : @filter %></span>
          <% if pages > 1 %>
            <span class="flex gap-3">
              <% if @page > 1 %><%= link_to "Newer", path.call(page: @page - 1), class: "text-pink-600 hover:text-pink-700" %><% end %>
              <span>Page <%= @page %> of <%= pages %></span>
              <% if @page < pages %><%= link_to "Older", path.call(page: @page + 1), class: "text-pink-600 hover:text-pink-700" %><% end %>
            </span>
          <% end %>
        </div>
      <% elsif @q.present? || @source || @filter != "subscribed" %>
        <%= render "shared/empty_state", icon: "search", title: "Nobody here", body: "No followers match these filters.",
              actions: [ { text: "Clear filters", path: manage_mailing_list_path(@list), variant: "secondary" } ] %>
      <% else %>
        <%= render "shared/empty_state", icon: "people", title: "Nobody on this list yet",
              body: (@list.main? ? "Ticket buyers join at checkout. Add anyone else by hand." : "Pick productions for it to collect from, or add people by hand."),
              actions: [ { text: "Add people", path: "#", data: { controller: "modal", action: "click->modal#open", modal_id: "add-people-modal" } } ] %>
      <% end %>
    </div>

    <aside class="space-y-4">
      <section class="bg-white rounded-lg border border-gray-200 p-5" data-collects-from>
        <h3 class="font-semibold text-gray-900 mb-4">Collects from</h3>
        <% if @list.main? %>
          <p class="text-sm text-gray-600">Every production's checkout offers it: "<%= @list.box_words %>".</p>
        <% elsif @productions.any? %>
          <div class="space-y-2">
            <% @productions.each do |production| %>
              <div class="flex items-center gap-2 px-3 py-2.5 bg-gray-50 rounded-lg">
                <span class="min-w-0 flex-1 truncate text-sm text-gray-900"><%= production.name %></span>
                <% if production.type_third_party? %><span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-700">Contract</span><% end %>
              </div>
            <% end %>
          </div>
          <p class="text-xs text-gray-500 mt-3">Buyers of these productions see "<%= @list.box_words %>" at checkout.</p>
        <% else %>
          <p class="text-sm text-gray-600">No production's checkout offers it yet.</p>
        <% end %>
      </section>


      <%
        actions = [
          (unless @list.main?
             { text: "Change where it collects", description: "Which productions' checkout offers it", path: "#",
               icon: "M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z",
               data: { controller: "modal", action: "click->modal#open", modal_id: "collects-modal" } }
           end),
          { text: "Export", description: "A spreadsheet of everyone on it, by email", path: manage_export_mailing_list_path(@list),
            icon: "M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3", data: { turbo_method: :post } },
          { text: (@list.main? ? "Change its checkout words" : "Rename"), description: (@list.main? ? "What the box says at checkout" : "Its name and checkout words"), path: "#",
            icon: "M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.1 2.1 0 013 3L12 15l-4 1 1-4 9.5-9.5z",
            data: { controller: "modal", action: "click->modal#open", modal_id: "rename-modal" } },
          (if @list.archived?
             { text: "Unarchive this list", description: "Collect at checkout again", path: manage_unarchive_mailing_list_path(@list),
               icon: "M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6", data: { turbo_method: :post } }
           elsif !@list.main?
             { text: "Archive this list", description: "Stops collecting; keeps its followers", path: "#", tone: :muted,
               icon: [ "M21 8v13H3V8", "M1 3h22v5H1z", "M10 12h4" ],
               data: { controller: "modal", action: "click->modal#open", modal_id: "archive-modal" } }
           end)
        ].compact
      %>
      <%= render "shared/action_list", items: actions %>
    </aside>
  </div>
</div>

<%# ---- Windows ---- %>

<%# Add people: one person, or many pasted (Check previews a paste; it's optional),
    on the usual tabs (tabs_controller); follower-paste swaps the footer's buttons. %>
<% follower_tab_class = "py-2 px-1 text-sm font-medium border-b-2 cursor-pointer whitespace-nowrap" %>
<div data-controller="follower-paste tabs" data-follower-paste-check-url-value="<%= manage_check_mailing_list_followers_path(@list) %>"
     data-tabs-plain-value="true" data-tabs-url-value="false" data-action="tabs:change->follower-paste#tabChanged">
  <%= render "manage/mailing_lists/modal", id: "add-people-modal", title: "Add people", wide: true, open: params[:add].present?,
        body: capture {
          concat tag.nav(class: "flex gap-4 border-b border-gray-200 mb-4", aria: { label: "Tabs" }) {
            concat tag.button("One person", type: "button", class: "#{follower_tab_class} border-pink-500 text-pink-600", data: { tabs_target: "tab", index: 0, action: "tabs#select" })
            concat tag.button("Paste many", type: "button", class: "#{follower_tab_class} border-transparent text-gray-500 hover:text-gray-700", data: { tabs_target: "tab", index: 1, action: "tabs#select" })
          }
          concat(form_with(url: manage_mailing_list_followers_path(@list), method: :post, id: "add-one-form", data: { turbo: false, tabs_target: "panel" }, class: "space-y-4") do
            concat tag.div {
              concat tag.label("Name", for: "add_name", class: "block text-sm font-medium text-gray-700 mb-1.5")
              concat text_field_tag(:name, nil, id: "add_name", class: follower_input_class, autocomplete: "off")
            }
            concat tag.div {
              concat tag.label("Email", for: "add_email", class: "block text-sm font-medium text-gray-700 mb-1.5")
              concat email_field_tag(:email, nil, id: "add_email", required: true, class: follower_input_class, autocomplete: "off")
            }
            concat tag.p("They're added to #{@list.name}. Add only people who asked to hear from you.", class: "text-xs text-gray-500")
          end)
          concat(form_with(url: manage_mailing_list_followers_path(@list), method: :post, id: "add-paste-form", data: { turbo: false, tabs_target: "panel" }, class: "hidden space-y-4") do
            concat tag.div {
              concat tag.label("Names and emails, one per line", for: "add_text", class: "block text-sm font-medium text-gray-700 mb-1.5")
              concat text_area_tag(:text, nil, id: "add_text", rows: 6, class: "#{follower_input_class} font-mono text-[13px]",
                                   placeholder: "Rosa Delgado, rosa@example.com\ntkwan@example.com", data: { follower_paste_target: "text", action: "input->follower-paste#edited" })
              concat tag.p("Copy two columns from a spreadsheet, or just the emails.", class: "text-xs text-gray-500 mt-1.5")
            }
            concat render("shared/button", text: "Check", variant: "secondary", size: "small", type: :button, data: { action: "follower-paste#check" })
            concat tag.div(data: { follower_paste_target: "result" })
            concat tag.label(class: "flex items-start gap-2.5 text-sm text-gray-700") {
              concat check_box_tag(:permission, "1", false, class: "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500",
                                   data: { follower_paste_target: "permission", action: "change->follower-paste#refresh" })
              concat tag.span("These people asked to hear from #{Current.organization.name}, or I otherwise have their permission.")
            }
          end)
        },
        footer: capture {
          concat render("shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" })
          concat tag.span(data: { follower_paste_target: "addOne" }) { render("shared/button", text: "Add", variant: "primary", size: "medium", type: :submit, form_id: "add-one-form") }
          concat tag.span(data: { follower_paste_target: "addPaste" }) { render("shared/button", text: "Add people", variant: "primary", size: "medium", type: :submit, form_id: "add-paste-form", disabled: true) }
        } %>
</div>

<% unless @list.main? %>
  <%= render "manage/mailing_lists/modal", id: "collects-modal", title: "Where #{@list.name} collects",
        body: capture {
          concat tag.p("Checkout for these productions offers a box to join this list.", class: "text-sm text-gray-700 mb-4")
          concat(form_with(url: manage_mailing_list_productions_path(@list), method: :patch, id: "collects-form", data: { turbo: false }) do
            concat hidden_field_tag("production_ids[]", "", id: nil)
            concat(tag.div(class: "rounded-lg border border-gray-200 divide-y divide-gray-100 max-h-80 overflow-y-auto") do
              @all_productions.each do |production|
                concat(tag.label(class: "flex items-center gap-3 px-3.5 py-2.5 text-sm text-gray-900 cursor-pointer") do
                  concat check_box_tag("production_ids[]", production.id, @productions.include?(production), id: "collect_#{production.id}",
                                       class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500")
                  concat tag.span(production.name, class: "min-w-0 flex-1 truncate")
                  concat tag.span("Contract", class: "inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-700") if production.type_third_party?
                end)
              end
            end)
          end)
        },
        footer: capture {
          concat render("shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" })
          concat render("shared/button", text: "Save", variant: "primary", size: "medium", type: :submit, form_id: "collects-form")
        } %>
<% end %>

<%= render "manage/mailing_lists/modal", id: "rename-modal", title: (@list.main? ? "Checkout words" : "Rename #{@list.name}"),
      body: capture {
        form_with(model: @list, url: manage_mailing_list_path(@list), method: :patch, id: "rename-form", data: { turbo: false }, class: "space-y-4") do |f|
          unless @list.main?
            concat tag.div {
              concat f.label(:name, "Name", class: "block text-sm font-medium text-gray-700 mb-1.5")
              concat f.text_field(:name, class: follower_input_class, required: true)
            }
          end
          concat tag.div {
            concat f.label(:checkout_words, "The box at checkout says", class: "block text-sm font-medium text-gray-700 mb-1.5")
            concat f.text_field(:checkout_words, class: follower_input_class, placeholder: @list.box_words)
            concat tag.p("Leave it blank for \"#{@list.main? ? "Send me news from #{Current.organization.name}" : "Send me news about #{@list.name}"}\".", class: "text-xs text-gray-500 mt-1.5")
          }
        end
      },
      footer: capture {
        concat render("shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" })
        concat render("shared/button", text: "Save", variant: "primary", size: "medium", type: :submit, form_id: "rename-form")
      } %>

<% unless @list.main? || @list.archived? %>
  <%= render "shared/confirm_modal", id: "archive-modal", title: "Archive #{@list.name}?",
        message: "It stops collecting at checkout and drops off your lists. Its followers stay, and you can bring it back.",
        confirm_text: "Archive", url: manage_archive_mailing_list_path(@list), method: :post %>
<% end %>

<% @followers.each do |follower| %>
  <%= render "shared/confirm_modal", id: "remove-follower-#{follower.id}", title: "Take #{follower.display_name} off #{@list.name}?",
        message: "They stay on your other lists. To stop all your emails to them, they unsubscribe from one.",
        confirm_text: "Take them off", url: manage_mailing_list_follower_path(@list, follower_id: follower.id), method: :delete %>
<% end %>
