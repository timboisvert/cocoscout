<% content_for :title, "Edit #{@production.name}" %>
<%# Pay, Agreement and Tickets are Pro, and Pro is the organization's managers':
    a producer editing their production sees a note there, never the controls. %>
<% org_manager = Current.user&.superadmin? || @production.organization.manageable_by?(Current.user) %>
<%# Services (after-V1 #6): Pro and the managers', and no tab at all otherwise. %>
<% services_on = @production.organization.services_available_to?(Current.user) %>
<%# Casting: whether people are cast in it at all, for a production we run
    casting for (not one booked by a contract, not a course). %>
<% casting_tab = @production.castable? %>

<div class="w-full">

  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <!-- Production Info Card -->
  <%= render "manage/productions/production_info_card", production: @production %>

  <%# The tabs, in order (ProductionsHelper#production_edit_tabs): the strip,
      the phone's section picker (the row and sheet every settings page has),
      and the panels below all follow it, branch for branch. %>
  <%
    edit_tabs = production_edit_tabs(@production)
    tab_features = { agreement: :agreements, pay: :money, tickets: :ticketing, services: nil }
  %>
  <!-- Tabs Section -->
  <div class="w-full" data-controller="tabs">
    <%
      edit_sections = edit_tabs.each_with_index.map { |key, i|
        feature = tab_features[key]
        { label: ProductionsHelper::PRODUCTION_TAB_LABELS.fetch(key), index: i, active: i.zero?, danger: key == :danger_zone, pro: tab_features.key?(key),
          group: ProductionsHelper::PRODUCTION_TAB_GROUPS[key],
          locked: feature.present? && !@production.organization.feature_available?(feature) }
      }
    %>
    <div data-production-edit-sections>
      <%= render "shared/section_picker", id: "production-edit-sections-sheet", list_from: "md", sections: edit_sections %>
    </div>
    <%# From md up: the sections down the left (shared/section_list), the
        section showing beside them. %>
    <div class="md:flex md:items-start md:gap-8">
    <%= render "shared/section_list", sections: edit_sections %>
    <div class="flex-1 min-w-0">

    <!-- Tab 1: Basic Information -->
    <div data-tabs-target="panel">
      <% basics_contract = production_basics_contract(@production) %>
      <%= form_with(model: [:manage, @production], class: "contents") do |form| %>
        <!-- Production Details Card -->
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
          <%= render "shared/section_heading", title: "Production details" %>
          <div class="p-6 pt-4 space-y-6">
            <% if basics_contract %>
              <%# A running contract owns these: Amend → Change the basic info. %>
              <div>
                <p class="block text-sm font-medium text-gray-700 mb-1">Production Name</p>
                <p class="text-gray-900"><%= @production.name %></p>
              </div>
              <div>
                <p class="block text-sm font-medium text-gray-700 mb-1">Description</p>
                <% if @production.description.present? %>
                  <div class="text-sm text-gray-600"><%= @production.description %></div>
                <% else %>
                  <p class="text-sm text-gray-500">No description yet.</p>
                <% end %>
              </div>
              <div class="flex items-center justify-between gap-3 flex-wrap pt-4 border-t border-gray-100">
                <% if can_amend_production_basics?(@production) %>
                  <p class="text-sm text-gray-500">These change through the contract with <%= basics_contract.contractor_name %>, with nothing to re-sign.</p>
                  <%= render "shared/button", text: "Change in the contract", variant: "secondary", size: "small", icon: "pencil",
                        path: amend_basics_manage_contract_path(basics_contract) %>
                <% else %>
                  <p class="text-sm text-gray-500">These change through the contract with <%= basics_contract.contractor_name %>, which your organization's managers look after.</p>
                <% end %>
              </div>
            <% else %>
              <div>
                <%= form.label :name, "Production Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= form.text_field :name, class: ["block w-full rounded-lg border px-3 py-2 shadow-sm focus:border-pink-500 focus:ring-pink-500", {"border-gray-300": @production.errors[:name].none?, "border-pink-500": @production.errors[:name].any?}], placeholder: "Enter production name" %>
                <% if @production.errors[:name].any? %>
                  <p class="mt-1 text-sm text-pink-600"><%= @production.errors[:name].first %></p>
                <% end %>
              </div>

              <div>
                <%= form.label :description, "Description", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <p class="text-xs text-gray-500 mb-2">A brief description of your production shown on public listings</p>
                <div data-controller="no-attachments">
                  <%= form.rich_text_area :description, class: "w-full min-h-[150px]", placeholder: "Describe your production..." %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <% if @production.type_third_party? %>
          <%# Third-Party Contract Info %>
          <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
            <%# The Pro mark sits in the header, as on every Pro card (Tim, 2026-10-16). %>
            <%= render "shared/section_heading", title: "Contract information" do %>
              <%= render "shared/pro_marker", kind: :header %>
            <% end %>
            <div class="p-6 pt-4">
              <% if @production.contract.present? %>
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-sm font-medium text-gray-900"><%= @production.contract.contractor_name %></p>
                    <p class="text-sm text-gray-500">
                      <% if @production.contract.contract_start_date && @production.contract.contract_end_date %>
                        <%= @production.contract.contract_start_date.strftime("%b %-d, %Y") %> - <%= @production.contract.contract_end_date.strftime("%b %-d, %Y") %>
                      <% else %>
                        Contract dates not set
                      <% end %>
                    </p>
                  </div>
                  <%# Contracts are the organization's managers'; nobody else gets the link. %>
                  <% if Current.user&.superadmin? || @production.organization.manageable_by?(Current.user) %>
                    <% contracts_ok = @production.organization.feature_available?(:contracts) %>
                    <span class="inline-flex items-center gap-1.5">
                      <%= render "shared/pro_marker", kind: :lock unless contracts_ok %>
                      <%= render "shared/button", text: "View Contract", variant: "secondary", size: "small", path: manage_contract_path(@production.contract),
                            data: (contracts_ok ? {} : { action: "click->upgrade-modal#open", upgrade_feature: "contracts" }) %>
                    </span>
                  <% end %>
                </div>
              <% else %>
                <p class="text-sm text-gray-500">This production was created from a third-party contract.</p>
              <% end %>
            </div>
          </div>
        <% else %>
          <!-- Contact Settings Card -->
          <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
            <%= render "shared/section_heading", title: "Contact settings" %>
            <div class="p-6 pt-4">
              <div>
                <%= form.label :contact_email, "Contact Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <p class="text-xs text-gray-500 mb-2">Used for automated emails and public inquiries</p>
                <%= form.email_field :contact_email, autocapitalize: "none", class: ["block w-full rounded-lg border px-3 py-2 shadow-sm focus:border-pink-500 focus:ring-pink-500", {"border-gray-300": @production.errors[:contact_email].none?, "border-pink-500": @production.errors[:contact_email].any?}], placeholder: "contact@example.com" %>
                <% if @production.errors[:contact_email].any? %>
                  <p class="mt-1 text-sm text-pink-600"><%= @production.errors[:contact_email].first %></p>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <%# A contracted production's tab has nothing to save here. %>
        <% unless basics_contract %>
          <!-- Save Button -->
          <div class="flex justify-end">
            <%= render "shared/button", text: "Save Changes", variant: "primary", size: "medium", type: :submit %>
          </div>
        <% end %>
      <% end %>
      <%# Money in: a form of its own, after the details' Save. %>
      <% if org_manager %>
        <div class="mt-6"><%= render "manage/productions/money_in_card" %></div>
      <% end %>
    </div>

    <!-- Tab 2: Visual Assets -->
    <%# Drawn from the organization's list of visual assets (Tim, 2026-11-19). %>
    <div data-tabs-target="panel" class="hidden">
      <%= render "manage/visual_assets/tab", production: @production, can_manage: current_user_can_manage?(@production) %>
    </div>

    <!-- Tab 3: Documents -->
    <div data-tabs-target="panel" class="hidden space-y-6">
      <%# The shared folder: one link to Google Drive, Dropbox, or OneDrive,
          shown next to the documents (Tim, 2026-11-19). %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <%= render "shared/section_heading", title: "Shared folder" %>
        <div class="p-6 pt-4">
          <p class="text-sm text-gray-600 mb-4">If your production keeps its files on Google Drive, Dropbox, or OneDrive, link the folder here. Everyone in the production will see it next to your documents, and the folder's own sharing settings decide who can open it.</p>
          <% link_error = flash[:documents_link_error] %>
          <% link_attempt = (flash[:documents_link_attempt] || {}).with_indifferent_access %>
          <%= form_with model: @production, url: update_documents_link_manage_production_path(@production), method: :patch, id: "documents-link-form", data: { turbo_action: "replace" } do |f| %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <%= f.label :documents_link_url, "Folder link", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.url_field :documents_link_url, value: link_error ? link_attempt[:documents_link_url] : @production.documents_link_url,
                      autocapitalize: "none", placeholder: "https://drive.google.com/drive/folders/...",
                      class: ["block w-full rounded-lg border px-3 py-2 shadow-sm focus:border-pink-500 focus:ring-pink-500", link_error ? "border-pink-500" : "border-gray-300"] %>
                <% if link_error %>
                  <p class="text-sm text-red-600 mt-2" data-documents-link-error><%= link_error %></p>
                <% end %>
              </div>
              <div>
                <%= f.label :documents_link_name, "Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.text_field :documents_link_name, value: link_error ? link_attempt[:documents_link_name] : @production.documents_link_name,
                      maxlength: 100, placeholder: "Rehearsal files",
                      class: "block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-end gap-3 mt-4">
              <% if @production.documents_link? %>
                <%= render "shared/button", text: "Remove link", variant: "secondary", size: "medium", type: :button,
                      data: { controller: "modal", action: "click->modal#open", modal_id: "remove-documents-link" } %>
              <% end %>
              <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
            </div>
          <% end %>
          <% if @production.documents_link? %>
            <div class="mt-6">
              <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">What people will see</div>
              <%= render "shared/documents_link", production: @production %>
            </div>
          <% end %>
        </div>
      </div>
      <% if @production.documents_link? %>
        <%= render "shared/confirm_modal", id: "remove-documents-link",
              title: "Remove the shared folder?",
              message: "People in #{h(@production.name)} won't see the link next to your documents anymore. The folder itself stays as it is on #{@production.documents_link_provider_name}.",
              confirm_text: "Remove link",
              url: update_documents_link_manage_production_path(@production), method: :patch,
              params: { "production[documents_link_url]" => "" } %>
      <% end %>
      <% production_documents = @production.applied_documents.includes(:shares).ordered %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <%= render "shared/section_heading", title: "Documents" do %>
          <%= link_to manage_production_documents_path(@production) do %>
            <%= render "shared/button", text: "All documents", variant: "primary", size: "small" %>
          <% end %>
          <%= link_to manage_new_org_document_path(production_id: @production.id) do %>
            <%= render "shared/button", text: "New document", variant: "primary", size: "small", icon: "plus" %>
          <% end %>
        <% end %>
        <div class="p-6 pt-4">
          <% if production_documents.any? %>
            <div class="space-y-2">
              <% production_documents.each do |doc| %>
                <%= link_to manage_production_document_path(@production, doc),
                      class: "flex items-center gap-3 border border-gray-200 rounded-lg px-4 py-3 hover:border-pink-400 hover:bg-pink-50/40 transition-colors" do %>
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-gray-900 truncate"><%= doc.title %></div>
                    <div class="text-xs text-gray-500 mt-0.5">Shared with: <%= doc.audience_summary %></div>
                  </div>
                  <% if doc.productions.size > 1 %>
                    <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-indigo-50 text-indigo-700 font-bold flex-shrink-0" title="Applies to <%= doc.applies_to_summary %>">Shared</span>
                  <% end %>
                  <svg class="w-5 h-5 text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-6 text-center">
              <p class="text-sm text-gray-600 mb-3">No documents yet. Create a performer handbook or any document your team needs.</p>
              <%= link_to manage_new_org_document_path(production_id: @production.id) do %>
                <%= render "shared/button", text: "Create your first document", variant: "primary", size: "small" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Tab 4: Team (every production, contracted ones too) -->
    <div data-tabs-target="panel" class="hidden">
      <%= render "team_permissions" %>
    </div>

    <% if casting_tab %>
      <!-- Casting: the production's answer, and the way into the rest -->
      <div data-tabs-target="panel" class="hidden space-y-6" data-production-casting-tab>
        <%= render "manage/casting/answer_card", production: @production, return_to: "production_edit" %>
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
          <%= render "shared/section_heading", title: "Casting Settings" %>
          <div class="px-6 py-5 flex flex-wrap items-center justify-between gap-3">
          <% case @production.casting_state %>
          <% when :not_set_up %>
            <p class="text-sm text-gray-700">Casting isn't set up for <%= @production.name %> yet: who you cast, your roles, and which dates are cast.</p>
            <%= render "shared/button", text: "Set up casting", variant: "primary", size: "small", path: manage_casting_setup_path(@production) %>
          <% when :on %>
            <p class="text-sm text-gray-700">Who you cast, which dates are cast, your <%= @production.act_based? ? "lineup" : "roles" %>, and the talent pool are in Casting Settings.</p>
            <%= render "shared/button", text: "Casting Settings", variant: "secondary", size: "small", path: manage_casting_settings_path(@production) %>
          <% else %>
            <p class="text-sm text-gray-700">A single date can still be cast: turn casting on from that date's page.</p>
          <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% unless @production.type_third_party? %>
      <!-- Agreement -->
      <div data-tabs-target="panel" class="hidden">
        <% templates = @production.organization.agreement_templates.active.order(:name) %>

        <%# Same shape as the Pay tab: one card, Pro pill in the header, and the
            locked treatment inside it when the plan doesn't include agreements. %>
        <% if !org_manager %>
          <%= render "manage/productions/managers_only_card", title: "Performer agreements",
                description: "Performer agreements for #{@production.name} are set up by your organization's managers." %>
        <% elsif !@production.organization.feature_available?(:agreements) %>
          <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
            <%= render "shared/section_heading", title: "Performer agreements" do %>
              <%= render "shared/pro_marker", kind: :header %>
            <% end %>
            <div class="p-6 pt-4">
              <%= render "shared/pro_locked_card", feature: :agreements,
                    title: "Performers sign an agreement for this production",
                    description: "Pro feature — reusable agreement templates, in-app e-signatures, and a signed / awaiting / not-sent roster, sent by hand or automatically when someone joins your talent pool." %>
            </div>
          </div>
        <% else %>

        <!-- Agreement Settings Card -->
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
          <%= render "shared/section_heading", title: "Agreement settings" do %>
            <%= render "shared/pro_marker", kind: :header %>
          <% end %>
          <div class="p-6 pt-4">
            <%= form_with(model: [:manage, @production], url: manage_production_path(@production), method: :patch) do |f| %>
              <% if templates.any? %>
                <div class="space-y-5">
                  <!-- Template Selection -->
                  <div class="max-w-md">
                    <label for="production_agreement_template_id" class="block text-sm font-medium text-gray-700 mb-1">
                      Agreement Template
                    </label>
                    <%= f.select :agreement_template_id,
                        options_for_select(
                          [["None - no agreement required", nil]] + templates.map { |t| [t.name, t.id] },
                          @production.agreement_template_id
                        ),
                        {},
                        class: "w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
                  </div>

                  <% if @production.agreement_template.present? %>
                    <!-- Enforcement Option -->
                    <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-lg">
                      <%= f.check_box :agreement_required,
                          class: "mt-0.5 h-4 w-4 rounded border-gray-300 accent-pink-500" %>
                      <div>
                        <%= f.label :agreement_required, class: "text-sm font-medium text-gray-900" do %>
                          Require signature before casting
                        <% end %>
                        <p class="text-xs text-gray-500 mt-0.5">
                          Performers must sign this agreement before they can be assigned to shows.
                        </p>
                      </div>
                    </div>

                    <!-- How it's sent -->
                    <div>
                      <span class="block text-sm font-medium text-gray-900 mb-2">How performers receive it</span>
                      <div class="space-y-2">
                        <label class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 cursor-pointer hover:border-pink-300 has-[:checked]:border-pink-400 has-[:checked]:bg-pink-50">
                          <%= f.radio_button :agreement_auto_send, false, class: "mt-0.5 h-4 w-4 border-gray-300 accent-pink-500" %>
                          <span>
                            <span class="block text-sm font-medium text-gray-900">Send manually</span>
                            <span class="block text-xs text-gray-500 mt-0.5">You decide when to send it, from the agreement roster. Nothing goes out automatically.</span>
                          </span>
                        </label>
                        <label class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 cursor-pointer hover:border-pink-300 has-[:checked]:border-pink-400 has-[:checked]:bg-pink-50">
                          <%= f.radio_button :agreement_auto_send, true, class: "mt-0.5 h-4 w-4 border-gray-300 accent-pink-500" %>
                          <span>
                            <span class="block text-sm font-medium text-gray-900">Send automatically when added to the talent pool</span>
                            <span class="block text-xs text-gray-500 mt-0.5">The moment someone joins this production's talent pool, they're asked to sign. (Requires "Require signature" above.)</span>
                          </span>
                        </label>
                      </div>
                    </div>

                    <!-- Actions Row -->
                    <div class="flex items-center justify-between pt-2">
                      <%= link_to preview_manage_agreement_template_path(@production.agreement_template),
                          class: "inline-flex items-center gap-1.5 text-sm text-gray-600 hover:text-pink-600",
                          data: { turbo_frame: "agreement_preview_modal" } do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        Preview
                      <% end %>
                      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
                    </div>
                  <% else %>
                    <div class="flex justify-end pt-2">
                      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <!-- No Templates Yet -->
                <div class="text-center py-8">
                  <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  <h3 class="mt-3 text-sm font-medium text-gray-900">No agreement templates</h3>
                  <p class="mt-1 text-sm text-gray-500">Create a template to require performers to sign before casting.</p>
                  <div class="mt-4">
                    <%= render "shared/button", text: "Create Template", variant: "primary", size: "small", path: new_manage_agreement_template_path %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>

        <% if templates.any? && !@production.agreement_template.present? %>
          <p class="text-sm text-gray-500 text-center">
            Or <%= link_to "manage your templates", manage_agreement_templates_path, class: "text-pink-600 hover:text-pink-700" %>
          </p>
        <% end %>

        <% if @production.agreement_required? %>
          <% counts = @production.agreement_roster_counts %>

          <!-- Signature Status Card -->
          <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
            <%= render "shared/section_heading", title: "Signature status" %>
            <div class="p-6 pt-4">
              <% if counts[:total].zero? %>
                <div class="text-center py-4 mb-4">
                  <p class="text-sm text-gray-500">No performers in the talent pool yet.</p>
                </div>
              <% else %>
                <div class="flex items-center gap-4 mb-2">
                  <div class="text-2xl font-bold text-gray-900"><%= counts[:signed] %><span class="text-gray-400 font-normal"> / <%= counts[:total] %></span></div>
                  <div class="text-sm text-gray-500">have signed</div>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-1.5 mb-4">
                  <div class="bg-pink-500 h-1.5 rounded-full transition-all" style="width: <%= counts[:total] > 0 ? (counts[:signed] * 100.0 / counts[:total]).round : 0 %>%"></div>
                </div>
                <div class="flex flex-wrap items-center gap-2 mb-5 text-xs">
                  <span class="inline-flex items-center rounded-full bg-green-50 border border-green-200 px-2.5 py-1 font-medium text-green-700"><%= counts[:signed] %> signed</span>
                  <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 font-medium text-amber-700"><%= counts[:awaiting] %> awaiting</span>
                  <span class="inline-flex items-center rounded-full bg-gray-50 border border-gray-200 px-2.5 py-1 font-medium text-gray-600"><%= counts[:not_sent] %> not sent</span>
                </div>
              <% end %>

              <%= link_to agreement_status_manage_production_path(@production) do %>
                <%= render "shared/button", text: "Manage & send agreements", variant: "primary", size: "small" %>
              <% end %>
            </div>
          </div>
        <% end %>
        <% end %>
      </div>

    <!-- Pay -->
    <div data-tabs-target="panel" class="hidden">
      <% if org_manager %>
        <%= render "manage/productions/pay_tab", production: @production %>
      <% else %>
        <%= render "manage/productions/managers_only_card", title: "Performer pay",
              description: "How performers on #{@production.name} are paid is set by your organization's managers." %>
      <% end %>
    </div>
    <% end %>

    <!-- Tickets (Pro): the Tickets question (Round 9 §3). Dates inherit the answer; a date can answer for itself on its own Tickets tab. -->
    <div data-tabs-target="panel" class="hidden">
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <%# The question is the heading only where the question is asked: not for a
            producer, and not behind the Pro pitch. %>
        <%= render "shared/section_heading",
              title: (org_manager && @production.organization.feature_available?(:ticketing) ? "Where do people get tickets for #{@production.name}?" : "Tickets") %>
        <div class="px-6 py-5">
        <% if !org_manager %>
          <p class="text-sm text-gray-600">Tickets for <%= @production.name %> are set up by your organization's managers.</p>
        <% elsif @production.organization.feature_available?(:ticketing) %>
          <%= render "shared/ticketing/tickets_question", production: @production, cocoscout_fields: false, heading: false,
                return_to: edit_manage_production_path(@production, tab: production_tickets_tab(@production)) %>
          <p class="mt-4 text-xs text-gray-500">Every date of <%= @production.name %> follows this. A date can answer for itself on its own Tickets tab.</p>
        <% else %>
          <%= render "manage/billing/upgrade", paywall: Manage::PaidFeatureGate::FEATURE_DETAILS[:ticketing], feature: :ticketing %>
        <% end %>
        </div>
      </div>
    </div>

    <% if services_on %>
      <!-- Services (Pro): what every show needs -->
      <div data-tabs-target="panel" class="hidden">
        <%= render "manage/productions/services_tab", production: @production %>
      </div>
    <% end %>

    <% unless @production.type_third_party? %>
      <%# Public Listing: right of the Pro tabs, the last before the managers' last tab (Tim, 2026-11-18). %>
      <div data-tabs-target="panel" class="hidden" data-controller="production-profile-modals profile-visibility">
      <!-- Public Profile Card -->
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
        <%= render "shared/section_heading", title: "Public listing" %>
        <div class="p-6 pt-4">
          <div class="space-y-4">
            <!-- Enable/Disable Toggle -->
            <%= form_with(model: [:manage, @production], url: manage_production_path(@production), method: :patch, data: { turbo: true, profile_visibility_target: "form" }) do |f| %>
              <div class="flex items-center justify-between">
                <div class="flex-1">
                  <p class="text-sm font-medium text-gray-700">Enable Public Listing</p>
                  <p class="text-xs text-gray-500 mt-1">
                    When enabled, this production will be visible to anyone with the listing URL
                  </p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer ml-4">
                  <%= f.check_box :public_profile_enabled,
                    { class: "sr-only peer",
                      data: {
                        action: "change->profile-visibility#toggle",
                        profile_visibility_target: "checkbox"
                      }
                    } %>
                  <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-pink-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-pink-500"></div>
                </label>
              </div>
            <% end %>

            <!-- Profile Content (shown when enabled) -->
            <div data-profile-visibility-target="content" class="pt-4 border-t border-gray-200 <%= 'hidden' unless @production.public_profile_enabled %>">
              <!-- URL Box -->
              <% if @production.public_key.present? %>
                <%= render "shared/copy_url", url: public_profile_url(@production.public_key), label: "#{@production.name}'s Public Listing URL" %>
                <p class="mt-1 mb-4 text-xs text-gray-500">
                  <a href="javascript:void(0)" data-action="click->production-profile-modals#openChangeUrl" class="text-pink-500 hover:text-pink-600 underline">Change URL</a>
                </p>

                <!-- Action Buttons -->
                <div class="flex flex-wrap gap-3">
                  <%= render "shared/button",
                      text: "View Public Listing",
                      variant: "primary",
                      icon: "eye",
                      path: public_profile_url(@production.public_key),
                      target: "_blank",
                      rel: "noopener" %>
                  <%= render "shared/button",
                      text: "Share Listing",
                      variant: "outline",
                      icon: "share",
                      data: { action: "click->production-profile-modals#openShare" },
                      type: :button %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Profile Sections (shown when enabled) -->
      <div data-profile-visibility-target="sections" class="<%= 'hidden' unless @production.public_profile_enabled %>">
        <!-- Features Card -->
        <%= turbo_frame_tag "features_frame" do %>
          <%= render "manage/productions/features_card", production: @production %>
        <% end %>
      </div>

      <% if @production.public_key.present? %>
      <!-- Share Modal -->
      <div data-production-profile-modals-target="shareModal" data-action="click->production-profile-modals#closeModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full" data-action="click->production-profile-modals#stopPropagation">
          <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
            <h2 class="text-xl font-semibold text-gray-900 coustard-regular">Share Production Listing</h2>
            <button type="button" data-action="click->production-profile-modals#closeModal" class="text-gray-400 hover:text-gray-500 cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          <div class="p-6 space-y-6">
            <% profile_url = public_profile_url(@production.public_key) if @production.public_key.present? %>
            <div data-controller="copy-url">
              <label class="block text-sm font-medium text-gray-700 mb-2">Production Listing URL</label>
              <div class="flex items-center gap-2">
                <input type="text" readonly value="<%= profile_url %>" class="flex-1 px-3 py-2 text-sm bg-gray-50 border border-gray-300 rounded-lg focus:outline-none">
                <button type="button" data-action="click->copy-url#copy" data-url="<%= profile_url %>" class="px-4 py-2 text-sm font-medium text-pink-500 hover:text-pink-600 hover:bg-pink-50 rounded-lg transition-colors cursor-pointer">
                  <span data-copy-url-target="buttonText">Copy</span>
                </button>
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-3">Share on social media</label>
              <div class="flex items-center justify-center gap-4">
                <a href="https://www.facebook.com/sharer/sharer.php?u=<%= CGI.escape(profile_url.to_s) %>" target="_blank" rel="noopener" class="flex items-center justify-center w-12 h-12 text-white bg-[#1877F2] hover:bg-[#0d65d9] rounded-full transition-colors">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>
                <a href="https://twitter.com/intent/tweet?url=<%= CGI.escape(profile_url.to_s) %>&text=Check%20out%20this%20production%20on%20CocoScout" target="_blank" rel="noopener" class="flex items-center justify-center w-12 h-12 text-white bg-black hover:bg-gray-800 rounded-full transition-colors">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>
                <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= CGI.escape(profile_url.to_s) %>" target="_blank" rel="noopener" class="flex items-center justify-center w-12 h-12 text-white bg-[#0A66C2] hover:bg-[#004182] rounded-full transition-colors">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Change URL Modal -->
      <div data-production-profile-modals-target="changeUrlModal" data-action="click->production-profile-modals#closeModal keydown.esc@window->production-profile-modals#closeModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full" data-action="click->production-profile-modals#stopPropagation" data-controller="url-checker" data-url-checker-check-url-value="<%= check_url_availability_manage_production_path(@production) %>">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-900 coustard-regular">Change Public Profile URL</h2>
          </div>
          <div class="p-6">
            <%= form_with(model: [:manage, @production], url: update_public_key_manage_production_path(@production), method: :patch, data: { url_checker_target: "form" }) do |f| %>
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Current URL</label>
                  <div class="p-3 bg-gray-50 rounded-lg border border-gray-200">
                    <div class="text-sm font-mono text-gray-600"><%= public_profile_url(@production.public_key) %></div>
                  </div>
                </div>
                <div>
                  <%= f.label :public_key, "New URL", class: "block text-sm font-medium text-gray-700 mb-2" %>
                  <div class="flex items-center gap-2">
                    <span class="text-sm text-gray-500"><%= request.base_url %>/</span>
                    <%= f.text_field :public_key, value: "", placeholder: "your-new-url", pattern: "[a-z0-9][a-z0-9\\-]{2,29}", class: "flex-1 rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-pink-500 focus:ring-pink-500", data: { url_checker_target: "input", action: "input->url-checker#inputChanged" } %>
                  </div>
                  <p class="mt-2 text-xs text-gray-500">3-30 characters: lowercase letters, numbers, hyphens only</p>
                </div>

                <!-- Status Message -->
                <div data-url-checker-target="message" class="rounded-lg border p-3 text-sm hidden"></div>
              </div>
              <div class="flex items-center justify-end gap-3 mt-6 pt-4 border-t border-gray-200">
                <%= render "shared/button",
                    text: "Cancel",
                    variant: "ghost-cancel",
                    data: { action: "click->production-profile-modals#closeModal" },
                    type: :button %>
                <%= render "shared/button",
                    text: "Check Availability",
                    variant: "primary",
                    size: "medium",
                    data: { action: "click->url-checker#checkAvailability", url_checker_target: "checkButton" },
                    type: :button %>
                <%= render "shared/button",
                    text: "Update URL",
                    variant: "primary",
                    size: "medium",
                    data: { action: "click->url-checker#submitForm", url_checker_target: "updateButton" },
                    style: "display: none;",
                    type: :button %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <% end %>
    </div>

    <% end %>

    <%# Danger Zone tab: the organization's managers' only (Tim, 2026-10-17); a
        production team member gets neither the tab nor the panel. %>
    <% if org_manager %>
    <div data-tabs-target="panel" class="hidden">
      <% if org_manager %>
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-6">
          <%= render "shared/section_heading", title: (@production.archived? ? "This production is archived" : "Archive this production") %>
          <div class="px-6 py-5">
          <% if @production.archived? %>
            <p class="text-sm text-gray-600 mb-4">
              It's hidden from your production lists and pickers. Nothing was deleted: its dates, people, money, and documents are all still here.
            </p>
            <%= render "shared/button", text: "Unarchive", variant: "primary", size: "medium",
                  path: unarchive_manage_production_path(@production), method: :post %>
          <% else %>
            <p class="text-sm text-gray-600 mb-4">
              Done with this one? Archiving hides it from your production lists and pickers. Nothing is deleted, and you can unarchive it from the Productions page any time.
            </p>
            <%= render "shared/button", text: "Archive this production", variant: "primary", size: "medium", type: :button,
                  data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-archive-production" } %>
          <% end %>
          </div>
        </div>
        <% unless @production.archived? %>
          <%= render "shared/confirm_modal", id: "confirm-archive-production",
                title: "Archive #{@production.name}?",
                message: "It disappears from your production lists and pickers. Nothing is deleted, and you can bring it back from the Productions page under Archived.",
                confirm_text: "Archive",
                url: archive_manage_production_path(@production), method: :post %>
        <% end %>
      <% end %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-6">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0">
            <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-semibold text-red-800 mb-2">Delete this Production</h3>
            <p class="text-sm text-red-700 mb-4">
              Deleting this production is <strong>permanent and cannot be undone</strong>. This action will remove the production and all associated data from the system.
            </p>
            <p class="text-sm text-red-700 mb-4">
              Before deleting, please review what will be removed. You'll be asked to confirm on the next page.
            </p>
            <div class="mt-6">
              <%= render "shared/button",
                  text: "Delete this production",
                  variant: "primary",
                  size: "medium",
                  path: confirm_delete_manage_production_path(@production),
                  icon: "trash" %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% end %>
    </div>
    </div>
  </div>

</div>

<%# Compose Message Modal - required for agreement reminder buttons %>
<%= render "shared/compose_message_modal" %>

<%# Host frame for the agreement preview modal (opened from the Agreement tab). %>
<%= turbo_frame_tag "agreement_preview_modal" %>