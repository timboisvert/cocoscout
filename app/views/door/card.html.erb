<%
  show = @listing.show
  tickets = @order.tickets.includes(:ticket_tier).to_a
%>
<% content_for :title, "Pay · #{@listing.display_title}" %>
<% content_for :door_header do %>
  <%= link_to door_path(@listing), class: "flex-shrink-0 -ml-2 p-2 rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100", "aria-label": "Back to the door" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  <% end %>
  <div class="min-w-0 flex-1">
    <div class="text-base font-semibold text-gray-900 leading-tight truncate"><%= @listing.display_title %></div>
    <div class="text-xs text-gray-500 truncate">Paying at the door · <%= show.date_and_time.strftime("%-l:%M %p") %></div>
  </div>
<% end %>

<%# The door phone, turned to face the buyer. %>
<div data-controller="door-card"
     data-door-card-status-url-value="<%= door_card_status_path(@listing, token: @order.token) %>"
     data-door-card-expires-at-value="<%= @order.expires_at&.iso8601 %>">
  <div data-door-card-target="waiting" class="rounded-2xl border border-gray-200 bg-white p-5 text-center">
    <div class="text-sm text-gray-600"><%= tickets.group_by(&:ticket_tier).map { |tier, ts| "#{ts.size} × #{tier.name}" }.join(", ") %></div>
    <div class="mt-1 text-4xl font-bold tabular-nums text-gray-900"><%= number_to_currency(@order.total_cents / 100.0) %></div>
    <div class="mx-auto mt-4 w-64 max-w-full rounded-xl border border-gray-200 bg-white p-3"><%= link_qr_svg(@checkout_url) %></div>
    <p class="mt-4 text-base font-medium text-gray-900">Scan with your phone's camera to pay</p>
    <p class="mt-1 text-sm text-gray-600">Apple Pay, Google Pay or a card</p>
    <p class="mt-4 text-sm text-gray-500">Waiting for payment · held <span class="tabular-nums" data-door-card-target="countdown"></span></p>
    <div class="mt-4 flex justify-center">
      <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium",
            path: door_card_cancel_path(@listing, token: @order.token), method: :post %>
    </div>
  </div>

  <div data-door-card-target="paid" class="hidden rounded-2xl border-2 border-green-300 bg-green-50 p-6 text-center">
    <svg class="mx-auto w-14 h-14 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <p class="mt-3 text-2xl font-semibold text-green-800">Paid</p>
    <p class="mt-1 text-base text-green-800" data-door-card-target="paidText">Checked in.</p>
    <div class="mt-5 flex justify-center">
      <%= render "shared/button", text: "Back to the door", variant: "primary", size: "large", path: door_path(@listing) %>
    </div>
  </div>

  <div data-door-card-target="expired" class="hidden rounded-2xl border-2 border-amber-300 bg-amber-50 p-6 text-center">
    <p class="text-xl font-semibold text-amber-800">This payment timed out</p>
    <p class="mt-1 text-sm text-amber-800">Nothing was charged and the seats went back.</p>
    <div class="mt-5 flex justify-center">
      <%= render "shared/button", text: "Start over", variant: "primary", size: "large", path: door_path(@listing) %>
    </div>
  </div>
</div>
