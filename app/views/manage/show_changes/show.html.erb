<% content_for :title, "Notify cast and staff" %>

<%#
  Notify cast and staff (docs/show_change_notices_plan.md): what changed,
  then a notification for each group touched (the cast and the staff of
  dates that are off, and of dates that moved), each message seen and edited
  before it goes. ?audience= shows just the cast or the staff. Not now leaves
  them waiting (Home says so); Nobody needs to be notified closes it.
%>
<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Home", manage_path ] ],
    text: @audience ? "Notify the #{@audience}" : "Notify cast and staff",
    links: []
  } %>

  <div class="max-w-3xl space-y-5">
    <div class="bg-white border border-gray-200 rounded-xl" data-show-changes>
      <%= render "shared/section_heading", title: @changes.one? ? "What changed" : "What changed (#{@changes.size} dates)" %>
      <ul class="divide-y divide-gray-100">
        <% @changes.each do |change| %>
          <li class="px-6 py-3 flex flex-wrap items-baseline gap-x-3 gap-y-1" data-show-change="<%= change.id %>">
            <% tone, word = case change.kind
                            when "canceled" then [ "bg-red-50 text-red-700 border-red-200", "Canceled" ]
                            when "removed" then [ "bg-gray-100 text-gray-700 border-gray-200", "Taken off" ]
                            else [ "bg-amber-50 text-amber-800 border-amber-200", change.booking_only? ? "Booking moved" : "Moved" ]
                            end %>
            <span class="text-[11px] font-semibold rounded-full border px-2 py-0.5 <%= tone %>"><%= word %></span>
            <span class="text-sm font-medium text-gray-900"><%= change.show_label %></span>
            <% if change.moved? && change.now_starts_at %>
              <span class="text-sm text-gray-600">→ <%= change.now_starts_at.strftime("%a, %b %-d, %-l:%M %p") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <% if @sections.empty? %>
      <% others = @notices.sections.map(&:audience).uniq %>
      <%= render "shared/alert_panel", eyebrow: "All notified",
            headline: @audience ? "The whole #{@audience} has been notified." : "Everyone has been notified.",
            body: "Nobody on #{@changes.one? ? 'this date' : 'these dates'} is waiting to hear#{' from this list' if others.any?}.",
            actions: others.map { |audience| { text: "Notify the #{audience}", variant: "primary", size: "small", type: :link,
                                               path: manage_show_changes_path(params[:batch], audience: audience) } } %>
    <% else %>
      <% @sections.each do |section| %>
        <%= render "manage/show_changes/section", section: section, notices: @notices, batch: params[:batch], audience: @audience %>
      <% end %>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <%= link_to manage_path do %>
          <%= render "shared/button", text: "Not now", variant: "secondary", size: "medium" %>
        <% end %>
        <%= render "shared/button", text: "Nobody needs to be notified", variant: "secondary", size: "medium",
              path: manage_close_show_changes_path(params[:batch]), method: :post %>
        <p class="text-xs text-gray-500 w-full sm:w-auto">Not now keeps them on Home as not notified. Nobody needs to be notified closes it.</p>
      </div>
    <% end %>
  </div>
</div>
