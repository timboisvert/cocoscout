<%# Right panel for shared/show_row (right_panel: :ticket_sales): how a show
    on CocoScout Ticketing is selling — sold of capacity, a thin bar, and
    where its sales stand. Locals: listing (TicketListing), and optionally
    stats (Ticketing::ListingStats) to add sales and this week's pace. %>
<%
  stats = local_assigns[:stats]
  inventory = stats ? stats.inventory : listing.inventory
  sold = stats ? stats.sold : inventory.sold
  capacity = inventory.capacity
  this_week = stats&.sold_since(7.days.ago).to_i
  percent = capacity.to_i.positive? ? [ (sold * 100.0 / capacity).round, 100 ].min : nil
  label, badge_classes = ticket_listing_status_badge(listing, inventory)
%>
<div class="w-full md:w-1/2 md:border-l border-gray-200 md:pl-4 flex items-center justify-between gap-3 border-t md:border-t-0 mt-2 md:mt-0 pt-2 md:pt-0">
  <div class="min-w-0 flex-1">
    <div class="text-sm text-gray-900">
      <span class="font-semibold tabular-nums"><%= sold %></span><% if capacity %> <span class="text-gray-500">of <%= capacity %></span><% end %> sold
      <% if stats %>
        <span class="text-gray-500">· <%= number_to_currency(stats.gross_cents / 100.0, precision: 0) %></span>
        <% if this_week.positive? %><span class="text-green-700 text-xs font-medium">+<%= this_week %> this week</span><% end %>
      <% end %>
    </div>
    <% if percent %>
      <div class="mt-1.5 h-1.5 w-full max-w-[12rem] rounded-full bg-gray-100">
        <div class="h-1.5 rounded-full bg-pink-500" style="width: <%= percent %>%"></div>
      </div>
    <% end %>
  </div>
  <span class="flex-shrink-0 inline-flex items-center rounded-md px-2 py-1 text-xs font-medium <%= badge_classes %>"><%= label %></span>
</div>
