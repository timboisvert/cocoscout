<%# Casting & Visibility: whether this event is cast and how, and whether
    the public sees it. Locals: form, input_class. %>
<%
  kind = @show.event_type.titleize.downcase
  event_type_default = @production.event_type_publicly_visible?(@show.event_type)
  will_be_visible = @show.public_profile_visible.nil? ? event_type_default : @show.public_profile_visible
%>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
<%= render layout: "manage/shows/edit/card", locals: { title: "Casting" } do %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="text-sm font-medium text-gray-900">Cast this <%= kind %></div>
      <div class="text-xs text-gray-600 mt-0.5">On, you can assign people to its roles. Shows, classes and workshops start on; rehearsals and meetings start off.</div>
    </div>
    <%= render "shared/toggle_switch", form: form, field: :casting_enabled %>
  </div>

  <div class="pt-4 border-t border-gray-100">
    <%= form.label :casting_mode, "Casting style", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
    <%= form.select :casting_mode,
          options_for_select([
            [ "Same as the production (#{@production.act_based? ? 'acts' : 'roles'})", "" ],
            [ "Roles", "role_based" ],
            [ "Acts", "act_based" ]
          ], @show.casting_mode.to_s),
          {}, { class: input_class } %>
    <p class="text-xs text-gray-500 mt-1"><%= @production.name %> casts by <%= @production.act_based? ? "acts" : "roles" %>. A different style here changes how this <%= kind %>'s casting looks and how per-act pay counts acts; assignments are kept.</p>
  </div>
<% end %>

<%= render layout: "manage/shows/edit/card", locals: { title: "Public listing" } do %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="text-sm font-medium text-gray-900">Show it on <%= possessive(@production.name) %> public listing</div>
      <div class="text-xs text-gray-600 mt-0.5">On, anyone viewing the public listing sees it. <%= @show.event_type.titleize.pluralize %> are <%= event_type_default ? "shown" : "hidden" %> unless you say otherwise here.</div>
    </div>
    <%= render "shared/toggle_switch", form: form, field: :public_profile_visible, checked: will_be_visible, checked_value: "true", unchecked_value: "false",
          data: { show_edit_target: "publicProfileCheckbox", action: "change->show-edit#publicProfileToggled" } %>
  </div>

  <% if @production.public_profile_enabled && @production.public_key.present? %>
    <div class="<%= 'hidden' unless will_be_visible %>" data-show-edit-target="publicProfileContent">
      <%= render "shared/copy_url", url: public_profile_show_url(@production.public_key, @show), label: "This #{kind}'s public page" %>
    </div>
  <% elsif !@production.type_third_party? %>
    <p class="text-sm text-gray-600">
      <%= possessive(@production.name) %> public listing is off.
      <%= link_to "Turn it on in the production's settings", edit_manage_production_path(@production, tab: 5), class: "font-medium text-pink-600 hover:text-pink-700" %>
      to share its schedule.
    </p>
  <% end %>
<% end %>
</div>
