<div data-controller="mobile-nav" class="app-top-chrome fixed inset-x-0 top-0 z-30 border-b border-pink-100 bg-white lg:hidden">
  <%# ===== TOP BAR ===== %>
  <div class="flex items-center justify-between px-4 py-2.5">
    <button type="button" data-action="mobile-nav#toggle" class="p-1">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-pink-500">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
    <div class="absolute left-1/2 transform -translate-x-1/2 flex items-center gap-1.5">
      <%= link_to my_dashboard_path, class: "flex items-center gap-1.5" do %>
        <%= image_tag "/icon.png", alt: "CocoScout", class: "h-5 w-5" %>
        <span class="text-lg text-pink-500 coustard-regular">CocoScout</span>
      <% end %>
    </div>
    <% icons = panel_universal_icons(production_mode: panel_last_mode_production?) %>
    <div class="flex -mr-2">
      <%= render "shared/navigation/universal_icon", kind: :messages, size: :bar, **icons[:messages] %>
      <%= render "shared/navigation/universal_icon", kind: :notifications, size: :bar, **icons[:notifications] %>
    </div>
  </div>

  <%# ===== FULL-SCREEN PANEL ===== %>
  <div data-mobile-nav-target="panel" class="app-top-chrome hidden fixed inset-0 top-[45px] bg-white overflow-y-auto z-40">
    <div class="flex flex-col min-h-full">

      <%# No impersonation banner here — shared/_impersonation_bar sits above the
          whole nav now, so it's visible without opening this panel. %>

      <%# ===== MAIN CONTENT ===== %>
      <div class="flex-1 px-4 py-6">

        <%# No dashboard switcher (V1.1): back to the mode last used. %>
        <% back_production = panel_last_mode_production? %>
        <%= link_to (back_production ? manage_path : my_dashboard_path), class: "flex items-center gap-2 min-h-[44px] text-sm font-semibold text-gray-700" do %>
          <svg class="w-4 h-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          <%= back_production ? "Back to production mode" : "Back to CocoScout" %>
        <% end %>

        <%# ===== PROFILE SELECTOR ===== %>
        <%
          all_profiles = Current.user.people.active.includes(:profile_headshots).order(:created_at)
          group_memberships = Current.user.person&.groups&.active || []
          has_multiple_options = all_profiles.count > 1 || group_memberships.any?
          current_person = @person || Current.user.person
          other_profiles = all_profiles.reject { |p| p.id == current_person&.id }
        %>
        <% if has_multiple_options %>
          <div class="my-4 border-t border-gray-200"></div>

          <button type="button" data-action="mobile-nav#showProfilePopup" class="w-full flex items-center justify-between hover:bg-gray-50 rounded-lg transition cursor-pointer py-2">
            <div class="flex items-center gap-3 min-w-0 flex-1">
              <% headshot = current_person&.primary_headshot&.image %>
              <% if headshot&.attached? %>
                <%= image_tag headshot.variant(resize_to_fill: [36, 36]), class: "w-9 h-9 rounded-lg object-cover flex-shrink-0" %>
              <% else %>
                <div class="w-9 h-9 rounded-lg bg-pink-100 flex items-center justify-center text-pink-600 font-bold text-sm flex-shrink-0">
                  <%= current_person&.initials || "?" %>
                </div>
              <% end %>
              <div class="min-w-0 text-left">
                <div class="text-sm font-bold text-gray-900 truncate"><%= current_person&.name || "My Profile" %></div>
                <div class="text-xs text-gray-500">Switch profile</div>
              </div>
            </div>
            <div class="p-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-400">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 15 12 18.75 15.75 15m-7.5-6L12 5.25 15.75 9" />
              </svg>
            </div>
          </button>
        <% end %>

        <div class="my-4 border-t border-gray-200"></div>

        <%# ===== PROFILE SECTION LINKS ===== %>
        <nav class="space-y-1 mb-5">
          <a href="#basic-info" data-action="click->mobile-nav#toggle" class="flex items-center gap-3 px-4 py-2 rounded-lg text-lg font-medium hover:bg-pink-50 hover:text-pink-600 transition text-gray-800">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
            Basic Info
          </a>

          <a href="#bio" data-action="click->mobile-nav#toggle" class="flex items-center gap-3 px-4 py-2 rounded-lg text-lg font-medium hover:bg-pink-50 hover:text-pink-600 transition text-gray-800">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
            Bio
          </a>

          <a href="#social-media" data-action="click->mobile-nav#toggle" class="flex items-center gap-3 px-4 py-2 rounded-lg text-lg font-medium hover:bg-pink-50 hover:text-pink-600 transition text-gray-800">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
            </svg>
            Links
          </a>

          <a href="#headshots" data-action="click->mobile-nav#toggle" class="flex items-center gap-3 px-4 py-2 rounded-lg text-lg font-medium hover:bg-pink-50 hover:text-pink-600 transition text-gray-800">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
            Headshots
          </a>

          <a href="#videos" data-action="click->mobile-nav#toggle" class="flex items-center gap-3 px-4 py-2 rounded-lg text-lg font-medium hover:bg-pink-50 hover:text-pink-600 transition text-gray-800">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
            Videos
          </a>

          <a href="#performance-history" data-action="click->mobile-nav#toggle" class="flex items-center gap-3 px-4 py-2 rounded-lg text-lg font-medium hover:bg-pink-50 hover:text-pink-600 transition text-gray-800">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            History
          </a>

          <a href="#training" data-action="click->mobile-nav#toggle" class="flex items-center gap-3 px-4 py-2 rounded-lg text-lg font-medium hover:bg-pink-50 hover:text-pink-600 transition text-gray-800">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />
            </svg>
            Training
          </a>

          <a href="#skills" data-action="click->mobile-nav#toggle" class="flex items-center gap-3 px-4 py-2 rounded-lg text-lg font-medium hover:bg-pink-50 hover:text-pink-600 transition text-gray-800">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
            </svg>
            Skills
          </a>

          <a href="#resumes" data-action="click->mobile-nav#toggle" class="flex items-center gap-3 px-4 py-2 rounded-lg text-lg font-medium hover:bg-pink-50 hover:text-pink-600 transition text-gray-800">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
            Resumes
          </a>

          <a href="#groups" data-action="click->mobile-nav#toggle" class="flex items-center gap-3 px-4 py-2 rounded-lg text-lg font-medium hover:bg-pink-50 hover:text-pink-600 transition text-gray-800">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
            </svg>
            Groups
          </a>
        </nav>

      </div>

      <%# ===== FOOTER ===== %>
      <div class="border-t border-gray-200 bg-gray-50 px-4 py-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3 min-w-0 flex-1">
            <% user_headshot_variant = Current.user.person&.safe_headshot_variant(:thumb) %>
            <% if user_headshot_variant %>
              <%= image_tag user_headshot_variant, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
            <% else %>
              <div class="w-10 h-10 rounded-lg bg-pink-100 text-pink-600 flex items-center justify-center font-bold text-sm flex-shrink-0">
                <%= Current.user.person&.initials || Current.user.email_address[0].upcase %>
              </div>
            <% end %>
            <div class="min-w-0">
              <div class="text-sm font-bold text-gray-900 truncate"><%= Current.user.person&.name || "My Account" %></div>
              <div class="text-xs text-gray-500 truncate"><%= Current.user.email_address %></div>
            </div>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <%= render "shared/button", text: "Settings", variant: "secondary", size: "small", path: account_path %>
            <%= render "shared/button", text: "Sign out", variant: "secondary", size: "small", path: signout_path, data: { turbo_prefetch: false } %>
          </div>
        </div>
      </div>

    </div>

    <%# ===== PROFILE POPUP (bottom sheet) ===== %>
    <% if has_multiple_options %>
      <div data-mobile-nav-target="profilePopup" class="hidden fixed inset-0 z-50">
        <div class="absolute inset-0 bg-black/40" data-action="click->mobile-nav#hideProfilePopup"></div>
        <div class="absolute bottom-0 inset-x-0 bg-white rounded-t-2xl shadow-xl max-h-[70vh] overflow-y-auto">
          <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between sticky top-0 bg-white">
            <h3 class="text-lg font-bold text-gray-900">Switch Profile</h3>
            <button type="button" data-action="click->mobile-nav#hideProfilePopup" class="p-1 rounded-lg hover:bg-gray-100 transition cursor-pointer">
              <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <div class="px-5 py-3">
            <%# Current profile %>
            <div class="flex items-center gap-3 px-4 py-3 rounded-lg bg-pink-50 border border-pink-200 mb-2">
              <% headshot = current_person&.primary_headshot&.image %>
              <% if headshot&.attached? %>
                <%= image_tag headshot.variant(resize_to_fill: [40, 40]), class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
              <% else %>
                <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center text-pink-600 font-bold text-sm flex-shrink-0">
                  <%= current_person&.initials || "?" %>
                </div>
              <% end %>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-bold text-gray-900 truncate"><%= current_person&.name || "My Profile" %></div>
                <div class="text-xs text-pink-600 font-medium">Current</div>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-pink-500 flex-shrink-0">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
              </svg>
            </div>

            <%# Other profiles %>
            <% other_profiles.each do |profile| %>
              <%= link_to edit_profile_path(profile), data: { turbo: false }, class: "flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-50 transition mb-1" do %>
                <% profile_headshot = profile.primary_headshot&.image %>
                <% if profile_headshot&.attached? %>
                  <%= image_tag profile_headshot.variant(resize_to_fill: [40, 40]), class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
                <% else %>
                  <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center text-pink-600 font-bold text-sm flex-shrink-0">
                    <%= profile.initials %>
                  </div>
                <% end %>
                <div class="text-sm font-semibold text-gray-700 truncate"><%= profile.name %></div>
              <% end %>
            <% end %>

            <%# Group profiles %>
            <% group_memberships.each do |group| %>
              <%= link_to edit_group_path(group), data: { turbo: false }, class: "flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-50 transition mb-1" do %>
                <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-blue-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-700"><%= group.name %></div>
                  <div class="text-xs text-gray-500">Group profile</div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

  </div>
</div>

<script>
  // Smooth scroll to sections with offset for fixed header on mobile
  document.addEventListener('DOMContentLoaded', function() {
    const mobileNav = document.querySelector('[data-controller="mobile-nav"]');
    if (mobileNav) {
      mobileNav.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const targetId = this.getAttribute('href');
          const target = document.querySelector(targetId);
          if (target) {
            const headerOffset = 60;
            const elementPosition = target.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        });
      });
    }
  });
</script>
