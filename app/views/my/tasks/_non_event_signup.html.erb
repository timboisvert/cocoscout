<%#
  Non-event signup item (shared_pool forms - read-only display).
  Same 2026 compact row language as the dated rows — just no date on the left.

  Required params:
    - item: Hash with :form, :production, :registrations, :people
    - has_groups: Boolean (whether the user has any groups — controls headshots)
%>

<%
  form = item[:form]
  production = item[:production]
  registrations = item[:registrations]
  people = item[:people]
  first_reg = registrations.first
  on_waitlist = registrations.any? { |r| r.status == "waitlisted" }
%>

<div class="bg-white border border-gray-200 rounded-lg hover:border-gray-400 transition-all">
  <div class="flex flex-wrap sm:flex-nowrap items-center gap-x-3 px-3 py-1.5">
    <%# Details — no date, no icon; same typography as the dated rows %>
    <div class="flex-1 min-w-0">
      <div class="text-xs text-gray-400 truncate"><%= production.name %></div>
      <div class="text-sm font-medium text-gray-900 truncate"><%= form.name %></div>
      <% if form.slot_generation_mode != "open_list" %>
        <div class="text-xs text-gray-900 truncate">
          <span class="text-gray-400"><%= registrations.size == 1 ? "Your position" : "Your positions" %>:</span>
          <%= registrations.map { |r| r.sign_up_slot&.display_name }.compact.join(", ") %>
        </div>
      <% end %>
    </div>

    <%# Who signed up — only matters with multiple profiles/groups %>
    <% if local_assigns.fetch(:has_groups, false) && people.any? %>
      <div class="flex gap-1 flex-shrink-0">
        <% people.each do |person| %>
          <% headshot = person.safe_headshot_variant(:thumb) %>
          <% if headshot %>
            <%= image_tag headshot, class: "w-8 h-8 rounded-lg object-cover", alt: person.preferred_name %>
          <% else %>
            <div class="w-8 h-8 rounded-lg bg-gray-200 flex items-center justify-center text-gray-700 font-bold text-xs">
              <%= person.initials %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# Status + registration link %>
    <div class="flex items-center gap-2 flex-shrink-0">
      <% if on_waitlist %>
        <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium bg-amber-100 text-amber-700">On waitlist</span>
      <% else %>
        <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium bg-green-100 text-green-700">Signed up</span>
      <% end %>
      <% if form.slot_generation_mode == "open_list" && form.short_code.present? %>
        <%= link_to "View registration", my_sign_up_form_path(form.short_code), class: "text-[11px] text-pink-600 hover:text-pink-700 font-medium whitespace-nowrap" %>
      <% end %>
    </div>
  </div>
</div>
