<%#
  Standalone availability panel for card contexts (e.g., my/shows/show "My Availability" card).
  Includes its own data-controller="availability" and all necessary data attributes.
  2026 compact design: worded buttons at every width (no thumbs), note behind
  a pencil icon that expands the editor below.

  Required locals:
    - show: Show
    - availability: ShowAvailability or nil
    - entity: Person or Group
    - current_status: string ('available','unavailable','unset')
%>

<%
  entity_key = entity.is_a?(Person) ? "person_#{entity.id}" : "group_#{entity.id}"
  availability_note = availability&.note
%>

<div data-controller="availability disclosure"
     data-availability-show-id-value="<%= show.id %>"
     data-availability-status-value="<%= current_status %>"
     data-availability-entity-key-value="<%= entity_key %>"
     data-availability-entity-type-value="<%= entity.class.name %>">
  <div class="flex items-center gap-3">
    <%# Headshot %>
    <% headshot_variant = entity.safe_headshot_variant(:thumb) %>
    <% if headshot_variant %>
      <%= image_tag headshot_variant, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
    <% else %>
      <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-700 font-bold text-sm flex-shrink-0">
        <%= entity.respond_to?(:initials) ? entity.initials : entity.name[0..1].upcase %>
      </div>
    <% end %>
    <%# Name + Buttons %>
    <div class="flex-1 min-w-0">
      <div class="text-sm text-gray-700 mb-1 truncate"><%= entity.name %></div>
      <div class="flex items-center gap-1.5">
        <div class="flex flex-1 sm:flex-none">
          <% [:available, :unavailable].each do |status| %>
            <%
              classes = "flex-1 sm:flex-none sm:w-24 text-xs px-2.5 py-1.5 sm:py-1 text-center border border-gray-200 cursor-pointer flex items-center justify-center whitespace-nowrap"
              classes += status == :available ? " rounded-l border-r-0" : " rounded-r"
              classes += current_status == status.to_s ? " bg-pink-500 text-white" : " bg-white text-gray-700 hover:bg-gray-50"
            %>
            <%= link_to "#", class: classes, data: { action: "click->availability#setStatus", availability_status: status } do %>
              <span data-availability-target="<%= status %>Check" class="hidden">&check;</span>
              <span data-availability-target="<%= status %>Text"><%= status.to_s.humanize %></span>
            <% end %>
          <% end %>
        </div>

        <%# Note toggle — pink with a dot when a note exists %>
        <button type="button" data-action="click->disclosure#toggle" title="<%= availability_note.present? ? "Edit note" : "Add a note" %>"
                class="relative flex-shrink-0 p-1.5 rounded-md <%= availability_note.present? ? "text-pink-500" : "text-gray-300" %> hover:text-pink-500 hover:bg-pink-50 transition-colors cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.862 4.487zm0 0L19.5 7.125"/></svg>
          <% if availability_note.present? %>
            <span class="absolute top-0.5 right-0.5 w-1.5 h-1.5 rounded-full bg-pink-500"></span>
          <% end %>
        </button>
      </div>
    </div>
  </div>

  <%# Note editor — opened by the pencil icon %>
  <div data-disclosure-target="content" class="hidden mt-2">
    <div class="flex items-center gap-1">
      <input type="text"
             data-availability-target="noteInput"
             data-action="focus->availability#showSaveButton"
             value="<%= availability_note %>"
             maxlength="100"
             placeholder="Add a note..."
             class="flex-1 text-xs px-2 py-1.5 border border-gray-200 rounded focus:outline-none focus:ring-1 focus:ring-pink-300 focus:border-pink-300" />
      <button type="button"
              data-availability-target="saveButton"
              data-action="click->availability#saveNote"
              class="hidden px-2 py-1.5 text-xs bg-pink-500 text-white rounded hover:bg-pink-600 cursor-pointer flex-shrink-0 transition-all">
        Save
      </button>
    </div>
  </div>
</div>
