<%# locals: status %>
<%
  cls = case status
        when "completed" then "bg-green-100 text-green-700"
        when "failed", "canceled" then "bg-red-100 text-red-700"
        when "processing", "funding", "funded" then "bg-amber-100 text-amber-700"
        when "partially_paid" then "bg-blue-100 text-blue-700"
        else "bg-gray-100 text-gray-700"
        end
  label = status.to_s == "partially_paid" ? "Partially paid" : status.to_s.titleize
%>
<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold <%= cls %>"><%= label %></span>
