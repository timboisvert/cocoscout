<% content_for :title, @contractor.name %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Contracts", manage_contracts_path],
      ["Contractors", manage_contractors_path]
    ],
    text: @contractor.name,
    links: [
      { icon: "pencil", text: "Edit", path: edit_manage_contractor_path(@contractor) },
      { icon: "plus", text: "New Contract", path: manage_new_contract_wizard_path(contractor_id: @contractor.id) }
    ]
  } %>

  <%# Contractor Details Card %>
  <div class="border border-gray-200 rounded-lg overflow-hidden mb-8">
    <%= render "shared/card_header", title: "Contact Information" %>
    <div class="p-4">
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% if @contractor.email.present? %>
          <div>
            <dt class="text-sm font-medium text-gray-500">Email</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= mail_to @contractor.email, @contractor.email, class: "text-pink-600 hover:text-pink-700" %>
            </dd>
          </div>
        <% end %>

        <% if @contractor.phone.present? %>
          <div>
            <dt class="text-sm font-medium text-gray-500">Phone</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @contractor.phone %></dd>
          </div>
        <% end %>

        <% if @contractor.address.present? %>
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Address</dt>
            <dd class="mt-1 text-sm text-gray-900 whitespace-pre-line"><%= @contractor.address %></dd>
          </div>
        <% end %>

        <% if @contractor.notes.present? %>
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Notes</dt>
            <dd class="mt-1 text-sm text-gray-900 whitespace-pre-line"><%= @contractor.notes %></dd>
          </div>
        <% end %>
      </dl>

      <% if @contractor.email.blank? && @contractor.phone.blank? && @contractor.address.blank? %>
        <p class="text-sm text-gray-500">No contact information on file.</p>
      <% end %>
    </div>
  </div>

  <%# Associated person — who this contractor IS. The person and their CocoScout
      access are the same thing, so they live together; adding one is a single
      previewed step in the modal below. %>
  <div class="border border-gray-200 rounded-lg overflow-hidden mb-8">
    <%= render "shared/card_header", title: "Associated person" %>
    <div class="p-4">
      <% if @person %>
        <div class="flex items-center gap-3 min-w-0 mb-3">
          <% variant = @person.safe_headshot_variant(:thumb) %>
          <% if variant %>
            <%= image_tag variant, alt: @person.name, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
          <% else %>
            <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center text-pink-600 font-bold text-sm flex-shrink-0"><%= @person.initials %></div>
          <% end %>
          <div class="min-w-0 flex-1">
            <div class="font-medium text-gray-900 truncate"><%= @person.name %></div>
            <div class="text-sm text-gray-500 truncate"><%= @person.email %></div>
          </div>
          <button type="button" class="flex-shrink-0 text-sm font-medium text-pink-600 hover:text-pink-700" data-controller="modal" data-action="click->modal#open" data-modal-id="add-person-modal">Change</button>
        </div>

        <%# CocoScout access — this person IS who we invite, so it lives right here. %>
        <div class="rounded-lg bg-gray-50 border border-gray-200 p-3">
          <% if @has_cocoscout_access %>
            <div class="flex items-center gap-2 text-sm text-green-700">
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span><span class="font-medium">On CocoScout.</span> They can log in to see their contracts and set up payment.</span>
            </div>
          <% else %>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="text-sm text-gray-600 min-w-0">
                <% if @pending_invitation %>
                  <span class="font-medium text-gray-900">Invited <%= @pending_invitation.created_at.strftime("%b %-d") %>.</span>
                  Waiting for them to accept — they haven't set up a login yet.
                <% else %>
                  <span class="font-medium text-gray-900">Not on CocoScout yet.</span>
                  Invite them so they can log in, view their contracts, and connect their bank.
                <% end %>
              </p>
              <% if @invite_preview %>
                <%= render "shared/button", text: @pending_invitation ? "Preview & resend" : "Invite to CocoScout", variant: @pending_invitation ? "secondary" : "primary", size: "small", type: :button, classes: "flex-shrink-0",
                      data: { controller: "modal", action: "click->modal#open", modal_id: "invite-preview-modal" } %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <%# Empty state — same treatment as the tiers / services lists. %>
        <div class="text-center py-8 bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
          <p class="text-gray-500 text-sm">No one is linked yet.</p>
          <p class="text-gray-400 text-xs mt-1">Link who this contractor is so they can log in, see their contracts, and get paid.</p>
        </div>
        <div class="mt-4">
          <%= render "shared/button", text: "Add a person", variant: "primary", size: "medium", icon: "user-plus", type: :button,
                data: { controller: "modal", action: "click->modal#open", modal_id: "add-person-modal" } %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Getting paid — Stripe bank connection %>
  <div class="border border-gray-200 rounded-lg overflow-hidden mb-8">
    <%= render "shared/card_header", title: "Getting paid" %>
    <div class="p-4">
      <% if @person.nil? %>
        <p class="text-sm text-gray-600">Link a person above first — that's who connects a bank and gets paid.</p>
      <% elsif @person.can_receive_payouts? %>
        <div class="flex items-center gap-2 text-sm text-green-700">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="font-medium">Bank connected.</span>
          <span class="text-gray-600">You can pay this contractor through a payout run, straight to their bank.</span>
        </div>
      <% else %>
        <p class="text-sm text-gray-600 mb-3">
          <% if @person.connect_account_started? %>
            This contractor started bank setup but hasn't finished. Send them the link again to complete it.
          <% else %>
            Send this contractor a secure link to connect their bank, so you can pay them through CocoScout — no account needed on their end.
          <% end %>
        </p>
        <%= render "shared/copy_url",
          url: @payment_setup_url,
          label: "Bank setup link",
          copy_button_text: "Copy link",
          help_text: "Email this to #{@person.email}. The link expires in 30 days." %>
      <% end %>
    </div>
  </div>


  <%# Active Contracts %>
  <% if @active_contracts.any? || @draft_contracts.any? %>
    <div class="border border-gray-200 rounded-lg overflow-hidden mb-8">
      <%= render "shared/card_header", title: "Active Contracts" %>
      <div class="p-4 space-y-2">
        <% @active_contracts.each do |contract| %>
          <%= render "manage/contracts/contract_list_row", contract: contract %>
        <% end %>
        <% @draft_contracts.each do |contract| %>
          <%= render "manage/contracts/contract_list_row", contract: contract %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Past Contracts %>
  <% if @completed_contracts.any? %>
    <div class="border border-gray-200 rounded-lg overflow-hidden mb-8">
      <%= render "shared/card_header", title: "Past Contracts" %>
      <div class="p-4 space-y-2">
        <% @completed_contracts.each do |contract| %>
          <%= render "manage/contracts/contract_list_row", contract: contract %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Empty state %>
  <% if @active_contracts.empty? && @draft_contracts.empty? && @completed_contracts.empty? %>
    <div class="bg-gray-50 rounded-lg border border-dashed border-gray-300 p-12 text-center">
      <%= icon("file-text", class: "w-12 h-12 text-gray-400 mx-auto mb-4") %>
      <h3 class="text-lg font-medium text-gray-900 mb-2">No contracts yet</h3>
      <p class="text-gray-600 mb-4">
        Create a contract for this contractor.
      </p>
      <%= link_to manage_new_contract_wizard_path(contractor_id: @contractor.id) do %>
        <%= render "shared/button", text: "New Contract", variant: "primary", icon: "plus" %>
      <% end %>
    </div>
  <% end %>

  <%# Invitation preview — the exact email this person would get, before it sends. %>
  <% if @person && @invite_preview %>
    <div id="invite-preview-modal"
         class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4"
         data-controller="modal"
         data-action="click->modal#closeOnBackdrop keydown.escape->modal#close">
      <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg max-h-[88vh] overflow-y-auto"
           data-action="click->modal#stopPropagation">
        <div class="flex items-center justify-between px-6 py-4 bg-pink-600 rounded-t-xl">
          <h3 class="text-lg font-bold text-white"><%= @pending_invitation ? "Resend invitation" : "Invite to CocoScout" %></h3>
          <button type="button" data-action="click->modal#close" class="text-white/80 hover:text-white">
            <%= icon("x-mark", class: "w-5 h-5") %>
          </button>
        </div>

        <div class="p-6 space-y-4">
          <p class="text-sm text-gray-600">
            This is exactly what <span class="font-medium text-gray-900"><%= @person.name %></span> will receive.
            Sending gives them a login so they can see their contracts and set up payment.
          </p>

          <dl class="rounded-lg border border-gray-200 divide-y divide-gray-100 text-sm">
            <div class="flex gap-3 px-4 py-2.5">
              <dt class="w-16 flex-shrink-0 text-gray-500">To</dt>
              <dd class="text-gray-900 min-w-0 truncate"><%= @person.name %> &lt;<%= @person.email %>&gt;</dd>
            </div>
            <div class="flex gap-3 px-4 py-2.5">
              <dt class="w-16 flex-shrink-0 text-gray-500">Subject</dt>
              <dd class="text-gray-900 min-w-0"><%= @invite_preview[:subject] %></dd>
            </div>
          </dl>

          <div class="rounded-lg border border-gray-200 p-4 bg-gray-50 prose prose-sm max-w-none text-gray-800">
            <%= raw @invite_preview[:body] %>
          </div>
        </div>

        <div class="flex gap-3 px-6 py-4 border-t border-gray-200">
          <button type="button" data-action="click->modal#close"
                  class="flex-1 px-4 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">Cancel</button>
          <%= button_to invite_manage_contractor_path(@contractor), method: :post, class: "flex-1" do %>
            <%= render "shared/button",
                  text: @pending_invitation ? "Resend invitation" : "Send invitation",
                  variant: "primary", size: "medium", classes: "w-full justify-center" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Add-a-person modal: search or enter someone, preview what they'll be sent,
      then link + send in one confirmed step. Nothing is created until you send. %>
  <div id="add-person-modal"
       class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4"
       data-controller="modal invite-search"
       data-invite-search-url-value="<%= search_for_invite_manage_people_path(mode: "link") %>"
       data-invite-search-preview-url-value="<%= preview_person_manage_contractor_path(@contractor) %>"
       data-action="click->modal#closeOnBackdrop keydown.escape->modal#close">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg max-h-[88vh] overflow-y-auto" data-action="click->modal#stopPropagation">
      <div class="flex items-center justify-between px-6 py-4 bg-pink-600 rounded-t-xl">
        <h3 class="text-lg font-bold text-white">Add a person</h3>
        <button type="button" data-action="click->modal#close" class="text-white/80 hover:text-white">
          <%= icon("x-mark", class: "w-5 h-5") %>
        </button>
      </div>

      <%# Step 1 — pick who they are %>
      <div data-invite-search-target="step1" class="p-6">
        <input type="hidden" name="person_id" data-invite-search-target="selectedPersonIdInput">

        <div data-invite-search-target="searchSection">
          <label class="block text-sm font-medium text-gray-700 mb-1">Search CocoScout by name or email</label>
          <input type="text"
                 data-invite-search-target="input"
                 data-action="input->invite-search#search"
                 placeholder="Search by name or email…"
                 class="block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-pink-500 focus:ring-pink-500">
          <div data-invite-search-target="results" class="mt-3"></div>
          <div class="mt-3">
            <button type="button" class="text-sm font-medium text-pink-600 hover:text-pink-700" data-action="invite-search#showInviteForm">
              <%= icon("user-plus", class: "w-4 h-4 inline mr-1") %> Can't find them? Enter them manually
            </button>
          </div>
        </div>

        <%# Selected existing person %>
        <div data-invite-search-target="selectedPerson" class="hidden">
          <div class="flex items-center justify-between gap-3 p-3 bg-pink-50 border border-pink-200 rounded-lg">
            <div class="min-w-0">
              <div class="font-medium text-gray-900 truncate" data-invite-search-target="selectedPersonName"></div>
              <div class="text-sm text-gray-500 truncate" data-invite-search-target="selectedPersonEmail"></div>
            </div>
            <button type="button" class="text-sm font-medium text-pink-600 hover:text-pink-700 flex-shrink-0" data-action="invite-search#backToSearch">Change</button>
          </div>
        </div>

        <%# Manual entry %>
        <div data-invite-search-target="inviteForm" class="hidden mt-3">
          <div data-invite-search-target="personDetailsSection">
            <button type="button" class="inline-flex items-center gap-1 text-sm font-medium text-gray-600 hover:text-gray-900 mb-3" data-action="invite-search#backToSearch">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              Back to search
            </button>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">Name</label>
                <input type="text" data-invite-search-target="inviteName"
                       class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink-500 focus:ring-pink-500">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">Email</label>
                <input type="email" data-invite-search-target="inviteEmail" autocapitalize="none"
                       class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink-500 focus:ring-pink-500">
              </div>
            </div>
          </div>
        </div>

        <p data-invite-search-target="previewError" class="hidden text-sm text-red-600 mt-3"></p>

        <div class="flex justify-end mt-5">
          <%= render "shared/button", text: "Continue", variant: "primary", size: "medium", type: :button,
                data: { action: "click->invite-search#toPreview" } %>
        </div>
      </div>

      <%# Step 2 — preview of exactly what they'll be sent, filled in on Continue %>
      <div data-invite-search-target="step2" class="hidden">
        <div data-invite-search-target="previewContainer"></div>
      </div>
    </div>
  </div>
</div>
