<% content_for :title, "Enter your password" %>
<%
  # Someone who chose a password. The code is always the other way in, and it
  # is also the answer to "I forgot it".
%>
<% notices = capture do %>
  <% if @error %>
    <%= render "shared/auth/notice", kind: :error, body: "That password doesn't match. Try again, or use a code instead." %>
  <% end %>
<% end %>

<%= render layout: "shared/auth/shell",
      locals: { title: "Enter your password",
                lede: "Your calendar, cast messages, contracts, and pay are waiting in there.",
                notices: notices } do %>
  <%= form_with url: handle_signin_path, class: "space-y-4" do |form| %>
    <%= hidden_field_tag :step, "password", id: nil %>
    <%= render "shared/auth/account_row", email: @email_address, change: signin_path(start_over: 1) %>
    <%# For password managers: the address this password belongs to. %>
    <input type="email" name="email_address" value="<%= @email_address %>" autocomplete="username" readonly tabindex="-1" aria-hidden="true"
           style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden">

    <%= render "shared/auth/password_field", form: form, autocomplete: "current-password", error: @error.present? %>

    <div class="pt-1">
      <%= render "shared/button", text: "Sign in", variant: "primary", size: "jumbo", type: :submit %>
    </div>
  <% end %>

  <%= form_with url: handle_signin_path, id: "send-code-form" do %>
    <%= hidden_field_tag :step, "send_code", id: nil %>
  <% end %>
  <div class="flex flex-col items-center gap-1 text-center">
    <%= render "shared/button", text: "Email me a code instead", variant: "ghost", size: "small", type: :submit,
          form_id: "send-code-form", classes: "!text-[15px] !text-pink-600 hover:!bg-pink-50 hover:!text-pink-700" %>
    <p class="text-[13px] leading-snug text-slate-500">Forgot your password? A code signs you in without it.</p>
  </div>
<% end %>
