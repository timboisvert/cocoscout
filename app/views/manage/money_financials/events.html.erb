<%# Slim revenue-event rows for one production, loaded lazily into the accordion
    on the all-productions financials list. Columns line up with the parent list
    (Revenue / Costs / Profit). %>
<%= turbo_frame_tag "prod-events-#{@production.id}" do %>
  <% if @is_course %>
    <div class="py-2 pl-7 pr-3 text-xs text-gray-500">
      Course revenue is tracked at the course level, not per session.
      <%= link_to "Open course financials →", manage_money_production_financials_path(@production), class: "text-pink-600 hover:text-pink-700 font-medium" %>
    </div>
  <% elsif @shows.any? %>
    <div class="divide-y divide-gray-100">
      <% @shows.each do |show| %>
        <%
          financials = show.show_financials
          revenue = financials&.total_revenue || 0
          costs = (financials&.calculated_expenses || 0) + (financials&.calculated_production_expenses || 0)
          profit = revenue - costs

          if show.canceled?
            status = "Canceled"
          elsif financials&.data_confirmed?
            status = "Complete"
          elsif financials&.has_data?
            status = "Needs review"
          else
            status = "Needs data"
          end

          title = "#{show.date_and_time.strftime('%b %-d, %Y')} · #{show.display_name}"
        %>
        <%= render "shared/slim_list_row",
          title: title,
          subtitle: status,
          href: manage_money_show_financials_path(show),
          cells: [
            { value: number_to_currency(revenue) },
            { value: number_to_currency(costs), class: costs > 0 ? "text-red-600" : "text-gray-400" },
            { value: number_to_currency(profit), class: profit >= 0 ? "text-green-600" : "text-red-600" }
          ] %>
      <% end %>
    </div>
  <% else %>
    <div class="py-2 pl-7 pr-3 text-xs text-gray-500">No revenue events yet.</div>
  <% end %>
<% end %>
