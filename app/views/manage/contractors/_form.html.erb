<%= form_with model: contractor, url: contractor.persisted? ? manage_contractor_path(contractor) : manage_contractors_path, method: contractor.persisted? ? :patch : :post, local: true, class: "space-y-6" do |form| %>
  <% if contractor.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex items-start gap-3">
        <%= icon("exclamation-circle", class: "w-5 h-5 text-red-500 flex-shrink-0") %>
        <div>
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(contractor.errors.count, "error") %> prevented this contractor from being saved:
          </h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% contractor.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-lg p-6 space-y-5">
    <div>
      <label for="contractor_name" class="block text-sm font-medium text-gray-900 mb-1.5">
        Name
        <span class="text-pink-500">*</span>
      </label>
      <%= form.text_field :name,
        placeholder: "e.g., Nuns4Fun Entertainment",
        required: true,
        class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
    </div>

    <div>
      <label for="contractor_email" class="block text-sm font-medium text-gray-900 mb-1.5">
        Email
      </label>
      <%= form.email_field :email,
        placeholder: "contact@example.com",
        class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
    </div>

    <div>
      <label for="contractor_phone" class="block text-sm font-medium text-gray-900 mb-1.5">
        Phone
      </label>
      <%= form.telephone_field :phone,
        placeholder: "(555) 123-4567",
        class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
    </div>

    <div>
      <label for="contractor_address" class="block text-sm font-medium text-gray-900 mb-1.5">
        Address
      </label>
      <%= form.text_area :address,
        rows: 3,
        placeholder: "123 Main Street\nCity, State 12345",
        class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
    </div>

    <div>
      <label for="contractor_notes" class="block text-sm font-medium text-gray-900 mb-1.5">
        Notes
      </label>
      <%= form.text_area :notes,
        rows: 3,
        placeholder: "Internal notes about this contractor...",
        class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
    </div>
  </div>

  <% unless contractor.persisted? %>
    <%# Associated person — who this contractor IS. Optional at create time; can also be set later on the contractor page. %>
    <div class="bg-white border border-gray-200 rounded-lg p-6"
         data-controller="invite-search" data-invite-search-url-value="<%= search_for_invite_manage_people_path %>">
      <h3 class="text-sm font-medium text-gray-900">Associated person <span class="text-gray-400 font-normal">(optional)</span></h3>
      <p class="text-sm text-gray-500 mt-0.5 mb-4">Link who this contractor is so they can log in, see their contracts, and get paid. You can also set this later.</p>

      <input type="hidden" name="person_id" data-invite-search-target="selectedPersonIdInput">

      <%# Step 1: search %>
      <div data-invite-search-target="searchSection">
        <label class="block text-sm font-medium text-gray-700 mb-1">Search CocoScout by name or email</label>
        <input type="text"
               data-invite-search-target="input"
               data-action="input->invite-search#search"
               placeholder="Search by name or email…"
               class="block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-pink-500 focus:ring-pink-500">
        <div data-invite-search-target="results" class="mt-3"></div>
        <div class="mt-3">
          <button type="button" class="text-sm font-medium text-pink-600 hover:text-pink-700" data-action="invite-search#showInviteForm">
            <%= icon("user-plus", class: "w-4 h-4 inline mr-1") %> Can't find them? Invite by email
          </button>
        </div>
      </div>

      <%# Selected existing person %>
      <div data-invite-search-target="selectedPerson" class="hidden">
        <div class="flex items-center justify-between gap-3 p-3 bg-pink-50 border border-pink-200 rounded-lg">
          <div class="min-w-0">
            <div class="font-medium text-gray-900 truncate" data-invite-search-target="selectedPersonName"></div>
            <div class="text-sm text-gray-500 truncate" data-invite-search-target="selectedPersonEmail"></div>
          </div>
          <button type="button" class="text-sm font-medium text-pink-600 hover:text-pink-700 flex-shrink-0" data-action="invite-search#backToSearch">Change</button>
        </div>
      </div>

      <%# Invite-new details %>
      <div data-invite-search-target="inviteForm" class="hidden mt-3">
        <div data-invite-search-target="personDetailsSection" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Name</label>
            <input type="text" name="invite_name" data-invite-search-target="inviteName"
                   class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink-500 focus:ring-pink-500">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Email</label>
            <input type="email" name="invite_email" data-invite-search-target="inviteEmail" autocapitalize="none"
                   class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink-500 focus:ring-pink-500">
          </div>
        </div>
        <p class="text-xs text-gray-400 mt-2">We'll invite them to CocoScout so they can accept, set a password, and connect their bank.</p>
      </div>
    </div>
  <% end %>

  <div class="flex justify-end gap-3">
    <%= link_to contractor.persisted? ? manage_contractor_path(contractor) : manage_contractors_path, class: "px-4 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition" do %>
      Cancel
    <% end %>
    <%= render "shared/button", text: contractor.persisted? ? "Update Contractor" : "Create Contractor", variant: "primary", size: "medium", type: :submit %>
  </div>
<% end %>
