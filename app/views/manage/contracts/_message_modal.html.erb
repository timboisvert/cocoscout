<%#
  The Message window (Tim, 2026-11-22): write to everyone on the contract
  from the top of its page. While the contractor owes something that can be
  paid online, the pay link can go with it.

  Locals: contract, money (ContractDatesAndMoney)
%>
<% payable = money.owed_pending.select(&:collectable_online?) %>
<div id="contract-message-modal" class="hidden fixed inset-0 z-50 overflow-y-auto" data-controller="modal">
  <div class="flex min-h-full items-center justify-center p-4">
    <div class="fixed inset-0 bg-gray-500/75" data-action="click->modal#close"></div>
    <div class="relative bg-white rounded-xl shadow-xl w-full max-w-lg overflow-hidden" role="dialog" aria-labelledby="contract-message-title">
      <div class="flex items-center justify-between px-6 py-4 bg-gradient-to-r from-pink-500 to-pink-600">
        <h3 id="contract-message-title" class="text-lg font-semibold text-white">Message <%= contract.contractor_name %></h3>
        <button type="button" data-action="click->modal#close" class="text-white/80 hover:text-white" aria-label="Close">
          <%= icon("x", class: "w-5 h-5") %>
        </button>
      </div>
      <%= form_with url: contract_thread_path(contract), method: :post, data: { turbo_action: "replace" } do %>
        <div class="p-6 space-y-4">
          <p class="text-sm text-gray-600">This goes to <%= contract.contractor_name %>, the people on the contract, and the managers at <%= contract.organization.name %>. Each of them gets it in their Messages, and replies stay together on this contract.</p>
          <div>
            <label for="contract-message-body" class="block text-sm font-medium text-gray-700 mb-1">Your message</label>
            <textarea name="body" id="contract-message-body" rows="6" required placeholder="Write a message"
                      class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"></textarea>
          </div>
          <% payable.each do |payment| %>
            <label class="flex items-start gap-2.5 text-sm cursor-pointer">
              <input type="checkbox" name="pay_link_payment_ids[]" value="<%= payment.id %>" class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
              <span>
                <span class="font-medium text-gray-900">Add the link to pay the <%= number_to_currency(payment.amount) %></span>
                <span class="block text-gray-600"><%= ContractDatesAndMoney.owed_label(payment).upcase_first %>.</span>
              </span>
            </label>
          <% end %>
        </div>
        <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex justify-end gap-2">
          <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
          <%= render "shared/button", text: "Send", variant: "primary", size: "medium", type: :submit %>
        </div>
      <% end %>
    </div>
  </div>
</div>
