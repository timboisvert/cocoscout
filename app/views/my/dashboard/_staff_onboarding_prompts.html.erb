<%# Prompts to finish staff onboarding, one row per organization the signed-in
    person is staff at but hasn't fully onboarded (accepted + bank connected).
    Local: memberships (Array<OrganizationStaffMember>). %>
<% return if memberships.blank? %>

<div class="border border-pink-200 rounded-lg overflow-hidden mb-6 bg-pink-50">
  <div class="bg-pink-100 px-4 py-3 border-b border-pink-200 flex items-center gap-2">
    <svg class="w-5 h-5 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 0 0 0 6.364L12 20.364l7.682-7.682a4.5 4.5 0 0 0-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 0 0-6.364 0Z"/>
    </svg>
    <h3 class="text-base coustard-regular text-gray-900">
      Finish setting up your staff <%= "position".pluralize(memberships.size) %>
    </h3>
  </div>

  <div class="divide-y divide-pink-100">
    <% memberships.each do |member| %>
      <%
        org = member.organization
        next_step = case member.onboarding_status
                    when :awaiting_bank then "Connect your bank so you can get paid."
                    else "Accept your spot, set up how you get paid, and add your availability."
                    end
      %>
      <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
        <div class="min-w-0">
          <div class="font-medium text-gray-900 truncate"><%= org.name %></div>
          <div class="text-sm text-gray-600"><%= next_step %></div>
        </div>
        <%= link_to my_onboarding_path(org.id), class: "flex-shrink-0" do %>
          <%= render "shared/button",
                text: member.acknowledged? ? "Continue onboarding" : "Get set up",
                variant: "primary", size: "small", type: :button %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
