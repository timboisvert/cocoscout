<% content_for :title, "Enter your code" %>
<%
  # A 6-digit code went to the address: for someone who never chose a
  # password, for a new address, or because they chose a code. The lifetime
  # quoted is the model's. The copy never claims to know which of those people
  # this is.
  lifetime = SignIn::Code.lifetime_in_words
  problem = { wrong: "That code doesn't match. Check the email and try again.",
              expired: "That code has expired or was already used. Send a new code below.",
              locked: "That code has had too many tries. Send a new code below." }[@code_problem]
%>
<% notices = capture do %>
  <% if problem %>
    <%= render "shared/auth/notice", kind: :error, body: problem %>
  <% elsif @code_sent == "too_soon" %>
    <%= render "shared/auth/notice", body: "We sent a code to this address a moment ago, so use that one. It can take a minute to arrive." %>
  <% elsif @code_sent == "too_many" %>
    <%= render "shared/auth/notice", body: "We've sent this address several codes in the last hour. Use the newest one, or request another later." %>
  <% end %>
<% end %>
<% lede = capture do %>
  We sent a 6-digit code to <strong class="font-semibold text-slate-900"><%= @email_address %></strong>. It works for <%= lifetime %>.
<% end %>
<% footer = capture do %>
  No email after a minute? Check spam, then write to
  <%= mail_to "support@cocoscout.com", class: "underline hover:text-pink-600" %>.
<% end %>

<%= render layout: "shared/auth/shell",
      locals: { title: "Enter your code", lede: lede, notices: notices, footer: footer } do %>
  <%= form_with url: handle_signin_path, class: "space-y-4" do |form| %>
    <%= hidden_field_tag :step, "code", id: nil %>
    <%= render "shared/auth/account_row", email: @email_address, change: signin_path(start_over: 1) %>
    <%= render "shared/auth/code_field", error: @code_problem.present?, autofocus: !auth_native_app? %>

    <div class="pt-1">
      <%= render "shared/button", text: "Continue", variant: "primary", size: "jumbo", type: :submit %>
    </div>
  <% end %>

  <%= form_with url: handle_signin_path, id: "send-code-form" do %>
    <%= hidden_field_tag :step, "send_code", id: nil %>
  <% end %>
  <div class="flex flex-col items-center gap-1 text-center">
    <%= render "shared/button", text: "Send a new code", variant: "ghost", size: "small", type: :submit,
          form_id: "send-code-form", classes: "!text-[15px] !text-pink-600 hover:!bg-pink-50 hover:!text-pink-700" %>
    <% if @code_purpose == "sign_in" %>
      <%= link_to "Use your password instead", signin_path(use: "password"),
            class: "p-1 text-[13px] font-medium text-slate-600 underline hover:text-pink-600" %>
    <% end %>
  </div>
<% end %>
