<% preselect_pro = @setup_state[:preselect_plan] == "pro" %>
<% preselect_interval = @setup_state[:preselect_interval] || "year" %>
<% genre_label = ProductionGenres.label(@setup_state[:genre]) %>

<%= render layout: "manage/producer_setup/setup_layout", locals: { current_step: 2, step_name: "Plan" } do %>
  <div class="text-center mb-8">
    <h2 class="text-2xl sm:text-3xl coustard-regular text-gray-900">Almost there</h2>
    <p class="mt-3">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-pink-200 text-sm text-gray-700 shadow-sm">
        <span class="font-semibold text-gray-900"><%= @setup_state[:name] %></span>
        <span class="text-gray-300">·</span>
        <span><%= genre_label %></span>
      </span>
    </p>
  </div>

  <%# turbo: false — choosing Pro ends in a cross-origin redirect to Stripe
      checkout, which Turbo's fetch silently swallows. A plain form submit
      lets the browser follow the whole redirect chain. %>
  <%= form_with url: manage_producer_setup_complete_path, method: :post, data: { turbo: false } do %>
    <%# The plan radios sit as (visually hidden) siblings BEFORE the two cards,
        so each card's selected state is driven by its own named peer. Keeping
        the radios out of the cards means the interval radios below can never
        make a card look selected by accident. %>
    <%# The interval block below is also a peer of the pro radio, so it only
        appears once Pro is actually chosen — free is the quiet default. %>
    <div class="grid sm:grid-cols-2 gap-3 items-stretch">
      <%= radio_button_tag "plan", "free", !preselect_pro, class: "peer/free sr-only" %>
      <%= radio_button_tag "plan", "pro", preselect_pro, class: "peer/pro sr-only" %>

      <label for="plan_free"
             class="relative flex flex-col p-5 bg-white border border-gray-200 rounded-2xl cursor-pointer transition-all duration-150 hover:border-pink-300 hover:shadow-md peer-checked/free:border-pink-500 peer-checked/free:ring-2 peer-checked/free:ring-pink-500/20 peer-checked/free:bg-pink-50/60 peer-checked/free:shadow-md">
        <span class="text-sm font-semibold text-gray-900">Producer</span>
        <span class="mt-1 flex items-baseline gap-1">
          <span class="text-3xl font-bold text-gray-900">$0</span>
          <span class="text-sm text-gray-500">free forever</span>
        </span>
        <span class="mt-3 space-y-1.5 text-xs text-gray-600">
          <span class="block">One production, <%= Organization::FREE_MONTHLY_EVENT_LIMIT %> events a month</span>
          <span class="block">Casting, availability &amp; sign-ups</span>
          <span class="block">Messaging, contacts &amp; documents</span>
        </span>
      </label>

      <label for="plan_pro"
             class="relative flex flex-col p-5 bg-white border border-gray-200 rounded-2xl cursor-pointer transition-all duration-150 hover:border-pink-300 hover:shadow-md peer-checked/pro:border-pink-500 peer-checked/pro:ring-2 peer-checked/pro:ring-pink-500/20 peer-checked/pro:bg-pink-50/60 peer-checked/pro:shadow-md">
        <span class="text-sm font-semibold text-gray-900">Pro</span>
        <span class="mt-1 flex items-baseline gap-1">
          <span class="text-3xl font-bold text-gray-900">$20</span>
          <span class="text-sm text-gray-500">/mo, or $200/yr</span>
        </span>
        <span class="mt-3 space-y-1.5 text-xs text-gray-600">
          <span class="block">Everything in Producer, unlimited</span>
          <span class="block">Money, payouts &amp; contracts</span>
          <span class="block">Staffing, casting tables &amp; reports</span>
        </span>
      </label>

      <%# Only shown once Pro is selected — sibling of the pro radio above. %>
      <div class="hidden peer-checked/pro:block sm:col-span-2 mt-1">
        <span class="block text-xs font-medium text-gray-500 mb-2 text-center">How would you like to pay?</span>
        <div class="grid grid-cols-2 gap-2 max-w-md mx-auto">
          <label class="flex flex-col items-center px-4 py-2.5 bg-white border border-gray-200 rounded-xl cursor-pointer text-center transition-all hover:border-pink-300 has-[:checked]:border-pink-500 has-[:checked]:ring-1 has-[:checked]:ring-pink-500/30 has-[:checked]:bg-pink-50/60">
            <%= radio_button_tag "interval", "year", preselect_interval == "year", class: "sr-only" %>
            <span class="text-sm font-semibold text-gray-900">Annual ($200/yr)</span>
            <span class="text-xs text-gray-500">Two months free</span>
          </label>
          <label class="flex flex-col items-center px-4 py-2.5 bg-white border border-gray-200 rounded-xl cursor-pointer text-center transition-all hover:border-pink-300 has-[:checked]:border-pink-500 has-[:checked]:ring-1 has-[:checked]:ring-pink-500/30 has-[:checked]:bg-pink-50/60">
            <%= radio_button_tag "interval", "month", preselect_interval == "month", class: "sr-only" %>
            <span class="text-sm font-semibold text-gray-900">Monthly ($20/mo)</span>
            <span class="text-xs text-gray-500">Pay as you go</span>
          </label>
        </div>
        <p class="mt-3 text-xs text-gray-400 text-center">Choosing Pro takes you to secure checkout after setup. Change plans anytime.</p>
      </div>
    </div>

    <div class="mt-8">
      <%= render "shared/button", text: "Create", variant: "primary", size: "jumbo", type: :submit %>
    </div>
  <% end %>

  <div class="mt-4 text-center">
    <%= link_to "← Back", manage_producer_setup_name_path,
          class: "text-sm text-gray-400 hover:text-gray-600 underline-offset-2 hover:underline" %>
  </div>
<% end %>
