<%
  show = @listing.show
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  box_office = TicketingDoorAccess.at_least?(@level, :box_office)
  has_products = @listing.ticket_order_items.sold.exists?
%>
<% content_for :title, turbo_native_app? ? "Work the door" : "Work the door · #{@listing.display_title}" %>

<%# The show being worked, with its poster, so the page reads as that
    show's (Tim, 2026-10-18): the poster, the name, when, where, the ages. %>
<%
  poster = show.poster.attached? ? show.safe_poster_variant(:small) : @listing.production.safe_poster_variant(:small)
  room = [ show.location&.name, show.location_space&.name ].compact.uniq.last
%>
<div class="rounded-2xl border border-gray-200 bg-white px-4 py-3 flex items-center gap-3">
  <% if poster %>
    <div class="w-12 aspect-[3/4] rounded overflow-hidden border border-gray-200 bg-white flex-shrink-0"><%= image_tag poster, alt: "", class: "w-full h-full object-cover" %></div>
  <% else %>
    <div class="w-12 aspect-[3/4] rounded bg-pink-100 flex items-center justify-center flex-shrink-0"><span class="text-sm font-bold text-pink-600"><%= @listing.production.initials %></span></div>
  <% end %>
  <div class="min-w-0 flex-1">
    <div class="text-lg font-bold text-gray-900 leading-tight truncate"><%= @listing.display_title %></div>
    <div class="text-sm text-gray-600 truncate">
      <%= show.date_and_time.to_date == Date.current ? "Tonight" : show.date_and_time.strftime("%a %b %-d") %>
      · <%= show.date_and_time.strftime("%-l:%M %p") %><%= " · #{room}" if room.present? %>
    </div>
    <div class="text-xs text-gray-500 truncate">
      <% if (age = AgeLimit.short(@listing.effective_minimum_age)) %><span class="font-semibold text-gray-700">Ages <%= age %></span> · <% end %><%= show.date_and_time <= Time.current ? "started #{time_ago_in_words(show.date_and_time)} ago" : "starts in #{distance_of_time_in_words(Time.current, show.date_and_time)}" %>
    </div>
  </div>
</div>

<%# Two ways to work the door: the list (most nights people are looked up by
    name and checked in with a tap) and the camera. Selling sits behind its
    own button so the page stays short. %>
<%# In the app, bridge--door-scanner swaps the page's camera for the app's
    own and keeps the phone awake; in a browser it does nothing. %>
<div data-controller="door bridge--door-scanner"
     data-action="door:scan->bridge--door-scanner#open door:result->bridge--door-scanner#result
                  door-scanner:code->door#nativeCode door-scanner:undo->door#nativeUndo
                  door-scanner:fulfill->door#nativeFulfill door-scanner:closed->door#nativeClosed"
     data-bridge--door-scanner-title-value="<%= @listing.display_title %>"
     data-bridge--door-scanner-subtitle-value="<%= show.date_and_time.to_date == Date.current ? "Tonight" : show.date_and_time.strftime("%a %b %-d") %> · <%= show.date_and_time.strftime("%-l:%M %p") %>"
     data-door-in-app-value="<%= turbo_native_app? %>"
     data-door-check-in-url-value="<%= door_check_in_path(@listing) %>"
     data-door-stats-url-value="<%= door_stats_path(@listing) %>"
     data-door-list-url-value="<%= door_list_path(@listing) %>"
     data-door-deliveries-url-value="<%= door_deliveries_path(@listing) %>"
     data-door-undo-url-value="<%= door_undo_path(@listing) %>"
     data-door-listing-id-value="<%= @listing.id %>"
     data-door-passes-url-value="<%= door_search_path(@listing, passes_only: 1) if @pass_holders_searchable %>">

  <%# The numbers that matter tonight; refreshed every few seconds. %>
  <div class="mt-3 grid grid-cols-3 gap-2 text-center">
    <div class="rounded-xl border border-gray-200 bg-white py-3">
      <div class="text-2xl font-bold tabular-nums text-gray-900" data-door-target="checkedIn"><%= @counts[:checked_in] %></div>
      <div class="text-xs text-gray-500">Checked in</div>
    </div>
    <div class="rounded-xl border border-gray-200 bg-white py-3">
      <div class="text-2xl font-bold tabular-nums text-gray-900" data-door-target="sold"><%= @counts[:sold] %></div>
      <% outside = @listing.inventory.outside_sold %>
      <div class="text-xs text-gray-500">Sold<% if outside.positive? %> <span class="text-gray-400">· <%= outside %> elsewhere</span><% end %></div>
    </div>
    <div class="rounded-xl border border-gray-200 bg-white py-3">
      <div class="text-2xl font-bold tabular-nums text-gray-900"><%= @counts[:capacity] || "—" %></div>
      <div class="text-xs text-gray-500">Seats</div>
    </div>
  </div>

  <%# What the last scan or tap came to: green, amber or red, big. %>
  <div data-door-target="banner" class="hidden mt-4 rounded-xl px-4 py-4 text-center text-lg font-semibold" role="status" aria-live="assertive"></div>

  <%# Three modes, one lit at a time: List, Scan and Sell. Sell sits here,
      never under the list (a night's list is long), and shows only the sale
      form (Tim, 2026-10-11). %>
  <% can_sell = box_office && @listing.status != "canceled" %>
  <%# Tap to Pay: the buyer taps their card on this phone (the app's Terminal
      SDK), offered only by a copy of the app that has it. Beside it, the QR
      code reads as the other way: tap a card, or scan a code (Tim, 2026-10-13). %>
  <% can_tap = native_bridge_component?("tap-to-pay") && TapToPay.available_for?(@listing.organization) %>
  <% card_label = can_tap ? "Scan to pay" : "Card or phone pay" %>
  <div class="mt-4 grid <%= can_sell ? 'grid-cols-3' : 'grid-cols-2' %> gap-2" role="tablist" aria-label="How to check people in">
    <%= render "shared/button", text: "List", variant: "secondary", size: "medium", type: :button, classes: "w-full justify-center",
          data: { door_target: "modeButton", mode: "list", action: "click->door#setMode" } %>
    <%= render "shared/button", text: "Scan", variant: "secondary", size: "medium", type: :button, classes: "w-full justify-center",
          data: { door_target: "modeButton", mode: "scan", action: "click->door#setMode" } %>
    <% if can_sell %>
      <%= render "shared/button", text: "Sell", variant: "secondary", size: "medium", type: :button, classes: "w-full justify-center",
            data: { door_target: "modeButton", mode: "sell", action: "click->door#setMode" } %>
    <% end %>
  </div>

  <% if can_sell %>
    <%# Selling to someone in front of you: pick the tickets, then how they pay. %>
    <% max_per_order = @listing.effective_max_per_order %>
    <%= form_with url: door_sell_path(@listing), method: :post, class: "hidden mt-4 rounded-xl border border-gray-200 bg-white p-4",
          data: { controller: "door-sell", door_target: "sellPanel",
                  door_sell_fee_mode_value: @listing.effective_fee_mode,
                  door_sell_platform_fee_value: TicketPricing::PLATFORM_FEE_CENTS,
                  door_sell_per_mille_value: TicketPricing::PROCESSING_PER_MILLE,
                  door_sell_fixed_value: TicketPricing::PROCESSING_FIXED_CENTS,
                  door_sell_tap_per_mille_value: TicketPricing::IN_PERSON_PER_MILLE,
                  door_sell_tap_fixed_value: TicketPricing::IN_PERSON_FIXED_CENTS,
                  door_sell_card_label_value: card_label } do %>
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-base font-semibold text-gray-900">Sell tickets</h2>
        <%= render "shared/button", text: "Close", variant: "ghost", size: "xs", type: :button, data: { mode: "list", action: "click->door#setMode" } %>
      </div>
      <ul class="mt-2 divide-y divide-gray-100">
        <% @tiers.each do |tier| %>
          <%# Counts are purchases: a 4-pack is four seats and four tickets. %>
          <% left = tier.units_for(@listing.inventory.remaining(tier: tier)) %>
          <% most = [ left || tier.units_for(max_per_order), tier.units_for(max_per_order) ].min %>
          <% added_tax = tier.seat_prices.sum { |cents| TaxCalculator.for_ticket(@listing, tier.base_tier, cents).added_cents } %>
          <li class="flex items-center gap-3 py-3" data-door-sell-target="row"
              data-price="<%= tier.price_cents %>" data-tax="<%= added_tax %>" data-max="<%= [ most, 0 ].max %>" data-admits="<%= tier.admits %>">
            <div class="min-w-0 flex-1">
              <% if left == 0 %>
                <div class="font-medium text-red-700"><%= tier.name %></div>
                <div class="text-sm text-red-700"><%= ticket_price(tier.price_cents) %> · Sold out</div>
              <% else %>
                <div class="font-medium text-gray-900"><%= tier.name %></div>
                <div class="text-sm text-gray-500"><%= ticket_price(tier.price_cents) %><%= " · #{left} left" if left && left <= @listing.effective_low_stock_threshold %></div>
              <% end %>
            </div>
            <%= hidden_field_tag "quantities[#{tier.id}]", 0, id: nil, data: { door_sell_target: "input" } %>
            <div class="flex items-center gap-2">
              <%= render "shared/button", text: "−", variant: "secondary", size: "xs", type: :button, title: "One fewer #{tier.name}",
                    classes: "w-11 h-11 !p-0 !rounded-full !text-xl disabled:opacity-40 disabled:cursor-default",
                    data: { door_sell_target: "minus", action: "door-sell#decrement" } %>
              <span class="w-6 text-center text-lg font-semibold tabular-nums" data-door-sell-target="count" aria-live="polite">0</span>
              <%= render "shared/button", text: "+", variant: "outline-pink", size: "xs", type: :button, title: "One more #{tier.name}",
                    classes: "w-11 h-11 !p-0 !rounded-full !text-xl disabled:opacity-40 disabled:cursor-default",
                    data: { door_sell_target: "plus", action: "door-sell#increment" } %>
            </div>
          </li>
        <% end %>
      </ul>
      <% if @offers.any? %>
        <div class="mt-3 text-xs font-semibold uppercase tracking-wide text-gray-500">With it</div>
        <ul class="divide-y divide-gray-100">
          <% @offers.each do |offer| %>
            <% added_tax = TaxCalculator.for_product(@listing, offer, offer.price_cents).added_cents %>
            <li class="flex items-center gap-3 py-3" data-door-sell-target="row" data-product="1"
                data-price="<%= offer.price_cents %>" data-tax="<%= added_tax %>" data-max="<%= TicketCheckout::MAX_PER_PRODUCT %>">
              <div class="min-w-0 flex-1">
                <div class="font-medium text-gray-900"><%= offer.name %></div>
                <div class="text-sm text-gray-500"><%= ticket_price(offer.price_cents) %><%= " · #{offer.description}" if offer.description.present? %></div>
              </div>
              <%= hidden_field_tag "products[#{offer.id}]", 0, id: nil, data: { door_sell_target: "input" } %>
              <div class="flex items-center gap-2">
                <%= render "shared/button", text: "−", variant: "secondary", size: "xs", type: :button, title: "One fewer #{offer.name}",
                      classes: "w-11 h-11 !p-0 !rounded-full !text-xl disabled:opacity-40 disabled:cursor-default",
                      data: { door_sell_target: "minus", action: "door-sell#decrement" } %>
                <span class="w-6 text-center text-lg font-semibold tabular-nums" data-door-sell-target="count" aria-live="polite">0</span>
                <%= render "shared/button", text: "+", variant: "outline-pink", size: "xs", type: :button, title: "One more #{offer.name}",
                      classes: "w-11 h-11 !p-0 !rounded-full !text-xl disabled:opacity-40 disabled:cursor-default",
                      data: { door_sell_target: "plus", action: "door-sell#increment" } %>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
      <div class="mt-2">
        <%= text_field_tag :buyer_name, nil, placeholder: "Their name (optional)", "aria-label": "Their name", class: input_class %>
      </div>
      <div class="mt-3 space-y-2">
        <% if can_tap %>
          <%# Apple 5.2 to 5.4: first, never greyed out, and named Tap to Pay on iPhone beside the other ways to pay. %>
          <%= render "shared/button", text: "Tap to Pay on iPhone", variant: "primary", size: "large", type: :submit, name: "kind", value: "tap",
                classes: "w-full justify-center", data: { door_sell_target: "tapButton" } %>
        <% end %>
        <%= render "shared/button", text: card_label, variant: can_tap ? "secondary" : "primary", size: "large", type: :submit, name: "kind", value: "card",
              classes: "w-full justify-center disabled:opacity-50", data: { door_sell_target: "cardButton" } %>
        <div class="grid grid-cols-2 gap-2">
          <%= render "shared/button", text: "Cash", variant: "secondary", size: "large", type: :submit, name: "kind", value: "cash",
                classes: "w-full justify-center disabled:opacity-50", data: { door_sell_target: "cashButton" } %>
          <%= render "shared/button", text: "Comp", variant: "secondary", size: "large", type: :submit, name: "kind", value: "comp",
                classes: "w-full justify-center disabled:opacity-50", data: { door_sell_target: "compButton" } %>
        </div>
      </div>
      <p class="mt-3 text-xs text-gray-500"><%= "Tap to Pay on iPhone takes their card or phone right on this iPhone. " if can_tap %><%= card_label %> shows a code they scan to pay on their own phone, with Apple Pay, Google Pay or a card. Cash and comps are checked in as you record them<%= "; a comp carries no products" if @offers.any? %>.</p>
    <% end %>
  <% end %>

  <%# The list: everyone with a ticket, filtered as you type, a box per party. %>
  <section class="mt-4 rounded-xl border border-gray-200 bg-white p-4" data-door-target="listPanel">
    <label for="door-filter" class="sr-only">Filter the list</label>
    <input id="door-filter" type="search" autocomplete="off" placeholder="Filter by name, email or order code" data-door-target="filterInput"
           data-action="input->door#filter" class="<%= input_class %>">
    <div class="mt-3 flex flex-wrap gap-2">
      <% { "all" => "All", "out" => "Not here yet", "in" => "Checked in" }.each do |key, words| %>
        <%= render "shared/button", text: words, variant: "secondary", size: "xs", type: :button,
              data: { door_target: "filterChip", filter: key, action: "click->door#chip" } %>
      <% end %>
      <span class="<%= 'hidden' unless has_products %>" data-door-target="deliverChip">
        <%= render "shared/button", text: "To deliver", variant: "secondary", size: "xs", type: :button,
              data: { door_target: "filterChip", filter: "deliver", action: "click->door#chip" } %>
      </span>
    </div>
    <% deliveries = render("door/deliveries", listing: @listing) %>
    <div class="mt-3 text-sm <%= 'hidden' if deliveries.blank? %>" data-door-target="deliveries"><%= deliveries %></div>
    <div class="mt-2" data-door-target="results"><%= render "door/list", orders: @orders, listing: @listing %></div>
    <%# Pass holders matching the filter, who can use a credit on this show. %>
    <div data-door-target="passHolders"></div>
  </section>

  <%# The camera. %>
  <section class="hidden mt-4 rounded-xl border border-gray-200 bg-white p-4" data-door-target="scanPanel">
    <div class="relative overflow-hidden rounded-lg bg-black aspect-square sm:aspect-video hidden" data-door-target="viewport">
      <video data-door-target="video" class="h-full w-full object-cover" muted playsinline></video>
    </div>
    <div class="mt-3 flex gap-2">
      <span class="flex-1" data-door-target="startButton">
        <%= render "shared/button", text: "Scan tickets", variant: "primary", size: "medium", type: :button, classes: "w-full justify-center",
              data: { action: "click->door#startScanning" } %>
      </span>
      <%# hidden sits on a plain wrapper: on the button itself inline-flex would win. %>
      <span class="hidden" data-door-target="stopButton">
        <%= render "shared/button", text: "Stop", variant: "secondary", size: "medium", type: :button, data: { action: "click->door#stopScanning" } %>
      </span>
    </div>
    <p class="mt-3 text-xs text-gray-500">
      <% if turbo_native_app? %>
        Opens the camera full screen. Point it at the code on their phone or printout; each result shows over the camera with a sound and a buzz.
      <% else %>
        Point the camera at the QR code on their phone or printout. Each result shows above with a sound.
      <% end %>
    </p>
  </section>

</div>
