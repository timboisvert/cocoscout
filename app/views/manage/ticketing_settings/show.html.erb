<% content_for :title, "Ticketing settings" %>

<%= render layout: "shared/settings_layout", locals: {
  title: "Ticketing settings",
  breadcrumbs: [
    [ "Ticketing", manage_ticketing_path ]
  ],
  sections: sections,
  current: @section
} do %>
  <% case @section %>
  <% when "tax" %>
    <%= render "manage/ticketing_settings/sections/tax" %>
  <% when "notifications" %>
    <%= render "manage/ticketing_settings/sections/notifications" %>
  <% when "door" %>
    <%= render "manage/ticketing_settings/sections/door" %>
  <% when "embed" %>
    <%= render "manage/ticketing_settings/sections/embed" %>
  <% else %>
    <%= render "manage/ticketing_settings/sections/box_office" %>
  <% end %>
<% end %>
