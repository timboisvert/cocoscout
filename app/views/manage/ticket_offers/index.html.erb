<% content_for :title, "Deals" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Ticketing", manage_ticketing_path ] ],
    text: "Deals",
    links: [ { text: "New deal", path: manage_new_ticket_offer_path } ]
  } %>

  <div class="max-w-3xl space-y-6">
    <p class="text-sm text-gray-600">
      Another show for less, offered while someone is buying: "Buying Boylesque? Add tonight's Laugh Along Live for $5 off."
      It shows at checkout and, for a few days, on their order page and confirmation email. By default a buyer gets one for each
      ticket they buy, and returning those tickets takes the deal back.
    </p>

    <% if @offers.empty? %>
      <div class="bg-white border border-gray-200 rounded-lg px-6 py-10 text-center">
        <p class="text-gray-900 font-medium">No deals yet.</p>
        <p class="mt-1 text-sm text-gray-600">Pick what someone is buying, what to offer them, and the deal.</p>
        <div class="mt-4 flex justify-center">
          <%= render "shared/button", text: "New deal", variant: "primary", size: "medium", path: manage_new_ticket_offer_path %>
        </div>
      </div>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <ul class="divide-y divide-gray-100">
          <% @offers.each do |offer| %>
            <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-5 py-3">
              <div class="min-w-[12rem] flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-sm font-medium text-gray-900"><%= offer.name %></span>
                  <span class="inline-flex rounded-md px-1.5 py-0.5 text-xs font-medium <%= offer.active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600' %>"><%= offer.active? ? "On" : "Off" %></span>
                </div>
                <div class="text-xs text-gray-500">
                  Buying <%= offer.buying_words %> → <%= offer.offer_words %>, <%= offer.deal_words %>
                </div>
                <div class="text-xs text-gray-500">Shown <%= pluralize(offer.shown_count, "time") %> · <%= pluralize(@taken.fetch(offer.id, 0), "ticket") %> sold</div>
              </div>
              <div class="flex items-center gap-2">
                <%= render "shared/button", text: "Edit", variant: "secondary", size: "small", path: manage_edit_ticket_offer_path(offer) %>
                <%= render "shared/button", text: (@taken.key?(offer.id) ? "Turn off" : "Delete"), variant: "ghost", size: "small", type: :button,
                      data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-remove-offer-#{offer.id}" } %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>
<% @offers.each do |offer| %>
  <%= render "shared/confirm_modal", id: "confirm-remove-offer-#{offer.id}",
        title: (@taken.key?(offer.id) ? "Turn off #{offer.name}?" : "Delete #{offer.name}?"),
        message: (@taken.key?(offer.id) ? "Nobody sees it anymore. Tickets bought with it keep their price." : "Nobody took it, so it's deleted for good."),
        confirm_text: (@taken.key?(offer.id) ? "Turn off" : "Delete"), url: manage_ticket_offer_path(offer), method: :delete %>
<% end %>
