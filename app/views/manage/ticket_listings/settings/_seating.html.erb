<%# One date's own way of selling seats, or (override off) the one above it:
    its production's, else its room's. The one override control
    (manage/ticketing/own_switch), drawn as the date's other tabs are (Tim,
    2026-11-13). Locals: listing, setup. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  # An archived location's charts leave the picker; the chart already picked stays.
  charts = Current.organization.seat_charts.pickable(listing.seat_chart_id).includes(location_space: { location: :location_spaces }).order(:name).to_a
  own = listing.seating_mode.present? || listing.seat_chart_id.present?
  from_production = setup&.seating_mode.present? || setup&.seat_chart_id.present?
  mode = listing.effective_seating_mode
  chart = listing.seated? ? listing.effective_seat_chart : nil
  sold = listing.tickets.where(status: Ticket::SOLD_STATUSES).exists?
%>
<%= form_with model: listing, url: manage_ticket_listing_path(listing), method: :patch, data: { turbo: false } do |f| %>
  <%= hidden_field_tag :section, "seating" %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle" data-settings-card="seating">
    <%= render "manage/ticketing/own_switch", title: "Seating", follows: (from_production ? listing.production.name : "your box office"),
          settings_path: (from_production ? manage_edit_production_ticketing_path(listing.production, section: "seating") : manage_ticketing_settings_section_path(section: "rooms")),
          intro: "How this date sells its seats: by count, by seat, or both at once.",
          only: "this date", name: "ticket_listing[own_seating]", id: "ticket_listing_own_seating", checked: own %>
    <div class="px-6 py-5 space-y-4">
      <fieldset <%= "disabled" unless own %> data-fieldset-toggle-target="fields" class="grid grid-cols-1 sm:grid-cols-2 gap-4 disabled:opacity-50">
        <div>
          <%= f.label :seating_mode, "How seats sell", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.select :seating_mode, options_for_select(RoomTicketingSetting::SEATING_MODE_LABELS.map { |k, v| [ v, k ] }, mode), {}, class: input_class %>
        </div>
        <div>
          <%= f.label :seat_chart_id, "Chart", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.select :seat_chart_id, options_for_select([ [ "Same as the production and room", "" ] ] + charts.map { |c| [ "#{c.name} (#{c.location_space.place_name})", c.id ] }, listing.seat_chart_id), {}, class: input_class %>
        </div>
      </fieldset>
      <p class="text-sm text-gray-600 rounded-lg bg-gray-50 border border-gray-200 px-3 py-2"><span class="font-medium text-gray-900">This date sells:</span> <%= listing.seating_mode_label %><% if chart %>, on <%= link_to chart.name, manage_seat_chart_path(chart), class: "text-pink-600 hover:text-pink-700 underline" %><% end %>.</p>
      <% if sold %><p class="text-sm text-gray-600">Tickets are sold for this date. Changing how it sells keeps every ticket, and a seat number stays only if the new chart has that seat.</p><% end %>
      <p class="text-sm text-gray-600">Zones, which say which sections each ticket type sells, are set on the production's Seating tab and come down to this date's ticket types.</p>
    </div>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
    </div>
  </div>
<% end %>
