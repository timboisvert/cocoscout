<%# The production's ticket types, set once for every date that uses them.
    Drag the handle (or use the arrows) to change their order; "Add a ticket
    type" adds one row at a time. Locals: setup, production. %>
<%
  rows = setup.ticket_tiers.to_a.sort_by { |t| [ t.position, t.id.to_i ] }
  rows = [ TicketTier.new(position: 0) ] if rows.empty?
  inheriting = setup.persisted? ? setup.listings.where(inherits_tiers: true).count : 0
%>
<%= form_with model: setup, scope: :production_ticketing, url: manage_update_production_ticketing_path(production, section: "tickets"), method: :patch, class: "space-y-6" do |f| %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden" data-controller="reorderable nested-form"
       data-reorderable-handle-value=".tier-drag-handle" data-reorderable-auto-save-value="false">
    <div class="px-5 py-4 border-b border-gray-200">
      <h3 class="font-semibold text-gray-900">Tickets</h3>
      <p class="text-sm text-gray-600 mt-1">
        Every date uses these unless it has its own prices<%= " (#{pluralize(inheriting, 'date')} use them now)" if inheriting.positive? %>.
        A new price applies to sales from now on. Leave seats blank for no limit.
      </p>
    </div>
    <div class="px-5 py-4 space-y-3">
      <div class="space-y-3" data-reorderable-target="list" data-nested-form-target="children">
        <%= f.fields_for :ticket_tiers, rows do |tf| %>
          <%= render "manage/ticketing/tier_row", tf: tf %>
        <% end %>
      </div>
      <template data-nested-form-target="template">
        <%= f.fields_for :ticket_tiers, TicketTier.new(position: 999), child_index: "NEW_CHILD_RECORD" do |tf| %>
          <%= render "manage/ticketing/tier_row", tf: tf %>
        <% end %>
      </template>
      <%= render "shared/button", text: "Add a ticket type", variant: "secondary", size: "small", type: :button, icon: "plus",
            data: { action: "nested-form#add" } %>
    </div>
  </div>

  <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
<% end %>
