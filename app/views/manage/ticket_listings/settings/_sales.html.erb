<%# One date's sales window, order limit and fee switch. Blank means the
    production's (or your default). Locals: listing, setup. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  local_time = ->(time) { time&.in_time_zone&.strftime("%Y-%m-%dT%H:%M") }
  fee_words = { "buyer" => "buyers pay the fees", "org" => "you absorb the fees" }
  cash_words = { "same" => "cash is the same as any other sale", "included" => "cash has tax included in the price" }
  # What this date follows while its switch is off: its production's own,
  # else the box office's.
  inherited_fee = setup&.fee_mode.presence || ticketing_profile.default_fee_mode
  inherited_cash = setup&.cash_tax.presence || ticketing_profile.cash_tax
  inherited_max = setup&.max_per_order || ticketing_profile.default_max_per_order
  inherited_low = setup&.low_stock_threshold || TicketListing::LOW_STOCK_DEFAULT
  low_words = inherited_low.zero? ? "no low seats note" : "a note at #{inherited_low} seats left"
  own_fees = listing.fee_mode.present? || listing.cash_tax.present? || listing.max_per_order.present? || !listing.low_stock_threshold.nil?
  followed = "#{fee_words[inherited_fee]}, #{cash_words[inherited_cash]}, up to #{inherited_max} tickets an order, and #{low_words}"
%>
<%= form_with model: listing, url: manage_ticket_listing_path(listing), method: :patch, class: "space-y-6" do |f| %>
  <%= hidden_field_tag :section, "sales" %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="window">
    <%= render "shared/section_heading", title: "When sales open and close", intro: "This date's own times." %>
    <div class="px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="ticket_listing_on_sale_at" class="block text-sm font-medium text-gray-700 mb-1.5">Online sales open</label>
        <%= f.datetime_local_field :on_sale_at, value: local_time.call(listing.on_sale_at), class: input_class %>
        <p class="text-xs text-gray-500 mt-1">Empty: as soon as it's on sale.</p>
      </div>
      <div>
        <label for="ticket_listing_off_sale_at" class="block text-sm font-medium text-gray-700 mb-1.5">Online sales close</label>
        <%= f.datetime_local_field :off_sale_at, value: local_time.call(listing.off_sale_at), class: input_class %>
        <p class="text-xs text-gray-500 mt-1">After that it's door sales.</p>
      </div>
    </div>
  </div>

  <%# Fees, cash, the order limit and the low seats note: what the date
      follows, or (switch on) its own, by the one override control. %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle" data-settings-card="fees">
    <%= render "manage/ticketing/own_switch", title: "Fees, cash, and order limit", follows: (setup ? listing.production.name : "your box office"), followed: followed,
          only: "this date", name: "ticket_listing[own_fees]", id: "ticket_listing_own_fees", checked: own_fees %>
    <fieldset <%= "disabled" unless own_fees %> data-fieldset-toggle-target="fields" class="px-6 py-5 disabled:opacity-50">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="ticket_listing_fee_mode" class="block text-sm font-medium text-gray-700 mb-1.5">Who pays the fees</label>
          <%= f.select :fee_mode, options_for_select([ [ "Buyers pay the fees", "buyer" ], [ "You absorb the fees", "org" ] ], listing.fee_mode.presence || inherited_fee), {}, class: input_class %>
        </div>
        <div>
          <label for="ticket_listing_cash_tax" class="block text-sm font-medium text-gray-700 mb-1.5">Cash at the door</label>
          <%= f.select :cash_tax, options_for_select([ [ "The same as any other sale", "same" ], [ "Tax is included in the price", "included" ] ], listing.cash_tax.presence || inherited_cash), {}, class: input_class %>
        </div>
        <div>
          <label for="ticket_listing_max_per_order" class="block text-sm font-medium text-gray-700 mb-1.5">Most tickets in one order</label>
          <%= f.number_field :max_per_order, min: 1, max: 100, value: listing.max_per_order || inherited_max, class: input_class %>
        </div>
        <div>
          <label for="ticket_listing_low_stock_threshold" class="block text-sm font-medium text-gray-700 mb-1.5">Show an "Only N left" note</label>
          <%= f.select :low_stock_threshold, options_for_select(low_stock_choices(listing.low_stock_threshold), listing.low_stock_threshold || inherited_low), {}, class: input_class %>
        </div>
      </div>
    </fieldset>
  </div>

  <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
<% end %>

<% if listing.status == "draft" && !listing.worth_keeping? %>
  <div class="mt-6 bg-white border border-gray-200 rounded-xl px-6 py-4 flex flex-wrap items-center justify-between gap-3" data-settings-card="remove">
    <p class="text-sm text-gray-600">Nobody has bought for this date. Removing it takes it out of Ticketing; the show stays on your calendar.</p>
    <%= render "shared/button", text: "Remove from Ticketing", variant: "secondary", size: "small", type: :button,
          data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-remove-listing" } %>
  </div>
  <%= render "shared/confirm_modal", id: "confirm-remove-listing", title: "Remove this date from Ticketing?",
        message: "Its page and prices are deleted. The show itself stays on your calendar.",
        confirm_text: "Remove", url: manage_ticket_listing_path(listing), method: :delete %>
<% end %>
