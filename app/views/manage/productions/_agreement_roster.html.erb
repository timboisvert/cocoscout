<%#
  Producer roster grid for a production's agreement. Locals:
    production    - the Production
    roster        - production.agreement_roster (array of status hashes)
    roster_counts - production.agreement_roster_counts
  Shows every talent-pool person and where they are: Signed / Awaiting (sent, not
  yet signed) / Not sent — with per-person send/resend.
%>

<%# Summary chips %>
<div class="flex flex-wrap items-center gap-2 mb-4">
  <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 border border-green-200 px-3 py-1 text-sm font-medium text-green-700">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
    <%= roster_counts[:signed] %> signed
  </span>
  <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 border border-amber-200 px-3 py-1 text-sm font-medium text-amber-700">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l2 2m6-2a8 8 0 11-16 0 8 8 0 0116 0z"/></svg>
    <%= roster_counts[:awaiting] %> awaiting
  </span>
  <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-50 border border-gray-200 px-3 py-1 text-sm font-medium text-gray-600">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636a9 9 0 11-12.728 0M12 3v6"/></svg>
    <%= roster_counts[:not_sent] %> not sent
  </span>
</div>

<% if roster.empty? %>
  <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-8 text-center">
    <p class="text-sm text-gray-600">No performers in the talent pool yet. Add people to the talent pool to track their agreement.</p>
  </div>
<% else %>
  <div class="overflow-x-auto rounded-lg border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Performer</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wide">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <% roster.each do |row| %>
          <% person = row[:person] %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                <% headshot_variant = person.safe_headshot_variant(:thumb) %>
                <% if headshot_variant %>
                  <%= image_tag rails_storage_proxy_url(headshot_variant), alt: person.name, class: "w-9 h-9 rounded-lg object-cover flex-shrink-0" %>
                <% else %>
                  <div class="w-9 h-9 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-xs flex-shrink-0"><%= person.initials %></div>
                <% end %>
                <span class="font-medium text-gray-900"><%= person.name %></span>
              </div>
            </td>
            <td class="px-4 py-3">
              <% case row[:status] %>
              <% when :signed %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-green-100 px-2.5 py-1 text-xs font-medium text-green-800">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
                  Signed <%= row[:signed_at]&.strftime("%b %-d, %Y") %>
                </span>
              <% when :awaiting %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-800">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l2 2m6-2a8 8 0 11-16 0 8 8 0 0116 0z"/></svg>
                  Sent <%= row[:sent_at]&.strftime("%b %-d, %Y") %><%= " · #{row[:send_count]}×" if row[:send_count].to_i > 1 %>
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600">Not sent</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <% if row[:status] == :signed %>
                <span class="text-xs text-gray-400">—</span>
              <% else %>
                <%= button_to send_agreement_reminders_manage_production_path(production, person_id: person.id), method: :post, class: "inline-block" do %>
                  <%= render "shared/button", text: (row[:status] == :awaiting ? "Resend" : "Send"), variant: "secondary", size: "small" %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
