<% content_for :title, "My Payments" %>

<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [],
    text: "My Payments",
    links: []
  } %>

  <%= render "my/payments/bank_connect_banner" %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Main column: what you're owed / paid, then the full history. %>
    <div class="lg:col-span-2 space-y-6">
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">To be paid</div>
          <div class="text-2xl font-semibold text-gray-900"><%= number_to_currency(@to_be_paid_cents / 100.0) %></div>
          <% if @pending_total_cents.to_i.positive? %>
            <div class="text-[11px] text-amber-600 mt-0.5">incl. <%= number_to_currency(@pending_total_cents / 100.0) %> awaiting approval</div>
          <% end %>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Total received</div>
          <div class="text-2xl font-semibold text-gray-900"><%= number_to_currency(@total_received) %></div>
        </div>
      </div>

      <%# Money the orgs have already put in motion — the payee should never
          think nobody's tried to pay them when a run is submitted or staged. %>
      <% if @submitted_run_items.any? || @queued_run_items.any? %>
        <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
          <div class="px-5 py-4 border-b border-gray-200">
            <h3 class="font-semibold text-gray-900">On its way</h3>
          </div>
          <div class="divide-y divide-gray-100">
            <% @submitted_run_items.each do |item| %>
              <% batch = item.payout_batch %>
              <% earliest, latest = batch.expected_deposit_range %>
              <div class="px-5 py-3 flex items-center justify-between gap-4">
                <div class="min-w-0 flex items-start gap-2.5">
                  <div class="w-7 h-7 rounded-lg bg-blue-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19V5m0 0l-6 6m6-6l6 6"/></svg>
                  </div>
                  <div class="min-w-0">
                    <div class="text-sm font-medium text-gray-900">
                      Payout run submitted<% if batch.payday %> <%= batch.payday.strftime("%b %-d") %><% end %>
                    </div>
                    <div class="text-xs text-gray-500">
                      <%= batch.organization&.name %> · expect it in your bank
                      <span class="font-medium text-gray-700"><%= earliest.strftime("%b %-d") %>–<%= latest.strftime("%b %-d") %></span>
                    </div>
                  </div>
                </div>
                <div class="text-sm font-semibold text-gray-900 tabular-nums flex-shrink-0"><%= number_to_currency(item.amount_cents / 100.0) %></div>
              </div>
            <% end %>
            <% @queued_run_items.each do |item| %>
              <% batch = item.payout_batch %>
              <div class="px-5 py-3 flex items-center justify-between gap-4">
                <div class="min-w-0 flex items-start gap-2.5">
                  <div class="w-7 h-7 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  </div>
                  <div class="min-w-0">
                    <div class="text-sm font-medium text-gray-900">Queued for a payout run</div>
                    <div class="text-xs text-gray-500">
                      <%= batch.organization&.name %><% if batch.payday %> · planned for <%= batch.payday.strftime("%b %-d") %><% end %>
                    </div>
                  </div>
                </div>
                <div class="text-sm font-semibold text-gray-900 tabular-nums flex-shrink-0"><%= number_to_currency(item.amount_cents / 100.0) %></div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# What makes up "To be paid" — confirmed lines plus anything awaiting approval. %>
      <% if @owed_lines.any? || @pending_lines.any? %>
        <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
          <div class="px-5 py-4 border-b border-gray-200">
            <h3 class="font-semibold text-gray-900">What you're being paid for</h3>
          </div>
          <%# No bank yet: the money is real and waiting — say exactly what
              unlocks it rather than leaving the impression nothing's happening. %>
          <% if !@person.can_receive_payouts? && @to_be_paid_cents.to_i.positive? %>
            <div class="px-5 py-3 bg-amber-50 border-b border-amber-200 flex flex-wrap items-center justify-between gap-3">
              <p class="text-sm text-amber-900">This is what you'll be paid once you add your payment info — it's ready and waiting on your bank details.</p>
              <%= render "shared/button", text: "Add payment info", variant: "primary", size: "small", path: my_payments_connect_bank_path, method: :post, form: { data: { turbo: false } } %>
            </div>
          <% end %>
          <div class="divide-y divide-gray-100">
            <% @owed_lines.each do |line| %>
              <div class="px-5 py-3 flex items-center justify-between gap-4">
                <div class="min-w-0">
                  <div class="text-sm text-gray-900 truncate"><%= line[:label] %></div>
                  <% if line[:org].present? %><div class="text-xs text-gray-400 truncate"><%= line[:org] %></div><% end %>
                </div>
                <div class="text-sm font-medium text-gray-900 tabular-nums flex-shrink-0"><%= number_to_currency(line[:cents] / 100.0) %></div>
              </div>
            <% end %>
            <% if @already_paid_out_cents.to_i.positive? %>
              <div class="px-5 py-3 flex items-center justify-between gap-4">
                <div class="text-sm text-gray-400">Already paid out</div>
                <div class="text-sm text-gray-400 tabular-nums flex-shrink-0">−<%= number_to_currency(@already_paid_out_cents / 100.0) %></div>
              </div>
            <% end %>
            <% @pending_lines.each do |line| %>
              <div class="px-5 py-3 flex items-center justify-between gap-4">
                <div class="min-w-0">
                  <div class="text-sm text-gray-900 truncate flex items-center gap-2">
                    <span class="truncate"><%= line[:label] %></span>
                    <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium bg-amber-100 text-amber-700 flex-shrink-0">Awaiting approval</span>
                  </div>
                  <% if line[:org].present? %><div class="text-xs text-gray-400 truncate"><%= line[:org] %></div><% end %>
                </div>
                <div class="text-sm font-medium text-gray-500 tabular-nums flex-shrink-0"><%= number_to_currency(line[:cents] / 100.0) %></div>
              </div>
            <% end %>
          </div>
          <div class="px-5 py-3 border-t border-gray-200 bg-gray-50 flex items-center justify-between">
            <span class="text-sm font-medium text-gray-700">To be paid</span>
            <span class="text-sm font-bold text-gray-900 tabular-nums"><%= number_to_currency(@to_be_paid_cents / 100.0) %></span>
          </div>
        </div>
      <% end %>

      <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-200">
          <h3 class="font-semibold text-gray-900">Payment history</h3>
        </div>

        <% if @payment_history.any? %>
          <div class="divide-y divide-gray-100">
            <%# Each row is one actual payment — click through for its receipt
                (everything that deposit or hand-payment covered). %>
            <% @payment_history.each do |payment| %>
              <%= link_to my_payment_receipt_path(kind: payment[:kind], id: payment[:id]),
                    class: "px-5 py-4 flex items-center justify-between gap-4 hover:bg-gray-50 transition-colors" do %>
                <div class="min-w-0">
                  <div class="font-medium text-gray-900 truncate"><%= payment[:title] %></div>
                  <div class="text-sm text-gray-500 truncate">
                    <% bits = [payment[:org], payment[:subtitle]].compact %>
                    <%= bits.join(" · ") %>
                  </div>
                </div>
                <div class="text-right flex-shrink-0">
                  <div class="font-semibold text-green-600"><%= number_to_currency(payment[:cents] / 100.0) %></div>
                  <div class="text-xs text-gray-500"><%= paid_with_phrase(payment[:paid_at], payment[:method]) %></div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-12 text-gray-500">
            <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p>No payments yet.</p>
            <p class="text-sm mt-1">Payments from shows will appear here once they're processed.</p>
          </div>
        <% end %>
      </div>
    </div>

    <%# Right column: actions (money-section style). %>
    <aside class="space-y-4">
      <div class="bg-white rounded-lg border border-gray-200 p-5">
        <h3 class="font-semibold text-gray-900 mb-1">Payment settings</h3>
        <div class="flex items-center gap-2 mb-4 text-sm">
          <% if @person.can_receive_payouts? %>
            <span class="inline-flex items-center gap-1 text-green-700">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Bank connected
            </span>
          <% else %>
            <span class="text-amber-700">Bank not connected yet</span>
          <% end %>
        </div>
        <%= render "shared/button", text: "Manage payment settings", variant: "primary", size: "medium", path: my_payments_setup_path %>
      </div>

      <div class="rounded-lg bg-gray-50 border border-gray-200 p-4">
        <p class="text-xs text-gray-500">Payments land straight in your connected bank account. Your bank and tax details stay with Stripe — productions never see them.</p>
      </div>
    </aside>
  </div>
</div>
