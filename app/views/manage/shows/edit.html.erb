<% content_for :title, "#{@show.display_name} · #{@show.date_and_time.strftime("%a, %b %-d")} · Settings" %>

<%
  location_spaces_map = Current.organization.locations.includes(:location_spaces).each_with_object({}) { |l, h| h[l.id] = l.location_spaces.map { |s| { id: s.id, name: s.name } } }
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  when_words = @show.date_and_time.strftime("%a, %b %-d · %-l:%M %p")
  # Each tab, and whether it has fields to save (Linked Events and the Danger
  # Zone act through their own buttons and modals).
  edit_tabs = [
    { label: "Basic Information", partial: "tab_details" },
    { label: "Schedule", partial: "tab_schedule" },
    { label: "Location", partial: "tab_location" },
    { label: "Casting & Visibility", partial: "tab_visibility" },
    { label: "Visual Assets", partial: "tab_media" },
    { label: "Tickets", partial: "tab_tickets", pro: true },
    { label: "Linked Events", partial: "tab_linked", save: false },
    { label: "Danger Zone", partial: "tab_danger", danger: true, save: false }
  ]
  ticketing_locked = !@production.organization.feature_available?(:ticketing)
%>
<div class="w-full mb-10" data-controller="location-modal tabs" data-tabs-plain-value="true"
     data-location-modal-event-type-value="<%= @show.event_type&.titleize&.downcase || 'event' %>" data-location-modal-spaces-value="<%= location_spaces_map.to_json %>">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      [ "Shows & Events", manage_shows_path ],
      [ @production.name, manage_production_shows_path(@production) ],
      [ when_words, manage_show_path(@production, @show) ]
    ],
    text: "Settings",
    links: []
  } %>

  <%= form_with(model: [ :manage, @production, @show ], class: "contents", data: { controller: "show-edit", "show-edit-casting-defaults-value": EventTypes.casting_enabled_defaults.to_json }) do |form| %>
    <%# One event of a series: say so once, above every tab, with the one
        switch that sends a save to all of them. %>
    <% if @show.recurring? %>
      <% series = @show.recurrence_group.order(:date_and_time) %>
      <div class="mb-5 rounded-lg border border-pink-200 bg-pink-50 px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <div class="text-sm text-pink-900">
          <span class="font-semibold">One of <%= pluralize(series.count, "event") %> in a series</span>,
          <%= series.first.date_and_time.strftime("%b %-d") %> to <%= series.last.date_and_time.strftime("%b %-d, %Y") %>.
          Saving changes only this one unless you switch this on.
        </div>
        <div class="flex items-center gap-2 text-sm font-medium text-pink-900">
          <span>Save to all <%= series.count %></span>
          <%= render "shared/toggle_switch", form: form, field: :recurrence_edit_scope, checked: false, checked_value: "all", unchecked_value: "this" %>
        </div>
      </div>
    <% end %>

    <%# Mobile: the tabs as a menu. %>
    <div class="sm:hidden mb-5">
      <select data-tabs-target="menu" data-action="change->tabs#selectMenu" aria-label="Settings section" class="<%= input_class %>">
        <% edit_tabs.each_with_index do |tab, i| %>
          <option value="<%= i %>"><%= tab[:label] %></option>
        <% end %>
      </select>
    </div>

    <%# Desktop: the tab strip, drawn as the settings pages draw theirs. %>
    <nav class="hidden sm:flex gap-1 border-b border-gray-200 mb-6 overflow-x-auto" aria-label="Settings sections">
      <% edit_tabs.each_with_index do |tab, i| %>
        <button type="button" data-tabs-target="tab" data-index="<%= i %>" data-action="tabs#select"
                class="inline-flex items-center gap-1 px-4 py-2 -mb-px text-sm font-medium whitespace-nowrap border-b-2 transition-colors cursor-pointer hover:text-gray-700 <%= i.zero? ? 'border-pink-500 text-pink-600' : 'border-transparent text-gray-500' %> <%= 'text-red-500' if tab[:danger] %>">
          <%= tab[:label] %>
          <% if tab[:pro] %>
            <%= render "shared/pro_marker" %>
            <%= render "shared/pro_marker", kind: :lock if ticketing_locked %>
          <% end %>
        </button>
      <% end %>
    </nav>

    <% edit_tabs.each_with_index do |tab, i| %>
      <div data-tabs-target="panel" class="space-y-6 <%= 'hidden' unless i.zero? %>">
        <%= render "manage/shows/edit/#{tab[:partial]}", form: form, input_class: input_class, location_spaces_map: location_spaces_map %>
        <% unless tab[:save] == false || (tab[:pro] && ticketing_locked) %>
          <div class="flex justify-end">
            <%= render "shared/button", text: "Save Changes", variant: "primary", size: "medium", type: :submit %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render "manage/shows/edit/move_modal" %>
  <%= render "manage/shows/edit/location_modal" %>
  <%= render "manage/shows/edit/danger_modals" %>
</div>

<%# Turbo frame for the recurring series modal %>
<%= turbo_frame_tag "recurring_series_modal" %>
