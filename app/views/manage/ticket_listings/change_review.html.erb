<% content_for :title, "Tell buyers · #{@listing.display_title}" %>
<%
  d = @draft
  show = @listing.show
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  sample = d.orders.first
  sample_vars = sample && TicketShowChange.variables(sample)
  told = ->(order) { order.told_starts_at ? order.told_starts_at.strftime("%a %b %-d, %-l:%M %p") : "?" }
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: ticket_listing_breadcrumbs(@listing),
    text: "Tell buyers about the change",
    links: []
  } %>

  <%= form_with url: manage_ticket_listing_change_path(@listing), method: :post, class: "max-w-2xl space-y-6" do %>
    <div class="bg-white border border-gray-200 rounded-xl px-6 py-5">
      <h2 class="text-lg font-semibold text-gray-900"><%= @listing.display_title %> is now <%= show.date_and_time.strftime("%A, %B %-d · %-l:%M %p") %></h2>
      <p class="text-sm text-gray-600 mt-1">
        <%= pluralize(d.orders.size, "buyer") %> bought before it changed. Each gets this email, with their tickets, which still work.
        Nothing goes out until you send it.
      </p>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">The email they'll get</h2>
        <p class="text-sm text-gray-600 mt-1">Each buyer gets their own copy. Words in double braces, like {{first_name}} and {{was}}, are filled in for each person.</p>
      </div>
      <div class="px-6 py-5 space-y-4">
        <div>
          <label for="subject" class="block text-sm font-medium text-gray-700 mb-1.5">Subject</label>
          <%= text_field_tag :subject, d.subject, class: input_class %>
        </div>
        <div>
          <label for="body" class="block text-sm font-medium text-gray-700 mb-1.5">Message</label>
          <%= text_area_tag :body, d.body, rows: 9, class: input_class %>
        </div>
        <% if sample_vars %>
          <div class="rounded-lg bg-gray-50 border border-gray-200 px-4 py-3 text-sm text-gray-700">
            <div class="text-xs font-medium text-gray-500 mb-1">How it reads for <%= sample.buyer_name.presence || sample.buyer_email %></div>
            <div class="font-medium text-gray-900"><%= ContentTemplate.interpolate(d.subject, sample_vars) %></div>
            <div class="mt-1"><%= TicketOrderMailer.paragraphs(ContentTemplate.interpolate(d.body, sample_vars)) %></div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Who gets it</h2>
      </div>
      <ul class="divide-y divide-gray-100 max-h-80 overflow-y-auto">
        <% d.orders.each do |order| %>
          <li class="flex items-center justify-between gap-4 px-6 py-2.5 text-sm">
            <span class="min-w-0 truncate text-gray-900"><%= order.buyer_name.presence || "No name" %> <span class="text-gray-500"><%= order.buyer_email %></span></span>
            <span class="text-xs text-gray-500 whitespace-nowrap">Told <%= told.call(order) %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= render "shared/button", text: "Email #{pluralize(d.orders.size, 'buyer')}", variant: "primary", size: "medium", type: :submit %>
      <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", path: manage_ticket_listing_path(@listing) %>
    </div>
  <% end %>

  <div class="max-w-2xl mt-6 rounded-lg border border-gray-200 bg-gray-50 px-5 py-4 text-sm text-gray-600 flex flex-wrap items-center justify-between gap-3">
    <span>Already told them another way, or the change is too small to mention?</span>
    <%= render "shared/button", text: "Mark as told, no email", variant: "secondary", size: "small", path: manage_ticket_listing_change_told_path(@listing), method: :post %>
  </div>
</div>
