<% content_for :title, "Payment Settings" %>

<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["My Payments", my_payments_path]
    ],
    text: "Payment Settings",
    links: []
  } %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">

    <!-- Bank account (Stripe Connect) — the primary way to get paid -->
    <div class="bg-white rounded-lg border-2 border-pink-200 p-6">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-lg bg-pink-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11m16-11v11M8 14v3m4-3v3m4-3v3" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 text-lg flex items-center gap-2">
              Bank account
              <% if @person.can_receive_payouts? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">Connected</span>
              <% end %>
            </h3>
            <p class="text-sm text-gray-500 mt-1 max-w-md">Get paid automatically, straight to your bank. Powered by Stripe — your bank and tax details stay with Stripe, never with the productions you work for.</p>
          </div>
        </div>
        <div class="flex-shrink-0">
          <%# turbo: false so the browser follows the redirect out to Stripe's hosted onboarding. %>
          <% if @person.can_receive_payouts? %>
            <%= render "shared/button", text: "Update bank details", variant: "secondary", size: "small", path: my_payments_connect_bank_path, method: :post, form: { data: { turbo: false } } %>
          <% else %>
            <%= render "shared/button", text: "Connect your bank", variant: "primary", size: "medium", path: my_payments_connect_bank_path, method: :post, form: { data: { turbo: false } } %>
          <% end %>
        </div>
      </div>

      <% unless @person.can_receive_payouts? %>
        <div class="mt-4 rounded-lg bg-amber-50 border border-amber-200 p-3">
          <p class="text-sm text-amber-900">
            <span class="font-semibold">Connect your bank to keep getting paid.</span>
            Payments are sent straight to your bank account.
          </p>
        </div>
      <% end %>
    </div>

    </div><%# /left column %>

    <%# Right column: how getting paid works (money-section style aside). %>
    <aside class="space-y-4">
      <div class="bg-white rounded-lg border border-gray-200 p-5">
        <h3 class="font-semibold text-gray-900 mb-3">How you get paid</h3>
        <ol class="space-y-3 text-sm text-gray-600">
          <li class="flex gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-pink-100 text-pink-600 text-xs font-semibold flex items-center justify-center">1</span>
            <span>Connect your bank once — Stripe collects your legal name and details securely.</span>
          </li>
          <li class="flex gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-pink-100 text-pink-600 text-xs font-semibold flex items-center justify-center">2</span>
            <span>Productions pay you straight to that account — no apps, no chasing.</span>
          </li>
          <li class="flex gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-pink-100 text-pink-600 text-xs font-semibold flex items-center justify-center">3</span>
            <span>Track everything you've been paid on <%= link_to "My Payments", my_payments_path, class: "text-pink-600 hover:text-pink-700 font-medium" %>.</span>
          </li>
        </ol>
      </div>
      <div class="rounded-lg bg-gray-50 border border-gray-200 p-4">
        <p class="text-xs text-gray-500">Your bank and tax details stay with Stripe — the productions you work for never see them.</p>
      </div>
    </aside>
  </div>
</div>
