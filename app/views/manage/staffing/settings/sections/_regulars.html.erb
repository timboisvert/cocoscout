<div class="bg-white border border-gray-200 rounded-xl p-6">
  <div class="flex items-center gap-2.5 mb-1">
    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-pink-100 text-pink-600 flex-shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"/></svg>
    </span>
    <h2 class="text-xl text-gray-900 coustard-regular">Regulars</h2>
  </div>
  <p class="text-sm text-gray-600">
    A regular is someone who always works the same slot — every event of one of
    your productions, or the same weekday shift each week ("Camille tends bar
    Thursdays 6–10"). Set the rules once, and each week Scheduling matches them
    against that week's events and your staff's availability, so you can fill
    the whole week in one click.
  </p>
  <p class="text-sm text-gray-600 mt-2">
    Nothing is ever scheduled behind your back: you review each week's matches
    first, and anyone who's marked themselves unavailable is flagged and left
    out unless you say otherwise.
  </p>

  <div class="mt-5 pt-5 border-t border-gray-200">
    <%= form_with url: manage_staffing_settings_path, method: :patch, class: "flex items-center justify-between gap-4" do %>
      <%# Marker param so an unchecked submit still routes to this setting. %>
      <%= hidden_field_tag :updating_regulars, "1" %>
      <label class="flex items-start gap-3 cursor-pointer">
        <%= check_box_tag :staffing_regulars_enabled, "1", Current.organization.staffing_regulars_enabled?,
              class: "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
        <span>
          <span class="block text-sm font-medium text-gray-900">Use Regulars on my schedule</span>
          <span class="block text-xs text-gray-500 mt-0.5">
            Adds a Regulars link and an apply button to
            <%= link_to "Scheduling", manage_staffing_scheduling_path, class: "text-pink-600 hover:text-pink-700 underline" %>.
          </span>
        </span>
      </label>
      <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
    <% end %>
  </div>

  <% if Current.organization.staffing_regulars_enabled? %>
    <div class="mt-5 pt-5 border-t border-gray-200">
      <p class="text-sm text-gray-600">
        <% if @regulars_rule_count.to_i.positive? %>
          You have <%= pluralize(@regulars_rule_count, "standing rule") %> set up.
        <% else %>
          You haven't set up any regulars yet.
        <% end %>
        <%= link_to "Manage your regulars", manage_staffing_scheduling_rules_path, class: "text-pink-600 hover:text-pink-700 underline" %>.
      </p>
    </div>
  <% end %>
</div>
