<%#
  A directory entry as a contact row (V1.1 plan §5, Contact row): headshot,
  name and email, and the ways to reach them: Call and Text for a phone on
  file, and Email. Groups show their members' count.
%>
<% person = entry.is_a?(Person) ? entry : nil %>
<div class="flex items-center gap-3 px-3 py-2 rounded-lg border border-gray-200 bg-white hover:border-pink-300 transition" data-contact-row>
  <%= link_to (person ? manage_person_path(entry) : manage_group_path(entry)), data: { turbo_frame: "_top" }, class: "flex items-center gap-3 flex-1 min-w-0" do %>
    <% headshot_variant = entry.safe_headshot_variant(:thumb) %>
    <% if headshot_variant %>
      <%= image_tag headshot_variant, alt: entry.name, loading: "lazy", class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
    <% else %>
      <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-sm flex-shrink-0"><%= entry.initials %></div>
    <% end %>
    <div class="min-w-0">
      <div class="text-sm font-medium text-gray-900 truncate"><%= entry.name %></div>
      <div class="text-xs text-gray-500 truncate">
        <% if person %><%= person.email %><% else %>Group<% end %>
      </div>
    </div>
  <% end %>
  <% if person %>
    <div class="flex items-center gap-1.5 flex-shrink-0">
      <% if person.phone.present? %>
        <%= render "shared/button", text: "Call", icon: "phone", variant: "secondary", size: "xs", path: "tel:#{person.phone.gsub(/[^\d+]/, '')}" %>
        <%= render "shared/button", text: "Text", icon: "chat-bubble", variant: "secondary", size: "xs", path: "sms:#{person.phone.gsub(/[^\d+]/, '')}" %>
      <% end %>
      <% if person.email.present? %>
        <span class="hidden sm:inline-flex"><%= render "shared/button", text: "Email", icon: "envelope", variant: "secondary", size: "xs", path: "mailto:#{person.email}" %></span>
      <% end %>
    </div>
  <% end %>
</div>
