<%# How this production sells seats (advanced ticketing §1): each date follows
    its room, or (the one override control, manage/ticketing/own_switch) the
    production picks a way and a chart for every date; then which sections
    each ticket type sells (its zone). Drawn as the other tabs are (Tim,
    2026-11-13). Locals: setup, production. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  # An archived location's charts leave the picker; the chart already picked stays.
  charts = Current.organization.seat_charts.pickable(setup.seat_chart_id).includes(location_space: { location: :location_spaces }).order(:name).to_a
  chart = setup.seat_chart
  own = setup.seating_mode.present? || chart.present?
  mode = setup.seating_mode.presence || chart&.kind || "general"
  sections = chart ? chart.sections.to_a : []
  tiers = setup.ticket_tiers.active.reject(&:bundle?).sort_by { |t| [ t.position, t.id.to_i ] }
  zone_ids = tiers.to_h { |t| [ t.id, t.seat_sections.map(&:id) ] }
  rooms_path = manage_ticketing_settings_section_path(section: "rooms")
%>
<%= form_with model: setup, scope: :production_ticketing, url: manage_update_production_ticketing_path(production, section: "seating"), method: :patch, data: { turbo: false }, class: "space-y-6" do |f| %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle" data-settings-card="seating">
    <%= render "manage/ticketing/own_switch", title: "Seating", follows: "your box office", settings_path: rooms_path,
          intro: "Each room says how its tickets sell: by count, by seat, or both at once. Every date of #{production.name} follows its room unless you choose here, and a single date can still choose for itself.",
          only: production.name, name: "production_ticketing[own_seating]", id: "production_ticketing_own_seating", checked: own %>
    <div class="px-6 py-5 space-y-4">
      <fieldset <%= "disabled" unless own %> data-fieldset-toggle-target="fields" class="grid grid-cols-1 sm:grid-cols-2 gap-4 disabled:opacity-50">
        <div>
          <%= f.label :seating_mode, "How seats sell", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.select :seating_mode, options_for_select(RoomTicketingSetting::SEATING_MODE_LABELS.map { |k, v| [ v, k ] }, mode), {}, class: input_class %>
        </div>
        <div>
          <%= f.label :seat_chart_id, "Chart", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.select :seat_chart_id, options_for_select([ [ "The room's own chart", "" ] ] + charts.map { |c| [ "#{c.name} (#{c.location_space.place_name}, #{pluralize(c.seat_count, 'seat')})", c.id ] }, setup.seat_chart_id), {}, class: input_class %>
        </div>
      </fieldset>
      <% if charts.empty? %>
        <p class="text-sm text-gray-600">There is no chart to pick yet. Charts are drawn for a room, in <%= link_to "Rooms and seating", rooms_path, class: "text-pink-600 hover:text-pink-700 underline" %>.</p>
      <% end %>
    </div>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
    </div>
  </div>

  <% if chart %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="zones">
      <%= render "shared/section_heading", title: "Zones on #{chart.name}", intro: "Which sections each ticket type sells. A ticket type with no section sells nothing on a seated date, and a section with no ticket type isn't for sale." %>
      <% if tiers.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead><tr class="text-left text-xs text-gray-500 border-b border-gray-100"><th class="px-6 py-2 font-medium">Ticket type</th><% sections.each do |s| %><th class="px-3 py-2 font-medium"><%= s.name %><span class="block text-[10px] font-normal text-gray-400"><%= s.standing? ? "standing, #{s.standing_capacity}" : pluralize(s.live_seat_count, 'seat') %></span></th><% end %></tr></thead>
            <tbody class="divide-y divide-gray-100">
              <% tiers.each do |tier| %>
                <tr>
                  <td class="px-6 py-2 font-medium text-gray-900"><%= tier.name %> <span class="text-gray-500 font-normal">· <%= number_to_currency(tier.price_cents / 100.0) %></span></td>
                  <% sections.each do |s| %>
                    <td class="px-3 py-2"><%= check_box_tag "zones[#{tier.id}][]", s.id, zone_ids[tier.id].include?(s.id), id: "zone-#{tier.id}-#{s.id}", class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500", "aria-label": "#{tier.name} sells #{s.name}" %></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= hidden_field_tag "zones_present", "1" %>
        <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
          <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
        </div>
      <% else %>
        <p class="px-6 py-5 text-sm text-gray-500">There are no ticket types yet. Add them on the Tickets tab, then come back to say which sections each one sells.</p>
      <% end %>
    </div>
  <% end %>
<% end %>
