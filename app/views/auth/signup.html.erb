<% content_for :title, "Create your account" %>
<%
  # Performers arrive from a show, a mic or an audition; producers from
  # "Start free". The lede says what one account covers; visitors who came in
  # through a campaign page get that campaign's framing in the strip instead.
  sketch = referred_from?("sketchfest")
  lede =
    if sketch
      "Put your run in once and your whole team sees it: rehearsals and show dates on one calendar, who can make which night, and who's cast in what. Your performers are free forever."
    else
      "One account for everything you do in live entertainment: get cast and scheduled, sign up for mics and auditions, sign contracts and get paid, or run an organization of your own."
    end
  back = sketch && !auth_native_app? ? { text: "SketchFest", path: sketchfest_path } : nil
%>
<% strip = capture do %>
  <% if sketch %>
    <%= render layout: "shared/auth/strip", locals: { initial: "S", dark: true } do %>
      <strong class="font-semibold text-slate-900">Welcome from SketchFest.</strong>
      Free for sketch teams up to <%= Organization::FREE_MONTHLY_EVENT_LIMIT %> rehearsals or shows a month.
    <% end %>
  <% end %>
<% end %>
<% notices = capture do %>
  <% if @signup_retry %>
    <%= render "shared/auth/notice", kind: :error, body: "That didn't go through. Please click Create account again." %>
  <% elsif @user&.errors&.any? %>
    <%= render "shared/auth/notice", kind: :error, title: "That didn't work.", body: @user.errors.full_messages.to_sentence + "." %>
  <% end %>
<% end %>

<%= render layout: "shared/auth/shell",
      locals: { title: "Create your account", lede: lede, pill: "Free to join · No card needed",
                strip: strip, notices: notices, legal: "creating an account", back: back }.compact do %>
  <%= render "shared/auth/signup_form",
        user: @user,
        signup_token: @signup_token,
        email_value: (params[:email_address] || @user&.email_address),
        autofocus: !auth_native_app? %>

  <div class="border-t border-slate-200 pt-4 text-center text-sm leading-[1.8] text-slate-600">
    Already have an account? <%= link_to "Sign in", signin_path, class: "font-medium text-pink-600 hover:text-pink-700" %>
  </div>
<% end %>
