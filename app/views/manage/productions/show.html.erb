<% content_for :title, @production.name %>
<%#
  A production's own page, for reading (Tim, 2026-11-08: "a nice little
  dashboard without editing"): who it is, what's next, what needs doing, its
  coming dates, then a box for each part of it, each with the way in.
  Settings is one of the ways in, for the people who can change it. Every
  box is drawn only when it applies to this production and this reader
  (ProductionPage). Drawn from the canvas of 2026-11-08; on a phone the
  side column follows the main one.
%>
<% page = @page %>
<div class="w-full mb-10" data-production-page="<%= @production.production_type %>">
  <%= render partial: "shared/notice", locals: { notice: notice } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Productions", manage_productions_path ] ],
    text: @production.name,
    links: []
  } %>

  <%= render "manage/productions/page/header", page: page %>
  <%= render "manage/productions/page/next", page: page %>

  <div class="mt-5 flex flex-wrap items-start gap-5 lg:gap-6">
    <div class="min-w-0 flex-[999_1_34rem] flex flex-col gap-5">
      <%= render "manage/productions/page/needs_doing", page: page %>
      <%= render "manage/productions/page/contract", page: page if page.contract %>
      <%= render "manage/productions/page/runs", page: page if page.course? %>
      <%= render "manage/productions/page/coming_up", page: page %>
      <%= render "manage/productions/page/tickets", page: page %>
      <%= render "manage/productions/page/cast", page: page if page.cast? %>
      <%= render "manage/productions/page/signups", page: page %>
      <%= render "manage/productions/page/money", page: page if page.money_box? %>
      <%= render "manage/productions/page/course_money", page: page if page.course_money_box? %>
      <%= render "manage/productions/page/services", page: page if page.service_needs.any? %>
    </div>

    <div class="min-w-0 flex-[1_1_19rem] flex flex-col gap-5">
      <div data-production-go-to>
        <%= render "shared/action_list", title: "Go to", items: production_page_destinations(page) %>
      </div>
      <%= render "manage/productions/page/registration_link", page: page if page.course? && page.current_run %>
      <%= render "manage/productions/page/people", page: page %>
      <%= render "manage/productions/page/images", page: page if page.manager? %>
    </div>
  </div>
</div>
