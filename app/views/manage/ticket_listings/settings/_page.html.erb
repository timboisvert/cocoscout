<%# What buyers read about this date. Blank means the production's. Locals:
    listing, setup. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  production = listing.production
  inherited_title = setup&.title.presence || listing.show.secondary_name.presence || production.name
  inherited_description = setup&.description.presence || production.description.to_s
%>
<%= form_with model: listing, url: manage_ticket_listing_path(listing), method: :patch, class: "space-y-6" do |f| %>
  <%= hidden_field_tag :section, "page" %>
  <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
    <div>
      <h3 class="font-semibold text-gray-900">The ticket page</h3>
      <p class="text-sm text-gray-600 mt-1">Blank fields show <%= setup ? "#{possessive(production.name)} ticketing" : "the production's" %> words, shown faintly in each box.</p>
    </div>
    <div>
      <label for="ticket_listing_title" class="block text-sm font-medium text-gray-700 mb-1.5">Title</label>
      <%= f.text_field :title, placeholder: inherited_title, class: input_class %>
    </div>
    <div>
      <label for="ticket_listing_description" class="block text-sm font-medium text-gray-700 mb-1.5">Description</label>
      <%= f.text_area :description, rows: 5, placeholder: inherited_description.truncate(200), class: input_class %>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label for="ticket_listing_door_note" class="block text-sm font-medium text-gray-700 mb-1.5">Doors</label>
        <%= f.text_field :door_note, placeholder: setup&.door_note.presence || "Doors 30 min before", class: input_class %>
      </div>
      <div>
        <label for="ticket_listing_age_note" class="block text-sm font-medium text-gray-700 mb-1.5">Ages</label>
        <%= f.text_field :age_note, placeholder: setup&.age_note.presence || "18+", class: input_class %>
      </div>
      <div>
        <label for="ticket_listing_accessibility_note" class="block text-sm font-medium text-gray-700 mb-1.5">Accessibility</label>
        <%= f.text_field :accessibility_note, placeholder: setup&.accessibility_note.presence || "Step-free entry", class: input_class %>
      </div>
    </div>
  </div>

  <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
<% end %>

<%= render "manage/ticket_listings/page_image", listing: listing %>
