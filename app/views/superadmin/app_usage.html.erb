<% content_for :title, "App - Superadmin" %>
<%#
  Superadmin → Business → App (Tim, 2026-11-13): the iPhone and Android apps
  in a set of screens, each a real address, with the platform and the period
  chosen once and kept from screen to screen. Counted on our own server
  (AppUsageReport); the stores keep downloads and deletions.
%>
<%
  filters = { platform: @report.platform, days: (@report.days unless @report.days == 30) }.compact
  section_path = ->(key, **over) { app_usage_path(*([ key ] unless key == "overview"), **filters.merge(over).compact) }
  choice = "px-2.5 py-1 text-xs font-medium"
  on = "bg-pink-500 text-white"
  off = "text-gray-700 hover:bg-gray-50"
%>
<%= render layout: "shared/settings_layout", locals: {
      title: "App", breadcrumbs: [ [ "Superadmin", superadmin_path ] ],
      sections: SuperadminController::APP_SECTIONS.map { |key, label| { key: key, label: label, path: section_path.call(key) } },
      current: @section, width: "max-w-6xl",
      intro: "People using the iPhone and Android apps, counted on our own server: a day for each person who opens an app page, and a count of the pages they load. The App Review accounts are left out."
    } do %>
  <div class="flex flex-wrap items-center gap-3" data-app-filters>
    <span class="inline-flex rounded-md border border-gray-300 overflow-hidden bg-white" role="group" aria-label="App">
      <% [ [ nil, "All" ], [ "ios", "iPhone" ], [ "android", "Android" ] ].each do |value, label| %>
        <%= link_to label, section_path.call(@section, platform: value), class: "#{choice} #{@report.platform == value ? on : off}",
              aria: { current: (@report.platform == value ? "true" : nil) } %>
      <% end %>
    </span>
    <span class="inline-flex rounded-md border border-gray-300 overflow-hidden bg-white" role="group" aria-label="Period">
      <% AppUsageReport::PERIODS.each do |days| %>
        <%= link_to "#{days} days", section_path.call(@section, days: (days unless days == 30)), class: "#{choice} #{@report.days == days ? on : off}",
              aria: { current: (@report.days == days ? "true" : nil) } %>
      <% end %>
    </span>
  </div>

  <div data-app-usage data-app-section="<%= @section %>" class="space-y-4">
    <%= render "superadmin/app/#{@section}", report: @report %>
  </div>
<% end %>
