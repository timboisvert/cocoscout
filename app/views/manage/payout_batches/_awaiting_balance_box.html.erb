<%#
  A run paying from the CocoScout balance as it clears (awaiting_balance):
  what's left, when the bank pays it, the button that has the bank pay it
  now, and the Pay order window for whoever is left.

  Locals: batch, items
%>
<%
  org = Current.organization
  money = ->(cents) { number_to_currency(cents / 100.0) }
  rest = items.select { |item| PayoutBatch::RETRYABLE_ITEM_STATUSES.include?(item.status) }
  due = batch.bank_due_at&.in_time_zone(org.time_zone)
  bank_cents = PayoutBatchService.rest_bank_cents(batch)
  who = rest.size == 1 ? "1 payee is" : "#{rest.size} payees are"
  due_words = due ? due.strftime("%B %-d") : "their due date"
  line = if rest.none?(&:payable_now?)
    "#{who} waiting on a bank. Their money is set aside from your balance as it clears, or from your bank on #{due_words}, and each is paid once they connect."
  else
    "#{who} paid as ticket money clears, or from your bank on #{due_words}."
  end
  # Whether waiting would help: what the bank would pay on each day the
  # money already sold changes it (PayoutBalanceForecast).
  forecast = PayoutBalanceForecast.rows(batch)
  bank_day = due&.to_date
  confirm = if bank_cents.positive?
    [ "We'll pay the other #{rest.size} (#{money.call(rest.sum(&:amount_cents))}) from your balance and debit #{money.call(bank_cents)} from your bank. They're paid when the debit clears.",
      bank_debit_note(org) ].compact.join(" ")
  else
    "Your balance covers everyone left, so they're paid now."
  end
%>
<div class="rounded-lg border border-pink-200 bg-pink-50 p-5">
  <h2 class="text-sm font-semibold text-gray-900"><%= money.call(rest.sum(&:amount_cents)) %> still to pay on this run</h2>
  <p class="text-sm text-gray-600 mt-1"><%= line %></p>
  <% if forecast.any? { |row| row.bank_cents.positive? } %>
    <%= render "manage/payout_batches/balance_advice", batch: batch, rows: forecast, bank_day: bank_day, can_move: true %>
  <% end %>
  <% if batch.funding_error.present? %>
    <p class="text-sm text-red-700 mt-2">Your bank didn't pay the rest: <%= batch.funding_error %></p>
  <% end %>
  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
    <% rest_cid = "confirm-pay-rest-batch" %>
    <%= render "shared/button", text: "Pay the rest from my bank", variant: "primary", size: "medium", type: :button,
          data: { controller: "modal", action: "click->modal#open", modal_id: rest_cid } %>
    <%= render "shared/confirm_modal", id: rest_cid,
          title: "Pay the rest now?",
          message: h(confirm),
          confirm_text: "Pay the rest",
          url: manage_pay_rest_payout_batch_path(batch),
          method: :post %>
    <%= render "manage/payout_batches/pay_order_link", batch: batch %>
  </div>
</div>
<%= render "manage/payout_batches/pay_order_modal", batch: batch, items: items %>
