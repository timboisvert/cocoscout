<% content_for :title, "Pay People" %>

<div class="w-full mb-10" data-controller="pay-run tips-worksheet pay-draft help-modal"
     data-action="input->pay-run#recalc change->pay-run#recalc"
     data-pay-draft-url-value="<%= manage_staffing_pay_draft_path %>"
     data-pay-draft-initial-value="<%= @draft %>">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ ["Staffing", manage_staffing_index_path] ],
    text: "Pay People",
    links: [
      { text: "How pay works", icon: "search", variant: "secondary", type: :button, data: { action: "click->help-modal#open" } }
    ]
  } %>

  <% payable = @staff_members.select { |m| m.person.respond_to?(:can_receive_payouts?) && m.person.can_receive_payouts? } %>

  <% unless Current.organization.funding_payment_method_id.present? %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 mt-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-amber-900">Connect a bank account to fund pay runs first.</p>
      <%= render "shared/button", text: "Connect a bank account", variant: "primary", size: "small",
            path: manage_connect_payout_funding_path, method: :post, form: { data: { turbo: false } } %>
    </div>
  <% end %>

  <% if @staff_members.empty? %>
    <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-6 text-center mt-4">
      <p class="text-sm text-gray-600 mb-3">No staff to pay yet.</p>
      <%= render "shared/button", text: "Add a staff member", variant: "primary", size: "small", path: manage_new_staffing_staff_wizard_path %>
    </div>
  <% else %>
    <%= form_with url: manage_create_staffing_pay_path, method: :post, class: "mt-4",
          data: { controller: "pay-confirm", "pay-draft-target": "form",
                  action: "input->pay-draft#schedule change->pay-draft#schedule submit->pay-confirm#intercept" } do %>
      <%# ACH is the only funding method for now — no card option. %>
      <input type="hidden" name="funding_method" value="ach">

      <%# These hours/amounts get added to your one open staffing payout run;
          you fund and pay that run separately (on its own schedule) from the
          payout-runs page. %>
      <div class="rounded-lg border border-gray-200 bg-white p-4 mb-4">
        <div class="flex flex-col lg:flex-row lg:items-stretch gap-5">
          <div class="lg:w-56 lg:border-r lg:border-gray-100 lg:pr-5" data-controller="deposit-estimate">
            <label class="block text-sm font-medium text-gray-700 mb-1">Pay date</label>
            <%= date_field_tag :payday, @payday, min: Date.current,
                  data: { deposit_estimate_target: "date", action: "change->deposit-estimate#update input->deposit-estimate#update" },
                  class: "w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
            <p class="text-xs text-gray-500 mt-1">The day you plan to fund &amp; pay this run.</p>
            <p data-deposit-estimate-target="error" class="hidden text-xs text-red-600 mt-1"></p>
            <p data-deposit-estimate-target="estimate" class="hidden text-xs font-medium text-gray-700 mt-1"></p>
          </div>

          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">How staff pay works</span>
              <button type="button" data-action="click->help-modal#open" class="text-xs text-pink-600 hover:text-pink-700 cursor-pointer">What's this?</button>
            </div>
            <p class="text-sm text-gray-600">
              What you enter here is added to your <span class="font-medium text-gray-900">open staffing payout run</span>, so you can build it up across the pay period.
              When you're ready, open it from
              <%= link_to "Payout runs", manage_payout_batches_path, class: "text-pink-600 hover:text-pink-700 font-medium" %>
              and hit <span class="font-medium text-gray-900">Fund &amp; pay</span> — we debit your bank by ACH and deposit each person a few business days later.
            </p>
            <p class="text-[11px] text-gray-400 mt-2">Staffing runs are separate from performer runs and pay on their own schedule.</p>
          </div>
        </div>
      </div>

      <%# One grid, two layouts. Below lg each person is a stacked card with
          labeled fields (no sideways scrolling); from lg up it's the classic
          spreadsheet table. Same single set of inputs in both — the form,
          draft autosave, pull-hours, worksheets, and pay-run math don't know
          the difference. %>
      <%# Rate has no column of its own — pay rates belong to the work (roles),
          and they surface inside each person's Hours modal where hours are
          actually included and priced. %>
      <div class="lg:overflow-x-auto lg:border lg:border-gray-200 lg:rounded-lg lg:bg-white"
           data-controller="pay-accordion pay-hours"
           data-action="input->pay-accordion#refreshAll change->pay-accordion#refreshAll input->pay-hours#syncAll keydown.esc@window->pay-hours#closeAll pay-hours:commit->pay-hours#commitMembers">
        <table class="block lg:table min-w-full text-sm">
          <thead class="hidden lg:table-header-group bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
            <tr>
              <th class="text-left font-medium px-3 py-2">Staff</th>
              <th class="text-right font-medium px-3 py-2">Hours</th>
              <th class="text-right font-medium px-3 py-2">Bonus</th>
              <th class="text-right font-medium px-3 py-2">Reimb.</th>
              <th class="text-right font-medium px-3 py-2">Tips</th>
              <th class="text-right font-medium px-3 py-2">Cash tips</th>
              <th class="text-right font-medium px-3 py-2">Total</th>
            </tr>
          </thead>
          <tbody class="block lg:table-row-group space-y-3 lg:space-y-0 lg:divide-y lg:divide-gray-100">
            <% @staff_members.each do |member| %>
              <% payee = member.person %>
              <% can_pay = payee.respond_to?(:can_receive_payouts?) && payee.can_receive_payouts? %>
              <%
                # Rate is a property of the work (the role), not the person. All
                # hours — included entries and ad-hoc — are picked and priced in
                # this person's Hours modal; the member default rate is only the
                # fallback for role-less work.
                role_rates = @role_rates_by_member[member.id] || []
                entries = @approved_entries_by_person[member.person_id] || []
              %>
              <tr data-pay-run-target="row" data-pay-accordion-target="row" data-pay-hours-target="row"
                  data-rate="<%= member.hourly_rate_cents.to_i %>" data-payable="<%= can_pay %>"
                  data-member-id="<%= member.id %>" data-member-name="<%= member.display_name %>"
                  class="block lg:table-row bg-white lg:bg-transparent border border-gray-200 lg:border-0 rounded-lg lg:rounded-none p-3 lg:p-0 <%= "opacity-60" unless can_pay %>">
                <%# Person header — the accordion toggle on mobile (name + live summary
                    of anything entered); a plain name cell in the desktop table. %>
                <td class="block lg:table-cell cursor-pointer lg:cursor-auto select-none lg:select-auto lg:px-3 lg:py-2 lg:align-top"
                    data-action="click->pay-accordion#toggle">
                  <div class="flex items-center justify-between gap-3 lg:block">
                    <div class="min-w-0">
                      <div class="font-medium text-gray-900 truncate"><%= member.display_name %></div>
                    </div>
                    <svg data-acc-chevron class="w-4 h-4 text-gray-400 flex-shrink-0 transition-transform lg:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </div>
                  <div data-acc-summary class="hidden text-xs font-medium text-gray-600 mt-1 lg:hidden"></div>
                  <% unless can_pay %><span class="text-[11px] text-amber-600">Needs to connect a bank to get paid</span><% end %>
                </td>
                <td data-acc-field class="hidden items-center justify-between gap-3 py-1 lg:table-cell lg:px-3 lg:py-2 lg:text-right lg:align-top">
                  <span class="text-xs text-gray-500 lg:hidden">Hours</span>
                  <div class="text-right">
                    <%# Form state written by the Hours modal's Done button:
                        included entry ids + "hours|role_id" ad-hoc pairs. %>
                    <span id="pay-entries-<%= member.id %>"></span>
                    <span id="pay-adhoc-<%= member.id %>"></span>
                    <%= render "shared/button", text: "Add hours", variant: "primary", size: "small", type: :button,
                          classes: "w-full lg:w-auto",
                          data: { action: "click->pay-hours#open", "pay-hours-target": "button", "member-id": member.id } %>
                  </div>

                </td>
                <td data-acc-field class="hidden items-center justify-between gap-3 py-1 lg:table-cell lg:px-3 lg:py-2 lg:text-right lg:align-top">
                  <span class="text-xs text-gray-500 lg:hidden">Bonus</span>
                  <input type="text" inputmode="decimal" name="lines[<%= member.id %>][bonus]" data-pay-field="bonus" data-action="input->pay-run#recalc" placeholder="0" class="w-24 lg:w-20 px-2 py-1.5 text-base lg:text-sm border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300">
                </td>
                <td data-acc-field class="hidden items-center justify-between gap-3 py-1 lg:table-cell lg:px-3 lg:py-2 lg:text-right lg:align-top">
                  <span class="text-xs text-gray-500 lg:hidden">Reimbursement</span>
                  <input type="text" inputmode="decimal" name="lines[<%= member.id %>][reimbursement]" data-pay-field="reimbursement" data-action="input->pay-run#recalc" placeholder="0" class="w-24 lg:w-20 px-2 py-1.5 text-base lg:text-sm border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300">
                </td>
                <td data-acc-field class="hidden items-center justify-between gap-3 py-1 lg:table-cell lg:px-3 lg:py-2 lg:text-right lg:align-top">
                  <span class="text-xs text-gray-500 lg:hidden">Tips</span>
                  <div class="text-right">
                    <input id="pay-tips-<%= member.id %>" type="text" inputmode="decimal" name="lines[<%= member.id %>][tips]" data-pay-field="tips" data-action="input->pay-run#recalc" placeholder="0" class="w-24 lg:w-20 px-2 py-1.5 text-base lg:text-sm border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300">
                    <span id="pay-tips-sheet-<%= member.id %>" class="hidden"></span>
                    <button type="button" data-action="click->tips-worksheet#open" data-member-id="<%= member.id %>" data-field-input-id="pay-tips-<%= member.id %>" data-holder-id="pay-tips-sheet-<%= member.id %>" data-field-name="tips_sheet" data-title="Tips worksheet"
                            class="block ml-auto mt-1 text-[11px] text-pink-600 hover:text-pink-700 cursor-pointer">worksheet</button>
                  </div>
                </td>
                <td data-acc-field class="hidden items-center justify-between gap-3 py-1 lg:table-cell lg:px-3 lg:py-2 lg:text-right lg:align-top">
                  <span class="text-xs text-gray-500 lg:hidden">Cash tips</span>
                  <div class="text-right">
                    <input id="pay-cashtips-<%= member.id %>" type="text" inputmode="decimal" name="lines[<%= member.id %>][cash_tips]" placeholder="0" class="w-24 lg:w-20 px-2 py-1.5 text-base lg:text-sm border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300">
                    <span id="pay-cashtips-sheet-<%= member.id %>" class="hidden"></span>
                    <button type="button" data-action="click->tips-worksheet#open" data-member-id="<%= member.id %>" data-field-input-id="pay-cashtips-<%= member.id %>" data-holder-id="pay-cashtips-sheet-<%= member.id %>" data-field-name="cash_tips_sheet" data-title="Cash tips worksheet"
                            class="block ml-auto mt-1 text-[11px] text-pink-600 hover:text-pink-700 cursor-pointer">worksheet</button>
                  </div>
                </td>
                <td data-acc-field class="hidden items-center justify-between gap-3 pt-2 mt-1 border-t border-gray-100 lg:border-t-0 lg:mt-0 lg:table-cell lg:px-3 lg:py-2 lg:pt-3.5 lg:text-right lg:align-top">
                  <span class="text-xs font-medium text-gray-600 lg:hidden">Total</span>
                  <span class="font-medium text-gray-900" data-pay-total>$0.00</span>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="block lg:table-footer-group mt-3 lg:mt-0 bg-gray-50 border border-gray-200 lg:border-0 lg:border-t lg:border-gray-200 rounded-lg lg:rounded-none">
            <tr class="flex items-center justify-between gap-3 p-3 lg:p-0 lg:table-row">
              <td colspan="6" class="block lg:table-cell lg:px-3 lg:py-3 lg:text-right text-sm text-gray-600">Total to pay (<span data-pay-run-target="count">0</span> people, cash tips excluded)</td>
              <td class="block lg:table-cell lg:px-3 lg:py-3 text-right text-base font-semibold text-gray-900" data-pay-run-target="grandTotal">$0.00</td>
            </tr>
          </tfoot>
        </table>

        <%# Hours modals — one per member, deliberately OUTSIDE the rows: a
            no-bank row is dimmed with opacity, and an opacity ancestor creates
            a stacking context that traps/clips the fixed overlay. Out here they
            layer over the whole page. Still inside this wrapper so the
            pay-hours controller's targets resolve. %>
        <% @staff_members.each do |member| %>
          <%= render "manage/staffing/pay/hours_modal",
                member: member,
                entries: @approved_entries_by_person[member.person_id] || [],
                role_rates: @role_rates_by_member[member.id] || [] %>
        <% end %>
      </div>

      <p class="text-xs text-gray-500 mt-2">Only staff with a connected bank are paid. Paying staff is unlimited and included in the $5/month per active staff member. Cash tips are saved to this pay run's record for your files, but not sent through us.</p>

      <div class="flex items-center justify-end gap-3 mt-4">
        <%= link_to "Cancel", manage_staffing_index_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
        <%= render "shared/button", text: "Add to pay run", variant: "primary", size: "medium", type: :submit %>
      </div>

      <%# ===== Missing-hours check (shown on submit when approved hours aren't
          included in this pay — e.g. a shift approved after hours were added). %>
      <div data-pay-confirm-target="missingModal" class="hidden fixed inset-0 z-[70] bg-black/60 backdrop-blur-sm overflow-y-auto"
           data-action="click->pay-confirm#backdropClose">
        <div class="flex min-h-full items-start justify-center p-4 py-12">
          <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl" data-action="click->pay-confirm#stopPropagation">
            <div class="flex items-center justify-between px-5 py-4 bg-gradient-to-r from-pink-500 to-pink-600 rounded-t-xl">
              <h3 class="text-lg font-semibold text-white">Approved hours not included</h3>
              <button type="button" data-action="click->pay-confirm#closeAll" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <div class="px-5 py-4">
              <p class="text-sm text-gray-600 mb-3">These approved hours aren't part of this pay. Include them?</p>
              <div data-pay-confirm-target="missingList" class="space-y-1.5 text-sm text-gray-800"></div>
            </div>
            <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
              <%= render "shared/button", text: "No, skip them", variant: "secondary", size: "small", type: :button, data: { action: "click->pay-confirm#skipMissing" } %>
              <%= render "shared/button", text: "Yes, include them", variant: "primary", size: "small", type: :button, data: { action: "click->pay-confirm#includeMissing" } %>
            </div>
          </div>
        </div>
      </div>

      <%# ===== Pay summary + acknowledge (the last stop before submitting). %>
      <div data-pay-confirm-target="summaryModal" class="hidden fixed inset-0 z-[70] bg-black/60 backdrop-blur-sm overflow-y-auto"
           data-action="click->pay-confirm#backdropClose">
        <div class="flex min-h-full items-start justify-center p-4 py-12">
          <div class="relative w-full max-w-lg bg-white rounded-xl shadow-2xl" data-action="click->pay-confirm#stopPropagation">
            <div class="flex items-center justify-between px-5 py-4 bg-gradient-to-r from-pink-500 to-pink-600 rounded-t-xl">
              <h3 class="text-lg font-semibold text-white">Review this pay</h3>
              <button type="button" data-action="click->pay-confirm#closeAll" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <div class="px-5 py-4 space-y-3 max-h-[55vh] overflow-y-auto">
              <div data-pay-confirm-target="summaryList" class="divide-y divide-gray-100"></div>
              <div class="flex items-center justify-between pt-2 border-t-2 border-gray-200 text-sm">
                <span class="font-semibold text-gray-900">Total</span>
                <span class="font-bold text-gray-900 tabular-nums" data-pay-confirm-target="summaryTotal">$0.00</span>
              </div>
            </div>
            <div class="px-5 py-3 border-t border-gray-200 space-y-3">
              <p class="text-xs text-gray-500" data-pay-confirm-target="timing"></p>
              <label class="flex items-start gap-2 cursor-pointer">
                <input type="checkbox" data-pay-confirm-target="ack" data-action="change->pay-confirm#ackChanged"
                       class="mt-0.5 h-4 w-4 rounded border-gray-300 text-pink-600 focus:ring-pink-500 accent-pink-500">
                <span class="text-sm text-gray-700">I've reviewed this and want to add it to the pay run.</span>
              </label>
              <div class="flex items-center justify-end gap-2">
                <%= render "shared/button", text: "Go back", variant: "secondary", size: "small", type: :button, data: { action: "click->pay-confirm#closeAll" } %>
                <%= render "shared/button", text: "Add to pay run", variant: "primary", size: "small", type: :button,
                      disabled: true, classes: "disabled:opacity-50 disabled:cursor-not-allowed",
                      data: { action: "click->pay-confirm#confirm", "pay-confirm-target": "confirmButton" } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

  <%# ---- Tips / cash-tips worksheet modal (shared) ---- %>
  <div data-tips-worksheet-target="modal" class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->tips-worksheet#backdropClose keydown.esc@window->tips-worksheet#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl" data-action="click->tips-worksheet#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <h3 class="text-lg font-semibold text-white" data-tips-worksheet-target="title">Tips worksheet</h3>
          <button type="button" class="text-white/70 hover:text-white cursor-pointer" data-action="click->tips-worksheet#close">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="px-5 py-4">
          <p class="text-sm text-gray-500 mb-3">Enter each day's amount; we'll total them for you.</p>
          <div data-tips-worksheet-target="rows" class="space-y-2"></div>
          <button type="button" data-action="click->tips-worksheet#addRow" class="mt-3 text-sm text-pink-600 hover:text-pink-700 cursor-pointer">+ Add a day</button>
        </div>
        <div class="flex items-center justify-between gap-2 px-5 py-3 border-t border-gray-200">
          <span class="text-sm text-gray-600">Total <span data-tips-worksheet-target="subtotal" class="font-semibold text-gray-900">$0.00</span></span>
          <div class="flex items-center gap-2">
            <%= render "shared/button", text: "Cancel", variant: "ghost-cancel", size: "small", type: :button, data: { action: "click->tips-worksheet#close" } %>
            <%= render "shared/button", text: "Use total", variant: "primary", size: "small", type: :button, data: { action: "click->tips-worksheet#useTotal" } %>
          </div>
        </div>
        <template data-tips-worksheet-target="template">
          <div class="flex items-center gap-2" data-row>
            <input type="date" data-cell="date" class="flex-1 px-2 py-1.5 border border-gray-200 rounded text-sm focus:outline-none focus:ring-1 focus:ring-pink-300">
            <div class="relative w-28">
              <span class="absolute left-2 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
              <input type="text" inputmode="decimal" data-cell="amount" data-action="input->tips-worksheet#recalc" placeholder="0" class="w-full pl-5 pr-2 py-1.5 border border-gray-200 rounded text-sm text-right focus:outline-none focus:ring-1 focus:ring-pink-300">
            </div>
            <button type="button" data-action="click->tips-worksheet#removeRow" class="text-gray-400 hover:text-red-500 cursor-pointer px-1" title="Remove">×</button>
          </div>
        </template>
      </div>
    </div>
  </div>

  <%# ---- Help pop-up: what each column means ---- %>
  <%= render layout: "shared/help_modal", locals: { title: "Paying your team" } do %>
    <p class="text-sm text-gray-600 mb-4">Enter what each person earned this pay period. Here's what every column does:</p>
    <dl class="space-y-3 text-sm">
      <div>
        <dt class="font-medium text-gray-900">Rate &amp; Hours</dt>
        <dd class="text-gray-600">Their hourly rate times the hours they worked. Hit <span class="text-pink-600">pull</span> to load hours they submitted and you approved.</dd>
      </div>
      <div>
        <dt class="font-medium text-gray-900">Bonus</dt>
        <dd class="text-gray-600">A one-off extra on top of their hourly pay.</dd>
      </div>
      <div>
        <dt class="font-medium text-gray-900">Reimb.</dt>
        <dd class="text-gray-600">Expenses you're paying back (supplies, mileage). Added to their deposit as-is.</dd>
      </div>
      <div>
        <dt class="font-medium text-gray-900">Tips</dt>
        <dd class="text-gray-600">Tips you're paying out <em>through us</em> — added to the deposit they receive.</dd>
      </div>
      <div>
        <dt class="font-medium text-gray-900">Cash tips</dt>
        <dd class="text-gray-600">Tips they <strong>already took in cash</strong> (their split from the jar). Saved to this pay run's permanent record — for your files and their pay history — but <strong>we don't send this money again</strong>, so it's excluded from the total. Use the worksheet to log which days they came from.</dd>
      </div>
      <div>
        <dt class="font-medium text-gray-900">Total</dt>
        <dd class="text-gray-600">What we'll deposit to their bank — everything above except cash tips.</dd>
      </div>
    </dl>
    <div class="mt-4 pt-4 border-t border-gray-100 text-xs text-gray-500 space-y-1">
      <p>Only staff with a connected bank get paid; the rest are skipped until they connect one.</p>
      <p>Funds are pulled from your bank by ACH and land in staff accounts a few business days later.</p>
