<%
  show = @listing.show
  tickets = @order.tickets.includes(:ticket_tier).to_a
%>
<%# Apple's name is always the whole "Tap to Pay on iPhone" (plain "Tap to Pay" on Android); the app's title bar has room only for the door's. %>
<% content_for :title, turbo_native_app? ? "Work the door" : "#{tap_to_pay_name} · #{@listing.display_title}" %>
<% content_for :door_header do %>
  <%# The app has its own back button. %>
  <% unless turbo_native_app? %>
    <%= link_to door_path(@listing), class: "flex-shrink-0 -ml-2 p-2 rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100", "aria-label": "Back to the door" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
  <% end %>
  <div class="min-w-0 flex-1">
    <div class="text-base font-semibold text-gray-900 leading-tight truncate"><%= @listing.display_title %></div>
    <div class="text-xs text-gray-500 truncate"><%= tap_to_pay_name %> · <%= show.date_and_time.strftime("%-l:%M %p") %></div>
  </div>
<% end %>

<%# The door phone, held out for the buyer's card. In the app, bridge--tap-to-pay
    hands the payment to the Stripe Terminal SDK and reports back; this page
    settles the order when it says paid, and watches the order like a
    card-or-phone sale in case Stripe's webhook settles it first. %>
<div data-controller="door-tap bridge--tap-to-pay"
     data-action="door-tap:pay->bridge--tap-to-pay#pay tap-to-pay:done->door-tap#done"
     data-door-tap-status-url-value="<%= door_card_status_path(@listing, token: @order.token) %>"
     data-door-tap-settle-url-value="<%= door_tap_settle_path(@listing, token: @order.token) %>"
     data-door-tap-expires-at-value="<%= @order.expires_at&.iso8601 %>"
     data-bridge--tap-to-pay-payment-value="<%= @payment.to_json %>"
     data-bridge--tap-to-pay-connection-token-url-value="<%= door_tap_connection_token_path(@listing) %>"
     data-bridge--tap-to-pay-location-id-value="<%= @location_id %>"
     data-bridge--tap-to-pay-label-value="<%= @listing.display_title %>"
     data-bridge--tap-to-pay-can-accept-terms-value="<%= @can_accept_terms %>"
     data-bridge--tap-to-pay-door-path-value="<%= door_path(@listing) %>">
  <div data-door-tap-target="waiting" class="rounded-2xl border border-gray-200 bg-white p-5 text-center">
    <div class="text-sm text-gray-600"><%= tickets.group_by(&:ticket_tier).map { |tier, ts| "#{ts.size} × #{tier.name}" }.join(", ") %></div>
    <div class="mt-1 text-4xl font-bold tabular-nums text-gray-900"><%= number_to_currency(@order.total_cents / 100.0) %></div>
    <%# No drawn tap icon: Apple allows none of our own (Tap to Pay 5.5 and its marketing rules). %>
    <%# An Android phone's tap spot is usually on its back (its own tap screen points to it); Android's words never name Apple. %>
    <p class="mt-6 text-base font-medium text-gray-900" data-door-tap-target="prompt"><%= native_android? ? "Hold their card or phone to the back of this phone" : "Hold their card or phone to the top of this iPhone" %></p>
    <p class="mt-1 text-sm text-gray-600"><%= native_android? ? "Contactless card, or a phone or watch wallet" : "Contactless card, Apple Pay or Google Pay" %></p>
    <div class="mt-2 flex justify-center">
      <%= render "shared/button", text: "How to take a tap", variant: "ghost", size: "small", type: :button,
            data: { action: "click->bridge--tap-to-pay#howToTap" } %>
    </div>
    <p class="mt-4 text-sm text-gray-500">Held <span class="tabular-nums" data-door-tap-target="countdown"></span></p>
    <p class="mt-3 hidden text-sm text-red-700" data-door-tap-target="error"></p>
    <%# A receipt either way (Apple 5.10): shown with a payment that wasn't approved. %>
    <div class="mt-4 hidden" data-door-tap-target="declinedReceipt">
      <div class="mx-auto w-36"><%= link_qr_svg(@receipt_url) %></div>
      <p class="mt-1 text-xs text-gray-500">The buyer can scan for a receipt.</p>
    </div>
    <div class="mt-4 flex justify-center gap-2">
      <%# hidden on a wrapper: it loses to the button's own inline-flex. %>
      <div class="hidden" data-door-tap-target="retry">
        <%= render "shared/button", text: "Try again", variant: "primary", size: "medium", type: :button,
              data: { action: "click->door-tap#retry" } %>
      </div>
      <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium",
            path: door_card_cancel_path(@listing, token: @order.token), method: :post %>
    </div>
  </div>

  <div data-door-tap-target="paid" class="hidden rounded-2xl border-2 border-green-300 bg-green-50 p-6 text-center">
    <svg class="mx-auto w-14 h-14 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <p class="mt-3 text-2xl font-semibold text-green-800">Paid</p>
    <p class="mt-1 text-base text-green-800" data-door-tap-target="paidText">Checked in.</p>
    <%# The buyer's receipt (Apple 5.10): scan it with their phone's camera. %>
    <div class="mt-4 rounded-xl bg-white p-3 inline-block">
      <div class="w-36"><%= link_qr_svg(@receipt_url) %></div>
      <p class="mt-1 text-xs text-gray-600">Scan for a receipt</p>
    </div>
    <div class="mt-5 flex justify-center">
      <%= render "shared/button", text: "Back to the door", variant: "primary", size: "large", path: door_path(@listing) %>
    </div>
  </div>

  <div data-door-tap-target="expired" class="hidden rounded-2xl border-2 border-amber-300 bg-amber-50 p-6 text-center">
    <p class="text-xl font-semibold text-amber-800">This sale timed out</p>
    <p class="mt-1 text-sm text-amber-800">Nothing was charged and the seats went back.</p>
    <div class="mt-5 flex justify-center">
      <%= render "shared/button", text: "Start over", variant: "primary", size: "large", path: door_path(@listing) %>
    </div>
  </div>
</div>
