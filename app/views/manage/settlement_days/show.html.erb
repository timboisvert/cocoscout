<% content_for :title, "Settle up · #{@date.strftime('%a, %b %-d')}" %>
<%
  money = ->(cents) { cents.negative? ? "−#{number_to_currency(-cents / 100.0)}" : number_to_currency(cents / 100.0) }
  day = @day
  # A day before the organization's Settle up start date is history: shown,
  # never changed here (SettleUpStart).
  can_change = module_change?(:settle_up) && !day.before_start?
  record = day.record
  tiles = [
    [ "Tickets", money.call(day.shows.sum(&:tickets_cents)), "text-gray-900" ],
    [ "Products and other", money.call(day.shows.sum { |s| s.products_cents + s.other_revenue_cents + s.flat_fee_cents }), "text-gray-900" ],
    [ "Expenses", money.call(day.out_cents), "text-gray-900" ],
    (day.registers.any? ? [ "Bar and register", money.call(day.register_sales_cents), "text-gray-900" ] : nil)
  ].compact
  what = [ (day.shows.empty? ? nil : (day.shows.size == 1 ? "one show" : "#{day.shows.size} shows")),
           (day.registers.any? ? (day.tips.any? ? "the register and its tips" : "the register") : nil) ].compact
  settle_cid = "confirm-settle-day"
  # When the day ends by the organization's clock: "5 am Thursday".
  day_ends_at = SettlementDay.window(day.organization, day.date).end
  day_ends_words = day_ends_at.in_time_zone.then { |t| (t.min.zero? && t.sec.zero? ? t : t + 1.second).strftime("%-l#{':%M' unless (t + 1.second).min.zero?} %P %A").squish }
%>
<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Money", manage_money_index_path ], [ "Settle up", manage_money_settle_up_path ] ],
    text: @date.strftime("%A, %b %-d"),
    links: []
  } %>

  <%# The day picker Home has, to the right of the big date (Tim, 2026-11-03); a phone gets the arrows and the day. %>
  <%
    earlier = manage_money_settle_up_day_path((@prev_date || @date - 1).iso8601)
    later = manage_money_settle_up_day_path((@next_date || @date + 1).iso8601)
    today_path = @date == @today ? nil : manage_money_settle_up_day_path(@today.iso8601)
  %>

  <%# The title and the picker hold their place on every day (Tim, 2026-11-04): the row comes first, the picker never drops under the words on a desktop, and what the day's state has to say sits underneath. %>
  <div class="flex flex-wrap sm:flex-nowrap items-start justify-between gap-3 mb-4">
    <div class="min-w-0 sm:flex-1">
      <h1 class="text-2xl font-bold text-gray-900 coustard-regular"><%= @date.strftime("%A, %B %-d") %></h1>
      <p class="text-sm text-gray-600 mt-1">
        <% if day.any? %>
          <%= what.join(", ").capitalize %>.<% unless day.settled? || day.before_start? %> Confirm each piece; settling the day puts it on the books and its payouts on the run.<% end %>
        <% else %>
          Nothing with money in it happened this day.
        <% end %>
      </p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <%= render "shared/week_picker", label: @date.strftime("%a, %b %-d, %Y"), months: @calendar_months, pick: :day,
            prev_path: earlier, next_path: later, today_path: today_path, today_text: "Today",
            day_path: ->(d) { manage_money_settle_up_day_path(d.iso8601) }, selected_day: @date, day_statuses: @day_states %>
      <div class="flex sm:hidden items-center gap-2">
        <%= render "shared/button", text: "", icon: "chevron-left", variant: "secondary", size: "small", type: :link, path: earlier, title: "Earlier" %>
        <span class="text-sm font-semibold text-gray-900"><%= @date.strftime("%a, %b %-d, %Y") %></span>
        <%= render "shared/button", text: "", icon: "chevron-right", variant: "secondary", size: "small", type: :link, path: later, title: "Later" %>
        <% if today_path %>
          <%= render "shared/button", text: "Today", variant: "ghost", size: "small", type: :link, path: today_path %>
        <% end %>
      </div>
    </div>
  </div>

  <% if day.before_start? %>
    <%= render "shared/alert_panel",
          eyebrow: "Before Settle up",
          headline: "#{@date.strftime('%A, %B %-d')} is before Settle up started",
          body: "Settle up starts on #{Current.organization.settle_up_starts_on.strftime('%B %-d, %Y')}. Days before it stay as they were: their money is on the books from each show's Financials, and nothing here needs doing.",
          actions: (module_change?(:settle_up) ? [ { text: "Change the start date", variant: "secondary", path: manage_money_settings_section_path(section: "settle_up") } ] : []) %>
  <% elsif day.settled? %>
    <% open_run = PayoutBatch.current_open_draft(Current.organization) %>
    <% on_run = day.shows.sum { |s| s.pay.performers? ? s.pay.rows.count { |r| r.stage.in?(%i[in_draft in_flight]) } : s.pay.payments.count { |p| p.payout_stage.present? } } %>
    <%# Says "the draft payout run" while that's all it is; a run already funding is just "a payout run". %>
    <% on_draft = day.shows.sum { |s| s.pay.performers? ? s.pay.rows.count { |r| r.stage == :in_draft } : s.pay.payments.count { |p| p.payout_stage == :in_draft } } %>
    <%
      settled_words = "#{record.settled_at.strftime('%b %-d at %-l:%M %P')}#{record.settled_by ? " by #{record.settled_by.default_person&.name || record.settled_by.email_address}" : ''}."
      run_words = on_run.positive? ? "#{pluralize(on_run, 'payout')} from this day #{on_run == 1 ? 'is' : 'are'} on #{on_draft == on_run ? 'the draft payout run' : 'a payout run'}." : nil
    %>
    <div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-2.5" id="day-settled">
      <p class="min-w-0 text-sm text-gray-600">
        <svg class="inline-block w-4 h-4 -mt-0.5 mr-1 text-green-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.42l-7.5 7.5a1 1 0 01-1.414 0l-3.5-3.5a1 1 0 111.414-1.42L8.5 12.086l6.79-6.796a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span class="font-semibold text-gray-900">Settled</span>
        <%= settled_words %><% if run_words %> <%= run_words %><% end %><% if record.reopen_reason.present? %> Reopened once: <%= record.reopen_reason %><% end %>
      </p>
      <div class="flex items-center gap-2 shrink-0">
        <% if open_run && on_run.positive? %>
          <%= render "shared/button", text: "The payout run", variant: "secondary", size: "small", type: :link, path: manage_payout_batch_path(open_run) %>
        <% end %>
        <% if can_change %>
          <%= render "shared/button", text: "Reopen this day", variant: "secondary", size: "small", type: :button,
                data: { controller: "modal", action: "click->modal#open", modal_id: "reopen-day" } %>
        <% end %>
      </div>
    </div>
  <% elsif record&.reopened_at %>
    <%= render "shared/alert_panel", tone: :amber,
          eyebrow: "Reopened",
          headline: "Reopened #{record.reopened_at.strftime('%b %-d')}#{record.reopened_by ? " by #{record.reopened_by.default_person&.name || record.reopened_by.email_address}" : ''}",
          body: record.reopen_reason.presence || "Settle it again when it's right." %>
  <% end %>

  <% if day.any? %>
    <div class="grid grid-cols-2 <%= tiles.size >= 5 ? "lg:grid-cols-5" : "lg:grid-cols-4" %> gap-3 mb-6">
      <% tiles.each do |label, value, color| %>
        <div class="rounded-xl border border-gray-200 bg-white px-4 py-3">
          <div class="text-[11px] font-medium uppercase tracking-wide text-gray-500"><%= label %></div>
          <div class="mt-0.5 text-lg font-bold tabular-nums <%= color %>"><%= value %></div>
        </div>
      <% end %>
    </div>
    <%# What the day actually made (Tim, 2026-11-11): under the takings, what
        goes to the shows' people and what is left for the house. %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 -mt-3 mb-6">
      <div class="rounded-xl border border-gray-200 bg-white px-4 py-3">
        <div class="text-[11px] font-medium uppercase tracking-wide text-gray-500">Going to the shows' people</div>
        <div class="mt-0.5 text-lg font-bold tabular-nums text-gray-900"><%= money.call(day.to_people_cents) %></div>
        <div class="text-xs text-gray-500"><%= day.kept_back_cents.positive? ? "After #{money.call(day.kept_back_cents)} they owe for services is kept back" : "Performers and contractors, from these shows" %></div>
      </div>
      <div class="rounded-xl border-2 border-gray-900 bg-white px-4 py-3">
        <div class="text-[11px] font-medium uppercase tracking-wide text-gray-500">The house keeps</div>
        <div class="mt-0.5 text-lg font-bold tabular-nums <%= day.house_keeps_cents.negative? ? 'text-red-700' : 'text-gray-900' %>"><%= money.call(day.house_keeps_cents) %></div>
        <div class="text-xs text-gray-500">Before staff pay. Tips and sales tax aren't in it.</div>
      </div>
    </div>

    <div class="space-y-4">
      <% day.shows.each do |piece| %>
        <%= render "manage/settlement_days/show_piece", piece: piece, day: day, can_change: can_change, open_show_id: @open_show_id, open_modal_id: @open_modal_id %>
      <% end %>

      <% if day.registers.any? %>
        <%= render "manage/settlement_days/register", day: day, registers: day.registers, can_change: can_change %>
      <% end %>

    </div>

    <% if !day.settled? && !day.before_start? %>
<%# Pinned to the bottom (Tim, 2026-11-03/04): one ring, a segment per piece, lit once confirmed, amber while a question holds it, grey until then; what is left; and the one button, which waits until every piece is confirmed. The box keeps its shape whatever the day holds. %>
<%
  checks = day.checks
  left = checks.reject(&:ok?)
  held = left.select(&:held?)
  to_run_words = day.to_run_count.positive? ? " and #{money.call(day.to_run_cents)} for #{pluralize(day.to_run_count, 'person')} on the payout run" : ""
  # The ring: radius 20 in a 48-box, its circumference cut into one arc per piece with a small gap between.
  ring_r = 20.0
  ring_c = 2 * Math::PI * ring_r
  ring_gap = checks.size > 1 ? 3.0 : 0.0
  ring_seg = ring_c / checks.size - ring_gap
%>
<%# The bar at the foot (Tim, 2026-11-14): on a phone the ring and its words
    on one line, and the button the full width under them; from sm up, the
    button at the right. %>
<div class="sticky bottom-0 z-20 mt-6 -mx-4 sm:mx-0 border-t sm:border border-gray-200 bg-white/95 backdrop-blur sm:rounded-xl shadow-[0_-8px_24px_rgba(17,24,39,0.08)] px-4 sm:px-5 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
  <div class="min-w-0 flex items-center gap-4">
    <svg class="w-12 h-12 shrink-0" viewBox="0 0 48 48" role="img" aria-label="<%= day.checked_count %> of <%= checks.size %> pieces confirmed">
      <%# The segments start at twelve o'clock and run clockwise (an SVG circle starts at three; the group turns it back a quarter). %>
      <g transform="rotate(-90 24 24)">
      <% checks.each_with_index do |check, i| %>
        <a href="#<%= check.key %>">
          <title><%= check.name %><%= check.ok? ? ", confirmed" : (check.held? ? ": #{check.hold_reason}" : ", not confirmed yet") %></title>
          <circle cx="24" cy="24" r="<%= ring_r %>" fill="none" stroke-width="5" stroke-linecap="<%= checks.size > 1 ? 'butt' : 'round' %>"
                  class="<%= check.ok? ? 'stroke-pink-500' : (check.held? ? 'stroke-amber-400' : 'stroke-gray-200 hover:stroke-gray-300') %>"
                  stroke-dasharray="<%= ring_seg.round(2) %> <%= (ring_c - ring_seg).round(2) %>" stroke-dashoffset="<%= (-(i * (ring_seg + ring_gap)) - ring_gap / 2).round(2) %>" />
        </a>
      <% end %>
      </g>
      <g>
        <% if day.all_checked? %>
          <path d="M16.5 24.5l5 5L32 18.5" fill="none" class="stroke-pink-500" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <% else %>
          <text x="24" y="25" text-anchor="middle" dominant-baseline="middle" class="fill-gray-700" font-size="12" font-weight="600"><%= day.checked_count %>/<%= checks.size %></text>
        <% end %>
      </g>
    </svg>
    <div class="min-w-0 text-sm">
            <% if day.all_checked? %>
              <div class="font-semibold text-gray-900">Every piece is confirmed<%= day.ended? ? "" : ". The day runs until #{day_ends_words} by the clock; settle it now if the night is done" %></div>
              <div class="text-xs text-gray-500">Settling puts <%= @date.strftime("%b %-d") %> on the books<%= to_run_words %><%= day.tips.any? ? "; the tip shares wait on Pay People" : "" %>. You can reopen it later; the books keep both versions.</div>
            <% else %>
              <div class="font-semibold text-gray-900"><%= day.checked_count %> of <%= checks.size %> confirmed</div>
              <div class="text-xs text-gray-500 line-clamp-2 sm:line-clamp-none">
                <% if held.any? %>
                  <%= held.map { |c| "#{c.name}: #{c.hold_reason.downcase}" }.to_sentence %>.
                <% else %>
                  Still to confirm: <%= left.map(&:name).to_sentence %>.
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
        <% if can_change %>
          <%# The clock doesn't know the night is over; the person at the bar
              does (Tim, 2026-11-11). A day still going can be settled once
              every piece is confirmed, and the modal says what that means. %>
          <% if day.all_checked? %>
            <%= render "shared/button", text: "Settle the day", variant: "primary", size: "medium", type: :button, classes: "w-full sm:w-auto shrink-0",
                  data: { controller: "modal", action: "click->modal#open", modal_id: settle_cid } %>
          <% else %>
            <span class="inline-flex items-center justify-center px-4 py-2 rounded text-sm font-medium bg-gray-200 text-gray-500 cursor-not-allowed w-full sm:w-auto shrink-0" aria-disabled="true" title="Confirm every piece first">Settle the day</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <%= render "shared/empty_state", icon: "calendar", title: "Nothing to settle on #{@date.strftime('%b %-d')}", body: "Days with no shows, no register sales and no door money never need settling." %>
  <% end %>
</div>

<% if can_change && !day.settled? %>
  <%= render "shared/confirm_modal", id: settle_cid,
        title: "Settle #{@date.strftime('%A, %b %-d')}?",
        message: "#{day.ended? ? 'Every piece is confirmed.' : "The day runs until #{day_ends_words} by the clock, so settle now only if the night is done: a sale rung up after this, at the bar or the door, is not in the day until you reopen it."} This closes the day: its numbers go on the books#{day.to_run_count.positive? ? ", and #{money.call(day.to_run_cents)} for #{pluralize(day.to_run_count, 'person')} goes on the draft payout run, which you fund when it's ready" : ''}. You can reopen it later with a reason.",
        confirm_text: "Settle the day",
        url: manage_settle_money_settle_up_day_path(day.param), method: :post %>
<% end %>

<% if can_change && day.settled? %>
  <%# Reopening undoes what settling did, so the modal says so and asks about
      the payouts (Tim, 2026-11-04: "reopening is essentially unsettling it"). %>
  <%
    draft_rows = day.shows.flat_map { |s| s.pay.performers? ? s.pay.rows.select { |r| r.stage == :in_draft } : [] }
    draft_payments = day.shows.flat_map { |s| s.pay.contract? ? s.pay.payments.select { |p| p.payout_stage == :in_draft } : [] }
    draft_count = draft_rows.size + draft_payments.size
    draft_cents = draft_rows.sum(&:cents) + draft_payments.sum { |p| (p.amount.to_d * 100).round }
    tip_shares = day.tips ? day.tips.shares.select(&:payout?) : []
    on_draft = ->(share) { share.payout_contribution&.payout_batch&.open? }
    submitted = ->(share) { share.payout_contribution.present? && !on_draft.call(share) }
    # Tips still to come: waiting on Pay People, or on the draft run.
    tips_back = tip_shares.select { |share| !submitted.call(share) && share.owed_cents.positive? }
    tips_on_draft = tips_back.select(&on_draft)
    # Already paid, which means paid another way or on a run that was
    # submitted (Tim, 2026-11-04): it stays paid, and the modal says who.
    paid_people = day.shows.flat_map do |s|
      pay = s.pay
      if pay.performers? && pay.show_payout
        pay.show_payout.line_items.select(&:paid_or_submitted?).map { |line| [ line.payee_name, (line.net_amount.to_d * 100).round ] }
      elsif pay.contract?
        pay.payments.select { |p| p.status_paid? || p.payout_stage == :in_flight }.map { |p| [ p.contract&.contractor&.name || p.display_name, (p.amount.to_d * 100).round ] }
      else
        []
      end
    end
    paid_people = paid_people.group_by(&:first).map { |name, pairs| [ name, pairs.sum(&:last) ] }.select { |_, cents| cents.positive? }
    tips_paid = tip_shares.filter_map do |share|
      cents = share.paid_cents.to_i + (submitted.call(share) ? share.owed_cents : 0)
      [ share.person.name, cents ] if cents.positive?
    end
  %>
  <div id="reopen-day" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center sm:p-4" data-controller="modal" data-action="click->modal#closeOnBackdrop">
    <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full sm:max-w-md sm:mx-4 overflow-hidden" data-action="click->modal#stopPropagation">
      <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
        <h3 class="text-lg font-semibold text-white">Reopen <%= @date.strftime("%A, %b %-d") %>?</h3>
        <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10" aria-label="Close">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <%= form_with url: manage_reopen_money_settle_up_day_path(day.param), method: :post do %>
        <div class="px-6 py-5 space-y-3 text-sm text-gray-600">
          <p>Reopening undoes what settling did, so the day can change. Its numbers come off the books and go back on, dated <%= @date.strftime("%b %-d") %>, when you settle it again.</p>
          <% if draft_count.positive? %>
            <fieldset class="space-y-2">
              <legend class="font-medium text-gray-700"><%= pluralize(draft_count, "payout") %> from this day, <%= money.call(draft_cents) %>, <%= draft_count == 1 ? "is" : "are" %> on the draft payout run.</legend>
              <label class="flex items-start gap-2 cursor-pointer">
                <input type="radio" name="payouts" value="off" checked class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500">
                <span>Take <%= draft_count == 1 ? "it" : "them" %> off the run, so the pay can change. <%= draft_count == 1 ? "It goes" : "They go" %> back on when the day settles again.</span>
              </label>
              <label class="flex items-start gap-2 cursor-pointer">
                <input type="radio" name="payouts" value="keep" class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500">
                <span>Leave <%= draft_count == 1 ? "it" : "them" %> on the run. I'm changing something else, and the pay stays as it is.</span>
              </label>
            </fieldset>
          <% end %>
          <%# The tips are undone with the day, whatever is chosen above: they stop waiting on Pay People, and come off a draft run (Tim, 2026-11-04). %>
          <% if tips_back.any? %>
            <p>Its tips, <%= money.call(tips_back.sum(&:owed_cents)) %> for <%= pluralize(tips_back.size, "person") %>, <%= tips_on_draft.any? ? (tips_on_draft.size == tips_back.size ? "come off the draft payout run" : "stop waiting on Pay People or come off the draft payout run") : "stop waiting on Pay People" %> until the day settles again.</p>
          <% end %>
          <% if paid_people.any? || tips_paid.any? %>
            <div>
              <p class="font-medium text-gray-700">Already paid, and staying paid</p>
              <ul class="mt-1 max-h-40 overflow-y-auto space-y-0.5">
                <% paid_people.each do |name, cents| %><li><%= name %>, <%= money.call(cents) %></li><% end %>
                <% tips_paid.each do |name, cents| %><li><%= name %>, <%= money.call(cents) %> in tips</li><% end %>
              </ul>
              <p class="mt-2">If the day then pays someone a different amount, the difference follows them: more owed goes on the next payout run<%= tips_paid.any? ? " (tips wait on Pay People)" : "" %>, and anything overpaid comes out of their next pay.</p>
            </div>
          <% end %>
          <label class="block"><span class="font-medium text-gray-700">Why?</span>
            <input type="text" name="reason" required placeholder="e.g. A count was fixed later" class="mt-1 block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"></label>
        </div>
        <div class="px-6 py-4 bg-gray-50 flex justify-end gap-2">
          <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
          <%= render "shared/button", text: "Reopen the day", variant: "primary", size: "medium", type: :submit %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
