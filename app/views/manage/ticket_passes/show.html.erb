<% content_for :title, @pass.name %>
<%
  money = ->(cents) { number_to_currency(cents.to_i / 100.0) }
  pass_url = tickets_pass_url(org: ticketing_profile.slug, pass: @pass.slug)
  selling = @pass.selling?(Time.current, @rows)
  sold_money = @money_by_listing.values.sum
  remove_id = "confirm-remove-pass-#{@pass.id}"
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Ticketing", manage_ticketing_path ], [ "Passes", manage_ticket_passes_path ] ],
    text: @pass.name,
    links: [ { text: "Edit", path: manage_edit_ticket_pass_path(@pass) } ]
  } %>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_20rem] gap-6">
    <div class="space-y-6 min-w-0">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <% [ [ "Sold", @sold.to_s, "People with this pass" ],
             [ "Left", @remaining.nil? ? "No limit" : @remaining.to_s, "The fewest seats at any show" ],
             [ "Price", money.call(@pass.price_cents), "#{money.call(@pass.separately_cents(@rows))} separately" ],
             [ "Sales", money.call(sold_money), "Before fees and tax" ] ].each do |label, value, note| %>
          <div class="bg-white border border-gray-200 rounded-lg px-4 py-3">
            <div class="text-xs font-medium text-gray-500 uppercase tracking-wide"><%= label %></div>
            <div class="mt-1 text-xl font-bold text-gray-900 tabular-nums"><%= value %></div>
            <div class="text-xs text-gray-500"><%= note %></div>
          </div>
        <% end %>
      </div>

      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">The shows</h2>
          <p class="text-xs text-gray-500 mt-0.5">
            Each show counts its share of every pass: <%= { "regular_price" => "in proportion to its regular price", "even" => "an even share", "custom" => "the share you typed" }[@pass.split] %>.
          </p>
        </div>
        <% if @rows.empty? %>
          <p class="px-5 py-6 text-sm text-gray-500">No shows yet. Edit the pass to add them.</p>
        <% else %>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-xs font-medium text-gray-500 uppercase tracking-wide">
                  <th class="px-5 py-2">Show</th>
                  <th class="px-3 py-2 text-right">Regular</th>
                  <th class="px-3 py-2 text-right">Counts</th>
                  <th class="px-3 py-2 text-right">Seats left</th>
                  <th class="px-5 py-2 text-right">From passes</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% @rows.each_with_index do |row, index| %>
                  <% listing = row.ticket_listing %>
                  <% left = listing.inventory.remaining(tier: row.ticket_tier) %>
                  <tr>
                    <td class="px-5 py-2.5">
                      <%= link_to listing.display_title, manage_ticket_listing_path(listing), class: "font-medium text-gray-900 hover:text-pink-600" %>
                      <div class="text-xs text-gray-500"><%= listing.show.date_and_time.strftime("%a %b %-d, %-l:%M %p") %> · <%= row.ticket_tier.name %></div>
                    </td>
                    <td class="px-3 py-2.5 text-right tabular-nums text-gray-600"><%= money.call(row.ticket_tier.price_cents) %></td>
                    <td class="px-3 py-2.5 text-right tabular-nums font-medium text-gray-900"><%= money.call(@shares[index]) %></td>
                    <td class="px-3 py-2.5 text-right tabular-nums text-gray-600"><%= left.nil? ? "No limit" : left %></td>
                    <td class="px-5 py-2.5 text-right tabular-nums text-gray-900"><%= money.call(@money_by_listing[listing.id]) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    </div>

    <div class="space-y-4">
      <div class="bg-white border border-gray-200 rounded-lg p-4">
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-sm font-semibold text-gray-900">Pass page</h2>
          <span class="inline-flex rounded-md px-1.5 py-0.5 text-xs font-medium <%= selling ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600' %>">
            <%= selling ? "Selling" : (@pass.status == "on_sale" ? "Not selling right now" : @pass.status.humanize) %>
          </span>
        </div>
        <% if @pass.status == "on_sale" && !selling %>
          <p class="mt-1 text-xs text-gray-500">It needs two or more shows, before its first show's online sales close, with none canceled.</p>
        <% end %>
        <div class="mt-3"><%= render "shared/copy_url", url: pass_url, show_qr: true, qr_title: "Scan for the pass" %></div>
      </div>
      <div class="bg-white border border-gray-200 rounded-lg p-4">
        <h2 class="text-sm font-semibold text-gray-900"><%= @pass.tickets.exists? ? "Close this pass" : "Delete this pass" %></h2>
        <p class="mt-1 text-xs text-gray-500"><%= @pass.tickets.exists? ? "It stops selling. Everyone who bought it keeps their tickets." : "Nobody has bought it, so it goes for good." %></p>
        <div class="mt-3">
          <%= render "shared/button", text: (@pass.tickets.exists? ? "Close pass" : "Delete pass"), variant: "secondary", size: "small", type: :button,
                data: { controller: "modal", action: "click->modal#open", modal_id: remove_id } %>
        </div>
      </div>
    </div>
  </div>
</div>
<%= render "shared/confirm_modal", id: remove_id, title: (@pass.tickets.exists? ? "Close #{@pass.name}?" : "Delete #{@pass.name}?"),
      message: (@pass.tickets.exists? ? "It stops selling. Everyone who bought it keeps their tickets." : "Nobody has bought it, so it's deleted for good."),
      confirm_text: (@pass.tickets.exists? ? "Close pass" : "Delete pass"), url: manage_ticket_pass_path(@pass), method: :delete %>
