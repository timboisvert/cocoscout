<%# One choice in a settings card: a bordered box with a radio, a bold line,
    and a sentence under it. The chosen one wears pink with no script.
    Locals: name, value, checked, title, help. %>
<label class="flex items-start gap-3 p-4 border border-gray-200 rounded-lg cursor-pointer transition-colors hover:bg-gray-50 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50">
  <input type="radio" name="<%= name %>" value="<%= value %>" <%= "checked" if checked %> class="h-4 w-4 mt-0.5 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500 cursor-pointer">
  <span class="min-w-0 flex-1">
    <span class="block text-sm font-semibold text-gray-900"><%= title %></span>
    <span class="block text-sm text-gray-600 mt-0.5"><%= help %></span>
  </span>
</label>
