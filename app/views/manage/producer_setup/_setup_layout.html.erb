<%# Standalone first-run layout: no sidebar, no breadcrumbs (there is no
    organization yet to crumb back to) — just the logo, the three-step bar,
    and the step card. %>
<% content_for :title, "Get Started - #{step_name}" %>

<div class="min-h-screen bg-white">
  <div class="flex flex-col items-center pt-6 sm:pt-10 pb-4">
    <%= render "shared/cocoscout_logo", size: :medium %>
    <h1 class="mt-3 text-3xl sm:text-4xl coustard-regular text-pink-500">CocoScout</h1>
  </div>

  <div class="max-w-2xl mx-auto px-4 sm:px-6 pb-12">
    <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

    <%
      setup_steps = [
        { name: "What you're making", path: manage_producer_setup_path },
        { name: "Name", path: manage_producer_setup_name_path },
        { name: "Plan", path: manage_producer_setup_plan_path }
      ]
    %>
    <%= render "shared/wizard_steps", steps: setup_steps, current_index: current_step %>

    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <%= yield %>
    </div>

    <div class="mt-4 text-center">
      <%= button_to "I'll do this later", manage_producer_setup_cancel_path, method: :delete,
            class: "text-sm text-gray-500 hover:text-gray-700 bg-transparent border-0 cursor-pointer underline-offset-2 hover:underline" %>
    </div>
  </div>
</div>
