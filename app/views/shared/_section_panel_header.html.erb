<%# The phone header of one section in a drill-in tabbed page (the tabs
    controller's drill mode): the way back to the list, and the section's
    name. Hidden from sm up, where the tab strip shows. Local: label. %>
<div class="sm:hidden flex items-center gap-3 mb-4" data-section-panel-header>
  <button type="button" data-action="tabs#showList" class="inline-flex items-center gap-1 min-h-[44px] text-sm font-medium text-pink-600 cursor-pointer">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
    Sections
  </button>
  <span class="text-gray-300">/</span>
  <span class="text-sm font-semibold text-gray-900"><%= label %></span>
</div>
