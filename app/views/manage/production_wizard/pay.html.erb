<%
  pays = @wizard_state[:pays_performers].presence || "no"
  chosen_id = @wizard_state[:payout_scheme_id]
  input_classes = "w-full px-3 py-2.5 border border-gray-300 rounded-md text-sm shadow-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
%>
<%= render layout: "manage/production_wizard/wizard_layout", locals: { current_step: :pay, step_name: "Pay" } do %>
  <div class="text-center mb-6">
    <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
      </svg>
    </div>
    <h2 class="text-xl font-bold text-gray-900 coustard-regular">Will performers be paid for this production?</h2>
    <p class="text-gray-600 mt-2">A payout scheme decides how each show's money is split among the people cast in it. You can set this up or change it any time in Money.</p>
  </div>

  <%= form_with url: manage_productions_wizard_save_pay_path, method: :post, local: true, id: "pay-form" do |form| %>
    <div class="space-y-4">
      <!-- No option -->
      <label class="block cursor-pointer">
        <div id="no-pay-option" class="p-4 rounded-lg border-2 transition-colors <%= pays == 'no' ? 'border-pink-500 bg-pink-50' : 'border-gray-200 bg-gray-50' %> hover:border-pink-300">
          <div class="flex items-start">
            <input type="radio" name="pays_performers" value="no"
                   <%= "checked" if pays == 'no' %>
                   class="mt-1 h-4 w-4 text-pink-500 border-gray-300 focus:ring-pink-500 accent-pink-500">
            <div class="ml-3">
              <p class="font-medium text-gray-900">No</p>
              <p class="text-sm text-gray-500 mt-1">Nobody is paid through CocoScout for this production</p>
            </div>
          </div>
        </div>
      </label>

      <!-- Yes option -->
      <label class="block cursor-pointer">
        <div id="yes-pay-option" class="p-4 rounded-lg border-2 transition-colors <%= pays == 'yes' ? 'border-pink-500 bg-pink-50' : 'border-gray-200 bg-gray-50' %> hover:border-pink-300">
          <div class="flex items-start">
            <input type="radio" name="pays_performers" value="yes"
                   <%= "checked" if pays == 'yes' %>
                   class="mt-1 h-4 w-4 text-pink-500 border-gray-300 focus:ring-pink-500 accent-pink-500">
            <div class="ml-3">
              <p class="font-medium text-gray-900">Yes</p>
              <p class="text-sm text-gray-500 mt-1">Pick the payout scheme each show should start from</p>
            </div>
          </div>
        </div>
      </label>

      <!-- Scheme picker (shown when yes is selected) -->
      <div id="pay-scheme-section" class="<%= pays == 'yes' ? '' : 'hidden' %> ml-4 pl-4 border-l-2 border-pink-200 space-y-3">
        <% if @payout_schemes.any? %>
          <div>
            <label for="payout_scheme_id" class="block text-sm font-medium text-gray-700 mb-1">Payout scheme</label>
            <select name="payout_scheme_id" id="payout_scheme_id" class="<%= input_classes %>">
              <option value="" <%= "selected" if chosen_id.blank? %>>I'll set this up later</option>
              <% @payout_schemes.each do |scheme| %>
                <option value="<%= scheme.id %>" <%= "selected" if chosen_id.to_s == scheme.id.to_s %>>
                  <%= scheme.name %><% if scheme.rules_summary.present? %> — <%= scheme.rules_summary %><% end %>
                </option>
              <% end %>
            </select>
          </div>
          <p class="text-sm text-gray-500">
            <%= link_to "Manage payout schemes", manage_money_payout_schemes_path, target: "_blank", rel: "noopener", class: "text-pink-500 hover:text-pink-600 font-medium" %>
            to add or edit schemes.
          </p>
        <% else %>
          <input type="hidden" name="payout_scheme_id" value="">
          <p class="text-sm text-gray-700">You don't have any payout schemes yet — you can set one up after the production is created.</p>
          <p class="text-sm text-gray-500">
            <%= link_to "Start from a preset", manage_presets_money_payout_schemes_path, target: "_blank", rel: "noopener", class: "text-pink-500 hover:text-pink-600 font-medium" %>
            (opens in a new tab).
          </p>
        <% end %>

        <% if act_based_wizard? && !@has_per_act_scheme %>
          <p class="text-sm text-gray-600 flex items-start gap-2">
            <svg class="w-4 h-4 text-pink-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
            <span>Act-based productions usually pay per act —
              <%= link_to "start from the Per-Act preset", manage_presets_money_payout_schemes_path(preset: "per_act"), target: "_blank", rel: "noopener", class: "text-pink-500 hover:text-pink-600 font-medium" %>.
            </span>
          </p>
        <% end %>
      </div>
    </div>

    <div class="mt-8 flex justify-between items-center">
      <%= link_to manage_productions_wizard_roles_path, class: "text-gray-500 hover:text-gray-700 text-sm py-2" do %>
        ← Back
      <% end %>
      <%= render "shared/button", text: "Next", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>

<script>
(function() {
  const noOption = document.getElementById('no-pay-option');
  const yesOption = document.getElementById('yes-pay-option');
  const schemeSection = document.getElementById('pay-scheme-section');

  document.querySelectorAll('input[name="pays_performers"]').forEach(radio => {
    radio.addEventListener('change', function() {
      const yes = this.value === 'yes';
      schemeSection.classList.toggle('hidden', !yes);
      (yes ? yesOption : noOption).classList.add('border-pink-500', 'bg-pink-50');
      (yes ? yesOption : noOption).classList.remove('border-gray-200', 'bg-gray-50');
      (yes ? noOption : yesOption).classList.remove('border-pink-500', 'bg-pink-50');
      (yes ? noOption : yesOption).classList.add('border-gray-200', 'bg-gray-50');
    });
  });
})();
</script>
