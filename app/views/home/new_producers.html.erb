<% content_for :title, "For Producers — CocoScout" %>

<div class="min-h-screen bg-[#f9f9f7]">
  <%= render "shared/marketing/header" %>

  <main class="flex flex-col min-w-full">
    <!-- Hero -->
    <section class="w-full px-6 py-16 sm:py-20 bg-gradient-to-br from-pink-50 via-white to-slate-50">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-pink-100 text-pink-600 px-4 py-2 rounded-full text-sm font-medium mb-8">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
          </svg>
          Free to start · no credit card
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-900 mb-6 coustard-regular leading-tight">
          Everything you need to<br>run your show — free.
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 mb-4 leading-relaxed">
          Scheduling, casting, availability, sign-ups, messaging, contacts, documents, and courses —
          all free for solo producers and small teams. Ready to grow? Upgrade to Pro any time.
        </p>
        <p class="text-sm font-semibold uppercase tracking-wider text-pink-600 mb-10">
          Built by performers &amp; producers, for performers &amp; producers.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <%= render "shared/button", text: "Start Your Production", path: signup_path, variant: "primary", size: "large" %>
          <%= render "shared/button", text: "See Features", path: "#free-features", variant: "secondary", size: "large" %>
        </div>
      </div>
    </section>

    <!-- FREE FEATURES -->
    <section id="free-features" class="w-full bg-white border-t border-slate-200">
      <div class="text-center px-6 py-16 max-w-3xl mx-auto">
        <span class="inline-flex items-center rounded-full bg-green-100 text-green-700 px-3 py-1 text-xs font-semibold uppercase tracking-wide mb-4">Included free</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4 coustard-regular">Everything you need to run your show</h2>
        <p class="text-lg text-slate-600">Replace the spreadsheets, email chains, and group texts with one platform — at no cost.</p>
      </div>

      <%= render "home/producer_feature_block",
        eyebrow: "Shows & Events", reverse: false, carousel_key: "scheduling",
        title: "Schedule every show and rehearsal",
        description: "Build your calendar of shows, rehearsals, and events — recurring or one-off — and keep your whole team in sync.",
        bullets: ["Shows, rehearsals, and every event type", "Recurring events and one-click duplication", "Per-event details, call times, and locations"],
        images: [
          { src: "screenshots/scheduling/1-shows-list.png", alt: "Shows and events list" },
          { src: "screenshots/scheduling/2-show-detail.png", alt: "Show detail" },
          { src: "screenshots/scheduling/3-availability-grid.png", alt: "Availability grid" }
        ] %>

      <%= render "home/producer_feature_block",
        eyebrow: "Casting", reverse: true, carousel_key: "casting-free",
        title: "Cast your show and notify everyone",
        description: "Define roles, build talent pools, collect availability, and assign performers — then notify your cast in a click.",
        bullets: ["Roles and talent pools", "Cast availability tracking", "Assign performers and notify your cast"],
        images: [
          { src: "screenshots/casting/3-org-grid.png", alt: "Casting grid" },
          { src: "screenshots/casting/2-notifications.png", alt: "Cast notifications" }
        ] %>

      <%= render "home/producer_feature_block",
        eyebrow: "Sign-ups", reverse: false, carousel_key: "sign-ups",
        title: "Let people sign up for anything",
        description: "Create sign-up forms for events, track who's coming, and take attendance — no back-and-forth required.",
        bullets: ["Event sign-up forms and waitlists", "Attendance tracking", "Self-service for your community"],
        images: [
          { src: "screenshots/sign-ups/1-sign-up-form.png", alt: "Sign-up form" },
          { src: "screenshots/sign-ups/2-attendance.png", alt: "Attendance tracking" }
        ] %>

      <!-- More free features -->
      <div class="w-full px-6 pt-8 pb-20 bg-gradient-to-br from-pink-50 to-white">
        <div class="max-w-6xl mx-auto">
          <h3 class="text-center text-2xl font-bold text-slate-900 mb-10 coustard-regular">…and everything else your production needs</h3>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <%= render "home/producer_feature_card", icon: "calendar", title: "Cast availability", description: "Collect availability for every show and see who can make it at a glance." %>
            <%= render "home/producer_feature_card", icon: "clipboard", title: "Roles & talent pools", description: "Define the roles you need and organize the people who can fill them." %>
            <%= render "home/producer_feature_card", icon: "chat", title: "Messaging", description: "Send show-wide announcements or targeted messages to keep everyone aligned." %>
            <%= render "home/producer_feature_card", icon: "users", title: "Contacts", description: "Keep your whole directory of people and groups in one place." %>
            <%= render "home/producer_feature_card", icon: "document", title: "Documents", description: "Share handbooks, riders, and agreements with the right people." %>
            <%= render "home/producer_feature_card", icon: "cap", title: "Courses", description: "Sell classes and workshops online — a small fee applies per transaction." %>
          </div>
        </div>
      </div>
    </section>

    <!-- PRO FEATURES -->
    <section id="pro-features" class="w-full bg-slate-900 text-white">
      <div class="text-center px-6 py-16 max-w-3xl mx-auto">
        <span class="inline-flex items-center rounded-full bg-pink-500 text-white px-3 py-1 text-xs font-semibold uppercase tracking-wide mb-4">Upgrade to Pro</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4 coustard-regular">Ready to grow? Add the full toolkit</h2>
        <p class="text-lg text-slate-300">One upgrade — <span class="font-semibold text-white">$20/month or $200/year</span> — unlocks unlimited productions and every module below.</p>
      </div>
    </section>

    <div class="bg-slate-50">
      <%= render "home/producer_feature_block", pro: true,
        eyebrow: "Auditions", reverse: false, carousel_key: "auditions",
        title: "Run in-person & video auditions",
        description: "Build custom audition forms, collect video submissions, schedule live sessions, and review as a team — all in one flow.",
        bullets: ["Custom audition forms with video uploads", "In-person session scheduling", "Team review, voting, and notifications"],
        images: [
          { src: "screenshots/auditions/1-form-builder.png", alt: "Audition form builder" },
          { src: "screenshots/auditions/2-submissions-list.png", alt: "Audition submissions" },
          { src: "screenshots/auditions/3-submission-detail.png", alt: "Submission detail" }
        ] %>

      <%= render "home/producer_feature_block", pro: true,
        eyebrow: "Money & Payments", reverse: true, carousel_key: "money",
        title: "Track revenue and pay your people",
        description: "See financials per show, manage contracts and advances, and pay everyone — performers get paid straight to their bank, on a schedule you set or all at once.",
        bullets: ["Show & production financials", "Pay performers straight to their bank", "Scheduled or one-click payout runs", "Payout schemes, contracts, and advances"],
        images: [
          { src: "screenshots/accounting/1-financial-overview.png", alt: "Financial overview" },
          { src: "screenshots/accounting/2-show-financials.png", alt: "Show financials" },
          { src: "screenshots/payouts/1-dashboard.png", alt: "Payouts dashboard" },
          { src: "screenshots/payouts/2-scheme-setup.png", alt: "Payout scheme setup" }
        ] %>

      <%= render "home/producer_feature_block", pro: true,
        eyebrow: "Casting Tables", reverse: false, carousel_key: "casting-table",
        title: "Cast a whole run of shows at once",
        description: "See every role across every show on one visual board, drag performers into open slots, and spot conflicts instantly.",
        bullets: ["Every show and role in one grid", "Drag-and-drop casting", "Conflict and vacancy detection"],
        images: [
          { src: "screenshots/casting/1-casting-table.png", alt: "Casting table" }
        ] %>

      <%= render "home/producer_feature_block", pro: true,
        eyebrow: "Staffing", reverse: true, carousel_key: "staffing",
        title: "Your whole team — scheduled, onboarded, and paid",
        description: "Build the week's shifts, invite staff to onboard themselves, then pay them for the hours they work — straight to their bank. Fair by design: $5/month per person, only in the months they actually work.",
        bullets: [
          "Weekly shift scheduling by role, with staff availability",
          "Staff onboard themselves and connect their own bank",
          "Pay from an hours grid — 2 free payments a month each, then $1",
          "Nothing to pay for anyone who doesn't work that month"
        ],
        images: [
          { src: "screenshots/scheduling/1-shows-list.png", alt: "Weekly staffing schedule" },
          { src: "screenshots/scheduling/2-show-detail.png", alt: "Shift detail" },
          { src: "screenshots/scheduling/3-availability-grid.png", alt: "Staff availability grid" }
        ] %>

      <!-- More Pro features -->
      <div class="w-full px-6 pt-8 pb-20">
        <div class="max-w-6xl mx-auto">
          <h3 class="text-center text-2xl font-bold text-slate-900 mb-10 coustard-regular">Plus everything else in Pro</h3>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <%= render "home/producer_feature_card", pro: true, icon: "chart", title: "Reports", description: "Revenue, payouts, cast participation, and programming analytics." %>
            <%= render "home/producer_feature_card", pro: true, icon: "sparkles", title: "Unlimited everything", description: "Run unlimited productions and unlimited shows/events every month." %>
            <%= render "home/producer_feature_card", pro: true, icon: "document", title: "Documents & contracts", description: "Send agreements, collect signatures, and keep every contract in one place." %>
          </div>

          <div class="text-center mt-12">
            <%= render "shared/button", text: "See full plan comparison", path: pricing_path, variant: "secondary", size: "medium" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Carousel JavaScript -->
    <script>
      function initCarousels() {
        document.querySelectorAll('[data-carousel]').forEach(function(carousel) {
          if (carousel.dataset.carouselInitialized) return;
          carousel.dataset.carouselInitialized = 'true';

          const slides = carousel.querySelectorAll('.carousel-slide');
          const dots = carousel.querySelectorAll('.carousel-dot');
          const prevBtn = carousel.querySelector('.carousel-prev');
          const nextBtn = carousel.querySelector('.carousel-next');
          let currentIndex = 0;

          function showSlide(index) {
            slides.forEach((slide, i) => {
              if (i === index) {
                slide.classList.remove('hidden', 'absolute', 'inset-0');
              } else {
                slide.classList.add('hidden', 'absolute', 'inset-0');
              }
            });
            dots.forEach((dot, i) => {
              dot.classList.toggle('bg-pink-500', i === index);
              dot.classList.toggle('bg-slate-300', i !== index);
            });
            currentIndex = index;
          }

          if (prevBtn) {
            prevBtn.addEventListener('click', function(e) {
              e.preventDefault();
              showSlide(currentIndex === 0 ? slides.length - 1 : currentIndex - 1);
            });
          }
          if (nextBtn) {
            nextBtn.addEventListener('click', function(e) {
              e.preventDefault();
              showSlide(currentIndex === slides.length - 1 ? 0 : currentIndex + 1);
            });
          }
          dots.forEach(function(dot, index) {
            dot.addEventListener('click', function(e) {
              e.preventDefault();
              showSlide(index);
            });
          });
        });
      }

      document.addEventListener('DOMContentLoaded', initCarousels);
      document.addEventListener('turbo:load', initCarousels);
    </script>

    <!-- CTA -->
    <section class="w-full px-6 py-20 bg-white border-t border-slate-200">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6 coustard-regular">Get started for free</h2>
        <p class="text-lg text-slate-600 mb-10">No credit card required. Start with everything you need, and upgrade to Pro when you're ready.</p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <%= render "shared/button", text: "Start Your Production", path: signup_path, variant: "primary", size: "large" %>
          <%= render "shared/button", text: "Looking to perform instead? →", path: performers_path, variant: "ghost", size: "medium" %>
        </div>
      </div>
    </section>
  </main>

  <%= render "shared/marketing/footer" %>
</div>
