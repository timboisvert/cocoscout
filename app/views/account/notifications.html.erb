<% content_for :title, "Notifications" %>

<div class="w-full">
  <div id="notice-container">
    <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  </div>

  <%# In the app: push notifications on this phone. Turning them on asks
      the phone; turning them off is the phone's Settings' job (apps can't
      switch their own permission off). Shows once the app says where they
      stand. %>
  <% if turbo_native_app? %>
    <div class="hidden bg-white border border-gray-200 rounded-lg overflow-hidden mb-6"
         data-controller="push-settings" data-action="push:status@window->push-settings#update">
      <%= render "shared/section_heading", padding: "px-4 py-3 sm:px-6 sm:py-4", title: "Notifications on this phone" %>
      <div class="p-4 sm:p-6">
        <div class="hidden" data-push-settings-target="state" data-push-state="ask">
          <p class="text-sm font-medium text-gray-700">Off</p>
          <p class="text-sm text-gray-600 mt-1">Turn them on to hear about new messages the moment they arrive.</p>
          <div class="mt-4">
            <%= render "shared/button", text: "Turn on notifications", variant: "primary", size: "medium", type: :button,
                  data: { action: "push-settings#request" } %>
          </div>
        </div>
        <div class="hidden" data-push-settings-target="state" data-push-state="on">
          <p class="text-sm font-medium text-gray-700">On</p>
          <p class="text-sm text-gray-600 mt-1">New messages arrive as notifications on this phone. To turn them off, use <%= native_settings_name %>.</p>
          <div class="mt-4">
            <%= render "shared/button", text: native_android? ? "Open Settings" : "Open iPhone Settings", variant: "secondary", size: "medium", type: :button,
                  data: { action: "push-settings#openSettings" } %>
          </div>
        </div>
        <div class="hidden" data-push-settings-target="state" data-push-state="off">
          <p class="text-sm font-medium text-gray-700">Turned off in <%= native_settings_name %></p>
          <p class="text-sm text-gray-600 mt-1">Turn them back on there to hear about new messages straight away.</p>
          <div class="mt-4">
            <%= render "shared/button", text: native_android? ? "Open Settings" : "Open iPhone Settings", variant: "secondary", size: "medium", type: :button,
                  data: { action: "push-settings#openSettings" } %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# V1.1 plan §9: Messages are people writing to you; Notifications are
      everything automated. Push and Email per group. A group's Push shows
      once its area sends Notifications (NotificationGroups live); Ticketing
      email is the organization's, by plan. %>
  <%= form_with(url: account_notifications_path, method: :patch, data: { turbo: true }) do |f| %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
      <%= render "shared/section_heading", padding: "px-4 py-3 sm:px-6 sm:py-4", title: "Messages" %>
      <p class="px-4 sm:px-6 pt-3 text-sm text-gray-600">People writing to you. A new message always shows in Messages.</p>
      <%= render "account/notification_switch_header" %>
      <%= render "account/notification_switch_row", label: "New messages",
            description: "A push the moment one arrives; email as a digest of what's still unread.",
            push_name: "push[messages]", push_on: Current.user.message_push?,
            email_name: "notifications[message_digest]", email_on: Current.user.message_digest_enabled? %>
    </div>

    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
      <%= render "shared/section_heading", padding: "px-4 py-3 sm:px-6 sm:py-4", title: "Notifications" %>
      <p class="px-4 sm:px-6 pt-3 text-sm text-gray-600">What CocoScout tells you about as things happen. Every one shows in Notifications; choose which also reach your phone or your inbox.</p>
      <%= render "account/notification_switch_header" %>
      <% NotificationGroups::ALL.select { |g| g.section == :yours }.each do |group| %>
        <%= render "account/notification_switch_row", label: group.label, description: group.description,
              push_name: (group.live ? "push[#{group.key}]" : nil), push_on: Current.user.notification_push?(group.key),
              email_name: "email[#{group.key}]", email_on: Current.user.notification_email?(group.key) %>
      <% end %>
    </div>

    <% @ticketing_plans.each do |organization, recipient| %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
        <%= render "shared/section_heading", padding: "px-4 py-3 sm:px-6 sm:py-4", title: "Ticketing at #{organization.name}" %>
        <p class="px-4 sm:px-6 pt-3 text-sm text-gray-600">
          Your organization picks your Ticketing emails. Your plan is <strong class="text-gray-900"><%= TicketingNotifications::PLANS.find { |plan| plan.key == recipient.plan }&.label || "Your own pick" %></strong>, <%= pluralize(recipient.kinds.size, "email") %>.
          <% if organization.manageable_by?(Current.user) %>
            <%= link_to "Change it on Ticketing settings", manage_ticketing_settings_section_path(section: "notifications"), class: "text-pink-600 hover:text-pink-700 font-medium" %>.
          <% end %>
        </p>
        <%= render "account/notification_switch_header" %>
        <% NotificationGroups::ALL.select(&:ticketing?).each do |group| %>
          <%= render "account/notification_switch_row", label: group.label, description: group.description,
                push_name: "push[#{group.key}]", push_on: Current.user.notification_push?(group.key),
                email_name: nil, email_note: "By plan" %>
        <% end %>
      </div>
    <% end %>

    <div class="mb-6">
      <%= render "shared/button", text: "Save", type: :submit, variant: "primary" %>
    </div>
  <% end %>
</div>
