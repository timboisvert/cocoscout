<%# "Send reminders" on a show's payouts page, through the shared draft
    modal: everyone owed for the show who hasn't set up payment, with what
    each is owed; {{recipient_name}} and {{amount}} are filled per person
    when sent (PayoutSetupReminders.send!).
    Locals: id, show, recipients (PayoutSetupReminders::Recipient), draft. %>
<% reachable, unreachable = recipients.partition(&:reachable?) %>
<%= render "shared/send_draft_modal",
      id: id, title: "Remind them to set up payment", submit_text: "Send reminders",
      url: manage_send_payment_reminders_money_show_payout_path(show),
      recipients: reachable.map { |r| { id: r.person.id, name: r.person.name, email: r.email, detail: number_to_currency(r.amount_cents / 100.0) } },
      unreachable: (if unreachable.any?
                      "#{unreachable.map { |r| r.person.name }.to_sentence} #{unreachable.one? ? "doesn't" : "don't"} have a CocoScout login yet, " \
                        "so a reminder can't reach them. Share the setup link or the QR code with them instead."
                    end),
      draft: draft, subject_name: "reminder_subject", body_name: "reminder_body",
      hint: "{{recipient_name}} becomes each person's first name and {{amount}} what they're owed for this show. It arrives as a CocoScout message." %>
