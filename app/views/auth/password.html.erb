<% content_for :title, "Reset your password" %>
<%
  # Two people arrive here: someone who forgot their password, and someone an
  # organization added who never set one (their account has a random
  # password). Same door, so the lede names both. The lifetime quoted is the
  # model's, not a number that can drift.
  expired = @reset_link_expired_or_invalid
  lede =
    if expired
      "We'll email you a link to choose a new password."
    else
      "Forgot it, or never set one because an organization created your account? Same door. Enter your email and we'll send a link to choose a password. The link works for #{password_reset_link_lifetime}."
    end
  back = auth_native_app? ? nil : { text: "Sign in", path: signin_path }
%>
<% notices = capture do %>
  <% if expired %>
    <%= render "shared/auth/notice", kind: :error, title: "That link has expired.",
          body: "Links work for #{password_reset_link_lifetime} and only once. Enter your email and we'll send a fresh one." %>
  <% end %>
<% end %>
<% footer = capture do %>
  Use the email your organization has for you. No email after a few minutes? Check spam, then write to
  <%= mail_to "support@cocoscout.com", class: "underline hover:text-pink-600" %>.
<% end %>

<%= render layout: "shared/auth/shell",
      locals: { title: "Reset your password", lede: lede, notices: notices, footer: footer, back: back }.compact do %>
  <%= form_with url: handle_password_path, class: "space-y-4" do |form| %>
    <div>
      <label for="email_address" class="mb-1.5 block text-sm font-medium text-slate-700">Email address</label>
      <%= form.email_field :email_address,
          required: true,
          autofocus: !auth_native_app?,
          autocomplete: "username",
          autocapitalize: "none",
          placeholder: "you@example.com",
          value: params[:email_address],
          class: auth_input_class %>
    </div>

    <div class="pt-1">
      <%= render "shared/button", text: (expired ? "Email me a new link" : "Email me a link"), variant: "primary", size: "jumbo", type: :submit %>
    </div>
  <% end %>

  <div class="border-t border-slate-200 pt-4 text-center text-sm text-slate-600">
    <%= link_to signin_path, class: "inline-flex items-center gap-1 font-medium text-pink-600 hover:text-pink-700" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Back to sign in
    <% end %>
  </div>
<% end %>
