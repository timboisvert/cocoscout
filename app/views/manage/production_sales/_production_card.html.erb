<%# The Tickets card on a production's page for its production team
    (Tim, 2026-10-16): the next few dates with how each is selling, beside
    the production's link. A manager at Everything gets a Ticket sales button
    and each date links to its sales page; at Numbers there's no button and
    the rows don't link. Locals: production, level (:full or :numbers). %>
<%
  listings = Current.organization.ticket_listings.where(production: production).where.not(status: %w[draft canceled]).joins(:show)
                    .where(shows: { canceled: false }).where("shows.date_and_time >= ?", Time.current.beginning_of_day)
                    .order("shows.date_and_time").limit(4).includes(:show).to_a
  stats = Ticketing::ListingStats.for(listings)
  link_url = short_link_url(code: ShortLink.canonical_for!(production).code)
  full = level == :full
%>
<div class="border border-gray-200 rounded-lg overflow-hidden mb-8 bg-white" data-production-tickets-card>
  <%= render "shared/section_heading", padding: "px-4 py-3", title: "Tickets" do %>
    <%= render "shared/pro_marker" %>
    <% if full %>
      <%= link_to manage_production_sales_path(production) do %>
        <%= render "shared/button", text: "Ticket sales", variant: "secondary", size: "small" %>
      <% end %>
    <% end %>
  <% end %>
  <div class="p-4 grid grid-cols-1 sm:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] gap-4 items-start">
    <div class="min-w-0">
      <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Next up</div>
      <% if listings.empty? %>
        <p class="text-sm text-gray-500 py-2">No dates on sale.</p>
      <% end %>
      <% listings.each_with_index do |listing, i| %>
        <%
          s = stats[listing.id]
          show = listing.show
          seats = s.seats_to_sell
          percent = seats.to_i.positive? ? [ (s.sold_anywhere * 100.0 / seats).round, 100 ].min : nil
          label, classes = ticket_listing_status_badge(listing, s.inventory)
          row_class = "flex items-center gap-3 py-2.5 #{'border-t border-gray-100' unless i.zero?} #{'hover:bg-gray-50 -mx-2 px-2 rounded-md' if full}"
          inner = capture do
        %>
          <div class="flex-shrink-0 w-10 text-center">
            <div class="text-[10px] font-semibold text-pink-600 uppercase"><%= show.date_and_time.strftime("%b") %></div>
            <div class="text-xl font-bold leading-tight text-gray-900"><%= show.date_and_time.day %></div>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-sm text-gray-900">
              <span class="font-semibold tabular-nums"><%= s.sold_anywhere %></span><% if seats %> <span class="text-gray-500">of <%= seats %></span><% end %> sold<% if full && s.comps.positive? %> <span class="text-gray-500">· <%= pluralize(s.comps, "comp") %></span><% end %>
            </div>
            <% if percent %>
              <div class="mt-1 h-1.5 w-full max-w-[10rem] rounded-full bg-gray-100"><div class="h-1.5 rounded-full bg-pink-500" style="width: <%= percent %>%"></div></div>
            <% end %>
          </div>
          <span class="flex-shrink-0 inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium <%= classes %>"><%= label %></span>
        <% end %>
        <% if full %>
          <%= link_to manage_production_sale_path(production, listing), class: row_class do %><%= inner %><% end %>
        <% else %>
          <div class="<%= row_class %>"><%= inner %></div>
        <% end %>
      <% end %>
    </div>
    <%= render "shared/copy_url", url: link_url, layout: :tile, label: "Ticket link", show_qr: true, qr_title: "Scan for tickets" %>
  </div>
  <% if (shared_codes = TicketDiscountCode.shared_for_production(production)).any? %>
    <div class="px-4 pb-4"><%= render "shared/ticketing/shared_codes", codes: shared_codes %></div>
  <% end %>
</div>
