<%# Who can come: the minimum age as radio cards (AgeLimit), "Another age"
    with its number under it, and an optional note about ages. Shared by a
    production's Sales & page tab and a date's Page tab, where the first card
    follows the production. Brings its own radio-card controller.
    Locals: scope (the param prefix), age (what's stored), note, input_class,
    inherit (a date: true), inherited_age (the production's), note_placeholder. %>
<%
  inherit = local_assigns[:inherit] || false
  choice = AgeLimit.choice_for(age, inherit: inherit)
%>
<div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4" data-controller="radio-card">
  <div>
    <h3 class="font-semibold text-gray-900">Ages</h3>
    <p class="text-sm text-gray-600 mt-1">Buyers see it on the ticket page, at checkout, with their tickets and in their emails, and the door sees it too.</p>
  </div>
  <div class="space-y-2">
    <% AgeLimit.choices(inherit: inherit, inherited_age: local_assigns[:inherited_age]).each do |value, title, hint| %>
      <%= render layout: "shared/choice_card", locals: { name: "#{scope}[age_choice]", value: value, selected: choice, title: title, hint: hint } do %>
        <% if value == AgeLimit::OTHER %>
          <div class="flex items-center gap-2">
            <%= number_field_tag "#{scope}[age_other]", (choice == AgeLimit::OTHER ? age : nil), min: AgeLimit::AGES.min, max: AgeLimit::AGES.max,
                  id: "#{scope}_age_other", placeholder: "16", class: "#{input_class} max-w-[6rem]", "aria-label": "Minimum age" %>
            <span class="text-sm text-gray-600">and over</span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <div>
    <label for="<%= scope %>_age_note" class="block text-sm font-medium text-gray-700 mb-1.5">Anything else about ages <span class="font-normal text-gray-500">(optional)</span></label>
    <%= text_field_tag "#{scope}[age_note]", note, id: "#{scope}_age_note", maxlength: 200,
          placeholder: local_assigns[:note_placeholder].presence || "Under 21 welcome with a parent", class: input_class %>
  </div>
</div>
