<%#
  One thing a change touches, as a card. On a phone (Tim's rule: one row,
  then a sheet) the card is a row with what will happen; tapping it opens
  the card's contents as a sheet, so there is one set of fields either way.
  Locals: key, title, intro (optional), summary (the phone row's line)
  Block: the card's contents.
%>
<% body = capture { yield } %>
<section class="bg-white border border-gray-200 rounded-xl" data-touch-section="<%= key %>">
  <button type="button" class="sm:hidden w-full flex items-center gap-3 px-4 py-3.5 text-left min-h-[44px] cursor-pointer"
          data-controller="modal" data-action="click->modal#open" data-modal-id="sheet-<%= key %>">
    <span class="flex-1 min-w-0">
      <span class="block text-[15px] font-semibold text-gray-900"><%= title %></span>
      <span class="block text-[13px] text-gray-600 truncate"><%= summary %></span>
    </span>
    <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </button>
  <div id="sheet-<%= key %>" class="hidden sm:block max-sm:fixed max-sm:inset-0 max-sm:z-50 max-sm:bg-black/45"
       data-controller="modal" data-action="click->modal#closeOnBackdrop">
    <div class="max-sm:absolute max-sm:inset-x-0 max-sm:bottom-0 max-sm:max-h-[85vh] max-sm:flex max-sm:flex-col max-sm:bg-white max-sm:rounded-t-2xl"
         data-action="click->modal#stopPropagation" role="group" aria-label="<%= title %>">
      <div class="sm:hidden mx-auto mt-2.5 h-1.5 w-10 rounded-full bg-gray-300" aria-hidden="true"></div>
      <%= render "shared/section_heading", title: title, intro: local_assigns[:intro] %>
      <div class="px-6 py-2 max-sm:px-4 max-sm:overflow-y-auto">
        <%= body %>
      </div>
      <div class="sm:hidden px-4 pt-3 pb-[calc(env(safe-area-inset-bottom)+16px)] border-t border-gray-100">
        <%= render "shared/button", text: "Done", variant: "primary", size: "medium", type: :button, classes: "w-full", data: { action: "click->modal#close" } %>
      </div>
    </div>
  </div>
</section>
