<% content_for :title, "Payout Runs" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Money", manage_money_index_path],
      ["Payouts", manage_money_payouts_path]
    ],
    text: "Payout Runs",
    links: [
      { text: "New payout run", icon: "banknotes", path: manage_new_payout_batch_path }
    ]
  } %>

  <% org = Current.organization %>

  <%# ---- Money by lifecycle state: where every dollar currently sits.
      Draft → Funding → Waiting on people → Paid out, echoing the badge colors. %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="text-xs text-gray-500 uppercase tracking-wide">In draft</div>
      <div class="mt-1 text-2xl font-bold text-gray-900 tabular-nums"><%= number_to_currency(@money_by_state[:draft] / 100.0) %></div>
      <div class="text-xs text-gray-400 mt-0.5"><%= pluralize(@runs_by_state[:draft], "open run") %> · not submitted yet</div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="text-xs text-gray-500 uppercase tracking-wide">Funding</div>
      <div class="mt-1 text-2xl font-bold text-amber-700 tabular-nums"><%= number_to_currency(@money_by_state[:funding] / 100.0) %></div>
      <div class="text-xs text-gray-400 mt-0.5"><%= pluralize(@runs_by_state[:funding], "run") %> · ACH clearing, pays out automatically</div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="text-xs text-gray-500 uppercase tracking-wide">Waiting on people</div>
      <div class="mt-1 text-2xl font-bold text-blue-700 tabular-nums"><%= number_to_currency(@money_by_state[:waiting] / 100.0) %></div>
      <div class="text-xs text-gray-400 mt-0.5"><%= pluralize(@runs_by_state[:waiting], "partially paid run") %> · funded, needs their bank info</div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="text-xs text-gray-500 uppercase tracking-wide">Paid out</div>
      <div class="mt-1 text-2xl font-bold text-green-700 tabular-nums"><%= number_to_currency(@money_by_state[:paid] / 100.0) %></div>
      <div class="text-xs text-gray-400 mt-0.5">all time, across every run</div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# ---- Main: active runs (need attention or in motion), then history. ---- %>
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between gap-3">
          <h2 class="font-semibold text-gray-900">Active runs</h2>
          <%= link_to "New run", manage_new_payout_batch_path, class: "text-sm font-medium text-pink-600 hover:text-pink-700" %>
        </div>

        <% if @active_batches.any? %>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gray-200 bg-gray-50 text-left text-gray-600">
                  <th class="px-4 py-2.5 font-semibold">Run</th>
                  <th class="px-4 py-2.5 font-semibold">Status</th>
                  <th class="px-4 py-2.5 font-semibold text-right">Total</th>
                  <th class="px-4 py-2.5 font-semibold text-right">People</th>
                  <th class="px-4 py-2.5 font-semibold hidden sm:table-cell">Started by</th>
                  <th class="px-4 py-2.5"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% @active_batches.each do |batch| %>
                  <%= render "manage/payout_batches/run_row", batch: batch %>
                <% end %>
              </tbody>
            </table>
          </div>
        <% elsif @completed_batches.any? %>
          <div class="p-6 text-center text-sm text-gray-500">Nothing in motion — every run is settled.</div>
        <% else %>
          <div class="p-8 text-center">
            <p class="text-gray-600 mb-4">No payout runs yet.</p>
            <div class="inline-block">
              <%= render "shared/button", text: "Run your first payout", variant: "primary", size: "medium", path: manage_new_payout_batch_path %>
            </div>
          </div>
        <% end %>
      </div>

      <% if @completed_batches.any? %>
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <div class="px-5 py-4 border-b border-gray-200">
            <h2 class="font-semibold text-gray-900">Completed runs</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gray-200 bg-gray-50 text-left text-gray-600">
                  <th class="px-4 py-2.5 font-semibold">Run</th>
                  <th class="px-4 py-2.5 font-semibold">Status</th>
                  <th class="px-4 py-2.5 font-semibold text-right">Total</th>
                  <th class="px-4 py-2.5 font-semibold text-right">People</th>
                  <th class="px-4 py-2.5 font-semibold hidden sm:table-cell">Started by</th>
                  <th class="px-4 py-2.5"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% @completed_batches.each do |batch| %>
                  <%= render "manage/payout_batches/run_row", batch: batch %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>

    <%# ---- Sidebar: how runs get funded. (Scheduling UI returns when
        automatic runs ship — manual-only for now.) ---- %>
    <aside class="space-y-6">
      <%= render "manage/funding_source", org: org %>

      <% held_cents = OrgCashEntry.available_cents(org) %>
      <% if held_cents.positive? %>
        <%# The org's share of the money CocoScout holds in its Stripe balance
            (course sales, contract payments, funding credit). This — and only
            this — is what course runs and refunds can draw on. %>
        <div class="bg-white border border-gray-200 rounded-lg p-5">
          <h2 class="text-sm font-semibold text-gray-900 mb-1">Held for you</h2>
          <div class="text-2xl font-bold text-gray-900 tabular-nums"><%= number_to_currency(held_cents / 100.0) %></div>
          <p class="text-sm text-gray-500 mt-1">Course and contract money CocoScout is holding for your organization, including funding credit. Course payout runs and refunds draw on this balance.</p>
        </div>
      <% end %>

      <% credit_cents = PayoutFundingCredit.available_cents(org) %>
      <% if credit_cents.positive? %>
        <%# Money already in the org's Stripe balance from released payees —
            it silently shrinks the next run's debit, so it must be visible or
            the smaller debit looks like an error. %>
        <div class="bg-white border border-green-200 rounded-lg p-5">
          <h2 class="text-sm font-semibold text-gray-900 mb-1">Funding credit</h2>
          <div class="text-2xl font-bold text-green-700 tabular-nums"><%= number_to_currency(credit_cents / 100.0) %></div>
          <p class="text-sm text-gray-500 mt-1">Already in your balance from people released from funded runs (paid another way). It's applied automatically — your next run's bank debit is reduced by this amount.</p>
        </div>
      <% end %>

      <div class="rounded-lg bg-gray-50 border border-gray-200 p-4">
        <p class="text-xs text-gray-500">A run's money moves in one direction: <span class="font-medium text-gray-700">draft</span> (building it up) → <span class="font-medium text-amber-700">funding</span> (ACH debit clearing) → <span class="font-medium text-blue-700">waiting on people</span> (funded; pays each person as they connect a bank) → <span class="font-medium text-green-700">paid out</span>.</p>
      </div>
    </aside>
  </div>
</div>
