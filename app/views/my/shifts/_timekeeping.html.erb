<%# Worker timekeeping: confirm/adjust scheduled hours, log ad-hoc time, and see
    recent unpaid hours. Uses @unconfirmed_shifts, @time_entries, @unpaid_hours,
    @staff_orgs. One shared modal (time-entry-form) handles confirm / add / edit. %>
<% dt = ->(t) { t&.strftime("%Y-%m-%dT%H:%M") } %>

<div class="mb-8" data-controller="modal time-entry-form">
  <div class="flex items-center justify-between gap-3 mb-3">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Your hours</h2>
      <p class="text-sm text-gray-500">
        <span class="font-semibold text-gray-900"><%= number_with_precision(@unpaid_hours, precision: 2, strip_insignificant_zeros: true) %></span>
        unpaid <%= "hour".pluralize(@unpaid_hours) %> logged recently.
      </p>
    </div>
    <%= render "shared/button", text: "Add time", variant: "secondary", size: "small", icon: "plus", type: :button,
          data: { action: "click->modal#open click->time-entry-form#load", "modal-id": "time-entry-modal",
                  mode: "manual", url: my_time_entries_path, method: "post", title: "Add time you worked" } %>
  </div>

  <%# Past shifts still to confirm %>
  <% if @unconfirmed_shifts.any? %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 p-3 mb-3">
      <div class="text-sm font-medium text-amber-900 mb-2">Confirm your hours from these shifts</div>
      <div class="space-y-2">
        <% @unconfirmed_shifts.each do |a| %>
          <% s = a.shift %>
          <div class="flex items-center justify-between gap-3 bg-white border border-amber-200 rounded-lg px-3 py-2">
            <div class="min-w-0">
              <div class="text-sm font-medium text-gray-900 truncate"><%= s.starts_at.strftime("%a %b %-d") %> · <%= s.role_label %></div>
              <div class="text-xs text-gray-500"><%= s.starts_at.strftime("%-l:%M %p") %>–<%= s.ends_at.strftime("%-l:%M %p") %> · <%= s.organization.name %> · <%= number_with_precision(s.scheduled_hours, precision: 2, strip_insignificant_zeros: true) %>h scheduled</div>
            </div>
            <%= render "shared/button", text: "Confirm", variant: "primary", size: "small", type: :button,
                  data: { action: "click->modal#open click->time-entry-form#load", "modal-id": "time-entry-modal",
                          mode: "confirm", url: my_time_entries_path, method: "post",
                          "assignment-id": a.id, started: dt.call(s.starts_at), ended: dt.call(s.ends_at),
                          title: "Confirm your hours" } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Logged (unpaid) entries %>
  <% if @time_entries.any? %>
    <div class="space-y-2">
      <% @time_entries.each do |e| %>
        <div class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-lg px-3 py-2">
          <div class="min-w-0">
            <div class="text-sm font-medium text-gray-900 truncate">
              <%= e.started_at.strftime("%a %b %-d") %>
              <span class="text-gray-400">·</span>
              <%= number_with_precision(e.hours, precision: 2, strip_insignificant_zeros: true) %>h
              <% if e.source == "manual" %><span class="text-[10px] px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">self-logged</span><% end %>
            </div>
            <div class="text-xs text-gray-500 truncate">
              <%= e.started_at.strftime("%-l:%M %p") %>–<%= e.ended_at.strftime("%-l:%M %p") %>
              <% if e.shift&.role_label.present? %> · <%= e.shift.role_label %><% end %>
              <% if e.notes.present? %> · <%= e.notes %><% end %>
            </div>
          </div>
          <div class="flex items-center gap-1.5 flex-shrink-0">
            <%= render "shared/button", text: "Edit", variant: "outline", size: "small", type: :button,
                  data: { action: "click->modal#open click->time-entry-form#load", "modal-id": "time-entry-modal",
                          mode: "edit", url: my_time_entry_path(e), method: "patch",
                          started: dt.call(e.started_at), ended: dt.call(e.ended_at), notes: e.notes.to_s,
                          title: "Edit your hours" } %>
            <%= render "shared/button", text: "", icon: "trash", variant: "ghost", size: "small",
                  path: my_time_entry_path(e), method: :delete,
                  data: { turbo_confirm: "Remove this time entry?" } %>
          </div>
        </div>
      <% end %>
    </div>
  <% elsif @unconfirmed_shifts.empty? %>
    <p class="text-sm text-gray-400">No hours logged yet. Confirm a shift above or add time you worked.</p>
  <% end %>

  <%# ---- Shared modal: confirm / add / edit ---- %>
  <div id="time-entry-modal" class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->modal#closeOnBackdrop keydown.esc@window->modal#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl" data-action="click->modal#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
          <h3 class="text-base font-semibold text-gray-900" data-time-entry-form-target="title">Log time</h3>
          <%= render "shared/button", text: "", icon: "x-mark", variant: "ghost", size: "small", type: :button,
                data: { action: "click->modal#close" } %>
        </div>
        <%= form_with url: my_time_entries_path, method: :post, data: { "time-entry-form-target": "form" } do %>
          <input type="hidden" name="_method" value="post" data-time-entry-form-target="methodInput">
          <input type="hidden" name="shift_assignment_id" data-time-entry-form-target="assignmentInput">
          <div class="px-5 py-4 space-y-4">
            <div data-time-entry-form-target="orgRow" class="hidden">
              <label class="block text-sm font-medium text-gray-700 mb-1">Organization</label>
              <select name="organization_id" data-time-entry-form-target="orgSelect"
                      class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
                <% @staff_orgs.each do |o| %><option value="<%= o.id %>"><%= o.name %></option><% end %>
              </select>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Started</label>
                <input type="datetime-local" name="started_at" required data-time-entry-form-target="started" data-action="input->time-entry-form#recalc"
                       class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Ended</label>
                <input type="datetime-local" name="ended_at" required data-time-entry-form-target="ended" data-action="input->time-entry-form#recalc"
                       class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
              </div>
            </div>
            <p class="text-sm text-gray-600"><span data-time-entry-form-target="hours" class="font-semibold text-gray-900">0</span> hours</p>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Notes <span class="text-gray-400 font-normal">(optional)</span></label>
              <input type="text" name="notes" data-time-entry-form-target="notes"
                     class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
            </div>
          </div>
          <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
            <%= render "shared/button", text: "Cancel", variant: "ghost-cancel", size: "small", type: :button, data: { action: "click->modal#close" } %>
            <%= render "shared/button", text: "Save hours", variant: "primary", size: "small", type: :submit %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
