<% content_for :title, "Choose your password" %>
<%
  # Opened from the email link. This is both the password reset and how a
  # manager-created account gets its first password, so it talks about the
  # password they'll use from now on, not about "resetting". Setting it signs
  # them in (AuthController#handle_reset).
  back = auth_native_app? ? nil : { text: "Sign in", path: signin_path }
%>
<% notices = capture do %>
  <% if @password_unsuccessfully_reset %>
    <%= render "shared/auth/notice", kind: :error, title: "That password didn't work.",
          body: (@user&.errors&.any? ? @user.errors.full_messages.to_sentence + "." : "Please check it meets the requirements and try again.") %>
  <% end %>
<% end %>
<% footer = capture do %>
  Setting a password signs you out of any other phone or browser. Didn't ask for this email? Close this page and nothing changes.
<% end %>

<%= render layout: "shared/auth/shell",
      locals: { title: "Choose your password",
                lede: "You'll use it to sign in on the web and in the app, so pick something only you would know. Set it once here and we'll take you straight to your shows.",
                notices: notices, footer: footer, back: back }.compact do %>
  <%= form_with url: handle_reset_path(token: params[:token]), method: :post, local: true, class: "space-y-4",
        data: { controller: "password-strength" } do |form| %>
    <%= render "shared/auth/account_row", email: @user.email_address %>

    <%= render "shared/auth/password_field", form: form, strength: true, autocomplete: "new-password",
          error: @user&.errors&.[](:password)&.any? || false %>

    <div class="pt-1">
      <%= render "shared/button",
          text: "Set password and sign in",
          variant: "primary",
          size: "jumbo",
          type: :submit,
          disabled: true,
          classes: "!opacity-50 !cursor-not-allowed",
          data: { password_strength_target: "submit" } %>
    </div>
  <% end %>
<% end %>
