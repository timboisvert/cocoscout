<%= render layout: "manage/casting_setup/wizard_layout", locals: { step: :dates, step_name: "Dates" } do %>
  <h2 class="text-xl font-bold text-gray-900 mb-2 coustard-regular">Which dates are cast?</h2>
  <p class="text-gray-600 mb-6">
    <% if @dates.any? %>
      Every date coming up in <%= @production.name %>. Tick the ones you cast people in, and untick any you don't.
    <% else %>
      There is nothing to choose yet.
    <% end %>
  </p>

  <%= render "manage/casting_steps/dates", production: @production, dates: @dates, chosen: @chosen, cast_ids: @cast_ids,
        url: manage_casting_setup_save_dates_path(@production), back_path: manage_casting_setup_roles_path(@production), submit_text: "Next" %>
<% end %>
