<%= render layout: "manage/staffing/staff_wizard/wizard_layout", locals: { current_step: 5, step_name: "Pay" } do %>
  <h2 class="text-xl font-bold text-gray-900 mb-2 coustard-regular">How much do they make?</h2>
  <p class="text-gray-600 mb-6">Their hourly rate. This is what we'll use to calculate pay on a pay run — you can change it anytime.</p>

  <%= form_with url: manage_save_pay_staffing_staff_wizard_path, method: :post, class: "space-y-4" do %>
    <div class="max-w-xs">
      <label class="block text-sm font-medium text-gray-700 mb-1">Hourly rate</label>
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">$</span>
        <%= text_field_tag :hourly_rate, @staff_member.hourly_rate_dollars, inputmode: "decimal", placeholder: "0.00", class: "block w-full pl-7 pr-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
      </div>
      <p class="mt-1 text-xs text-gray-500">Per hour, in dollars.</p>
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-gray-200">
      <%= link_to "← Back", manage_start_staffing_staff_wizard_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
      <%= render "shared/button", text: "Continue", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>
