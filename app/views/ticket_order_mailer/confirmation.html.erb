<%= raw @intro_html %>

<%= render "shared/mailer/when_where", w: @when_where, calendar_url: tickets_order_calendar_url(token: @order.token) %>

<% @tickets.each_with_index do |ticket, index| %>
  <div style="margin: 20px 0; padding: 16px; border: 1px solid #e5e7eb; border-radius: 12px; text-align: center;">
    <div style="font-size: 14px; color: #6b7280;">Ticket <%= index + 1 %> of <%= @tickets.size %> · <%= ticket.ticket_tier.name %></div>
    <%= image_tag attachments["ticket-#{ticket.id}.png"].url, alt: "Ticket QR code", width: 180, height: 180, style: "display: block; margin: 12px auto;" %>
    <div style="font-size: 12px; color: #9ca3af;">Order <%= @order.code %></div>
  </div>
<% end %>

<% if @items.any? %>
  <div style="margin: 20px 0; padding: 16px; border: 1px solid #e5e7eb; border-radius: 12px;">
    <div style="font-size: 14px; font-weight: 600; color: #111827;">Also with this order</div>
    <% @items.each do |item| %>
      <div style="font-size: 14px; color: #374151; margin-top: 6px;"><%= item.quantity %> × <%= item.name %><% if item.description.present? %> <span style="color: #6b7280;">· <%= item.description %></span><% end %></div>
    <% end %>
    <div style="font-size: 12px; color: #9ca3af; margin-top: 8px;">Waiting for you at the show. The door has it on your order.</div>
  </div>
<% end %>

<p style="font-size: 12px; color: #6b7280;">
  Order <%= @order.code %> · <%= link_to "View your tickets online", tickets_order_url(token: @order.token) %>
  <% if @stop_url %> · <%= link_to "Stop reminder emails", @stop_url %><% end %>
</p>
