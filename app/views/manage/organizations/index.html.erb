<% content_for :title, "Organizations" %>

<div class="min-h-screen bg-white">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <!-- Header -->
  <div class="flex flex-col items-center pt-6 sm:pt-10 pb-4">
    <%= render "shared/cocoscout_logo", size: :medium %>
    <h1 class="mt-3 text-3xl sm:text-4xl coustard-regular text-pink-500">CocoScout</h1>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">

    <% if @organizations.any? %>
      <!-- Organizations Section -->
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">My Organizations</h2>
        <p class="text-slate-600">Manage your organizations</p>
      </div>

      <div class="flex flex-wrap <%= @organizations.count <= 2 ? 'justify-center' : 'justify-start' %> gap-6 max-w-5xl mx-auto mb-12">
        <% @organizations.each do |org| %>
          <% role = @organization_roles[org.id] %>
          <% is_owner = org.owned_by?(Current.user) %>
          <% is_manager = role == 'manager' %>
          <% can_manage = is_owner || is_manager %>
          <% is_current = Current.organization&.id == org.id %>
          <div class="bg-white <%= is_current ? 'border-2 border-pink-500 ring-2 ring-pink-100' : (is_owner ? 'border-2 border-pink-200' : 'border border-gray-300') %> rounded-lg p-6 hover:shadow-lg transition-shadow w-full sm:w-80">
            <div class="mb-4">
              <div class="flex items-center gap-2 mb-2">
                <h3 class="text-xl font-bold text-gray-900"><%= org.name %></h3>
                <% if is_current %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wide bg-pink-100 text-pink-700">Current</span>
                <% end %>
              </div>
              <% if is_owner %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold bg-pink-500 text-white">
                  Owner
                </span>
              <% elsif role == 'manager' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold bg-blue-600 text-white">
                  Manager
                </span>
              <% elsif role == 'viewer' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold bg-gray-600 text-white">
                  Viewer
                </span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold bg-gray-500 text-white">
                  <%= role.titleize %>
                </span>
              <% end %>
            </div>

            <div class="space-y-2 text-sm text-gray-600 mb-4">
              <div class="flex justify-between">
                <span class="font-medium">Productions:</span>
                <span><%= org.productions.count %></span>
              </div>
              <div class="flex justify-between">
                <span class="font-medium">Team members:</span>
                <span><%= org.team_size %></span>
              </div>
            </div>

            <% unless is_owner %>
              <div class="mb-4 pb-4 border-b border-gray-200 text-xs text-gray-500">
                Owner: <%= org.owner.person&.name || org.owner.email_address %>
              </div>
            <% end %>

            <div class="space-y-2">
              <% if is_current %>
                <div class="w-full text-center px-4 py-3 text-sm bg-pink-50 text-pink-700 border border-pink-200 rounded-lg font-semibold">
                  ✓ Currently selected
                </div>
                <% if can_manage %>
                  <%= render "shared/button", text: "Manage", path: manage_organization_path(org), variant: "primary", size: "jumbo" %>
                <% end %>
              <% else %>
                <%= render "shared/button", text: "Switch to this organization", path: set_organization_path(id: org.id), method: :post, variant: "primary", size: "jumbo" %>
                <% if can_manage %>
                  <%= render "shared/button", text: "Manage", path: manage_organization_path(org), variant: "outline", size: "jumbo" %>
                <% end %>
              <% end %>
              <% unless can_manage %>
                <div class="w-full text-center px-4 py-3 text-sm bg-gray-100 text-gray-500 rounded-lg font-semibold">
                  View only
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Create Another Organization Button -->
      <div class="text-center">
        <p class="text-sm text-slate-600 mb-3">Ready to create another organization?</p>
        <div class="inline-block">
          <%= render "shared/button", text: "Create another organization", path: new_manage_organization_path, variant: "primary", size: "large", icon: "plus" %>
        </div>
      </div>

    <% else %>
      <!-- Empty State - No Organizations -->
      <div class="text-center py-12">
        <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-slate-900 mb-2 coustard-regular">No Organizations Yet</h3>
        <p class="text-slate-600 mb-6 max-w-md mx-auto">
          Create your first organization to start managing productions, casting calls, and your team.
        </p>
        <div class="inline-block">
          <%= render "shared/button", text: "Create Your First Organization", path: new_manage_organization_path, variant: "primary", size: "large", icon: "plus" %>
        </div>
      </div>
    <% end %>

  </div>
</div>
