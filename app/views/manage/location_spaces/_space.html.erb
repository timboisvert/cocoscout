<%# One room in a location's list: its name, its limit, and what's next in it. %>
<% next_show = space.next_show %>
<%= link_to manage_location_space_path(location, space), id: "space_#{space.id}", class: "flex items-center justify-between gap-3 p-4 hover:bg-gray-50 transition-colors" do %>
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2">
      <span class="font-medium text-gray-900"><%= space.name %></span>
      <% if space.default? %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-pink-100 text-pink-700">Default</span>
      <% end %>
    </div>
    <div class="text-sm text-gray-500 mt-0.5">
      <% if space.capacity.to_i.positive? %>Up to <%= number_with_delimiter(space.capacity) %> people<% else %>No limit set<% end %>
      <% if next_show %> · Next: <%= next_show.display_name %>, <%= next_show.date_and_time.strftime("%b %-d") %><% end %>
    </div>
  </div>
  <%= icon("arrow-right", class: "w-5 h-5 text-gray-400 flex-shrink-0") %>
<% end %>
