<%
  input_classes = "px-3 py-2.5 border border-gray-300 rounded-md text-sm shadow-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
  house_percentage = @state[:house_percentage].to_f
  house_percentage = house_percentage.to_i if house_percentage == house_percentage.to_i
  cuts = Array(@state[:individual_allocations]).map { |row| row.to_h.with_indifferent_access }
  cuts_total = cuts.sum { |row| row[:percentage].to_f }
  performer_share = [ 100 - house_percentage - cuts_total, 0 ].max
  performer_share = performer_share.to_i if performer_share == performer_share.to_i
  row_classes = "flex flex-wrap sm:flex-nowrap items-center gap-3 p-3 bg-white border border-gray-200 rounded-lg"
%>
<%= render layout: "manage/payout_calculation_wizard/wizard_layout", locals: { current_step: :before, step_name: "Before performers are paid" } do %>
  <div class="text-center mb-6">
    <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
      </svg>
    </div>
    <h2 class="text-xl font-bold text-gray-900 coustard-regular">What comes off the top?</h2>
    <p class="text-gray-600 mt-2">Before the night's money is split among performers, the house, the expenses and anyone with a cut are taken care of. Leave all of this off if the performers share everything.</p>
  </div>

  <%= form_with url: manage_money_payout_calculation_wizard_save_before_path, method: :post, local: true, id: "before-form" do |form| %>
    <div data-controller="payout-calculation-before" class="space-y-6">
      <div>
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" name="expenses_first" value="1" <%= "checked" if @state[:expenses_first] %>
                 class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
          <span>
            <span class="block text-sm font-medium text-gray-900">Cover the show's expenses first</span>
            <span class="block text-xs text-gray-500 mt-0.5">The show's recorded expenses come out of the money before anyone's percentage is worked out.</span>
          </span>
        </label>
      </div>

      <div>
        <label for="house_percentage" class="block text-sm font-medium text-gray-900 mb-1.5">The house keeps</label>
        <div class="flex items-center gap-3 flex-wrap">
          <div class="flex items-center gap-2">
            <input type="number" id="house_percentage" name="house_percentage" value="<%= house_percentage %>" min="0" max="100" step="0.5"
                   data-payout-calculation-before-target="housePercentage"
                   data-action="input->payout-calculation-before#updatePercentages"
                   class="w-24 <%= input_classes %>">
            <span class="text-gray-500">%</span>
          </div>
          <span class="text-sm text-gray-600">and performers share the other <span data-payout-calculation-before-target="performerPercentage" class="font-medium text-gray-900"><%= performer_share %>%</span></span>
        </div>
        <p class="mt-1.5 text-xs text-gray-500">Set it to 0 if the house takes nothing.</p>
      </div>

      <div>
        <p class="block text-sm font-medium text-gray-900 mb-1">Someone gets a cut off the top</p>
        <p class="text-xs text-gray-500 mb-3">A producer, a host, whoever — a percentage of the night that comes out before the performers' share. Optional.</p>

        <div data-payout-calculation-before-target="cutsList" class="space-y-2">
          <% cuts.each_with_index do |row, index| %>
            <div class="<%= row_classes %>" data-payout-calculation-before-target="cutRow">
              <select name="individual_allocations[<%= index %>][person_id]" class="flex-1 min-w-[10rem] <%= input_classes %>">
                <option value="">Choose a person…</option>
                <% @people.each do |person| %>
                  <option value="<%= person.id %>" <%= "selected" if row[:person_id].to_s == person.id.to_s %>><%= person.name %></option>
                <% end %>
              </select>
              <div class="flex items-center gap-2">
                <input type="number" name="individual_allocations[<%= index %>][percentage]" value="<%= row[:percentage] %>" min="0" max="100" step="0.5"
                       data-payout-calculation-before-target="cutPercentage"
                       data-action="input->payout-calculation-before#updatePercentages"
                       class="w-20 <%= input_classes %>">
                <span class="text-sm text-gray-500">%</span>
              </div>
              <input type="text" name="individual_allocations[<%= index %>][label]" value="<%= row[:label] %>" placeholder="Label (optional)" class="flex-1 min-w-[8rem] <%= input_classes %>">
              <%= render "shared/button", text: "", variant: "ghost", size: "small", type: :button, icon: "x-mark",
                    title: "Remove this cut", classes: "ml-auto text-gray-400 hover:text-red-500",
                    data: { action: "click->payout-calculation-before#removeCut" } %>
            </div>
          <% end %>
        </div>

        <template data-payout-calculation-before-target="cutTemplate">
          <div class="<%= row_classes %>" data-payout-calculation-before-target="cutRow">
            <select name="individual_allocations[__INDEX__][person_id]" class="flex-1 min-w-[10rem] <%= input_classes %>">
              <option value="">Choose a person…</option>
              <% @people.each do |person| %>
                <option value="<%= person.id %>"><%= person.name %></option>
              <% end %>
            </select>
            <div class="flex items-center gap-2">
              <input type="number" name="individual_allocations[__INDEX__][percentage]" value="10" min="0" max="100" step="0.5"
                     data-payout-calculation-before-target="cutPercentage"
                     data-action="input->payout-calculation-before#updatePercentages"
                     class="w-20 <%= input_classes %>">
              <span class="text-sm text-gray-500">%</span>
            </div>
            <input type="text" name="individual_allocations[__INDEX__][label]" value="" placeholder="Label (optional)" class="flex-1 min-w-[8rem] <%= input_classes %>">
            <%= render "shared/button", text: "", variant: "ghost", size: "small", type: :button, icon: "x-mark",
                  title: "Remove this cut", classes: "ml-auto text-gray-400 hover:text-red-500",
                  data: { action: "click->payout-calculation-before#removeCut" } %>
          </div>
        </template>

        <div class="mt-3">
          <% if @people.any? %>
            <%= render "shared/button", text: "Give someone a cut", variant: "secondary", size: "small", type: :button, icon: "plus",
                  data: { action: "click->payout-calculation-before#addCut" } %>
          <% else %>
            <p class="text-xs text-gray-500">Add people to your organization first to give one of them a cut.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="mt-8 flex justify-between items-center">
      <%= link_to wizard_step_link(:amounts), class: "text-gray-500 hover:text-gray-700 text-sm py-2" do %>
        &larr; Back
      <% end %>
      <%= render "shared/button", text: "Next", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>
