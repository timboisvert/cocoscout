<% content_for :title, "Create Contract - #{local_assigns[:step_name] || 'Setup'}" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Contracts", manage_contracts_path]
    ],
    text: "New Contract",
    links: []
  } %>

  <div class="max-w-2xl mx-auto">
    <!-- Progress Steps -->
    <div class="mb-8">
      <div class="flex items-center justify-center">
        <%
          # Settlement-first flow. Schedule merges bookings + preview (internal
          # steps 2 & 3 both read as "Schedule"); Financials comes before
          # everything downstream, and Ticketing only appears once you've said
          # we're the ones selling.
          persisted = defined?(@contract) && @contract.persisted?
          # Normalize the schedule-preview sub-step (3) onto the Schedule node (2).
          current_step = @step == 3 ? 2 : @step
          steps = [
            { num: 2, name: "Schedule", path: persisted ? manage_bookings_contract_wizard_path(@contract) : nil },
            { num: 4, name: "Financials", path: persisted ? manage_payments_contract_wizard_path(@contract) : nil }
          ]
          if persisted && @contract.org_sells_tickets?
            steps << { num: 5, name: "Ticketing", path: manage_ticketing_contract_wizard_path(@contract) }
          end
          steps += [
            { num: 6, name: "Services", path: persisted ? manage_tech_contract_wizard_path(@contract) : nil },
            { num: 7, name: "Documents", path: persisted ? manage_documents_contract_wizard_path(@contract) : nil },
            { num: 8, name: "Review", path: persisted ? manage_review_contract_wizard_path(@contract) : nil }
          ]
          steps.each_with_index { |step, i| step[:display] = i + 1 }
        %>
        <% steps.each_with_index do |step, index| %>
          <% is_current = step[:num] == current_step %>
          <% is_completed = step[:num] < current_step %>
          <% is_clickable = is_completed && step[:path].present? %>
          <div class="flex items-center">
            <% if is_clickable %>
              <%= link_to step[:path], class: "flex items-center" do %>
                <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-medium bg-pink-500 text-white">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="ml-2 text-sm font-medium text-pink-500 hidden sm:inline"><%= step[:name] %></span>
              <% end %>
            <% else %>
              <div class="flex items-center">
                <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-medium <%= is_current ? 'bg-pink-500 text-white' : 'bg-gray-200 text-gray-600' %>">
                  <%= step[:display] %>
                </div>
                <span class="ml-2 text-sm font-medium <%= is_current ? 'text-pink-600' : 'text-gray-500' %> hidden sm:inline"><%= step[:name] %></span>
              </div>
            <% end %>
          </div>

          <% if index < steps.length - 1 %>
            <div class="flex-1 h-0.5 mx-2 <%= step[:num] < current_step ? 'bg-pink-500' : 'bg-gray-200' %>"></div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Step Content -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <%= yield %>
    </div>

    <!-- Cancel Link -->
    <% if defined?(@contract) && @contract.persisted? %>
      <div class="mt-4 text-center">
        <%= link_to "Cancel", manage_cancel_contract_wizard_path(@contract),
            data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to cancel? This draft will be deleted." },
            class: "text-sm text-gray-500 hover:text-gray-700" %>
      </div>
    <% end %>
  </div>
</div>
