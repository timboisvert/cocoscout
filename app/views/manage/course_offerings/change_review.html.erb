<% content_for :title, "Tell students · #{@course_offering.title}" %>
<%
  d = @draft
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  sample = d.registrations.first
  sample_moved = sample && CourseSessionChange.moved(sample).first
  sample_vars = sample_moved && CourseSessionChange.variables(sample, sample_moved)
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Courses", manage_course_offerings_path ], [ @course_offering.title, manage_course_offering_path(@course_offering) ] ],
    text: "Tell students about the change",
    links: []
  } %>

  <%= form_with url: manage_course_offering_change_path(@course_offering), method: :post, class: "max-w-2xl space-y-6" do %>
    <div class="bg-white border border-gray-200 rounded-xl px-6 py-5">
      <h2 class="text-lg font-semibold text-gray-900">A session of <%= @course_offering.title %> moved</h2>
      <p class="text-sm text-gray-600 mt-1">
        <%= pluralize(d.registrations.size, "student") %> registered before it changed. Each gets this email, one per moved session, with the new time and place.
        Nothing goes out until you send it.
      </p>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">The email they'll get</h2>
        <p class="text-sm text-gray-600 mt-1">Words in double braces, like {{first_name}}, {{was}} and {{now}}, are filled in for each person.</p>
      </div>
      <div class="px-6 py-5 space-y-4">
        <div>
          <label for="subject" class="block text-sm font-medium text-gray-700 mb-1.5">Subject</label>
          <%= text_field_tag :subject, d.subject, class: input_class %>
        </div>
        <div>
          <label for="body" class="block text-sm font-medium text-gray-700 mb-1.5">Message</label>
          <%= text_area_tag :body, d.body, rows: 8, class: input_class %>
        </div>
        <% if sample_vars %>
          <div class="rounded-lg bg-gray-50 border border-gray-200 px-4 py-3 text-sm text-gray-700">
            <div class="text-xs font-medium text-gray-500 mb-1">How it reads for <%= sample.person&.name %></div>
            <div class="font-medium text-gray-900"><%= ContentTemplate.interpolate(d.subject, sample_vars) %></div>
            <div class="mt-1"><%= TicketOrderMailer.paragraphs(ContentTemplate.interpolate(d.body, sample_vars)) %></div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Who gets it</h2>
      </div>
      <ul class="divide-y divide-gray-100 max-h-80 overflow-y-auto">
        <% d.registrations.each do |registration| %>
          <li class="px-6 py-2.5 text-sm truncate text-gray-900"><%= registration.person&.name || "No name" %> <span class="text-gray-500"><%= registration.person&.email %></span></li>
        <% end %>
      </ul>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= render "shared/button", text: "Email #{pluralize(d.registrations.size, 'student')}", variant: "primary", size: "medium", type: :submit %>
      <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", path: manage_course_offering_path(@course_offering) %>
    </div>
  <% end %>

  <div class="max-w-2xl mt-6 rounded-lg border border-gray-200 bg-gray-50 px-5 py-4 text-sm text-gray-600 flex flex-wrap items-center justify-between gap-3">
    <span>Already told them another way, or the change is too small to mention?</span>
    <%= render "shared/button", text: "Mark as told, no email", variant: "secondary", size: "small", path: manage_course_offering_change_told_path(@course_offering), method: :post %>
  </div>
</div>
