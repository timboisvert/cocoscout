<%# The manager's words to the buyer, put in the refund (or comp cancellation) email. %>
<div>
  <label for="<%= id %>" class="block text-sm font-medium text-gray-700 mb-1.5">Message to <%= @order.buyer_name.presence || "the buyer" %> <span class="font-normal text-gray-500">(optional)</span></label>
  <%= text_area_tag :buyer_message, nil, id: id, rows: 4, maxlength: 2000, placeholder: "Sorry you can't make it. We hope to see you at another show soon.", class: input_class %>
  <p class="text-xs text-gray-500 mt-1">Goes in the <%= "refund " unless @order.money_path == "none" %>email to <%= @order.buyer_email %>.</p>
</div>
