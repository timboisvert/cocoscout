<%# Goal 3: staffing pay owed (estimate — hours × rate, not performance pay),
    bank setup/confirm, and a little recently-paid history. Uses
    @owed_estimate_cents, @unpaid_hours, @pending_hours, @approved_hours,
    @bank_connected, @paid_entries. %>
<section class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <div class="px-5 py-4 border-b border-gray-200 flex items-center gap-2">
    <svg class="w-5 h-5 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V6m0 12v-2m0-8a9 9 0 110 8"/></svg>
    <h2 class="text-base font-semibold text-gray-900">Getting paid</h2>
  </div>

  <div class="p-5 space-y-4">
    <%# Owed estimate %>
    <div class="rounded-lg bg-gray-50 border border-gray-100 p-4">
      <div class="text-xs font-medium text-gray-500 uppercase tracking-wide">Owed for staffing hours</div>
      <div class="text-3xl font-bold text-gray-900 mt-1 tabular-nums"><%= number_to_currency(@owed_estimate_cents / 100.0) %></div>
      <div class="text-xs text-gray-500 mt-1">
        Estimated from <%= number_with_precision(@unpaid_hours, precision: 2, strip_insignificant_zeros: true) %> unpaid hours ·
        <%= number_with_precision(@pending_hours, precision: 2, strip_insignificant_zeros: true) %>h pending,
        <%= number_with_precision(@approved_hours, precision: 2, strip_insignificant_zeros: true) %>h approved.
        Tips and extras are added at pay time.
      </div>
    </div>

    <%# Bank status %>
    <% if @bank_connected %>
      <div class="flex items-center justify-between gap-3 rounded-lg border border-green-200 bg-green-50 px-3 py-2.5">
        <div class="flex items-center gap-2 text-sm text-green-800">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Bank connected — you're set up to get paid.
        </div>
        <%= link_to "Manage", my_payments_setup_path, class: "text-sm font-medium text-green-700 hover:text-green-800" %>
      </div>
    <% else %>
      <div class="flex items-center justify-between gap-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2.5">
        <div class="text-sm text-amber-900">Connect your bank so we can pay you.</div>
        <%= render "shared/button", text: "Set up bank", variant: "primary", size: "small", path: my_payments_setup_path %>
      </div>
    <% end %>

    <%# Recently paid %>
    <% if @paid_entries.any? %>
      <div>
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Recently paid</div>
        <div class="space-y-1.5">
          <% @paid_entries.first(5).each do |e| %>
            <div class="flex items-center justify-between gap-2 text-sm">
              <span class="text-gray-600"><%= e.started_at.strftime("%b %-d") %> · <%= number_with_precision(e.hours, precision: 2, strip_insignificant_zeros: true) %>h</span>
              <span class="text-gray-400 text-xs">paid <%= e.paid_at.strftime("%b %-d") %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="pt-1">
      <%= link_to "View all my payments →", my_payments_path, class: "text-sm font-medium text-pink-600 hover:text-pink-700" %>
    </div>
  </div>
</section>
