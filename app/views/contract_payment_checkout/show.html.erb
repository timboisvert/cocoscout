<% content_for :title, @invoice ? "Invoice #{@invoice.display_number} from #{@organization.name}" : "Pay #{@organization.name}" %>
<% state = @invoice&.state %>

<div class="min-h-screen bg-gray-50 py-10 px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-6">
      <h1 class="text-3xl coustard-regular text-gray-900">
        <%= state == :paid ? "Paid to" : (@invoice ? "Invoice from" : "Pay") %> <%= @organization.name %>
      </h1>
      <p class="mt-1 text-sm text-gray-600">
        <%= @contract.contractor_name %> · <%= @contract.production_name.presence || @contract.production&.name || "contract payment" %>
      </p>
    </div>

    <% if flash[:alert] %>
      <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-600"><%= flash[:alert] %></p>
      </div>
    <% end %>
    <% if flash[:notice] %>
      <div class="mb-4 p-4 bg-gray-100 border border-gray-200 rounded-lg">
        <p class="text-sm text-gray-700"><%= flash[:notice] %></p>
      </div>
    <% end %>
    <% if @just_paid %>
      <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg flex items-start gap-3">
        <svg class="h-5 w-5 text-green-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
        <p class="text-sm text-green-800">
          Payment received. Thank you, there's nothing else to do.
          <% if @contract.contractor_email.present? %>A receipt is on its way to <%= @contract.contractor_email %>.<% end %>
        </p>
      </div>
    <% end %>

    <% if @invoice %>
      <%= render "shared/invoice_document", document: @invoice.document %>
      <% if state == :void %>
        <p class="mt-4 text-sm text-gray-600 text-center">This invoice was cancelled. Check with <%= @organization.name %> if you think that's a mistake.</p>
      <% end %>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-xl p-6 text-center">
        <div class="text-sm text-gray-500"><%= @payment.display_name %></div>
        <p class="mt-3 text-sm text-gray-600">This payment isn't ready to be paid yet. Check with <%= @organization.name %>.</p>
      </div>
    <% end %>

    <% if state.in?(%i[due overdue]) %>
      <div class="mt-6">
        <% if @payment.collectable_online? %>
          <%# turbo: false so the browser follows the redirect out to Stripe. %>
          <%= render "shared/button", text: "Pay #{number_to_currency(@payment.amount)}",
                variant: "primary", size: "large", classes: "w-full justify-center",
                path: pay_contract_checkout_path(token: @token), method: :post,
                form: { data: { turbo: false } } %>
          <p class="mt-3 text-xs text-gray-400 text-center">Payments are processed securely by Stripe.</p>
          <% if (other_ways = @contract.offline_payment_methods_sentence) %>
            <%# Only what this contract says they may use. Online-only contracts show nothing here. %>
            <p class="mt-2 text-xs text-gray-500 text-center">
              Prefer to pay by <%= other_ways %>? Reach out to <%= @organization.name %> to arrange it.
            </p>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @invoice %>
      <div class="mt-6 flex justify-center">
        <%= link_to pay_contract_invoice_path(token: @token, format: :pdf), target: "_blank", rel: "noopener" do %>
          <%= render "shared/button", text: state == :paid ? "Download receipt (PDF)" : "Download invoice (PDF)",
                variant: "secondary", size: "small", icon: "download", type: :button %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
