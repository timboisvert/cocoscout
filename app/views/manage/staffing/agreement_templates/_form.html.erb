<div class="bg-white rounded-lg border border-gray-200 overflow-hidden border-l-4 border-l-pink-400">
<%= form_with model: agreement_template, url: (agreement_template.persisted? ? manage_staffing_agreement_template_path(agreement_template) : manage_staffing_agreement_templates_path), method: (agreement_template.persisted? ? :patch : :post), class: "space-y-6 p-6", data: { turbo: false } do |f| %>
  <% if agreement_template.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-sm font-medium text-red-800 mb-2">Please fix the following errors:</h3>
      <ul class="text-sm text-red-700 list-disc list-inside">
        <% agreement_template.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <h3 class="text-lg font-medium text-gray-900 mb-4">Agreement Details</h3>
    <div class="space-y-4">
      <div>
        <label for="staff_agreement_template_name" class="block text-sm font-medium text-gray-700 mb-1">
          Agreement Name <span class="text-pink-500">*</span>
        </label>
        <%= f.text_field :name,
            class: "w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500",
            placeholder: "e.g., Standard Staff Agreement" %>
        <p class="mt-1 text-sm text-gray-500">A descriptive name to identify this agreement.</p>
      </div>

      <div>
        <label for="staff_agreement_template_description" class="block text-sm font-medium text-gray-700 mb-1">
          Internal Description
        </label>
        <%= f.text_area :description,
            rows: 2,
            class: "w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500",
            placeholder: "e.g., Use for front-of-house hourly staff" %>
        <p class="mt-1 text-sm text-gray-500">Optional note for your team about when to use this agreement.</p>
      </div>

      <div class="flex items-center gap-3">
        <%= f.check_box :active,
            class: "h-4 w-4 rounded border-gray-300 text-pink-600 focus:ring-pink-500 accent-pink-500" %>
        <%= f.label :active, "Active", class: "text-sm font-medium text-gray-700" %>
        <span class="text-sm text-gray-500">— Inactive agreements won't be offered when onboarding staff.</span>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-6">
    <h3 class="text-lg font-medium text-gray-900 mb-4">Agreement Content</h3>
    <div class="mb-4 p-4 bg-pink-50 border border-pink-200 rounded-lg">
      <h4 class="text-sm font-medium text-pink-800 mb-2">Available Variables</h4>
      <p class="text-sm text-pink-700 mb-2">Use these placeholders in your agreement wording. They're replaced with each staff member's real details when they see the agreement:</p>
      <div class="grid grid-cols-2 gap-2 text-sm">
        <% StaffAgreementTemplate::MERGE_FIELDS.each do |field, label| %>
          <div><code class="bg-pink-100 px-1 rounded">{{<%= field %>}}</code> — <%= label %></div>
        <% end %>
      </div>
    </div>

    <div>
      <label for="staff_agreement_template_content" class="block text-sm font-medium text-gray-700 mb-1">
        Agreement Text <span class="text-pink-500">*</span>
      </label>
      <%= f.rich_text_area :content, class: "w-full min-h-[400px]" %>
      <p class="mt-1 text-sm text-gray-500">Use the toolbar to format with headings, bold, lists, and more.</p>
    </div>

    <% if agreement_template.persisted? %>
      <div class="mt-4">
        <button type="button"
            data-controller="modal" data-action="click->modal#open" data-modal-id="preview-staff-agreement-<%= agreement_template.id %>"
            class="inline-flex items-center gap-2 text-sm text-pink-600 hover:text-pink-700 bg-transparent border-0 cursor-pointer p-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
          Preview with sample data
        </button>
        <p class="mt-1 text-xs text-gray-400">Previews the last saved version.</p>
      </div>
    <% end %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-6 border-t border-gray-200">
    <%= link_to "Cancel", manage_staffing_settings_path, class: "text-sm text-gray-600 hover:text-gray-800" %>
    <%= render "shared/button", text: agreement_template.persisted? ? "Save Changes" : "Create Agreement", type: :submit, variant: "primary" %>
  </div>
<% end %>

<%# Delete lives OUTSIDE the edit form on purpose: the confirm modal renders its
    own method: :delete form, and a nested <form> leaks its _method=delete into
    the edit form — turning "Save Changes" into a destroy. Keep it separate. %>
<% if agreement_template.persisted? %>
  <div class="px-6 pb-6 border-t border-gray-100 pt-4">
    <% if agreement_template.organization_staff_members.empty? %>
      <% del_id = "confirm-delete-staff-agreement-#{agreement_template.id}" %>
      <button type="button"
          data-controller="modal" data-action="click->modal#open" data-modal-id="<%= del_id %>"
          class="text-sm text-pink-600 hover:text-pink-700 bg-transparent border-0 cursor-pointer p-0">Delete agreement</button>
      <%= render "shared/confirm_modal",
          id: del_id,
          title: "Delete agreement?",
          message: "Are you sure you want to delete this staff agreement?",
          confirm_text: "Delete Agreement",
          url: manage_staffing_agreement_template_path(agreement_template),
          method: :delete %>
    <% else %>
      <span class="text-sm text-gray-500">
        Assigned to <%= agreement_template.organization_staff_members.count %> <%= "staff member".pluralize(agreement_template.organization_staff_members.count) %> — cannot delete
      </span>
    <% end %>
  </div>
<% end %>

<%# Preview modal — renders the saved agreement with sample data (merge fields filled in). %>
<% if agreement_template.persisted? %>
  <div id="preview-staff-agreement-<%= agreement_template.id %>"
       class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
       data-controller="modal" data-action="click->modal#closeOnBackdrop">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl mx-4 max-h-[85vh] flex flex-col overflow-hidden"
         data-action="click->modal#stopPropagation">
      <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4 flex-shrink-0">
        <div class="min-w-0">
          <h3 class="text-lg font-semibold text-white truncate"><%= agreement_template.name %></h3>
          <p class="text-xs text-pink-100">Preview with sample data</p>
        </div>
        <button type="button" data-action="click->modal#close"
                class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="px-6 py-5 overflow-y-auto prose prose-sm max-w-none [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:my-1">
        <%= agreement_template.render_content(
              staff_name: "Jordan Rivera",
              organization_name: agreement_template.organization&.name,
              title: "Bartender",
              department: "Front of House",
              start_date: Date.current.strftime("%B %-d, %Y"),
              current_date: Date.current.strftime("%B %-d, %Y")
            ) %>
      </div>
      <div class="px-6 py-3 bg-gray-50 border-t border-gray-200 flex items-center justify-end flex-shrink-0">
        <%= render "shared/button", text: "Close", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
      </div>
    </div>
  </div>
<% end %>
</div>
