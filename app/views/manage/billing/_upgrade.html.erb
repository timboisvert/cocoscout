<%# Rich, sales-oriented upgrade content for a locked Pro feature.
    locals: paywall (hash from PaidFeatureGate::FEATURE_DETAILS), feature (symbol) %>
<div class="upgrade-content">
  <!-- Header (no icon — feature name leads) -->
  <div>
    <div class="inline-flex items-center gap-1.5 rounded-full bg-pink-50 px-2.5 py-0.5 text-xs font-semibold text-pink-700 mb-2">
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
      Pro feature
    </div>
    <h2 class="text-2xl coustard-regular text-gray-900 leading-tight"><%= paywall[:name] %></h2>
    <% if paywall[:subhead].present? %>
      <p class="mt-1.5 text-gray-600"><%= paywall[:subhead] %></p>
    <% end %>
  </div>

  <% if paywall[:description].present? %>
    <p class="mt-5 text-sm text-gray-600 leading-relaxed"><%= paywall[:description] %></p>
  <% end %>

  <!-- Capabilities -->
  <% if paywall[:capabilities].present? %>
    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      <% paywall[:capabilities].each do |cap| %>
        <div class="rounded-xl border border-gray-200 p-4">
          <div class="flex items-center gap-2 mb-1">
            <svg class="w-4 h-4 text-pink-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span class="text-sm font-semibold text-gray-900"><%= cap[:title] %></span>
          </div>
          <p class="text-xs text-gray-500 leading-relaxed"><%= cap[:body] %></p>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if paywall[:outcome].present? %>
    <div class="mt-6 rounded-xl bg-gradient-to-br from-pink-50 to-purple-50 border border-pink-100 p-4">
      <p class="text-sm font-medium text-gray-800">“<%= paywall[:outcome] %>”</p>
    </div>
  <% end %>

  <!-- Pro also includes -->
  <div class="mt-6">
    <div class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Pro also includes</div>
    <ul class="grid gap-1.5 sm:grid-cols-2">
      <% Manage::PaidFeatureGate::PRO_INCLUDES.each do |item| %>
        <li class="flex items-start gap-2 text-sm text-gray-600">
          <svg class="w-4 h-4 text-green-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <span><%= item %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <!-- Pricing + CTA -->
  <div class="mt-7">
    <%= render "manage/billing/pricing_options" %>
    <p class="mt-4 text-center text-xs text-gray-500">
      <%= link_to "Compare all plans", pricing_path, class: "text-pink-600 hover:text-pink-700 font-medium", target: "_blank", rel: "noopener" %>
      · Cancel anytime
    </p>
  </div>
</div>
