<%# The ticket page: what it says and its ages, for every date that doesn't
    have its own. (Fees are on Fees and taxes; the order limit is on Basic info.)
    Locals: setup, production. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  poster = production.safe_poster_variant(:small)
  wide = production.wide_image.attached? ? production.safe_wide_image_variant : nil
%>
<%= form_with model: setup, scope: :production_ticketing, url: manage_update_production_ticketing_path(production, section: "sales"), method: :patch, class: "space-y-6" do |f| %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="page">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">The ticket page</h2>
      <p class="text-sm text-gray-600 mt-1">What buyers read. A box left empty shows the production's own name and description.</p>
    </div>
    <div class="px-6 py-5 space-y-4">
    <div>
      <label for="production_ticketing_title" class="block text-sm font-medium text-gray-700 mb-1.5">Title</label>
      <%= f.text_field :title, placeholder: production.name, class: input_class %>
    </div>
    <div>
      <label for="production_ticketing_page_key" class="block text-sm font-medium text-gray-700 mb-1.5">Address</label>
      <div class="flex flex-wrap items-center gap-x-1 gap-y-1.5">
        <span class="text-sm text-gray-500 break-all"><%= tickets_box_office_url(org: ticketing_profile.slug).sub(%r{\Ahttps?://}, "") %>/</span>
        <%= f.text_field :page_key, placeholder: production.public_key, pattern: "[a-z0-9][a-z0-9\\-]{2,29}", autocapitalize: "none", spellcheck: false,
              class: "#{input_class} sm:w-64 flex-1 sm:flex-none" %>
      </div>
      <p class="text-xs text-gray-500 mt-1.5">Blank means the production's own<%= " (#{production.public_key})" if production.public_key.present? %>. Lowercase letters, numbers and hyphens. Links to the old address keep working.</p>
    </div>
    <div>
      <label for="production_ticketing_description" class="block text-sm font-medium text-gray-700 mb-1.5">Description</label>
      <div data-controller="no-attachments">
        <%= f.rich_text_area :description, placeholder: production.description.to_plain_text.squish.truncate(200), class: "w-full min-h-[150px]" %>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="production_ticketing_door_note" class="block text-sm font-medium text-gray-700 mb-1.5">Doors</label>
        <%= f.text_field :door_note, placeholder: "Doors 30 min before", class: input_class %>
      </div>
      <div>
        <label for="production_ticketing_accessibility_note" class="block text-sm font-medium text-gray-700 mb-1.5">Accessibility</label>
        <%= f.text_field :accessibility_note, placeholder: "Step-free entry", class: input_class %>
      </div>
    </div>
    <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 flex items-center gap-4">
      <% if wide %><%= image_tag wide, alt: "", class: "w-24 h-auto rounded" %><% elsif poster %><%= image_tag poster, alt: "", class: "w-12 h-auto rounded" %><% end %>
      <p class="text-sm text-gray-600 flex-1">
        Images come from the production's Visual Assets: the wide image leads the page, the poster when there isn't one.
        <%= link_to "Open Visual Assets", edit_manage_production_path(production, tab: 1), class: "font-medium text-pink-600 hover:text-pink-700" %>
      </p>
    </div>
    </div>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
    </div>
  </div>

  <%= render "manage/production_ticketings/age_limit_fields", scope: "production_ticketing", age: setup.minimum_age, note: setup.age_note, input_class: input_class, save: true %>
<% end %>
