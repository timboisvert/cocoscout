{
  "settings": {
    "nav": 2
  },
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "/new$",
        "/new/",
        "/edit$",
        "/edit/"
      ],
      "properties": {
        "context": "modal",
        "modal_dismiss_gesture_enabled": false,
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "/staffing/staff/[0-9]+/edit$",
        "/ticketing/shows/[0-9]+/edit/",
        "/casting/tables/[0-9]+/edit/"
      ],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "/my/signups/[^/]+/form$",
        "/my/auditions/[^/]+/form$",
        "/my/questionnaires/[^/]+/form$",
        "/my/courses/[^/]+/register$",
        "/my/profiles/new$",
        "/groups/new$"
      ],
      "properties": {
        "context": "modal",
        "modal_dismiss_gesture_enabled": false,
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "^/select/organization/menu$"
      ],
      "properties": {
        "context": "modal",
        "modal_style": "medium",
        "uri": "hotwire://fragment/web/modal/sheet",
        "fallback_uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "/door/[0-9]+/card/"
      ],
      "properties": {
        "context": "modal",
        "modal_style": "full",
        "modal_dismiss_gesture_enabled": false,
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "/door/[0-9]+$"
      ],
      "properties": {
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "/welcome$",
        "/password$",
        "/reset/"
      ],
      "properties": {
        "context": "default",
        "presentation": "replace_root",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "^/superadmin",
        "^/$",
        "^/for-performers",
        "^/for-producers",
        "^/pricing",
        "^/sketchfest",
        "^/manage/billing",
        "^/manage/organizations/[^/]+/section/billing"
      ],
      "properties": {
        "open_in": "safari"
      }
    },
    {
      "patterns": [
        "/tax-forms/[0-9]+/w9/copy$",
        "/tax-forms/[0-9]+/1099/[0-9]+$",
        "/pay/contract/[^/]+/invoice$",
        "/my/courses/[^/]+/calendar$",
        "/tickets/orders/[^/]+/calendar$",
        "^/rails/active_storage/",
        "/manage/reports/[^/]+\\.csv$",
        "/staffing/taxes/1099s\\.csv$",
        "/courses/[0-9]+/roster\\.csv$",
        "/pay/invoice/[^/]+/invoice$",
        "/manage/money/invoices/[^/]+/pdf",
        "/manage/money/files/[0-9]+",
        "/manage/money/books/statements\\.(pdf|csv)",
        "/manage/money/books/taxes\\.csv",
        "/manage/money/books/bank/rules/export",
        "/manage/ticketing/taxes\\.csv"
      ],
      "properties": {
        "open_in": "document"
      }
    }
  ]
}
