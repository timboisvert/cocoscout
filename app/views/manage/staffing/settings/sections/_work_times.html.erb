<%#
  Work times: which regions of the day this organization staffs by, picked
  from the fixed catalog (StaffingDayParts::STAFFING_DAY_PART_CATALOG). Staff
  mark themselves unavailable "all day" or for one of the regions turned on
  here, and a shift belongs to every region its start time falls in.
  Local from the controller: @day_part_keys — the keys currently on.
%>
<div class="bg-white border border-gray-200 rounded-xl p-6">
  <div class="flex items-center gap-2.5 mb-1">
    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-pink-100 text-pink-600 flex-shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
    </span>
    <h2 class="text-xl text-gray-900 coustard-regular">Work times</h2>
  </div>
  <p class="text-sm text-gray-600">
    The stretches of the day your staff can mark themselves unavailable for.
    Turn on the ones that fit how you schedule — Morning, Afternoon and Evening
    to start, or finer slices like Late morning or Early evening. Scheduling
    reads a shift against every region its start time falls in, and "All day"
    is always there.
  </p>

  <%= form_with url: manage_staffing_settings_path, method: :patch, class: "mt-5 pt-5 border-t border-gray-200" do %>
    <%# Marker param so an all-unchecked submit still routes to this setting. %>
    <%= hidden_field_tag :updating_work_times, "1" %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
      <% StaffingDayParts::STAFFING_DAY_PART_CATALOG.each do |part| %>
        <label class="flex items-start gap-3 cursor-pointer">
          <%= check_box_tag "day_part_keys[]", part["key"], @day_part_keys.include?(part["key"]), id: "day_part_#{part['key']}",
                class: "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
          <span>
            <span class="block text-sm font-medium text-gray-900"><%= part["name"] %></span>
            <span class="block text-xs text-gray-500"><%= Organization.day_part_hours_label(part) %></span>
          </span>
        </label>
      <% end %>
      <label class="flex items-start gap-3 opacity-70">
        <%= check_box_tag "day_part_always_all_day", "1", true, disabled: true,
              class: "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
        <span>
          <span class="block text-sm font-medium text-gray-900">All day</span>
          <span class="block text-xs text-gray-500">Always offered</span>
        </span>
      </label>
    </div>

    <div class="mt-5 flex items-center justify-between gap-4">
      <p class="text-xs text-gray-500">Unchecking everything goes back to Morning, Afternoon and Evening.</p>
      <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
</div>
