<% content_for :title, "Ticketing settings" %>

<%= render layout: "shared/settings_layout", locals: {
  title: "Ticketing settings",
  breadcrumbs: [
    [ "Ticketing", manage_ticketing_path ]
  ],
  sections: sections,
  current: @section,
  # Every tab uses the content space, like Door (Tim, 2026-10-20).
  width: "max-w-5xl"
} do %>
  <% case @section %>
  <% when "page" %>
    <%= render "manage/ticketing_settings/sections/page" %>
  <% when "refunds" %>
    <%= render "manage/ticketing_settings/sections/refunds" %>
  <% when "tax" %>
    <%= render "manage/ticketing_settings/sections/tax" %>
  <% when "notifications" %>
    <%= render "manage/ticketing_settings/sections/notifications" %>
  <% when "door" %>
    <%= render "manage/ticketing_settings/sections/door" %>
  <% when "sharing" %>
    <%= render "manage/ticketing_settings/sections/sharing" %>
  <% when "comps" %>
    <%= render "manage/ticketing_settings/sections/comps" %>
  <% else %>
    <%= render "manage/ticketing_settings/sections/box_office" %>
  <% end %>
<% end %>
