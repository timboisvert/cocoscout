<% content_for :title, "Payout Runs" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Money", manage_money_index_path],
      ["Payouts", manage_money_payouts_path]
    ],
    text: "Payout Runs",
    links: [
      { text: "New payout run", icon: "banknotes", path: manage_new_payout_batch_path }
    ]
  } %>

  <p class="text-sm text-gray-600 mb-6 max-w-2xl">
    Pay everyone who's connected a bank, all at once. You fund the run (ACH or card) and CocoScout
    deposits each person's balance straight to their account.
  </p>

  <% org = Current.organization %>

  <%# ---- Funding source ---- %>
  <div class="bg-white border border-gray-200 rounded-lg p-5 mb-6 max-w-2xl">
    <h2 class="text-sm font-semibold text-gray-900 mb-1">Funding source</h2>
    <p class="text-sm text-gray-500 mb-4">The bank account or card we pull from to fund each payout run before depositing to your people.</p>
    <% if org.funding_payment_method_id.present? %>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11m16-11v11"/></svg>
          </div>
          <div>
            <div class="text-sm font-medium text-gray-900"><%= org.funding_payment_method_label %></div>
            <div class="text-xs text-gray-500"><%= org.funding_payment_method_type == "card" ? "Card" : "Bank account (ACH)" %> · connected</div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <%= render "shared/button", text: "Change", variant: "secondary", size: "small",
                path: manage_connect_payout_funding_path, method: :post %>
          <%= render "shared/button", text: "Remove", variant: "danger", size: "small",
                path: manage_remove_payout_funding_path, method: :delete,
                data: { turbo_confirm: "Remove this funding source? You won't be able to run payouts until you add another." } %>
        </div>
      </div>
    <% else %>
      <div class="rounded-lg border border-amber-200 bg-amber-50 p-3 mb-3">
        <p class="text-sm text-amber-900">Connect a bank or card before you run payouts — that's what we charge to fund each run.</p>
      </div>
      <%= render "shared/button", text: "Connect a bank or card", variant: "primary", size: "small", icon: "banknotes",
            path: manage_connect_payout_funding_path, method: :post %>
    <% end %>
  </div>

  <%# ---- Payout schedule ---- %>
  <div class="bg-white border border-gray-200 rounded-lg p-5 mb-6 max-w-2xl">
    <div class="flex items-start justify-between gap-4 mb-4">
      <div>
        <h2 class="text-sm font-semibold text-gray-900">Payout schedule</h2>
        <p class="text-sm text-gray-500 mt-0.5">
          <% if org.payout_schedule_enabled? %>
            <%= org.payout_schedule_label %> — next run <span class="font-medium text-gray-700"><%= org.next_payout_date.strftime("%A, %b %-d") %></span>.
          <% else %>
            Automatic payouts are off — you run them yourself.
          <% end %>
        </p>
      </div>
    </div>

    <%= form_with url: manage_payout_batch_schedule_path, method: :patch, class: "grid grid-cols-1 sm:grid-cols-2 gap-3 items-end" do %>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Frequency</label>
        <select name="payout_schedule" class="block w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
          <% [ %w[manual Manual], %w[weekly Weekly], %w[monthly Monthly] ].each do |val, label| %>
            <option value="<%= val %>" <%= "selected" if org.payout_schedule == val %>><%= label %></option>
          <% end %>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Funding</label>
        <select name="payout_funding_method" class="block w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
          <option value="ach" <%= "selected" if org.payout_funding_method == "ach" %>>Bank transfer (ACH)</option>
          <option value="card" <%= "selected" if org.payout_funding_method == "card" %>>Card (instant)</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Day of week <span class="text-gray-400">(if weekly)</span></label>
        <select name="weekly_day" class="block w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
          <% Date::DAYNAMES.each_with_index do |name, i| %>
            <option value="<%= i %>" <%= "selected" if (org.payout_schedule == "weekly" ? org.payout_schedule_day : PayoutScheduling::DEFAULT_WEEKLY_DAY) == i %>><%= name %></option>
          <% end %>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Day of month <span class="text-gray-400">(if monthly)</span></label>
        <input type="number" name="monthly_day" min="1" max="28"
               value="<%= org.payout_schedule == 'monthly' ? org.payout_schedule_day : PayoutScheduling::DEFAULT_MONTHLY_DAY %>"
               class="block w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
      </div>
      <div class="sm:col-span-2 flex justify-end">
        <%= render "shared/button", text: "Save schedule", variant: "secondary", size: "small", type: :submit %>
      </div>
    <% end %>
  </div>

  <% if @batches.any? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50 text-left text-gray-600">
            <th class="px-4 py-2.5 font-semibold">Date</th>
            <th class="px-4 py-2.5 font-semibold">Status</th>
            <th class="px-4 py-2.5 font-semibold text-right">Total</th>
            <th class="px-4 py-2.5 font-semibold text-right">People</th>
            <th class="px-4 py-2.5 font-semibold">Started by</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @batches.each do |batch| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2.5">
                <%= link_to batch.created_at.strftime("%b %-d, %Y"), manage_payout_batch_path(batch), class: "text-pink-600 hover:text-pink-700 font-medium" %>
              </td>
              <td class="px-4 py-2.5"><%= render "manage/payout_batches/status_badge", status: batch.status %></td>
              <td class="px-4 py-2.5 text-right tabular-nums"><%= number_to_currency(batch.total_cents / 100.0) %></td>
              <td class="px-4 py-2.5 text-right tabular-nums"><%= batch.items.size %></td>
              <td class="px-4 py-2.5 text-gray-600"><%= batch.created_by&.person&.name || batch.created_by&.email_address || "Scheduled" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-8 text-center">
      <p class="text-gray-600 mb-4">No payout runs yet.</p>
      <div class="inline-block">
        <%= render "shared/button", text: "Run your first payout", variant: "primary", size: "medium", path: manage_new_payout_batch_path %>
      </div>
    </div>
  <% end %>
</div>
