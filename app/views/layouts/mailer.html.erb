<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Coustard:wght@400&display=swap');

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.6;
      color: #333333;
      margin: 0;
      padding: 0;
      background-color: #f5f5f5;
    }
    /* 680 wide with a slim frame: tables in ticketing emails had only 480px
       and wrapped every show name (Tim, 2026-10-12). */
    .email-wrapper {
      max-width: 680px;
      margin: 0 auto;
      background-color: #f5f5f5;
    }
    .logo-container {
      text-align: center;
      padding: 30px 20px 0;
    }
    .logo {
      width: 120px;
      height: auto;
    }
    .email-container {
      background-color: #ffffff;
      padding: 28px 32px;
      margin: 0 16px;
    }
    h1 {
      font-family: 'Coustard', serif;
      color: #ec4899;
      font-size: 22px;
      margin: 0 0 25px 0;
      font-weight: 300;
    }
    p {
      font-size: 15px;
      color: #555555;
      line-height: 1.5;
      margin: 0 0 12px 0;
    }
    ul, ol {
      font-size: 15px;
      color: #555555;
      line-height: 1.5;
      margin: 0 0 12px 0;
      padding-left: 20px;
    }
    li {
      margin-bottom: 6px;
    }
    blockquote {
      border-left: 3px solid #ec4899;
      margin: 12px 0;
      padding-left: 12px;
      color: #666666;
      font-style: italic;
    }
    strong, b {
      font-weight: 600;
    }
    em, i {
      font-style: italic;
    }
    a {
      color: #ec4899;
      text-decoration: underline;
    }
    .footer {
      text-align: center;
      padding: 20px 20px 28px;
    }
    .footer-note {
      font-size: 12px;
      color: #6b7280;
      line-height: 1.5;
      margin: 8px 0 0;
    }
    .footer .footer-note a {
      font-family: inherit;
      font-size: inherit;
      color: #6b7280;
      text-decoration: underline;
      display: inline;
    }
    .footer a {
      color: #ec4899;
      text-decoration: none;
      display: inline-block;
    }
    .wordmark {
      width: 168px;
      height: 28px;
      border: 0;
    }
    /* Phones: most of the screen for the email, and tighter table cells. */
    @media only screen and (max-width: 600px) {
      .email-container { padding: 22px 16px !important; margin: 0 8px !important; }
      .email-container td, .email-container th { padding: 6px 5px !important; font-size: 13px !important; }
      .logo-container { padding-top: 20px !important; }
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <%# CocoScout's cat leads every email but a ticket buyer's, which opens
        straight on the theater's words: no name up top, since email apps
        drop our font (Tim, 2026-10-21). %>
    <div class="logo-container">
      <% if !@storefront_organization && attachments["cocoscout.png"] %>
        <img src="<%= attachments['cocoscout.png'].url %>" alt="CocoScout" class="logo" />
      <% end %>
    </div>

    <div class="email-container">
      <%= yield %>
    </div>

    <%# Who sent it and for whom, where to change what you get, and how to
        reach us (Tim, 2026-10-12). A buyer's footer just credits CocoScout. %>
    <div class="footer">
      <% if @storefront_organization %>
        <p class="footer-note">Tickets by <a href="https://www.cocoscout.com">CocoScout</a></p>
      <% else %>
        <%# An image, not text: email apps drop the Coustard web font. %>
        <a href="https://www.cocoscout.com"><% if attachments["cocoscout_wordmark.png"] %><img src="<%= attachments['cocoscout_wordmark.png'].url %>" alt="CocoScout" width="168" height="28" class="wordmark" /><% else %>CocoScout<% end %></a>
        <p class="footer-note">
          Sent by CocoScout<%= " for #{@footer_organization_name}" if @footer_organization_name.present? %>.
          <a href="<%= @email_settings_url %>">Email settings</a> &middot;
          <a href="mailto:<%= CocoScoutIdentity::EMAIL %>"><%= CocoScoutIdentity::EMAIL %></a>
        </p>
        <p class="footer-note">Get the CocoScout app for your shows, messages and pay, with a buzz when something changes:
          <a href="<%= AppStores::APP_STORE_URL %>">iPhone</a> &middot; <a href="<%= AppStores::PLAY_STORE_URL %>">Android</a></p>
        <p class="footer-note"><%= CocoScoutIdentity::LEGAL_NAME %> &middot; <%= CocoScoutIdentity::ADDRESS_LINES.join(", ") %></p>
      <% end %>
    </div>
  </div>
</body>
</html>
