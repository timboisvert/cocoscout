<%#
  A shift as one line on the week grid: its hours, then who's on it
  ("7:30–9:45 [DP] Dev P.", "5:00–11:00 Ana, Ben", "9:15–11:45 + Staff").
  Pink when it's fully staffed, red when someone can't make it, dashed while
  nobody's on it. Opens the shift's menu (_shift_menu).

  Locals:
    shift
    echo   true on a role the shift also covers: an indigo "also" line that
           opens the same menu (default false)
%>
<%
  echo = local_assigns[:echo]
  standing = shift.shift_assignments.reject(&:declined?).map(&:person)
  declined = shift.shift_assignments.select(&:declined?).map(&:person)
  open_slots = shift.needs_assignment? ? shift.remaining_slots : 0
  tone =
    if echo then "border-indigo-200 bg-indigo-50 text-indigo-900 hover:bg-indigo-100"
    elsif declined.any? then "border-red-300 bg-red-50 text-gray-900 hover:bg-red-100"
    elsif shift.covered_by_renter? then "border-blue-300 bg-blue-50 text-blue-900 hover:bg-blue-100"
    elsif shift.not_needed? then "border-gray-200 bg-gray-50 text-gray-500 hover:bg-gray-100"
    elsif open_slots.zero? then "border-pink-300 bg-pink-50 text-gray-900 hover:bg-pink-100"
    elsif standing.empty? then "border-dashed border-pink-300 bg-white text-pink-700 hover:bg-pink-50"
    else "border-pink-200 bg-white text-gray-900 hover:bg-pink-50"
    end
  names = standing.map { |p| standing.size == 1 ? short_person_name(p) : p.name.to_s.split.first }
  label = [ shift.house_role.name, shift_time_range(shift), shift.shift_assignments.map { |a| a.person.name + (a.declined? ? " (can't make it)" : "") }.join(", ").presence ].compact.join(" · ")
%>
<button type="button" data-action="click->shift-menu#open" data-shift-menu-id-param="shift-menu-<%= shift.id %>" data-shift-chip="<%= shift.id %>"
        class="w-full h-7 flex items-center gap-1 rounded border px-1.5 text-[11px] leading-none text-left cursor-pointer transition-colors <%= tone %>"
        title="<%= echo ? "Also covering for #{label}" : label %>" aria-haspopup="menu">
  <% if echo %><span class="text-[9px] px-1 py-0.5 rounded bg-indigo-200 text-indigo-800 font-semibold flex-shrink-0">also</span><% end %>
  <span class="tabular-nums font-medium flex-shrink-0"><%= shift_compact_range(shift) %></span>
  <% if shift.covered_by_renter? %>
    <span class="truncate">Renter</span>
  <% elsif shift.not_needed? %>
    <span class="truncate italic">Not needed</span>
  <% else %>
    <% declined.first(2).each do |person| %>
      <span class="w-4 h-4 rounded-lg bg-red-200 text-red-700 flex items-center justify-center text-[7px] font-bold flex-shrink-0" title="<%= person.name %> can't make it"><%= person.initials %></span>
    <% end %>
    <% if standing.size == 1 %>
      <% v = standing.first.safe_headshot_variant(:thumb) %>
      <% if v %>
        <%= image_tag v, alt: "", class: "w-4 h-4 rounded-lg object-cover flex-shrink-0" %>
      <% else %>
        <span class="w-4 h-4 rounded-lg bg-gray-200 text-gray-600 flex items-center justify-center text-[7px] font-bold flex-shrink-0"><%= standing.first.initials %></span>
      <% end %>
    <% end %>
    <% if names.any? %>
      <span class="truncate min-w-0"><%= names.first(2).join(", ") %><%= " +#{names.size - 2}" if names.size > 2 %></span>
    <% end %>
    <% if open_slots.positive? && !echo %>
      <span class="text-pink-600 font-semibold flex-shrink-0 <%= 'ml-auto' if names.any? %>"><%= names.any? ? "+#{open_slots}" : "+ Staff" %></span>
    <% end %>
  <% end %>
</button>
