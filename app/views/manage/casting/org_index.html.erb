<% content_for :title, "Casting" %>

<%
  casting_actions = [
    { icon: "table-cells", text: "Casting Tables", description: "Batch cast multiple shows", path: manage_casting_tables_path, locked: !Current.organization&.on_paid_plan?, feature: :casting_table },
    { icon: "calendar", text: "Availability", description: "View availability grid", path: manage_org_availability_path },
    { icon: "users", text: "Roles & Acts", description: "Define positions to fill, or the acts in a running order, and how each production casts", path: manage_casting_roles_path },
    { icon: "user-group", text: "Talent Pool", description: "Manage who can be cast", path: manage_casting_talent_pools_path }
  ]

%>

<div class="w-full" data-controller="linked-highlight">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%= render "shared/module_header",
    title: "Casting",
    actions: casting_actions
  %>

  <%
    casting_guide_body = <<~HTML.html_safe
      <p>Casting is how you decide who performs in each show. At a high level it works like this:</p>
      <ol>
        <li><strong>Choose how each production casts</strong> — by <em>roles</em> (positions you fill, like Host, Player, or Stage Manager) or by <em>acts</em> (a running order — Magic, Variety, Intermission, Clown — where one performer can hold several acts). Set this per production in Casting Settings.</li>
        <li><strong>Define the roles or build the lineup</strong> — every show starts from the production's set, and you can tweak it show by show.</li>
        <li><strong>Build your talent pool</strong> — the people who can be cast. Add them directly or bring them in through auditions.</li>
        <li><strong>Check availability</strong> — see who's free for each date before you assign anyone.</li>
        <li><strong>Assign people</strong> — to roles or acts, show by show, or several shows at once with a casting table.</li>
      </ol>
      <p>There's no single right order — many teams cast directly and never run auditions. Use the parts that fit how you work.</p>
    HTML
  %>
  <%= render "shared/intro_guide",
        guide_key: "casting_intro",
        title: "New to casting in CocoScout?",
        body: casting_guide_body,
        actions: [
          { text: "Roles & Acts", path: manage_casting_roles_path },
          { text: "Build your talent pool", path: manage_casting_talent_pools_path }
        ] %>

  <div class="border-t border-gray-200 pt-4 mt-2" data-controller="casting-filter">
    <%= render "shared/filters/filter_bar", wrapper_data_controller: "filter-select", filter_groups: [
      {
        label: "View",
        filters: [
          { text: "Upcoming", path: manage_casting_path(filter: "upcoming", hide_canceled: @hide_canceled, production: @production_filter), active: @filter == "upcoming" },
          { text: "Past", path: manage_casting_path(filter: "past", hide_canceled: @hide_canceled, production: @production_filter), active: @filter == "past" }
        ]
      },
      { separator: true },
      {
        partial: "shared/filters/production_dropdown_filter",
        locals: {
          label: "Production",
          name: "production",
          options: [{ value: "", text: "All Productions" }] + @productions.map { |p| { value: p.id.to_s, text: p.name, type: p.production_type } },
          selected: @production_filter.to_s,
          data_attributes: {
            action: "change->filter-select#update",
            filter_select_param_value: "production",
            filter_select_filter_value: @filter
          }
        }
      },
      { separator: true },
      {
        partial: "shared/filters/toggle_filter",
        locals: {
          label: "Hide Canceled Events",
          active: @hide_canceled,
          toggle_action: "click->casting-filter#toggle"
        }
      }
    ] %>

    <!-- Show Cast Assignments Section -->
    <div>
      <% if @shows.any? %>
        <div class="space-y-1">
          <% @shows.each do |show| %>
            <%
              production = show.production
              roles = @roles_by_production[production.id] || []
              sign_up_regs = @sign_up_registrations_by_show[show.id] || []
            %>
            <%= render "manage/casting/cast_card",
                       show: show,
                       production: production,
                       title: nil,
                       roles: roles,
                       roles_count: roles.size,
                       people_by_id: @people_by_id,
                       groups_by_id: @groups_by_id,
                       sign_up_registrations: sign_up_regs,
                       show_production: true %>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-sm">No shows with casting enabled in <%= @current_month.strftime("%B %Y") %>.</p>
      <% end %>
    </div>

    <!-- Month Navigation -->
    <div class="flex items-center justify-between mt-6">
      <div>
        <% if @can_go_prev %>
          <%= render "shared/button",
              text: @prev_month.strftime("%B %Y"),
              path: manage_casting_path(month: @prev_month.strftime("%Y-%m-01"), filter: @filter, hide_canceled: @hide_canceled, production: @production_filter),
              variant: "secondary",
              size: "small",
              icon: "chevron-left",
              data: { turbo_prefetch: false } %>
        <% end %>
      </div>
      <div>
        <% if @can_go_next %>
          <%= render "shared/button",
              text: @next_month.strftime("%B %Y"),
              path: manage_casting_path(month: @next_month.strftime("%Y-%m-01"), filter: @filter, hide_canceled: @hide_canceled, production: @production_filter),
              variant: "secondary",
              size: "small",
              icon: "chevron-right",
              data: { turbo_prefetch: false } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
