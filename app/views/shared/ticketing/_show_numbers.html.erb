<%# One show's ticket numbers (Ticketing::ListingStats): tiles, sales by
    ticket type, and discount codes used. The manager's show page and the
    producer view both render it. Locals: stats, read_only (producers see
    sales, not what the organization keeps), comps_modal / outside_modal (ids:
    the Comps and Sold elsewhere tiles open them; nil shows plain tiles). %>
<%
  read_only = local_assigns.fetch(:read_only, false)
  comps_modal = local_assigns[:comps_modal]
  outside_modal = local_assigns[:outside_modal]
  listing = stats.listing
  money = ->(cents) { number_to_currency(cents / 100.0) }
  started = listing.show.date_and_time <= Time.current
  outside = stats.outside_sold
  sold_note = if stats.capacity.to_i.positive?
    "#{((stats.sold + outside) * 100.0 / stats.capacity).round}% full#{', with sales elsewhere' if outside.positive?}"
  else
    "No seat limit"
  end
  # [label, value, note, tint, modal it opens]
  tiles = [
    [ "Sold", stats.capacity ? "#{stats.sold} of #{stats.capacity}" : stats.sold.to_s, sold_note, nil ],
    [ "Ticket sales", money.call(stats.gross_cents), "Before fees and tax", nil ],
    (read_only ? nil : [ "You keep", money.call(stats.net_cents), stats.tax_cents.positive? ? "Plus #{money.call(stats.tax_cents)} tax to pay" : "After fees and refunds", nil ]),
    (started ? [ "Checked in", "#{stats.checked_in} of #{stats.sold}", stats.no_shows.to_i.positive? ? "#{stats.no_shows} didn't come" : "Everyone came", nil ] : nil),
    (stats.products_sold.positive? ? [ "Products", stats.products_sold.to_s, "#{money.call(stats.product_cents)} before tax", "bg-pink-50 border-pink-200" ] : nil),
    [ "Comps", stats.comps.to_s, comps_modal ? "Given away free · give tickets" : "Given away free", stats.comps.positive? ? "bg-blue-50 border-blue-200" : nil, comps_modal ],
    (outside_modal || outside.positive? ? [ "Sold elsewhere", outside.to_s, outside.positive? ? stats.outside_words : "On other sites, off these seats",
                                            outside.positive? ? "bg-violet-50 border-violet-200" : nil, outside_modal ] : nil),
    [ "Refunded", stats.refunded_tickets.to_s, stats.refunded_cents.positive? ? "#{money.call(stats.refunded_cents)} back" : "None", stats.refunded_tickets.positive? ? "bg-amber-50 border-amber-200" : nil ]
  ].compact
  codes = stats.discount_uses
%>
<div class="space-y-6">
  <%# Four tiles sit in one row; five or six go three to a row (3+2, 3+3), so
      none of them is squeezed. Literal class names, so Tailwind sees each. %>
  <div class="grid grid-cols-2 <%= tiles.size == 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3' %> gap-3">
    <% tiles.each do |label, value, note, tint, modal| %>
      <% inner = capture do %>
        <div class="text-xs text-gray-500"><%= label %></div>
        <div class="text-xl font-bold tabular-nums text-gray-900 mt-0.5"><%= value %></div>
        <div class="text-xs <%= modal ? 'text-pink-600' : 'text-gray-500' %> mt-0.5"><%= note %></div>
      <% end %>
      <% if modal %>
        <%# A tile that opens its modal: the thing to do is right where the number is. %>
        <%= link_to "#", class: "block rounded-lg border px-4 py-3 text-left hover:border-pink-400 transition-colors #{tint || 'bg-white border-gray-200'}",
              data: { controller: "modal", action: "click->modal#open", modal_id: modal } do %><%= inner %><% end %>
      <% else %>
        <div class="rounded-lg border px-4 py-3 <%= tint || 'bg-white border-gray-200' %>"><%= inner %></div>
      <% end %>
    <% end %>
  </div>
  <% if stats.capacity.to_i.positive? %>
    <div class="h-2 rounded-full bg-gray-100 overflow-hidden" aria-hidden="true">
      <div class="h-full bg-pink-500" style="width: <%= [ (stats.sold + outside) * 100.0 / stats.capacity, 100 ].min.round(1) %>%"></div>
    </div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-200"><h2 class="text-sm font-semibold text-gray-900">By ticket type</h2></div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500">
          <tr>
            <th class="px-5 py-2 text-left font-medium">Ticket</th>
            <th class="px-3 py-2 text-right font-medium">Price</th>
            <th class="px-3 py-2 text-right font-medium">Sold</th>
            <th class="px-3 py-2 text-right font-medium">In checkout</th>
            <th class="px-3 py-2 text-right font-medium">Left</th>
            <th class="px-5 py-2 text-right font-medium">Sales</th>
            <% unless read_only %><th class="w-10"><span class="sr-only">Actions</span></th><% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <%# A type no longer sold shows only while someone holds a ticket on it. %>
          <% stats.by_tier.reject { |row| row.tier.archived_at && row.sold.zero? }.each do |row| %>
            <%# The row wears its state (Tim: colors, not badges): gray when it's
                hidden or no longer sold, red when it's marked sold out. %>
            <%
              tone = if row.tier.archived_at || row.tier.unlisted? then "text-gray-400"
                     elsif row.tier.marked_sold_out? then "text-red-700"
                     end
            %>
            <tr class="whitespace-nowrap <%= tone %>">
              <td class="px-5 py-2.5 <%= tone || 'text-gray-900' %>">
                <%= row.tier.name %><%= " (no longer sold)" if row.tier.archived_at %>
                <% if row.tier.archived_at.nil? && !row.tier.available? %>
                  <span class="ml-1 text-xs font-medium">· <%= TicketTier::AVAILABILITY_LABELS[row.tier.effective_availability] %></span>
                <% end %>
              </td>
              <td class="px-3 py-2.5 text-right tabular-nums"><%= ticket_price(row.tier.price_cents) %></td>
              <td class="px-3 py-2.5 text-right tabular-nums"><%= row.sold %><%= " of #{row.seats}" if row.seats %></td>
              <td class="px-3 py-2.5 text-right tabular-nums"><%= row.held %></td>
              <td class="px-3 py-2.5 text-right tabular-nums">
                <%= row.remaining.nil? ? "No limit" : row.remaining %>
                <% if row.outside.positive? %><div class="text-xs font-normal text-gray-500 whitespace-normal"><%= stats.outside_words(tier: row.tier) %></div><% end %>
              </td>
              <td class="px-5 py-2.5 text-right tabular-nums"><%= money.call(row.gross_cents) %></td>
              <% unless read_only %>
                <td class="pr-3 py-1.5 text-right">
                  <%# This type on this date only: on sale, marked sold out, or hidden. %>
                  <% if row.tier.archived_at.nil? %>
                    <% menu_item = "w-full flex items-center gap-2 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer bg-transparent border-0 text-left" %>
                    <%# Floats over the page (fixed): the table's scrolling box would clip it. %>
                    <div class="relative inline-block" data-controller="dropdown" data-dropdown-fixed-value="true">
                      <button type="button" data-action="click->dropdown#toggle" title="<%= row.tier.name %>: on sale, sold out or hidden"
                              aria-label="Change <%= row.tier.name %>"
                              class="p-1.5 text-gray-400 hover:text-gray-600 rounded-md border border-gray-200 hover:border-gray-400 bg-white transition-colors cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/></svg>
                      </button>
                      <div data-dropdown-target="menu" class="hidden absolute right-0 top-full w-60 bg-white rounded-lg shadow-lg border border-gray-200 py-1 z-50 text-left whitespace-normal">
                        <% [ [ "on_sale", "Put back on sale", "check-circle" ], [ "sold_out", "Mark sold out", "x-circle" ], [ "unlisted", "Hide from the ticket page", "eye" ] ].each do |value, label, glyph| %>
                          <% next if row.tier.availability == value %>
                          <%= button_to manage_ticket_listing_tier_availability_path(listing, row.tier), method: :patch, params: { availability: value },
                                class: menu_item, form: { class: "block" } do %>
                            <%= icon(glyph, class: "w-4 h-4 text-gray-400") %> <%= label %>
                          <% end %>
                        <% end %>
                        <p class="px-3 pt-1.5 pb-1 text-[11px] text-gray-400 border-t border-gray-100 mt-1">For this date only.<%= " Bundles of it follow it." if listing.ticket_tiers.any? { |t| t.bundle_of_tier_id == row.tier.id } %></p>
                      </div>
                    </div>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if stats.products_sold.positive? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-200"><h2 class="text-sm font-semibold text-gray-900">Products</h2></div>
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500">
          <tr>
            <th class="px-5 py-2 text-left font-medium">Product</th>
            <th class="px-3 py-2 text-right font-medium">Sold</th>
            <th class="px-3 py-2 text-right font-medium">Delivered</th>
            <th class="px-5 py-2 text-right font-medium">Sales</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% stats.by_product.each do |row| %>
            <tr class="whitespace-nowrap">
              <td class="px-5 py-2.5 text-gray-900"><%= row.name %></td>
              <td class="px-3 py-2.5 text-right tabular-nums"><%= row.sold %></td>
              <td class="px-3 py-2.5 text-right tabular-nums"><%= row.handed_over %></td>
              <td class="px-5 py-2.5 text-right tabular-nums"><%= money.call(row.gross_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if codes.any? %>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <h2 class="text-sm font-semibold text-gray-900">Discount codes</h2>
      <ul class="mt-2 space-y-1 text-sm">
        <% codes.each do |code, orders, cents| %>
          <li class="flex justify-between gap-3"><span class="text-gray-900"><%= code %> <span class="text-gray-500">· <%= pluralize(orders, "order") %></span></span><span class="tabular-nums text-gray-600">−<%= money.call(cents) %></span></li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
