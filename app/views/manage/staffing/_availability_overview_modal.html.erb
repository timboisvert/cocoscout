<%# Read-only overview of every active staff member's upcoming availability.
    Opened from the "Availability" link in the scheduling top menu (via the shared
    `modal` controller, id "staff-availability-modal"). Data: @availability_overview
    (array of { member:, picture: WorkAvailabilityPicture }). %>
<div id="staff-availability-modal" class="hidden fixed inset-0 z-[70] overflow-y-auto"
     data-controller="modal" data-action="keydown.esc@window->modal#close">
  <div class="flex min-h-full items-start justify-center p-4 py-10">
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm" data-action="click->modal#closeOnBackdrop"></div>

    <div class="relative w-full max-w-3xl bg-white rounded-xl shadow-2xl">
      <div class="flex items-center justify-between px-5 py-4 bg-gradient-to-r from-pink-500 to-pink-600 rounded-t-xl">
        <div>
          <h3 class="text-lg font-semibold text-white">Staff availability</h3>
          <p class="text-xs text-pink-100">Each person's usual week, and what's different coming up</p>
        </div>
        <button type="button" data-action="click->modal#close"
                class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <% if @availability_overview.blank? %>
        <div class="px-5 py-10 text-center text-sm text-gray-500">No active staff yet.</div>
      <% else %>
        <div class="max-h-[70vh] overflow-y-auto divide-y divide-gray-100">
          <% @availability_overview.each do |row| %>
            <% member = row[:member] %>
            <% person = member.person %>
            <% headshot = person&.safe_headshot_variant(:thumb) %>
            <div class="flex items-start gap-3 px-5 py-3">
              <% if headshot %>
                <%= image_tag headshot, alt: member.display_name, class: "w-9 h-9 rounded-lg object-cover flex-shrink-0" %>
              <% else %>
                <div class="w-9 h-9 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-xs flex-shrink-0">
                  <%= person&.initials || member.display_name.to_s.first %>
                </div>
              <% end %>

              <div class="min-w-0 flex-1">
                <div class="font-medium text-gray-900 text-sm"><%= member.display_name %></div>

                <% picture = row[:picture] %>
                <% if !picture.anything_said? %>
                  <div class="text-xs text-gray-400 mt-0.5">Hasn't said when they can work</div>
                <% else %>
                  <dl class="mt-1 space-y-0.5">
                    <% picture.week_summary.each do |days, label| %>
                      <div class="flex flex-wrap gap-x-2 text-xs">
                        <dt class="font-medium text-gray-700"><%= days %></dt>
                        <dd class="<%= label == "Not working" ? "text-gray-400" : "text-gray-600" %>"><%= label %></dd>
                      </div>
                    <% end %>
                  </dl>
                  <% if picture.exceptions.any? %>
                    <div class="flex flex-wrap gap-1.5 mt-1.5">
                      <% picture.exceptions.each do |ex| %>
                        <span class="inline-flex items-center gap-1 rounded bg-amber-50 border border-amber-200 px-1.5 py-0.5 text-xs text-amber-900"
                              <% if ex.note.present? %>title="<%= ex.note %>"<% end %>>
                          <%= ex.dates_label %>
                          <span class="text-amber-600">· <%= ex.answer.label %></span>
                        </span>
                      <% end %>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
