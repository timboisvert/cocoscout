<% content_for :title, "Ticketing" %>
<%
  d = @dashboard
  profile = ticketing_profile
  summary = d.summary
  money = ->(cents) { number_to_currency(cents / 100.0) }
  series = d.daily_tickets
  box_office_url = short_link_url(code: ShortLink.canonical_for!(profile).code)
  coming_up = d.coming_up
  just_played = d.just_played
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render "shared/module_header",
        title: "Ticketing",
        lead: (render("manage/ticketing/door_open_now", rows: d.door_open) if d.door_open.any?),
        description: "<p>Sell tickets to your shows right here: your own box office page, checkout, and the door. Ticket money lands in your CocoScout balance, where it pays your people first and fills in each show's financials for you.</p>",
        actions: [
          { icon: "calendar", text: "Productions", description: "Each one you sell, and how its dates are going", path: manage_ticket_listings_path, badge: d.drafts_soon.count },
          { icon: "clipboard-list", text: "Orders", description: "Find a buyer, resend tickets, refund", path: manage_ticket_orders_path },
          { icon: "ticket", text: "Passes", description: "Several shows sold together for less", path: manage_ticket_passes_path },
          { icon: "dollar-sign", text: "Deals", description: "Another show for less, offered at checkout", path: manage_ticket_offers_path },
          { icon: "shopping-bag", text: "Products", description: "Bottles and extras sold with tickets", path: manage_ticket_products_path },
          { icon: "user-group", text: "Door", description: "Check people in and sell at the door", path: door_index_path, badge: d.tonight.size },
          { icon: "cog", text: "Settings", description: "Box office, fees, tax and door access", path: manage_ticketing_settings_path }
        ] %>

  <%= render "shared/intro_guide", guide_key: "ticketing_intro", title: "How ticketing works",
        body: %(<ol class="list-decimal pl-5 space-y-1"><li>Set a production up once: its ticket types, prices and seats. Every date goes on sale as soon as it's listed, and new dates join on their own.</li><li>Share the production's short link or QR code; buyers check out here and get QR tickets by email.</li><li>On the night, open the Door on a phone: find people by name, scan tickets, sell at the door.</li><li>Each sale lands in your CocoScout balance and fills in the show's financials; our fee is 50¢ a paid ticket.</li></ol>).html_safe %>

  <% d.alerts.each do |a| %>
    <%= render "shared/alert_panel", eyebrow: a.eyebrow, headline: a.headline, body: a.body, actions: a.actions, tone: a.tone %>
  <% end %>

  <%# Sales for a period, the Money hub way. %>
  <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 mb-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-lg font-semibold text-gray-900">Sales</h2>
      <div class="flex items-center gap-2">
        <label for="ticketing-period" class="text-xs font-medium text-gray-500 uppercase tracking-wide">Period</label>
        <%= select_tag :period, options_for_select(FinancialSummaryService::PERIOD_LABELS.map { |key, label| [ label, key ] }, d.period),
              id: "ticketing-period", onchange: "window.location.href = '#{manage_ticketing_path}?period=' + this.value",
              class: "appearance-none pl-3 pr-8 py-1.5 rounded text-xs font-medium cursor-pointer bg-pink-500 text-white border-0 hover:bg-pink-600" %>
      </div>
    </div>
    <div class="mt-4 grid grid-cols-2 lg:grid-cols-4 gap-3">
      <% [ [ "Tickets sold", summary.tickets.to_s, "Comps not counted" ],
           [ "Ticket sales", money.call(summary.gross_cents), "Before fees and tax" ],
           [ "You keep", money.call(summary.net_cents), "After fees and refunds, without tax" ],
           [ "Refunded", money.call(summary.refunded_cents), "Back to buyers" ] ].each do |label, value, note| %>
        <div class="rounded-lg bg-gray-50 px-4 py-3">
          <div class="text-xs text-gray-500"><%= label %></div>
          <div class="text-xl font-bold tabular-nums text-gray-900 mt-0.5"><%= value %></div>
          <div class="text-xs text-gray-500 mt-0.5"><%= note %></div>
        </div>
      <% end %>
    </div>
    <% if series.values.sum.positive? %>
      <div class="mt-4 h-36" data-controller="line-chart" data-line-chart-data-value="<%= series.to_json %>" data-line-chart-label-value="tickets">
        <canvas data-line-chart-target="canvas"></canvas>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_20rem] gap-6">
    <div class="space-y-6 min-w-0">
      <%# Coming up: each production once, at its next date, soonest first;
          its next few dates open under it, and the rest on its own page. %>
      <%# Upcoming or Past (Tim, 2026-10-19): upcoming is each production with
          its next date and a drawer of the few after; past is every date that
          has played, newest first, each with its numbers, no drawers. %>
      <section>
        <%= render "shared/filters/filter_bar", bare: true, filter_groups: [ { label: "Dates", filters: [
              { text: "Upcoming", path: manage_ticketing_path(period: params[:period].presence), active: @dates == "upcoming" },
              { text: "Past", path: manage_ticketing_path(period: params[:period].presence, dates: "past"), active: @dates == "past" }
            ] } ] %>
        <% if @dates == "past" %>
          <% if d.past.any? %>
            <div class="mt-2 bg-white border border-gray-200 rounded-xl divide-y divide-gray-100">
              <% d.past.each do |listing, stats| %>
                <%= render "manage/ticketing/played_row", listing: listing, stats: stats %>
              <% end %>
            </div>
            <%= link_to "Every date, with totals", manage_ticketing_attendance_path(filter: "this_month"), class: "mt-2 inline-block text-sm font-medium text-pink-600 hover:text-pink-700" %>
          <% else %>
            <div class="mt-2 bg-white border border-gray-200 rounded-xl px-5 py-6 text-sm text-gray-600">No dates have played yet.</div>
          <% end %>
        <% elsif coming_up.any? %>
          <div class="mt-2 space-y-3">
            <% coming_up.each do |row| %>
              <%= render "manage/ticketing/coming_up_production", row: row %>
            <% end %>
          </div>
          <% if d.upcoming_production_count > coming_up.size %>
            <%= link_to "All productions →", manage_ticket_listings_path, class: "mt-2 inline-block text-sm font-medium text-pink-600 hover:text-pink-700" %>
          <% end %>
        <% else %>
          <div class="mt-2 bg-white border border-gray-200 rounded-xl px-5 py-6 flex items-center gap-3 text-sm text-gray-600">
            <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            No upcoming shows are selling yet. Set a production up to sell its dates.
          </div>
        <% end %>
      </section>

      <% if just_played.any? && @dates == "upcoming" %>
        <section>
          <div class="flex items-baseline justify-between mb-2">
            <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Just played</h2>
            <%= link_to "Every date, with totals", manage_ticketing_attendance_path(filter: "last_7_days"), class: "text-xs text-pink-600 hover:text-pink-700" %>
          </div>
          <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100">
            <% just_played.each do |listing, stats| %>
              <%= render "manage/ticketing/played_row", listing: listing, stats: stats %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>

    <aside class="space-y-6">
      <%= link_to manage_ticket_balance_path, class: "block rounded-lg border px-5 py-4 transition-colors hover:border-pink-400 #{@balance.available_cents.positive? ? 'bg-green-50 border-green-200' : 'bg-white border-gray-200'}" do %>
        <div class="text-sm text-gray-600">Your CocoScout balance</div>
        <div class="text-2xl font-bold tabular-nums text-gray-900"><%= money.call(@balance.available_cents) %> <span class="text-sm font-normal text-gray-600">available</span></div>
        <div class="text-xs text-gray-600 mt-1"><%= money.call(@balance.upcoming_cents) %> waiting on upcoming shows<%= " · #{money.call(@balance.tax_set_aside_cents)} set aside for sales tax" if @balance.tax_set_aside_cents.positive? %></div>
      <% end %>

      <div class="bg-white rounded-lg border border-gray-200 p-5">
        <h3 class="font-semibold text-gray-900 mb-3">Your box office</h3>
        <%= render "shared/copy_url", url: box_office_url, show_qr: true, qr_title: "Scan for tickets" %>
      </div>

      <%= render "shared/action_list", items: [
        { text: "Attendance", description: "Everyone holding a ticket, date by date, for any week", path: manage_ticketing_attendance_path,
          icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" },
        { text: "Reports", description: "Ticket sales by show, type and channel, in Reports", path: manage_reports_path,
          icon: "M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" },
        { text: "Sales tax", description: "What you collected, what's set aside, and how to pay it", path: manage_ticket_taxes_path,
          icon: "M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" },
        (Current.user.superadmin? ? { text: "Books", description: "Every dollar on double-entry books", path: manage_money_books_path,
          icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" } : nil)
      ] %>
    </aside>
  </div>
</div>
