<%#
  Shared Financials editor — the deal (who sells + settlement), the generated
  payment list, add-a-payment, and how they may pay us. Used by BOTH the create
  wizard and the Amend flow so the two never drift.

  Locals:
    contract                  - the Contract
    form_url                  - where the form posts
    back_path                 - the "Back" button target
    existing_payments         - array of payment hashes (draft shape; extras carry extra:true)
    existing_payment_structure- "flat_fee" | "per_event" | "revenue_share"
    existing_payment_config   - hash of the deal config
    bookings                  - array of booking hashes (need "starts_at")
    bookings_count            - Integer
    offline_payment_methods   - array of allowed offline methods
%>
<% booking_dates = bookings.map { |b| b["starts_at"] }.compact.sort %>
<div id="payments-app" data-controller="contract-payments"
     data-contract-payments-existing-value="<%= existing_payments.to_json %>"
     data-contract-payments-existing-structure-value="<%= existing_payment_structure %>"
     data-contract-payments-existing-config-value="<%= existing_payment_config.to_json %>"
     data-contract-payments-bookings-value="<%= booking_dates.to_json %>"
     data-contract-payments-bookings-count-value="<%= bookings_count %>">
  <%= form_with url: form_url, method: :post, local: true, data: { action: "submit->contract-payments#preparePaymentsForSubmit" } do |form| %>

  <%# Who holds the ticket money. Separate from how the deal settles — we might
      sell the tickets on a deal that's simply a flat rental. %>
  <div class="mb-6">
    <h3 class="text-sm font-semibold text-gray-900 mb-1">Who sells the tickets?</h3>
    <p class="text-xs text-gray-500 mb-3">Just who takes the ticket money. How the deal settles is the next question.</p>
    <%# Default a brand-new contract to "We do". Once the step has been saved the
        key is present (nil means an explicit "No tickets"), so we respect that. %>
    <% who_sells = existing_payment_config.key?("who_sells_tickets") ? existing_payment_config["who_sells_tickets"].to_s : "org" %>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <label class="flex items-start gap-2 p-3 border border-gray-300 rounded-lg cursor-pointer has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 transition-colors">
        <input type="radio" name="who_sells_tickets" value="org" class="mt-0.5 accent-pink-500" data-action="change->contract-payments#onWhoSellsChange" <%= "checked" if who_sells == "org" %>>
        <span class="text-sm text-gray-700"><span class="font-medium text-gray-900">We do</span> — we set up ticketing and take the money</span>
      </label>
      <label class="flex items-start gap-2 p-3 border border-gray-300 rounded-lg cursor-pointer has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 transition-colors">
        <input type="radio" name="who_sells_tickets" value="contractor" class="mt-0.5 accent-pink-500" data-action="change->contract-payments#onWhoSellsChange" <%= "checked" if who_sells == "contractor" %>>
        <span class="text-sm text-gray-700"><span class="font-medium text-gray-900">They do</span> — they sell and report their sales</span>
      </label>
      <label class="flex items-start gap-2 p-3 border border-gray-300 rounded-lg cursor-pointer has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 transition-colors">
        <input type="radio" name="who_sells_tickets" value="" class="mt-0.5 accent-pink-500" data-action="change->contract-payments#onWhoSellsChange" <%= "checked" if who_sells == "" %>>
        <span class="text-sm text-gray-700"><span class="font-medium text-gray-900">No tickets</span> — this deal doesn't involve them</span>
      </label>
    </div>
  </div>

  <%# Payment Structure Selection %>
  <div class="mb-6">
    <h3 class="text-sm font-semibold text-gray-900 mb-1">How does the money work?</h3>
    <p class="text-xs text-gray-500 mb-3">Split the ticket revenue with them, or a set fee either way — whoever sold the tickets.</p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <button type="button" data-action="click->contract-payments#selectStructureBtn" data-structure="flat_fee"
              data-contract-payments-target="flatFeeBtn"
              class="bg-pink-500 text-white border-pink-500 border-2 rounded-xl p-4 text-center transition-all">
        <div class="flex items-center justify-center gap-2 font-semibold">
          <%= icon("banknotes", class: "w-5 h-5") %>
          Flat Fee
        </div>
        <div class="text-sm opacity-75 mt-1">A set amount, optional deposit</div>
      </button>

      <button type="button" data-action="click->contract-payments#selectStructureBtn" data-structure="per_event"
              data-contract-payments-target="perEventBtn"
              class="bg-white text-gray-700 border-gray-300 hover:border-pink-400 border-2 rounded-xl p-4 text-center transition-all">
        <div class="flex items-center justify-center gap-2 font-semibold">
          <%= icon("calendar", class: "w-5 h-5") %>
          Per Event
        </div>
        <div class="text-sm opacity-75 mt-1">Charge for each date</div>
      </button>

      <button type="button" data-action="click->contract-payments#selectStructureBtn" data-structure="revenue_share"
              data-contract-payments-target="revenueShareBtn"
              class="bg-white text-gray-700 border-gray-300 hover:border-pink-400 border-2 rounded-xl p-4 text-center transition-all">
        <div class="flex items-center justify-center gap-2 font-semibold">
          <%= icon("chart-pie", class: "w-5 h-5") %>
          Revenue Share
        </div>
        <div class="text-sm opacity-75 mt-1">Split by percentage</div>
      </button>
    </div>
    <p class="text-xs text-gray-500 mt-2">Whichever you pick, you can add extra one-off payments below.</p>
  </div>

  <%# Flat Fee Configuration %>
  <div data-contract-payments-target="flatFeeConfig" class="bg-gray-50 rounded-xl p-5 mb-6 border border-gray-200">
    <h4 class="text-sm font-semibold text-gray-900 mb-4 flex items-center gap-2">
      <%= icon("banknotes", class: "w-4 h-4 text-pink-600") %>
      Flat Fee Details
    </h4>
    <div class="space-y-6 [&>div:not(:first-child)]:border-t [&>div:not(:first-child)]:border-gray-200 [&>div:not(:first-child)]:pt-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Which way does the money go?</label>
        <%= render "manage/contract_wizard/choice_cards",
              name: "flat_fee_direction_choice", target: "flatFeeDirection",
              selected: existing_payment_config["flat_fee_direction"].presence || "incoming",
              action: "change->contract-payments#onFlatFeeDirectionChange",
              options: [
                { value: "incoming", title: "They pay us", help: "A fixed amount, whoever sold the tickets." },
                { value: "outgoing", title: "We pay them", help: "A fixed guarantee, whatever the box office does." },
                { value: "ticket_revenue_minus_fee", title: "They get the ticket revenue, minus our fee",
                  help: "We sell, keep a set amount, and hand back the rest." }
              ] %>
        <div data-contract-payments-target="flatFeeTicketRevenueHint" class="hidden bg-amber-50 border border-amber-200 rounded-lg px-4 py-3 mt-3">
          <p class="text-sm text-amber-800">We sell tickets and keep a fixed fee. They receive whatever ticket revenue remains after our deduction.</p>
        </div>
      </div>

      <%# Minus-fee only: is the fee priced per show or for the whole run? A
          per-show fee is what makes a weekly settlement work, and it drops
          itself automatically when a date cancels. %>
      <div data-contract-payments-target="flatFeeBasisConfig" class="hidden">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">How is our fee priced?</label>
        <%= render "manage/contract_wizard/choice_cards",
              name: "flat_fee_basis_choice", target: "flatFeeBasis", columns: 2,
              selected: existing_payment_config["flat_fee_basis"].presence || "contract",
              action: "change->contract-payments#onFlatFeeBasisChange",
              options: [
                { value: "per_show", title: "Per show", help: "Charged for each date. Cancel a show and its fee goes with it." },
                { value: "contract", title: "One total for the run", help: "Spread evenly across the dates when we settle." }
              ] %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5" data-contract-payments-target="flatFeeAmountLabel">Total Contract Amount</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">$</span>
          <input type="number" step="0.01" min="0" data-contract-payments-target="flatFeeAmount" placeholder="0.00"
                 data-action="input->contract-payments#updateSummaryFromConfig"
                 class="w-full pl-8 pr-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
        </div>
      </div>

      <%# Minus-fee only: how often we hand the remainder back. Anything other
          than "once" builds one settlement per period off the booked dates. %>
      <div data-contract-payments-target="flatFeeSettlementConfig" class="hidden">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">When do we settle up?</label>
        <%= render "manage/contract_wizard/choice_cards",
              name: "flat_fee_settlement_choice", target: "flatFeeSettlement", columns: 2,
              selected: existing_payment_config["flat_fee_settlement"].presence || "once",
              action: "change->contract-payments#onFlatFeeSettlementChange",
              options: [
                { value: "once", title: "Once, at the end", help: "A single settlement covering the whole run." },
                { value: "per_event", title: "After each show", help: "One settlement per date." },
                { value: "weekly", title: "Weekly", help: "One settlement covering each week's shows." },
                { value: "monthly", title: "Monthly", help: "One settlement covering each month's shows." }
              ] %>
      </div>

      <div data-contract-payments-target="flatFeeFinalDueConfig">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Payment Due Date</label>
        <input type="date" data-contract-payments-target="flatFeeFinalDue"
               class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
      </div>

      <div data-contract-payments-target="flatFeeDepositSection">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Deposit</label>
        <%= render "manage/contract_wizard/choice_cards",
              name: "flat_fee_deposit_choice", target: "flatFeeDeposit", columns: 2,
              selected: existing_payment_config["flat_fee_has_deposit"].to_s == "true" ? "yes" : "no",
              action: "change->contract-payments#toggleDeposit",
              options: [
                { value: "no", title: "No deposit", help: "The whole amount is due on the date above." },
                { value: "yes", title: "Take a deposit", help: "Collect part of it upfront, the rest on the due date." }
              ] %>

        <div data-contract-payments-target="flatFeeDepositConfig" class="hidden mt-4 pl-4 border-l-2 border-pink-200 space-y-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Deposit amount</label>
            <div class="flex gap-2">
              <div class="relative flex-1">
                <input type="number" step="0.01" min="0" data-contract-payments-target="flatFeeDepositAmount" placeholder="0.00"
                       data-action="input->contract-payments#updateSummaryFromConfig"
                       class="w-full pl-8 pr-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">$</span>
              </div>
              <span class="text-gray-400 self-center">or</span>
              <div class="relative w-24">
                <input type="number" step="1" min="0" max="100" data-contract-payments-target="flatFeeDepositPercent" placeholder="50"
                       data-action="input->contract-payments#updateSummaryFromConfig"
                       class="w-full pl-3 pr-8 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">%</span>
              </div>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Deposit due date</label>
            <input type="date" data-contract-payments-target="flatFeeDepositDue"
                   class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Per Event Configuration %>
  <div data-contract-payments-target="perEventConfig" class="hidden bg-gray-50 rounded-xl p-5 mb-6 border border-gray-200">
    <h4 class="text-sm font-semibold text-gray-900 mb-4 flex items-center gap-2">
      <%= icon("calendar", class: "w-4 h-4 text-pink-600") %>
      Per Event Fee Details
    </h4>
    <div class="space-y-6 [&>div:not(:first-child)]:border-t [&>div:not(:first-child)]:border-gray-200 [&>div:not(:first-child)]:pt-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Fee Per Event</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">$</span>
            <input type="number" step="0.01" min="0" data-contract-payments-target="perEventAmount" placeholder="0.00"
                   data-action="input->contract-payments#updateSummaryFromConfig"
                   class="w-full pl-8 pr-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Scheduled Events</label>
          <div class="flex items-center gap-2 px-3 py-2.5 bg-gray-100 border border-gray-200 rounded-lg text-sm">
            <span class="font-semibold text-gray-900" data-contract-payments-target="perEventCount"><%= bookings_count %></span>
            <span class="text-gray-500">events from schedule</span>
          </div>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Which way does the money go?</label>
        <%= render "manage/contract_wizard/choice_cards",
              name: "per_event_direction_choice", target: "perEventDirection", columns: 2,
              selected: existing_payment_config["per_event_direction"].presence || "incoming",
              action: "change->contract-payments#updateSummaryFromConfig",
              options: [
                { value: "incoming", title: "They pay us", help: "For each event on the contract." },
                { value: "outgoing", title: "We pay them", help: "For each event on the contract." }
              ] %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">When is it paid?</label>
        <%= render "manage/contract_wizard/choice_cards",
              name: "per_event_timing_choice", target: "perEventTiming", columns: 2,
              selected: existing_payment_config["per_event_timing"].presence || "per_event",
              action: "change->contract-payments#toggleUpfrontPayment",
              options: [
                { value: "per_event", title: "Event by event", help: "One payment for each date." },
                { value: "upfront", title: "All of it upfront", help: "A single payment covering the whole run." }
              ] %>
      </div>

      <%# Upfront payment details %>
      <div data-contract-payments-target="perEventUpfrontConfig" class="hidden pl-6 border-l-2 border-pink-200 space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Due Date for Full Payment</label>
          <input type="date" data-contract-payments-target="perEventUpfrontDue"
                 class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
        </div>
        <p class="text-xs text-gray-500">
          Total: <span data-contract-payments-target="perEventTotal" class="font-semibold text-pink-600">$0.00</span>
          (<span data-contract-payments-target="perEventCountDisplay">0</span> events × $<span data-contract-payments-target="perEventAmountDisplay">0.00</span>)
        </p>
      </div>

      <%# Per-event payment terms %>
      <div data-contract-payments-target="perEventTermsConfig">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">When is each one due?</label>
        <%= render "manage/contract_wizard/choice_cards",
              name: "per_event_terms_choice", target: "perEventTerms", columns: 2,
              selected: existing_payment_config["per_event_terms"].presence || "same_day",
              action: "change->contract-payments#togglePaymentTermsDays",
              options: [
                { value: "same_day", title: "On the day", help: "Due the day of the event." },
                { value: "before", title: "Before each event", help: "Due a set number of days ahead." },
                { value: "after", title: "After each event", help: "Due a set number of days later." },
                { value: "monthly", title: "Monthly invoice", help: "One invoice covering the month." }
              ] %>
      </div>

      <%# Days before/after config %>
      <div data-contract-payments-target="perEventTermsDaysConfig" class="hidden pl-6 border-l-2 border-pink-200">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">
          <span data-contract-payments-target="perEventTermsDaysLabel">Days before event</span>
        </label>
        <div class="flex items-center gap-2">
          <input type="number" min="1" max="90" value="7" data-contract-payments-target="perEventTermsDays"
                 class="w-20 px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
          <span class="text-sm text-gray-500">days</span>
        </div>
      </div>

      <% if bookings_count.to_i > 1 %>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Volume discount</label>
          <%= render "manage/contract_wizard/choice_cards",
                name: "per_event_discount_choice", target: "perEventDiscount", columns: 2,
                selected: existing_payment_config["per_event_discount"].to_s == "true" ? "yes" : "no",
                action: "change->contract-payments#toggleVolumeDiscount",
                options: [
                  { value: "no", title: "Full price every event", help: "The same fee for each of the #{bookings_count} dates." },
                  { value: "yes", title: "Discount for booking several", help: "Take a percentage off because it's a run." }
                ] %>
        </div>
      <% end %>

      <div data-contract-payments-target="perEventDiscountConfig" class="hidden pl-6 border-l-2 border-pink-200 space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Discount Percentage</label>
          <div class="relative">
            <input type="number" step="1" min="0" max="100" data-contract-payments-target="perEventDiscountPercent" placeholder="10"
                   data-action="input->contract-payments#updateSummaryFromConfig"
                   class="w-full pl-3 pr-8 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">%</span>
          </div>
          <p class="text-xs text-gray-500 mt-1">Applied to total per-event fees</p>
        </div>
      </div>
    </div>
  </div>

  <%# Revenue Share Configuration %>
  <div data-contract-payments-target="revenueShareConfig" class="hidden bg-gray-50 rounded-xl p-5 mb-6 border border-gray-200">
    <h4 class="text-sm font-semibold text-gray-900 mb-4 flex items-center gap-2">
      <%= icon("chart-pie", class: "w-4 h-4 text-pink-600") %>
      Revenue Share Details
    </h4>
    <div class="space-y-6 [&>div:not(:first-child)]:border-t [&>div:not(:first-child)]:border-gray-200 [&>div:not(:first-child)]:pt-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">What are we splitting?</label>
        <%= render "manage/contract_wizard/choice_cards",
              name: "revenue_source_choice", target: "revenueSource", columns: 2,
              selected: existing_payment_config["revenue_source"].presence || "ticket_sales",
              options: [
                { value: "ticket_sales", title: "Ticket sales", help: "Everything sold in advance and at the door." },
                { value: "door_sales", title: "Door sales", help: "Only what's taken on the night." },
                { value: "bar_sales", title: "Bar and concessions", help: "Drinks and snacks, not tickets." },
                { value: "merchandise", title: "Merchandise", help: "Shirts, posters, anything sold at the table." },
                { value: "total_revenue", title: "Everything", help: "All of it, from every source." }
              ] %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Our Share</label>
          <div class="relative">
            <input type="number" step="1" min="0" max="100" data-contract-payments-target="revenueOurShare" placeholder="50" value="<%= existing_payment_config["revenue_our_share"].presence || 50 %>"
                   data-action="input->contract-payments#syncRevenueShare"
                   class="w-full pl-3 pr-8 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">%</span>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Their Share</label>
          <div class="relative">
            <input type="number" step="1" min="0" max="100" data-contract-payments-target="revenueTheirShare" placeholder="50" value="<%= existing_payment_config["revenue_their_share"].presence || 50 %>"
                   data-action="input->contract-payments#syncRevenueShare"
                   class="w-full pl-3 pr-8 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">%</span>
          </div>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Minimum guarantee</label>
        <%= render "manage/contract_wizard/choice_cards",
              name: "revenue_guarantee_choice", target: "revenueGuarantee", columns: 2,
              selected: existing_payment_config["revenue_guarantee"].to_s == "true" ? "yes" : "no",
              action: "change->contract-payments#toggleGuarantee",
              options: [
                { value: "no", title: "Just the split", help: "Whatever their percentage comes to, and no more." },
                { value: "yes", title: "Guarantee a minimum", help: "They take home at least a set amount either way." }
              ] %>
      </div>

      <div data-contract-payments-target="revenueGuaranteeConfig" class="hidden pl-6 border-l-2 border-pink-200">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Guaranteed Minimum</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">$</span>
          <input type="number" step="0.01" min="0" data-contract-payments-target="revenueGuaranteeAmount" placeholder="500.00"
                 class="w-full pl-8 pr-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
        </div>
        <p class="text-xs text-gray-500 mt-1">They receive at least this amount, even if their share is less.</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">When do we settle up?</label>
        <%= render "manage/contract_wizard/choice_cards",
              name: "revenue_settlement_choice", target: "revenueSettlement", columns: 2,
              selected: existing_payment_config["revenue_settlement"].presence || "same_day",
              options: [
                { value: "same_day", title: "Same day", help: "Settle the night of the show." },
                { value: "next_day", title: "Next business day", help: "Once the numbers are counted." },
                { value: "weekly", title: "Weekly", help: "One settlement covering the week." },
                { value: "monthly", title: "Monthly", help: "One settlement covering the month." }
              ] %>
      </div>
    </div>
  </div>

  <%# Every payment this contract will create: the ones the deal above
      generates, plus any extras added by hand. %>
  <div class="mb-6">
    <h3 class="text-sm font-semibold text-gray-900 mb-1">Payments on this contract</h3>
    <p class="text-xs text-gray-500 mb-3">These follow from the deal above and update as you change it. Add extra one-off payments if the deal needs them.</p>

    <div data-contract-payments-target="list" class="space-y-2"></div>

    <div class="mt-4">
      <%= render "shared/button", text: "Add another payment", variant: "primary", size: "medium",
            icon: "plus", type: :button,
            data: { action: "click->contract-payments#openPaymentModal" } %>
    </div>
  </div>

  <%# How they may pay us. Online is always on; anything else has to be allowed
      here before a payment can be recorded by hand. Starts from org settings. %>
  <div class="mb-6 pt-6 border-t border-gray-200">
    <h3 class="text-sm font-semibold text-gray-900">How may they pay us?</h3>
    <p class="text-xs text-gray-500 mt-1 mb-3">Pre-filled from your <%= link_to "contract settings", manage_contract_settings_section_path(section: "payments"), class: "text-pink-600 hover:text-pink-700 underline" %>. Change it here if this deal is different.</p>
    <div class="space-y-2.5">
      <label class="flex items-start gap-3 opacity-60">
        <input type="checkbox" checked disabled class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
        <span>
          <span class="block text-sm font-medium text-gray-900">Online (card or bank)</span>
          <span class="block text-xs text-gray-500">Pay through CocoScout. Always available.</span>
        </span>
      </label>
      <% Contract::OFFLINE_PAYMENT_METHODS.each do |method| %>
        <label class="flex items-start gap-3 cursor-pointer">
          <%= check_box_tag "offline_payment_methods[]", method,
                offline_payment_methods.include?(method), id: "contract_offline_method_#{method}",
                class: "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
          <span class="block text-sm font-medium text-gray-900"><%= Contract::OFFLINE_PAYMENT_METHOD_LABELS[method] %></span>
        </label>
      <% end %>
    </div>
  </div>

  <input type="hidden" name="payment_structure" data-contract-payments-target="structureJson" value="<%= existing_payment_structure %>">
  <input type="hidden" name="payment_config" data-contract-payments-target="configJson" value="<%= existing_payment_config.to_json %>">
  <input type="hidden" name="payments" data-contract-payments-target="paymentsJson" value="<%= existing_payments.to_json %>">

  <div class="flex justify-between">
    <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", icon: "arrow-left", path: back_path %>
    <%# What's next depends on who's selling, so the label follows the choice. %>
    <div data-contract-payments-target="nextButton">
      <%= render "shared/button",
            text: contract.org_sells_tickets? ? "Next: Ticketing" : "Next: Services",
            variant: "primary", size: "medium", type: :submit %>
    </div>
  </div>
  <% end %>

  <%# Add-a-payment modal. Fields are read by the controller, not submitted. %>
  <div data-contract-payments-target="paymentModal" class="hidden fixed inset-0 z-50">
    <div class="fixed inset-0 bg-black/50" data-action="click->contract-payments#closePaymentModal"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-lg w-full overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 bg-pink-600">
          <h3 class="text-lg font-bold text-white">Add a payment</h3>
          <button type="button" data-action="click->contract-payments#closePaymentModal" class="text-white/80 hover:text-white">
            <%= icon("x-mark", class: "w-5 h-5") %>
          </button>
        </div>

        <div class="p-6 space-y-5">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">What's it for?</label>
            <input type="text" data-contract-payments-target="description" placeholder="e.g. Cleaning deposit, Final settlement"
                   class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Which way does it go?</label>
            <%= render "manage/contract_wizard/choice_cards",
                  name: "extra_payment_direction_choice", target: "direction", columns: 2,
                  selected: "incoming",
                  options: [
                    { value: "incoming", title: "They pay us", help: "Money coming in." },
                    { value: "outgoing", title: "We pay them", help: "Money going out." }
                  ] %>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Amount</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">$</span>
                <input type="number" step="0.01" min="0" data-contract-payments-target="amount" placeholder="0.00"
                       class="block w-full pl-8 pr-4 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Due date</label>
              <input type="date" data-contract-payments-target="dueDate"
                     class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
            </div>
          </div>

          <p data-contract-payments-target="paymentModalError" class="hidden text-sm text-red-600"></p>

          <div class="flex gap-3 pt-1">
            <button type="button" data-action="click->contract-payments#closePaymentModal"
                    class="flex-1 px-4 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
              Cancel
            </button>
            <%= render "shared/button", text: "Add payment", variant: "primary", size: "medium", type: :button,
                  classes: "flex-1", data: { action: "click->contract-payments#addPayment" } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
