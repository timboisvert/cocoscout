<%# Tickets tab (Pro): this date follows the production's answer to the
    Tickets question unless it answers for itself, the way a date can set its
    own ticket prices (ticket_listings/settings/_tickets). Off, the
    production's answer shows grayed; on, this date says where its tickets
    are, or that it has none, and leaves the production's CocoScout sales. %>
<%
  production = @show.production
  organization = production.organization
  listing = @show.ticket_listing
  listing = nil if listing&.status == "canceled"
  own = @show.tickets_override?
  inherited = case production.tickets_mode
              when "cocoscout" then "Sold on CocoScout#{listing ? ': this date is listed' : ''}"
              when "elsewhere" then "Sold on #{TicketLink.recognize(production.tickets_url)&.dig(:name) || 'another site'}"
              when "none" then "No tickets"
              else "Not set yet"
              end
  mode = @show.tickets_mode.presence || "elsewhere"
%>
<% if organization.feature_available?(:ticketing) %>
  <%= render layout: "manage/shows/edit/card", locals: { title: "Tickets", intro: "Where people get tickets for this date." } do %>
  <div class="space-y-5" data-controller="fieldset-toggle">
    <div class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3">
      <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">The production's answer</div>
      <div class="mt-1 text-sm font-medium text-gray-900"><%= inherited %></div>
      <p class="mt-1 text-xs text-gray-500">
        <% if production.tickets_mode == "unset" %>
          Set where people get tickets for <%= production.name %> on <%= link_to "Production Settings → Tickets", edit_manage_production_path(production, tab: (production.type_third_party? ? 3 : 7)), class: "text-pink-600 hover:text-pink-700 font-medium" %>.
        <% else %>
          Set on <%= link_to "Production Settings → Tickets", edit_manage_production_path(production, tab: (production.type_third_party? ? 3 : 7)), class: "text-pink-600 hover:text-pink-700 font-medium" %>; every date follows it unless it answers for itself below.
        <% end %>
      </p>
    </div>

    <div class="flex items-center justify-between gap-4">
      <div>
        <div class="text-sm font-medium text-gray-900">Set tickets for this date only</div>
        <div class="text-xs text-gray-600 mt-0.5">
          Off, this date follows <%= possessive(production.name) %> answer. On, you say where this date's tickets are, or that it has none<% if production.tickets_mode == "cocoscout" %>; it leaves CocoScout's sales for <%= production.name %><%= listing && listing.ticket_orders.paid_like.exists? ? " (tickets already sold here stay valid)" : "" %><% end %>.
        </div>
      </div>
      <%= render "shared/toggle_switch", form: form, field: :tickets_override, checked: own, unchecked_value: "0",
            data: { fieldset_toggle_target: "switch", action: "change->fieldset-toggle#toggle" } %>
    </div>

    <fieldset <%= "disabled" unless own %> data-fieldset-toggle-target="fields" class="min-w-0 space-y-3 disabled:opacity-50 disabled:pointer-events-none transition-opacity">
      <label class="flex items-start gap-3 p-3 border border-gray-300 rounded-lg cursor-pointer has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 transition-colors">
        <%= form.radio_button :tickets_mode, "elsewhere", checked: mode == "elsewhere", class: "mt-0.5 accent-pink-500" %>
        <span class="flex-1">
          <span class="block text-sm font-medium text-gray-900">Somewhere else</span>
          <span class="block text-xs text-gray-600 mt-0.5">Paste the link where people buy tickets for this date.</span>
        </span>
      </label>
      <div class="ml-4 pl-4 border-l-2 border-pink-200">
        <%= form.url_field :tickets_url, placeholder: "https://www.eventbrite.com/e/…", class: input_class %>
      </div>
      <label class="flex items-start gap-3 p-3 border border-gray-300 rounded-lg cursor-pointer has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 transition-colors">
        <%= form.radio_button :tickets_mode, "none", checked: mode == "none", class: "mt-0.5 accent-pink-500" %>
        <span class="flex-1">
          <span class="block text-sm font-medium text-gray-900">No tickets for this date</span>
          <span class="block text-xs text-gray-600 mt-0.5">Free, or not ticketed.</span>
        </span>
      </label>
    </fieldset>
  </div>
  <% end %>
<% else %>
  <%= render "manage/billing/upgrade", paywall: Manage::PaidFeatureGate::FEATURE_DETAILS[:ticketing], feature: :ticketing %>
<% end %>
