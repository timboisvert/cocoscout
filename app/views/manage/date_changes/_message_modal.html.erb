<%#
  Read and edit a message before it goes: a modal inside the step's form,
  so what's typed is saved with the step. Enter in the subject closes the
  modal (it never submits the form behind it).
  Locals: id, title, prefix (choice key prefix), subject, body, hint
  (optional), examples (optional [[label, lines]]), html (true when the body
  is HTML, as the cast and staff notices are)
%>
<div id="<%= id %>" class="hidden fixed inset-0 bg-black/50 z-[60] flex items-end sm:items-center justify-center sm:p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full sm:max-w-2xl max-h-[92vh] flex flex-col overflow-hidden" data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white"><%= title %></h3>
      <button type="button" data-action="click->modal#close" aria-label="Close"
              class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="px-6 py-5 space-y-4 overflow-y-auto">
      <div>
        <label for="<%= id %>-subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
        <%= text_field_tag "choices[#{prefix}_subject]", subject, id: "#{id}-subject",
              data: { action: "keydown.enter->modal#close:prevent" },
              class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
      </div>
      <div>
        <label for="<%= id %>-body" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
        <%= text_area_tag "choices[#{prefix}_body]", body, id: "#{id}-body", rows: 10,
              class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 #{'font-mono text-xs' if local_assigns[:html]}" %>
        <% if local_assigns[:hint].present? %>
          <p class="mt-2 text-xs text-gray-500"><%= local_assigns[:hint] %></p>
        <% end %>
      </div>
      <% Array(local_assigns[:examples]).each do |label, lines| %>
        <div class="rounded-lg bg-gray-50 border border-gray-200 px-4 py-3">
          <p class="text-xs font-semibold text-gray-700 mb-1"><%= label %></p>
          <% Array(lines).first(6).each do |line| %>
            <p class="text-xs text-gray-600"><%= line %></p>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="px-4 sm:px-6 pt-3 pb-[calc(env(safe-area-inset-bottom)+12px)] sm:py-4 bg-gray-50 border-t border-gray-200 flex justify-end">
      <%= render "shared/button", text: "Done", variant: "primary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
    </div>
  </div>
</div>
