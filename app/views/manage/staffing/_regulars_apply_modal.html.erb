<%# The weekly Regulars review: every standing rule that matches this week's
    events, one checkbox per slot. Checked = will be scheduled on confirm.
    Unavailable people stay visible but start unchecked; rows that can't apply
    (already scheduled, no longer qualified) are shown disabled so the manager
    can see why nothing will happen. Submits to SchedulingRulesController#apply,
    which re-verifies every key server-side. %>
<div id="regulars-apply-modal" class="hidden fixed inset-0 z-[70] overflow-y-auto"
     data-controller="modal" data-action="keydown.esc@window->modal#close">
  <div class="fixed inset-0 bg-black/60 backdrop-blur-sm" data-action="click->modal#closeOnBackdrop"></div>
  <div class="flex min-h-full items-start justify-center p-4 py-12">
    <div class="relative w-full max-w-2xl bg-white rounded-xl shadow-2xl" data-action="click->modal#stopPropagation">
      <div class="flex items-center justify-between px-5 py-4 bg-gradient-to-r from-pink-500 to-pink-600 rounded-t-xl">
        <h3 class="text-lg font-semibold text-white">Apply regulars — week of <%= @week_start.strftime("%b %-d") %></h3>
        <button type="button" data-action="click->modal#close" class="text-white/70 hover:text-white cursor-pointer">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <%= form_with url: manage_apply_staffing_scheduling_rules_path, method: :post do %>
        <%= hidden_field_tag :week_start, @week_start.iso8601 %>
        <div class="px-5 py-4">
          <p class="text-sm text-gray-600 mb-3">
            Everyone checked gets their shift created and assigned when you confirm.
            Uncheck anyone to skip them this week.
          </p>

          <div class="max-h-[26rem] overflow-y-auto space-y-4">
            <% @regulars_matches.group_by(&:date).each do |date, day_matches| %>
              <div>
                <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">
                  <%= date.strftime("%A, %b %-d") %>
                </div>
                <div class="space-y-1">
                  <% day_matches.each do |match| %>
                    <label class="flex items-center gap-3 px-2 py-2 rounded-lg <%= match.selectable? ? "hover:bg-gray-50 cursor-pointer" : "opacity-60" %>">
                      <input type="checkbox" name="match_keys[]" value="<%= match.key %>"
                             <%= "checked" if match.prechecked? %>
                             <%= "disabled" unless match.selectable? %>
                             class="h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500 flex-shrink-0">
                      <% headshot_variant = match.person.safe_headshot_variant(:thumb) %>
                      <% if headshot_variant %>
                        <%= image_tag headshot_variant, alt: match.person.name, class: "w-8 h-8 rounded-lg object-cover flex-shrink-0" %>
                      <% else %>
                        <div class="w-8 h-8 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-xs flex-shrink-0">
                          <%= match.person.initials %>
                        </div>
                      <% end %>
                      <span class="flex-1 min-w-0">
                        <span class="block text-sm font-medium text-gray-900 truncate"><%= match.person.name %></span>
                        <span class="block text-xs text-gray-500 truncate">
                          <%= match.house_role.name %>
                          <% if match.show %>
                            · <%= match.show.production&.name %>
                          <% elsif match.rule.production_anchored? %>
                            · <%= match.rule.production&.name %>
                          <% end %>
                          · <%= match.starts_at.strftime("%-l:%M %p") %>–<%= match.ends_at.strftime("%-l:%M %p") %>
                        </span>
                      </span>
                      <% if match.already_assigned %>
                        <span class="text-xs text-gray-500 flex-shrink-0">Already scheduled</span>
                      <% elsif !match.qualified %>
                        <span class="text-xs text-gray-500 flex-shrink-0">Not qualified for this role</span>
                      <% elsif match.unavailable %>
                        <span class="text-xs font-medium text-amber-700 bg-amber-50 px-2 py-0.5 rounded flex-shrink-0">Marked unavailable</span>
                      <% end %>
                    </label>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
          <button type="button" data-action="click->modal#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
          <%= render "shared/button", text: "Add checked shifts", variant: "primary", size: "small", type: :submit %>
        </div>
      <% end %>
    </div>
  </div>
</div>
