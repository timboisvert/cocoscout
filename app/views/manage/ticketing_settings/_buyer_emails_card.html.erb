<%# What buyers are sent (Tim, 2026-11-13: beside the management emails, on
    the Notifications and emails tab). Saved by the Basic info action,
    which comes back here (from: "notifications"). %>
<% input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="emails">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Buyer emails</h2>
      <p class="text-sm text-gray-600 mt-1">The reminder before the show, and whether tickets come as a PDF too.</p>
    </div>
    <%= form_with model: ticketing_profile, url: manage_ticketing_settings_path, method: :patch do |f| %>
      <%= hidden_field_tag :from, "notifications", id: nil %>
      <div class="px-6 py-5 space-y-6">
      <div>
        <label for="ticketing_profile_reminder_days_before" class="block text-sm font-medium text-gray-700 mb-1.5">Reminder email</label>
        <%= f.select :reminder_days_before,
              [ [ "Off", "" ] ] + (1..30).map { |days| [ "#{pluralize(days, 'day')} before the show", days ] },
              {}, class: "#{input_class} max-w-xs" %>
        <p class="text-xs text-gray-500 mt-1">Buyers get the time, the place and their tickets again. Each order gets one reminder, sent at 10am.</p>
      </div>

      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="text-sm font-medium text-gray-700">Attach PDF tickets</div>
          <p class="text-xs text-gray-500 mt-1">Off, buyers get their QR codes in the email. On, the email also carries a PDF with a page per ticket, for people who like to print. Either way, they can download the PDF from their order page.</p>
        </div>
        <%= render "shared/toggle_switch", form: f, field: :attach_pdf_tickets, aria_label: "Attach PDF tickets" %>
      </div>
      </div>
      <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
        <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
      </div>
    <% end %>
  </div>
