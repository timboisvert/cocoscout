<% content_for :title, "Availability Calendar" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
        ["My Tasks & Availability", my_tasks_path]
    ],
    text: "Availability Calendar",
    links: [
      {
        text: "List",
        path: my_tasks_path,
        icon: "list"
      }
    ]
  } %>

  <%= render "shared/filters/filter_bar",
      toggle_label: "Filters",
      filter_groups: [
        {
          partial: "shared/filters/event_type_filter",
          locals: {
            path_helper: method(:my_availability_calendar_path),
            event_type_filter: @event_type_filter,
            entity_filter: @entity_filter,
            month: params[:month]
          }
        },
        {
          partial: "shared/filters/entity_filter",
          locals: {
            path_helper: method(:my_availability_calendar_path),
            people: @people,
            groups: @groups,
            entity_filter: @entity_filter,
            label: "Include",
            event_type: @event_type_filter.join(","),
            month: params[:month]
          }
        }
      ]
  %>
  <% if @show_entity_pairs.any? %>
    <%
      # Use Date for month keys to avoid DST timezone comparison issues
      current_month_param = params[:month] ? Date.parse(params[:month]).beginning_of_month : nil
      display_month = current_month_param || Date.current.beginning_of_month
      month_pairs = @pairs_by_month[display_month] || []
      multi_entity = @people.size > 1 || @groups.any?

      last_month = @pairs_by_month.keys.sort.last
      prev_month = display_month - 1.month
      next_month = display_month + 1.month

      # One augmented item per show x entity, grouped by day for the calendar.
      items_by_date = month_pairs
        .map { |pair| pair.merge(availability: @availabilities[[ pair[:show].id, pair[:entity_key] ]], multi_entity: multi_entity) }
        .group_by { |pair| pair[:show].date_and_time.to_date }

      month_link = ->(m) {
        my_availability_calendar_path(event_type: @event_type_filter.join(","),
                                      entity: @entity_filter.join(","),
                                      month: m.strftime("%Y-%m-01"))
      }

      # Clicking a day with events opens its modal (future days only).
      cell_attrs = ->(date, day_items) {
        next {} if day_items.empty? || date < Date.current
        {
          class: "cursor-pointer hover:border-pink-400 hover:shadow-sm transition-all",
          data: { controller: "modal", action: "click->modal#open", modal_id: "day-modal-#{date.iso8601}" }
        }
      }
    %>

    <%= render "shared/month_calendar",
        current_month: display_month,
        month_link: month_link,
        items_by_date: items_by_date,
        item_partial: "my/availability/calendar_tile",
        mobile_item_partial: "my/availability/calendar_mobile_row",
        cell_attrs: cell_attrs,
        prev_month: prev_month,
        next_month: next_month,
        can_go_prev: prev_month >= Date.current.beginning_of_month,
        can_go_next: next_month <= (last_month || display_month),
        dim_past: true,
        empty_text: "No upcoming events this month." %>

    <%# Day modals: the standard editable availability rows %>
    <% items_by_date.each do |date, day_items| %>
      <% next if date < Date.current %>
      <div id="day-modal-<%= date.iso8601 %>"
           class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
           data-controller="modal"
           data-action="click->modal#closeOnBackdrop">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden"
             data-action="click->modal#stopPropagation">
          <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
            <h3 class="text-lg font-semibold text-white"><%= date.strftime("%A, %B %-d") %></h3>
            <button type="button"
                    data-action="click->modal#close"
                    class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
          <div class="p-4 space-y-1 max-h-[70vh] overflow-y-auto">
            <% day_items.each do |item| %>
              <%= render partial: "my/tasks/availability_item", locals: {
                item: {
                  show: item[:show],
                  entity: item[:entity],
                  entity_type: item[:entity].class.name,
                  entity_key: item[:entity_key],
                  availability: item[:availability]
                },
                has_groups: multi_entity
              } %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-gray-500 text-sm">
      You don't have any upcoming events matching your filters.
    </p>
  <% end %>
</div>
