<%# The Tickets question's three answers as form fields (no form of their
    own): the production page wraps them (shared/ticketing/tickets_question),
    the production wizard renders them in its step. The ancestor form carries
    data-controller="radio-card tickets-question" and the sites value.
    Locals: organization, name (the production's), answer ({ "mode", "url",
    "fee_mode", "schedule_mode", "opens_days_before", "tiers" }), setup
    (ProductionTicketing or nil), cocoscout_fields (default true; false on
    Production Settings, where prices and dates are Ticketing's: the CocoScout
    answer just points there), production (optional, for that link). %>
<%
  pro = organization.feature_available?(:ticketing)
  cocoscout_fields = local_assigns.fetch(:cocoscout_fields, true)
  production = local_assigns[:production]
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  answer = (local_assigns[:answer] || {}).to_h.stringify_keys
  has_tiers = setup&.ticket_tiers&.active&.any?
  mode = answer["mode"].presence || (pro ? "cocoscout" : "elsewhere")
  profile = TicketingProfile.for(organization)
  fee_default = answer["fee_mode"].presence || setup&.fee_mode.presence || profile.default_fee_mode
  schedule = answer["schedule_mode"].presence || setup&.schedule_mode.presence || "immediate"
  days = answer["opens_days_before"].presence || setup&.opens_days_before || 30
  site = answer["url"].present? ? TicketLink.recognize(answer["url"]) : nil
  rows = Array(answer["tiers"]).map { |r| r.to_h.stringify_keys }.select { |r| r["name"].present? }
  rows = [ { "name" => "General" } ] if rows.empty?
  tier_row = lambda do |index, row|
    capture do
%>
      <div class="grid grid-cols-[minmax(0,1fr)_7rem_6rem_auto] gap-x-2 items-center">
        <%= text_field_tag "tickets[tiers][#{index}][name]", row["name"], placeholder: "General", "aria-label": "Ticket type", class: input_class %>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">$</span>
          <%= text_field_tag "tickets[tiers][#{index}][price]", row["price"], inputmode: "decimal", placeholder: "20.00", "aria-label": "Price", class: "#{input_class} pl-7" %>
        </div>
        <%= number_field_tag "tickets[tiers][#{index}][seats]", row["seats"], min: 1, placeholder: "Seats", "aria-label": "Seats", class: input_class %>
        <%= render "shared/button", text: "Remove", variant: "ghost", size: "xs", type: :button, data: { action: "nested-form#remove" } %>
      </div>
<%
    end
  end
%>

  <%= render layout: "shared/choice_card", locals: { name: "tickets[mode]", value: "cocoscout", selected: mode,
        title: "Sell them on CocoScout", hint: (pro ? "Your own box office page, checkout and the door. 50¢ a paid ticket; the money fills in each show's financials and pays your people." : "Part of Pro: your own box office, 50¢ a paid ticket."), disabled: !pro } do %>
    <% if pro && !cocoscout_fields %>
      <% if setup&.persisted? %>
        <p class="text-sm text-gray-700">Ticket types, prices, dates and the page are set in <%= link_to "Ticketing", manage_production_ticketing_path(production), class: "font-medium text-pink-600 hover:text-pink-700" %><%= setup.enabled? ? "; it's on." : "; turn it on there when the prices are set." %></p>
      <% else %>
        <p class="text-sm text-gray-700">Save, and you'll set the ticket types and prices in Ticketing next. Every date goes on sale right away once it's on.</p>
      <% end %>
    <% elsif pro %>
      <% if has_tiers %>
        <p class="text-sm text-gray-700"><%= name %> already has its ticket types: <%= setup.ticket_tiers.active.map { |t| "#{t.name} #{number_to_currency(t.price_cents / 100.0)}" }.to_sentence %>. Change them in Ticketing.</p>
      <% else %>
        <div data-controller="nested-form" class="space-y-2">
          <div class="grid grid-cols-[minmax(0,1fr)_7rem_6rem_auto] gap-x-2 text-xs font-medium text-gray-500"><span>Ticket type</span><span>Price</span><span>Seats</span><span></span></div>
          <div class="space-y-2" data-nested-form-target="children"><% rows.each_with_index { |row, i| concat tier_row.call(i, row) } %></div>
          <template data-nested-form-target="template"><%= tier_row.call("NEW_CHILD_RECORD", {}) %></template>
          <%= render "shared/button", text: "Add a ticket type", variant: "secondary", size: "xs", type: :button, icon: "plus", data: { action: "nested-form#add" } %>
        </div>
      <% end %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
        <div>
          <label for="tickets_fee_mode" class="block text-xs font-medium text-gray-700 mb-1">Fees</label>
          <%= select_tag "tickets[fee_mode]", options_for_select([ [ "Buyers pay the fees", "buyer" ], [ "You absorb the fees", "org" ] ], fee_default), id: "tickets_fee_mode", class: input_class %>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Sales open</label>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-900">
            <label class="inline-flex items-center gap-1.5"><%= radio_button_tag "tickets[schedule_mode]", "immediate", schedule == "immediate", class: "accent-pink-500" %> Right away</label>
            <label class="inline-flex items-center gap-1.5"><%= radio_button_tag "tickets[schedule_mode]", "relative", schedule == "relative", class: "accent-pink-500" %>
              <%= number_field_tag "tickets[opens_days_before]", days, min: 1, max: 365, "aria-label": "Days before each date", class: "w-16 px-2 py-1 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-right" %> days before each date</label>
          </div>
        </div>
      </div>
      <% unless profile.enabled? %>
        <p class="text-xs text-gray-500">Your box office opens with this: the public pages go live, and course and contract money you collect online joins your CocoScout balance from now on.</p>
      <% end %>
    <% else %>
      <%= render "shared/button", text: "See Pro", variant: "secondary", size: "xs", path: manage_billing_path %>
    <% end %>
  <% end %>

  <%= render layout: "shared/choice_card", locals: { name: "tickets[mode]", value: "elsewhere", selected: mode,
        title: "Somewhere else", hint: "Paste the link where they buy. We read the site from it and add it to your ticket sources, so the financials know it too." } do %>
    <%= url_field_tag "tickets[url]", answer["url"], placeholder: "https://www.tickettailor.com/events/…", "aria-label": "Where people buy tickets", class: input_class,
          data: { tickets_question_target: "url", action: "input->tickets-question#recognize" } %>
    <p class="text-xs text-pink-700 <%= 'hidden' unless site %>" data-tickets-question-target="siteNote"><%= site ? "#{site[:name]}: got it." : "" %></p>
  <% end %>

  <%= render layout: "shared/choice_card", locals: { name: "tickets[mode]", value: "none", selected: mode,
        title: "No tickets", hint: "Free, or not ticketed." } do %><% end %>
