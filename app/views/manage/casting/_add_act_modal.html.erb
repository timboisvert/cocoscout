<%# Add an act to this show's running order: type a new one, re-add an act
    already in the show (duplicated with its performer — the same act twice
    means the same performer), or pull in a default-lineup act that isn't in
    this show yet. Lists are fetched fresh each time the modal opens. %>
<div id="add-act-modal" data-running-order-target="addActModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" data-action="click->running-order#closeAddActModal">
  <div class="bg-white w-full max-w-md rounded-lg shadow-xl overflow-hidden" data-action="click->running-order#stopPropagation">
    <div class="bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-white">Add an Act</h2>
      <button type="button" data-action="click->running-order#closeAddActModal" class="text-white/80 hover:text-white p-1 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="p-6 max-h-[70vh] overflow-y-auto">
      <form data-action="submit->running-order#addFreeText">
        <label class="block text-sm font-medium text-gray-700 mb-1" for="add-act-name">New act</label>
        <div class="flex items-center gap-2">
          <input type="text" id="add-act-name" data-running-order-target="addActNameInput"
                 placeholder="Act name"
                 class="flex-1 rounded-md border border-gray-300 py-2.5 px-3 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500 text-sm" />
          <%= render "shared/button", text: "Add act", variant: "primary", size: "small", type: :submit %>
        </div>
      </form>

      <div data-running-order-target="addActInShowSection" class="hidden mt-6">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Again from this show</p>
        <p class="text-xs text-gray-500 mb-2">Add another run of an act already in the running order — its performer comes with it.</p>
        <div data-running-order-target="addActInShowList" class="space-y-1"></div>
      </div>

      <div data-running-order-target="addActDefaultSection" class="hidden mt-6">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">From the default lineup</p>
        <div data-running-order-target="addActDefaultList" class="space-y-1"></div>
      </div>
    </div>
  </div>
</div>
