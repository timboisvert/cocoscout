<% content_for :title, "Casting - #{@production.name}" %>

<div class="w-full" data-controller="linked-highlight">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Casting", manage_casting_path]
    ],
    text: @production.name,
    links: [
      { text: "Questionnaires", path: manage_contacts_questionnaires_path, icon: "clipboard-list" },
      *([ { text: "Casting Settings", path: manage_casting_settings_path(@production), icon: "cog", variant: "secondary" } ] if current_user_can_manage?(@production))
    ]
  } %>

  <% if current_user_can_manage?(@production) && production_needs_per_act_calculation_nudge?(@production) %>
    <div class="mt-4">
      <%= render "manage/casting/pay_calculation_nudge", production: @production %>
    </div>
  <% end %>

  <div class="mt-4">
    <%= render "manage/casting/status", status: @casting_status, can_manage: current_user_can_manage?(@production) %>
  </div>

  <div class="pt-4 mt-2" data-controller="casting-filter">
    <%= render "shared/filters/filter_bar", filter_groups: [
      {
        label: "View",
        filters: [
          { text: "Upcoming", path: manage_casting_production_path(@production, filter: "upcoming", hide_canceled: @hide_canceled), active: @filter == "upcoming" },
          { text: "Past", path: manage_casting_production_path(@production, filter: "past", hide_canceled: @hide_canceled), active: @filter == "past" }
        ]
      },
      { separator: true },
      {
        partial: "shared/filters/toggle_filter",
        locals: {
          label: "Hide Canceled Events",
          active: @hide_canceled,
          toggle_action: "click->casting-filter#toggle"
        }
      }
    ] %>

    <!-- Show Cast Assignments Section -->
    <div>
      <% if @shows.any? %>
        <div class="space-y-1">
          <% @shows.each do |show| %>
            <%
              sign_up_regs = @sign_up_registrations_by_show[show.id] || []
            %>
            <%= render "manage/casting/cast_card", show: show, production: @production, title: nil, roles: @roles, roles_count: @roles_count, people_by_id: @people_by_id, groups_by_id: @groups_by_id, sign_up_registrations: sign_up_regs %>
          <% end %>
        </div>
      <% end %>
      <%# What the list above leaves out, said plainly: a date with casting
          off isn't here, and an empty list isn't "nothing scheduled". %>
      <%
        coming = @filter != "past"
        off = @casting_off_in_view
        note = if @dates_in_view.zero? && @canceled_hidden
          coming ? "Every date coming up in #{@production.name} is canceled." : "Every past date of #{@production.name} was canceled."
        elsif @dates_in_view.zero?
          coming ? "No dates are coming up in #{@production.name}." : "#{@production.name} has no past dates."
        elsif @shows.empty?
          if coming
            "Casting is off for #{off == 1 ? 'the one date' : "all #{off} dates"} coming up, so there is nothing to cast here."
          else
            "Casting was off for #{off == 1 ? 'the one past date' : "all #{off} past dates"}."
          end
        elsif off.positive?
          coming ? "Casting is off for #{pluralize(off, 'more date')} coming up." : "Casting was off for #{pluralize(off, 'more past date')}."
        end
        dates_link = coming && off.positive? && current_user_can_manage?(@production)
      %>
      <% if note %>
        <p class="text-gray-600 text-sm <%= 'mt-3' if @shows.any? %>" data-casting-list-note>
          <%= note %>
          <% if dates_link %>
            <%= link_to "Choose which dates are cast", manage_casting_settings_path(@production, anchor: "dates"), class: "text-pink-600 hover:text-pink-700 font-medium" %>
          <% end %>
        </p>
      <% end %>
    </div>
  </div>
</div>
