<%#
  Home on a phone: one day at a time, show by show. The day's name opens a
  calendar of any date, the strip keeps the day in the middle, swipe for the
  next or previous day; each show is a row with its three state chips, and
  opens its modal.
%>
<%
  day = @selected_day
  rows = @home.rows_by_day[day] || []
  sold = rows.sum { |r| r.tickets&.stats&.sold.to_i }
  needing = rows.count { |r| [ home_ticket_chip(r.tickets), home_staffing_chip(r.staffing), home_cast_chip(r.cast) ].compact.any? { |t, _s, _l| t.in?(%i[warn bad]) } }
%>
<div class="sm:hidden space-y-3" data-home-day="<%= day.iso8601 %>"
     data-controller="day-swipe"
     data-day-swipe-prev-url-value="<%= manage_path(day: (day - 1).iso8601) %>"
     data-day-swipe-next-url-value="<%= manage_path(day: (day + 1).iso8601) %>"
     data-action="touchstart->day-swipe#start touchend->day-swipe#end">
  <%= render "shared/day_strip", day: day, id: "home-jump", show_dates: @show_dates, months: @calendar_months,
        day_path: ->(d) { manage_path(day: d.iso8601) } %>

  <% if rows.any? %>
    <div class="flex items-center justify-between text-xs text-gray-500 px-0.5">
      <span><%= pluralize(rows.size, "show") %><%= " · #{sold} sold" if sold.positive? %></span>
      <span><%= needing.zero? ? "Nothing to do" : "#{needing} #{needing == 1 ? 'needs' : 'need'} something" %></span>
    </div>
    <% rows.each do |row| %>
      <%= render "manage/manage/show_row", row: row, size: :phone %>
    <% end %>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg px-4 py-6 text-center text-sm text-gray-500">Nothing on <%= day.strftime("%A") %>.</div>
  <% end %>
</div>
