<% content_for :title, @listing.display_title %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  show = @listing.show
  inventory = @listing.inventory
  status_label, status_classes = ticket_listing_status_badge(@listing, inventory)
  tiers_for_form = @listing.ticket_tiers.active.to_a + [ TicketTier.new, TicketTier.new ]
  tax = TicketTaxSetting.current(@listing.organization)
  default_fee_words = ticketing_profile.default_fee_mode == "buyer" ? "Buyers pay" : "You absorb"
  fee_options = [ [ "Use your default (#{default_fee_words})", "" ], [ "Buyers pay the fees", "buyer" ], [ "You absorb the fees", "org" ] ]
  local_time = ->(time) { time&.in_time_zone&.strftime("%Y-%m-%dT%H:%M") }
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Ticketing", manage_ticketing_path ], [ "Shows on sale", manage_ticket_listings_path ] ],
    text: @listing.display_title,
    links: []
  } %>

  <div class="max-w-2xl space-y-6">
    <%# Where it stands, and the one thing to do next. %>
    <div class="bg-white border border-gray-200 rounded-xl px-6 py-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium <%= status_classes %>"><%= status_label %></span>
            <span class="text-sm text-gray-900"><span class="font-semibold tabular-nums"><%= inventory.sold %></span><%= " of #{inventory.capacity}" if inventory.capacity %> sold</span>
          </div>
          <p class="text-xs text-gray-500 mt-1"><%= show.date_and_time.strftime("%A, %B %-d · %-l:%M %p") %> · <%= ticket_public_path_text(@listing) %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <% case @listing.status %>
          <% when "draft" %>
            <%= render "shared/button", text: "Put on sale", variant: "primary", size: "small", type: :button,
                  data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-put-on-sale" } %>
          <% when "on_sale" %>
            <%= render "shared/button", text: "Pause sales", variant: "secondary", size: "small",
                  path: manage_ticket_listing_status_path(@listing, status: "paused"), method: :post %>
            <%= render "shared/button", text: "Close online sales", variant: "secondary", size: "small", type: :button,
                  data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-close-sales" } %>
          <% when "paused" %>
            <%= render "shared/button", text: "Resume sales", variant: "primary", size: "small",
                  path: manage_ticket_listing_status_path(@listing, status: "on_sale"), method: :post %>
            <%= render "shared/button", text: "Close online sales", variant: "secondary", size: "small", type: :button,
                  data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-close-sales" } %>
          <% when "closed" %>
            <%= render "shared/button", text: "Reopen sales", variant: "primary", size: "small",
                  path: manage_ticket_listing_status_path(@listing, status: "on_sale"), method: :post %>
          <% end %>
        </div>
      </div>
    </div>

    <%= form_with model: @listing, url: manage_ticket_listing_path(@listing), method: :patch, class: "space-y-6" do |f| %>
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Tickets</h2>
          <p class="text-sm text-gray-600 mt-1">Leave seats blank for no limit. A price that has sold is kept for its buyers when you remove it.</p>
        </div>
        <div class="px-6 py-5">
          <div class="hidden sm:grid grid-cols-[minmax(0,1fr)_7rem_6rem_2rem] gap-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500 mb-1.5">
            <span>Name</span><span>Price</span><span>Seats</span><span class="sr-only">Remove</span>
          </div>
          <div class="space-y-2">
            <%= f.fields_for :ticket_tiers, tiers_for_form do |tf| %>
              <% tier = tf.object %>
              <%# Phones: the name gets its own line; price, seats and remove sit under it. %>
              <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)_2rem] sm:grid-cols-[minmax(0,1fr)_7rem_6rem_2rem] gap-2 items-start <%= 'pt-3 border-t border-gray-100 sm:pt-0 sm:border-0' unless tf.index.zero? %>">
                <div class="col-span-3 sm:col-span-1">
                  <%= tf.text_field :name, placeholder: tier.persisted? ? nil : "Add a price", "aria-label": "Ticket name", class: input_class %>
                  <% if tier.persisted? && (sold = inventory.sold(tier: tier)).positive? %>
                    <p class="text-xs text-gray-500 mt-1"><%= sold %> sold</p>
                  <% end %>
                </div>
                <div>
                  <span class="sm:hidden block text-[11px] font-semibold uppercase tracking-wide text-gray-500 mb-1">Price</span>
                  <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">$</span>
                    <%= tf.text_field :price, value: (tier.persisted? ? format("%.2f", tier.price_cents / 100.0) : nil), inputmode: "decimal", placeholder: "0.00", "aria-label": "Price", class: "#{input_class} pl-7" %>
                  </div>
                </div>
                <div>
                  <span class="sm:hidden block text-[11px] font-semibold uppercase tracking-wide text-gray-500 mb-1">Seats</span>
                  <%= tf.number_field :quantity, min: 1, placeholder: "Any", "aria-label": "Seats", class: input_class %>
                </div>
                <% if tier.persisted? %>
                  <label class="self-end sm:self-start flex h-10 items-center justify-center cursor-pointer text-gray-400 hover:text-pink-600" title="Remove this price">
                    <%= tf.check_box :_destroy, class: "sr-only peer" %>
                    <svg class="w-5 h-5 peer-checked:text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                  </label>
                <% else %>
                  <span></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Sales</h2>
        </div>
        <div class="px-6 py-5 space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="ticket_listing_on_sale_at" class="block text-sm font-medium text-gray-700 mb-1.5">Sales open</label>
              <%= f.datetime_local_field :on_sale_at, value: local_time.call(@listing.on_sale_at), class: input_class %>
              <p class="text-xs text-gray-500 mt-1">Blank: as soon as it's put on sale.</p>
            </div>
            <div>
              <label for="ticket_listing_off_sale_at" class="block text-sm font-medium text-gray-700 mb-1.5">Online sales close</label>
              <%= f.datetime_local_field :off_sale_at, value: local_time.call(@listing.off_sale_at), class: input_class %>
              <p class="text-xs text-gray-500 mt-1">Showtime by default; after that it's door sales.</p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="ticket_listing_capacity" class="block text-sm font-medium text-gray-700 mb-1.5">Seats in the room</label>
              <%= f.number_field :capacity, min: 1, placeholder: "Add up the prices' seats", class: input_class %>
            </div>
            <div>
              <label for="ticket_listing_max_per_order" class="block text-sm font-medium text-gray-700 mb-1.5">Most tickets in one order</label>
              <%= f.number_field :max_per_order, min: 1, max: 100, placeholder: ticketing_profile.default_max_per_order.to_s, class: input_class %>
            </div>
          </div>
          <div>
            <label for="ticket_listing_fee_mode" class="block text-sm font-medium text-gray-700 mb-1.5">Who pays the fees</label>
            <%= f.select :fee_mode, options_for_select(fee_options, @listing.fee_mode.to_s), {}, class: input_class %>
          </div>
          <p class="text-sm text-gray-600">
            Tax: <%= tax.set? ? "#{tax.percent}% #{tax.name.downcase}, #{tax.mode == 'included' ? 'included in prices' : 'added at checkout'}" : "none" %>.
            <%= link_to "Change in Ticketing settings", manage_ticketing_settings_section_path(section: "tax"), class: "text-pink-600 hover:text-pink-700" %>
          </p>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">The page</h2>
          <p class="text-sm text-gray-600 mt-1">What buyers see. Anything left blank comes from the show and production.</p>
        </div>
        <div class="px-6 py-5 space-y-5">
          <div>
            <label for="ticket_listing_title" class="block text-sm font-medium text-gray-700 mb-1.5">Title</label>
            <%= f.text_field :title, placeholder: show.display_name, class: input_class %>
          </div>
          <div>
            <label for="ticket_listing_description" class="block text-sm font-medium text-gray-700 mb-1.5">Description</label>
            <%= f.text_area :description, rows: 5, placeholder: @listing.production.description.to_s.truncate(200), class: input_class %>
          </div>
          <div>
            <label for="ticket_listing_image" class="block text-sm font-medium text-gray-700 mb-1.5">Event image</label>
            <% if @listing.image.attached? %>
              <%= image_tag url_for(@listing.image), alt: "", class: "mb-2 w-full max-w-sm aspect-video object-cover rounded-lg border border-gray-200" %>
            <% end %>
            <%= f.file_field :image, accept: "image/jpeg,image/png,image/webp",
                  class: "block w-full text-sm text-gray-600 file:mr-3 file:rounded-lg file:border-0 file:bg-pink-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-pink-700 hover:file:bg-pink-100" %>
            <p class="text-xs text-gray-500 mt-1">16:9, ideally 1920×1080 (at least 1200×675). JPG, PNG or WebP up to 10 MB.</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="ticket_listing_door_note" class="block text-sm font-medium text-gray-700 mb-1.5">Doors</label>
              <%= f.text_field :door_note, placeholder: "Doors 30 min before", class: input_class %>
            </div>
            <div>
              <label for="ticket_listing_age_note" class="block text-sm font-medium text-gray-700 mb-1.5">Ages</label>
              <%= f.text_field :age_note, placeholder: "18+", class: input_class %>
            </div>
            <div>
              <label for="ticket_listing_accessibility_note" class="block text-sm font-medium text-gray-700 mb-1.5">Accessibility</label>
              <%= f.text_field :accessibility_note, placeholder: "Step-free entry", class: input_class %>
            </div>
          </div>
        </div>
      </div>

      <div>
        <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>

    <%# Discount codes: their own forms, so they sit outside the page form. %>
    <div id="discount-codes" class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Discount codes</h2>
        <p class="text-sm text-gray-600 mt-1">Codes buyers can enter at checkout for this show.</p>
      </div>
      <% codes = @listing.ticket_discount_codes.where(active: true).order(:code).to_a %>
      <% if codes.any? %>
        <div class="divide-y divide-gray-100">
          <% codes.each do |code| %>
            <div class="flex items-center justify-between gap-3 px-6 py-3">
              <div class="min-w-0">
                <span class="font-mono text-sm font-semibold text-gray-900"><%= code.code %></span>
                <span class="text-sm text-gray-600"> · <%= code.kind == "percent" ? "#{format('%g', code.percent)}% off" : "#{number_to_currency(code.amount_cents / 100.0)} off" %></span>
                <span class="text-xs text-gray-500"> · used <%= pluralize(code.uses_count, "time") %><%= " of #{code.max_uses}" if code.max_uses %></span>
              </div>
              <% cid = "confirm-remove-code-#{code.id}" %>
              <%= render "shared/button", text: "Remove", variant: "secondary", size: "small", type: :button,
                    data: { controller: "modal", action: "click->modal#open", modal_id: cid } %>
              <%= render "shared/confirm_modal", id: cid, title: "Remove #{code.code}?",
                    message: "Buyers won't be able to use it anymore. Orders that already used it keep their discount.",
                    confirm_text: "Remove code", url: manage_ticket_listing_code_path(@listing, code_id: code.id), method: :delete %>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= form_with scope: :ticket_discount_code, url: manage_ticket_listing_codes_path(@listing), method: :post, class: "px-6 py-5 border-t border-gray-100" do |cf| %>
        <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,1fr)_7rem_7rem_6rem] gap-2">
          <%= cf.text_field :code, placeholder: "FRIENDS", "aria-label": "Code", class: "#{input_class} uppercase" %>
          <%= cf.select :kind, options_for_select([ [ "$ off", "fixed" ], [ "% off", "percent" ] ]), {}, "aria-label": "Kind", class: input_class %>
          <%= cf.text_field :amount, inputmode: "decimal", placeholder: "5", "aria-label": "Amount", class: input_class %>
          <%= cf.number_field :max_uses, min: 1, placeholder: "Uses", "aria-label": "Most uses", class: input_class %>
        </div>
        <div class="mt-3">
          <%= render "shared/button", text: "Add code", variant: "secondary", size: "small", type: :submit %>
        </div>
      <% end %>
    </div>

    <% if @listing.status == "draft" && !@listing.ticket_orders.exists? %>
      <div class="pt-2">
        <%= render "shared/button", text: "Remove from Ticketing", variant: "ghost", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-remove-listing" } %>
      </div>
    <% end %>
  </div>
</div>

<%= render "shared/confirm_modal", id: "confirm-put-on-sale", title: "Put this show on sale?",
      message: "Buyers can get tickets at #{h(ticket_public_path_text(@listing))}#{' once ticketing is on for your organization' unless ticketing_profile.enabled?}.",
      confirm_text: "Put on sale", url: manage_ticket_listing_status_path(@listing), method: :post, params: { status: "on_sale" } %>
<%= render "shared/confirm_modal", id: "confirm-close-sales", title: "Close online sales?",
      message: "Nobody can buy online after this. Door sales and check-in keep working, and you can reopen sales any time.",
      confirm_text: "Close online sales", url: manage_ticket_listing_status_path(@listing), method: :post, params: { status: "closed" } %>
<%= render "shared/confirm_modal", id: "confirm-remove-listing", title: "Remove this show from Ticketing?",
      message: "Its page and prices are deleted. The show itself stays on your calendar.",
      confirm_text: "Remove", url: manage_ticket_listing_path(@listing), method: :delete %>
