<% content_for :title, "Report Ticket Sales" %>

<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["My Contracts", my_contracts_path]
    ],
    text: "Report Ticket Sales",
    links: []
  } %>

  <div class="max-w-3xl mx-auto mt-4">
    <%# Wrapped in a frame so the same form can lazy-load into the My Contracts modal. %>
    <%= turbo_frame_tag "report_sales_#{@contract.id}" do %>
      <%= render "my/contracts/report_sales_form" %>
    <% end %>
  </div>
</div>
