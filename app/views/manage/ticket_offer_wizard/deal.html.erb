<% input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
<% kind = wizard_state[:deal_kind] || "amount_off" %>
<%= render layout: "manage/ticket_offer_wizard/wizard_layout", locals: { step: :deal } do %>
  <h2 class="text-xl font-bold text-gray-900 mb-2 coustard-regular">The deal</h2>
  <p class="text-gray-600 mb-6">How much less the other show costs them.</p>

  <%= form_with url: manage_ticket_offer_wizard_save_deal_path, method: :post, local: true, data: { controller: "radio-card" } do %>
    <div class="space-y-2">
      <%= render layout: "manage/ticket_offer_wizard/choice_card", locals: { name: "deal_kind", value: "amount_off", selected: kind,
            title: "An amount off", hint: "$5 off a $20 ticket is $15." } do %>
        <div class="relative w-40">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">$</span>
          <%= text_field_tag :amount, wizard_state[:amount], inputmode: "decimal", placeholder: "5.00", "aria-label": "Amount off", class: "#{input_class} pl-7" %>
        </div>
      <% end %>
      <%= render layout: "manage/ticket_offer_wizard/choice_card", locals: { name: "deal_kind", value: "percent_off", selected: kind,
            title: "A percent off", hint: "20% off a $20 ticket is $16." } do %>
        <div class="relative w-40">
          <%= text_field_tag :percent, wizard_state[:percent], inputmode: "decimal", placeholder: "20", "aria-label": "Percent off", class: "#{input_class} pr-8" %>
          <span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">%</span>
        </div>
      <% end %>
      <%= render layout: "manage/ticket_offer_wizard/choice_card", locals: { name: "deal_kind", value: "price", selected: kind,
            title: "A set price", hint: "Whatever the ticket usually costs, they pay this." } do %>
        <div class="relative w-40">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">$</span>
          <%= text_field_tag :price, wizard_state[:price], inputmode: "decimal", placeholder: "12.00", "aria-label": "Set price", class: "#{input_class} pl-7" %>
        </div>
      <% end %>
    </div>

    <div class="mt-6 pt-6 border-t border-gray-200 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="max_per_order" class="block text-sm font-medium text-gray-700 mb-1.5">Most per order <span class="font-normal text-gray-500">(optional)</span></label>
        <%= number_field_tag :max_per_order, wizard_state[:max_per_order], min: 1, placeholder: "One per ticket they buy", class: input_class %>
      </div>
      <div>
        <label for="max_uses" class="block text-sm font-medium text-gray-700 mb-1.5">Most tickets in all <span class="font-normal text-gray-500">(optional)</span></label>
        <%= number_field_tag :max_uses, wizard_state[:max_uses], min: 1, placeholder: "No limit", class: input_class %>
      </div>
    </div>

    <div class="mt-8 flex justify-between">
      <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", icon: "arrow-left", path: manage_ticket_offer_wizard_offer_path %>
      <%= render "shared/button", text: "Next: Review", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>
