<%# Full three-tier feature comparison. Self-contained; reused on /new and /pricing. %>
<%
  check_svg = '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>'.html_safe
  chk  = -> { content_tag(:span, check_svg, class: "inline-flex text-green-600") }
  dash = -> { content_tag(:span, "—", class: "text-slate-300") }
  txt  = ->(s) { content_tag(:span, s, class: "text-sm text-slate-700") }

  comparison = [
    ["Productions &amp; events", [
      ["Productions", txt.("1"), txt.("Unlimited"), txt.("Unlimited")],
      ["Events per month", txt.("6"), txt.("Unlimited"), txt.("Unlimited")],
      ["Shows, rehearsals &amp; events", chk.(), chk.(), chk.()],
      ["Courses &amp; classes", chk.(), chk.(), chk.()]
    ]],
    ["Casting &amp; auditions", [
      ["Roles &amp; talent pools", chk.(), chk.(), chk.()],
      ["Auditions &amp; sign-ups", chk.(), chk.(), chk.()],
      ["Availability tracking", chk.(), chk.(), chk.()],
      ["Multi-show casting tables", dash.(), chk.(), chk.()]
    ]],
    ["People &amp; docs", [
      ["Contacts &amp; groups", chk.(), chk.(), chk.()],
      ["Documents", chk.(), chk.(), chk.()],
      ["Messaging", chk.(), chk.(), chk.()]
    ]],
    ["Money &amp; contracts", [
      ["Payouts &amp; splits", dash.(), chk.(), chk.()],
      ["Financials &amp; reports", dash.(), chk.(), chk.()],
      ["Contracts + e-sign", dash.(), chk.(), chk.()],
      ["Performer agreements", dash.(), chk.(), chk.()]
    ]],
    ["Staffing &amp; payroll", [
      ["Scheduling &amp; shifts", dash.(), chk.(), chk.()],
      ["Timesheets &amp; approvals", dash.(), chk.(), chk.()],
      ["Payroll &amp; tips", dash.(), chk.(), chk.()],
      ["Contractor payments + tax", dash.(), chk.(), chk.()],
      ["W-2 employees &amp; full payroll", dash.(), dash.(), chk.()],
      ["Staffing volume", dash.(), txt.("Standard"), txt.("High-volume")]
    ]],
    ["Support", [
      ["Email support", chk.(), chk.(), chk.()],
      ["Dedicated onboarding &amp; priority support", dash.(), dash.(), chk.()]
    ]]
  ]
%>

<div class="space-y-6">
  <% comparison.each do |group_name, rows| %>
    <div class="border border-slate-200 rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[40rem] text-left">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200">
              <th class="px-5 py-3 text-sm font-bold text-slate-900"><%= group_name.html_safe %></th>
              <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide w-32">Producer</th>
              <th class="px-5 py-3 text-xs font-semibold text-pink-600 uppercase tracking-wide w-32">Pro</th>
              <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide w-36">Enterprise</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% rows.each do |label, producer_cell, pro_cell, enterprise_cell| %>
              <tr>
                <td class="px-5 py-3 text-sm text-slate-800"><%= label.html_safe %></td>
                <td class="px-5 py-3"><%= producer_cell %></td>
                <td class="px-5 py-3 bg-pink-50/40"><%= pro_cell %></td>
                <td class="px-5 py-3"><%= enterprise_cell %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
