<%# One show's ticket numbers (Ticketing::ListingStats): tiles, sales by
    ticket type, and discount codes used. The manager's
    show page and the producer view both render it. Locals: stats, read_only
    (producers see sales, not what the theater keeps). %>
<%
  read_only = local_assigns.fetch(:read_only, false)
  listing = stats.listing
  money = ->(cents) { number_to_currency(cents / 100.0) }
  started = listing.show.date_and_time <= Time.current
  tiles = [
    [ "Sold", stats.capacity ? "#{stats.sold} of #{stats.capacity}" : stats.sold.to_s, stats.capacity && stats.capacity.positive? ? "#{(stats.sold * 100.0 / stats.capacity).round}% full" : "No seat limit", nil ],
    [ "Ticket sales", money.call(stats.gross_cents), "Before fees and tax", nil ],
    (read_only ? nil : [ "You keep", money.call(stats.net_cents), stats.tax_cents.positive? ? "Plus #{money.call(stats.tax_cents)} tax to pay" : "After fees and refunds", nil ]),
    (started ? [ "Checked in", "#{stats.checked_in} of #{stats.sold}", stats.no_shows.to_i.positive? ? "#{stats.no_shows} didn't come" : "Everyone came", nil ] : nil),
    [ "Comps", stats.comps.to_s, "Given away free", stats.comps.positive? ? "bg-blue-50 border-blue-200" : nil ],
    [ "Refunded", stats.refunded_tickets.to_s, stats.refunded_cents.positive? ? "#{money.call(stats.refunded_cents)} back" : "None", stats.refunded_tickets.positive? ? "bg-amber-50 border-amber-200" : nil ]
  ].compact
  codes = stats.discount_uses
%>
<div class="space-y-6">
  <%# Literal class names, so Tailwind sees each one. %>
  <div class="grid grid-cols-2 <%= { 4 => 'lg:grid-cols-4', 5 => 'lg:grid-cols-5' }.fetch(tiles.size, 'lg:grid-cols-6') %> gap-3">
    <% tiles.each do |label, value, note, tint| %>
      <div class="rounded-lg border px-4 py-3 <%= tint || 'bg-white border-gray-200' %>">
        <div class="text-xs text-gray-500"><%= label %></div>
        <div class="text-xl font-bold tabular-nums text-gray-900 mt-0.5"><%= value %></div>
        <div class="text-xs text-gray-500 mt-0.5"><%= note %></div>
      </div>
    <% end %>
  </div>
  <% if stats.capacity.to_i.positive? %>
    <div class="h-2 rounded-full bg-gray-100 overflow-hidden" aria-hidden="true">
      <div class="h-full bg-pink-500" style="width: <%= [ stats.sold * 100.0 / stats.capacity, 100 ].min.round(1) %>%"></div>
    </div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-200"><h2 class="text-sm font-semibold text-gray-900">By ticket type</h2></div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500">
          <tr>
            <th class="px-5 py-2 text-left font-medium">Ticket</th>
            <th class="px-3 py-2 text-right font-medium">Price</th>
            <th class="px-3 py-2 text-right font-medium">Sold</th>
            <th class="px-3 py-2 text-right font-medium">In checkout</th>
            <th class="px-3 py-2 text-right font-medium">Left</th>
            <th class="px-5 py-2 text-right font-medium">Sales</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% stats.by_tier.each do |row| %>
            <tr class="whitespace-nowrap <%= 'text-gray-400' if row.tier.archived_at %>">
              <td class="px-5 py-2.5 text-gray-900"><%= row.tier.name %><%= " (removed)" if row.tier.archived_at %></td>
              <td class="px-3 py-2.5 text-right tabular-nums"><%= ticket_price(row.tier.price_cents) %></td>
              <td class="px-3 py-2.5 text-right tabular-nums"><%= row.sold %><%= " of #{row.seats}" if row.seats %></td>
              <td class="px-3 py-2.5 text-right tabular-nums"><%= row.held %></td>
              <td class="px-3 py-2.5 text-right tabular-nums"><%= row.remaining.nil? ? "No limit" : row.remaining %></td>
              <td class="px-5 py-2.5 text-right tabular-nums"><%= money.call(row.gross_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if codes.any? %>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <h2 class="text-sm font-semibold text-gray-900">Discount codes</h2>
      <ul class="mt-2 space-y-1 text-sm">
        <% codes.each do |code, orders, cents| %>
          <li class="flex justify-between gap-3"><span class="text-gray-900"><%= code %> <span class="text-gray-500">· <%= pluralize(orders, "order") %></span></span><span class="tabular-nums text-gray-600">−<%= money.call(cents) %></span></li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
