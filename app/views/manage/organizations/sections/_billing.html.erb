<div class="border border-gray-200 rounded-lg overflow-hidden bg-white">
  <%= render "shared/section_heading", title: "Billing & Plan" %>
  <div class="p-6 bg-white">
    <%= render "manage/billing/comp_ending", organization: @organization %>
    <%= render "manage/billing/plan_summary", organization: @organization %>
    <%# Usage ($5 a staff member, $3 everyone else paid, bank debits beyond the
        free ones) is Pro-only: the features that pay people are unavailable on
        the Producer plan, so there's nothing to bill or show a free org here. %>
    <% if @organization.bills_usage? %>
      <%= render "manage/billing/usage", organization: @organization %>
    <% elsif @organization.on_paid_plan? %>
      <p class="mt-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
        Usage is complimentary: the people you pay through CocoScout and your bank debits aren't billed.
      </p>
    <% end %>
    <%= render "manage/billing/bills", organization: @organization %>
    <%= render "manage/billing/contacts", organization: @organization %>
    <div class="mt-6">
      <%= render "manage/funding_source", org: @organization,
            return_to: section_manage_organization_path(@organization, section: "billing") %>
    </div>
  </div>
</div>
