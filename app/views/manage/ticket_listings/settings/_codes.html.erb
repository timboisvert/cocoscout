<%# Discount codes for this date, and the production's that work here too.
    Locals: listing, setup. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  codes = listing.ticket_discount_codes.where(active: true).order(:code).to_a
  production_codes = listing.organization.ticket_discount_codes.where(production: listing.production, active: true).order(:code).to_a
  describe = ->(code) { code.kind == "percent" ? "#{format('%g', code.percent)}% off" : "#{number_to_currency(code.amount_cents / 100.0)} off" }
%>
<p class="text-sm text-gray-600">Codes buyers can enter at checkout, good for this date (<%= ticket_listing_date_label(listing) %>) only.</p>
<div>
  <% if codes.any? %>
    <div class="divide-y divide-gray-100 border-y border-gray-200">
      <% codes.each do |code| %>
        <div class="flex items-center justify-between gap-3 py-3">
          <div class="min-w-0">
            <span class="font-mono text-sm font-semibold text-gray-900"><%= code.code %></span>
            <span class="text-sm text-gray-600"> · <%= describe.call(code) %></span>
            <span class="text-xs text-gray-500"> · used <%= pluralize(code.uses_count, "time") %><%= " of #{code.max_uses}" if code.max_uses %></span>
          </div>
          <%= render "shared/button", text: "Remove", variant: "secondary", size: "small", type: :button,
                data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-remove-code-#{code.id}" } %>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= form_with scope: :ticket_discount_code, url: manage_ticket_listing_codes_path(listing), method: :post, class: "pt-5" do |cf| %>
    <%= render "manage/ticketing/code_fields", cf: cf, input_class: input_class %>
    <div class="mt-3">
      <%= render "shared/button", text: "Add code", variant: "secondary", size: "small", type: :submit %>
    </div>
  <% end %>
</div>

<% if production_codes.any? %>
  <div class="pt-5 border-t border-gray-200">
    <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Also good here</h3>
    <p class="text-sm text-gray-600 mt-1">Codes for every date of <%= listing.production.name %>.
      <%= link_to "Manage them", manage_edit_production_ticketing_path(listing.production, section: "codes"), class: "font-medium text-pink-600 hover:text-pink-700" %></p>
    <ul class="mt-3 space-y-1 text-sm">
      <% production_codes.each do |code| %>
        <li><span class="font-mono font-semibold text-gray-900"><%= code.code %></span> <span class="text-gray-600">· <%= describe.call(code) %></span></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% codes.each do |code| %>
  <%= render "shared/confirm_modal", id: "confirm-remove-code-#{code.id}", title: "Remove #{code.code}?",
        message: "Buyers won't be able to use it anymore. Orders that already used it keep their discount.",
        confirm_text: "Remove code", url: manage_ticket_listing_code_path(listing, code_id: code.id), method: :delete %>
<% end %>
