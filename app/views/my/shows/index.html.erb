<%# V1.1 says "Shows & Events" (Tim, 2026-10-20); V1 phones keep their words. %>
<% content_for :title, "My Shows & Events" %>

<div class="w-full">

  <%= render partial: "shared/notice", locals: { notice: notice } %>


  <%= render "shared/module_header", title: "My Shows & Events" %>

  <!-- Pending Vacancy Invitations -->
  <%= render "my/vacancy_invitation_alerts", invitations: @pending_vacancy_invitations %>

  <% if @has_any_shows %>

  <%# Two filters (Tim, 2026-10-18): what to list, and when. %>
  <%= render "shared/filters/filter_bar",
      toggle_label: "Filters & View Options",
      filter_groups: [
        {
          label: "View",
          filters: [
            { text: "My Assignments", path: my_shows_path(filter: 'my_assignments', when: @when, event_type: @event_type_filter.join(','), entity: @entity_filter.join(','), production: @production_filter), active: @filter == 'my_assignments' },
            { text: "All Shows", path: my_shows_path(filter: 'all', when: @when, event_type: @event_type_filter.join(','), entity: @entity_filter.join(','), production: @production_filter), active: @filter == 'all' }
          ]
        },
        { separator: true },
        {
          label: "When",
          filters: [
            { text: "Upcoming", path: my_shows_path(filter: @filter, when: 'upcoming', event_type: @event_type_filter.join(','), entity: @entity_filter.join(','), production: @production_filter), active: @when == 'upcoming' },
            { text: "Past", path: my_shows_path(filter: @filter, when: 'past', event_type: @event_type_filter.join(','), entity: @entity_filter.join(','), production: @production_filter), active: @when == 'past' }
          ]
        },
        { separator: true },
        {
          partial: "shared/filters/entity_filter",
          locals: {
            path_helper: method(:my_shows_path),
            people: @people,
            groups: @groups,
            entity_filter: @entity_filter,
            label: "Include",
            filter: @filter,
            when: @when,
            event_type: @event_type_filter.join(","),
            production: @production_filter
          }
        },
        (@filter_productions.size > 1 ? { separator: true } : nil),
        (@filter_productions.size > 1 ? {
          partial: "shared/filters/production_dropdown_filter",
          locals: {
            label: "Production",
            name: "production",
            options: [{ value: "", text: "All Productions" }] + @filter_productions.map { |p| { value: p.id.to_s, text: p.name, type: p.production_type } },
            selected: @production_filter.to_s,
            extra_url_params: { filter: @filter, when: @when, event_type: @event_type_filter.join(","), entity: @entity_filter.join(",") }
          }
        } : nil)
      ].compact
  %>

  <% if @show_entity_rows.any? %>
    <%= render "shared/shows_list",
               show_rows: @show_entity_rows,
               show_production: true,
               show_location: true,
               has_groups: @groups.any?,
               show_cant_make_it: @when == 'upcoming',
               cant_make_it_person: @person,
               my_vacancies_by_show: @my_vacancies_by_show,
               newest_first: @when == 'past',
               link_path_helper: ->(show) { my_show_path(show) } %>
  <% else %>
    <div class="text-sm text-gray-500">
      <%= @when == 'past' ? "Nothing in the past for these filters." : "No upcoming shows or events found for the selected filters." %>
    </div>
  <% end %>

  <% else %>
    <%= render "shared/empty_state", icon: "calendar", title: "No shows yet", body: "When a production casts you, or you sign up for one of its events, it shows up here." %>
  <% end %>

</div>