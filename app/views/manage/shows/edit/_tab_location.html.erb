<%# Location: a venue and room, or online. Mirrors the wizard's Location
    step. Locals: form, input_class, location_spaces_map. %>
<%= render layout: "manage/shows/edit/card", locals: { title: "Where" } do %>
  <%= form.hidden_field :is_online, value: @show.is_online, data: { "location-modal-target": "isOnlineField" } %>

  <%# In person %>
  <div data-location-modal-target="inPersonContainer" class="space-y-4 <%= 'hidden' if @show.is_online %>">
    <div>
      <%= form.label :location_id, "Location", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
      <%= form.collection_select :location_id, Current.organization.locations.order(:created_at), :id, :name,
            { prompt: "Select a location" },
            { class: "#{input_class} #{'!border-pink-500' if @show.errors[:location_id].any?}",
              data: { "location-modal-target": "locationSelect", action: "change->location-modal#handleLocationChange" } } %>
      <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm">
        <a href="#" data-action="click->location-modal#openModal" class="font-medium text-pink-600 hover:text-pink-700">Add a location</a>
        <a href="#" data-action="click->location-modal#toggleLocationType" class="font-medium text-pink-600 hover:text-pink-700" data-location-modal-target="toggleLink">
          <span data-location-modal-target="toggleLinkText">Host <%= @show.event_type&.titleize&.downcase || 'event' %> online</span>
        </a>
      </div>
    </div>

    <% current_spaces = location_spaces_map[@show.location_id] || [] %>
    <div data-location-modal-target="spaceContainer" class="<%= 'hidden' if current_spaces.empty? %>">
      <%= form.label :location_space_id, "Space", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
      <%= form.select :location_space_id,
            options_for_select(current_spaces.map { |s| [ s[:name], s[:id] ] }, @show.location_space_id),
            { include_blank: "Entire venue" },
            { class: input_class, data: { "location-modal-target": "spaceSelect" } } %>
    </div>
  </div>

  <%# Online %>
  <div data-location-modal-target="onlineContainer" class="<%= 'hidden' unless @show.is_online %>">
    <%= form.label :online_location_info, "Online details", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
    <%= form.text_field :online_location_info, placeholder: "A Zoom link, a YouTube Live address, or 'Link will be emailed'", class: input_class %>
    <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm">
      <span class="text-gray-500">Optional: a link or instructions for joining.</span>
      <a href="#" data-action="click->location-modal#toggleLocationType" class="font-medium text-pink-600 hover:text-pink-700" data-location-modal-target="toggleLink">
        <span data-location-modal-target="toggleLinkText">Host <%= @show.event_type&.titleize&.downcase || 'event' %> in person</span>
      </a>
    </div>
  </div>
<% end %>
