<% content_for :title, "My Messages" %>

<div class="w-full pb-8" data-controller="contact-production message-density">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [],
    text: "My Messages",
    links: [
      { icon: "check", text: "Mark All Read", path: mark_all_read_my_messages_path, method: :post, disabled: @unread_count == 0 }
    ]
  } %>

  <%# Notifications, at the top of Messages (V1.1 plan §9): automated notices
      left Messages for the bell, and the V1 apps have no bell, so this row
      is how their phones (and anyone looking here) reach them. %>
  <% unread_notifications = Current.user.unread_notification_count %>
  <%= link_to notifications_path, class: "mt-4 flex items-center gap-3 rounded-lg border px-4 py-3 transition-colors #{unread_notifications.positive? ? 'border-pink-200 bg-pink-50 hover:bg-pink-100/70' : 'border-gray-200 bg-white hover:bg-gray-50'}", data: { notifications_row: true } do %>
    <span class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 <%= unread_notifications.positive? ? 'bg-white text-pink-600' : 'bg-gray-100 text-gray-500' %>">
      <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10 21a2 2 0 0 0 4 0"/></svg>
    </span>
    <span class="min-w-0 flex-1">
      <span class="block text-sm font-semibold text-gray-900">Notifications</span>
      <span class="block text-xs text-gray-600"><%= unread_notifications.positive? ? "#{unread_notifications} unread: casting, sign-ups, pay, contracts and more" : "Casting, sign-ups, pay, contracts and more" %></span>
    </span>
    <% if unread_notifications.positive? %>
      <span class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 text-xs font-bold text-white bg-pink-500 rounded-full"><%= unread_notifications > 99 ? "99+" : unread_notifications %></span>
    <% end %>
    <svg class="w-4 h-4 text-gray-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
  <% end %>

  <%# Contact Production Team Card %>
  <% if @contactable_productions.any? %>
    <div class="mt-4">
      <% if @contactable_productions.size == 1 %>
        <%= render "shared/contact_production_card", production: @contactable_productions.first %>
      <% else %>
        <%= render "shared/contact_production_card", productions: @contactable_productions %>
      <% end %>
    </div>
  <% end %>

  <%# Search + Filter Bar %>
  <%= form_with url: my_messages_path, method: :get, data: { turbo_action: "advance" }, class: "mt-4" do |f| %>
    <%# Search sits above the filter box, spanning the row. %>
    <div class="mb-3">
      <%= render "shared/filters/search_input",
            placeholder: "Search messages...", value: @search, name: "q", full_width: true %>
    </div>

    <%= render "shared/filters/filter_bar",
        toggle_label: "Filters",
        wrapper_data_controller: "filter-select",
        filter_groups: [
          {
            label: "Show",
            filters: [
              { text: "All", path: my_messages_path(q: @search, production_id: @production_filter, order: @order), active: @filter == "all" },
              { text: "Unread", path: my_messages_path(filter: "unread", q: @search, production_id: @production_filter, order: @order), active: @filter == "unread" },
              { text: "Archived", path: my_messages_path(filter: "archived", q: @search, production_id: @production_filter, order: @order), active: @filter == "archived" }
            ]
          },
          { separator: true },
          {
            partial: "shared/filters/order_toggle",
            locals: {
              current_order: @order,
              newest_path: my_messages_path(order: "newest", filter: @filter, q: @search, production_id: @production_filter),
              oldest_path: my_messages_path(order: "oldest", filter: @filter, q: @search, production_id: @production_filter)
            }
          },
          (@user_productions.any? ? { separator: true } : nil),
          (@user_productions.any? ? {
            partial: "shared/filters/production_dropdown_filter",
            locals: {
              label: "Production",
              name: "production_id",
              options: [{ value: "", text: "All Productions" }] + @user_productions.map { |p| { value: p.id.to_s, text: p.name, type: p.production_type } },
              selected: @production_filter.to_s,
              data_attributes: {
                action: "change->filter-select#update",
                filter_select_filter_value: @filter,
                filter_select_q_value: @search,
                filter_select_order_value: @order
              }
            }
          } : nil),
          { separator: true },
          { partial: "shared/filters/layout_filter" }
        ].compact
    %>
    <%# Hidden fields to preserve filters when searching %>
    <%= f.hidden_field :filter, value: @filter %>
    <%= f.hidden_field :production_id, value: @production_filter %>
    <%= f.hidden_field :order, value: @order %>
  <% end %>

  <% if @messages.any? %>
    <div data-message-density-target="list" class="mt-4 msg-density-compact border border-gray-200 rounded-lg overflow-hidden bg-white">
      <% @messages.each do |thread| %>
        <%= render "shared/messages/compact_row", message: thread, summary: @thread_summaries[thread.id] %>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-6 flex items-center justify-between">
        <div class="text-sm text-gray-500">
          Page <%= @pagy.page %> of <%= @pagy.pages %>
        </div>
        <div class="flex gap-2">
          <% if @pagy.previous %>
            <%= render "shared/button", text: "← Previous", variant: "secondary", size: "small", path: my_messages_path(page: @pagy.previous, filter: @filter, q: @search, production_id: @production_filter, order: @order) %>
          <% else %>
            <%= render "shared/button", text: "← Previous", variant: "secondary", size: "small", disabled: true %>
          <% end %>
          <% if @pagy.next %>
            <%= render "shared/button", text: "Next →", variant: "secondary", size: "small", path: my_messages_path(page: @pagy.next, filter: @filter, q: @search, production_id: @production_filter, order: @order) %>
          <% else %>
            <%= render "shared/button", text: "Next →", variant: "secondary", size: "small", disabled: true %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="mt-8 text-center py-12">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      <%
        empty_title, empty_message = case @filter
        when "unread"
          ["All caught up!", "You have no unread messages."]
        when "has_images"
          ["No messages with images", "None of your messages contain images."]
        when "archived"
          ["No archived messages", "You haven't archived any messages yet."]
        else
          if @search.present?
            ["No results", "No messages match \"#{@search}\"."]
          elsif @production_filter.present?
            ["No messages", "No messages for this production yet."]
          else
            ["No messages", "Your inbox is empty."]
          end
        end
      %>
      <h3 class="mt-2 text-sm font-medium text-gray-900"><%= empty_title %></h3>
      <p class="mt-1 text-sm text-gray-500"><%= empty_message %></p>
    </div>
  <% end %>

  <%# Contact Production Modal %>
  <% if @contactable_productions.any? %>
    <%= render "shared/contact_production_modal" %>
  <% end %>
</div>