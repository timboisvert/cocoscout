<%# Messages (mail) or Notifications (bell): the two universal icons, the same
    in both modes. Locals: kind (:messages or :notifications), path, count, active,
    size (:panel, default, or :bar for the phone's top bar). %>
<% bar = local_assigns[:size] == :bar %>
<% label = kind == :messages ? "Messages" : "Notifications" %>
<%= link_to path, class: "relative flex items-center justify-center flex-shrink-0 transition-colors #{bar ? 'w-11 h-11 text-gray-700' : "w-[34px] h-[34px] rounded-[10px] border #{active ? 'border-pink-300 bg-pink-50 text-pink-600' : 'border-gray-200 bg-white text-gray-700 hover:border-pink-300 hover:text-pink-600'}"}",
      aria: { label: count.to_i.positive? ? "#{label}, #{count} unread" : label, current: (active ? "page" : nil) }, data: { universal_icon: kind } do %>
  <% if kind == :messages %>
    <svg class="<%= bar ? 'w-[22px] h-[22px]' : 'w-[18px] h-[18px]' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
  <% else %>
    <svg class="<%= bar ? 'w-[22px] h-[22px]' : 'w-[18px] h-[18px]' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10 21a2 2 0 0 0 4 0"/></svg>
  <% end %>
  <% if count.to_i.positive? %>
    <span class="absolute <%= bar ? 'top-1.5 right-1' : '-top-1.5 -right-1.5' %> inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 text-[10px] font-bold text-white bg-pink-500 rounded-full ring-2 ring-white"><%= count > 99 ? "99+" : count %></span>
  <% end %>
<% end %>
