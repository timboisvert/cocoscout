<% content_for :title, "Record money" %>
<%
  tabs = [ [ "out", "Money out" ], [ "in", "Money in" ], [ "move", "Moved between your accounts" ] ]
  tab_class = "py-2 px-1 text-sm font-medium border-b-2 cursor-pointer whitespace-nowrap"
  initial = tabs.index { |k, _| k == @kind } || 0
%>
<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Money", manage_money_index_path ], [ "Books", manage_money_books_path ] ],
    text: "Record money",
    links: []
  } %>

  <%# The sheet: full width on a phone, a centered card from sm up. %>
  <div class="max-w-2xl -mx-4 sm:mx-auto bg-white sm:rounded-xl sm:border sm:border-gray-200 sm:shadow-sm overflow-hidden">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h2 class="text-lg font-semibold text-white">Record money</h2>
      <%= link_to manage_money_books_path, class: "rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors", aria: { label: "Close" } do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      <% end %>
    </div>
    <div data-controller="tabs" data-tabs-plain-value="true" data-tabs-url-value="false" data-tabs-initial-tab-value="<%= initial %>">
      <nav class="flex gap-4 border-b border-gray-200 px-6 overflow-x-auto" aria-label="What happened">
        <% tabs.each_with_index do |(key, name), i| %>
          <%= tag.button name, type: "button", class: "#{tab_class} #{i == initial ? 'border-pink-500 text-pink-600' : 'border-transparent text-gray-500 hover:text-gray-700'}",
                data: { tabs_target: "tab", index: i, key: key, action: "tabs#select" } %>
        <% end %>
      </nav>
      <% tabs.each do |key, _| %>
        <%= render "form", record: @records[key], productions: @productions, shows: @shows, panel: true %>
      <% end %>
    </div>
  </div>
</div>
