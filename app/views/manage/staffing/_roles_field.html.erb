<%# Role assignments WITH a per-role pay rate. Each role the person can fill has
    its own hourly rate (blank = fall back to their default rate). Submits
    house_role_ids[] and role_rates[<id>]. A "Manage roles" modal (Turbo-frame)
    adds/removes house roles without leaving the page; new roles sync into the
    list when it closes.
    Locals: house_roles, assigned_ids (array of ids).
    Optional: role_rates (hash id => dollars), default_rate_dollars. %>
<%
  role_rates = local_assigns.fetch(:role_rates, {}).transform_keys(&:to_i)
  default_rate_dollars = local_assigns[:default_rate_dollars]
  rate_placeholder = default_rate_dollars.present? ? format("%.2f", default_rate_dollars) : "0.00"
%>
<% if house_roles.empty? %>
  <p class="text-sm text-gray-500 mb-3" id="staff-roles-empty">No roles yet — add some so you can mark what this person is qualified for and what they earn in each.</p>
<% end %>
<p class="text-xs text-gray-500 mb-2">Check each role they can work and set the rate for it. Leave a rate blank to use their default rate<%= " ($#{rate_placeholder}/hr)" if default_rate_dollars.present? %>.</p>
<div id="staff-roles-list" data-rate-placeholder="<%= rate_placeholder %>" class="space-y-2">
  <% house_roles.each do |role| %>
    <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 cursor-pointer" data-role-row data-role-id="<%= role.id %>">
      <input type="checkbox" name="house_role_ids[]" value="<%= role.id %>" <%= "checked" if assigned_ids.include?(role.id) %>
             data-role-checkbox class="h-4 w-4 rounded border-gray-300 accent-pink-500">
      <span class="flex-1 text-sm font-medium text-gray-800"><%= role.name %></span>
      <div class="relative w-28 flex-shrink-0">
        <span class="absolute left-2 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
        <input type="text" inputmode="decimal" name="role_rates[<%= role.id %>]"
               value="<%= role_rates[role.id] %>" placeholder="<%= rate_placeholder %>"
               data-role-rate class="w-full pl-5 pr-8 py-1.5 border border-gray-200 rounded text-right text-sm focus:outline-none focus:ring-1 focus:ring-pink-300">
        <span class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 text-xs">/hr</span>
      </div>
    </label>
  <% end %>
</div>

<div class="mt-3" data-controller="modal">
  <%= render "shared/button", text: "Manage roles", variant: "ghost", size: "small", icon: "cog", type: :button,
        data: { action: "click->modal#open", "modal-id": "roles-modal" } %>
</div>

<% content_for :staffing_modals do %>
  <div id="roles-modal" data-controller="modal roles-field"
       data-roles-field-list-value="staff-roles-list" data-roles-field-empty-value="staff-roles-empty"
       class="hidden fixed inset-0 z-[70] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->modal#closeOnBackdrop click->roles-field#sync">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl" data-action="click->modal#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <h3 class="text-lg font-semibold text-white">House roles</h3>
          <button type="button" class="text-white/70 hover:text-white cursor-pointer" data-action="click->modal#close click->roles-field#sync">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="px-5 py-4">
          <%= turbo_frame_tag "house_roles_manager", src: manage_staffing_house_roles_editor_path, loading: :lazy,
                data: { "roles-field-target": "frame" } do %>
            <p class="text-sm text-gray-400 py-2">Loading…</p>
          <% end %>
        </div>
        <div class="flex items-center justify-end px-5 py-3 border-t border-gray-200">
          <%= render "shared/button", text: "Done", variant: "primary", size: "small", type: :button,
                data: { action: "click->modal#close click->roles-field#sync" } %>
        </div>
      </div>
    </div>
  </div>
<% end %>
