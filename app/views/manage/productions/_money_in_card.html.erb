<%# Whether the production takes money at all (Tim, 2026-11-14: an open mic
    never does). Its shows then settle up as no revenue on their own. On
    Basic Information, which every production has: a contract production has
    no Pay tab. %>
<div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6" data-no-revenue-card>
  <%= render "shared/section_heading", title: "Money in" %>
  <%= form_with url: update_no_revenue_manage_production_path(@production), method: :patch, local: true do |form| %>
    <div class="p-6 pt-4 flex items-start justify-between gap-4">
      <div>
        <p class="font-medium text-gray-900">This production never takes money</p>
        <p class="text-sm text-gray-500 mt-1">For an open mic or anything free: its shows settle up as no revenue by themselves, with nothing to enter or confirm, and nobody is paid from them. A show that does take money is settled as usual.</p>
      </div>
      <%= render "shared/toggle_switch", form: form, field: :no_revenue, checked: @production.no_revenue? %>
    </div>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
    </div>
  <% end %>
</div>
