<% content_for :title, "Tap to Pay on iPhone" %>
<% content_for :door_header do %>
  <% unless turbo_native_app? %>
    <%= link_to door_index_path, class: "flex-shrink-0 p-1.5 -ml-2 rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100", "aria-label": "Work the door" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
  <% end %>
  <div class="coustard-regular text-xl leading-tight text-gray-900">Tap to Pay on iPhone</div>
<% end %>
<%# Tap to Pay on iPhone's page in the app (Apple 3.5, 3.6, 4.3): Apple's
    words and picture, how this iPhone stands, Set up (Apple's terms, then
    the guide), the guide again, and Apple's disclaimer behind "Terms apply." %>
<div data-controller="tap-to-pay-setup bridge--tap-to-pay"
     data-action="tap-to-pay-setup:status->bridge--tap-to-pay#status tap-to-pay:state->tap-to-pay-setup#state"
     data-bridge--tap-to-pay-connection-token-url-value="<%= door_tap_to_pay_token_path(organization_id: @organization.id) %>"
     data-bridge--tap-to-pay-location-id-value="<%= @location_id %>"
     data-bridge--tap-to-pay-can-accept-terms-value="<%= @can_accept_terms %>">

  <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <%= image_tag "tap_to_pay_hero_email.jpg", alt: "", class: "w-full h-auto" %>
    <div class="px-5 pb-5">
      <h1 class="text-2xl font-bold text-gray-900">Tap to Pay on iPhone</h1>
      <p class="mt-1 text-[15px] text-gray-700">Accept physical debit and credit cards as well as Apple Pay and other digital wallets. Right on your iPhone.</p>

      <div class="mt-5">
        <% if @location_error %>
          <div class="rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800"><%= @location_error %></div>
        <% end %>
        <div data-tap-to-pay-setup-target="checking" class="<%= 'hidden' if @location_error %> text-sm text-gray-500">Checking this iPhone…</div>

        <div data-tap-to-pay-setup-target="browser" class="hidden rounded-xl bg-gray-50 px-4 py-3 text-sm text-gray-700">
          Open this page in the CocoScout app on your iPhone to set up Tap to Pay on iPhone.
        </div>

        <div data-tap-to-pay-setup-target="notSetUp" class="hidden">
          <%= render "shared/button", text: "Set up Tap to Pay on iPhone", variant: "primary", size: "large", type: :button,
                classes: "w-full justify-center", data: { action: "click->bridge--tap-to-pay#enable" } %>
          <p class="mt-2 text-xs text-gray-500">This iPhone gets ready to take taps for <%= @organizations.map(&:name).to_sentence %>.</p>
        </div>

        <div data-tap-to-pay-setup-target="preparing" class="hidden" role="status" aria-live="polite">
          <div class="text-sm font-medium text-gray-900">Getting Tap to Pay on iPhone ready <span class="tabular-nums text-gray-500" data-tap-to-pay-setup-target="progressText"></span></div>
          <div class="mt-2 h-2 rounded-full bg-gray-100 overflow-hidden"><div class="h-2 rounded-full bg-pink-500 transition-all" style="width: 0%" data-tap-to-pay-setup-target="progress"></div></div>
          <p class="mt-2 text-xs text-gray-500">The first time on an iPhone this can take a minute or two. Tap to Pay on iPhone can't take payments until it's ready.</p>
        </div>

        <div data-tap-to-pay-setup-target="ready" class="hidden rounded-xl bg-green-50 px-4 py-3 text-sm text-green-800">
          <div class="font-semibold">Ready</div>
          <div>This iPhone can take payments with Tap to Pay on iPhone. At the door, pick tickets, then Tap to Pay on iPhone.</div>
        </div>

        <div data-tap-to-pay-setup-target="needsAdmin" class="hidden rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">
          <div class="font-semibold">An administrator needs to turn it on first</div>
          <div>Apple's terms for Tap to Pay on iPhone have to be accepted by an administrator before anyone can take payments. Ask your organization's manager to contact CocoScout.</div>
        </div>

        <div data-tap-to-pay-setup-target="failed" class="hidden">
          <div class="rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800" data-tap-to-pay-setup-target="failedText"></div>
          <div class="mt-3">
            <%= render "shared/button", text: "Try again", variant: "primary", size: "medium", type: :button,
                  classes: "w-full justify-center", data: { action: "click->bridge--tap-to-pay#enable" } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-3 rounded-2xl border border-gray-200 bg-white px-5 py-4">
    <h2 class="text-base font-semibold text-gray-900">How to accept payments</h2>
    <p class="mt-1 text-sm text-gray-600">Apple's guide to taking contactless cards, Apple Pay and other digital wallets, and PIN entry.</p>
    <div class="mt-3">
      <%= render "shared/button", text: "See how", variant: "secondary", size: "medium", type: :button,
            classes: "w-full justify-center", data: { action: "click->bridge--tap-to-pay#howToTap" } %>
    </div>
  </div>

  <%= render "shared/tap_to_pay_terms", classes: "mt-3 px-1 text-xs text-gray-500" %>
</div>
