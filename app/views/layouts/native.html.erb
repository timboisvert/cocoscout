<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "CocoScout" %></title>
    <%# No viewport-fit=cover: the app's opaque nav and tab bars already keep
        pages inside the safe area, and cover would slide content under them.
        maximum-scale=1: an app page never zooms. iPhone zooms in on any text
        box smaller than 16px when it's tapped, and in the app that zoom
        stuck to every page after (Tim, 2026-10-12). %>
    <meta name="viewport" content="<%= native_viewport %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Google Fonts — same set as application.html.erb. Without these the
        Coustard / Inter / Caprasimo @font-face rules never load and every
        .coustard-regular / .inter-regular falls back to system font. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caprasimo&family=Coustard:wght@400;900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <body class="inter-regular text-slate-700 bg-[#f9f9f7]"
        data-turbo-native="true">

    <%# No loading overlay: the page stays put while the next one loads, and
        Hotwire Native shows its own spinner only when a load is slow. %>
    <%# V1.1 builds while a superadmin is impersonating (Tim, 2026-10-20):
        "You're impersonating", whose account, and Stop, pinned at the top of
        every page. V1 builds never had a way to impersonate in the app. %>
    <% if native_nav_generation.to_i >= 2 && respond_to?(:impersonating?) && impersonating? %>
      <div class="sticky top-0 z-30 flex items-center justify-between gap-3 min-h-[40px] px-4 bg-amber-500 text-white" data-native-impersonation-bar>
        <span class="min-w-0 truncate text-xs font-bold"><span class="uppercase tracking-wider">You're impersonating</span> <%= Current.user.person&.name || Current.user.email_address %></span>
        <%= render "shared/button", text: "Stop", variant: "outline", size: "xs", path: stop_impersonating_user_path, method: :post, classes: "flex-shrink-0" %>
      </div>
    <% end %>

    <%# V1.1, generation-2 builds in production mode: a soft pink strip under
        the native nav bar naming the organization. Sticky, so it never
        scrolls away; tapping it changes organization. %>
    <% if native_nav_generation.to_i >= 2 && controller_path.start_with?("manage") && Current.organization %>
      <%= link_to select_organization_path, class: "sticky top-0 z-20 flex items-center justify-between gap-2.5 min-h-[44px] px-4 bg-pink-50 border-b border-pink-200 text-gray-900",
            aria: { label: "Production mode, #{Current.organization.name}. Change organization" }, data: { production_strip: true } do %>
        <span class="flex items-center gap-2 min-w-0 text-sm font-semibold">
          <%= render "shared/navigation/organization_monogram", organization: Current.organization, size: 24 %>
          <span class="truncate"><%= Current.organization.name %></span>
          <svg class="w-3.5 h-3.5 text-pink-700 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </span>
        <span class="text-[10px] font-bold uppercase tracking-[0.08em] text-pink-700 flex-shrink-0">Production mode</span>
      <% end %>
    <% end %>
    <main class="px-4 pt-3 pb-8 overflow-x-hidden" data-controller="bridge--form">
      <div id="flash-messages"></div>
      <%= render "shared/navigation/mode_switch_notice" %>
      <%= yield %>
    </main>

    <%= render "shared/native/bridge" %>

    <%# Global modal turbo frames %>
    <%= turbo_frame_tag "contact_modal" %>
    <%= yield :modals %>
  </body>
</html>
