<%# Poster, Links & Notes tab. %>
<div class="space-y-8">
  <%# Poster %>
  <div>
    <div class="flex items-center gap-3 mb-2">
      <h4 class="text-sm font-semibold text-gray-900">Poster</h4>
      <% if @show.poster.attached? && @show.poster.blob&.persisted? %>
        <%= render "shared/button", text: "Remove", variant: "secondary", size: "xs", type: :button,
              data: { action: "click->show-edit#removePoster" } %>
      <% end %>
    </div>

    <div class="poster-container">
      <% if @show.poster.attached? && @show.poster.blob&.persisted? %>
        <div class="mb-3 poster-image">
          <div class="w-full max-w-56 aspect-[3/4] rounded-lg overflow-hidden shadow border border-gray-200 bg-white">
            <%= image_tag url_for(@show.poster), class: "w-full h-full object-cover" %>
          </div>
        </div>
        <%= form.hidden_field :remove_poster, value: "0", class: "remove-poster-hidden" %>
      <% end %>
      <p class="text-xs text-gray-500 mb-2">JPEG, JPG, or PNG.</p>
      <div class="block w-full max-w-md rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm">
        <%= form.file_field :poster, class: "w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:text-white file:bg-pink-500 hover:file:bg-pink-600" %>
      </div>
    </div>
  </div>

  <%# Links %>
  <div class="border-t border-gray-200 pt-6" data-controller="show-links">
    <h4 class="text-sm font-semibold text-gray-900">Links</h4>
    <p class="text-xs text-gray-500 mb-3">Links related to this event (ticketing, event page, social posts, etc.)</p>
    <div id="show-links-fields" data-show-links-target="list">
      <%= form.fields_for :show_links do |show_link_form| %>
        <div class="flex items-start gap-2 mb-2 show-links-fields-row" data-show-links-target="row">
          <%= show_link_form.hidden_field :id %>
          <%= show_link_form.hidden_field :_destroy, value: 0, class: "destroy-flag" %>
          <div class="flex-1 flex flex-col sm:flex-row gap-2">
            <%= show_link_form.text_field :text, placeholder: "Link text (e.g. Buy Tickets)", class: "flex-1 rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500" %>
            <%= show_link_form.text_field :url, placeholder: "URL", class: "flex-1 rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500" %>
          </div>
          <%= link_to "Remove", '#', class: "remove-show-link text-pink-500 hover:text-pink-600 underline text-sm whitespace-nowrap mt-3", data: { action: "show-links#remove" } %>
        </div>
      <% end %>
    </div>
    <%= link_to "Add link", '#', class: "text-pink-500 hover:text-pink-600 underline text-sm", data: { action: "show-links#add" } %>
    <template data-show-links-target="template">
      <div class="flex items-start gap-2 mb-2 show-links-fields-row" data-show-links-target="row">
        <input type="hidden" name="show[show_links_attributes][new_show_links][id]" />
        <input type="hidden" name="show[show_links_attributes][new_show_links][_destroy]" value="0" class="destroy-flag" />
        <div class="flex-1 flex flex-col sm:flex-row gap-2">
          <input type="text" name="show[show_links_attributes][new_show_links][text]" placeholder="Link text (e.g. Buy Tickets)" class="flex-1 rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500" />
          <input type="text" name="show[show_links_attributes][new_show_links][url]" placeholder="URL" class="flex-1 rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500" />
        </div>
        <a href="#" class="remove-show-link text-pink-500 hover:text-pink-600 underline text-sm whitespace-nowrap mt-3" data-action="show-links#remove">Remove</a>
      </div>
    </template>
  </div>

  <%# Notes %>
  <div class="border-t border-gray-200 pt-6">
    <%= form.label :notes, "Event notes", class: "block text-sm font-semibold text-gray-900" %>
    <p class="text-xs text-gray-500 mt-0.5 mb-2">Notes for this event that cast and the production team can see (e.g. "family celebrating a birthday in the audience", "bring your own water").</p>
    <%= form.text_area :notes, placeholder: "Add notes for this event…", rows: 6,
          class: "w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500" %>
  </div>
</div>
