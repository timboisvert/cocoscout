<%# Tickets on the show page, for a date that follows another organization's
    contract date (LinkedDates): that organization sells the tickets, from
    its own box office, and this is the window onto them
    (LinkedTicketSales). Owners and managers see the count, with comps and
    what's sold elsewhere, and the way into the date's sales; the production
    team sees what its organization chose; nothing is drawn for anyone the
    sales aren't shared with. Locals: show, production. %>
<%
  connection = LinkedTicketSales.connection_for(show)
  listing = LinkedTicketSales.listing_for(show, connection: connection)
  level = listing && LinkedTicketSales.level_for(Current.user, show, connection: connection)
%>
<% if level %>
  <%
    seller = connection.organization
    stats = Ticketing::ListingStats.of(listing)
    link = TicketLink.for(listing.show, listing: listing)
    badge_label, badge_classes = ticket_listing_status_badge(listing, stats.inventory)
    past = show.date_and_time <= Time.current
  %>
  <div class="border border-gray-200 rounded-lg overflow-hidden bg-white" data-followed-tickets-card>
    <%= render "shared/section_heading", padding: "px-4 py-3", title: "Tickets at #{seller.name}",
          intro: "#{seller.name} sells the tickets for this date. Prices, orders, refunds and the door are theirs." do %>
      <% if level == :full %>
        <%= render "shared/button", text: "See ticket sales", variant: "secondary", size: "small", path: manage_production_sale_path(production, listing) %>
      <% end %>
    <% end %>
    <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-3 items-stretch">
      <div class="rounded-lg border border-gray-200 p-3">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Tickets sold</div>
        <div class="mt-1 text-lg font-semibold text-gray-900 tabular-nums">
          <%= stats.sold_words %><% if level == :full && stats.comps.positive? %> <span class="text-sm font-normal text-gray-500">· <%= pluralize(stats.comps, "comp") %></span><% end %>
        </div>
        <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs text-gray-500">
          <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium <%= badge_classes %>"><%= badge_label %></span>
          <% if level == :full %><span><%= number_to_currency(stats.gross_cents / 100.0) %> in ticket sales, before fees and tax</span><% end %>
        </div>
      </div>
      <% if link&.url.present? && !past %>
        <div class="min-w-0">
          <%= render "shared/copy_url", url: link.url, layout: :tile, label: "Ticket link", show_qr: false,
                help_text: "#{possessive(seller.name)} ticket page for this date. Share it with your people." %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
