<%# What buyers read about this date, and its ages: the production's, or
    (each box's switch on) this date's own, by the one override control
    (manage/ticketing/own_switch). Locals: listing, setup. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  production = listing.production
  inherited_title = setup&.title.presence || listing.show.secondary_name.presence || production.name
  inherited_description = (setup&.description.presence || production.description).to_plain_text.squish
  own_page = listing.title.present? || listing.description.present? || listing.door_note.present? || listing.accessibility_note.present?
  own_ages = !listing.minimum_age.nil? || listing.age_note.present?
  shown_age = own_ages ? listing.minimum_age : setup&.minimum_age
%>
<%= form_with model: listing, url: manage_ticket_listing_path(listing), method: :patch, class: "space-y-6" do |f| %>
  <%= hidden_field_tag :section, "page" %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle" data-settings-card="page">
    <%= render "manage/ticketing/own_switch", title: "The ticket page", follows: production.name, followed: "its title, description, doors and accessibility words",
          intro: "What buyers read about this date. On, a box left empty still shows the production's.",
          only: "this date", name: "ticket_listing[own_page]", id: "ticket_listing_own_page", checked: own_page %>
    <fieldset <%= "disabled" unless own_page %> data-fieldset-toggle-target="fields" class="px-6 py-5 space-y-4 disabled:opacity-50">
      <div>
        <label for="ticket_listing_title" class="block text-sm font-medium text-gray-700 mb-1.5">Title</label>
        <%= f.text_field :title, placeholder: inherited_title, class: input_class %>
      </div>
      <div>
        <label for="ticket_listing_description" class="block text-sm font-medium text-gray-700 mb-1.5">Description</label>
        <div data-controller="no-attachments">
          <%= f.rich_text_area :description, placeholder: inherited_description.truncate(200), class: "w-full min-h-[150px]" %>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="ticket_listing_door_note" class="block text-sm font-medium text-gray-700 mb-1.5">Doors</label>
          <%= f.text_field :door_note, placeholder: setup&.door_note.presence || "Doors 30 min before", class: input_class %>
        </div>
        <div>
          <label for="ticket_listing_accessibility_note" class="block text-sm font-medium text-gray-700 mb-1.5">Accessibility</label>
          <%= f.text_field :accessibility_note, placeholder: setup&.accessibility_note.presence || "Step-free entry", class: input_class %>
        </div>
      </div>
    </fieldset>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle" data-settings-card="ages">
    <%= render "manage/ticketing/own_switch", title: "Ages", follows: production.name, followed: (AgeLimit.words(setup&.minimum_age) || "All ages").downcase_first,
          intro: "Buyers see it on the ticket page, at checkout, with their tickets and in their emails, and the door sees it too.",
          only: "this date", name: "ticket_listing[own_ages]", id: "ticket_listing_own_ages", checked: own_ages %>
    <fieldset <%= "disabled" unless own_ages %> data-fieldset-toggle-target="fields" class="disabled:opacity-50">
      <%= render "manage/production_ticketings/age_limit_fields", scope: "ticket_listing", age: (shown_age.to_i.zero? ? nil : shown_age), note: listing.age_note, input_class: input_class,
            bare: true, note_placeholder: setup&.age_note.presence %>
    </fieldset>
  </div>

  <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
<% end %>

<%= render "manage/ticket_listings/page_image", listing: listing %>
