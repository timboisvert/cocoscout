<% content_for :title, "Account Settings" %>

<div class="w-full" data-controller="account-email">
  <div id="notice-container">
    <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  </div>

  <%= render "shared/me_card", person: @person, line: Current.user.email_address,
        detail: "Member since #{Current.user.created_at.strftime('%B %Y')}" do %>
    <%= render "shared/button", text: "Change email", variant: "secondary", size: "small", type: :button, data: { action: "click->account-email#open" } %>
  <% end %>

  <%# Each setting is one row: what it is, a line about it, and its button. %>
  <% row_class = "flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3 sm:px-6" %>

  <%# The app hides the Account sidebar, so its other pages are rows here. %>
  <% if turbo_native_app? %>
    <nav class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-6 divide-y divide-gray-100" aria-label="Account">
      <%# Tap to Pay's setup and Apple's guide live here, for people who can
          sell with it (Apple 3.6, 4.3; Tim, 2026-10-19: never in the menu). %>
      <% [
        [ "Notifications", "On this phone, and by email", account_notifications_path ],
        ([ tap_to_pay_name, "Set it up on this #{tap_to_pay_phone}, and how to take a tap", door_tap_to_pay_path ] if native_tap_to_pay),
        [ "Profiles", "Your profiles and which one is the default", account_profiles_path ],
        [ "Organizations", "The organizations you're part of", account_organizations_path ]
      ].compact.each do |label, line, path| %>
        <%# Never wraps (unlike row_class, made for rows with buttons): the
            arrow stays on the right however long the line. %>
        <%= link_to path, class: "flex items-center justify-between gap-4 px-4 py-3 sm:px-6 hover:bg-gray-50 transition-colors" do %>
          <div class="min-w-0 flex-1">
            <div class="text-sm font-medium text-gray-900"><%= label %></div>
            <div class="text-sm text-gray-600"><%= line %></div>
          </div>
          <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <%# Sign-in methods: every way into this account, one row each: the emailed
      code (always available), the password, Apple, Google, and each passkey. %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-6">
    <%= render "shared/section_heading", title: "Sign-in methods", intro: "Every method opens the same account.",
          padding: "px-4 py-3 sm:px-6 sm:py-4" %>
    <div class="divide-y divide-gray-100">
      <div class="<%= row_class %>">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900">Email code</div>
          <div class="text-sm text-gray-600">A 6-digit code sent to <%= Current.user.email_address %>. Always available.</div>
        </div>
      </div>
      <div class="<%= row_class %>">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900">Password</div>
          <div class="text-sm text-gray-600">
            <% if Current.user.password_chosen? %>
              Chosen on <%= Current.user.password_set_at.strftime("%B %-d, %Y") %>.
            <% else %>
              Not chosen. The code signs you in without one.
            <% end %>
          </div>
        </div>
        <%= render "shared/button", text: (Current.user.password_chosen? ? "Change" : "Choose a password"),
              path: choose_password_account_path, variant: "secondary", size: "small" %>
      </div>
      <%# Apple and Google (sign-in plan phase 2): a connected one always shows,
          so it can be disconnected; Connect shows where the buttons do
          (SignIn::Providers.shown), never while acting as someone else. %>
      <% connectable = SignIn::Providers.shown(user: Current.user, cookies: cookies, user_agent: request.user_agent) %>
      <% identities = Current.user.user_identities.index_by(&:provider) %>
      <% SignIn::Providers::LIST.each do |provider| %>
        <% identity = identities[provider] %>
        <% next unless identity || connectable.include?(provider) %>
        <% name = SignIn::Providers.name(provider) %>
        <div class="<%= row_class %>" data-sign-in-method="<%= provider %>">
          <div class="min-w-0">
            <div class="text-sm font-medium text-gray-900"><%= name %></div>
            <div class="text-sm text-gray-600">
              <%= identity ? "Connected: #{identity.shown_email}." : "Not connected. Connect it and #{name} signs you in with one tap." %>
            </div>
          </div>
          <% unless impersonating? %>
            <% if identity %>
              <% modal_id = "disconnect-#{provider}" %>
              <%= render "shared/button", text: "Disconnect", variant: "secondary", size: "small", type: :button,
                    data: { controller: "modal", action: "click->modal#open", modal_id: modal_id } %>
              <%= render "shared/confirm_modal", id: modal_id, title: "Disconnect #{name}?",
                    message: "#{name} will no longer sign you in. Your email code always works#{Current.user.password_chosen? ? ', and so does your password' : ''}.",
                    confirm_text: "Disconnect", url: disconnect_sign_in_provider_path(provider), method: :delete %>
            <% else %>
              <%= render "shared/button", text: "Connect", variant: "secondary", size: "small",
                    path: sign_in_provider_path(provider), method: :post, form: { data: { turbo: false } } %>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <%# Passkeys (sign-in plan phase 4): one row each, then Add a passkey.
          In a browser the page makes it (passkey_add_controller.js); in the
          app, the app's own sheet (bridge/passkey_controller.js). Either
          shows its row only once it knows it can, so a browser without
          passkeys, or an app build without them, shows nothing to tap. %>
      <% passkeys = Current.user.passkeys.order(:created_at).to_a %>
      <% passkeys.each do |passkey| %>
        <div class="<%= row_class %>" data-sign-in-method="passkey">
          <div class="min-w-0">
            <div class="text-sm font-medium text-gray-900">Passkey</div>
            <div class="text-sm text-gray-600">
              <%= passkey.shown_name %>. Added <%= passkey.created_at.strftime("%B %-d, %Y") %><%= passkey.last_used_at && passkey.last_used_at.to_date > passkey.created_at.to_date ? ", last used #{passkey.last_used_at.strftime('%B %-d, %Y')}" : "" %>.
            </div>
          </div>
          <% unless impersonating? %>
            <% modal_id = "remove-passkey-#{passkey.id}" %>
            <%= render "shared/button", text: "Remove", variant: "secondary", size: "small", type: :button,
                  data: { controller: "modal", action: "click->modal#open", modal_id: modal_id } %>
            <%= render "shared/confirm_modal", id: modal_id, title: "Remove this passkey?",
                  message: "#{passkey.shown_name} will no longer sign you in. Your email code always works#{Current.user.password_chosen? ? ', and so does your password' : ''}.",
                  confirm_text: "Remove", url: passkey_account_path(passkey), method: :delete %>
          <% end %>
        </div>
      <% end %>
      <%# In the app the server decides from the user agent's component list
          (native_bridge_component?), as Tap to Pay does: the page's own check
          can run before the app has registered its components, which hid the
          row on a link opened into a running app. In a browser the page shows
          it once it knows the browser can make one (passkey_add_controller.js). %>
      <% if !impersonating? && (!turbo_native_app? || native_bridge_component?("passkey")) %>
        <% adder = turbo_native_app? ?
             { controller: "bridge--passkey", action: "click->bridge--passkey#add" } :
             { controller: "passkey-add", action: "click->passkey-add#add",
               passkey_add_options_url_value: passkey_options_account_path, passkey_add_create_url_value: passkeys_account_path } %>
        <div class="<%= row_class %><%= " hidden" unless turbo_native_app? %>" data-sign-in-method="add-passkey" data-controller="<%= adder[:controller] %>"
             <%= tag.attributes(adder.except(:controller, :action).transform_keys { |key| "data-#{key.to_s.dasherize}" }) %>>
          <div class="min-w-0">
            <div class="text-sm font-medium text-gray-900"><%= passkeys.any? ? "Another passkey" : "Passkey" %></div>
            <div class="text-sm text-gray-600">
              <%= passkeys.any? ? "For a device or password manager that doesn't have yours." : "Not added. Add one and your face, fingerprint, or screen lock signs you in, with no code to wait for." %>
            </div>
            <div class="mt-1 hidden text-sm text-pink-700" data-<%= adder[:controller] %>-target="error" role="alert"></div>
          </div>
          <%= render "shared/button", text: "Add a passkey", variant: "secondary", size: "small", type: :button,
                data: { action: adder[:action], "#{adder[:controller]}-target": "button" } %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-6">
    <%= render "shared/section_heading", title: "Devices and help", padding: "px-4 py-3 sm:px-6 sm:py-4" %>
    <div class="divide-y divide-gray-100">
      <%# Where else you're signed in: browsers, the app, and API sign-ins.
          A new password signs them all out. %>
      <% others = @other_sessions.to_a %>
      <% app_sessions = @app_sessions.to_a %>
      <div class="<%= row_class %>">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900">Where you're signed in</div>
          <div class="text-sm text-gray-600">
            Here, on <%= Current.session.label %><% if others.any? || app_sessions.any? %>, and <%= pluralize(others.size + app_sessions.size, "other place") %><% end %>.
          </div>
        </div>
        <% if others.any? || app_sessions.any? %>
          <%= form_with url: sign_out_elsewhere_account_path, method: :delete, class: "inline" do %>
            <%= render "shared/button", text: "Sign out everywhere else", variant: "secondary", size: "small", type: :submit %>
          <% end %>
        <% end %>
      </div>
      <% others.first(10).each do |other| %>
        <div class="<%= row_class %>">
          <div class="min-w-0">
            <div class="text-sm text-gray-900"><%= other.label %></div>
            <div class="text-sm text-gray-600">Signed in <%= other.created_at.strftime("%b %-d, %Y") %><%= " #{other.sign_in_method_words}" if other.sign_in_method_words %></div>
          </div>
          <%= form_with url: sign_out_session_account_path(other), method: :delete, class: "inline" do %>
            <%= render "shared/button", text: "Sign out", variant: "secondary", size: "small", type: :submit %>
          <% end %>
        </div>
      <% end %>
      <% app_sessions.each do |app_session| %>
        <div class="<%= row_class %>">
          <div class="min-w-0">
            <div class="text-sm text-gray-900"><%= app_session.label %></div>
            <div class="text-sm text-gray-600">Signed in <%= app_session.created_at.strftime("%b %-d, %Y") %>, last used <%= app_session.last_used_at.strftime("%b %-d") %></div>
          </div>
          <%= form_with url: sign_out_app_account_path(app_session), method: :delete, class: "inline" do %>
            <%= render "shared/button", text: "Sign out", variant: "secondary", size: "small", type: :submit %>
          <% end %>
        </div>
      <% end %>
      <% if others.size > 10 %>
        <div class="px-4 py-2 sm:px-6 text-xs text-gray-500"><%= pluralize(others.size - 10, "older sign-in") %> not shown. Sign out everywhere else covers them too.</div>
      <% end %>
      <div class="<%= row_class %>">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900">Support</div>
          <div class="text-sm text-gray-600">Questions or feedback? We'd love to hear from you.</div>
        </div>
        <%= render "shared/button", text: "Email support", path: "mailto:support@cocoscout.com", variant: "secondary", size: "small" %>
      </div>
    </div>
  </div>

  <%# Delete my account: asked for right here, on the website or in the app
      (Apple requires the app to offer it); superadmins finish it within 30
      days, and it can be taken back until then. %>
  <div class="bg-white border border-red-200 rounded-xl overflow-hidden mb-6">
    <% if (requested_at = Current.user.deletion_requested_at) %>
      <div class="<%= row_class %>">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900">Deleting your account</div>
          <div class="text-sm text-gray-600">You requested this on <%= requested_at.strftime("%B %-d") %>. It will be done within 30 days; until then, you can change your mind.</div>
        </div>
        <%= form_with url: cancel_deletion_account_path, method: :delete, class: "inline" do %>
          <%= render "shared/button", text: "Keep my account", variant: "secondary", size: "small", type: :submit %>
        <% end %>
      </div>
    <% else %>
      <% delete_cid = "confirm-delete-account" %>
      <div class="<%= row_class %>">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900">Delete your account</div>
          <div class="text-sm text-gray-600">Your account and profiles are deleted within 30 days.</div>
        </div>
        <%= render "shared/button", text: "Delete my account", variant: "secondary", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: delete_cid } %>
      </div>
      <%= render "shared/confirm_modal", id: delete_cid,
            title: "Delete your account?",
            message: "We'll delete your account and profiles within 30 days, and sign-ins will stop working. Payment and tax records the law requires are kept. You can change your mind here until it's done.",
            confirm_text: "Delete my account",
            url: request_deletion_account_path, method: :post %>
    <% end %>
  </div>

  <%# Change email: two steps in one modal (account_email_controller.js). The
      new address, then the 6-digit code we emailed to it; nothing changes
      until the code is entered. %>
  <div data-account-email-target="modal"
       data-action="click->account-email#close keydown.esc@window->account-email#close"
       class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-lg w-full overflow-hidden" data-action="click->account-email#stopPropagation">
      <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
        <h2 class="text-lg font-semibold text-white">Change your email address</h2>
        <button type="button" class="text-white/90 hover:text-white" aria-label="Close" data-action="click->account-email#close">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form data-account-email-target="form" data-action="submit->account-email#submit">
        <div class="p-6 space-y-5">
          <div data-account-email-target="errorMessage" class="hidden rounded-lg border border-pink-200 bg-pink-50 px-4 py-3 text-sm text-pink-800" role="alert"></div>

          <%# Step one: the new address. %>
          <div data-account-email-target="addressStep" class="space-y-5">
            <p class="text-sm leading-relaxed text-gray-600">
              You'll sign in with the new address, and codes and notices will go there. To confirm it's yours, we'll email it a 6-digit code. Nothing changes until you enter the code.
            </p>
            <div>
              <div class="block text-sm font-medium text-gray-700 mb-1">Current email</div>
              <div class="text-gray-900"><%= Current.user.email_address %></div>
            </div>
            <div>
              <label for="new_email" class="block text-sm font-medium text-gray-700 mb-1">New email address</label>
              <input type="email"
                     id="new_email"
                     data-account-email-target="emailInput"
                     required
                     autocomplete="email"
                     class="<%= auth_input_class %>"
                     placeholder="you@example.com">
            </div>

            <% profiles_with_matching_email = Current.user.people.active.where(email: Current.user.email_address) %>
            <% if profiles_with_matching_email.any? %>
              <div>
                <div class="block text-sm font-medium text-gray-700 mb-2">Also update the email on these profiles:</div>
                <div class="space-y-2">
                  <% profiles_with_matching_email.each do |profile| %>
                    <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                      <input type="checkbox"
                             value="<%= profile.id %>"
                             checked
                             data-account-email-target="profileCheckbox"
                             class="h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
                      <span class="text-sm text-gray-900"><%= profile.name %></span>
                      <span class="text-xs text-gray-500">(<%= profile.email %>)</span>
                    </label>
                  <% end %>
                </div>
                <p class="text-xs text-gray-500 mt-2">Uncheck any profiles you want to keep on the old email.</p>
              </div>
            <% end %>
          </div>

          <%# Step two: the code we sent to the new address. %>
          <div data-account-email-target="codeStep" class="hidden space-y-5">
            <p class="text-sm leading-relaxed text-gray-600">
              We sent a 6-digit code to <strong class="font-semibold text-gray-900" data-account-email-target="sentTo"></strong>.
              It works for <span data-account-email-target="lifetime">10 minutes</span>.
            </p>
            <div>
              <label for="new_email_code" class="block text-sm font-medium text-gray-700 mb-1">Code</label>
              <input type="text"
                     id="new_email_code"
                     data-account-email-target="codeInput"
                     inputmode="numeric" autocomplete="one-time-code" maxlength="7"
                     class="<%= auth_input_class %> tracking-[0.4em]"
                     placeholder="000000">
            </div>
            <p class="text-sm text-gray-600">
              Wrong address?
              <%= render "shared/button", text: "Use a different one", variant: "ghost", size: "small", type: :button,
                    classes: "!px-0 !py-0 !text-pink-600 underline hover:!bg-transparent hover:!text-pink-700",
                    data: { action: "click->account-email#startOver" } %>
            </p>
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-200 bg-gray-50">
          <%= render "shared/button", text: "Cancel", variant: "secondary", type: :button, data: { action: "click->account-email#close" } %>
          <span data-account-email-target="sendButton"><%= render "shared/button", text: "Email me a code", variant: "primary", type: :submit %></span>
          <span data-account-email-target="changeButton" class="hidden"><%= render "shared/button", text: "Change email", variant: "primary", type: :submit %></span>
        </div>
      </form>
    </div>
  </div>
</div>
