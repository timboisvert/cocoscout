<%# One product's name, standard price, description and rules. Locals: product. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  checkbox_class = "h-4 w-4 mt-0.5 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500"
%>
<%= form_with model: product, url: (product.persisted? ? manage_ticket_product_path(product) : manage_ticket_products_path),
      method: (product.persisted? ? :patch : :post), class: "space-y-6" do |f| %>
  <% if product.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= product.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,1fr)_9rem] gap-4">
      <div>
        <%= f.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :name, placeholder: "Champagne bottle", required: true, class: input_class %>
      </div>
      <div>
        <%= f.label :price, "Standard price", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">$</span>
          <%= f.text_field :price, value: (product.persisted? || product.price_cents.positive? ? format("%.2f", product.price_cents / 100.0) : nil),
                inputmode: "decimal", placeholder: "0.00", required: true, class: "#{input_class} pl-7" %>
        </div>
      </div>
    </div>
    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1.5" do %>
        Description <span class="font-normal text-gray-500">(optional)</span>
      <% end %>
      <%= f.text_field :description, placeholder: "A bottle of bubbly waiting at your table", class: input_class %>
      <p class="mt-1 text-xs text-gray-500">Buyers see it under the name at checkout.</p>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4">
    <label class="flex items-start gap-3">
      <%= f.check_box :counts_toward_ticket_revenue, class: checkbox_class %>
      <span>
        <span class="block text-sm font-medium text-gray-900">Count its sales as ticket revenue</span>
        <span class="block text-xs text-gray-600 mt-0.5">
          On, what it sells joins the show's ticket revenue, which a contract's revenue share is worked out on.
          Off (the usual choice), the money is yours alone: it shows in the show's financials as other revenue and never in a split.
          A production can decide differently on its Products tab.
        </span>
      </span>
    </label>
    <label class="flex items-start gap-3">
      <%= f.check_box :taxable, class: checkbox_class %>
      <span>
        <span class="block text-sm font-medium text-gray-900">Charge the ticket tax on it</span>
        <span class="block text-xs text-gray-600 mt-0.5">The tax you set in Ticketing settings applies to this product the way it does to a ticket.</span>
      </span>
    </label>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= render "shared/button", text: (product.persisted? ? "Save" : "Add product"), variant: "primary", size: "medium", type: :submit %>
    <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", path: manage_ticket_products_path %>
  </div>
<% end %>
