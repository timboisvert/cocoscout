<%= render layout: "manage/production_wizard/wizard_layout", locals: { current_step: :casting_style, step_name: "Casting style" } do %>
  <% mode = @wizard_state[:casting_mode].presence || "role_based" %>
  <div class="text-center mb-6">
    <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
      </svg>
    </div>
    <h2 class="text-xl font-bold text-gray-900 coustard-regular">How is a show put together?</h2>
    <p class="text-gray-600 mt-2">This sets how casting is presented for this production. You can change it later in Casting Settings.</p>
  </div>

  <%= form_with url: manage_productions_wizard_save_casting_style_path, method: :post, local: true, id: "casting-style-form" do |form| %>
    <div class="space-y-4">
      <!-- Roles option -->
      <label class="block cursor-pointer">
        <div id="role-based-option" class="p-4 rounded-lg border-2 transition-colors <%= mode == 'role_based' ? 'border-pink-500 bg-pink-50' : 'border-gray-200 bg-gray-50' %> hover:border-pink-300">
          <div class="flex items-start">
            <input type="radio" name="casting_mode" value="role_based"
                   <%= "checked" if mode == 'role_based' %>
                   class="mt-1 h-4 w-4 text-pink-500 border-gray-300 focus:ring-pink-500 accent-pink-500">
            <div class="ml-3">
              <p class="font-medium text-gray-900">Roles</p>
              <p class="text-sm text-gray-500 mt-1">
                Fill named positions: Host, Performer ×6, Stage Manager.
                <span class="text-gray-600 font-medium">Best for:</span> plays, improv teams, crews.
              </p>
            </div>
          </div>
        </div>
      </label>

      <!-- Acts option -->
      <label class="block cursor-pointer">
        <div id="act-based-option" class="p-4 rounded-lg border-2 transition-colors <%= mode == 'act_based' ? 'border-pink-500 bg-pink-50' : 'border-gray-200 bg-gray-50' %> hover:border-pink-300">
          <div class="flex items-start">
            <input type="radio" name="casting_mode" value="act_based"
                   <%= "checked" if mode == 'act_based' %>
                   class="mt-1 h-4 w-4 text-pink-500 border-gray-300 focus:ring-pink-500 accent-pink-500">
            <div class="ml-3">
              <p class="font-medium text-gray-900">Acts</p>
              <p class="text-sm text-gray-500 mt-1">
                Build a running order: Magic, Clown, Intermission, Aerial… and cast each act. Performers can hold more than one act.
                <span class="text-gray-600 font-medium">Best for:</span> burlesque, variety, cabaret, circus.
              </p>
            </div>
          </div>
        </div>
      </label>
    </div>

    <div class="mt-8 flex justify-between items-center">
      <%= link_to manage_productions_wizard_casting_path, class: "text-gray-500 hover:text-gray-700 text-sm py-2" do %>
        ← Back
      <% end %>
      <%= render "shared/button", text: "Next", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>

<script>
(function() {
  const options = {
    role_based: document.getElementById('role-based-option'),
    act_based: document.getElementById('act-based-option')
  };

  document.querySelectorAll('input[name="casting_mode"]').forEach(radio => {
    radio.addEventListener('change', function() {
      Object.entries(options).forEach(([value, el]) => {
        if (!el) return;
        if (value === this.value) {
          el.classList.add('border-pink-500', 'bg-pink-50');
          el.classList.remove('border-gray-200', 'bg-gray-50');
        } else {
          el.classList.remove('border-pink-500', 'bg-pink-50');
          el.classList.add('border-gray-200', 'bg-gray-50');
        }
      });
    });
  });
})();
</script>
