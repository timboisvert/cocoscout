<%# A small Tickets chip for a show (TicketLink::Link): how the date stands on
    CocoScout, or the site it's sold on. Not an <a>: it sits inside rows that
    are links already, and opens the ticket link itself. Locals: link. %>
<% if link && !link.none? %>
  <%
    tone = case link.state
           when :on_sale, :outside then "bg-pink-50 text-pink-700 hover:bg-pink-100"
           when :sold_out then "bg-gray-100 text-gray-600"
           else "bg-amber-50 text-amber-800"
           end
    text = link.cocoscout? ? (link.state == :on_sale ? "Tickets" : link.label) : "Tickets · #{link.site || 'elsewhere'}"
  %>
  <span role="button" tabindex="0" data-controller="tooltip" data-tooltip-text="<%= link.cocoscout? ? link.label : "Get tickets on #{link.site || 'another site'}" %>"
        onclick="event.preventDefault(); event.stopPropagation(); window.open('<%= j link.url %>', '_blank', 'noopener');"
        class="ml-1 inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-[11px] font-medium cursor-pointer <%= tone %>">
    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
    <%= text %><% unless link.cocoscout? %> ↗<% end %>
  </span>
<% end %>
