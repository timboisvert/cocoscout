<%# What's waiting on someone, one line each with its way in: a role
    nobody's filling, audition sign-ups to review, a date that moved or
    was canceled with people still to hear. Nothing here when nothing is.
    Locals: page. %>
<% if page.needs_doing.any? %>
  <section class="<%= ProductionPageHelper::CARD %>" data-production-needs-doing>
    <%= render "shared/section_heading", padding: "px-4 py-3", title_basis: "basis-24", title: "Needs doing" %>
    <% page.needs_doing.each do |item| %>
      <div class="<%= ProductionPageHelper::ROW %>" data-needs="<%= item.key %>">
        <div class="min-w-0 flex-1 text-gray-900"><%= item.text %><% if item.detail %> <span class="text-gray-500">· <%= item.detail %></span><% end %></div>
        <%= render "shared/button", text: item.action, variant: "secondary", size: "small",
              path: production_page_needs_path(page.production, item), method: item.method %>
      </div>
    <% end %>
  </section>
<% end %>
