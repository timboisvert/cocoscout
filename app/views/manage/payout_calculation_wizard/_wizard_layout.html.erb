<%
  editing = @state[:editing_id].present?
  page_title = editing ? "Edit #{@state[:name].presence || 'Payout Calculation'}" : "New Payout Calculation"
  step_labels = {
    name: "Name",
    approach: "How they're paid",
    amounts: "The amounts",
    before: "Before performers are paid",
    review: "Review"
  }
  wizard_steps = steps_for_state.map { |key| { key: key, name: step_labels[key], path: wizard_path(key) } }
  current_index = wizard_steps.index { |s| s[:key] == current_step.to_sym } || 0
%>
<% content_for :title, "#{page_title} - #{step_name}" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Money", manage_money_index_path],
      ["Payout Calculations", manage_money_payout_calculations_path]
    ],
    text: page_title,
    links: []
  } %>

  <%= render "shared/wizard_steps", steps: wizard_steps, current_index: current_index %>

  <div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <%= yield %>
    </div>

    <div class="mt-4 text-center">
      <% cancel_cid = "confirm-#{SecureRandom.hex(6)}" %>
      <%= render "shared/button", text: "Cancel", variant: "ghost-cancel", size: "small", type: :button,
            data: { controller: "modal", action: "click->modal#open", modal_id: cancel_cid } %>
      <%= render "shared/confirm_modal",
            id: cancel_cid,
            title: editing ? "Discard your changes?" : "Discard this payout calculation?",
            message: editing ? "The calculation stays as it was before you started editing." : "Your progress will be lost.",
            confirm_text: "Discard",
            cancel_text: "Keep editing",
            url: manage_money_payout_calculation_wizard_cancel_path,
            method: :delete %>
    </div>
  </div>
</div>
