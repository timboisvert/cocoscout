<%
  profile = ticketing_profile
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
%>
<%# Is the box office open: its own box at the top (Tim, 2026-11-13: "Is the
    box office enabled? Are you selling tickets?"). Opening is the
    organization's own call (Tim, 2026-10-06); closing one is a
    superadmin's. The confirm modal carries its own form. %>
<div class="space-y-6">
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="status">
    <%# A green dot, throbbing, beside the title while it's live; then the
        switch itself and Save (Tim, 2026-11-13: "just put the toggle
        there"). Opening is the organization's own call; closing one that's
        open stays a superadmin's, so a manager's switch is greyed then. %>
    <div class="px-6 py-4 border-b border-gray-200 flex items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Selling tickets</h2>
        <p class="text-sm text-gray-600 mt-1">Whether your box office is open to buyers.</p>
      </div>
      <% if profile.enabled? %>
        <span class="inline-flex items-center gap-2 text-sm font-medium text-green-700" data-live-dot>
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-500"></span>
          </span>
          Live
        </span>
      <% end %>
    </div>
    <%= form_with model: profile, url: manage_ticketing_settings_path, method: :patch do |f| %>
      <div class="px-6 py-4 flex items-start gap-3">
        <%= render "shared/toggle_switch", form: f, field: :enabled, aria_label: "Box office open",
              disabled: (profile.enabled? && !Current.user.superadmin?) %>
        <p class="text-sm text-gray-600 min-w-0">
          <% if profile.enabled? %>
            <span class="font-medium text-gray-900">Your box office is open.</span> Buyers can find your shows and check out. Course and contract money you collect online joins your CocoScout balance.
          <% else %>
            <span class="font-medium text-gray-900">Your box office is closed.</span> Buyers see nothing: set your shows up and preview their pages as you like. Opening makes your box office page and checkout live, and course and contract money you collect online joins your CocoScout balance from then on.
          <% end %>
        </p>
      </div>
      <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
        <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
      </div>
    <% end %>
  </div>
  <%# The rest in titled white boxes, each saved on its own, as the Door and
      Comps tabs are (Tim, 2026-11-13: "really just busy and doesn't have
      clear sections"). %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="box-office">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Your box office's address</h2>
      <p class="text-sm text-gray-600 mt-1">Where buyers find your shows, and where their questions go.</p>
    </div>
    <%= form_with model: profile, url: manage_ticketing_settings_path, method: :patch do |f| %>
      <div class="px-6 py-5 space-y-6">
      <div>
        <label for="ticketing_profile_slug" class="block text-sm font-medium text-gray-700 mb-1.5">Your box office's name in addresses</label>
        <div class="flex items-stretch">
          <span class="inline-flex items-center px-3 rounded-l-lg border border-r-0 border-gray-300 bg-gray-50 text-sm text-gray-500">cocoscout.com/tickets/</span>
          <%= f.text_field :slug, class: "#{input_class} rounded-l-none" %>
        </div>
        <p class="text-xs text-gray-500 mt-1">
          The box office is the page with every show you have on sale; buyers see this name in the address bar once they're there. Lowercase letters, numbers and dashes.
          The link you share is the short one, <span class="font-mono">cocoscout.com<%= ShortLink.canonical_for!(ticketing_profile).short_path %></span>; each production has its own.
        </p>
      </div>

      <div>
        <label for="ticketing_profile_support_email" class="block text-sm font-medium text-gray-700 mb-1.5">Email for buyers' questions</label>
        <%= f.email_field :support_email, placeholder: "boxoffice@yourtheater.com", class: input_class %>
        <p class="text-xs text-gray-500 mt-1">Replies to ticket emails go here.</p>
      </div>
      </div>
      <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
        <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
      </div>
    <% end %>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="orders">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Orders</h2>
      <p class="text-sm text-gray-600 mt-1">How much one buyer can take at once.</p>
    </div>
    <%= form_with model: profile, url: manage_ticketing_settings_path, method: :patch do |f| %>
      <div class="px-6 py-5 space-y-6">
      <div>
        <label for="ticketing_profile_default_max_per_order" class="block text-sm font-medium text-gray-700 mb-1.5">Most tickets in one order</label>
        <%= f.number_field :default_max_per_order, min: 1, max: 100, class: "#{input_class} max-w-[8rem]" %>
      </div>
      </div>
      <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
        <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
      </div>
    <% end %>
  </div>
</div>
