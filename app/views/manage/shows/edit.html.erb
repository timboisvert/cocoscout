<% content_for :title, "Edit #{ @show.event_type.titleize }: #{@show.date_and_time.strftime("%A, %B %-d, %Y")}" %>

<% location_spaces_map = Current.organization.locations.includes(:location_spaces).each_with_object({}) { |l, h| h[l.id] = l.location_spaces.map { |s| { id: s.id, name: s.name } } } %>
<div class="w-full mb-10" data-controller="location-modal tabs" data-location-modal-event-type-value="<%= @show.event_type&.titleize&.downcase || 'event' %>" data-location-modal-spaces-value="<%= location_spaces_map.to_json %>">
  <%= render partial: "shared/notice", locals: { notice: notice } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Shows & Events", manage_shows_path],
      [@production.name, manage_production_shows_path(@production)]
    ],
    text: @show.date_and_time.strftime("%A, %B %-d, %Y"),
    links: []
  } %>

  <%
    edit_tabs = [
      { label: "Details" },
      { label: "Schedule" },
      { label: "Location" },
      { label: "Casting & Visibility" },
      { label: "Poster, Links & Notes" },
      { label: "Linked Events" },
      { label: "Danger Zone", danger: true }
    ]
  %>

  <%# Mobile: tab dropdown %>
  <div class="sm:hidden mt-6">
    <select data-tabs-target="menu" data-action="change->tabs#selectMenu"
            class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500">
      <% edit_tabs.each_with_index do |tab, i| %>
        <option value="<%= i %>"><%= tab[:label] %></option>
      <% end %>
    </select>
  </div>

  <%# Desktop: tab strip %>
  <nav class="hidden sm:flex space-x-1 border-b border-gray-200 mt-6 mb-6 overflow-x-auto">
    <% edit_tabs.each_with_index do |tab, i| %>
      <button type="button" data-tabs-target="tab" data-index="<%= i %>" data-action="tabs#select"
              class="px-4 py-2 text-sm font-medium border-b-2 cursor-pointer whitespace-nowrap <%= tab[:danger] ? 'text-red-500' : '' %> <%= i.zero? ? 'border-pink-500 text-pink-600 bg-white' : 'border-transparent text-gray-500 bg-gray-50' %>">
        <%= tab[:label] %>
      </button>
    <% end %>
  </nav>

  <%= form_with(model: [:manage, @production, @show], class: "contents", data: { controller: "show-edit", "show-edit-casting-defaults-value": EventTypes.casting_enabled_defaults.to_json }) do |form| %>

    <div data-tabs-target="panel"><%= render "manage/shows/edit/tab_details", form: form %></div>
    <div data-tabs-target="panel" class="hidden"><%= render "manage/shows/edit/tab_schedule", form: form %></div>
    <div data-tabs-target="panel" class="hidden"><%= render "manage/shows/edit/tab_location", form: form, location_spaces_map: location_spaces_map %></div>
    <div data-tabs-target="panel" class="hidden"><%= render "manage/shows/edit/tab_visibility", form: form %></div>
    <div data-tabs-target="panel" class="hidden"><%= render "manage/shows/edit/tab_media", form: form %></div>
    <div data-tabs-target="panel" class="hidden"><%= render "manage/shows/linked_events", show: @show, production: @production %></div>
    <div data-tabs-target="panel" class="hidden"><%= render "manage/shows/edit/tab_danger", form: form %></div>

    <div class="border-t border-gray-200 pt-5 mt-8 flex items-center gap-2">
      <%= render "shared/button", text: "Save Changes", variant: "primary", size: "medium", type: :submit %>
      <%= render "shared/button", text: "Back", variant: "ghost-cancel", size: "medium", path: "javascript:history.back()", type: :button %>
    </div>

  <% end %>

  <%= render "manage/shows/edit/move_modal" %>
  <%= render "manage/shows/edit/location_modal" %>
  <%= render "manage/shows/edit/danger_modals" %>
</div>

<%# Turbo frame for the recurring series modal %>
<%= turbo_frame_tag "recurring_series_modal" %>
