                            </imageView>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" tag="1" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchTitle" translatesAutoresizingMaskIntoConstraints="NO" id="TitleImageView">
                                <rect key="frame" x="64" y="123" width="265" height="74"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="265" id="TitleWidth"/>
                                    <constraint firstAttribute="height" constant="74" id="TitleHeight"/>
                                </constraints>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" tag="2" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="The platform for live entertainment production" textAlignment="center" lineBreakMode="wordWrap" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="TaglineLabel">
                                <rect key="frame" x="51.5" y="205" width="290" height="46"/>
                                <fontDescription key="fontDescription" type="system" weight="medium" pointSize="19"/>
