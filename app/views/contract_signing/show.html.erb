<% content_for :title, "Sign your contract with #{@organization.name}" %>

<div class="min-h-screen bg-gray-50 py-10 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-8">
      <h1 class="text-3xl coustard-regular text-gray-900">Review &amp; sign</h1>
      <p class="mt-2 text-sm text-gray-600">
        <%= @organization.name %> — <%= @contract.production_name.presence || @contract.production&.name || "Contract" %>
      </p>
    </div>

    <% if flash[:alert] %>
      <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-600"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <%# The contract document %>
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
        <h2 class="text-sm font-semibold text-gray-700">Contract</h2>
      </div>
      <div class="p-6 max-h-[60vh] overflow-y-auto">
        <div class="prose prose-sm max-w-none
                    [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:my-1
                    [&_table]:w-full [&_table]:text-sm [&_table]:my-3 [&_th]:text-left [&_th]:font-medium [&_th]:text-gray-500 [&_th]:border-b [&_th]:py-1 [&_td]:py-1 [&_td]:border-b [&_td]:border-gray-100
                    [&_hr]:my-5 [&_h3]:mt-5 [&_h4]:mt-4 [&_h4]:font-semibold">
          <%= @document %>
        </div>
      </div>
    </div>

    <%# Sign %>
    <div class="bg-white shadow rounded-lg overflow-hidden mt-6">
      <div class="px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-pink-500 to-pink-600">
        <h2 class="text-sm font-semibold text-white">Sign this contract</h2>
      </div>
      <%= form_with url: sign_contract_path(token: @token), method: :post, data: { controller: "sign-gate" } do %>
        <div class="p-6 space-y-4">
          <div>
            <label for="signer_name" class="block text-sm font-medium text-gray-900 mb-1.5">Your full name <span class="text-pink-500">*</span></label>
            <input type="text" name="signer_name" id="signer_name" required autocomplete="name"
                   value="<%= @contract.contractor_name %>"
                   data-sign-gate-target="name" data-action="input->sign-gate#update"
                   class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
          </div>

          <div>
            <label for="signer_email" class="block text-sm font-medium text-gray-900 mb-1.5">Your email</label>
            <input type="email" name="signer_email" id="signer_email" autocomplete="email"
                   value="<%= @contract.contractor_email %>"
                   class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
          </div>

          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" name="agree" value="1"
                   data-sign-gate-target="agree" data-action="change->sign-gate#update"
                   class="mt-1 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
            <span class="text-sm text-gray-700">I agree that this is a legally binding contract, and that typing my name and submitting this form is my electronic signature.</span>
          </label>

          <p class="text-xs text-gray-500">Your signature will be recorded with the date, time, and your IP address for the record.</p>
        </div>

        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">
          <%# Starts enabled so it works without JS; sign-gate disables until valid when present, and the server validates regardless. %>
          <%= render "shared/button", text: "Agree & sign", variant: "primary", size: "medium", type: :submit,
                classes: "disabled:opacity-50 disabled:cursor-not-allowed",
                data: { sign_gate_target: "submit" } %>
        </div>
      <% end %>
    </div>

    <p class="text-center text-xs text-gray-400 mt-6">Powered by CocoScout</p>
  </div>
</div>
