<%= render layout: "manage/contracts/amend_layout", locals: { step_name: "Change dates", width: "max-w-3xl" } do %>
    <p class="text-gray-600 mb-6">
      Each date stands on its own. Removing one takes its still-pending payments with it and leaves
      the rest of the deal exactly as it is.
    </p>

    <%# Submits to review first — the plan is shown back before anything changes.
        GET, because review only previews — and because Turbo drops a POST
        response that renders 200 HTML instead of redirecting. A GET has to fit
        in the address (Puma takes 10KB of query, then answers an empty 400 that
        Turbo shows as nothing), so a row sends its times only while it's being
        moved: the rest are disabled (amend_date_controller). %>
    <% if @date_request && @prefill.any? %>
      <div class="mb-4 rounded-lg border border-pink-200 bg-pink-50 px-4 py-3 text-sm text-gray-700" data-from-date-request>
        <span class="font-medium text-gray-900"><%= @contract.contractor_name %> <%= @date_request.asks_words %>.</span>
        That date starts on what they asked for. Change anything before you continue.
      </div>
    <% end %>
    <%= form_with url: review_amend_dates_manage_contract_path(@contract), method: :get, html: { novalidate: true } do %>
      <div class="space-y-3">
        <% @rentals.each do |rental| %>
          <%
            show = @shows_by_rental[rental.id]
            payments = @contract.contract_payments.select { |p| p.show_id == show&.id || p.due_date == rental.starts_at.to_date }
            # Ask the service, so the warning matches what removing actually does.
            settled = ContractDateChanges.settled_for?(contract: @contract, rental: rental, shows: [ show ].compact)
            ticketed = ContractDateChanges.tickets_held?([ show ].compact)
            pending = payments.select { |p| p.status_pending? && !p.in_payout_run? }
            past = rental.starts_at < Time.current
            # Opened from the contractor's request about this date: it starts
            # on what they asked (ContractDateRequests.amend_prefill).
            asked = (@prefill || {})[rental.id]
            asked_move = asked && asked[:action] == "move"
            asked_remove = asked && asked[:action] == "remove"
          %>
          <div class="border border-gray-200 rounded-lg p-4 bg-gray-50" data-controller="amend-date">
            <div class="flex items-start justify-between gap-4 flex-wrap">
              <div class="min-w-0">
                <p class="font-medium text-gray-900">
                  <%= rental.starts_at.strftime("%A, %b %-d, %Y") %>
                  <span class="text-gray-400 font-normal">· <%= rental.starts_at.strftime("%-l:%M %p") %>–<%= rental.ends_at.strftime("%-l:%M %p") %></span>
                  <% if rental.has_separate_event_time? %>
                    <span class="text-pink-600 font-normal text-sm">· show <%= rental.effective_event_starts_at.strftime("%-l:%M %p") %>–<%= rental.effective_event_ends_at.strftime("%-l:%M %p") %></span>
                  <% end %>
                </p>
                <p class="text-xs text-gray-500 mt-0.5">
                  <%= rental.location_space&.name || "Entire Venue" %> at <%= rental.location&.name %>
                  <% if past %><span class="text-gray-400">· already happened</span><% end %>
                </p>

                <% if ticketed %>
                  <p class="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded px-2 py-1 mt-2 inline-block">
                    People hold tickets for this night. Removing it cancels the show and frees the room; refund them from its ticketing page. To change its time, use Move: they keep their tickets.
                  </p>
                <% elsif settled %>
                  <p class="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded px-2 py-1 mt-2 inline-block">
                    Already settled — removing this cancels the show and frees the room, but leaves the money that already moved alone.
                  </p>
                <% elsif pending.any? %>
                  <p class="text-xs text-gray-500 mt-1.5">
                    Removing it also drops <%= pluralize(pending.size, "pending payment") %>
                    (<%= pending.map { |p| p.amount_tbd? ? "TBD" : number_to_currency(p.amount) }.to_sentence %>).
                  </p>
                <% end %>
              </div>

              <div class="flex items-center gap-3 flex-shrink-0">
                <label class="flex items-center gap-1.5 text-sm cursor-pointer">
                  <input type="radio" name="dates[<%= rental.id %>][action]" value="keep" <%= "checked" unless asked %>
                         class="accent-pink-500" data-action="change->amend-date#modeChanged">
                  <span class="text-gray-700">Keep</span>
                </label>
                <label class="flex items-center gap-1.5 text-sm cursor-pointer">
                  <input type="radio" name="dates[<%= rental.id %>][action]" value="move" <%= "checked" if asked_move %>
                         class="accent-pink-500" data-action="change->amend-date#modeChanged">
                  <span class="text-gray-700">Move</span>
                </label>
                <label class="flex items-center gap-1.5 text-sm cursor-pointer">
                  <input type="radio" name="dates[<%= rental.id %>][action]" value="remove" <%= "checked" if asked_remove %>
                         class="accent-pink-500" data-action="change->amend-date#modeChanged">
                  <span class="text-gray-700"><%= settled || ticketed ? "Cancel" : "Remove" %></span>
                </label>
              </div>
            </div>

            <%# Moving keeps the show itself, so its buyers, cast and staffing follow.
                The booking and the show inside it each have their own times. %>
            <div data-amend-date-target="moveFields" class="<%= "hidden" unless asked_move %> mt-3 pt-3 border-t border-gray-100">
              <% if asked_move %>
                <%= render "manage/contracts/night_times_fields", rental: rental, prefix: "dates[#{rental.id}]", times: asked[:times], disabled: false %>
              <% else %>
                <%= render "manage/contracts/night_times_fields", rental: rental, prefix: "dates[#{rental.id}]", disabled: true %>
              <% end %>
              <p class="text-xs text-gray-500 mt-3">The show keeps its ticket buyers, cast and staffing; they move with it.</p>
            </div>
          </div>
        <% end %>
      </div>

      <% if @rentals.empty? %>
        <p class="text-sm text-gray-500">This contract has no dates on it yet.</p>
      <% end %>

      <div class="flex items-center justify-between mt-6">
        <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", icon: "arrow-left",
              path: amend_choose_manage_contract_path(@contract) %>
        <% if @rentals.any? %>
          <%= render "shared/button", text: "Review changes", variant: "primary", size: "medium", type: :submit %>
        <% end %>
      </div>
    <% end %>

    <p class="text-xs text-gray-500 mt-4">
      Adding a date? Use <%= link_to "Change the deal", amend_bookings_manage_contract_path(@contract), class: "text-pink-600 hover:text-pink-700 underline" %>,
      which knows how to price a new one.
    </p>
<% end %>
