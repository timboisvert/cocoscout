<%# Contract Settings → Services: which of the organization's services
    (Organization settings → Services) contracts offer, and each one's usual
    terms. A blank price is the service's default price (after-V1 #6). %>
<%
  input = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-base sm:text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  dir_options = [ [ "They pay us", "incoming" ], [ "We pay them", "outgoing" ] ]
  mode_options = [ [ "Once", "once" ], [ "Per event", "per_event" ] ]
  org_services_path = section_manage_organization_path(Current.organization, section: "services")
%>
<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
  <%= render "shared/section_heading", title: "Offered on contracts" do %>
    <%= link_to org_services_path do %>
      <%= render "shared/button", text: "Your services", variant: "secondary", size: "small" %>
    <% end %>
  <% end %>
  <p class="px-6 pt-4 text-sm text-gray-600">
    Tick the services a contract can include. Each starts at its default price; every contract can change it.
    <%= link_to "Manage your organization's services", org_services_path, class: "font-medium text-pink-600 hover:text-pink-700" %>
  </p>

  <% if @services.any? %>
    <%= form_with url: manage_contract_settings_services_path, method: :patch do %>
      <div class="hidden md:grid grid-cols-[1.5rem_minmax(0,1fr)_10rem_9rem_8rem] gap-4 px-6 pt-4 pb-2 text-xs font-medium text-gray-500">
        <span class="col-span-2">Service</span><span>Price on contracts</span><span>Who pays</span><span>Booked</span>
      </div>
      <div class="divide-y divide-gray-100 border-t border-gray-100 md:border-t-0 mt-3 md:mt-0">
        <% @services.each do |service| %>
          <% key = "services[#{service.id}]" %>
          <div class="px-4 sm:px-6 py-3 flex flex-col gap-3 md:grid md:grid-cols-[1.5rem_minmax(0,1fr)_10rem_9rem_8rem] md:gap-4 md:items-center">
            <%= hidden_field_tag "#{key}[offered]", "0", id: nil %>
            <label class="md:col-span-2 flex items-start gap-3 cursor-pointer min-w-0">
              <%= check_box_tag "#{key}[offered]", "1", service.offered_on_contracts?, id: "offered_#{service.id}", class: "mt-1 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
              <span class="min-w-0">
                <span class="block text-[15px] font-medium text-gray-900"><%= service.name %></span>
                <span class="block text-xs text-gray-500"><%= service.staffed? ? "Done by #{service.house_roles.map(&:name).sort.to_sentence(two_words_connector: ' or ', last_word_connector: ', or ')}" : "Equipment" %></span>
              </span>
            </label>
            <div>
              <label class="md:hidden block text-xs font-medium text-gray-700 mb-1" for="price_<%= service.id %>">Price on contracts</label>
              <%= text_field_tag "#{key}[price]", (service.contract_price_cents ? format("%.2f", service.contract_price_cents / 100.0) : nil),
                    id: "price_#{service.id}", inputmode: "decimal", placeholder: "Default: #{service.price_label}", class: input %>
            </div>
            <div>
              <label class="md:hidden block text-xs font-medium text-gray-700 mb-1" for="direction_<%= service.id %>">Who pays</label>
              <%= select_tag "#{key}[direction]", options_for_select(dir_options, service.contract_direction), id: "direction_#{service.id}", class: input %>
            </div>
            <div>
              <label class="md:hidden block text-xs font-medium text-gray-700 mb-1" for="booking_<%= service.id %>">Booked</label>
              <%= select_tag "#{key}[booking_mode]", options_for_select(mode_options, service.contract_booking_mode), id: "booking_#{service.id}", class: input %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="px-6 py-4 border-t border-gray-200 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-gray-500">Leave a price blank to use the service's default price.</p>
        <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
  <% else %>
    <p class="px-6 py-6 text-sm text-gray-600">
      Your organization hasn't added any services yet.
      <%= link_to "Add them in Organization settings", org_services_path, class: "font-medium text-pink-600 hover:text-pink-700" %>
      (a booth tech at an hourly rate, say), then choose here which contracts offer.
    </p>
  <% end %>
</div>
