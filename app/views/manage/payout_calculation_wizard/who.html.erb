<%
  input_classes = "px-3 py-2.5 bg-white border border-gray-300 rounded-md text-sm shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
  radio_classes = "mt-0.5 h-4 w-4 text-pink-500 border-gray-300 focus:ring-pink-500 accent-pink-500"
  editing_id = @state[:editing_id].presence&.to_i
  starting = @starting_on.present? ? "date" : "now"
  steps = steps_for_state
%>
<%= render layout: "manage/payout_calculation_wizard/wizard_layout", locals: { current_step: :who, step_name: "Who uses it" } do %>
  <div class="text-center mb-6">
    <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h7.5c.621 0 1.125-.504 1.125-1.125m-9.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-7.5A1.125 1.125 0 0 1 12 18.375m9.75-12.75c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125m19.5 0v1.5c0 .621-.504 1.125-1.125 1.125M2.25 5.625v1.5c0 .621.504 1.125 1.125 1.125m0 0h17.25m-17.25 0h7.5c.621 0 1.125.504 1.125 1.125M3.375 8.25c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m17.25-3.75h-7.5c-.621 0-1.125.504-1.125 1.125m8.625-1.125c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125M12 10.875v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125M13.125 12h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125M20.625 12c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5M12 14.625v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 14.625c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125m0 1.5v-1.5m0 0c0-.621.504-1.125 1.125-1.125m0 0h7.5" />
      </svg>
    </div>
    <h2 class="text-xl font-bold text-gray-900 coustard-regular">Which productions should use this calculation?</h2>
    <p class="text-gray-600 mt-2">Every show in a checked production starts from it. You can change a production's calculation any time from its Pay tab, and leave them all unchecked to keep this one on the shelf for now.</p>
  </div>

  <%= form_with url: manage_money_payout_calculation_wizard_save_who_path, method: :post, local: true, id: "who-form", data: { controller: "payout-calculation-who" } do |form| %>
    <% if @productions.empty? %>
      <p class="text-sm text-gray-600 text-center py-4">You don't have any productions yet. Once you make one, its Pay tab can pick this calculation.</p>
    <% else %>
      <div class="space-y-2">
        <% @productions.each do |production| %>
          <% current = @current_calculations[production.id] %>
          <% checked = @default_production_ids.include?(production.id) %>
          <% is_this = current && editing_id && current.id == editing_id %>
          <% note_id = "switch-note-#{production.id}" %>
          <label class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 bg-white cursor-pointer hover:bg-gray-50 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50">
            <input type="checkbox" name="default_production_ids[]" value="<%= production.id %>"
                   <%= "checked" if checked %>
                   <% if current && !is_this %>data-action="change->payout-calculation-who#toggleNote" data-note-id="<%= note_id %>"<% end %>
                   class="mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
            <span class="min-w-0">
              <span class="block text-sm font-medium text-gray-900"><%= production.name %></span>
              <% if current %>
                <span class="block text-xs text-gray-500 mt-0.5">Currently uses <span class="font-medium text-gray-700"><%= current.name %></span></span>
                <% unless is_this %>
                  <span id="<%= note_id %>" class="<%= 'hidden' unless checked %> mt-1 inline-block text-xs font-medium text-pink-700 bg-pink-50 border border-pink-200 rounded px-2 py-0.5">Will switch from <%= current.name %> to this calculation</span>
                <% end %>
              <% else %>
                <span class="block text-xs text-gray-500 mt-0.5">None yet</span>
              <% end %>
            </span>
          </label>
        <% end %>
      </div>

      <div class="mt-6 pt-6 border-t border-gray-200">
        <p class="block text-sm font-medium text-gray-900 mb-2">Starting</p>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="starting" value="now" <%= "checked" if starting == "now" %>
                   data-action="change->payout-calculation-who#toggleDate" class="<%= radio_classes %>">
            <span class="text-sm text-gray-900">Now</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="starting" value="date" <%= "checked" if starting == "date" %>
                   data-action="change->payout-calculation-who#toggleDate" class="<%= radio_classes %>">
            <span class="text-sm text-gray-900">On a date</span>
          </label>
          <input type="date" name="starting_on" value="<%= @starting_on %>"
                 data-payout-calculation-who-target="date"
                 class="<%= 'hidden' unless starting == 'date' %> <%= input_classes %>">
        </div>
        <p class="mt-1.5 text-xs text-gray-500">"Now" covers every show in the production, including nights already on the calendar that haven't been paid out. A date leaves earlier shows on whatever they use today.</p>
      </div>
    <% end %>

    <div class="mt-8 flex justify-between items-center">
      <%= link_to wizard_path(steps[steps.index(:who) - 1]), class: "text-gray-500 hover:text-gray-700 text-sm py-2" do %>
        &larr; Back
      <% end %>
      <%= render "shared/button", text: "Next", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>
