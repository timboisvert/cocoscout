<% input_classes = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-md text-sm shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
<%= render layout: "manage/payout_calculation_wizard/wizard_layout", locals: { current_step: :name, step_name: "Name" } do %>
  <div class="text-center mb-6">
    <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h2 class="text-xl font-bold text-gray-900 coustard-regular">What should this calculation be called?</h2>
    <p class="text-gray-600 mt-2">A payout calculation is how a show's money becomes each performer's pay. You'll pick it by name when you set a production's pay, so name it the way you'd say it out loud.</p>
  </div>

  <%= form_with url: manage_money_payout_calculation_wizard_save_name_path, method: :post, local: true do |form| %>
    <div class="space-y-5">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-900 mb-1.5">
          Name
          <span class="text-pink-500">*</span>
        </label>
        <input type="text"
               name="name"
               id="name"
               value="<%= @state[:name] %>"
               placeholder="e.g., Friday door split, $50 flat, Burlesque act pay"
               autofocus
               required
               class="<%= input_classes %>">
      </div>

      <div>
        <label for="description" class="block text-sm font-medium text-gray-900 mb-1.5">
          Description
          <span class="text-gray-400 font-normal">(optional)</span>
        </label>
        <textarea name="description"
                  id="description"
                  rows="3"
                  placeholder="A note to yourself about when this one applies…"
                  class="<%= input_classes %>"><%= @state[:description] %></textarea>
      </div>
    </div>

    <div class="mt-8 flex justify-end">
      <%= render "shared/button", text: "Next", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>
