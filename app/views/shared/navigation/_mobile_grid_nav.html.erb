<%#
  The phone's navigation on the website (navigation canvas, mobile web row),
  shared by every context. The top bar: the menu button, then the CocoScout
  wordmark, or in production mode the organization with "Production mode"
  under it on soft pink (tapping it opens the organization sheet), then the
  universal Messages and Notifications icons. The menu sheet opens on you: a
  plain outlined card with Profile, Settings and Sign out; in production
  mode the organization row under it; the nav's tiles; then Work the door
  (black) and the mode switch (CocoScout pink) at the bottom (Tim,
  2026-10-20). No dashboard switcher.
  Locals: context (:talent, :production, :account, :superadmin).
%>
<% production_mode = context.to_sym == :production && Current.organization.present? %>
<% icons = panel_universal_icons(production_mode: production_mode) %>
<% switch = %i[talent production].include?(context.to_sym) || panel_last_mode_production? ? panel_mode_switch(production_mode: production_mode || (context.to_sym != :talent && panel_last_mode_production?)) : nil %>
<div data-controller="mobile-nav" class="app-top-chrome fixed inset-x-0 top-0 z-30 border-b lg:hidden <%= production_mode ? 'bg-pink-50 border-pink-200' : 'bg-white border-pink-100' %>">
  <div class="grid grid-cols-[52px_minmax(0,1fr)_96px] items-center h-[52px] px-1">
    <button type="button" data-action="mobile-nav#toggle" class="w-11 h-11 flex items-center justify-center text-pink-500" aria-label="Menu">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <% if production_mode %>
      <button type="button" data-action="mobile-nav#showOrgPopup" class="min-h-[44px] flex flex-col items-center justify-center gap-px cursor-pointer min-w-0"
              aria-label="Organization: <%= Current.organization.name %>, production mode. Change organization">
        <span class="flex items-center gap-1 text-[15px] font-bold text-gray-900 max-w-full">
          <span class="truncate"><%= Current.organization.name %></span>
          <svg class="w-3.5 h-3.5 text-gray-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </span>
        <span class="text-[10px] font-bold uppercase tracking-[0.08em] text-pink-700">Production mode</span>
      </button>
    <% else %>
      <%= link_to "CocoScout", my_dashboard_path, class: "text-center coustard-regular text-lg text-pink-600" %>
    <% end %>
    <div class="flex justify-end">
      <%= render "shared/navigation/universal_icon", kind: :messages, size: :bar, **icons[:messages] %>
      <%= render "shared/navigation/universal_icon", kind: :notifications, size: :bar, **icons[:notifications] %>
    </div>
  </div>

  <%# ===== MENU SHEET ===== %>
  <div data-mobile-nav-target="panel" class="app-top-chrome hidden fixed inset-0 top-[53px] bg-[#f9f9f7] z-40 flex flex-col">
    <div class="flex-1 overflow-y-auto px-4 pt-3.5 pb-4 flex flex-col gap-3">
      <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden flex-shrink-0">
        <div class="flex items-center gap-3 px-3.5 py-3">
          <% headshot = Current.user.person&.safe_headshot_variant(:thumb) %>
          <% if headshot %>
            <%= image_tag headshot, alt: "", class: "w-11 h-11 rounded-lg object-cover flex-shrink-0" %>
          <% else %>
            <span class="w-11 h-11 rounded-lg bg-pink-100 text-pink-700 font-bold text-sm flex items-center justify-center flex-shrink-0"><%= Current.user.person&.initials || Current.user.email_address[0].upcase %></span>
          <% end %>
          <span class="min-w-0 flex flex-col">
            <span class="text-[15px] font-bold text-gray-900 truncate"><%= Current.user.person&.name || "My Account" %></span>
            <span class="text-[13px] text-gray-500 truncate"><%= Current.user.email_address %></span>
          </span>
        </div>
        <% links = [ [ "Profile", profile_path ], [ "Settings", account_path ] ] %>
        <% links << [ "Superadmin", superadmin_path ] if Current.user.superadmin? %>
        <% links << [ "Sign out", signout_path ] %>
        <div class="grid border-t border-gray-100" style="grid-template-columns: repeat(<%= links.size %>, minmax(0, 1fr))">
          <% links.each_with_index do |(text, path), i| %>
            <%= link_to text, path, class: "min-h-[44px] flex items-center justify-center text-sm font-semibold text-gray-800 hover:bg-gray-50 #{'border-l border-gray-100' if i.positive?}",
                  data: (path == signout_path ? { turbo_prefetch: false } : {}) %>
          <% end %>
        </div>
      </div>

      <% if production_mode %>
        <button type="button" data-action="mobile-nav#showOrgPopup" class="flex items-center justify-between gap-2.5 min-h-[48px] px-3.5 bg-pink-50 border border-pink-200 rounded-2xl text-left cursor-pointer flex-shrink-0">
          <span class="flex items-center gap-2.5 min-w-0">
            <%= render "shared/navigation/organization_monogram", organization: Current.organization, size: 28 %>
            <span class="text-[15px] font-bold text-gray-900 truncate"><%= Current.organization.name %></span>
            <svg class="w-3.5 h-3.5 text-pink-700 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </span>
          <span class="text-[10px] font-bold uppercase tracking-[0.08em] text-pink-700 flex-shrink-0">Production mode</span>
        </button>
      <% end %>

      <% panel_nav_sections(context).each do |section| %>
        <% if section[:label].present? %>
          <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-gray-500"><%= section[:label] %></div>
        <% end %>
        <div class="grid grid-cols-3 gap-2.5">
          <% section[:items].each do |item| %>
            <%= render "shared/navigation/mobile_grid_tile", item: item, full: false %>
          <% end %>
        </div>
      <% end %>

      <div class="flex-1"></div>
      <% if context.to_sym == :talent && (door_bar = door_bar_item(Current.user)) %>
        <%= render "shared/navigation/door_bar", item: door_bar, size: :mobile %>
      <% end %>
      <% if switch %>
        <%= render "shared/navigation/mode_switch", switch: switch, size: :bar %>
      <% elsif context.to_sym == :talent && !turbo_native_app? %>
        <%# Website only: the apps never pitch producing (Tim, 2026-10-20). %>
        <%= link_to manage_producer_setup_path, class: "flex items-center gap-2.5 min-h-[48px] px-3.5 text-sm text-gray-600" do %>
          <svg class="w-[18px] h-[18px] text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16M15 9h4a1 1 0 0 1 1 1v11M3 21h18"/></svg>
          <span><strong class="text-gray-700">Start producing</strong> · run your own shows on CocoScout</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if production_mode %>
    <%= render "shared/navigation/organization_sheet" %>
  <% end %>
</div>
