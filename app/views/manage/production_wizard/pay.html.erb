<%
  pays = @wizard_state[:pays_performers].presence || "no"
  has_schemes = @payout_schemes.any?
  presets = new_scheme_presets
  # Which way to get the scheme: what they picked, else the sensible start —
  # an existing scheme when the org has any, otherwise a new one.
  choice = @wizard_state[:pay_choice].presence || (has_schemes ? "existing" : "new")
  choice = "new" if choice == "existing" && !has_schemes
  chosen_id = @wizard_state[:payout_scheme_id]
  # In act mode the recommended preset is already picked; otherwise they choose.
  chosen_preset = @wizard_state[:new_scheme_preset].presence || (act_based_wizard? ? "per_act" : nil)
  input_classes = "w-full px-3 py-2.5 border border-gray-300 rounded-md text-sm shadow-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
  card_on = "border-pink-500 bg-pink-50"
  card_off = "border-gray-200 bg-gray-50"
  radio_classes = "mt-1 h-4 w-4 text-pink-500 border-gray-300 focus:ring-pink-500 accent-pink-500"
%>
<%= render layout: "manage/production_wizard/wizard_layout", locals: { current_step: :pay, step_name: "Pay" } do %>
  <div class="text-center mb-6">
    <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
      </svg>
    </div>
    <h2 class="text-xl font-bold text-gray-900 coustard-regular">Will performers be paid for this production?</h2>
    <p class="text-gray-600 mt-2">A payout scheme decides how each show's money is split among the people cast in it. You can set this up or change it any time in Money.</p>
  </div>

  <%= form_with url: manage_productions_wizard_save_pay_path, method: :post, local: true, id: "pay-form" do |form| %>
    <% if @pay_error.present? %>
      <p id="pay-error" class="mb-4 text-sm text-red-600" role="alert"><%= @pay_error %></p>
    <% end %>

    <div class="space-y-4">
      <!-- No option -->
      <label class="block cursor-pointer">
        <div data-radio-card="pays_performers" data-card-value="no" class="p-4 rounded-lg border-2 transition-colors <%= pays == 'no' ? card_on : card_off %> hover:border-pink-300">
          <div class="flex items-start">
            <input type="radio" name="pays_performers" value="no" <%= "checked" if pays == 'no' %> class="<%= radio_classes %>">
            <div class="ml-3">
              <p class="font-medium text-gray-900">No</p>
              <p class="text-sm text-gray-500 mt-1">Nobody is paid through CocoScout for this production</p>
            </div>
          </div>
        </div>
      </label>

      <!-- Yes option -->
      <label class="block cursor-pointer">
        <div data-radio-card="pays_performers" data-card-value="yes" class="p-4 rounded-lg border-2 transition-colors <%= pays == 'yes' ? card_on : card_off %> hover:border-pink-300">
          <div class="flex items-start">
            <input type="radio" name="pays_performers" value="yes" <%= "checked" if pays == 'yes' %> class="<%= radio_classes %>">
            <div class="ml-3">
              <p class="font-medium text-gray-900">Yes</p>
              <p class="text-sm text-gray-500 mt-1">Every show starts from a payout scheme — pick one or set one up</p>
            </div>
          </div>
        </div>
      </label>

      <!-- How to get the scheme (shown when yes is selected) -->
      <div id="pay-choice-section" class="<%= pays == 'yes' ? '' : 'hidden' %> ml-4 pl-4 border-l-2 border-pink-200 space-y-3">
        <p class="text-sm font-medium text-gray-700">Which payout scheme should its shows start from?</p>

        <% if has_schemes %>
          <!-- Existing scheme -->
          <label class="block cursor-pointer">
            <div data-radio-card="pay_choice" data-card-value="existing" class="p-4 rounded-lg border-2 transition-colors <%= choice == 'existing' ? card_on : card_off %> hover:border-pink-300">
              <div class="flex items-start">
                <input type="radio" name="pay_choice" value="existing" <%= "checked" if choice == 'existing' %> class="<%= radio_classes %>">
                <div class="ml-3">
                  <p class="font-medium text-gray-900">Use an existing scheme</p>
                  <p class="text-sm text-gray-500 mt-1">One of your organization's payout schemes</p>
                </div>
              </div>
            </div>
          </label>
          <div id="existing-scheme-section" class="<%= choice == 'existing' ? '' : 'hidden' %> ml-4 pl-4 border-l-2 border-pink-200 space-y-2">
            <label for="payout_scheme_id" class="block text-sm font-medium text-gray-700">Payout scheme</label>
            <select name="payout_scheme_id" id="payout_scheme_id" class="<%= input_classes %>">
              <option value="" data-summary="" <%= "selected" if chosen_id.blank? %>>Choose a scheme…</option>
              <% @payout_schemes.each do |scheme| %>
                <option value="<%= scheme.id %>" data-summary="<%= scheme.rules_summary %>" <%= "selected" if chosen_id.to_s == scheme.id.to_s %>><%= scheme.name %></option>
              <% end %>
            </select>
            <p id="payout-scheme-summary" class="text-sm text-gray-600 min-h-[1.25rem]"><%= chosen_id.present? ? @payout_schemes.find { |s| s.id.to_s == chosen_id.to_s }&.rules_summary : "" %></p>
          </div>
        <% end %>

        <!-- New scheme from a preset -->
        <label class="block cursor-pointer">
          <div data-radio-card="pay_choice" data-card-value="new" class="p-4 rounded-lg border-2 transition-colors <%= choice == 'new' ? card_on : card_off %> hover:border-pink-300">
            <div class="flex items-start">
              <input type="radio" name="pay_choice" value="new" <%= "checked" if choice == 'new' %> class="<%= radio_classes %>">
              <div class="ml-3">
                <p class="font-medium text-gray-900">Set up a new scheme</p>
                <p class="text-sm text-gray-500 mt-1">Start from a preset. You'll set the amounts on the next screen.</p>
              </div>
            </div>
          </div>
        </label>
        <div id="new-scheme-section" class="<%= choice == 'new' ? '' : 'hidden' %> ml-4 pl-4 border-l-2 border-pink-200">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <% presets.each do |key, preset| %>
              <% recommended = act_based_wizard? && key == :per_act %>
              <label class="block cursor-pointer">
                <div data-radio-card="new_scheme_preset" data-card-value="<%= key %>" class="h-full p-3 rounded-lg border-2 transition-colors <%= chosen_preset.to_s == key.to_s ? card_on : card_off %> hover:border-pink-300">
                  <div class="flex items-start">
                    <input type="radio" name="new_scheme_preset" value="<%= key %>" <%= "checked" if chosen_preset.to_s == key.to_s %> class="<%= radio_classes %>">
                    <div class="ml-3 min-w-0">
                      <p class="font-medium text-gray-900 text-sm flex items-center gap-2 flex-wrap">
                        <span><%= preset[:name] %></span>
                        <% if recommended %>
                          <span class="text-[9px] font-bold uppercase tracking-wide text-pink-600 bg-pink-50 border border-pink-200 rounded px-1 py-0.5 leading-none">Recommended</span>
                        <% end %>
                      </p>
                      <p class="text-xs text-gray-500 mt-1"><%= preset[:description] %></p>
                    </div>
                  </div>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <!-- Decide later -->
        <label class="block cursor-pointer">
          <div data-radio-card="pay_choice" data-card-value="later" class="px-4 py-3 rounded-lg border-2 transition-colors <%= choice == 'later' ? card_on : card_off %> hover:border-pink-300">
            <div class="flex items-start">
              <input type="radio" name="pay_choice" value="later" <%= "checked" if choice == 'later' %> class="<%= radio_classes %>">
              <div class="ml-3">
                <p class="text-sm font-medium text-gray-900">Decide later</p>
                <p class="text-xs text-gray-500 mt-0.5">Pick a scheme in Money once the production exists</p>
              </div>
            </div>
          </div>
        </label>
      </div>
    </div>

    <div class="mt-8 flex justify-between items-center">
      <%= link_to manage_productions_wizard_roles_path, class: "text-gray-500 hover:text-gray-700 text-sm py-2" do %>
        ← Back
      <% end %>
      <%= render "shared/button", text: "Next", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>

<script>
(function() {
  const ON = ['border-pink-500', 'bg-pink-50'];
  const OFF = ['border-gray-200', 'bg-gray-50'];
  const sections = {
    'pay-choice-section': () => checkedValue('pays_performers') === 'yes',
    'existing-scheme-section': () => checkedValue('pay_choice') === 'existing',
    'new-scheme-section': () => checkedValue('pay_choice') === 'new'
  };

  function checkedValue(name) {
    const el = document.querySelector('input[name="' + name + '"]:checked');
    return el ? el.value : null;
  }

  function paintCards(name) {
    const value = checkedValue(name);
    document.querySelectorAll('[data-radio-card="' + name + '"]').forEach(card => {
      const on = card.dataset.cardValue === value;
      card.classList.remove(...(on ? OFF : ON));
      card.classList.add(...(on ? ON : OFF));
    });
  }

  function refresh() {
    ['pays_performers', 'pay_choice', 'new_scheme_preset'].forEach(paintCards);
    Object.keys(sections).forEach(id => {
      const el = document.getElementById(id);
      if (el) el.classList.toggle('hidden', !sections[id]());
    });
  }

  document.querySelectorAll('input[name="pays_performers"], input[name="pay_choice"], input[name="new_scheme_preset"]').forEach(radio => {
    radio.addEventListener('change', refresh);
  });

  // Live description of the selected existing scheme.
  const schemeSelect = document.getElementById('payout_scheme_id');
  const schemeSummary = document.getElementById('payout-scheme-summary');
  if (schemeSelect && schemeSummary) {
    schemeSelect.addEventListener('change', function() {
      const opt = this.options[this.selectedIndex];
      schemeSummary.textContent = opt ? (opt.dataset.summary || '') : '';
    });
  }
})();
</script>
