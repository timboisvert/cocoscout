<%# Rooms and seating: Ticketing's side of every room the organization has
    (RoomTicketingSetting). The rooms themselves are made on Organization
    settings → Locations; here is how tickets in each one sell, the chart a
    seated room opens with, and directions for buyers. A box per room, each
    with its own Save, drawn as the other Ticketing settings tabs are (Tim,
    2026-11-13). A location's only room goes by the location's name, and an
    archived location's rooms aren't here (Tim, 2026-11-18). %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  seating_built = RoomTicketingSetting.seating_built?
  locations_path = section_manage_organization_path(Current.organization, section: "locations")
%>
<div class="space-y-6">
  <% if @locations.empty? %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="rooms">
      <%= render "shared/section_heading", title: "Rooms and seating", intro: "How tickets sell in each of your rooms: by count, by seat, or both at once." %>
      <div class="px-6 py-5">
        <%= render "shared/empty_state", compact: true, icon: "calendar", title: "No locations yet", body: "Add a location and its rooms in Organization settings first.",
              actions: [ { text: "Locations", path: locations_path } ] %>
      </div>
    </div>
  <% end %>

  <% @locations.each do |location| %>
    <% location.location_spaces.sort_by { |room| room.name.to_s.downcase }.each do |room| %>
      <% setting = @room_settings[room.id] %>
      <% charts = seating_built && setting.persisted? ? setting.charts.to_a : [] %>
      <% here = room.known_as %>
      <%= form_with model: setting, url: manage_ticketing_settings_room_path(room), method: :patch do |f| %>
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="room-<%= room.id %>">
          <%= render "shared/section_heading", title: room.place_name,
                intro: "How tickets sell in #{here}, unless a production or a single date chooses for itself.#{" It holds up to #{number_with_delimiter(room.capacity)} people." if room.capacity.to_i.positive?}" %>
          <div class="px-6 py-5 space-y-6">
            <fieldset>
              <legend class="block text-sm font-medium text-gray-700 mb-1.5">How tickets sell</legend>
              <div class="space-y-2">
                <% RoomTicketingSetting::SEATING_MODE_LABELS.each do |value, label| %>
                  <% explanation = { "general" => "Tickets are sold by count. #{room.capacity.to_i.positive? ? "Sales stop at #{number_with_delimiter(room.capacity)} people unless a production sets its own counts." : 'Set the most people allowed on the room\'s own page to cap sales.'}",
                                     "reserved" => "Every ticket is a seat on a chart. Buyers pick their seats or take the best available.",
                                     "mixed" => "A chart with standing areas sold by count and seated sections sold by seat." }[value] %>
                  <label class="flex items-start gap-3 rounded-lg border border-gray-200 px-4 py-3 cursor-pointer has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50">
                    <%= f.radio_button :seating_mode, value, id: "room_#{room.id}_seating_mode_#{value}", class: "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500" %>
                    <span>
                      <span class="block text-sm font-medium text-gray-900"><%= label %></span>
                      <span class="block text-xs text-gray-600 mt-0.5"><%= explanation %></span>
                    </span>
                  </label>
                <% end %>
              </div>
            </fieldset>
            <% if seating_built %>
              <div>
                <%= f.label :default_seat_chart_id, "Chart a seated show opens with", for: "room_#{room.id}_default_seat_chart_id", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
                <% if charts.any? %>
                  <%= f.select :default_seat_chart_id, options_for_select(charts.map { |c| [ "#{c.name} (#{pluralize(c.seat_count, 'seat')}#{", #{c.standing_capacity} standing" if c.standing_capacity.positive?})", c.id ] }, setting.default_seat_chart_id),
                        { include_blank: "Pick when setting up a production" }, id: "room_#{room.id}_default_seat_chart_id", class: "#{input_class} max-w-md" %>
                  <ul class="mt-2 text-sm text-gray-600 space-y-1">
                    <% charts.each do |chart| %>
                      <li><%= link_to chart.name, manage_seat_chart_path(chart), class: "text-pink-600 hover:text-pink-700 underline" %> · <%= chart.status.capitalize %> · <%= pluralize(chart.seat_count, "seat") %></li>
                    <% end %>
                    <li><%= link_to "Draw another chart", manage_new_seat_chart_path(room_id: room.id), class: "text-pink-600 hover:text-pink-700 underline" %></li>
                  </ul>
                <% else %>
                  <p class="text-sm text-gray-600">There is no chart for <%= here %> yet. <%= link_to "Draw a chart", manage_new_seat_chart_path(room_id: room.id), class: "text-pink-600 hover:text-pink-700 underline" %>.</p>
                <% end %>
              </div>
            <% end %>
            <div>
              <%= f.label :buyer_directions, "Directions for buyers", for: "room_#{room.id}_buyer_directions", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
              <%= f.text_area :buyer_directions, rows: 2, maxlength: 500, id: "room_#{room.id}_buyer_directions", class: input_class, placeholder: "Enter through the lobby on Clark Street; the Lounge is downstairs." %>
              <p class="text-xs text-gray-500 mt-1">Buyers see these on the show's page and on the PDF ticket for shows in <%= here %>.</p>
            </div>
          </div>
          <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
            <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if @locations.any? %>
    <p class="text-sm text-gray-600">
      Each room sells one way: by count (general admission), by seat (reserved), or both at once (a standing floor and seated sections).
      A production can choose differently for itself, and so can a single date.
      Rooms are added and renamed in <%= link_to "Organization settings → Locations", locations_path, class: "text-pink-600 hover:text-pink-700 underline" %>.
    </p>
  <% end %>
</div>
