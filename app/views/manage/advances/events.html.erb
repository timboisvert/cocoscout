<%# Slim rows for one production's active advances, loaded lazily into the
    accordion on the advances list. Columns line up with the parent (To pay / To repay). %>
<%= turbo_frame_tag "advance-events-#{@production.id}" do %>
  <%= render "manage/advances/advance_rows", advances: @advances, production: @production, href_data: { turbo_frame: "_top" } %>
<% end %>
