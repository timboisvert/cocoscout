<%# One of the three headline analytics cards (People / Organizations / Mics).
    The whole card is a link to that section.
    locals: title, view_all_path, stats [{value, label}], chart_label, daily %>
<%= link_to view_all_path, class: "block border border-gray-200 rounded-lg overflow-hidden hover:border-pink-500 transition-all h-full" do %>
  <div class="px-4 py-3 bg-gray-50 border-b border-gray-200">
    <h2 class="font-semibold text-gray-900 coustard-regular"><%= title %></h2>
  </div>
  <div class="p-4">
    <div class="grid grid-cols-4 gap-2 mb-4">
      <% stats.each do |s| %>
        <div class="text-center">
          <div class="text-lg font-semibold text-gray-900"><%= s[:value] %></div>
          <div class="text-[11px] text-gray-500 mt-0.5 leading-tight"><%= s[:label] %></div>
        </div>
      <% end %>
    </div>

    <div class="h-36" data-controller="line-chart"
         data-line-chart-data-value="<%= daily.to_json %>"
         data-line-chart-color-value="#ec4899"
         data-line-chart-label-value="<%= chart_label %>">
      <canvas data-line-chart-target="canvas"></canvas>
    </div>
  </div>
<% end %>
