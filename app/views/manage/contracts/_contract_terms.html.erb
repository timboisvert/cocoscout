<%#
  Contract Terms — the deal as it reads in the signed contract, so nobody has to
  open the PDF to know what was agreed: which way the money flows, how it's
  priced and settled, who sells the tickets and at what prices, and any services
  on top. Bookings and the actual payment schedule live in their own panels.

  Locals:
    contract: Contract
%>
<%
  tiers = contract.draft_ticketing["tiers"] || []
  discounts = Contract.ticketing_discounts(contract.draft_ticketing)
  services = contract.draft_services
  tech = contract.draft_tech
  pdf_doc = contract.signed_pdf_document

  outgoing = contract.settlement_direction == "outgoing"
  money_comes_in = !outgoing || services.any? { |s| (s["direction"].presence || "incoming") == "incoming" }

  # The headline is the "how the money works" line; everything else is detail.
  # How they may pay us only matters when something on this deal flows our way.
  lines = contract.deal_summary
  lines = lines.reject { |l| l[:label] == "They may pay us by" } unless money_comes_in
  headline = lines.find { |l| l[:label] == "How the money works" }
  details = lines - [ headline ].compact

  show_ticketing = contract.org_sells_tickets? || tiers.any? || discounts.any?
  show_services = services.any? || tech["provider"].present?
%>
<div class="border border-gray-200 rounded-lg overflow-hidden">
  <%= render "shared/card_header", title: "Contract Terms" do %>
    <% if pdf_doc %>
      <%= link_to rails_blob_path(pdf_doc.file, disposition: "inline"), target: "_blank" do %>
        <%= render "shared/button", text: "View signed contract", variant: "secondary", size: "small", icon: "eye" %>
      <% end %>
    <% end %>
  <% end %>

  <div class="p-4">
    <%# The deal %>
    <div class="flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-3">
      <span class="sm:mt-0.5 self-start inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-semibold flex-shrink-0 <%= outgoing ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>">
        <%= icon(outgoing ? "arrow-up-right" : "arrow-down-left", class: "w-3 h-3") %>
        <%= outgoing ? "We pay them" : "They pay us" %>
      </span>
      <% if headline %>
        <p class="text-base font-medium text-gray-900 leading-snug"><%= headline[:value] %></p>
      <% end %>
    </div>

    <% if details.any? %>
      <dl class="mt-3 grid grid-cols-[max-content_1fr] gap-x-6 gap-y-1.5 text-sm">
        <% details.each do |line| %>
          <dt class="text-gray-500"><%= line[:label] %></dt>
          <dd class="text-gray-900"><%= line[:value] %></dd>
        <% end %>
      </dl>
    <% end %>

    <% if show_ticketing || show_services %>
      <div class="mt-4 pt-4 border-t border-gray-100 grid grid-cols-1 <%= 'md:grid-cols-2' if show_ticketing && show_services %> gap-6">
        <%# Ticketing — only meaningful when we're the ones selling %>
        <% if show_ticketing %>
          <div>
            <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Ticketing</h4>
            <% if tiers.any? %>
              <ul class="divide-y divide-gray-100">
                <% tiers.each do |tier| %>
                  <li class="flex items-center justify-between py-1.5 text-sm">
                    <span class="text-gray-900"><%= tier["name"] %></span>
                    <span class="font-medium text-gray-900 tabular-nums"><%= number_to_currency(tier["price"]) %></span>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-sm text-amber-600">We sell the tickets, but no ticket tiers are set yet.</p>
            <% end %>
            <% discounts.each do |discount| %>
              <p class="text-sm text-gray-600 mt-2">
                Discount <span class="font-medium text-gray-900"><%= discount["code"] %></span>:
                <%= discount["amount_type"] == "percent" ? "#{discount["amount"]}% off" : "#{number_to_currency(discount["amount"])} off" %>
                <%= discount["applies_to"] == "specific" ? "(#{(discount["tier_names"] || []).join(", ")})" : "(all tickets)" %>
              </p>
            <% end %>
          </div>
        <% end %>

        <%# Services on top of the deal — booth tech, box office, etc. %>
        <% if show_services %>
          <div>
            <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Services</h4>
            <ul class="divide-y divide-gray-100">
              <% services.each do |service| %>
                <%
                  qty = service["quantity"].to_f
                  qty_text = qty.to_i == qty ? qty.to_i.to_s : qty.to_s
                  hourly = service["unit"] == "hourly"
                  total = qty * service["unit_price"].to_f
                  incoming = (service["direction"].presence || "incoming") == "incoming"
                  events = service["per_event"] ? Array(service["events"]) : []
                  detail = if events.any?
                    hourly ? "#{pluralize(events.size, 'event')} · #{qty_text} hrs × #{number_to_currency(service['unit_price'])}/hr" : "#{pluralize(events.size, 'event')} × #{number_to_currency(service['unit_price'])}"
                  else
                    "#{qty_text}#{hourly ? ' hr' : ''} × #{number_to_currency(service['unit_price'])}"
                  end
                %>
                <li class="flex items-center justify-between gap-3 py-1.5 text-sm">
                  <span class="min-w-0">
                    <span class="text-gray-900"><%= service["name"] %></span>
                    <span class="text-xs text-gray-500"><%= detail %></span>
                    <% if service["settlement"] == "payout_deduction" %>
                      <span class="text-xs text-gray-400">· taken out of their payout</span>
                    <% end %>
                  </span>
                  <span class="flex-shrink-0 font-medium tabular-nums <%= incoming ? 'text-green-600' : 'text-red-600' %>">
                    <%= incoming ? "+" : "−" %><%= number_to_currency(total) %>
                  </span>
                </li>
              <% end %>
              <% if tech["provider"].present? %>
                <li class="py-1.5 text-sm">
                  <% if tech["provider"] == "us" %>
                    <span class="text-gray-900">We provide tech</span>
                    <span class="text-xs text-gray-500"><%= tech["hours"] %> hr × <%= number_to_currency(tech["hourly_rate"]) %> = <%= number_to_currency(tech["hours"].to_f * tech["hourly_rate"].to_f) %></span>
                    <span class="text-xs text-gray-400">· <%= tech["payment_method"] == "from_cut" ? "taken out of their cut" : "paid in cash" %></span>
                  <% else %>
                    <span class="text-gray-900">Contractor provides their own tech.</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
