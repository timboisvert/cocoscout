<% content_for :title, "Pay People" %>

<div class="w-full mb-10" data-controller="pay-run">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ ["Staffing", manage_staffing_index_path] ],
    text: "Pay People",
    links: []
  } %>

  <% payable = @staff_members.select { |m| m.person.respond_to?(:can_receive_payouts?) && m.person.can_receive_payouts? } %>

  <% unless Current.organization.funding_payment_method_id.present? %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 mt-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-amber-900">Connect a bank or card to fund pay runs first.</p>
      <%= render "shared/button", text: "Connect a funding source", variant: "primary", size: "small",
            path: manage_connect_payout_funding_path, method: :post %>
    </div>
  <% end %>

  <% if @staff_members.empty? %>
    <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-6 text-center mt-4">
      <p class="text-sm text-gray-600 mb-3">No staff to pay yet.</p>
      <%= render "shared/button", text: "Add a staff member", variant: "primary", size: "small", path: manage_new_staffing_staff_wizard_path %>
    </div>
  <% else %>
    <%= form_with url: manage_create_staffing_pay_path, method: :post, class: "mt-4" do %>
      <div class="flex flex-col sm:flex-row sm:items-end gap-4 mb-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Payday</label>
          <%= date_field_tag :payday, @payday, class: "px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Funding</label>
          <select name="funding_method" class="px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
            <option value="ach">Bank transfer (ACH — a few days, no fee)</option>
            <option value="card">Card (instant rush)</option>
          </select>
        </div>
      </div>

      <div class="overflow-x-auto border border-gray-200 rounded-lg bg-white">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
            <tr>
              <th class="text-left font-medium px-3 py-2">Staff</th>
              <th class="text-right font-medium px-3 py-2">Rate</th>
              <th class="text-right font-medium px-3 py-2">Hours</th>
              <th class="text-right font-medium px-3 py-2">Bonus</th>
              <th class="text-right font-medium px-3 py-2">Reimb.</th>
              <th class="text-right font-medium px-3 py-2">Tips</th>
              <th class="text-right font-medium px-3 py-2">Cash tips</th>
              <th class="text-right font-medium px-3 py-2">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @staff_members.each do |member| %>
              <% payee = member.person %>
              <% can_pay = payee.respond_to?(:can_receive_payouts?) && payee.can_receive_payouts? %>
              <tr data-pay-run-target="row" data-rate="<%= member.hourly_rate_cents.to_i %>" data-payable="<%= can_pay %>" class="<%= "opacity-60" unless can_pay %>">
                <td class="px-3 py-2">
                  <div class="font-medium text-gray-900"><%= member.display_name %></div>
                  <% unless can_pay %><span class="text-[11px] text-amber-600">Needs to connect a bank — will be skipped</span><% end %>
                </td>
                <td class="px-3 py-2 text-right text-gray-600"><%= member.hourly_rate_cents ? number_to_currency(member.hourly_rate_cents / 100.0) : "—" %></td>
                <td class="px-3 py-2 text-right"><input type="number" step="0.25" min="0" name="lines[<%= member.id %>][hours]" data-pay-field="hours" data-action="input->pay-run#recalc" class="w-20 px-2 py-1.5 border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300"></td>
                <td class="px-3 py-2 text-right"><input type="text" inputmode="decimal" name="lines[<%= member.id %>][bonus]" data-pay-field="bonus" data-action="input->pay-run#recalc" placeholder="0" class="w-20 px-2 py-1.5 border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300"></td>
                <td class="px-3 py-2 text-right"><input type="text" inputmode="decimal" name="lines[<%= member.id %>][reimbursement]" data-pay-field="reimbursement" data-action="input->pay-run#recalc" placeholder="0" class="w-20 px-2 py-1.5 border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300"></td>
                <td class="px-3 py-2 text-right"><input type="text" inputmode="decimal" name="lines[<%= member.id %>][tips]" data-pay-field="tips" data-action="input->pay-run#recalc" placeholder="0" class="w-20 px-2 py-1.5 border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300"></td>
                <td class="px-3 py-2 text-right"><input type="text" inputmode="decimal" name="lines[<%= member.id %>][cash_tips]" placeholder="0" class="w-20 px-2 py-1.5 border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300"></td>
                <td class="px-3 py-2 text-right font-medium text-gray-900" data-pay-total>$0.00</td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-gray-50 border-t border-gray-200">
            <tr>
              <td colspan="7" class="px-3 py-3 text-right text-sm text-gray-600">Total to pay (<span data-pay-run-target="count">0</span> people, cash tips excluded)</td>
              <td class="px-3 py-3 text-right text-base font-semibold text-gray-900" data-pay-run-target="grandTotal">$0.00</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <p class="text-xs text-gray-500 mt-2">Only staff with a connected bank are paid. Each staff member gets 2 free payments a month; additional payments are $1 each. Cash tips are recorded for your records but not sent through us.</p>

      <div class="flex items-center justify-end gap-3 mt-4">
        <%= link_to "Cancel", manage_staffing_index_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
        <%= render "shared/button", text: "Pay People", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
  <% end %>
</div>
