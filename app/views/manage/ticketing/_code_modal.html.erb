<%# Add a discount code, or edit one, in a modal (Tim, 2026-10-17 and
    2026-11-24): the tab shows the list; this is where a code is typed.
    Edit is the same form filled in. Locals: id, url (where it posts),
    what ("every date of Stargazers" / "this date only"), input_class,
    code (the code being edited; nil adds one). %>
<% code = local_assigns[:code] %>
<% uses = code ? code.uses_count : 0 %>
<div id="<%= id %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl mx-4 max-h-[90vh] overflow-y-auto" data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white"><%= code ? "Edit #{code.code}" : "Add a discount code" %></h3>
      <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <%= form_with scope: :ticket_discount_code, url: url, method: (code ? :patch : :post), data: { turbo: false } do |cf| %>
      <div class="p-6 space-y-5">
        <p class="text-sm text-gray-600">
          Buyers enter it at checkout. Good for <%= what %>.
          <% if uses.positive? %>It has been used <%= pluralize(uses, "time") %>, and those orders keep what they paid.<% end %>
        </p>
        <%= render "manage/ticketing/code_fields", cf: cf, input_class: input_class, code: code, uid: (code ? code.id : "new") %>
      </div>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
        <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
        <%= render "shared/button", text: (code ? "Save code" : "Add code"), variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
  </div>
</div>
