<%# Bring a statement in: the modal the top-right button opens. The file
    from the bank, what happens to it, and the statements already in (each
    can be removed). The Remove confirmations are rendered by the page,
    outside this modal, so one modal never sits inside another.
      title: the modal's heading
      imports: the statements already brought in %>
<%
  title = local_assigns[:title] || "Bring a statement in"
  imports = local_assigns.fetch(:imports, [])
%>
<div id="bank-import-modal"
     class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center sm:p-4"
     data-controller="modal"
     data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full sm:max-w-lg sm:mx-4 max-h-[92vh] overflow-y-auto"
       data-action="click->modal#stopPropagation">
    <div class="sticky top-0 z-10 flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white"><%= title %></h3>
      <button type="button" data-action="click->modal#close" aria-label="Close"
              class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <%= form_with url: manage_money_bank_import_path, method: :post, multipart: true, data: { turbo: false } do %>
      <div class="px-6 py-5 space-y-4">
        <p class="text-sm text-gray-600">Download a month from your bank's website as CSV or OFX (QFX works too). Most banks offer both under Download or Export. Its lines are matched to the books in the background; you'll get a notification when that's done.</p>
        <label class="block text-sm font-medium text-gray-700"><span>The file from your bank</span>
          <span class="mt-1 flex items-center gap-3 rounded-lg border border-dashed border-gray-300 bg-gray-50 px-3 py-3">
            <input type="file" name="file" accept=".csv,.ofx,.qfx,text/csv,application/x-ofx" required class="block w-full text-sm text-gray-700">
          </span>
        </label>
        <%= render "shared/file_promises", compact: true %>
      </div>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-2">
        <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
        <%= render "shared/button", text: "Read the file", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
    <% if imports.any? %>
      <div class="px-6 py-4 border-t border-gray-200">
        <h4 class="text-[11px] font-medium uppercase tracking-wide text-gray-500 mb-2">Statements brought in</h4>
        <ul class="divide-y divide-gray-100">
          <% imports.each do |imp| %>
            <li class="py-2 flex items-center gap-3 text-sm">
              <span class="flex-1 min-w-0">
                <span class="font-medium text-gray-900"><%= imp.title %></span>
                <% if imp.matching? %><span class="ml-1 inline-flex rounded-md bg-blue-50 px-1.5 py-0.5 text-xs font-medium text-blue-700">Matching</span><% elsif imp.failed? %><span class="ml-1 inline-flex rounded-md bg-red-50 px-1.5 py-0.5 text-xs font-medium text-red-700">Didn't finish</span><% end %>
                <span class="block text-xs text-gray-500 truncate"><%= imp.created_at.strftime("%b %-d, %Y") %> · <%= pluralize(imp.lines_count, "line") %><%= imp.new_lines_count < imp.lines_count ? ", #{imp.lines_count - imp.new_lines_count} already in" : "" %> · <%= imp.format.upcase %><% if imp.filename.present? %> · <%= imp.filename %><% end %></span>
              </span>
              <%= render "shared/button", text: "Remove", variant: "secondary", size: "small", type: :button,
                    data: { controller: "modal", action: "click->modal#open", modal_id: "remove-statement-#{imp.id}" } %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>
