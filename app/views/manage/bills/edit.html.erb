<% content_for :title, "Change a bill" %>
<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: { breadcrumbs: [ [ "Money", manage_money_index_path ], [ "Bills", manage_money_bills_path ], [ @bill.vendor_name, manage_money_bill_path(@bill) ] ], text: "Change", links: [] } %>
  <div class="max-w-2xl -mx-4 sm:mx-auto bg-white sm:rounded-xl sm:border sm:border-gray-200 sm:shadow-sm overflow-hidden">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h2 class="text-lg font-semibold text-white"><%= @bill.vendor_name %></h2>
      <%= link_to manage_money_bill_path(@bill), class: "rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors", aria: { label: "Close" } do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      <% end %>
    </div>
    <%= render "form", bill: @bill, productions: @productions, shows: @shows %>
  </div>
</div>
