<% content_for :title, "Contracts" %>

<%
  contracts_description = <<~HTML
    <p>
      Manage contracts for third-party productions, venue rentals, and external bookings.
      Track payments, services, and space reservations all in one place.
    </p>
  HTML

  contracts_actions = [
    { icon: "plus", text: "New Contract", description: "Create a new contract", path: manage_new_contract_wizard_path },
    { icon: "users", text: "Contractors", description: "Manage contractor relationships", path: manage_contractors_path },
    { icon: "archive", text: "Past Contracts", description: "View completed contracts", path: completed_manage_contracts_path },
    { icon: "cog", text: "Settings", description: "Services catalog & defaults", path: manage_contract_settings_path }
  ]
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render "shared/module_header",
    title: "Contracts",
    description: contracts_description,
    actions: contracts_actions
  %>

  <div class="border-t border-gray-200 pt-4 mt-2">
  <%# Contract Stats %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-lg border border-gray-200 p-5">
      <div class="text-sm text-gray-500 mb-1">Received This Year</div>
      <div class="text-2xl font-semibold text-green-600"><%= number_to_currency(@money_received) %></div>
      <div class="text-xs text-gray-500">paid incoming payments</div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-5">
      <div class="text-sm text-gray-500 mb-1">Remaining to Receive</div>
      <div class="text-2xl font-semibold text-pink-600"><%= number_to_currency(@money_remaining) %></div>
      <div class="text-xs text-gray-500">pending incoming payments</div>
    </div>

    <%# Overdue wears red while there's anything late, plain white when there isn't. %>
    <% overdue_any = @overdue_count.to_i.positive? %>
    <div class="rounded-lg border p-5 <%= overdue_any ? 'bg-red-50 border-red-200' : 'bg-white border-gray-200' %>">
      <div class="text-sm text-gray-500 mb-1">Overdue</div>
      <div class="text-2xl font-semibold <%= overdue_any ? 'text-red-600' : 'text-gray-400' %> tabular-nums"><%= number_to_currency(@overdue_incoming) %></div>
      <% if overdue_any %>
        <div class="text-xs text-gray-500">
          <%= pluralize(@overdue_count, "payment") %> past due<% if @overdue_outgoing.to_f.positive? %> · <%= number_to_currency(@overdue_outgoing, precision: 0) %> you owe<% end %>
        </div>
      <% else %>
        <div class="text-xs text-gray-500">nothing past due</div>
      <% end %>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-5">
      <div class="text-sm text-gray-500 mb-1"><%= Date.current.year %> Contracts</div>
      <div class="text-2xl font-semibold <%= (@contracts_made - @contracts_cost) >= 0 ? 'text-gray-900' : 'text-red-600' %> tabular-nums"><%= number_to_currency(@contracts_made - @contracts_cost) %></div>
      <div class="text-xs text-gray-500">made <%= number_to_currency(@contracts_made, precision: 0) %> · cost <%= number_to_currency(@contracts_cost, precision: 0) %></div>
      <div class="text-xs text-gray-500">contracts starting this year</div>
    </div>
  </div>

  <%# What's in motion — a payment overdue, waiting on a signature, drafts,
      signed lately. The whole book is one click away on All Contracts; the hub
      isn't a list. %>
  <div class="mb-8">
    <div class="flex items-baseline justify-between gap-3 mb-3">
      <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">
        In motion
        <% if @in_motion_contracts.any? %>
          <span class="ml-1 text-gray-400 font-normal normal-case tracking-normal">(<%= @in_motion_contracts.size %>)</span>
        <% end %>
      </h3>
      <span class="text-sm text-gray-500 normal-case tracking-normal">Overdue payments, out for signature, drafts, and anything signed in the last <%= Manage::ContractsController::RECENTLY_SIGNED_WINDOW.inspect %></span>
    </div>
    <% if @in_motion_contracts.any? %>
      <%= render "contract_slim_list", contracts: @in_motion_contracts, badges: @in_motion_badges, amounts: @in_motion_amounts %>
    <% elsif @contracts.any? %>
      <div class="bg-white rounded-lg border border-gray-200 p-5 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-green-50 text-green-600 flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
          </span>
          <p class="text-sm text-gray-600">Nothing in motion — no overdue payments, no drafts, nothing out for signature.</p>
        </div>
        <%= link_to "All contracts", all_manage_contracts_path, class: "text-sm text-pink-600 hover:text-pink-700 flex-shrink-0" %>
      </div>
    <% end %>
  </div>

  <%# Unified calendar: payments + shows + rentals, month by month %>
  <% calendar_legend = capture do %>
    <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-green-300"></span> Payment in / night made</span>
    <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-red-300"></span> Payment out / night lost</span>
    <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-blue-300"></span> Space rental</span>
    <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-red-500"></span> Late</span>
  <% end %>
  <%= render "shared/month_calendar",
    current_month: @current_month,
    prev_month: @prev_month,
    next_month: @next_month,
    items_by_date: @calendar_items_by_date,
    item_partial: "manage/contracts/calendar_item",
    month_link: ->(m) { manage_contracts_path(month: m.strftime("%Y-%m-01")) },
    today_link: manage_contracts_path,
    legend: calendar_legend %>

  <%# Browsing, not doing: the whole book lives on All Contracts, sortable by
      upcoming date or by name (the Money hub does the same). %>
  <% if @contracts.any? %>
    <%= link_to all_manage_contracts_path, class: "block bg-white rounded-lg border border-gray-200 p-5 hover:bg-gray-50 transition-colors mt-8" do %>
      <div class="flex items-center justify-between gap-3">
        <div>
          <h3 class="font-semibold text-gray-900">All contracts</h3>
          <p class="text-sm text-gray-500 mt-0.5">Every current contract and draft — by upcoming date or by name.</p>
        </div>
        <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </div>
    <% end %>
  <% end %>

  <%# Empty state %>
  <% if @contracts.empty? %>
    <div class="bg-gray-50 rounded-lg border border-dashed border-gray-300 p-12 text-center">
      <%= icon("file-text", class: "w-12 h-12 text-gray-400 mx-auto mb-4") %>
      <h3 class="text-lg font-medium text-gray-900 mb-2">No contracts yet</h3>
      <p class="text-gray-600 mb-4">
        Create a contract when an external group wants to rent your space or perform at your venue.
      </p>
      <%= render "shared/button", text: "New Contract", variant: "primary", icon: "plus", path: manage_new_contract_wizard_path %>
    </div>
  <% end %>
  </div>
</div>
