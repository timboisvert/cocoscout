<%# Which of the organization's products this production upsells at checkout,
    and whether it prices them itself. Off, every offered product sells at
    its standard price and follows its own revenue rule; on, each offered
    product's price and rule come alive to set for this production. Locals:
    setup, production. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  checkbox_class = "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500"
  products = production.organization.ticket_products.active.ordered.to_a
  links = setup.persisted? ? setup.production_ticketing_products.index_by(&:ticket_product_id) : {}
  own = setup.own_product_prices
%>
<%= form_with model: setup, scope: :production_ticketing, url: manage_update_production_ticketing_path(production, section: "products"), method: :patch do |f| %>
  <% if products.empty? %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="products">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Products at checkout</h2>
        <p class="text-sm text-gray-600 mt-1">Things buyers of <%= production.name %> can add to their order.</p>
      </div>
      <div class="px-6 py-6 text-center">
        <p class="text-sm text-gray-600">You haven't added any products yet.</p>
        <div class="mt-3 flex justify-center">
          <%= render "shared/button", text: "Add a product", variant: "secondary", size: "small", path: manage_new_ticket_product_path %>
        </div>
      </div>
    </div>
  <% else %>
    <%# The products offered, with the one override control over their prices
        (manage/ticketing/own_switch): off, each sells at its standard price
        and follows its own revenue rule; on, both are set here. %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle" data-settings-card="products">
      <%= render "manage/ticketing/own_switch", title: "Products at checkout", what: "standard price", follows: "each product", settings_path: manage_ticket_products_path,
            intro: "After picking their tickets, buyers of any date of #{production.name} can add the ones you tick. What they buy shows on their order, on the guest list and at the door.",
            only: production.name, name: "production_ticketing[own_product_prices]", id: "production_ticketing_own_product_prices", checked: own %>
      <ul class="divide-y divide-gray-100">
        <% products.each do |product| %>
          <% link = links[product.id] %>
          <li class="px-6 py-3 space-y-2">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
              <label class="flex items-center gap-3 min-w-[12rem] flex-1 cursor-pointer">
                <%= check_box_tag "products[#{product.id}][offered]", "1", link.present?, id: "product_offered_#{product.id}", class: checkbox_class %>
                <span>
                  <span class="block text-sm font-medium text-gray-900"><%= product.name %></span>
                  <span class="block text-xs text-gray-500">
                    <%= number_to_currency(product.price_cents / 100.0) %> standard
                    · <%= product.counts_toward_ticket_revenue ? "counts as ticket revenue" : "not ticket revenue" %>
                    <%= "· #{product.description}" if product.description.present? %>
                  </span>
                </span>
              </label>
              <fieldset <%= "disabled" unless own %> data-fieldset-toggle-target="fields"
                        class="flex flex-wrap items-center gap-3 disabled:opacity-40 disabled:pointer-events-none transition-opacity">
                <div class="relative w-28">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">$</span>
                  <%= text_field_tag "products[#{product.id}][price]", (link&.price_cents ? format("%.2f", link.price_cents / 100.0) : nil),
                        id: "product_price_#{product.id}", inputmode: "decimal", placeholder: format("%.2f", product.price_cents / 100.0),
                        "aria-label": "#{product.name} price here", class: "#{input_class} pl-7" %>
                </div>
                <div class="flex items-center gap-2 text-xs text-gray-700">
                  <%= render "shared/toggle_switch", name: "products[#{product.id}][counts_toward_ticket_revenue]", id: "product_counts_#{product.id}",
                        checked: (link && !link.counts_toward_ticket_revenue.nil? ? link.counts_toward_ticket_revenue : product.counts_toward_ticket_revenue),
                        aria_label: "#{product.name} counts as ticket revenue here" %>
                  <label for="product_counts_<%= product.id %>" class="cursor-pointer">Counts as ticket revenue here</label>
                </div>
              </fieldset>
            </div>
          </li>
        <% end %>
      </ul>
      <div class="px-6 py-4 border-t border-gray-200 flex items-center justify-between gap-4">
        <div>
          <div class="text-sm font-medium text-gray-900">Sell them at the door too</div>
          <div class="text-xs text-gray-600 mt-0.5">
            Products are sold online only, ahead of the show, unless you turn this on. Then the door can add them to a cash or card sale as well.
          </div>
        </div>
        <%= render "shared/toggle_switch", form: f, field: :products_at_door, checked: setup.products_at_door %>
      </div>
      <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex flex-wrap items-center justify-between gap-3">
        <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
        <span class="text-xs text-gray-500">A price left empty uses the product's standard price. <%= link_to "Manage your products", manage_ticket_products_path, class: "font-medium text-pink-600 hover:text-pink-700" %></span>
      </div>
    </div>
  <% end %>
<% end %>
