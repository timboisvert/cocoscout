<%#
  Slim, spreadsheet-style contracts list — mirrors the production list on
  manage/money. Left column is the contractor (production shown underneath their
  name); the three right columns carry Dates, Type, and Value + status.

  Locals:
    contracts: array of Contract objects
%>
<%= render layout: "shared/slim_list", locals: { label: "Contractor", columns: [ "Dates", "Type", "Value" ], col_classes: [ "w-56", "w-36", "w-28" ], col_aligns: [ "text-left", "text-left", "text-right" ], min_width: "min-w-[780px]" } do %>
  <% contracts.each do |contract| %>
    <%
      is_draft = contract.status_draft?
      contract_path = is_draft ? manage_resume_contract_wizard_path(contract) : manage_contract_path(contract)

      # Payment status
      pending_payments = contract.contract_payments.select(&:status_pending?)
      late_payments = pending_payments.select(&:overdue?)
      is_paid = pending_payments.empty? && contract.contract_payments.any?
      is_behind = late_payments.any?
      total_value = contract.contract_payments.sum(&:amount)

      # Revenue share
      payment_structure = contract.draft_payment_structure
      is_revenue_share = payment_structure == "revenue_share"
      payment_config = contract.draft_payment_config
      our_share = payment_config["revenue_our_share"].to_i if is_revenue_share
      their_share = payment_config["revenue_their_share"].to_i if is_revenue_share

      # Space bookings
      bookings_count = contract.space_rentals.size.positive? ? contract.space_rentals.size : contract.draft_bookings.count
      has_space_rental = bookings_count > 0

      # ---- Column 1: Dates ----
      dates_label = contract.date_range.presence || "—"

      # Production now sits under the contractor name (subtitle), not in a column.
      production_label = contract.production_name.presence || contract.production&.name

      # ---- Column 2: Type ----
      type_label = if has_space_rental
        "Rental · #{pluralize(bookings_count, 'booking')}"
      elsif is_revenue_share
        "#{our_share}/#{their_share} share"
      else
        "—"
      end

      # ---- Column 3: Value (price is the headline; status is small subtext) ----
      value_sub = nil
      value_sub_class = "text-gray-400"
      # Ticket-based deals with real activity show actuals: net headline, made/cost
      # beneath — a rev-share where we sell is revenue + a payout, not one number.
      actuals = !is_draft && (is_revenue_share || contract.ticket_revenue_minus_fee?) ? contract.money_display : nil
      if actuals && (actuals[:made] > 0 || actuals[:cost] > 0)
        value_label = number_to_currency(actuals[:net])
        value_class = actuals[:net] >= 0 ? "text-green-600" : "text-red-600"
        value_sub = "in #{number_to_currency(actuals[:made], precision: 0)} · out #{number_to_currency(actuals[:cost], precision: 0)}"
      elsif is_revenue_share
        value_label = "#{our_share}% of sales"
        value_class = "text-gray-900"
      elsif total_value > 0
        value_label = number_to_currency(total_value)
        value_class = "text-gray-900"
        if is_paid
          value_sub = "paid"; value_sub_class = "text-green-600"
        elsif is_behind
          value_sub = pluralize(late_payments.size, "late"); value_sub_class = "text-red-500"
        elsif pending_payments.any?
          value_sub = "#{pending_payments.size} pending"; value_sub_class = "text-gray-400"
        end
      elsif is_draft
        value_label = "Not configured"
        value_class = "text-gray-400"
      else
        value_label = number_to_currency(0)
        value_class = "text-gray-400"
      end

      badge =
        if !is_draft
          nil
        elsif contract.signing_mode_esign?
          # E-sign drafts read by their signing stage, not a step number.
          case contract.signing_state
          when "awaiting_send" then { text: "Ready to send", color: "blue" }
          when "out_for_signature" then { text: "Out for signature", color: "amber" }
          else { text: "Draft", color: "gray" }
          end
        else
          { text: (contract.wizard_step > 1 ? "Draft · Step #{contract.wizard_step}/8" : "Draft"), color: "gray" }
        end
      subtitle = production_label.presence || contract.contractor_email.presence
    %>
    <%= render "shared/slim_list_row",
          title: contract.contractor_name,
          subtitle: subtitle,
          badge: badge,
          col_classes: [ "w-56", "w-36", "w-28" ],
          col_aligns: [ "text-left", "text-left", "text-right" ],
          col_labels: [ "Dates", "Type", "Value" ],
          href: contract_path,
          cells: [
            { value: dates_label, class: "text-gray-600 truncate" },
            { value: type_label, class: "text-gray-600 truncate" },
            { value: value_label, class: value_class, subvalue: value_sub, subvalue_class: value_sub_class }
          ] %>
  <% end %>
<% end %>
