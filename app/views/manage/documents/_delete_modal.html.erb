<%#
  Delete-confirmation modal for one document — replaces the browser confirm.
  Locals: document, production (the managed production whose route the DELETE
  runs through).
  Trigger with: data-controller="modal" data-action="click->modal#open"
                data-modal-id="delete-modal-<document.id>"
%>
<div id="delete-modal-<%= document.id %>"
     class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4"
     data-controller="modal"
     data-action="click->modal#closeOnBackdrop keydown.escape->modal#close">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-md max-h-[88vh] overflow-y-auto"
       data-action="click->modal#stopPropagation">
    <%# Header — pink gradient (CocoScout standard for confirmation modals) %>
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white">Delete &ldquo;<%= document.title %>&rdquo;?</h3>
      <button type="button" data-action="click->modal#close"
              class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="px-6 py-5 text-sm text-gray-600">
      <p>This can't be undone. Anyone this document is shared with will lose access to it.</p>
    </div>

    <div class="flex items-center justify-end gap-2 px-6 py-4 bg-gray-50 border-t border-gray-200">
      <button type="button" data-action="click->modal#close" class="bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 inline-flex items-center justify-center gap-2 font-medium rounded transition-colors cursor-pointer px-3 py-1.5 text-sm sm:px-5 sm:py-2.5 sm:h-10">Cancel</button>
      <%= button_to manage_production_document_path(production, document), method: :delete,
            class: "inline-flex items-center justify-center gap-2 font-medium rounded transition-colors cursor-pointer bg-pink-500 hover:bg-pink-600 text-white px-3 py-1.5 text-sm sm:px-5 sm:py-2.5 sm:h-10" do %>
        Delete document
      <% end %>
    </div>
  </div>
</div>
