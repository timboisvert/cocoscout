<% content_for :title, "Issue Advance - #{@production.name}" %>

<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  label_class = "block text-sm font-medium text-gray-900 mb-1.5"
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Money", manage_money_index_path],
      ["Advances", manage_money_advances_path],
      [@production.name, manage_money_production_advances_path(@production)]
    ],
    text: "Issue Advance",
    links: []
  } %>

  <div class="max-w-2xl">
    <%= form_with model: @advance, url: manage_create_money_production_advance_path(@production), class: "space-y-6" do |form| %>
      <% if @advance.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <div class="flex items-start gap-3">
            <%= icon("exclamation-circle", class: "w-5 h-5 text-red-500 flex-shrink-0") %>
            <div>
              <h3 class="text-sm font-medium text-red-800"><%= pluralize(@advance.errors.count, "error") %> prevented this advance from being issued:</h3>
              <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                <% @advance.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <div class="bg-white border border-gray-200 rounded-lg p-6 space-y-5">
        <%# Person %>
        <div>
          <%= form.label :person_id, "Person", class: label_class %>
          <% if @people.any? %>
            <%= form.select :person_id,
                options_for_select(@people.map { |p| [p.name, p.id] }, @advance.person_id),
                { include_blank: "Select a person…" },
                class: input_class %>
          <% else %>
            <p class="text-sm text-gray-500">No people in the talent pool. Add people to the production's talent pool first.</p>
          <% end %>
        </div>

        <%# Advance Type %>
        <div>
          <span class="<%= label_class %>">Advance type</span>
          <div class="space-y-2">
            <label class="flex items-start gap-3 p-3 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 transition-colors">
              <%= form.radio_button :advance_type, "show", class: "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500", data: { action: "change->advance-form#toggleShowSelect" } %>
              <div>
                <div class="font-medium text-gray-900">For a specific show</div>
                <div class="text-sm text-gray-500">Repaid from this show's payout first</div>
              </div>
            </label>
            <label class="flex items-start gap-3 p-3 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 transition-colors">
              <%= form.radio_button :advance_type, "general", class: "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500", data: { action: "change->advance-form#toggleShowSelect" } %>
              <div>
                <div class="font-medium text-gray-900">General advance</div>
                <div class="text-sm text-gray-500">Repaid from any future payout</div>
              </div>
            </label>
          </div>
        </div>

        <%# Show (for show-specific advances) %>
        <div id="show-select-container" class="<%= @advance.advance_type == 'general' ? 'hidden' : '' %>">
          <%= form.label :show_id, "Show", class: label_class %>
          <% if @upcoming_shows.any? %>
            <%= form.select :show_id,
                options_for_select(@upcoming_shows.map { |s| ["#{s.date_and_time.strftime('%b %-d, %Y')} — #{s.display_name}", s.id] }, @advance.show_id),
                { include_blank: "Select a show…" },
                class: input_class %>
          <% else %>
            <p class="text-sm text-gray-500">No upcoming shows scheduled.</p>
          <% end %>
        </div>

        <%# Amount %>
        <div>
          <%= form.label :original_amount, "Amount", class: label_class %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <span class="text-gray-500">$</span>
            </div>
            <%= form.number_field :original_amount,
                step: 0.01, min: 0.01, placeholder: "0.00",
                class: "block w-full pl-7 pr-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
          </div>
        </div>

        <%# Notes %>
        <div>
          <%= form.label :notes, "Notes", class: label_class %>
          <%= form.text_area :notes, rows: 3, placeholder: "Any notes about this advance…", class: input_class %>
        </div>
      </div>

      <%# Submit %>
      <div class="flex justify-end gap-3">
        <%= link_to "Cancel", manage_money_production_advances_path(@production), class: "px-4 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition" %>
        <%= render "shared/button", type: "submit", text: "Issue Advance", variant: "primary", size: "medium" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  // Toggle the show selector based on the advance type
  document.querySelectorAll('input[name="person_advance[advance_type]"]').forEach(radio => {
    radio.addEventListener('change', (e) => {
      document.getElementById('show-select-container').classList.toggle('hidden', e.target.value !== 'show');
    });
  });
</script>
