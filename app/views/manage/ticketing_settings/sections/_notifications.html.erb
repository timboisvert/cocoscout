<%#
  Ticketing emails by plan (Tim, 2026-10-20, Concept A): one row per manager
  or address with its plan, and Edit opens that person's modal
  (_notification_plan_modal) to change it. Add an email address opens the
  same modal for a new address.
%>
<%
  n = @notifications
  people = n.recipients
  plan_labels = TicketingNotifications::PLANS.to_h { |p| [ p.key, p.label ] }.merge("custom" => "Their own pick")
%>
<div class="space-y-6">
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Ticketing emails</h2>
      <p class="text-sm text-gray-600 mt-1">Who gets which emails as tickets sell and money moves. Each person has a plan, and a plan takes in new kinds of email on its own.</p>
    </div>
    <ul class="divide-y divide-gray-100" data-notification-recipients>
      <% people.each_with_index do |r, i| %>
        <% headshot_variant = r.user&.person&.safe_headshot_variant(:thumb) %>
        <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 sm:px-6 py-3.5" data-recipient="<%= r.key %>">
          <% if headshot_variant %>
            <%= image_tag headshot_variant, alt: r.name, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
          <% elsif r.address? %>
            <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6"/></svg>
            </div>
          <% else %>
            <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-sm flex-shrink-0"><%= r.user.person&.initials || r.name.first.upcase %></div>
          <% end %>
          <div class="min-w-0 flex-1 basis-48">
            <div class="text-sm font-medium text-gray-900 truncate"><%= r.name %></div>
            <div class="text-sm text-gray-600 truncate"><%= r.address? ? "Not a manager here" : r.email %></div>
          </div>
          <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs whitespace-nowrap <%= case r.plan when "everything" then "bg-pink-100 text-pink-800" when "nothing" then "bg-white border border-gray-200 text-gray-500" else "bg-gray-100 text-gray-700" end %>">
            <span class="font-semibold"><%= plan_labels.fetch(r.plan) %></span><% if r.kinds.any? %> · <%= pluralize(r.kinds.size, "email") %><% end %>
          </span>
          <%= render "shared/button", text: "Edit", variant: "secondary", size: "small", type: :button,
                data: { controller: "modal", action: "click->modal#open", modal_id: "notification-plan-#{i}" } %>
        </li>
      <% end %>
    </ul>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 sm:px-6 py-3.5 border-t border-gray-200 bg-gray-50">
      <%= render "shared/button", text: "Add an email address", variant: "secondary", size: "small", type: :button,
            data: { controller: "modal", action: "click->modal#open", modal_id: "notification-plan-new" } %>
      <span class="text-sm text-gray-600">For an inbox, or someone who isn't a manager here. Your managers are listed on their own.</span>
    </div>
  </div>
</div>

<% people.each_with_index do |r, i| %>
  <%= render "manage/ticketing_settings/notification_plan_modal", id: "notification-plan-#{i}", recipient: r %>
<% end %>
<%= render "manage/ticketing_settings/notification_plan_modal", id: "notification-plan-new", recipient: nil %>
