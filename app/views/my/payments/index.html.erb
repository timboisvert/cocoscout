<% content_for :title, "My Payments" %>

<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render "shared/module_header", title: "My Payments" %>

  <%= render "my/payments/bank_connect_banner" %>

  <%# Two details the payout provider will want once their pay reaches
      $3,000, asked for before it pauses anything (after-V1 #2). %>
  <% if @summary.details_heads_up? %>
    <%= render "shared/alert_panel",
          eyebrow: "Getting paid",
          headline: "Add two details before your pay reaches #{number_to_currency(MyPaymentsSummary::DETAILS_DUE_AT_CENTS / 100, precision: 0)}",
          body: "Our payment provider needs your date of birth and the last four digits of your Social Security number by then, and would hold your pay until they're in. Yours is #{number_to_currency(@summary.sent_total_cents / 100.0)} so far.",
          actions: [ { text: "Add the details", path: my_payments_connect_bank_path, method: :post, form: { data: { turbo: false } } } ] %>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Main column, in the payee's words (Tim, 2026-10-15): what's on its way
        to their bank, what's still to be paid, and past payments. Nothing says
        paid until the payout provider says deposited. %>
    <div class="lg:col-span-2 space-y-6">
      <%
        summary = @summary
        on_way_groups = summary.on_its_way_groups
        on_way_payments = summary.on_its_way_payments
        on_way_cents = summary.on_its_way_cents
        still_groups = summary.still_to_come_groups
        still_cents = summary.still_to_come_cents
        waiting_cents = still_groups.flat_map(&:lines).select { |l| l.tag.present? }.sum(&:cents)
        past = summary.past_payments
        next_expected = on_way_payments.filter_map(&:expected_on).min
        group_titles = { on_its_way: "On its way", queued: "Approved", owed: "Approved", waiting: "Waiting for approval" }
      %>
      <%# Two numbers: on its way, and still to be paid. A tile wears its
          color only while it holds money. %>
      <div>
        <div class="grid grid-cols-2 gap-3">
          <div class="rounded-lg border p-4 <%= on_way_cents.positive? ? 'border-blue-200 bg-blue-50' : 'border-gray-200 bg-white' %>">
            <div class="text-xs font-semibold uppercase tracking-wide <%= on_way_cents.positive? ? 'text-blue-800' : 'text-gray-500' %>">On its way</div>
            <div class="text-2xl font-bold tabular-nums mt-1 <%= on_way_cents.positive? ? 'text-gray-900' : 'text-gray-400' %>"><%= number_to_currency(on_way_cents / 100.0) %></div>
            <div class="text-xs mt-0.5 <%= on_way_cents.positive? ? 'text-blue-900' : 'text-gray-500' %>">
              <% if next_expected %>expected about <%= next_expected.strftime("%b %-d") %><% elsif on_way_cents.positive? %>going out now<% else %>nothing on its way<% end %>
            </div>
          </div>
          <div class="rounded-lg border border-gray-200 bg-white p-4">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Still to be paid</div>
            <div class="text-2xl font-bold tabular-nums mt-1 <%= still_cents.positive? ? 'text-gray-900' : 'text-gray-400' %>"><%= number_to_currency(still_cents / 100.0) %></div>
            <div class="text-xs text-gray-500 mt-0.5">
              <% if waiting_cents.positive? %>incl. <%= number_to_currency(waiting_cents / 100.0) %> waiting for approval<% elsif still_cents.positive? %>approved<% else %>nothing waiting<% end %>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-between gap-4 text-sm mt-3 px-1">
          <span class="text-gray-600">Sent to you in <%= Date.current.year %></span>
          <span class="font-semibold text-gray-900 tabular-nums"><%= number_to_currency(summary.paid_this_year_cents / 100.0) %></span>
        </div>
      </div>

      <%# On its way: a run going out now, and pay we sent that the provider
          hasn't said was deposited yet. %>
      <% if on_way_groups.any? || on_way_payments.any? %>
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">On its way</h2>
          <div class="space-y-3">
            <% on_way_groups.each do |group| %>
              <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                <%= render "my/payments/group_header", tone: :on_its_way, title: group.org || "On its way", sub: group.when_text, cents: group.total_cents %>
                <%= render "my/payments/lines", lines: group.lines %>
              </div>
            <% end %>
            <% on_way_payments.each do |payment| %>
              <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                <%= render "my/payments/group_header", tone: :on_its_way, title: payment.org || "On its way",
                      sub: "Sent #{payment.paid_at.strftime('%a, %b %-d')} · expected about #{payment.expected_on&.strftime('%a, %b %-d')}", cents: payment.cents %>
                <%= render "my/payments/lines", lines: payment.lines %>
                <div class="px-5 pb-3 text-right">
                  <%= link_to "Receipt", my_payment_receipt_path(kind: payment.kind, id: payment.id), class: "text-xs font-medium text-pink-600 hover:text-pink-700" %>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <%# Still to be paid: approved (in the next run, or in none yet) and hours
          waiting for approval. Every group is its line items. %>
      <section>
        <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">Still to be paid</h2>
        <% if !@person.can_receive_payouts? && still_cents.positive? %>
          <%# The money is real and waiting: say exactly what unlocks it. %>
          <%= render "shared/alert_panel",
                eyebrow: "Ready for you",
                headline: "#{number_to_currency(still_cents / 100.0)} is waiting on your bank",
                body: "Add your bank and it goes out with the next payout run. It reaches your bank about two business days later.",
                actions: [ { text: "Add your bank", path: my_payments_connect_bank_path, method: :post, form: { data: { turbo: false } } } ] %>
        <% end %>
        <% if still_groups.any? %>
          <div class="space-y-3">
            <% still_groups.each do |group| %>
              <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                <%
                  sub = [ group.org, group.when_text ].compact.join(" · ").presence
                  sub ||= group.kind == :waiting ? "Your manager approves hours before they go out." : "Goes out once it's added to a payout run."
                %>
                <%= render "my/payments/group_header", tone: group.kind == :waiting ? :waiting : :approved,
                      title: group_titles[group.kind], sub: sub, cents: group.total_cents %>
                <%= render "my/payments/lines", lines: group.lines %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="bg-white rounded-lg border border-gray-200"><%= render "shared/empty_state", icon: "check", title: "Nothing waiting right now", body: "New pay shows up here as soon as it's worked out.", compact: true %></div>
        <% end %>
      </section>

      <%# Past payments: each says what it was for and opens to its lines,
          grouped by month so months of weekly pay stay readable. %>
      <section>
        <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">Past payments</h2>
        <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
          <% if past.any? %>
            <% past.group_by { |p| p.paid_at&.to_date&.beginning_of_month }.each do |month, in_month| %>
              <div class="px-5 py-2 bg-gray-50 border-y border-gray-100 first:border-t-0 flex items-center justify-between text-xs font-semibold uppercase tracking-wide text-gray-500">
                <span><%= month ? month.strftime("%B %Y") : "Undated" %></span>
                <span class="tabular-nums"><%= number_to_currency(in_month.sum(&:cents) / 100.0) %></span>
              </div>
              <div class="divide-y divide-gray-100">
                <% in_month.each do |payment| %>
                  <%
                    # Only a payment with more to it than its own line opens:
                    # several lines, or something taken out. One plain line
                    # goes straight to its receipt.
                    opens = payment.lines.size > 1 || payment.lines.any? { |l| l.deductions.any? }
                    row_class = "px-5 py-3 flex items-center justify-between gap-4 hover:bg-gray-50 transition-colors"
                    when_line =
                      if payment.kind == "offset" then [ "Settled #{payment.paid_at&.strftime('%b %-d, %Y')}", "went toward what you owe" ].join(" · ")
                      elsif payment.stage then deposit_stage_phrase(payment.stage, paid_at: payment.paid_at, expected_on: payment.expected_on, deposited_on: payment.deposited_on)
                      else paid_with_phrase(payment.paid_at, payment.method)
                      end
                    when_class = payment.stage == :deposited ? "text-green-700" : "text-gray-500"
                  %>
                  <% row = capture do %>
                    <div class="min-w-0">
                      <div class="text-sm font-medium text-gray-900 truncate">
                        <%= payment.title %><% if payment.more_count.positive? %> <span class="font-normal text-gray-500">and <%= pluralize(payment.more_count, "more") %></span><% end %>
                      </div>
                      <div class="text-xs truncate">
                        <% if payment.org %><span class="text-gray-500"><%= payment.org %> · </span><% end %><span class="<%= when_class %>"><%= when_line %></span>
                      </div>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                      <span class="text-sm font-semibold text-gray-900 tabular-nums"><%= number_to_currency((payment.kind == "offset" ? payment.offset_cents : payment.cents) / 100.0) %></span>
                      <% if opens %>
                        <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                      <% else %>
                        <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                      <% end %>
                    </div>
                  <% end %>
                  <% if opens %>
                    <details class="group">
                      <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer <%= row_class %>"><%= row %></summary>
                      <div class="bg-gray-50/60 border-t border-gray-100">
                        <%= render "my/payments/lines", lines: payment.lines %>
                        <div class="px-5 pb-3 text-right">
                          <%= link_to "Receipt", my_payment_receipt_path(kind: payment.kind, id: payment.id), class: "text-xs font-medium text-pink-600 hover:text-pink-700" %>
                        </div>
                      </div>
                    </details>
                  <% else %>
                    <%= link_to row, my_payment_receipt_path(kind: payment.kind, id: payment.id), class: row_class %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <%= render "shared/empty_state", icon: "money", title: "No payments yet", body: "Pay from shows and shifts shows up here once it's sent.", compact: true %>
          <% end %>
        </div>
      </section>
    </div>

    <%# Right column: actions (money-section style). %>
    <aside class="space-y-4">
      <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
        <%= render "shared/section_heading", padding: "px-5 py-4", title: "Payment settings" %>
        <div class="px-5 py-4 space-y-3">
          <% if @person.can_receive_payouts? %>
            <div class="flex items-center justify-between gap-3 text-sm">
              <span class="text-gray-700">Paid to your bank</span>
              <%= link_to "Change", my_payments_setup_path, class: "font-medium text-pink-600 hover:text-pink-700" %>
            </div>
          <% else %>
            <p class="text-sm text-gray-700">Add your bank so you can be paid.</p>
            <%= render "shared/button", text: "Add your bank", variant: "primary", size: "medium", path: my_payments_setup_path %>
          <% end %>
          <p class="text-xs text-gray-500">Pay reaches your bank about two business days after it's sent.</p>
        </div>
      </div>

      <% if @tax_memberships.any? %>
        <div class="bg-white rounded-lg border border-gray-200 p-5">
          <h3 class="font-semibold text-gray-900 mb-1">Tax documents</h3>
          <p class="text-xs text-gray-500 mb-3">The W-9 you've given each place you're on staff.</p>
          <ul class="divide-y divide-gray-100">
            <% @tax_memberships.each do |member| %>
              <% w9 = member.current_w9 %>
              <li class="py-2.5 first:pt-0 last:pb-0">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-sm font-medium text-gray-900 truncate"><%= member.organization.name %></span>
                  <% if w9 %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-medium flex-shrink-0">W-9 on file</span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 text-xs font-medium flex-shrink-0">W-9 needed</span>
                  <% end %>
                </div>
                <% if w9 %>
                  <p class="text-xs text-gray-500 mt-0.5">
                    Signed <%= w9.signed_at.strftime("%b %-d, %Y") %> · <%= w9.masked_tin %> ·
                    <%= link_to "View", my_w9_copy_path(member.organization_id), target: "_blank", rel: "noopener", class: "text-pink-600 hover:text-pink-700" %> ·
                    <%= link_to "Update", my_w9_path(member.organization_id, return_to: "payments"), class: "text-pink-600 hover:text-pink-700" %>
                  </p>
                <% else %>
                  <div class="mt-2">
                    <%= render "shared/button", text: "Fill out your W-9", variant: "primary", size: "small",
                          path: my_w9_path(member.organization_id, return_to: "payments") %>
                  </div>
                <% end %>
              </li>
            <% end %>
            <% @person_1099s.group_by { |f| [ f.organization_id, f.tax_year ] }.each_value do |forms| %>
              <% form = forms.max_by(&:created_at) %>
              <li class="py-2.5">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-sm font-medium text-gray-900 truncate"><%= form.organization.name %> · <%= form.tax_year %> 1099-NEC</span>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 text-xs font-medium flex-shrink-0"><%= form.status.humanize %></span>
                </div>
                <p class="text-xs text-gray-500 mt-0.5">
                  Sent <%= form.delivered_at&.strftime("%b %-d, %Y") %> · Box 1 $<%= format("%.2f", form.reported_box1_cents / 100.0) %> ·
                  <%= link_to "View", my_form_1099_path(form.organization_id, form.tax_year), target: "_blank", rel: "noopener", class: "text-pink-600 hover:text-pink-700" %>
                </p>
              </li>
            <% end %>
          </ul>
        </div>
      <% elsif @person_1099s.any? %>
        <div class="bg-white rounded-lg border border-gray-200 p-5">
          <h3 class="font-semibold text-gray-900 mb-1">Tax documents</h3>
          <ul class="divide-y divide-gray-100">
            <% @person_1099s.group_by { |f| [ f.organization_id, f.tax_year ] }.each_value do |forms| %>
              <% form = forms.max_by(&:created_at) %>
              <li class="py-2.5 first:pt-0 last:pb-0">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-sm font-medium text-gray-900 truncate"><%= form.organization.name %> · <%= form.tax_year %> 1099-NEC</span>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 text-xs font-medium flex-shrink-0"><%= form.status.humanize %></span>
                </div>
                <p class="text-xs text-gray-500 mt-0.5">
                  <%= link_to "View", my_form_1099_path(form.organization_id, form.tax_year), target: "_blank", rel: "noopener", class: "text-pink-600 hover:text-pink-700" %>
                </p>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="rounded-lg bg-gray-50 border border-gray-200 p-4">
        <p class="text-xs text-gray-500">Your bank details stay with our payment provider; organizations never see them. A W-9 you give an organization is encrypted and shared only with them.</p>
      </div>
    </aside>
  </div>
</div>
