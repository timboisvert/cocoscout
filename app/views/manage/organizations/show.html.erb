<% content_for :title, @organization.name %>

<%= render layout: "shared/settings_layout", locals: {
  title: @organization.name,
  breadcrumbs: [
    ["Organizations", manage_organizations_path]
  ],
  sections: sections,
  current: @section,
  width: "max-w-4xl"
} do %>
  <%# Section content still hangs off these page-level controllers. %>
  <div data-controller="org-team-modals org-locations-settings org-messages">
    <%= render "manage/organizations/sections/#{@section}" %>
  </div>
<% end %>
