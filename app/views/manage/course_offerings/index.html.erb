<% content_for :title, "Courses" %>

<%
  courses_description = <<~HTML
    <p class="mb-2">
      This is where you run your classes and workshops — set them up, sell registrations
      online, and get paid.
    </p>
    <p>
      Students pay when they register. CocoScout collects the money, then sends your
      share to your bank and pays your instructors directly after each course runs.
    </p>
  HTML

  courses_actions = [
    { icon: "clipboard-list", text: "New Course", description: "Set up a class or workshop", path: manage_course_wizard_basics_path },
    { icon: "cog", text: "Course Settings", description: "Your bank and how payouts work", path: manage_course_payout_settings_path }
  ]
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render "shared/module_header",
    title: "Courses",
    description: courses_description,
    actions: courses_actions
  %>

  <div class="border-t border-gray-200 pt-6 mt-2">
<% if @course_offerings.any? %>
  <%# Payouts overview %>
  <% bank_connected = Current.organization.can_receive_payouts? %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4">
      <div class="text-sm text-gray-500">Active courses</div>
      <div class="text-2xl font-bold text-gray-900 mt-1"><%= @active_courses_count %></div>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4">
      <div class="text-sm text-gray-500">Awaiting payout</div>
      <div class="text-2xl font-bold <%= @awaiting_payout.any? ? 'text-pink-600' : 'text-gray-900' %> mt-1"><%= @awaiting_payout.size %></div>
    </div>
    <%= link_to manage_course_payout_settings_path, class: "bg-white border border-gray-200 rounded-xl px-5 py-4 hover:border-gray-300 transition-colors block" do %>
      <div class="flex items-center justify-between">
        <div class="text-sm text-gray-500">Payouts to your bank</div>
        <%= icon("arrow-right", class: "w-4 h-4 text-gray-400") %>
      </div>
      <div class="mt-1 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full <%= bank_connected ? 'bg-green-500' : 'bg-amber-500' %>"></span>
        <span class="text-sm font-semibold <%= bank_connected ? 'text-gray-900' : 'text-amber-700' %>">
          <%= bank_connected ? "Bank connected" : "Set up your bank" %>
        </span>
      </div>
    <% end %>
  </div>

  <%# An assembled course payout run with money still to send. %>
  <% if @course_run_pending_cents.to_i > 0 %>
    <%= link_to manage_course_payout_run_path, class: "flex items-center justify-between gap-3 bg-pink-50 border border-pink-200 rounded-xl px-5 py-4 mb-6 hover:bg-pink-100 transition-colors" do %>
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-pink-100 flex items-center justify-center flex-shrink-0">
          <%= icon("dollar-sign", class: "w-5 h-5 text-pink-600") %>
        </div>
        <div>
          <p class="text-sm font-semibold text-pink-900"><%= number_to_currency(@course_run_pending_cents / 100.0) %> ready to pay out</p>
          <p class="text-xs text-pink-700">Instructors and your organization are queued in the course payout run.</p>
        </div>
      </div>
      <span class="inline-flex items-center gap-1 text-sm font-medium text-pink-700 flex-shrink-0">Go to run <%= icon("arrow-right", class: "w-4 h-4") %></span>
    <% end %>
  <% end %>

  <%# Courses awaiting payout — quick links straight to each one's payout page. %>
  <% if @awaiting_payout.any? %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-6">
      <div class="px-5 py-3 border-b border-gray-200">
        <h2 class="text-sm font-semibold text-gray-900">Courses awaiting payout</h2>
      </div>
      <div class="divide-y divide-gray-100">
        <% @awaiting_payout.each do |offering| %>
          <%= link_to manage_course_offering_payout_path(offering), class: "flex items-center justify-between px-5 py-3 hover:bg-gray-50 transition-colors" do %>
            <div class="min-w-0">
              <div class="font-medium text-gray-900 truncate"><%= offering.title %></div>
              <div class="text-sm text-gray-500"><%= offering.confirmed_registrations_count %> registered · <%= number_to_currency(OrgPayout.owed_cents_for_course(offering) / 100.0) %> to pay out</div>
            </div>
            <span class="inline-flex items-center gap-1 text-sm font-medium text-pink-600 flex-shrink-0">
              Review payout
              <%= icon("arrow-right", class: "w-4 h-4") %>
            </span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="space-y-2">
    <% @course_offerings.each do |offering| %>
      <div class="bg-white rounded-lg border border-gray-200 hover:border-gray-300 transition-all">
        <%= link_to manage_course_offering_path(offering), class: "block" do %>
          <div class="flex flex-col lg:flex-row lg:items-stretch">

            <%# Panel 1: Course Info %>
            <div class="flex-1 flex items-center gap-4 px-4 py-3 rounded-t-lg lg:rounded-l-lg lg:rounded-tr-none">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center">
                <svg class="w-5 h-5 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <span class="font-medium text-gray-900 truncate"><%= offering.title %></span>
                  <% case offering.status %>
                  <% when "draft" %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700">Draft</span>
                  <% when "open" %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700">Open</span>
                  <% when "closed" %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700">Closed</span>
                  <% when "archived" %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-500">Archived</span>
                  <% end %>
                </div>
                <div class="text-sm text-gray-600">
                  <%= offering.production.name %>
                  <% if offering.instructor_name.present? %>
                    &middot; <%= offering.instructor_name %>
                  <% end %>
                </div>
              </div>
            </div>

            <%# Panel 2: Price %>
            <div class="w-full lg:w-1/5 px-4 py-3 border-t lg:border-t-0 lg:border-l border-gray-200 flex flex-col justify-center">
              <div class="text-[10px] text-gray-400 uppercase tracking-wide mb-0.5">Price</div>
              <div class="text-sm font-medium text-gray-900"><%= offering.formatted_price %></div>
              <% if offering.early_bird_price_cents.present? %>
                <div class="text-[10px] text-green-600">Early bird: <%= offering.formatted_early_bird_price %></div>
              <% end %>
            </div>

            <%# Panel 3: Registrations %>
            <div class="w-full lg:w-1/6 px-4 py-3 border-t lg:border-t-0 lg:border-l border-gray-200 flex flex-col justify-center">
              <div class="text-[10px] text-gray-400 uppercase tracking-wide mb-0.5">Registrations</div>
              <div class="text-sm font-medium text-gray-900"><%= offering.confirmed_registrations_count %></div>
            </div>

            <%# Panel 4: Capacity %>
            <div class="w-full lg:w-1/6 px-4 py-3 border-t lg:border-t-0 lg:border-l border-gray-200 rounded-b-lg lg:rounded-r-lg lg:rounded-bl-none flex flex-col justify-center">
              <div class="text-[10px] text-gray-400 uppercase tracking-wide mb-0.5">Spots Left</div>
              <% if offering.capacity.present? %>
                <div class="text-sm font-medium <%= offering.spots_remaining > 0 ? 'text-gray-900' : 'text-red-600' %>"><%= offering.spots_remaining %></div>
              <% else %>
                <div class="text-sm text-gray-400">&infin;</div>
              <% end %>
            </div>

          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white border border-gray-200 rounded-lg p-12 text-center">
    <div class="flex items-center justify-center mb-4">
      <div class="h-12 w-12 rounded-full bg-pink-100 flex items-center justify-center">
        <svg class="h-6 w-6 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
      </div>
    </div>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">No Courses Yet</h3>
    <p class="text-gray-600 text-sm mb-6">
      Create a course to start selling registrations online.
    </p>
    <%= link_to manage_course_wizard_basics_path do %>
      <%= render "shared/button", text: "Create Course", variant: "primary", size: "medium" %>
    <% end %>
  </div>
<% end %>
  </div>
</div>
