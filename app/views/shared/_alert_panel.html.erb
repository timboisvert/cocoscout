<%# THE alert for "something needs your attention" across My pages.
    One shape everywhere: a label, one big line, one small line, one button on
    the right. If you're tempted to invent another nudge box, use this instead.

    Locals:
      eyebrow  (required) — the category line, e.g. "You're owed", "Waiting on you"
      headline (required) — the one big thing: an amount, a count, a name
      body     (optional) — one small supporting line. Pass a plain String (it
                            gets escaped) or an html_safe fragment built with
                            tag helpers when you need a bold word inside.
      actions  (optional) — array of hashes handed straight to shared/button
                            (text:, path:, method:, data:, type:, form:, variant:).
                            The first is pink, the rest outline. Usually one.

    Stack them: each carries its own mb-6, so several in a row read as a list
    of things to deal with. %>
<%
  eyebrow  = local_assigns.fetch(:eyebrow)
  headline = local_assigns.fetch(:headline)
  body     = local_assigns[:body]
  actions  = local_assigns.fetch(:actions, [])
%>
<div data-alert-panel class="mb-6 rounded-lg border-2 border-pink-200 bg-gradient-to-r from-pink-50 to-white p-5">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div class="min-w-0">
      <div class="text-xs font-semibold uppercase tracking-wider text-pink-600"><%= eyebrow %></div>
      <div class="text-2xl font-bold text-gray-900 tabular-nums mt-0.5"><%= headline %></div>
      <% if body.present? %>
        <p class="text-sm text-gray-600 mt-1 max-w-2xl"><%= body %></p>
      <% end %>
    </div>
    <% if actions.any? %>
      <div class="flex-shrink-0 flex items-center gap-2">
        <% actions.each_with_index do |action, i| %>
          <%= render "shared/button", { variant: i.zero? ? "primary" : "outline", size: "medium" }.merge(action) %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
