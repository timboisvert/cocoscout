<%# What a payment (or coming batch) is made of, on My Payments: each thing
    they're paid for, with any charge taken out of it listed under it and
    what's left. Locals: lines (MyPaymentsSummary::Line). %>
<div class="divide-y divide-gray-100">
  <% lines.each do |line| %>
    <div class="px-5 py-2.5">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <div class="text-sm text-gray-900 flex items-center gap-2">
            <span class="min-w-0 truncate"><%= line.label %></span>
            <% if line.tag %>
              <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium bg-amber-100 text-amber-700 flex-shrink-0"><%= line.tag %></span>
            <% end %>
          </div>
          <% if line.detail.present? %><div class="text-xs text-gray-400 truncate"><%= line.detail %></div><% end %>
        </div>
        <div class="text-sm tabular-nums flex-shrink-0 <%= line.tag ? 'text-gray-500' : 'text-gray-900' %>">
          <%= line.cents.negative? ? "−#{number_to_currency(line.cents.abs / 100.0)}" : number_to_currency(line.cents / 100.0) %>
        </div>
      </div>
      <% if line.deductions.any? %>
        <div class="mt-1.5 ml-3 pl-3 border-l-2 border-purple-200 space-y-1">
          <% line.deductions.each do |d| %>
            <div class="flex items-center justify-between gap-4 text-sm text-gray-600">
              <span class="min-w-0 truncate"><%= d.label %></span>
              <span class="tabular-nums flex-shrink-0">−<%= number_to_currency(d.cents.abs / 100.0) %></span>
            </div>
          <% end %>
          <div class="flex items-center justify-between gap-4 text-sm font-medium text-gray-900">
            <span>You get</span>
            <span class="tabular-nums flex-shrink-0"><%= number_to_currency(line.net_cents / 100.0) %></span>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
