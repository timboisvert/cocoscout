<% content_for :title, "Approve Hours" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ ["Staffing", manage_staffing_index_path] ],
    text: "Approve Hours",
    links: [
      { text: "View approved hours", path: manage_approved_staffing_timesheets_path, icon: "check-circle", variant: "secondary" }
    ]
  } %>

  <% if @groups.empty? %>
    <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-10 text-center mt-6">
      <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-3">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      </div>
      <p class="text-sm font-medium text-gray-900">You're all caught up</p>
      <p class="text-sm text-gray-500 mt-1">No hours are waiting for your approval. Submitted time shows up here for sign-off before you pay it.</p>
    </div>
  <% else %>
    <%# Summary bar + approve-everything %>
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-gray-200 bg-white px-5 py-4 mt-6">
      <p class="text-sm text-gray-700">
        <span class="font-semibold text-gray-900"><%= pluralize(@total_entries, "entry") %></span>
        · <span class="font-semibold text-gray-900"><%= number_with_precision(@total_hours, precision: 2, strip_insignificant_zeros: true) %> hrs</span>
        from <%= pluralize(@groups.size, "person") %> awaiting your approval
      </p>
      <% approve_all_cid = "confirm-approve-all" %>
      <%= render "shared/button", text: "Approve everything", variant: "secondary", size: "small", type: :button,
            data: { controller: "modal", action: "click->modal#open", modal_id: approve_all_cid } %>
      <%= render "shared/confirm_modal", id: approve_all_cid,
            title: "Approve all pending?",
            message: "Approve every pending entry from all #{@groups.size} people?",
            confirm_text: "Approve everything",
            url: manage_approve_staffing_timesheets_path, method: :patch,
            params: { all: "1" } %>
    </div>

    <div class="space-y-4 mt-4">
      <% @groups.each do |person, entries| %>
        <% person_hours = entries.sum(&:hours) %>
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <%# Person header %>
          <div class="flex items-center justify-between gap-3 px-5 py-3 border-b border-gray-100 bg-gray-50">
            <div class="flex items-center gap-3 min-w-0">
              <% headshot_variant = person.safe_headshot_variant(:thumb) %>
              <% if headshot_variant %>
                <%= image_tag headshot_variant, alt: person.name, class: "w-9 h-9 rounded-lg object-cover flex-shrink-0" %>
              <% else %>
                <div class="w-9 h-9 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-xs flex-shrink-0">
                  <%= person.initials %>
                </div>
              <% end %>
              <div class="min-w-0">
                <div class="font-medium text-gray-900 truncate"><%= person.name %></div>
                <div class="text-xs text-gray-500"><%= pluralize(entries.size, "entry") %> · <%= number_with_precision(person_hours, precision: 2, strip_insignificant_zeros: true) %> hrs</div>
              </div>
            </div>
            <%= form_with url: manage_approve_staffing_timesheets_path(person_id: person.id), method: :patch do %>
              <%= render "shared/button", text: "Approve #{number_with_precision(person_hours, precision: 2, strip_insignificant_zeros: true)} hrs", variant: "primary", size: "small", type: :submit %>
            <% end %>
          </div>

          <%# This person's pending entries %>
          <div class="divide-y divide-gray-100">
            <% entries.each do |e| %>
              <div class="flex items-center gap-3 px-5 py-3">
                <div class="min-w-0 flex-1">
                  <div class="text-sm font-medium text-gray-900">
                    <%= e.started_at.strftime("%a %b %-d") %>
                    <span class="text-gray-400">·</span>
                    <%= number_with_precision(e.hours, precision: 2, strip_insignificant_zeros: true) %>h
                    <% if e.source == "manual" %>
                      <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">self-logged</span>
                    <% end %>
                  </div>
                  <div class="text-xs text-gray-500 truncate">
                    <%= e.started_at.strftime("%-l:%M %p") %>–<%= e.ended_at.strftime("%-l:%M %p") %>
                    <% role_label = e.shift&.role_label.presence || e.house_role&.name %>
                    <% if role_label.present? %> · <%= role_label %><% end %>
                    <%# What approving this entry costs, priced at the role it was worked as. %>
                    <% member_for_entry = @members_by_person_id[person.id] %>
                    <% rate_cents = member_for_entry&.rate_cents_for(e.effective_house_role).to_i %>
                    <% entry_cents = member_for_entry ? member_for_entry.amount_cents_for(e.effective_house_role, hours: e.hours) : 0 %>
                    <% if entry_cents.positive? %> · <%= member_for_entry.rate_label_for(e.effective_house_role) %> → <span class="font-medium text-gray-700"><%= number_to_currency(entry_cents / 100.0) %></span><% end %>
                    <% if e.notes.present? %> · <span class="italic">“<%= e.notes %>”</span><% end %>
                  </div>
                </div>
                <div class="flex items-center gap-3 flex-shrink-0">
                  <%= link_to "Adjust", manage_edit_staffing_timesheet_path(e),
                        data: { turbo_frame: "timesheet_edit_modal" },
                        class: "text-xs font-medium text-pink-600 hover:text-pink-700" %>
                  <% already_paid_cid = "already-paid-#{e.id}" %>
                  <button type="button" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= already_paid_cid %>"
                          class="text-xs text-gray-400 hover:text-pink-600 underline bg-transparent border-0 cursor-pointer">Already paid</button>
                  <%= render "manage/staffing/timesheets/already_paid_modal", entry: e, id: already_paid_cid %>
                  <% reject_cid = "confirm-reject-#{e.id}" %>
                  <button type="button" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= reject_cid %>"
                          class="text-xs text-gray-400 hover:text-red-600 bg-transparent border-0 cursor-pointer">Reject</button>
                  <%= render "shared/confirm_modal", id: reject_cid,
                        title: "Reject this entry?",
                        message: "Reject and remove #{person.name}'s #{number_with_precision(e.hours, precision: 2, strip_insignificant_zeros: true)}h entry on #{e.started_at.strftime('%b %-d')}? They can re-submit if it was a mistake.",
                        confirm_text: "Reject",
                        url: manage_reject_staffing_timesheet_path(e), method: :delete %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Host frame for the Adjust (edit) modal, loaded by the per-entry links. %>
  <%= turbo_frame_tag "timesheet_edit_modal" %>
</div>
