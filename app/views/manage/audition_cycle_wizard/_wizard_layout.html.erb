<% content_for :title, "Set Up Auditions - #{step_name}" %>

<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Sign-ups", manage_signups_path],
      [@production.name, manage_signups_production_path(@production)],
      ["Auditions", manage_signups_auditions_path(@production)]
    ],
    text: "Set Up Auditions",
    links: []
  } %>

  <%
    # Build steps dynamically based on wizard state. Open sign-up mode skips
    # availability / reviewers / voting / form — the slot IS the audition.
    open_mode = @wizard_state && @wizard_state[:signup_mode].to_s == "open"

    wizard_steps = []
    wizard_steps << { key: "format", name: "Format", path: manage_signups_auditions_wizard_path(@production) }
    wizard_steps << { key: "schedule", name: "Schedule", path: manage_signups_auditions_wizard_schedule_path(@production) }
    if @wizard_state && @wizard_state[:allow_in_person_auditions]
      wizard_steps << { key: "sessions", name: open_mode ? "Slots" : "Sessions", path: manage_signups_auditions_wizard_sessions_path(@production) }
    end
    unless open_mode
      wizard_steps << { key: "availability", name: "Availability", path: manage_signups_auditions_wizard_availability_path(@production) }
      wizard_steps << { key: "reviewers", name: "Reviewers", path: manage_signups_auditions_wizard_reviewers_path(@production) }
      wizard_steps << { key: "voting", name: "Voting", path: manage_signups_auditions_wizard_voting_path(@production) }
      wizard_steps << { key: "form_starter", name: "Form", path: manage_signups_auditions_wizard_form_starter_path(@production) }
    end
    wizard_steps << { key: "review", name: "Review", path: manage_signups_auditions_wizard_review_path(@production) }

    # Views may pass current_step_key so the highlighted step stays correct
    # even when the step list changes by mode. Fall back to the passed integer.
    current_step_key = local_assigns[:current_step_key]
    current_index = wizard_steps.index { |s| s[:key] == current_step_key.to_s } || (current_step ? current_step - 1 : 0)
  %>
  <%# Full-width step bar, directly below the breadcrumb. %>
  <%= render "shared/wizard_steps", steps: wizard_steps, current_index: current_index %>

  <div class="max-w-2xl mx-auto mt-8">
    <!-- Step Content -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <%= yield %>
    </div>

    <!-- Cancel Link -->
    <div class="mt-4 text-center">
      <% cancel_cid = "confirm-#{SecureRandom.hex(6)}" %>
      <button type="button"
          data-controller="modal" data-action="click->modal#open" data-modal-id="<%= cancel_cid %>"
          class="text-sm text-gray-500 hover:text-gray-700 bg-transparent border-0 cursor-pointer p-0">Cancel</button>
      <%= render "shared/confirm_modal",
          id: cancel_cid,
          title: "Cancel?",
          message: "Are you sure you want to cancel? Your progress will be lost.",
          confirm_text: "Cancel",
          url: manage_signups_auditions_wizard_cancel_path(@production),
          method: :delete %>
    </div>
  </div>
</div>
