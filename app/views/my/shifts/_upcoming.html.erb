<%# Goal 1: when do I work. Uses @rows_by_day, @has_any, @people, @expected_by_shift.
    Under the organization, one line per show the shift covers, with how
    many people to expect where the organization shows it (Tim, 2026-10-16:
    just the show time, the show's name and the count; no box, no total).

    A shift you told them you can't make reads by where it stands (the
    performer flow, for staff): told, finding someone, then once it's
    settled a muted row saying who has it or that they're not filling it. %>
<section class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <%= render "shared/section_heading", padding: "px-5 py-4", title: "Upcoming shifts" %>

  <div class="p-5">
    <% if @has_any %>
      <div class="space-y-5">
        <% @rows_by_day.each do |day, rows| %>
          <div>
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2"><%= day.strftime("%A, %B %-d") %></h3>
            <div class="space-y-2">
              <% rows.each do |row| %>
                <% shift = row[:shift] %>
                <% assignment = row[:assignment] %>
                <% vacancy = row[:vacancy] %>
                <% outcome = row[:outcome] %>
                <% dropped = outcome || assignment.declined? %>
                <% org = shift.organization %>
                <% location_name = shift.source.try(:location).try(:name) %>
                <%
                  # The shows this shift covers: with counts where the organization
                  # shows them; otherwise, for a show-tied shift, just the shows.
                  show_lines = (@expected_by_shift || {})[shift.id]
                  if show_lines.nil? && (shift.house_role&.show_specific? || shift.shows.any?)
                    show_lines = shift.covered_shows.map { |cs| ShiftExpectedAttendance::Line.new(show: cs, expected: nil) }
                  end
                  tone = if outcome then "bg-white border-gray-200 opacity-75"
                  elsif dropped then "bg-pink-50 border-pink-200"
                  else "bg-gray-50 border-gray-100"
                  end
                %>
                <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 p-3 rounded-lg border <%= tone %>" data-shift-row="<%= outcome ? 'settled' : (dropped ? 'dropped' : 'on') %>">
                  <div class="flex items-start gap-4 flex-1 min-w-0">
                    <div class="flex-shrink-0 w-12 flex items-center gap-1 pt-0.5">
                      <span class="text-lg leading-none font-bold text-gray-900"><%= shift.starts_at.strftime("%-d") %></span>
                      <span class="text-[9px] leading-tight font-semibold text-pink-600 uppercase"><%= shift.starts_at.strftime("%b") %></span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="font-medium text-gray-900 truncate <%= "line-through text-gray-500" if dropped %>"><%= shift.role_label %></div>
                      <div class="text-sm text-gray-600 tabular-nums"><%= shift.starts_at.strftime("%-l:%M %p") %>–<%= shift.ends_at.strftime("%-l:%M %p") %></div>
                      <div class="text-xs text-gray-500 truncate">
                        <% if org %><%= org.name %><% end %><% if location_name.present? && location_name != org&.name %> · <%= location_name %><% end %>
                        <% if @people.size > 1 %> · <%= row[:person].name %><% end %>
                      </div>
                      <% Array(show_lines).each do |line| %>
                        <div class="text-xs text-gray-600 mt-0.5" data-show-line>
                          <span class="font-semibold text-gray-800"><%= line.words %></span><% if line.expected %> · <span class="tabular-nums"><%= line.expected %> expected</span><% end %>
                        </div>
                      <% end %>
                      <% if outcome %>
                        <div class="mt-1 text-xs text-gray-600 font-medium" data-shift-outcome>
                          <% if vacancy.filled? && vacancy.filled_by %>
                            <%= vacancy.filled_by.name %> has it now.
                          <% else %>
                            They're not filling it.
                          <% end %>
                        </div>
                      <% elsif dropped %>
                        <div class="mt-1 text-xs text-pink-700 font-medium" data-shift-state>
                          You told them you can't make it<% if assignment.decline_reason.present? %> — “<%= assignment.decline_reason %>”<% end %><% if vacancy&.finding_replacement? %> · they're finding someone to cover it<% end %>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <% unless outcome %>
                    <div class="flex-shrink-0 sm:self-center">
                      <% if dropped %>
                        <%= button_to "I'm back on", my_undo_decline_shift_path(assignment), method: :post,
                              class: "text-xs text-gray-600 hover:text-gray-900 underline bg-transparent border-0 cursor-pointer p-0" %>
                      <% else %>
                        <% cid = "cant-make-it-#{assignment.id}" %>
                        <% form_id = "decline-shift-#{assignment.id}" %>
                        <%= render "shared/button", text: "I can't make it", variant: "primary", size: "small", type: :button,
                              classes: "w-full sm:w-auto justify-center min-h-[44px] sm:min-h-0",
                              data: { controller: "modal", action: "click->modal#open", modal_id: cid } %>
                        <%= render layout: "shared/sheet", locals: { id: cid, title: "Can't make this shift?", footer: capture {
                              concat render("shared/button", text: "Never mind", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" })
                              concat render("shared/button", text: "I can't make it", variant: "primary", size: "medium", type: :submit, form_id: form_id)
                            } } do %>
                          <div class="space-y-4">
                            <div class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-2">
                              <div class="font-medium text-gray-900"><%= shift.role_label %> · <%= shift.starts_at.strftime("%a, %b %-d") %></div>
                              <div class="text-sm text-gray-600 tabular-nums"><%= shift.starts_at.strftime("%-l:%M %p") %>–<%= shift.ends_at.strftime("%-l:%M %p") %><% if org %> · <%= org.name %><% end %></div>
                              <% Array(show_lines).each do |line| %>
                                <div class="text-xs text-gray-600">Covers <%= line.words %></div>
                              <% end %>
                            </div>
                            <%= form_with url: my_decline_shift_path(assignment), method: :post, id: form_id do %>
                              <label class="block text-sm font-medium text-gray-700 mb-1" for="<%= form_id %>-reason">Add a note (optional)</label>
                              <%= text_area_tag :reason, nil, rows: 2, id: "#{form_id}-reason", placeholder: "e.g. I'm out of town that weekend",
                                    class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
                            <% end %>
                            <p class="text-sm text-gray-600">We'll tell <span class="font-medium text-gray-900"><%= org&.name %></span> and they'll look for someone to cover it. You can take it back here until someone does.</p>
                          </div>
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state", icon: "clock", title: "No upcoming shifts", body: "They'll show up here once your schedule is posted.", compact: true %>
    <% end %>
  </div>
</section>
