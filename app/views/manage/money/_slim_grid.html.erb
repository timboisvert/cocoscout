<%#
  Shared slim, spreadsheet-style grid of production/course financial summaries.
  Reused on the financials list and the money hub. A production row expands in
  place to its revenue events; a course row (money in − out = profit, all on one
  line) links to the course's financials.

  Locals:
    summaries: array of summary hashes, each with at least :production,
               :gross_revenue, :net_income; optionally :is_course, :is_third_party,
               :revenue_shows / :total_shows, :pending_financials_count
    label:     first-column header (default "Production")
%>
<%= render layout: "shared/slim_list", locals: { label: local_assigns.fetch(:label, "Production"), columns: [ "Revenue", "Costs", "Profit" ] } do %>
  <% summaries.each do |summary| %>
    <%
      production = summary[:production]
      is_third_party = summary[:is_third_party]
      is_course = summary[:is_course]
      gross_revenue = summary[:gross_revenue] || 0
      net_income = summary[:net_income] || 0
      costs = gross_revenue - net_income
      event_count = is_third_party ? (summary[:total_shows] || 0) : (summary[:revenue_shows] || 0)
      pending = summary[:pending_financials_count].to_i

      if is_course
        subtitle = "#{event_count} #{'registration'.pluralize(event_count)}"
      else
        subtitle = "#{event_count} revenue #{'event'.pluralize(event_count)}"
        subtitle += " · #{pending} pending" if pending > 0
      end

      # What matters on the line is production vs course — not whether a contract
      # governs it (that shows in the expanded events bar / on the detail page).
      badge = is_course ? { text: "Course", color: "purple" } : nil

      profit_class = net_income > 0 ? "text-green-600" : (net_income < 0 ? "text-red-600" : "text-gray-900")

      row_locals = {
        title: production.name,
        subtitle: subtitle,
        badge: badge,
        cells: [
          { value: number_to_currency(gross_revenue) },
          { value: number_to_currency(costs), class: costs > 0 ? "text-red-600" : "text-gray-400" },
          { value: number_to_currency(net_income), class: profit_class }
        ]
      }
    %>
    <% if is_course %>
      <%= render "shared/slim_list_row", **row_locals, href: manage_money_production_financials_path(production) %>
    <% else %>
      <%= render "shared/slim_list_row", **row_locals,
            expand_src: manage_money_production_financial_events_path(production),
            expand_id: "prod-events-#{production.id}" %>
    <% end %>
  <% end %>
<% end %>
