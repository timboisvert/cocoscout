<% accent = @organization.email_accent %>
<div class="grid grid-cols-1 lg:grid-cols-5 gap-5 items-start">
  <%= form_with model: @organization, url: manage_mailing_list_settings_look_path, method: :patch, data: { turbo: false }, class: "lg:col-span-3 bg-white rounded-lg border border-gray-200 overflow-hidden" do |f| %>
    <%= render "shared/section_heading", title: "Email look", intro: "The top and bottom of every email you send" %>
    <div class="p-6 space-y-5">
      <div>
        <span class="block text-sm font-medium text-gray-700 mb-1.5">Logo</span>
        <div class="flex flex-wrap items-center gap-3">
          <% if @organization.logo.attached? && @organization.logo.variable? %>
            <%= image_tag @organization.logo.variant(resize_to_limit: [ 160, 160 ]), alt: "", class: "w-14 h-14 rounded-lg object-cover border border-gray-200" %>
          <% else %>
            <span class="w-14 h-14 rounded-lg flex items-center justify-center text-white font-extrabold" style="background-color: <%= accent %>"><%= @organization.initials %></span>
          <% end %>
          <%= f.file_field :logo, accept: "image/png,image/jpeg,image/webp", class: "text-sm text-gray-600" %>
        </div>
        <p class="text-xs text-gray-500 mt-1.5">Your organization's logo. Without one, emails show its two letters on its color.</p>
      </div>
      <div>
        <span class="block text-sm font-medium text-gray-700 mb-1.5">Color</span>
        <div class="flex flex-wrap items-center gap-3">
          <% Organization::EMAIL_ACCENTS.each do |name, hex| %>
            <label class="cursor-pointer">
              <%= f.radio_button :email_accent_color, hex, checked: accent == hex, class: "sr-only peer" %>
              <span class="block w-8 h-8 rounded-full ring-offset-2 peer-checked:ring-2 peer-checked:ring-gray-900 peer-focus-visible:ring-2 peer-focus-visible:ring-pink-500" style="background-color: <%= hex %>" title="<%= name.capitalize %>"></span>
            </label>
          <% end %>
          <span class="text-xs text-gray-500">Buttons and the line under the logo</span>
        </div>
      </div>
      <div>
        <%= f.label :email_footer_line, "A line at the bottom", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :email_footer_line, class: follower_input_class, placeholder: "Chicago's home for weird, wonderful comedy" %>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :email_website_url, "Website", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.url_field :email_website_url, class: follower_input_class, placeholder: "https://" %>
        </div>
        <div>
          <%= f.label :email_instagram, "Instagram", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.text_field :email_instagram, class: follower_input_class, placeholder: "@yourhandle" %>
        </div>
      </div>
      <div>
        <%= f.label :email_mailing_address, "Mailing address", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :email_mailing_address, class: follower_input_class, placeholder: @organization.email_postal_address || "Street, city, state, ZIP" %>
        <p class="text-xs text-gray-500 mt-1.5">The law asks for one in every marketing email. <%= @organization.email_mailing_address.blank? && @organization.email_postal_address ? "Until you set one, it's the address on your invoices." : "" %></p>
      </div>
      <div>
        <span class="block text-sm font-medium text-gray-700 mb-1">Replies go to</span>
        <p class="text-sm text-gray-600"><%= @profile.support_email.presence || "Nobody yet" %>, from <%= link_to "Ticketing settings", manage_ticketing_settings_path, class: "text-pink-600 hover:text-pink-700 underline" %>.</p>
      </div>
      <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>

  <section class="lg:col-span-2 space-y-2">
    <span class="text-[11px] font-semibold uppercase tracking-wider text-gray-500">How it looks</span>
    <div class="rounded-xl bg-gray-100 p-4 flex justify-center">
      <div class="w-full max-w-[300px] bg-white rounded-lg overflow-hidden shadow-sm">
        <div class="pt-5 pb-3 flex justify-center"><span class="w-12 h-12 rounded-lg flex items-center justify-center text-white font-extrabold" style="background-color: <%= accent %>"><%= @organization.initials %></span></div>
        <div class="h-[3px] mx-5" style="background-color: <%= accent %>"></div>
        <div class="px-5 py-4 space-y-2">
          <div class="h-2 w-3/4 rounded bg-gray-200"></div><div class="h-2 w-11/12 rounded bg-gray-200"></div><div class="h-2 w-5/6 rounded bg-gray-200"></div>
          <div class="mt-3 rounded text-white text-center text-xs font-semibold py-2" style="background-color: <%= accent %>">Buy tickets</div>
        </div>
        <div class="px-5 py-3 bg-gray-50 text-[10.5px] text-gray-500 text-center leading-relaxed">
          <% if @organization.email_footer_line.present? %><%= @organization.email_footer_line %><br><% end %>
          You're getting this because you asked to hear from <%= @organization.name %>.<br>
          <%= @organization.email_postal_address || "[Your mailing address]" %><br>
          <span class="underline">Unsubscribe</span> · Sent with CocoScout
        </div>
      </div>
    </div>
  </section>
</div>
