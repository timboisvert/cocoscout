<%= render layout: "manage/contract_wizard/wizard_layout", locals: { step_name: "Services" } do %>
  <h2 class="text-xl font-bold text-gray-900 mb-2 coustard-regular">Services</h2>
  <p class="text-gray-600 mb-6">Optional — add any services this contract includes, like technical services. You don't have to add anything.</p>

  <%= form_with url: manage_tech_contract_wizard_path(@contract), method: :post, local: true do |form| %>
    <div class="mb-6">
      <%= render "manage/contracts/services_fields", service_options: @service_options, existing_services: @existing_services, bookings: @bookings %>
    </div>

    <div class="flex items-center justify-between">
      <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", icon: "arrow-left", path: @contract.org_sells_tickets? ? manage_ticketing_contract_wizard_path(@contract) : manage_payments_contract_wizard_path(@contract) %>
      <div class="flex items-center gap-3">
        <%= link_to "Skip — no services", manage_documents_contract_wizard_path(@contract), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <%= render "shared/button", text: "Next: Documents", variant: "primary", size: "medium", type: :submit %>
      </div>
    </div>
  <% end %>
<% end %>
