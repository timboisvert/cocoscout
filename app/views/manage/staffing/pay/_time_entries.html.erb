<%# Unpaid time entries for one person, loaded into the pull-hours modal frame.
    Checkboxes default on; the pay-pull controller sums the checked ones. %>
<%= turbo_frame_tag "pay_time_entries" do %>
  <% if entries.any? %>
    <div class="space-y-2">
      <% entries.each do |e| %>
        <label class="flex items-center gap-3 px-3 py-2 border border-gray-200 rounded-lg cursor-pointer hover:border-pink-300">
          <input type="checkbox" checked data-entry-id="<%= e.id %>" data-hours="<%= e.hours %>"
                 data-action="change->pay-pull#recalcSubtotal"
                 class="h-4 w-4 rounded border-gray-300 accent-pink-500">
          <div class="min-w-0 flex-1">
            <div class="text-sm font-medium text-gray-900 truncate">
              <%= e.started_at.strftime("%a %b %-d") %>
              <span class="text-gray-400">·</span>
              <%= number_with_precision(e.hours, precision: 2, strip_insignificant_zeros: true) %>h
              <% if e.source == "manual" %><span class="text-[10px] px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">self-logged</span><% end %>
            </div>
            <div class="text-xs text-gray-500 truncate">
              <%= e.started_at.strftime("%-l:%M %p") %>–<%= e.ended_at.strftime("%-l:%M %p") %>
              <% if e.shift&.role_label.present? %> · <%= e.shift.role_label %><% end %>
            </div>
          </div>
        </label>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-400 py-4 text-center">No unpaid hours logged for this person yet.</p>
  <% end %>
<% end %>
