
<nav class="hidden w-56 bg-white border-r border-r-2 border-gray-200 lg:flex flex-col transition-all duration-200 ease-in-out z-50 justify-between fixed left-0 top-0 h-screen">
  <%= render "shared/navigation/nav_dashboard_selector", current_dashboard: "production" %>

  <div class="flex-1 overflow-y-auto">

    <div class="mt-2">

      <% if Current.organization.present? %>

        <%
        # Check if user has team access to any production, or is an org-level manager/viewer
        has_team_access = %w[manager viewer].include?(Current.user.default_role) ||
          Current.user.accessible_productions.where(organization: Current.organization).any? { |p| Current.user.role_for_production(p).present? }

        # Pro-tier gating: paid modules show a lock and link to billing for free orgs.
        on_paid_plan = Current.organization&.on_paid_plan?

        # Build links based on access level
        links = []

        if has_team_access
          # Full navigation for production team members
          links = [
            {
              label: "Home",
              path: manage_path,
              active: controller_name == "manage" && action_name == "index"
            },
            {
              label: "Messages",
              path: manage_messages_path,
              active: controller_name == "messages"
            },
            {
              label: "Shows & Events",
              path: manage_shows_path,
              active: ["shows", "org_shows", "vacancies", "show_wizard"].include?(controller_name)
            },
            {
              label: "Casting",
              path: manage_casting_path,
              active: ["casting", "org_casting", "casting_availability", "roles", "talent_pools", "casting_tables", "org_roles", "org_talent_pools", "org_availability"].include?(controller_name)
            },
            {
              label: "Sign-ups",
              path: manage_signups_path,
              active: ["signups", "org_signups", "sign_up_forms", "auditions", "audition_cycles", "audition_requests", "audition_sessions", "sign_up_form_wizard", "audition_cycle_wizard", "org_auditions", "org_forms"].include?(controller_name)
            },
            {
              label: "Courses",
              path: manage_course_offerings_path,
              active: ["course_offerings", "course_offering_wizard"].include?(controller_name)
            },
            # Producer-plan (free) modules come before the locked Pro ones.
            {
              label: "Documents",
              path: manage_org_documents_path,
              active: ["org_documents", "documents"].include?(controller_name)
            },
            {
              label: "Contacts",
              path: manage_contacts_path,
              active: ["directory", "people", "groups", "questionnaires"].include?(controller_name)
            },
            # Locked modules link to their real page; the paid-feature gate renders
            # the feature-specific upgrade paywall for Producer-plan orgs.
            {
              label: "Money",
              path: manage_money_index_path,
              locked: !on_paid_plan,
              feature: :money,
              active: controller_name == "money" || controller_name == "money_financials" || controller_name == "money_payouts" || controller_name == "show_payouts" || controller_name == "show_financials"
            },
            {
              label: "Reports",
              path: manage_reports_path,
              locked: !on_paid_plan,
              feature: :reports,
              active: controller_name == "reports"
            }
          ].compact

          # Staffing is limited to org owners/managers. Insert it right above Money.
          if Current.user&.superadmin? || Current.organization&.manageable_by?(Current.user)
            money_idx = links.index { |l| l[:label] == "Money" }
            links.insert((money_idx || links.length), {
              label: "Staffing",
              path: manage_staffing_index_path,
              locked: !on_paid_plan,
              feature: :staffing,
              active: controller_path.start_with?("manage/staffing")
            })
          end
        else
          # Limited navigation for reviewer-only users
          links = [
            {
              label: "Sign-ups",
              path: manage_signups_path,
              active: ["signups", "org_signups", "sign_up_forms", "auditions", "audition_cycles", "audition_requests", "audition_sessions"].include?(controller_name)
            }
          ]
        end
        %>

        <% links.each do |item| %>
          <% if item[:label] == "Messages" %>
            <div class="relative">
              <%= render "shared/nav_link", text: item[:label], path: item[:path], active: item[:active] %>
              <% unread_count = Current.user&.unread_message_count_for_org(Current.organization).to_i %>
              <% if unread_count > 0 %>
                <span class="absolute top-2 right-2 inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 text-xs font-bold text-white bg-pink-500 rounded-full" data-unread-badge><%= unread_count > 99 ? "99+" : unread_count %></span>
              <% end %>
            </div>
          <% else %>
            <%= render "shared/nav_link", text: item[:label], path: item[:path], active: item[:active], badge: item[:badge], locked: item[:locked], upgrade_feature: (item[:locked] ? item[:feature] : nil) %>
          <% end %>
        <% end %>

        <% unless on_paid_plan %>
          <% used = Current.organization.events_in_month.count %>
          <% limit = Organization::FREE_MONTHLY_EVENT_LIMIT %>
          <% can_manage_billing = Current.user&.superadmin? || Current.organization.manageable_by?(Current.user) %>
          <% upgrade_link = can_manage_billing ? manage_organization_path(Current.organization, anchor: "tab-4") : pricing_path %>
          <%= link_to upgrade_link, class: "block mx-3 mt-4 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2.5 hover:border-pink-300 transition-colors" do %>
            <div class="flex items-center justify-between text-xs font-semibold text-gray-700">
              <span>Producer plan</span>
              <span class="<%= used >= limit ? 'text-pink-600' : 'text-gray-500' %>"><%= used %>/<%= limit %> events</span>
            </div>
            <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-gray-200">
              <div class="h-full rounded-full <%= used >= limit ? 'bg-pink-500' : 'bg-gray-400' %>" style="width: <%= [(used.to_f / limit * 100).round, 100].min %>%"></div>
            </div>
            <div class="mt-1.5 text-xs text-pink-600 font-medium">Upgrade to Pro Plan →</div>
          <% end %>
        <% end %>

      <% end %>

    </div>

  </div>

  <!-- Bottom section -->
  <div class="mt-auto">
    <div class="flex justify-center">
      <%= render "shared/cocoscout_logo", size: :medium %>
    </div>
    <%= render "shared/navigation/sidebar_account_menu" %>
  </div>

</nav>