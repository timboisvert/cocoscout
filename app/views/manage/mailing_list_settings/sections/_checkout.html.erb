<% check_class = "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
<div class="grid grid-cols-1 lg:grid-cols-5 gap-5 items-start">
  <%= form_with model: @profile, url: manage_mailing_list_settings_checkout_path, method: :patch, data: { turbo: false }, class: "lg:col-span-3 bg-white rounded-lg border border-gray-200 overflow-hidden" do |f| %>
    <%= render "shared/section_heading", title: "Checkout", intro: "Ticket buyers join your lists while they buy" %>
    <div class="p-6 space-y-5">
      <label class="flex items-start gap-3 text-sm">
        <%= f.check_box :follow_at_checkout, class: check_class %>
        <span><span class="block font-semibold text-gray-900">Ask ticket buyers to join</span><span class="block text-xs text-gray-500">A box under their email address at checkout. Never at the door.</span></span>
      </label>
      <label class="flex items-start gap-3 text-sm">
        <%= f.check_box :follow_boxes_ticked, class: check_class %>
        <span><span class="block font-semibold text-gray-900">Start the boxes ticked</span><span class="block text-xs text-gray-500">They can untick. Every email has a one-click unsubscribe.</span></span>
      </label>
      <div>
        <%= f.label :follow_main_words, "The words for your main list", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :follow_main_words, class: follower_input_class, placeholder: "Send me news from #{@organization.name}" %>
      </div>
      <div class="border-t border-gray-100 pt-4">
        <div class="font-semibold text-gray-900 text-sm">Productions with their own list</div>
        <p class="text-xs text-gray-500 mt-0.5">A list that collects from a production adds a second box to that production's checkout. Set it on the list, with Change where it collects.</p>
        <% if @collecting_lists.any? { |list| list.productions.any? } %>
          <div class="mt-3 rounded-lg border border-gray-200 divide-y divide-gray-100 text-sm">
            <% @collecting_lists.select { |list| list.productions.any? }.each do |list| %>
              <%= link_to manage_mailing_list_path(list), class: "flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 px-3.5 py-2.5 hover:bg-gray-50" do %>
                <span class="min-w-0 flex-1 text-gray-900"><%= list.productions.map(&:name).sort.to_sentence %></span>
                <span class="text-xs text-gray-500">"<%= list.box_words %>"</span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
      <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>

  <section class="lg:col-span-2 bg-white rounded-lg border border-gray-200 p-5">
    <h3 class="font-semibold text-gray-900 mb-3">What buyers see</h3>
    <div class="space-y-2.5 text-sm text-gray-700">
      <div><span class="block text-xs font-medium text-gray-700 mb-1">Email</span><div class="px-3 py-2.5 border border-gray-300 rounded-lg text-gray-400">you@example.com</div></div>
      <% example = @collecting_lists.find { |list| list.productions.any? } %>
      <% if example %><label class="flex items-center gap-2.5"><input type="checkbox" class="h-4 w-4 accent-pink-500" <%= "checked" if @profile.follow_boxes_ticked %> disabled><%= example.box_words %></label><% end %>
      <label class="flex items-center gap-2.5"><input type="checkbox" class="h-4 w-4 accent-pink-500" <%= "checked" if @profile.follow_boxes_ticked %> disabled><%= MailingList.main_for!(@organization).box_words %></label>
    </div>
    <% unless @profile.follow_at_checkout %><p class="text-xs text-amber-700 mt-3">Switched off: checkout doesn't ask.</p><% end %>
  </section>
</div>
