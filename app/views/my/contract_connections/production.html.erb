<%# Connect, step 2: which organization (when they run several) and which
    production takes the contract's dates. A GET form: the choice is
    carried in the next step's address. From the controller: @contract,
    @organizations, @organization, @productions, @suggested (same name as
    the contract's production, only ever a suggestion), @new_name,
    @can_make_new. %>
<% content_for :title, "Connect: your production" %>
<%
  org = @contract.organization.name
  choice_class = "flex items-start p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-pink-400 transition-colors has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 bg-white"
  radio_class = "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500"
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  first = @suggested || @productions.first
%>
<div class="w-full mb-10 max-w-3xl">
  <%= render "my/contract_connections/steps", step: 2 %>

  <% dates = LinkedDates.contract_shows(@contract).where(canceled: false).count %>
  <h1 class="text-3xl coustard-regular text-gray-900">Where would you like these dates to go?</h1>
  <p class="text-gray-600 mt-2">
    Your contract with <%= org %> has <%= pluralize(dates, "date") %>. Choose the production in <%= @organization.name %> that they
    belong to, and we'll add them there <%= @standing ? "as soon as you finish these steps" : "once #{org} accepts" %>.
  </p>

  <% if @organizations.many? %>
    <%= form_with url: my_connect_contract_production_path(@contract), method: :get, class: "mt-6" do %>
      <label for="connect_organization" class="block text-sm font-medium text-gray-700 mb-1">You run more than one organization on CocoScout. Which one is this show in?</label>
      <div class="flex gap-2">
        <select name="organization_id" id="connect_organization" class="<%= input_class %>">
          <% @organizations.each do |organization| %>
            <option value="<%= organization.id %>" <%= "selected" if organization == @organization %>><%= organization.name %></option>
          <% end %>
        </select>
        <%= render "shared/button", text: "Show its productions", variant: "secondary", size: "medium", type: :submit, classes: "flex-shrink-0" %>
      </div>
    <% end %>
  <% end %>

  <%= form_with url: my_connect_contract_dates_path(@contract), method: :get, class: "mt-6" do %>
    <input type="hidden" name="organization_id" value="<%= @organization.id %>">
    <fieldset>
      <legend class="sr-only">The production to add the dates to</legend>
      <div class="space-y-2">
        <% @productions.each do |production| %>
          <% shows = production.shows.where(event_type: "show", canceled: false).where("date_and_time > ?", Time.current).count %>
          <label class="<%= choice_class %>">
            <input type="radio" name="production" value="<%= production.id %>" <%= "checked" if production == first %> class="<%= radio_class %>">
            <div class="ml-3 min-w-0">
              <div class="text-sm font-medium text-gray-900">
                Add them to <%= production.name %>
                <% if production == @suggested %><span class="ml-1.5 inline-flex items-center rounded-full bg-pink-50 px-2 py-0.5 text-xs font-medium text-pink-700">Same name as the contract</span><% end %>
              </div>
              <div class="text-sm text-gray-500">
                <% if shows.zero? %>
                  This production has no shows coming up yet, so <%= dates == 1 ? "the date" : "all #{dates} dates" %> will simply be added to it.
                <% else %>
                  This production already has <%= pluralize(shows, "show") %> coming up. On the next step you'll be able to check them against the contract, so that no date ends up listed twice.
                <% end %>
              </div>
            </div>
          </label>
        <% end %>

        <% if @can_make_new %>
          <label class="<%= choice_class %>">
            <input type="radio" name="production" value="new" <%= "checked" if first.nil? %> class="<%= radio_class %>">
            <div class="ml-3 flex-1 min-w-0">
              <div class="text-sm font-medium text-gray-900">Create a new production for them</div>
              <div class="text-sm text-gray-500 mb-2">We'll create it <%= @standing ? "when you finish these steps" : "as soon as #{org} accepts" %>, with the contract's <%= pluralize(dates, "date") %> already in it. What would you like to call it?</div>
              <input type="text" name="new_name" value="<%= @new_name %>" maxlength="120" aria-label="The new production's name" class="<%= input_class %>">
            </div>
          </label>
        <% else %>
          <p class="text-sm text-gray-500 px-1">
            <%= @organization.name %> is on the free plan, which includes one production, so the dates will be added to the one you already have.
          </p>
        <% end %>
      </div>
    </fieldset>

    <div class="flex items-center justify-between mt-6 pt-4 border-t border-gray-200">
      <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", path: my_connect_contract_path(@contract) %>
      <%= render "shared/button", text: "Continue", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
</div>
