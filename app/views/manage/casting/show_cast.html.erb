<% content_for :title, "Show: #{@show.date_and_time.strftime("%A, %B %-d, %Y")}" %>

<div class="w-full pb-10">
  <%= render partial: "shared/notice", locals: { notice: notice } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Casting", manage_casting_path],
      [@production.name, manage_casting_production_path(@production)]
    ],
    text: @show.date_and_time.strftime("%A, %b %d, %Y"),
    links: []
  } %>

  <%= render "manage/shows/show_info_card", show: @show %>

  <% if @show.casting_finalized? || !current_user_can_manage?(@production) %>
    <%# ===== FINALIZED STATE (and a viewer's read-only look) ===== %>
    <%= render "manage/casting/finalized_cast", show: @show, production: @production, roles: @roles, assignments_by_role_id: @assignments_by_role_id, people_by_id: @people_by_id, groups_by_id: @groups_by_id %>
  <% else %>
    <%# ===== EDITING STATE ===== %>
    <%
      # Determine casting source mode - use show's effective source (respects show-level override)
      casting_source = @show.effective_casting_source
      is_manual_mode = casting_source == "manual"
      show_talent_pool_panel = !is_manual_mode # Show for talent_pool or sign_up modes
      # Talent pool now supports click-to-add (formerly hybrid-only behavior)
      show_click_to_add = true # Always show click-to-add for all modes
      # "role" or "act" — the word this board uses for the thing being cast.
      # The show decides (it may override the production's casting style).
      unit = casting_unit(@show)
      unit_plural = casting_unit(@show, plural: true)
      unit_title = casting_unit(@show, capitalize: true)
      lineup_nums = lineup_numbers(@roles, show: @show)
      # The progress line counts every slot; on an act-based night with show
      # roles (MC, Stage Kitten ×2) those aren't all acts, so it says "spots".
      progress_unit_plural = @show.act_based? && @roles.any?(&:standing?) ? "spots" : unit_plural
    %>
    <div data-controller="drop-role<%= " running-order" if @show.act_based? %>"
         data-drop-role-show-id-value="<%= @show.id %>"
         data-drop-role-production-id-value="<%= @production.id %>"
         data-drop-role-casting-source-value="<%= casting_source %>"
         data-drop-role-unit-value="<%= unit %>"
         data-drop-role-progress-unit-value="<%= progress_unit_plural %>"
         data-drop-role-click-to-add-value="<%= show_click_to_add %>"
         data-drop-role-act-based-value="<%= @show.act_based? %>"
         <% if @show.act_based? %>
         data-running-order-reorder-url-value="<%= manage_casting_show_running_order_reorder_path(@production, @show) %>"
         data-running-order-acts-url-value="<%= manage_casting_show_running_order_acts_path(@production, @show) %>"
         data-running-order-options-url-value="<%= manage_casting_show_running_order_act_options_path(@production, @show) %>"
         data-running-order-reset-preview-url-value="<%= manage_casting_show_running_order_reset_preview_path(@production, @show) %>"
         data-running-order-reset-url-value="<%= manage_casting_show_running_order_reset_path(@production, @show) %>"
         <% end %>>

    <%
      # Count filled slots (assignments) vs total slots
      filled_slots = @assignments.size
      total_slots = @roles_count  # This is now sum of quantities from controller
      percentage = total_slots > 0 ? (filled_slots.to_f / total_slots * 100).round : 0
      fully_cast = percentage == 100

      # Linkage sync status
      is_linked = @show.linked?
      sync_info = @linkage_sync_info
      all_in_sync = sync_info.present? ? sync_info[:all_in_sync] : true
      can_finalize = fully_cast && (!is_linked || all_in_sync)
    %>

    <%# Row 0: Linkage sync bar - wrapper for dynamic updates %>
    <div id="linkage-sync-section">
      <%= render "manage/casting/linkage_sync_bar_content",
          show: @show,
          linked_shows: @linked_shows,
          sync_info: sync_info,
          production: @production %>
    </div>

    <%# Row 1: Roles configuration bar - always show so users can configure roles %>
    <div class="mb-4">
      <div id="roles-config-bar">
        <%= render "manage/casting/roles_config_bar", show: @show, production: @production, roles: @roles %>
      </div>
    </div>

    <% if total_slots > 0 %>
      <%# Row 2: Progress bar with inline linkage sync %>
      <div id="casting-progress-bar" class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
        <div class="flex flex-col lg:flex-row lg:items-stretch">
          <%# Left: cast progress. Label text is kept in sync by drop-role#updateProgressBar. %>
          <div class="flex-1 px-4 py-3 flex items-center">
            <div class="flex-1 min-w-0">
              <div class="mb-2">
                <span id="progress-label" class="text-sm font-semibold text-gray-900">
                  <% if fully_cast %>This show is 100% cast<% else %><%= filled_slots %> of <%= total_slots %> <%= progress_unit_plural %> have been cast<% end %>
                </span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div id="progress-bar" class="<%= fully_cast ? 'bg-green-500' : 'bg-pink-500' %> h-2 rounded-full transition-all" style="width: <%= percentage %>%"></div>
              </div>
            </div>
          </div>

          <%# Right: its own segment with a divider, matching the roles bar above.
              The partial supplies the segment styling so the empty state (no one cast)
              renders no visible panel. State-driven: Notify / Finalize / Contact Cast. %>
          <div id="notify-section-wrapper" class="flex-shrink-0 flex">
            <%= render "manage/casting/notify_modal",
                show: @show,
                production: @production,
                can_finalize: can_finalize,
                cast_email_draft: @cast_email_draft,
                removed_email_draft: @removed_email_draft %>
          </div>
        </div>
      </div>

      <%# On a phone (V1.1 plan §4): the cast count and Notify pinned to the
          bottom, so they're never a scroll away. Notify opens the same modal
          as the button above (drop-role#notifyFromBar). %>
      <div class="md:hidden h-20" aria-hidden="true"></div>
      <div class="md:hidden fixed inset-x-0 bottom-0 z-30 bg-white/95 backdrop-blur border-t border-gray-200 pl-4 <%= turbo_native_app? ? 'pr-[96px]' : 'pr-4' %> pt-3 pb-[calc(env(safe-area-inset-bottom)+12px)] flex items-center gap-3" data-casting-phone-bar>
        <span id="progress-fraction" class="flex-1 text-sm font-semibold <%= fully_cast ? 'text-green-600' : 'text-pink-600' %>"><%= filled_slots %>/<%= total_slots %> <%= progress_unit_plural %> cast</span>
        <span data-drop-role-target="phoneNotify" class="<%= 'hidden' if filled_slots.zero? %>">
          <%= render "shared/button", text: "Notify", variant: "primary", size: "medium", type: :button, data: { action: "click->drop-role#notifyFromBar" } %>
        </span>
      </div>
    <% elsif @show.use_custom_roles? && @roles.empty? %>
      <%# Show warning when custom roles is enabled but no roles are defined %>
      <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6">
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 text-amber-500">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
          </div>
          <div>
            <% if @show.act_based? %>
              <h3 class="font-semibold text-amber-900">No acts in the lineup</h3>
              <p class="text-sm text-amber-800 mt-1">
                This event uses its own lineup, but no acts have been added yet. Edit the lineup above to start casting.
              </p>
            <% else %>
              <h3 class="font-semibold text-amber-900">No roles defined</h3>
              <p class="text-sm text-amber-800 mt-1">
                Custom roles is enabled for this event, but no roles have been created yet. Configure roles above to start casting.
              </p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="flex flex-col lg:flex-row gap-6">

      <!-- Roles on the left (or top on mobile) -->
      <div class="w-full min-w-0 <%= show_talent_pool_panel ? 'lg:w-[55%]' : '' %>">
        <%= render partial: "manage/casting/roles_list", locals: {
          show: @show,
          roles: @roles,
          assignments_by_role_id: @assignments_by_role_id,
          people_by_id: @people_by_id,
          groups_by_id: @groups_by_id,
          sync_info: @linkage_sync_info,
          click_to_add: show_click_to_add,
          is_manual_mode: is_manual_mode
        } %>

        <%# Sign-up Attendees Box %>
        <% if @sign_up_registrations.any? %>
          <%
            # Calculate total capacity from sign-up form instances
            total_capacity = @show.sign_up_form_instances.sum { |instance| instance.total_capacity }
            attendee_count = @sign_up_registrations.count
            # Get sign-up form for linking
            first_sign_up_form = @sign_up_registrations.first&.sign_up_form
          %>
          <div class="mt-4 bg-white border border-gray-200 rounded-lg overflow-hidden">
            <div class="p-3">
              <div class="flex flex-col sm:grid sm:grid-cols-[minmax(100px,140px)_1fr] gap-2 sm:gap-4 sm:items-center">
                <div class="font-semibold text-sm text-gray-900 flex items-center gap-1">
                  Attendees
                  <span class="text-xs px-1.5 py-0.5 rounded-full bg-pink-100 text-pink-700">
                    <%= attendee_count %>/<%= total_capacity %>
                  </span>
                </div>

                <div class="flex flex-wrap gap-2">
                  <% @sign_up_registrations.each do |registration| %>
                    <%
                      person = registration.person
                      slot = registration.sign_up_slot
                      sign_up_form = registration.sign_up_form
                      tooltip_text = registration_slot_tooltip(registration)

                      display_name = person&.name || registration.guest_name || "Guest"
                    %>
                    <% if person %>
                      <% headshot_variant = person.safe_headshot_variant(:thumb) %>
                      <% if headshot_variant %>
                        <% if sign_up_form %>
                          <%= link_to manage_signups_form_path(@production, sign_up_form) do %>
                            <%= image_tag headshot_variant,
                                alt: display_name,
                                class: "w-10 h-10 rounded-md object-cover hover:ring-2 hover:ring-pink-300 transition-all",
                                data: { controller: "tooltip", tooltip_text: tooltip_text } %>
                          <% end %>
                        <% else %>
                          <%= image_tag headshot_variant,
                              alt: display_name,
                              class: "w-10 h-10 rounded-md object-cover",
                              data: { controller: "tooltip", tooltip_text: tooltip_text } %>
                        <% end %>
                      <% else %>
                        <% if sign_up_form %>
                          <%= link_to manage_signups_form_path(@production, sign_up_form) do %>
                            <div class="w-10 h-10 rounded-md bg-gray-100 text-gray-700 hover:ring-2 hover:ring-pink-300 transition-all flex items-center justify-center font-bold text-xs"
                                 data-controller="tooltip"
                                 data-tooltip-text="<%= tooltip_text %>">
                              <%= person.initials %>
                            </div>
                          <% end %>
                        <% else %>
                          <div class="w-10 h-10 rounded-md bg-gray-100 text-gray-700 flex items-center justify-center font-bold text-xs"
                               data-controller="tooltip"
                               data-tooltip-text="<%= tooltip_text %>">
                            <%= person.initials %>
                          </div>
                        <% end %>
                      <% end %>
                    <% else %>
                      <% if sign_up_form %>
                        <%= link_to manage_signups_form_path(@production, sign_up_form) do %>
                          <div class="w-10 h-10 rounded-md bg-gray-100 text-gray-700 hover:ring-2 hover:ring-pink-300 transition-all flex items-center justify-center font-bold text-xs"
                               data-controller="tooltip"
                               data-tooltip-text="<%= tooltip_text %>">
                            <%= registration.display_initials %>
                          </div>
                        <% end %>
                      <% else %>
                        <div class="w-10 h-10 rounded-md bg-gray-100 text-gray-700 flex items-center justify-center font-bold text-xs"
                             data-controller="tooltip"
                             data-tooltip-text="<%= tooltip_text %>">
                          <%= registration.display_initials %>
                        </div>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if show_talent_pool_panel %>
      <!-- Cast Members on the right (or bottom on mobile) - sticky on desktop -->
      <div class="hidden lg:block w-full lg:w-[45%] min-w-0 lg:sticky lg:top-4 lg:h-fit">
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <div class="p-4 border-b border-gray-200 flex items-center justify-between">
            <h3 class="font-semibold text-gray-900">Talent Pool</h3>
          </div>
          <%
            is_linked = @show.linked?
            linked_count = is_linked ? @linked_shows.count : 0
          %>
          <div class="px-4 pt-4 <%= @restricted_roles.any? ? 'pb-4 border-b border-gray-200' : 'pb-0' %>" data-controller="cast-filter" data-cast-filter-is-linked-value="<%= is_linked %>" data-cast-filter-linked-count-value="<%= linked_count %>">
            <!-- Availability Filter -->
            <% if is_linked && linked_count > 0 %>
              <%# Linked shows: Show Fully Available / Unavailable / All filters %>
              <%= render "shared/filters/filter_bar", bare: true, no_container: true, filter_groups: [
                {
                  filters: [
                    {
                      text: "Available",
                      path: "#",
                      active: true,
                      data: {
                        action: "cast-filter#filterByAvailability",
                        value: "fully-available"
                      }
                    },
                    {
                      text: "Unavailable",
                      path: "#",
                      active: false,
                      data: {
                        action: "cast-filter#filterByAvailability",
                        value: "unavailable"
                      }
                    },
                    {
                      text: "Everyone",
                      path: "#",
                      active: false,
                      data: {
                        action: "cast-filter#filterByAvailability",
                        value: "all"
                      }
                    }
                  ]
                }
              ] %>
            <% else %>
              <%# Non-linked shows: Show Available / Unavailable / Everyone filters %>
              <%= render "shared/filters/filter_bar", bare: true, no_container: true, filter_groups: [
                {
                  filters: [
                    {
                      text: "Available",
                      path: "#",
                      active: true,
                      data: {
                        action: "cast-filter#filterByAvailability",
                        value: "available"
                      }
                    },
                    {
                      text: "Unavailable",
                      path: "#",
                      active: false,
                      data: {
                        action: "cast-filter#filterByAvailability",
                        value: "unavailable"
                      }
                    },
                    {
                      text: "Everyone",
                      path: "#",
                      active: false,
                      data: {
                        action: "cast-filter#filterByAvailability",
                        value: "all"
                      }
                    }
                  ]
                }
              ] %>
            <% end %>

            <% if @restricted_roles.any? %>
              <!-- Restricted Role Filter -->
              <div class="mt-2 flex items-center gap-2">
                <label class="text-xs text-gray-500 whitespace-nowrap">Eligible for:</label>
                <select data-action="change->cast-filter#filterByRole"
                        data-cast-filter-target="roleFilter"
                        data-eligible-by-role='<%= @eligible_by_role_id.to_json %>'
                        class="flex-1 rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-pink-500 focus:ring-pink-500">
                  <option value="">All <%= unit_plural.capitalize %></option>
                  <% @restricted_roles.each do |role| %>
                    <option value="<%= role.id %>"><%= role_display_name(role, lineup_nums, show: @show) %></option>
                  <% end %>
                </select>
              </div>
            <% end %>
          </div>
          <div class="p-4 max-h-[calc(100vh-200px)] overflow-y-auto" data-cast-filter-target="list">
            <%= render partial: "manage/casting/cast_members_list", locals: {
              show: @show,
              availability: @availability,
              pool_members: @pool_members,
              assigned_member_keys: @assigned_member_keys,
              linked_availability: @linked_availability || {},
              linked_shows: @linked_shows || []
            } %>
          </div>
        </div>
      </div>
      <% end %><%# end show_talent_pool_panel %>

    </div>

    <%# Phone, act-based night: the acts to move someone to (V1.1 plan §4,
        Move to…); the JS fills it from the board's own act list. %>
    <% if @show.act_based? %>
      <%= render layout: "shared/sheet", locals: { id: "move-act-sheet", title: "Move to another act" } do %>
        <p class="text-sm text-gray-600 mb-3" data-drop-role-target="moveName"></p>
        <div class="rounded-lg border border-gray-200 divide-y divide-gray-100 overflow-hidden" data-drop-role-target="moveList" data-move-act-sheet></div>
      <% end %>
    <% end %>

    <%# Phone: the shared People Picker assigns to a slot (V1.1 plan §5):
        the talent pool first, availability for this date (and its linked
        dates), who's in the show already, who a restricted act approves,
        and a guest by name. %>
    <%= render "shared/people_picker", id: "cast-picker", title: "Assign #{unit_title}", scope: "members", list: "pool",
          production_id: @production.id, show_id: @show.id, in_show: (@show.act_based? ? "badge" : "taken"), guest: true,
          placeholder: "Search your organization", pick_action: "people-picker:pick->drop-role#picked" %>

    <%# Add Person Modal (for Manual Entry / Hybrid modes) %>
    <% if show_click_to_add %>
    <div id="add-person-modal" data-drop-role-target="addPersonModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" data-action="click->drop-role#closeAddPersonModal">
      <div class="bg-white w-full max-w-md rounded-lg shadow-xl" data-action="click->drop-role#stopPropagation">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Add Person to <span data-drop-role-target="addPersonRoleName" class="text-pink-600"></span></h2>
          <button type="button" data-action="click->drop-role#closeAddPersonModal" class="text-gray-400 hover:text-gray-600 p-1 cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <%# Tab navigation %>
        <div class="border-b border-gray-200">
          <nav class="flex -mb-px" aria-label="Tabs">
            <button type="button" data-action="click->drop-role#switchAddPersonTab" data-tab="search"
                    class="add-person-tab flex-1 py-3 px-4 text-center text-sm font-medium border-b-2 border-pink-500 text-pink-600 cursor-pointer">
              Search People
            </button>
            <button type="button" data-action="click->drop-role#switchAddPersonTab" data-tab="guest"
                    class="add-person-tab flex-1 py-3 px-4 text-center text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 cursor-pointer">
              Add Guest
            </button>
          </nav>
        </div>

        <%# Search tab content %>
        <div data-drop-role-target="addPersonSearchTab" class="p-6">
          <div class="relative">
            <input type="text"
                   data-drop-role-target="personSearchInput"
                   data-action="input->drop-role#searchPeople"
                   placeholder="Search by name or email..."
                   class="w-full px-4 py-2 pl-10 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
            <div data-drop-role-target="personSearchSpinner" class="hidden absolute right-3 top-1/2 -translate-y-1/2">
              <svg class="animate-spin h-4 w-4 text-pink-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </div>
          </div>

          <p class="text-xs text-gray-500 mt-2">Search for someone in your organization</p>

          <%# Search results %>
          <div data-drop-role-target="personSearchResults" class="mt-4 space-y-1 max-h-64 overflow-y-auto">
            <%# Results will be populated by JavaScript %>
            <p class="text-sm text-gray-400 text-center py-4">Type to search...</p>
          </div>
        </div>

        <%# Guest tab content (hidden by default) %>
        <div data-drop-role-target="addPersonGuestTab" class="p-6 hidden">
          <p class="text-sm text-gray-500 mb-4">Add someone who isn't in your organization yet.</p>

          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Name <span class="text-pink-500">*</span></label>
              <input type="text" data-drop-role-target="addPersonGuestName" placeholder="Enter name"
                     class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Email <span class="text-gray-400 text-xs">(optional)</span></label>
              <input type="email" data-drop-role-target="addPersonGuestEmail" placeholder="email@example.com"
                     class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
            </div>
          </div>

          <div class="mt-6 flex justify-end">
            <%= render "shared/button", text: "Add Guest", variant: "primary", type: :button, data: { action: "click->drop-role#addGuestFromModal" } %>
          </div>
        </div>

        <input type="hidden" data-drop-role-target="addPersonRoleId">
        <input type="hidden" data-drop-role-target="addPersonSlotPosition">
      </div>
    </div>
    <% end %>

    <%# Restricted Role Warning Modal %>
    <div id="restricted-warning-modal" data-drop-role-target="restrictedWarningModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" data-action="click->drop-role#closeRestrictedWarningModal">
      <div class="bg-white w-full max-w-md rounded-lg shadow-xl" data-action="click->drop-role#stopPropagation">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-amber-500">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
            Not Approved for This <%= unit_title %>
          </h2>
          <button type="button" data-action="click->drop-role#closeRestrictedWarningModal" class="text-gray-400 hover:text-gray-600 p-1 cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="p-6">
          <p class="text-sm text-gray-600 mb-4">
            <span data-drop-role-target="restrictedWarningPersonName" class="font-medium text-gray-900"></span>
            is not approved for <%= "the role" unless @show.act_based? %>
            <span data-drop-role-target="restrictedWarningRoleName" class="font-medium text-gray-900"></span>.
          </p>

          <div class="bg-gray-50 rounded-lg p-3 mb-4">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Approved for this <%= unit %>:</p>
            <div data-drop-role-target="restrictedWarningEligibleList" class="text-sm text-gray-700">
              <!-- Filled by JS -->
            </div>
          </div>

          <p class="text-sm text-gray-600 mb-4">
            Do you want to assign them anyway?
          </p>
        </div>

        <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-3">
          <%= render "shared/button", text: "Cancel", variant: "secondary", type: :button, data: { action: "click->drop-role#closeRestrictedWarningModal" } %>
          <%= render "shared/button", text: "Assign Anyway", variant: "primary", type: :button, data: { action: "click->drop-role#confirmRestrictedAssignment" } %>
        </div>

        <input type="hidden" data-drop-role-target="restrictedWarningRoleId">
        <input type="hidden" data-drop-role-target="restrictedWarningAssignableType">
        <input type="hidden" data-drop-role-target="restrictedWarningAssignableId">
        <input type="hidden" data-drop-role-target="restrictedWarningSourceRoleId">
        <input type="hidden" data-drop-role-target="restrictedWarningGuestName">
        <input type="hidden" data-drop-role-target="restrictedWarningGuestEmail">
      </div>
    </div>

    <%# Scheduling Conflict Modal - shown when an assign reports a double-booking %>
    <%= render "manage/casting/conflict_modal" %>

    <% if @show.act_based? %>
      <%# Running order editing: add an act or show role / edit / remove / reset %>
      <%# Typing suggestions for act names, shared by the add and rename inputs %>
      <datalist id="act-name-suggestions">
        <% (@frequent_act_names || []).each do |name| %>
          <option value="<%= name %>"></option>
        <% end %>
      </datalist>
      <%= render "manage/casting/add_act_modal" %>
      <%= render "manage/casting/add_show_role_modal" %>
      <%= render "manage/casting/edit_act_modal" %>
      <%= render "manage/casting/remove_act_modal" %>
      <%= render "manage/casting/reset_running_order_modal" %>
    <% end %>

    <%# Replace Assignment Modal - shown when dropping on a full role %>
    <div id="replace-assignment-modal" data-drop-role-target="replaceModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" data-action="click->drop-role#closeReplaceModal">
      <div class="bg-white w-full max-w-md rounded-lg shadow-xl" data-action="click->drop-role#stopPropagation">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">
            <span data-drop-role-target="replaceModalTitle">Replace or Add?</span>
          </h2>
          <button type="button" data-action="click->drop-role#closeReplaceModal" class="text-gray-400 hover:text-gray-600 p-1 cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="p-6">
          <%# New person being added - with headshot %>
          <div class="flex items-center gap-3 p-3 bg-pink-50 border border-pink-200 rounded-lg mb-4">
            <div data-drop-role-target="replaceNewPersonHeadshot" class="w-12 h-12 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-sm flex-shrink-0 overflow-hidden">
              <!-- Filled by JS with image or initials -->
            </div>
            <div class="flex-1">
              <p class="text-xs text-pink-600 font-medium uppercase tracking-wide">Adding</p>
              <p class="font-semibold text-gray-900" data-drop-role-target="replaceNewPersonName">Someone</p>
            </div>
            <div class="text-right">
              <p class="text-xs text-gray-500">to</p>
              <p class="font-medium text-gray-900" data-drop-role-target="replaceRoleName"><%= unit_title %></p>
            </div>
          </div>

          <%# Eligibility warning - shown when person isn't eligible for restricted role %>
          <div data-drop-role-target="replaceEligibilityWarning" class="hidden mb-4 p-3 bg-amber-50 border border-amber-200 rounded-lg">
            <div class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
              </svg>
              <div>
                <p class="text-sm font-medium text-amber-800">Not eligible for this restricted <%= unit %></p>
                <p class="text-xs text-amber-600 mt-0.5"><span data-drop-role-target="replaceNewPersonNameWarning">This person</span> isn't on the approved list.</p>
              </div>
            </div>
          </div>

          <p class="text-sm font-medium text-gray-700 mb-3">Who should they replace?</p>

          <%# Options list %>
          <div data-drop-role-target="replaceOptionsList" class="space-y-2">
            <!-- Options will be populated by JavaScript -->
          </div>
        </div>

        <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-3">
          <%= render "shared/button", text: "Cancel", variant: "secondary", type: :button, data: { action: "click->drop-role#closeReplaceModal" } %>
        </div>

        <input type="hidden" data-drop-role-target="replaceRoleId">
        <input type="hidden" data-drop-role-target="replaceAssignableType">
        <input type="hidden" data-drop-role-target="replaceAssignableId">
        <input type="hidden" data-drop-role-target="replaceSourceRoleId">
        <input type="hidden" data-drop-role-target="replaceIsEligible">
      </div>
    </div>

    <%# Vacancy/Remove Modal — shown when clicking "Can't Make It" on a finalized show %>
    <div id="vacancy-remove-modal" class="hidden fixed inset-0 z-50" data-drop-role-target="vacancyModal">
      <div class="fixed inset-0 bg-black/50" data-action="click->drop-role#closeVacancyModal"></div>
      <div class="fixed inset-0 flex items-center justify-center p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full relative">
          <div class="p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Remove <span data-drop-role-target="vacancyPersonName"></span>?</h3>
            <p class="text-sm text-gray-600 mb-5">
              Choose how to handle removing <span data-drop-role-target="vacancyPersonName2"></span> from <% if @show.act_based? %><span data-drop-role-target="vacancyRoleName"></span>.<% else %>the <span data-drop-role-target="vacancyRoleName"></span> role.<% end %>
            </p>
            <div class="space-y-3">
              <button type="button"
                class="w-full flex items-start gap-3 p-4 border border-gray-200 rounded-lg hover:border-pink-300 hover:bg-pink-50 transition-all cursor-pointer text-left"
                data-action="click->drop-role#createVacancyFromModal">
                <div class="flex-shrink-0 mt-0.5">
                  <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center">
                    <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                    </svg>
                  </div>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-900">Create a vacancy</div>
                  <div class="text-xs text-gray-500 mt-0.5">Remove them and create a vacancy so you can invite a replacement. The team will be notified.</div>
                </div>
              </button>
              <button type="button"
                class="w-full flex items-start gap-3 p-4 border border-gray-200 rounded-lg hover:border-gray-400 hover:bg-gray-50 transition-all cursor-pointer text-left"
                data-action="click->drop-role#removeFromVacancyModal">
                <div class="flex-shrink-0 mt-0.5">
                  <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center">
                    <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </div>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-900">Just remove</div>
                  <div class="text-xs text-gray-500 mt-0.5">Remove them without creating a vacancy. No notifications will be sent.</div>
                </div>
              </button>
            </div>
            <div class="mt-4 text-right">
              <button type="button" class="text-sm text-gray-500 hover:text-gray-700 cursor-pointer" data-action="click->drop-role#closeVacancyModal">Cancel</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    </div><%# End drop-role controller wrapper %>
  <% end %>

</div>

<%= render "shared/compose_message_modal" %>