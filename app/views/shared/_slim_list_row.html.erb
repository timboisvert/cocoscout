<%#
  One row in a shared/slim_list. Plain, linked (whole row), or an expandable
  accordion whose body is lazily loaded from a Turbo frame. Reusable anywhere a
  compact, spreadsheet-style row is wanted.

  Locals:
    title:      main label (required)
    cells:      array of { value:, class: } — right-aligned columns; supply the
                same count as the list's `columns` so they line up
    col_class:  width utility per column (default "w-28"); match the list
    col_classes: optional array of per-column widths (overrides col_class); match the list
    badge:      optional { text:, color: } small pill next to the title
                (color: pink|green|red|amber|gray|blue)
    subtitle:   optional small secondary text under the title
    href:       optional — a non-expandable row links here (whole row clickable)
    href_data:  optional hash of data attributes for the row link (e.g.
                { turbo_frame: "_top" } so a link inside a Turbo frame navigates
                the whole page instead of the frame)
    expand_src: optional — Turbo-frame src, lazy-loaded when the row is expanded
    expand_id:  Turbo-frame id (required when expand_src is given)
%>
<%
  col_class = local_assigns.fetch(:col_class, "w-28")
  col_classes = local_assigns[:col_classes]
  col_aligns = local_assigns[:col_aligns]
  # Column labels (usually the list's `columns`) — repeated inside each cell on
  # phones, where the header row is hidden and rows wrap to two lines.
  col_labels = local_assigns[:col_labels]
  badge = local_assigns[:badge]
  cells = local_assigns.fetch(:cells, [])
  subtitle = local_assigns[:subtitle]
  href_data = local_assigns.fetch(:href_data, {})
%>

<% inner = capture do %>
  <%# Line 1 on phones: chevron/spacer + title (full remaining width). %>
  <span class="flex-1 min-w-0">
    <span class="flex items-center gap-2">
      <span class="font-medium text-gray-900 text-sm truncate"><%= title %></span>
      <% if badge %>
        <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium bg-<%= badge[:color] %>-100 text-<%= badge[:color] %>-700 flex-shrink-0"><%= badge[:text] %></span>
      <% end %>
    </span>
    <% if subtitle.present? %>
      <span class="block text-[11px] text-gray-400 truncate mt-0.5"><%= subtitle %></span>
    <% end %>
  </span>
  <% if cells.any? %>
    <%# Phones: a second full-width line, figures spread out with tiny labels.
        sm+: back to fixed spreadsheet columns on the one line. %>
    <span class="flex w-full sm:w-auto items-center gap-3 pl-7 sm:pl-0">
      <% cells.each_with_index do |cell, i| %>
        <span class="flex-1 sm:flex-none <%= (col_classes && col_classes[i]) || col_class %> <%= (col_aligns && col_aligns[i]) || "text-right" %> text-sm tabular-nums <%= cell[:class] %>">
          <% if col_labels && col_labels[i].present? %>
            <span class="block text-[10px] uppercase tracking-wide text-gray-400 font-medium sm:hidden"><%= col_labels[i] %></span>
          <% end %>
          <%= cell[:value] %>
          <% if cell[:subvalue].present? %>
            <span class="block text-[11px] font-normal <%= cell[:subvalue_class] || "text-gray-400" %>"><%= cell[:subvalue] %></span>
          <% end %>
        </span>
      <% end %>
    </span>
  <% end %>
<% end %>

<% if local_assigns[:expand_src].present? %>
  <details class="group">
    <summary class="flex flex-wrap sm:flex-nowrap items-center gap-x-3 gap-y-1 px-3 py-2 cursor-pointer hover:bg-gray-50 list-none [&::-webkit-details-marker]:hidden">
      <svg class="w-4 h-4 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <%= inner %>
    </summary>
    <div class="border-t border-gray-100 bg-gray-50/60 px-3 py-1">
      <turbo-frame id="<%= expand_id %>" src="<%= expand_src %>" loading="lazy">
        <div class="text-xs text-gray-400 py-3 pl-7">Loading…</div>
      </turbo-frame>
    </div>
  </details>
<% elsif local_assigns[:href].present? %>
  <%= link_to href, class: "flex flex-wrap sm:flex-nowrap items-center gap-x-3 gap-y-1 px-3 py-2 hover:bg-gray-50", data: href_data do %>
    <span class="w-4 flex-shrink-0" aria-hidden="true"></span>
    <%= inner %>
  <% end %>
<% else %>
  <div class="flex flex-wrap sm:flex-nowrap items-center gap-x-3 gap-y-1 px-3 py-2">
    <span class="w-4 flex-shrink-0" aria-hidden="true"></span>
    <%= inner %>
  </div>
<% end %>
