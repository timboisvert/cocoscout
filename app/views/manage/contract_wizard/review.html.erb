<% esign = @contract.signing_mode_esign? %>
<%= render layout: "manage/contract_wizard/wizard_layout", locals: { step_name: "Review" } do %>
  <% if esign %>
    <h2 class="text-xl font-bold text-gray-900 mb-2 coustard-regular">Review the details</h2>
    <p class="text-gray-600 mb-6">Make sure everything below is right. Next you'll prepare the actual contract, sign it, and send it to <%= @contract.contractor_name %>.</p>
  <% else %>
    <h2 class="text-xl font-bold text-gray-900 mb-2 coustard-regular">Review &amp; Activate</h2>
    <p class="text-gray-600 mb-6">Review all details before activating the contract.</p>
  <% end %>

  <%
    # Hard blockers that genuinely stop the contract (no bookings, missing dates).
    # Scheduling overlaps are NOT listed here — they're handled by the conflict
    # bar above the proceed button, which lets the producer decide what to do.
    hard_errors = (@validation_errors || []).reject do |e|
      e.include?("overlaps with existing") || e.include?("conflicts with existing")
    end
  %>
  <% if hard_errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
      <div class="flex items-start">
        <%= icon("alert-circle", class: "w-5 h-5 text-red-600 mt-0.5 mr-3") %>
        <div class="flex-1">
          <h3 class="font-medium text-red-800"><%= esign ? "Cannot send yet" : "Cannot activate yet" %></h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% hard_errors.each do |error| %>
              <li><%= error %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="space-y-6">
    <%# Contractor Info %>
    <div class="border border-gray-200 rounded-lg p-4">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-medium text-gray-900">Contractor</h3>
        <%= link_to manage_contractor_contract_wizard_path(@contract), class: "text-sm text-pink-600 hover:text-pink-700" do %>
          Edit
        <% end %>
      </div>
      <dl class="grid grid-cols-2 gap-2 text-sm">
        <div>
          <dt class="text-gray-500">Company</dt>
          <dd class="text-gray-900"><%= @contract.contractor_name %></dd>
        </div>
        <% if @contract.production_name.present? %>
          <div>
            <dt class="text-gray-500">Production</dt>
            <dd class="text-gray-900"><%= @contract.production_name %></dd>
          </div>
        <% end %>
        <% if @contract.contractor_email.present? %>
          <div>
            <dt class="text-gray-500">Email</dt>
            <dd class="text-gray-900"><%= @contract.contractor_email %></dd>
          </div>
        <% end %>
        <% if @contract.contractor_phone.present? %>
          <div>
            <dt class="text-gray-500">Phone</dt>
            <dd class="text-gray-900"><%= @contract.contractor_phone %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <%# Bookings %>
    <%
      # Build lookup maps for location/space names
      locations = Current.organization.locations.includes(:location_spaces)
      locations_map = locations.index_by(&:id)
      spaces_map = locations.flat_map(&:location_spaces).index_by(&:id)
    %>
    <div class="border border-gray-200 rounded-lg p-4">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-medium text-gray-900">Bookings (<%= @contract.draft_bookings.count %>)</h3>
        <%= link_to manage_bookings_contract_wizard_path(@contract), class: "text-sm text-pink-600 hover:text-pink-700" do %>
          Edit
        <% end %>
      </div>
      <% if @contract.draft_bookings.any? %>
        <ul class="space-y-2 text-sm max-h-48 overflow-y-auto">
          <% @contract.draft_bookings.sort_by { |b| b["starts_at"].to_s }.each do |booking| %>
            <%
              starts_at = DateTime.parse(booking["starts_at"]) rescue nil
              duration = booking["duration"].to_f
              location = locations_map[booking["location_id"].to_i]
              space = spaces_map[booking["space_id"].to_i] if booking["space_id"].present?
              venue_name = location&.name || "Unknown location"
              venue_name += space ? " (#{space.name})" : " (Entire Venue)"
            %>
            <li class="flex items-center gap-2 text-gray-700">
              <%= icon("calendar", class: "w-4 h-4 text-gray-400 flex-shrink-0") %>
              <span>
                <% if starts_at %>
                  <%= starts_at.strftime("%b %d, %Y") %> at <%= starts_at.strftime("%l:%M %p").strip %>
                  <span class="text-gray-400">·</span>
                  <%= duration %> hrs
                <% else %>
                  Date TBD
                <% end %>
                <span class="text-gray-400">·</span>
                <%= venue_name %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-red-600">No bookings added</p>
      <% end %>
    </div>

    <%# The deal — every term set on Financials, so nothing needs a click back %>
    <div class="border border-gray-200 rounded-lg p-4">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-medium text-gray-900">The deal</h3>
        <%= link_to manage_payments_contract_wizard_path(@contract), class: "text-sm text-pink-600 hover:text-pink-700" do %>
          Edit
        <% end %>
      </div>
      <dl class="space-y-2 text-sm">
        <% @contract.deal_summary.each do |line| %>
          <div class="flex justify-between gap-4">
            <dt class="text-gray-500 flex-shrink-0"><%= line[:label] %></dt>
            <dd class="text-gray-900 text-right"><%= line[:value] %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <%# Payments this contract will create %>
    <div class="border border-gray-200 rounded-lg p-4">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-medium text-gray-900">Payments (<%= @contract.draft_payments.count %>)</h3>
        <%= link_to manage_payments_contract_wizard_path(@contract), class: "text-sm text-pink-600 hover:text-pink-700" do %>
          Edit
        <% end %>
      </div>
      <% if @contract.draft_payments.any? %>
        <ul class="space-y-2 text-sm">
          <% @contract.draft_payments.each do |payment| %>
            <% incoming = payment["direction"] == "incoming" %>
            <li class="flex items-center justify-between gap-3">
              <span class="text-gray-700 min-w-0">
                <span class="text-[11px] uppercase tracking-wide font-semibold <%= incoming ? 'text-green-700' : 'text-red-700' %>">
                  <%= incoming ? "They pay us" : "We pay them" %>
                </span>
                ·
                <%= payment["description"].presence || "Payment" %>
                <span class="text-xs text-gray-500">
                  (due <%= Date.parse(payment["due_date"]).strftime("%b %d, %Y") rescue payment["due_date"] %>)
                </span>
              </span>
              <span class="font-medium flex-shrink-0 <%= payment["amount_tbd"] ? 'text-gray-400' : (incoming ? 'text-green-600' : 'text-red-600') %>">
                <% if payment["amount_tbd"] %>$TBD<% else %><%= incoming ? '+' : '-' %>$<%= '%.2f' % payment["amount"].to_f %><% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-gray-500">No payments scheduled</p>
      <% end %>
    </div>

    <%# Ticketing — only when we're the ones selling %>
    <% ticketing = @contract.draft_ticketing %>
    <% tiers = ticketing["tiers"] || [] %>
    <% discounts = Contract.ticketing_discounts(ticketing) %>
    <% if @contract.org_sells_tickets? || tiers.any? || discounts.any? %>
      <div class="border border-gray-200 rounded-lg p-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-medium text-gray-900">Ticketing</h3>
          <%= link_to manage_ticketing_contract_wizard_path(@contract), class: "text-sm text-pink-600 hover:text-pink-700" do %>
            Edit
          <% end %>
        </div>
        <% if tiers.any? %>
          <ul class="space-y-1 text-sm text-gray-700">
            <% tiers.each do |tier| %>
              <li class="flex items-center justify-between">
                <span><%= tier["name"] %></span>
                <span class="font-medium"><%= number_to_currency(tier["price"]) %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-amber-600">No ticket tiers set yet.</p>
        <% end %>
        <% discounts.each do |discount| %>
          <p class="text-sm text-gray-600 mt-2">
            Discount <span class="font-medium"><%= discount["code"] %></span>:
            <%= discount["amount_type"] == "percent" ? "#{discount["amount"]}% off" : "#{number_to_currency(discount["amount"])} off" %>
            <%= discount["applies_to"] == "specific" ? "(#{(discount["tier_names"] || []).join(", ")})" : "(all tickets)" %>
          </p>
        <% end %>
      </div>
    <% end %>

    <%# Services %>
    <% services = @contract.draft_services %>
    <% if services.any? %>
      <div class="border border-gray-200 rounded-lg p-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-medium text-gray-900">Services (<%= services.count %>)</h3>
          <%= link_to manage_tech_contract_wizard_path(@contract), class: "text-sm text-pink-600 hover:text-pink-700" do %>
            Edit
          <% end %>
        </div>
        <ul class="space-y-2 text-sm">
          <% services.each do |service| %>
            <% qty = service["quantity"].to_f %>
            <% total = (qty * service["unit_price"].to_f) %>
            <% incoming = (service["direction"].presence || "incoming") == "incoming" %>
            <li class="flex items-center justify-between gap-3">
              <span class="text-gray-700">
                <%= service["name"] %>
                <span class="text-xs text-gray-500">
                  <%= qty %><%= service["unit"] == "hourly" ? " hr" : "" %> × <%= number_to_currency(service["unit_price"]) %>
                </span>
              </span>
              <span class="font-medium <%= incoming ? 'text-green-600' : 'text-red-600' %>">
                <%= incoming ? "They pay us" : "We pay them" %> <%= number_to_currency(total) %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Contract Period %>
    <div class="border border-gray-200 rounded-lg p-4">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-medium text-gray-900">Contract Period</h3>
      </div>
      <% if @contract.contract_start_date.present? && @contract.contract_end_date.present? %>
        <p class="text-sm text-gray-700"><%= @contract.date_range %></p>
        <p class="text-xs text-gray-500 mt-1">Dates are based on your scheduled bookings</p>
      <% else %>
        <p class="text-sm text-gray-500">Dates will be set from bookings</p>
      <% end %>
    </div>
  </div>

  <%
    has_conflicts = @conflicts&.any?
    proceed_label = esign ? "Continue to prepare the contract" : "Activate Contract"
    proceed_icon  = esign ? "arrow-right" : "check-circle"
    proceed_url   = esign ? manage_save_review_contract_wizard_path(@contract) : manage_activate_contract_wizard_path(@contract)
  %>

  <%# Anchor so a submit that surfaces a fresh conflict scrolls straight to it. %>
  <div id="conflict-anchor" class="scroll-mt-24"></div>

  <div data-controller="modal" class="mt-8">
    <% if has_conflicts %>
      <%# Proactive conflict summary bar — click to open the calendar + choices. %>
      <button type="button"
              data-action="click->modal#open" data-modal-id="conflict-modal"
              class="w-full flex items-center gap-3 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-left hover:bg-amber-100 transition cursor-pointer mb-4">
        <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-700">
          <%= icon("alert-triangle", class: "w-5 h-5") %>
        </span>
        <span class="flex-1 min-w-0">
          <span class="block font-semibold text-amber-900">
            <%= pluralize(@conflicts.count, "scheduling conflict") %> on this contract
          </span>
          <span class="block text-sm text-amber-800">
            Part of this booking overlaps something already on your calendar. Review it and choose what to do.
          </span>
        </span>
        <span class="flex-shrink-0 text-sm font-medium text-amber-800 flex items-center gap-1">
          Review <%= icon("arrow-right", class: "w-4 h-4") %>
        </span>
      </button>
    <% end %>

    <div class="flex justify-between items-center">
      <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", icon: "arrow-left",
            path: esign ? manage_tech_contract_wizard_path(@contract) : manage_documents_contract_wizard_path(@contract) %>

      <div class="flex items-center gap-4">
        <% if !@valid_for_activation %>
          <%# Hard blocker (no bookings / missing dates) — nothing to override. %>
          <%= render "shared/button", text: proceed_label, variant: "primary", size: "large", icon: proceed_icon, type: :button, disabled: true %>
        <% elsif has_conflicts %>
          <%# Must resolve the conflict choice in the modal before proceeding. %>
          <%= render "shared/button", text: "Resolve conflict to continue", variant: "primary", size: "large",
                icon: "alert-triangle", type: :button,
                data: { action: "click->modal#open", modal_id: "conflict-modal" } %>
        <% else %>
          <%# Clear path — a plain in-form submit. %>
          <%= form_with url: proceed_url, method: :post, local: true, class: "inline" do %>
            <%= hidden_field_tag :allow_overlap, "0" %>
            <%= render "shared/button", text: proceed_label, variant: "primary", size: "large", icon: proceed_icon, type: :submit %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if has_conflicts %>
      <%= render "manage/contract_wizard/conflict_modal", conflicts: @conflicts, contract: @contract, esign: esign, proceed_url: proceed_url %>
    <% end %>
  </div>

  <% if has_conflicts && response.status == 422 %>
    <%# A fresh conflict surfaced on submit — bring it into view. %>
    <script>
      (function () {
        var anchor = document.getElementById("conflict-anchor");
        if (anchor) anchor.scrollIntoView({ behavior: "smooth", block: "center" });
      })();
    </script>
  <% end %>

  <%
    bookings = @contract.draft_bookings || []
    event_types_used = bookings.map { |b| b["event_type"] || "show" }.uniq
    event_type_configs = YAML.load_file(Rails.root.join("config/event_types.yml"))["event_types"]
  %>

  <div class="mt-4 p-4 bg-blue-50 border border-blue-200 rounded-lg">
    <div class="flex items-start">
      <%= icon("info", class: "w-5 h-5 text-blue-600 mt-0.5 mr-3") %>
      <div class="text-sm text-blue-800">
        <% if esign %>
          <p class="font-medium">What's next?</p>
          <ul class="mt-2 list-disc list-inside space-y-1">
            <li><strong>Prepare</strong> — pick your contract template and preview the full rendered contract with this data</li>
            <li><strong>Sign</strong> — you sign it as <%= @contract.organization.name %></li>
            <li><strong>Send</strong> — send it to <%= @contract.contractor_name %> to sign</li>
            <li>When they sign, the contract is executed and everything above is created automatically</li>
          </ul>
        <% else %>
          <p class="font-medium">What happens when you activate?</p>
          <ul class="mt-2 list-disc list-inside space-y-1">
            <li>Space rentals will be created and appear on your calendar</li>
            <li>Payment schedule will be set up with reminders</li>
            <% if bookings.any? %>
              <li>A third-party production will be created with <%= pluralize(bookings.count, "event") %>
                (<%= event_types_used.map { |t| event_type_configs.dig(t, "label") || t.titleize }.join(", ") %>)
              </li>
            <% end %>
            <li>You can still edit details after activation</li>
          </ul>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
