<% content_for :title, "Account Settings" %>

<div class="w-full" data-controller="account-email">
  <div id="notice-container">
    <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  </div>

  <%= render "shared/me_card", person: @person, line: Current.user.email_address,
        detail: "Member since #{Current.user.created_at.strftime('%B %Y')}" do %>
    <%= render "shared/button", text: "Change email", variant: "secondary", size: "small", type: :button, data: { action: "click->account-email#open" } %>
  <% end %>

  <%# Each setting is one row: what it is, a line about it, and its button. %>
  <% row_class = "flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3 sm:px-6" %>

  <%# The app hides the Account sidebar, so its other pages are rows here. %>
  <% if turbo_native_app? %>
    <nav class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-6 divide-y divide-gray-100" aria-label="Account">
      <%# Tap to Pay's setup and Apple's guide live here, for people who can
          sell with it (Apple 3.6, 4.3; Tim, 2026-10-19: never in the menu). %>
      <% [
        [ "Notifications", "On this phone, and by email", account_notifications_path ],
        ([ tap_to_pay_name, "Set it up on this #{tap_to_pay_phone}, and how to take a tap", door_tap_to_pay_path ] if native_tap_to_pay),
        [ "Profiles", "Your profiles and which one is the default", account_profiles_path ],
        [ "Organizations", "The organizations you're part of", account_organizations_path ]
      ].compact.each do |label, line, path| %>
        <%# Never wraps (unlike row_class, made for rows with buttons): the
            arrow stays on the right however long the line. %>
        <%= link_to path, class: "flex items-center justify-between gap-4 px-4 py-3 sm:px-6 hover:bg-gray-50 transition-colors" do %>
          <div class="min-w-0 flex-1">
            <div class="text-sm font-medium text-gray-900"><%= label %></div>
            <div class="text-sm text-gray-600"><%= line %></div>
          </div>
          <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-6">
    <%= render "shared/section_heading", title: "Sign-in and help", padding: "px-4 py-3 sm:px-6 sm:py-4" %>
    <div class="divide-y divide-gray-100">
      <div class="<%= row_class %>">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900">Password</div>
          <div class="text-sm text-gray-600">We'll email you a link to set a new one.</div>
        </div>
        <%= render "shared/button", text: "Reset password", path: password_path, variant: "secondary", size: "small" %>
      </div>
      <%# Where else you're signed in: browsers, the app, and API sign-ins.
          A new password signs them all out. %>
      <% others = @other_sessions.to_a %>
      <% app_sessions = @app_sessions.to_a %>
      <div class="<%= row_class %>">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900">Where you're signed in</div>
          <div class="text-sm text-gray-600">
            Here, on <%= Current.session.label %><% if others.any? || app_sessions.any? %>, and <%= pluralize(others.size + app_sessions.size, "other place") %><% end %>.
          </div>
        </div>
        <% if others.any? || app_sessions.any? %>
          <%= form_with url: sign_out_elsewhere_account_path, method: :delete, class: "inline" do %>
            <%= render "shared/button", text: "Sign out everywhere else", variant: "secondary", size: "small", type: :submit %>
          <% end %>
        <% end %>
      </div>
      <% others.first(10).each do |other| %>
        <div class="<%= row_class %>">
          <div class="min-w-0">
            <div class="text-sm text-gray-900"><%= other.label %></div>
            <div class="text-sm text-gray-600">Signed in <%= other.created_at.strftime("%b %-d, %Y") %></div>
          </div>
          <%= form_with url: sign_out_session_account_path(other), method: :delete, class: "inline" do %>
            <%= render "shared/button", text: "Sign out", variant: "secondary", size: "small", type: :submit %>
          <% end %>
        </div>
      <% end %>
      <% app_sessions.each do |app_session| %>
        <div class="<%= row_class %>">
          <div class="min-w-0">
            <div class="text-sm text-gray-900"><%= app_session.label %></div>
            <div class="text-sm text-gray-600">Signed in <%= app_session.created_at.strftime("%b %-d, %Y") %>, last used <%= app_session.last_used_at.strftime("%b %-d") %></div>
          </div>
          <%= form_with url: sign_out_app_account_path(app_session), method: :delete, class: "inline" do %>
            <%= render "shared/button", text: "Sign out", variant: "secondary", size: "small", type: :submit %>
          <% end %>
        </div>
      <% end %>
      <% if others.size > 10 %>
        <div class="px-4 py-2 sm:px-6 text-xs text-gray-500"><%= pluralize(others.size - 10, "older sign-in") %> not shown. Sign out everywhere else covers them too.</div>
      <% end %>
      <div class="<%= row_class %>">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900">Support</div>
          <div class="text-sm text-gray-600">Questions or feedback? We'd love to hear from you.</div>
        </div>
        <%= render "shared/button", text: "Email support", path: "mailto:support@cocoscout.com", variant: "secondary", size: "small" %>
      </div>
    </div>
  </div>

  <%# Delete my account: asked for right here, on the website or in the app
      (Apple requires the app to offer it); superadmins finish it within 30
      days, and it can be taken back until then. %>
  <div class="bg-white border border-red-200 rounded-xl overflow-hidden mb-6">
    <% if (requested_at = Current.user.deletion_requested_at) %>
      <div class="<%= row_class %>">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900">Deleting your account</div>
          <div class="text-sm text-gray-600">You asked on <%= requested_at.strftime("%B %-d") %>. It will be done within 30 days; until then, you can change your mind.</div>
        </div>
        <%= form_with url: cancel_deletion_account_path, method: :delete, class: "inline" do %>
          <%= render "shared/button", text: "Keep my account", variant: "secondary", size: "small", type: :submit %>
        <% end %>
      </div>
    <% else %>
      <% delete_cid = "confirm-delete-account" %>
      <div class="<%= row_class %>">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900">Delete your account</div>
          <div class="text-sm text-gray-600">Your account and profiles are deleted within 30 days.</div>
        </div>
        <%= render "shared/button", text: "Delete my account", variant: "secondary", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: delete_cid } %>
      </div>
      <%= render "shared/confirm_modal", id: delete_cid,
            title: "Delete your account?",
            message: "We'll delete your account and profiles within 30 days, and sign-ins will stop working. Payment and tax records the law requires are kept. You can change your mind here until it's done.",
            confirm_text: "Delete my account",
            url: request_deletion_account_path, method: :post %>
    <% end %>
  </div>

  <!-- Email Change Modal -->
  <div data-account-email-target="modal"
       data-action="click->account-email#close keydown.esc@window->account-email#close"
       class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-lg w-full" data-action="click->account-email#stopPropagation">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900 coustard-regular">Change Email Address</h2>
      </div>

      <form data-account-email-target="form" data-action="submit->account-email#submit">
        <div class="p-6 space-y-5">
          <!-- Warning Box -->
          <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
            <div class="flex gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
              </svg>
              <div class="text-sm text-amber-800">
                <p class="font-medium mb-1">Important: Changing your email affects your login</p>
                <ul class="list-disc list-inside space-y-1 text-amber-700">
                  <li>You'll use your new email to sign in</li>
                  <li>Password reset emails will go to your new address</li>
                  <li>Existing sessions will remain active</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Error Message -->
          <div data-account-email-target="errorMessage" class="hidden bg-red-50 border border-red-200 rounded-lg p-3 text-sm text-red-700"></div>

          <!-- Current Email -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Current Email</label>
            <div class="text-gray-900"><%= Current.user.email_address %></div>
          </div>

          <!-- New Email -->
          <div>
            <label for="new_email" class="block text-sm font-medium text-gray-700 mb-1">New Email Address</label>
            <input type="email"
                   id="new_email"
                   data-account-email-target="emailInput"
                   required
                   class="w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-pink-500 focus:ring-pink-500"
                   placeholder="your.new.email@example.com">
          </div>

          <!-- Profile Emails -->
          <% profiles_with_matching_email = Current.user.people.active.where(email: Current.user.email_address) %>
          <% if profiles_with_matching_email.any? %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Also update email on these profiles:</label>
              <div class="space-y-2">
                <% profiles_with_matching_email.each do |profile| %>
                  <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                    <input type="checkbox"
                           value="<%= profile.id %>"
                           checked
                           data-account-email-target="profileCheckbox"
                           class="h-4 w-4 rounded border-gray-300 text-pink-500 focus:ring-pink-500 accent-pink-500">
                    <span class="text-sm text-gray-900"><%= profile.name %></span>
                    <span class="text-xs text-gray-500">(<%= profile.email %>)</span>
                  </label>
                <% end %>
              </div>
              <p class="text-xs text-gray-500 mt-2">Uncheck any profiles you want to keep on the old email.</p>
            </div>
          <% end %>
        </div>

        <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-200 bg-gray-50">
          <%= render "shared/button", text: "Cancel", variant: "ghost-cancel", type: :button, data: { action: "click->account-email#close" } %>
          <%= render "shared/button", text: "Change Email", variant: "primary", type: :submit %>
        </div>
      </form>
    </div>
  </div>
</div>
