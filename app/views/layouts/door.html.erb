<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Door" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="robots" content="noindex">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# The door on show night: a phone-first page with nothing in the way.
      The header says where you are: the show you're working (with a way
      back to your shows), or your list of shows. It never sends a door
      volunteer off into the rest of CocoScout. %>
  <% person = Current.user&.person %>
  <% headshot = person&.safe_headshot_variant(:thumb) %>
  <body class="inter-regular text-slate-700 bg-gray-50">
    <header class="sticky top-0 z-10 border-b border-gray-200 bg-white" style="padding-top: env(safe-area-inset-top)">
      <div class="mx-auto max-w-2xl px-4 py-2.5 flex items-center gap-3 min-h-[3.5rem]">
        <% if content_for?(:door_header) %>
          <%= yield :door_header %>
        <% else %>
          <%= image_tag "/icon.svg", alt: "", class: "w-8 h-8 rounded-lg flex-shrink-0" %>
          <div class="min-w-0 flex-1">
            <div class="text-base font-semibold text-gray-900 leading-tight">Working the door</div>
            <div class="text-xs text-gray-500 truncate">CocoScout Tickets</div>
          </div>
        <% end %>
        <% if person %>
          <span class="flex-shrink-0" title="Signed in as <%= person.name %>">
            <% if headshot %>
              <%= image_tag headshot, alt: person.name, class: "w-8 h-8 rounded-lg object-cover" %>
            <% else %>
              <span class="w-8 h-8 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-xs"><%= person.initials %></span>
            <% end %>
          </span>
        <% end %>
      </div>
    </header>
    <main class="mx-auto max-w-2xl px-4 py-5">
      <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
      <%= yield %>
    </main>
  </body>
</html>
