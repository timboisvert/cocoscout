<%# My usual week: pick the days, give them one answer. Opened fresh from the
    button ("never on Sundays"), or on a line of the usual week with its days
    and answer filled in. Locals: day_parts, onboarding, month. %>
<%= render layout: "my/work_availability/sheet_frame", locals: { target: "weekSheet", title: "My usual week" } do %>
  <%= form_with url: my_work_availability_path(onboarding: onboarding), method: :post,
        data: { action: "submit->work-availability#validate" } do %>
    <input type="hidden" name="scope" value="week">
    <input type="hidden" name="month" value="<%= month.iso8601 %>">

    <div class="px-5 py-5 space-y-5">
      <div>
        <p class="text-sm font-medium text-gray-900 mb-2">Every week, on</p>
        <div class="grid grid-cols-7 gap-1">
          <% WorkAvailabilityPicture::WEEK_ORDER.each do |wday| %>
            <label class="flex items-center justify-center rounded-lg border border-gray-300 bg-white py-2 text-xs font-medium text-gray-700 cursor-pointer transition-colors hover:border-pink-300 focus-within:ring-2 focus-within:ring-pink-500 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 has-[:checked]:text-pink-700">
              <input type="checkbox" name="days[]" value="<%= wday %>" data-day-checkbox
                     class="sr-only h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
              <%= Date::ABBR_DAYNAMES[wday] %>
            </label>
          <% end %>
        </div>
        <p data-days-error class="hidden mt-1 text-xs text-red-600"></p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-900 mb-2">Can you work?</p>
        <%= render "my/work_availability/answer_fields", day_parts: day_parts %>
      </div>
    </div>

    <div class="px-5 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
      <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button,
            data: { action: "click->work-availability#closeSheets" } %>
      <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>
