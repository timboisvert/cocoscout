<% content_for :title, "#{@show.display_name} · #{@show.date_and_time.strftime("%a, %b %-d")} · Settings" %>

<%
  location_spaces_map = Current.organization.locations.pickable(@show.location_id).includes(:location_spaces).each_with_object({}) { |l, h| h[l.id] = l.location_spaces.map { |s| { id: s.id, name: s.name } } }
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  when_words = @show.date_and_time.strftime("%a, %b %-d · %-l:%M %p")
  # Each section, the heading it sits under in the side list and the phone's
  # sheet (SectionNavHelper#section_groups), and whether it has fields to save (Linked Events and the Danger
  # Zone act through their own buttons and modals).
  edit_tabs = [
    { label: "Basic Information", group: "Details", partial: "tab_details" },
    { label: "Schedule", group: "Details", partial: "tab_schedule" },
    { label: "Location", group: "Details", partial: "tab_location" },
    { label: "Casting & Visibility", group: "Public", partial: "tab_visibility" },
    { label: "Visual Assets", group: "Public", partial: "tab_media" },
    { label: "Tickets", group: "Business", partial: "tab_tickets", pro: true, locked: !@production.organization.feature_available?(:ticketing) },
    # What this show needs (after-V1 #6): Pro and the managers', and no tab at
    # all otherwise. Sits at ProductionsHelper::SHOW_SERVICES_TAB.
    ({ label: "Services", group: "Business", partial: "tab_services", pro: true } if @production.organization.services_available_to?(Current.user)),
    { label: "Linked Events", group: "Details", partial: "tab_linked", save: false },
    { label: "Danger Zone", partial: "tab_danger", danger: true, save: false }
  ].compact
  # A date that follows another organization's contract date (LinkedDates):
  # its time, place, tickets and whether it exists are theirs. Those tabs
  # stay where they are and say so.
  if @show.follows_contract?
    edit_tabs.each do |tab|
      next unless tab[:partial].in?(%w[tab_schedule tab_location tab_tickets tab_danger])

      tab.merge!(partial: "tab_follows_contract", save: false, locked: false, danger: false)
    end
  end
%>
<div class="w-full mb-10" data-controller="location-modal tabs" data-tabs-plain-value="true"
     data-location-modal-event-type-value="<%= @show.event_type&.titleize&.downcase || 'event' %>" data-location-modal-spaces-value="<%= location_spaces_map.to_json %>">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      [ "Shows & Events", manage_shows_path ],
      [ @production.name, manage_production_shows_path(@production) ],
      [ when_words, manage_show_path(@production, @show) ]
    ],
    text: "Settings",
    links: []
  } %>

  <%= form_with(model: [ :manage, @production, @show ], class: "contents", data: { controller: "show-edit", "show-edit-casting-defaults-value": (@production.casts_people? ? @production.casting_event_types : []).to_json }) do |form| %>
    <%# One event of a series: say so once, above every tab, with the one
        switch that sends a save to all of them. %>
    <% if @show.recurring? %>
      <% series = @show.recurrence_group.order(:date_and_time) %>
      <div class="mb-5 rounded-lg border border-pink-200 bg-pink-50 px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <div class="text-sm text-pink-900">
          <span class="font-semibold">One of <%= pluralize(series.count, "event") %> in a series</span>,
          <%= series.first.date_and_time.strftime("%b %-d") %> to <%= series.last.date_and_time.strftime("%b %-d, %Y") %>.
          Saving changes only this one unless you switch this on.
        </div>
        <div class="flex items-center gap-2 text-sm font-medium text-pink-900">
          <span>Save to all <%= series.count %></span>
          <%= render "shared/toggle_switch", form: form, field: :recurrence_edit_scope, checked: false, checked_value: "all", unchecked_value: "this" %>
        </div>
      </div>
    <% end %>

    <%# Phone: the section row and its sheet, as on every settings page
        (shared/section_picker); Save pins to the bottom. %>
    <% edit_sections = edit_tabs.each_with_index.map { |tab, i|
         { label: tab[:label], index: i, active: i.zero?, danger: tab[:danger], pro: tab[:pro], locked: tab[:locked], group: tab[:group] }
       } %>
    <div data-show-edit-sections>
      <%= render "shared/section_picker", id: "show-edit-sections-sheet", list_from: "md", sections: edit_sections %>
    </div>

    <%# From md up: the sections down the left (shared/section_list), the
        section showing beside them. %>
    <div class="md:flex md:items-start md:gap-8">
    <%= render "shared/section_list", sections: edit_sections %>
    <div class="flex-1 min-w-0">

    <% edit_tabs.each_with_index do |tab, i| %>
      <div data-tabs-target="panel" class="space-y-6 <%= 'hidden' unless i.zero? %>">
        <%= render "manage/shows/edit/#{tab[:partial]}", form: form, input_class: input_class, location_spaces_map: location_spaces_map %>
        <% unless tab[:save] == false || tab[:locked] %>
          <%= render layout: "shared/sticky_actions" do %>
            <%= render "shared/button", text: "Save Changes", variant: "primary", size: "medium", type: :submit %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    </div>
    </div>
  <% end %>

  <%= render "manage/shows/edit/move_modal" %>
  <%= render "manage/shows/edit/location_modal" %>
  <%= render "manage/shows/edit/danger_modals" %>
</div>

<%# Turbo frame for the recurring series modal %>
<%= turbo_frame_tag "recurring_series_modal" %>
