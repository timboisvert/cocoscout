<%#
  Shown when the selected window hides all outstanding money (there's still money
  owed, just further out). Locals: show_all_path.
%>
<%= render "shared/empty_state", icon: "clock", title: "Nothing due in the #{@window_end ? "next #{@window_label.downcase}" : "selected window"}",
      body: "You're owed #{number_to_currency(@total_outstanding)} further out.",
      actions: [ { text: "Show all upcoming", path: show_all_path, variant: "secondary" } ] %>
