<%# Slim per-show revenue rows for one production, loaded lazily into the accordion
    on the all-productions financials list. If the production is governed by a
    contract, a small contract bar sits at the top. %>
<%= turbo_frame_tag "prod-events-#{@production.id}" do %>
  <% if @contract %>
    <%= render "manage/money_financials/contract_bar", contract: @contract %>
  <% end %>
  <%= render "manage/money_financials/event_rows", shows: @shows, href_data: { turbo_frame: "_top" } %>
<% end %>
