<%# Who's on a contract (contract people, docs/contract_people_plan.md): the
    list so far, and adding someone, search first (invite-search), the invite
    form only after a search finds nobody. Used by the wizard's People step
    and by Amend → Change who's on it.
    Locals:
      rows        [{ name:, detail:, badge: (optional), remove_params: (hash, or nil when they can't be removed) }]
      add_url     where the add form posts (person_id, or name + email)
      remove_url  where Remove posts (DELETE, with remove_params)
      empty_words what the empty list says
      question    the search label
      invite_blurb one sentence on what an invitation gives them %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  initials = ->(name) { name.to_s.split.first(2).map { |w| w[0] }.join.upcase.presence || "?" }
%>
<div class="border border-gray-200 rounded-lg overflow-hidden mb-6" data-people-list>
  <% if rows.empty? %>
    <p class="px-5 py-5 text-sm text-gray-500"><%= empty_words %></p>
  <% else %>
    <ul class="divide-y divide-gray-100">
      <% rows.each do |row| %>
        <li class="flex flex-wrap items-center gap-3 px-5 py-3">
          <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-sm flex-shrink-0"><%= initials.call(row[:name]) %></div>
          <div class="min-w-[9rem] flex-1">
            <div class="text-sm font-medium text-gray-900 truncate"><%= row[:name] %></div>
            <div class="text-xs text-gray-500 truncate"><%= row[:detail] %></div>
          </div>
          <% if row[:badge].present? %>
            <span class="inline-flex items-center rounded-md bg-pink-50 border border-pink-200 px-1.5 py-0.5 text-[11px] font-medium text-pink-700"><%= row[:badge] %></span>
          <% end %>
          <% if row[:remove_params] %>
            <%= button_to remove_url, method: :delete, params: row[:remove_params], class: "inline" do %>
              <%= render "shared/button", text: "Remove", variant: "secondary", size: "small", type: :submit %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

<div class="border border-gray-200 rounded-lg overflow-hidden mb-6"
     data-controller="invite-search" data-invite-search-url-value="<%= search_for_invite_manage_people_path(mode: "link") %>">
  <div class="px-5 py-4" data-invite-search-target="searchSection">
    <label for="people-search" class="block text-sm font-medium text-gray-900 mb-1.5"><%= question %> <span class="font-normal text-gray-500">Find them by name or email</span></label>
    <input id="people-search" type="search" autocomplete="off" placeholder="Name or email" class="<%= input_class %>"
           data-invite-search-target="input" data-action="input->invite-search#search">
    <div class="mt-3" data-invite-search-target="results"></div>
  </div>

  <%= form_with url: add_url, method: :post, class: "hidden", data: { invite_search_target: "inviteForm" } do %>
    <%= hidden_field_tag :person_id, nil, data: { invite_search_target: "selectedPersonIdInput" } %>
    <div class="hidden px-5 pt-4 flex items-center justify-between gap-3" data-invite-search-target="selectedPerson">
      <div class="min-w-0">
        <div class="text-sm font-medium text-gray-900 truncate" data-invite-search-target="selectedPersonName"></div>
        <div class="text-xs text-gray-500 truncate" data-invite-search-target="selectedPersonEmail"></div>
      </div>
      <%= render "shared/button", text: "Choose someone else", variant: "ghost", size: "small", type: :button, data: { action: "click->invite-search#backToSearch" } %>
    </div>
    <div class="px-5 pt-4 space-y-3" data-invite-search-target="personDetailsSection">
      <p class="text-sm text-gray-700">No one on CocoScout has that address. Invite them: <%= invite_blurb %></p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="people_invite_name" class="block text-sm font-medium text-gray-700 mb-1.5">Name</label>
          <%= text_field_tag :name, nil, id: "people_invite_name", placeholder: "Their name", class: input_class, data: { invite_search_target: "inviteName" } %>
        </div>
        <div>
          <label for="people_invite_email" class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
          <%= email_field_tag :email, nil, id: "people_invite_email", class: input_class, data: { invite_search_target: "inviteEmail" } %>
        </div>
      </div>
      <%= render "shared/button", text: "Choose someone else", variant: "ghost", size: "small", type: :button, data: { action: "click->invite-search#backToSearch" } %>
    </div>
    <div class="px-5 py-4 border-t border-gray-200 bg-gray-50">
      <div data-invite-search-target="pickSubmit">
        <%= render "shared/button", text: "Add to the contract", variant: "primary", size: "small", type: :submit %>
      </div>
      <div class="hidden" data-invite-search-target="inviteSubmit">
        <%= render "shared/button", text: "Invite and add to the contract", variant: "primary", size: "small", type: :submit %>
      </div>
    </div>
  <% end %>
</div>
