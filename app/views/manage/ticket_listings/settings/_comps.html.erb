<%# This date's own comp rules, or (switch off) the ones it follows: its
    production's own, else the box office's (CompRules). Locals: listing, setup. %>
<%
  own = listing.own_comps
  followed = setup&.own_comps ? setup : ticketing_profile
  followed_name = setup&.own_comps ? possessive(listing.production.name) : "Your box office's"
  rules = own ? listing : followed
  example = own ? comp_rules_sentence(listing, subject: "this date", single: true) : nil
%>
<%= form_with url: manage_ticket_listing_path(listing, section: "comps"), method: :patch, class: "space-y-6" do %>
  <div class="space-y-4" data-controller="fieldset-toggle">
    <div class="rounded-lg border border-pink-200 bg-pink-50 px-5 py-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
      <p class="text-sm text-pink-900 min-w-0 flex-1">
        <span class="font-medium"><%= followed_name %> rules:</span> <%= followed.comp_rules_words %>. Switch on to give this date its own.
      </p>
      <label class="flex items-center gap-3 text-sm font-medium text-gray-900 whitespace-nowrap">
        This date's own rules
        <%= render "shared/toggle_switch", name: "ticket_listing[own_comps]", checked: own, hidden_false: true,
              id: "ticket_listing_own_comps", aria_label: "This date's own comp rules",
              data: { fieldset_toggle_target: "switch", action: "change->fieldset-toggle#toggle" } %>
      </label>
    </div>
    <fieldset <%= "disabled" unless own %> data-fieldset-toggle-target="fields" class="disabled:opacity-50">
      <%= render "manage/ticketing_settings/comp_rules_fields", scope: "ticket_listing", rules: rules,
            off_words: "Off, nobody gives comps on this date.", example: example %>
    </fieldset>
  </div>

  <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
<% end %>
