<%# Danger Zone tab, triggers only. The form-bearing modals are rendered
   outside the edit form (see edit/_danger_modals), opened here by id. %>
<% event_label = @show.event_type.titleize %>
<div class="space-y-4">
  <%# Move %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden [&>div:last-child]:border-b-0">
    <%= render "shared/section_heading", title: "Move to another production",
          intro: "Move this #{@show.event_type} to a different production you have access to. Assignments and vacancies move with it." do %>
      <%= render "shared/button", text: "Move #{event_label}", variant: "secondary", size: "small", type: :button,
            data: { action: "show-edit#openMoveModal" } %>
    <% end %>
  </div>

  <% if @show.canceled %>
    <%# Bring back (Cancel or move this date, Tim 2026-11-27) %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden [&>div:last-child]:border-b-0">
      <%= render "shared/section_heading", title: "Bring this date back",
            intro: "It's canceled. Bring it back, and choose who hears about it." do %>
        <%= render "shared/button", text: "Bring this date back", variant: "secondary", size: "small", path: manage_new_date_restore_path(@production, @show) %>
      <% end %>
    </div>
  <% else %>
    <%# Cancel or move (Cancel or move this date, Tim 2026-11-27) %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden [&>div:last-child]:border-b-0">
      <%= render "shared/section_heading", title: "Cancel or move this date",
            intro: "Cancel it, move it to a new date, time, or place, and CocoScout takes care of everyone it touches." do %>
        <%= render "shared/button", text: "Cancel or move this date", variant: "primary", size: "small", path: manage_new_date_change_path(@production, @show) %>
      <% end %>
    </div>
  <% end %>

  <%# Delete, for a date entered by mistake %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden [&>div:last-child]:border-b-0">
    <%= render "shared/section_heading", title: "Delete this date",
          intro: "For a date entered by mistake, that nobody ever counted on. It comes off your calendar as if it had never been entered." do %>
      <%= render "shared/button", text: "Delete this date", variant: "primary", size: "small", type: :button,
            data: { controller: "modal", action: "click->modal#open", modal_id: "delete-date-#{@show.id}" } %>
    <% end %>
  </div>
</div>
