<%
  # The same rows the contract page draws (Contract#payment_schedule_groups):
  # a charge settled by deduction (Booth Tech) sits under the settlement it
  # comes out of, never as money to collect (Tim, 2026-10-10).
  payments = @show_contract_payments || []
  groups = @contract ? @contract.payment_schedule_groups(payments) : payments.map { |p| { payment: p, deductions: [] } }
  waiting = groups.select { |g| g[:payment].status_pending? && !g[:payment].amount_tbd? }
  # What a settlement hands over: its amount less every charge netted out of
  # it, whether still waiting or already taken out on its run.
  net_out = waiting.select { |g| g[:payment].direction_outgoing? }.sum do |g|
    g[:payment].amount.to_f - g[:deductions].sum { |d| d.amount.to_f }
  end
  owed_total = [ net_out, 0 ].max
  due_to_us_total = waiting.select { |g| g[:payment].direction_incoming? }.sum { |g| g[:payment].amount.to_f } + [ -net_out, 0 ].max
%>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-200">
        <h3 class="font-semibold text-gray-900">Contract payments for this show</h3>
        <p class="text-sm text-gray-500 mt-0.5">
          This show is settled on its contract<% if @contract %> with <strong><%= @contract.contractor_name %></strong><% end %>, the same as on the contract's page. No casting or payout calculation needed.
        </p>
      </div>
      <div class="p-4">
        <% if groups.any? %>
          <div class="space-y-2">
            <% groups.each do |group| %>
              <%= render "manage/contracts/contract_payment_row", payment: group[:payment], deductions: group[:deductions] %>
            <% end %>
          </div>
        <% else %>
          <p class="py-4 text-center text-sm text-gray-500">No contract payments for this show yet.</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="space-y-4">
    <div class="bg-white rounded-lg border border-gray-200 p-5">
      <div class="text-sm text-gray-500">Still to pay for this show</div>
      <div class="text-2xl font-bold text-gray-900 mt-1"><%= number_to_currency(owed_total) %></div>
      <p class="text-xs text-gray-500 mt-2">Add each contractor to your payout run to pay them to their bank, alongside your performers.</p>
    </div>

    <% if due_to_us_total > 0 %>
      <div class="bg-white rounded-lg border border-gray-200 p-5">
        <div class="text-sm text-gray-500">Still owed to you for this show</div>
        <div class="text-2xl font-bold text-gray-900 mt-1"><%= number_to_currency(due_to_us_total) %></div>
        <p class="text-xs text-gray-500 mt-2">Charges taken out of their share are already netted above.</p>
      </div>
    <% end %>

    <% if @contract %>
      <%= link_to manage_contract_path(@contract), class: "block bg-white rounded-lg border border-gray-200 p-4 hover:border-gray-300 transition-colors" do %>
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-gray-900">View full contract</span>
          <%= icon("arrow-right", class: "w-4 h-4 text-gray-400") %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
