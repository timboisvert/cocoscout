<% content_for :title, "Square" %>
<%
  integration = @integration
  connected = integration&.connected?
  input = "block w-full px-3 py-2 bg-white border border-gray-300 rounded-lg shadow-sm text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
  check = "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500"
  money = ->(cents) { number_to_currency(cents / 100.0) }
  links = []
  if connected
    links << { text: "Pull now", path: manage_pull_organization_square_path(@organization), method: :post }
  end
%>
<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Organizations", manage_organizations_path ], [ @organization.name, manage_organization_path(@organization) ], [ "Integrations", section_manage_organization_path(@organization, section: "integrations") ] ],
    text: "Square",
    links: links
  } %>

  <% unless connected %>
    <div class="max-w-2xl rounded-xl border border-gray-200 bg-white p-6 space-y-4">
      <div class="flex items-center gap-3">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-gray-900 text-sm font-bold text-white">Sq</span>
        <div>
          <div class="font-semibold text-gray-900">Connect Square</div>
          <div class="text-sm text-gray-600">Bar, food and merch sales, tips, sales tax and fees, onto the day's worksheet.</div>
        </div>
      </div>
      <p class="text-sm text-gray-700">You sign in on Square's own page and choose to let CocoScout read your orders, payments, refunds and locations. CocoScout cannot change anything in Square, never sees your Square password, and you can disconnect here any time.</p>
      <ul class="text-sm text-gray-700 space-y-1 list-disc pl-5">
        <li>Every morning at 5 am, the night before is pulled in; during the night, Square tells us as orders close.</li>
        <li>Which day a 12:15 am round belongs to follows your <%= link_to "Settle up setting", manage_money_settings_section_path(section: "settle_up"), class: "text-pink-600 hover:text-pink-700" %>.</li>
        <li>Nothing reaches the books until someone checks the day and settles it.</li>
      </ul>
      <% if (problem = SquareApi.setup_problem) %>
        <p class="text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2"><%= problem %></p>
      <% else %>
        <%= form_with url: manage_connect_organization_square_path(@organization), method: :post, data: { turbo: false } do %>
          <%= render "shared/button", text: "Connect with Square", variant: "primary", size: "medium", type: :submit %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border <%= integration.status == 'error' ? 'border-amber-200 bg-amber-50' : 'border-green-200 bg-green-50' %> px-5 py-4 mb-5 flex flex-wrap items-start gap-4">
      <span class="inline-flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-gray-900 text-sm font-bold text-white">Sq</span>
      <div class="flex-1 min-w-[16rem] text-sm text-gray-800">
        <b>Connected</b><% if integration.merchant_name %> as <%= integration.merchant_name %><% end %><% if integration.connected_by %>, by <%= integration.connected_by.default_person&.name || integration.connected_by.email_address %><% end %><% if integration.connected_at %> on <%= integration.connected_at.strftime("%b %-d, %Y") %><% end %>, through Square's own sign-in. CocoScout can read orders, payments, refunds and locations; it cannot change anything in Square.
        <% if integration.status == "error" %><div class="mt-1 text-amber-900">The last pull did not finish: <%= integration.last_error %></div><% end %>
      </div>
      <div class="text-xs text-gray-600 sm:text-right">
        <% if integration.last_synced_at %>Last pull <%= integration.last_synced_at.strftime("%-l:%M %P, %b %-d") %><% else %>No pull finished yet<% end %>
      </div>
    </div>

    <%= form_with url: manage_organization_square_path(@organization), method: :patch, data: { turbo: false } do %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <section class="rounded-xl border border-gray-200 bg-white overflow-hidden">
          <%= render "shared/section_heading", padding: "px-5 py-3", title: "Locations" %>
          <div class="px-5 py-4 space-y-3">
            <p class="text-sm text-gray-600">Each location on your Square account, and which of ours it is. A day's sales land on the worksheet for that day.</p>
            <% if integration.external_locations.empty? %>
              <p class="text-sm text-gray-500">No locations read yet. Pull now brings them in.</p>
            <% end %>
            <% integration.external_locations.each do |loc| %>
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <span class="text-sm"><b class="font-medium text-gray-900"><%= loc["name"] %></b><% if loc["address"].present? %> <span class="text-gray-500"><%= loc["address"] %></span><% end %></span>
                <%= select_tag "location_map[#{loc['id']}]", options_for_select([ [ "Choose one", "" ] ] + @locations.map { |l| [ l.name, l.id.to_s ] } + [ [ "Not ours, skip it", Integration::SKIP ] ], integration.location_map[loc["id"]].to_s), class: "#{input} sm:w-64" %>
              </div>
            <% end %>
            <p class="text-xs text-gray-500">Which day an order belongs to follows your <%= link_to "Settle up setting", manage_money_settings_section_path(section: "settle_up"), class: "text-pink-600 hover:text-pink-700" %>: when things stop, so a 12:15 am round is Friday's, not Saturday's.</p>
          </div>
        </section>

        <section class="rounded-xl border border-gray-200 bg-white overflow-hidden">
          <%= render "shared/section_heading", padding: "px-5 py-3", title: "What Square's categories are to us" %>
          <div class="px-5 py-4 space-y-3">
            <p class="text-sm text-gray-600">Square's item categories, each mapped to one of our money-in categories. New ones show up here as Other until you say.</p>
            <% if integration.external_categories.empty? %>
              <p class="text-sm text-gray-500">No categories read yet.</p>
            <% end %>
            <% integration.external_categories.each do |cat| %>
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm text-gray-900"><%= cat["name"] %><% if cat["first_seen_on"].present? && Date.parse(cat["first_seen_on"]) > 14.days.ago.to_date %> <span class="text-xs text-pink-600">new since <%= Date.parse(cat["first_seen_on"]).strftime("%b %-d") %></span><% end %></span>
                <%= select_tag "category_map[#{cat['id']}]", options_for_select(Integration::REGISTER_CATEGORIES.map { |k, v| [ v, k ] }, integration.our_category(cat["id"])), class: "#{input} w-40" %>
              </div>
            <% end %>
          </div>
        </section>

        <section class="rounded-xl border border-gray-200 bg-white overflow-hidden">
          <%= render "shared/section_heading", padding: "px-5 py-3", title: "What comes in, and when" %>
          <div class="px-5 py-4 space-y-3">
            <% Integration::BRINGS.each do |key, (label, note)| %>
              <label class="flex items-start gap-3 text-sm">
                <%= check_box_tag "brings[#{key}]", "1", integration.brings?(key), class: "#{check} mt-0.5" %>
                <span><b class="font-medium text-gray-900"><%= label %></b> <span class="text-gray-500"><%= note %></span></span>
              </label>
            <% end %>
            <p class="text-xs text-gray-500">Every morning at 5 am for the night before, and during the night as Square tells us orders closed, so the day is filling in before anyone looks. Pull now re-reads the last 7 days. Nothing reaches the books until the day is settled.</p>
          </div>
        </section>

        <section class="rounded-xl border border-gray-200 bg-white overflow-hidden">
          <%= render "shared/section_heading", padding: "px-5 py-3", title: "Pulls" %>
          <% if @pulls.empty? %>
            <p class="px-5 py-4 text-sm text-gray-500">Nothing pulled yet.</p>
          <% else %>
            <ul class="divide-y divide-gray-100">
              <% @pulls.each do |pull| %>
                <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 py-2.5 text-sm">
                  <span class="w-36 text-gray-500 tabular-nums"><%= pull.started_at.strftime("%b %-d, %-l:%M %P") %></span>
                  <span class="flex-1 text-gray-900"><%= pull.what %></span>
                  <span class="text-xs font-medium <%= pull.done? ? 'text-green-700' : (pull.failed? ? 'text-amber-700' : 'text-gray-500') %>"><%= pull.done? ? "Done" : (pull.failed? ? "Did not finish" : "Running") %></span>
                </li>
              <% end %>
            </ul>
          <% end %>
        </section>
      </div>

      <% if @recent_days.any? %>
        <section class="mt-4 rounded-xl border border-gray-200 bg-white overflow-hidden">
          <%= render "shared/section_heading", padding: "px-5 py-3", title: "The last days read" %>
          <ul class="divide-y divide-gray-100">
            <% @recent_days.each do |day| %>
              <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 py-2.5 text-sm">
                <span class="w-28 text-gray-500 tabular-nums"><%= day.business_date.strftime("%b %-d, %Y") %></span>
                <span class="flex-1 text-gray-900"><%= day.location_name %> · <%= pluralize(day.orders_count, "order") %></span>
                <span class="tabular-nums text-gray-900"><%= money.call(day.gross_cents) %> sold</span>
                <%= link_to "The day", manage_money_settle_up_day_path(day.business_date.iso8601), class: "text-pink-600 hover:text-pink-700" %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <%= render "shared/button", text: "Disconnect", variant: "secondary", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-disconnect-square" } %>
        <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
    <%= render "shared/confirm_modal", id: "confirm-disconnect-square",
          title: "Disconnect Square?",
          message: "CocoScout stops reading from Square. What it already brought in stays on the days it belongs to.",
          confirm_text: "Disconnect",
          url: manage_organization_square_path(@organization), method: :delete %>
  <% end %>
</div>
