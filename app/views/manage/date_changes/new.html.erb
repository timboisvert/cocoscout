<% content_for :title, "Cancel or move this date" %>
<%#
  Step 1 of Cancel or move this date (Tim, 2026-11-27): the date, what's on
  it, and what to do with it: cancel it, move it, or delete it (only for a
  date entered by mistake, that nobody counted on).
%>
<%
  day = @show.date_and_time.strftime("%A, %B %-d")
  name = @show.display_name.presence || @production.name
  later = @following.size - 1
  can_delete = @delete_blockers.empty?
  option = ->(value, title, words, disabled: false) {
    tag.label(class: "flex gap-3 rounded-xl border px-4 py-4 #{disabled ? 'border-gray-200 bg-gray-50 cursor-not-allowed' : 'border-gray-200 bg-white cursor-pointer has-[input:checked]:border-pink-500 has-[input:checked]:bg-pink-50 has-[input:checked]:ring-1 has-[input:checked]:ring-pink-500'}") do
      safe_join([
        radio_button_tag(:kind, value, @kind == value && !disabled, disabled: disabled, class: "mt-1 h-4 w-4 shrink-0 accent-pink-500 text-pink-600 focus:ring-pink-500"),
        tag.span(class: "min-w-0") { safe_join([ tag.span(title, class: "block text-base font-semibold #{disabled ? 'text-gray-500' : 'text-gray-900'}"), tag.span(words, class: "block mt-1 text-sm #{disabled ? 'text-gray-500' : 'text-gray-600'} leading-relaxed") ]) }
      ])
    end
  }
%>
<div class="w-full mb-10">
  <%= render "manage/date_changes/header", show: @show, production: @production, title: "Cancel or move this date", index: 0, kind: @kind %>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <%= form_with url: manage_create_date_change_path(@production, @show), method: :post, class: "space-y-6" do %>
      <div class="bg-white border border-gray-200 rounded-xl px-6 py-5 max-sm:px-4">
        <h2 class="text-xl font-semibold text-gray-900 coustard-regular"><%= name %></h2>
        <p class="mt-1 text-sm text-gray-700"><%= day %>, <%= @show.date_and_time.strftime("%-l:%M %p").strip %><%= " · #{@show.location_space&.name || @show.location&.name}" if @show.location %></p>
        <% if @show.recurring? %>
          <p class="mt-1 text-sm text-gray-500">
            Part of a series of <%= @series.size %> dates, <%= @series.first.date_and_time.strftime("%b %-d") %> to <%= @series.last.date_and_time.strftime("%b %-d") %><%= later.positive? ? " · #{later} still to come after this one" : "" %>
          </p>
        <% end %>
        <div class="mt-3 flex flex-wrap gap-2 text-xs">
          <% chips = [] %>
          <% chips << "#{@facts.tickets} #{@facts.tickets == 1 ? 'ticket' : 'tickets'} sold" if @facts&.tickets.to_i.positive? %>
          <% chips << "#{@facts.cast} cast" if @facts&.cast.to_i.positive? %>
          <% chips << "#{@facts.shifts} #{@facts.shifts == 1 ? 'shift' : 'shifts'}" if @facts&.shifts.to_i.positive? %>
          <% chips << "#{@facts.signups} #{@facts.signups == 1 ? 'sign-up' : 'sign-ups'}" if @facts&.signups.to_i.positive? %>
          <% @linked.each { |l| chips << "Linked: #{l.display_name.presence || l.production.name}, #{l.date_and_time.strftime('%-l:%M %p').strip}" } %>
          <% chips.each do |chip| %>
            <span class="rounded-full bg-gray-100 text-gray-700 px-2.5 py-1"><%= chip %></span>
          <% end %>
        </div>
      </div>

      <fieldset class="space-y-3">
        <legend class="text-lg font-semibold text-gray-900 mb-3">What would you like to do with <%= day %>?</legend>
        <%= option.call("cancel", "Cancel it", "It isn't going to happen. It stays on your calendar as Canceled, and CocoScout takes care of the buyers, the cast, the staff, and the money.") %>
        <%= option.call("move", "Move it", "It's still happening, at a new date, time, or place. It keeps everything on it, and everyone who needs to know is notified.") %>
        <% if can_delete %>
          <%= option.call("delete", "Delete it", "For a date entered by mistake, that nobody ever counted on. It comes off your calendar as if it had never been entered.") %>
        <% else %>
          <%= option.call("delete", "Delete it", "For a date entered by mistake, that nobody ever counted on. This one has #{@delete_blockers.to_sentence}, so it really existed. Cancel it instead.", disabled: true) %>
        <% end %>
      </fieldset>

      <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3 max-sm:sticky max-sm:bottom-0 max-sm:-mx-4 max-sm:px-4 max-sm:py-3 max-sm:bg-white max-sm:border-t max-sm:border-gray-200">
        <%= link_to manage_show_path(@production, @show), class: "max-sm:w-full" do %>
          <%= render "shared/button", text: "Keep it as it is", variant: "secondary", size: "medium", type: :button, classes: "w-full" %>
        <% end %>
        <%= render "shared/button", text: "Continue", variant: "primary", size: "medium", type: :submit, classes: "max-sm:w-full" %>
      </div>
    <% end %>

    <aside class="hidden lg:block text-sm text-gray-600 space-y-3">
      <div class="bg-white border border-gray-200 rounded-xl px-5 py-4">
        <p class="font-semibold text-gray-900 mb-1">Nothing changes yet</p>
        <p>You'll choose which dates, then see everything it touches and what CocoScout will do about each. Nothing happens until you confirm on the last step.</p>
      </div>
    </aside>
  </div>

  <%= render "manage/date_changes/delete_modals", show: @show, production: @production, series: @series, following: @following,
        blockers: @delete_blockers, open: params[:delete].present? %>
</div>
