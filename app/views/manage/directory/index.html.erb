<% content_for :title, "Contacts" %>

<%
  directory_actions = [
    ({ icon: "user-plus", text: "Invite People", description: "Add new performers or staff", path: new_manage_person_path } if Current.user&.manager?),
    { icon: "clipboard-list", text: "Questionnaires", description: "Create and manage questionnaires", path: manage_contacts_questionnaires_path }
  ].compact

%>

<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%= render "shared/module_header",
    title: "Contacts",
    actions: directory_actions
  %>

  <%
    contacts_guide_body = <<~HTML.html_safe
      <p>Contacts is your whole company in one directory:</p>
      <ol>
        <li><strong>Invite people</strong> — performers and staff join with their own account, so their profile, headshots, and availability stay up to date.</li>
        <li><strong>Organize into groups</strong> — a team or ensemble acts like a single contact you can cast and message.</li>
        <li><strong>Collect what you need</strong> — send questionnaires when you need information from everyone at once.</li>
      </ol>
      <p>From here, people flow into your talent pools, casting, and messages.</p>
    HTML
  %>
  <%= render "shared/intro_guide",
        guide_key: "contacts_intro",
        title: "How contacts work",
        body: contacts_guide_body,
        actions: [
          ({ text: "Invite people", path: new_manage_person_path } if Current.user&.manager?),
          { text: "Create a questionnaire", path: manage_contacts_questionnaires_path }
        ].compact %>

  <div class="mt-4">
  <%# Search Bar - Always Visible %>
  <div class="mb-4" data-controller="search-bar">
    <%= form_with url: manage_contacts_path, method: :get, data: { turbo_action: "advance", search_bar_target: "form" }, class: "relative flex items-center gap-2" do |f| %>
      <div class="relative flex-1">
        <input
          type="text"
          name="q"
          value="<%= @search %>"
          placeholder="Search by name or email..."
          class="w-full h-10 text-base px-3 pl-9 pr-9 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-pink-500 focus:border-transparent"
          autocomplete="off"
          data-action="input->search-bar#toggleClear"
          data-search-bar-target="input"
        />
        <svg class="absolute left-2.5 top-3 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <button
          type="button"
          data-action="click->search-bar#clear"
          data-search-bar-target="clearBtn"
          class="absolute right-1.5 top-2.5 p-1 rounded-full hover:bg-gray-100 transition cursor-pointer <%= @search.blank? ? 'hidden' : '' %>"
          title="Clear search"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-gray-400 hover:text-gray-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <%= render "shared/button",
          text: "Search",
          variant: "primary",
          size: "large",
          icon: "search",
          type: :submit %>

      <%# Hidden fields to preserve other filters %>
      <%= f.hidden_field :sort, value: @sort %>
      <%= f.hidden_field :show, value: @show %>
      <%= f.hidden_field :filter, value: @filter %>
      <%= f.hidden_field :type, value: @type %>
    <% end %>
  </div>

  <%
    # In single pool mode, don't show the pool selector dropdown (but still show Everyone vs Talent Pool)
    single_pool_mode = Current.organization.talent_pool_single?
  %>
  <%= render "shared/filters/filter_bar",
      toggle_label: "Filters & View Options",
      wrapper_data_controller: "filter-select",
      filter_groups: [
        # Always show the Talent Pool vs Everyone filter
        {
          partial: "shared/filters/dropdown_filter",
          locals: {
            label: "Group",
            name: "filter",
            options: [
              {
                value: "talent_pools",
                text: "Talent Pool"
              },
              {
                value: "everyone",
                text: "Everyone"
              }
            ],
            selected: @filter,
            data_attributes: {
              action: "change->filter-select#update",
              filter_select_search_value: @search,
              filter_select_show_value: @show,
              filter_select_type_value: @type
            }
          }
        },
        # Only show pool selector when filtering by talent pools AND NOT in single pool mode AND there are multiple pools
        (@filter == "talent_pools" && !single_pool_mode && @talent_pools.count > 1 ? {
          partial: "shared/filters/dropdown_filter",
          locals: {
            label: "Pool",
            name: "talent_pool_id",
            options: [{ value: "", text: "All Talent Pools" }] + @talent_pools.map { |tp| { value: tp.id.to_s, text: tp.production_names } },
            selected: @talent_pool_id.to_s,
            data_attributes: {
              action: "change->filter-select#update",
              filter_select_search_value: @search,
              filter_select_show_value: @show,
              filter_select_filter_value: @filter,
              filter_select_type_value: @type
            }
          }
        } : nil),
        { separator: true },
        {
          partial: "shared/filters/dropdown_filter",
          locals: {
            label: "Include",
            name: "type",
            options: [
              { value: "all", text: "People & Groups" },
              { value: "people", text: "Just People" },
              { value: "groups", text: "Just Groups" }
            ],
            selected: @type,
            data_attributes: {
              action: "change->filter-select#update",
              filter_select_search_value: @search,
              filter_select_show_value: @show,
              filter_select_filter_value: @filter
            }
          }
        },
        { separator: true },
        {
          partial: "shared/filters/dropdown_filter",
          locals: {
            label: "Sort",
            name: "sort",
            options: [
              { value: "name_asc", text: "A→Z" },
              { value: "name_desc", text: "Z→A" },
              { value: "date_desc", text: "Newest" },
              { value: "date_asc", text: "Oldest" }
            ],
            selected: @sort,
            data_attributes: {
              action: "change->filter-select#update",
              filter_select_search_value: @search,
              filter_select_filter_value: @filter,
              filter_select_show_value: @show,
              filter_select_type_value: @type
            }
          }
        },
        { separator: true },
        {
          partial: "shared/filters/view_mode_filter",
          locals: {
            path_helper: method(:manage_contacts_path),
            current_mode: @show,
            q: @search,
            sort: @sort,
            filter: @filter,
            type: @type
          }
        }
      ]
  %>

  <% if @entries.any? %>

    <%# Tile View %>
    <% if @show == "tiles" %>
      <div id="directory_content" class="grid grid-cols-4 md:grid-cols-6 lg:grid-cols-8 xl:grid-cols-10 gap-3 w-full">
        <% @entries.each do |entry| %>
          <% cache ["directory_tile_v2", entry, entry.updated_at, Current.production&.id] do %>
            <%= render "directory_tile", entry: entry %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%# List View %>
      <div id="directory_content" class="space-y-1">
        <% @entries.each do |entry| %>
          <% cache ["directory_list_v3", entry, entry.updated_at, Current.production&.id] do %>
            <%= render "directory_list_item", entry: entry %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# Infinite Scroll - Auto-load more when scrolling to bottom %>
    <% if @pagy.pages > 1 && @pagy.page < @pagy.pages %>
      <%= turbo_frame_tag "pagination" do %>
        <div data-controller="infinite-scroll"
             data-infinite-scroll-url-value="<%= manage_contacts_path(page: @pagy.page + 1, q: @search, sort: @sort, show: @show, filter: @filter, type: @type, format: :turbo_stream) %>"
             data-infinite-scroll-page-value="<%= @pagy.page %>"
             data-infinite-scroll-pages-value="<%= @pagy.pages %>">
          <%= link_to "Load More",
                  manage_contacts_path(page: @pagy.page + 1, q: @search, sort: @sort, show: @show, filter: @filter, type: @type, format: :turbo_stream),
                  data: {
                    infinite_scroll_target: "nextLink"
                  },
                  class: "hidden" %>

          <div data-infinite-scroll-target="sentinel" class="h-20 flex items-center justify-center">
            <div class="text-sm text-gray-400">Loading more...</div>
          </div>
        </div>
      <% end %>
    <% end %>

  <% else %>
    <% if @search.present? %>
      <%= render "shared/empty_state", icon: "search", title: "No results found", body: "Try adjusting your filters or search.", actions: [ { text: "Clear all filters", path: manage_contacts_path, variant: "secondary" } ] %>
    <% else %>
      <%= render "shared/empty_state", icon: "people", title: "No people or groups yet", body: "Invite people and they show up here, with their groups." %>
    <% end %>
  <% end %>

  </div><%# Close module content wrapper %>
</div>

<%# Compose Message Modal for contacting people/groups %>
<%= render "shared/compose_message_modal" %>