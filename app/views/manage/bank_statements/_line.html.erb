<%# One bank line, in whatever state it is: to deal with (Yes/No, Record it,
    Ignore) or dealt with (its badge and Undo). An action answers with a
    Turbo Stream that swaps this row in place.
      line:        the BankStatementLine
      looks_like:  what it looks like on the books ([ { memo:, on:, amount_cents: } ]) or nil
      hint:        what was recorded for the same payee last time, or nil
      filters:     the page's month/kind/page, carried on every action %>
<%
  money = ->(cents) { number_to_currency(cents / 100.0) }
  can_change = module_change?(:books)
  filters = local_assigns.fetch(:filters, {})
  looks_like = local_assigns[:looks_like]
  hint = line.open? ? local_assigns[:hint] : nil
  state_badge = { "matched" => "bg-green-50 text-green-700", "recorded" => "bg-pink-50 text-pink-700", "ignored" => "bg-gray-100 text-gray-600" }
  summary = "#{line.on.strftime('%b %-d, %Y')} · #{line.deposit? ? '+' : '−'}#{money.call(line.amount_cents.abs)} · #{line.description.presence || 'No description'}"
%>
<li id="<%= dom_id(line) %>" class="px-5 py-2.5">
  <div class="flex flex-wrap lg:flex-nowrap items-center gap-x-4 gap-y-2">
    <span class="w-24 flex-none text-sm text-gray-500 tabular-nums"><%= line.on.strftime("%b %-d, %Y") %></span>
    <span class="flex-1 min-w-[12rem] text-sm text-gray-900 truncate" title="<%= line.description %>"><%= line.description.presence || "No description" %></span>
    <span class="w-28 flex-none text-right text-sm font-semibold tabular-nums <%= line.deposit? ? 'text-green-700' : 'text-gray-900' %>"><%= line.deposit? ? "+" : "−" %><%= money.call(line.amount_cents.abs) %></span>
    <% if line.done? %>
      <span class="inline-flex w-20 justify-center rounded-md px-1.5 py-0.5 text-xs font-medium <%= state_badge[line.state] %>"><%= line.state.capitalize %></span>
      <span class="flex-none flex items-center gap-2 lg:w-32 lg:justify-end">
        <% if line.money_record %><%= link_to "Open", manage_money_record_path(line.money_record), class: "text-xs text-pink-600 hover:text-pink-700" %><% end %>
        <% if can_change %><%= render "shared/button", text: "Undo", variant: "secondary", size: "small", path: manage_reopen_money_bank_line_path(line, filters), method: :post %><% end %>
      </span>
    <% elsif can_change %>
      <span class="flex-none flex items-center gap-2 lg:w-64 lg:justify-end">
        <% if line.suggested? && looks_like %>
          <%= render "shared/button", text: "Yes, that's it", variant: "primary", size: "small", path: manage_match_money_bank_line_path(line, filters), method: :post %>
          <%= render "shared/button", text: "No", variant: "secondary", size: "small", path: manage_reopen_money_bank_line_path(line, filters), method: :post %>
        <% else %>
          <%= render "shared/button", text: "Record it", variant: "primary", size: "small", type: :button,
                data: { action: "click->bank-record#open", bank_record_kind_param: (line.deposit? ? "in" : "out"), bank_record_amount_param: format("%.2f", line.amount_cents.abs / 100.0),
                        bank_record_on_param: line.on.iso8601, bank_record_memo_param: line.description, bank_record_line_param: line.id,
                        bank_record_category_param: hint&.dig(:category_key), bank_record_counterparty_param: hint&.dig(:counterparty), bank_record_summary_param: summary } %>
          <%= render "shared/button", text: "Ignore", variant: "secondary", size: "small", path: manage_ignore_money_bank_line_path(line, filters), method: :post %>
          <button type="button" class="text-xs text-pink-600 hover:text-pink-700 cursor-pointer" title="A rule for every line like this one"
                  data-action="click->bank-rule#open" data-bank-rule-contains-param="<%= line.description_key.presence || line.description %>" data-bank-rule-direction-param="<%= line.deposit? ? 'in' : 'out' %>"
                  data-bank-rule-category-param="<%= hint&.dig(:category_key) %>" data-bank-rule-counterparty-param="<%= hint&.dig(:counterparty) %>">Rule</button>
        <% end %>
      </span>
    <% end %>
  </div>
  <% if line.suggested? && looks_like %>
    <p class="mt-1 text-sm text-blue-900">
      <% if looks_like.size == 1 %>
        Looks like <b><%= looks_like.first[:memo] %></b> on the books, <%= looks_like.first[:on].strftime("%b %-d") %>.
      <% else %>
        Looks like <%= looks_like.size %> entries on the books that add up to it:
        <%= looks_like.map { |c| "#{c[:memo]} (#{money.call(c[:amount_cents].abs)}, #{c[:on].strftime('%b %-d')})" }.join("; ") %>.
      <% end %>
    </p>
  <% elsif hint %>
    <p class="mt-1 text-xs text-gray-500">Last time: <%= hint[:label] %>. Record it starts from that.</p>
  <% end %>
</li>
