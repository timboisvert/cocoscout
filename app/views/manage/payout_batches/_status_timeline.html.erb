<%#
  A payout run's current state, then its lifecycle stepper.

  The state box (eyebrow / big line / one plain-English line, tinted by state)
  is THE place the page says where the run is and what that means; the stepper
  under it shows where that sits in draft → funding → funded → paying → paid.

  Locals:
    batch:      PayoutBatch (required)
    breakdown:  PayoutBatch#money_by_item_state (optional — makes the partially
                paid description say how much is paid / ready / waiting)
%>
<%
  steps = batch.timeline_steps
  breakdown = local_assigns[:breakdown]
  next_try = batch.next_auto_retry_at
  next_try_text = if next_try
                    day = if next_try.to_date == Date.current then "today"
                          elsif next_try.to_date == Date.current + 1 then "tomorrow"
                          else next_try.strftime("%a, %b %-d")
                          end
                    "#{day} at #{next_try.strftime('%-l:%M%P')}"
                  end
  money = ->(cents) { number_to_currency(cents / 100.0) }

  headline, description, tint, eyebrow_color =
    case batch.status
    when "draft"
      [ "Draft — not submitted",
        "Nothing has been debited yet. Fund & pay when you're ready; payees with a connected bank are paid as soon as the funding clears, and anyone without one waits on this run until they connect.",
        "bg-gray-50 border-gray-300", "text-gray-500" ]
    when "funding"
      [ "Funding — ACH clearing",
        "We're debiting #{money.call(batch.total_cents)} from your bank. Payouts go out to each payee automatically the moment it lands — usually 2–4 business days. Nothing to do.",
        "bg-amber-50 border-amber-200", "text-amber-700" ]
    when "funded"
      [ "Funded — about to pay",
        "The debit landed and #{money.call(batch.total_cents)} is in. Transfers to each payee's bank are going out now.",
        "bg-amber-50 border-amber-200", "text-amber-700" ]
    when "processing"
      [ "Paying out",
        "Transfers are going out to each payee right now. This usually finishes within a minute.",
        "bg-amber-50 border-amber-200", "text-amber-700" ]
    when "partially_paid"
      parts = []
      if breakdown
        parts << "#{money.call(breakdown[:paid][:cents])} is paid to #{pluralize(breakdown[:paid][:count], 'payee')}" if breakdown[:paid][:count].positive?
        parts << "#{money.call(breakdown[:waiting][:cents])} is waiting on #{pluralize(breakdown[:waiting][:count], 'payee')} who #{breakdown[:waiting][:count] == 1 ? "hasn't" : "haven't"} connected a bank" if breakdown[:waiting][:count].positive?
        parts << "#{money.call(breakdown[:ready][:cents])} is ready to pay now" if breakdown[:ready][:count].positive?
      end
      body = "Funded, but not everyone is paid yet."
      body += " #{parts.to_sentence.upcase_first}." if parts.any?
      body += " We retry automatically — next #{next_try_text} — and the moment anyone connects." if next_try_text
      [ "Partially paid", body, "bg-blue-50 border-blue-200", "text-blue-700" ]
    when "completed"
      [ "Paid — everyone's been paid",
        "All #{money.call(batch.total_cents)} went out#{" · completed #{batch.completed_at.strftime('%b %-d, %Y')}" if batch.completed_at}. Nothing left to do.",
        "bg-green-50 border-green-200", "text-green-700" ]
    when "failed"
      [ batch.funding_status == "failed" ? "Failed — funding didn't go through" : "Failed — transfers didn't go through",
        batch.funding_status == "failed" ? "The bank debit failed, so nobody was paid. Check the funding source and start a new run." : "The funding landed but the transfers failed. Check the payments below for what went wrong.",
        "bg-red-50 border-red-200", "text-red-700" ]
    when "canceled"
      [ "Canceled", "This run was canceled; nothing was paid from it.", "bg-gray-50 border-gray-300", "text-gray-500" ]
    else
      [ batch.display_status, "", "bg-gray-50 border-gray-300", "text-gray-500" ]
    end
%>

<%# The state itself: label, one big line, one line of what it means. %>
<div class="rounded-lg border p-5 mb-4 <%= tint %>">
  <div class="text-xs font-semibold uppercase tracking-wider <%= eyebrow_color %>">Current state</div>
  <div class="text-2xl font-bold text-gray-900 mt-0.5"><%= headline %></div>
  <% if description.present? %>
    <p class="text-sm text-gray-700 mt-1 max-w-3xl"><%= description %></p>
  <% end %>
</div>

<%# Where that sits in the run's lifecycle. %>
<div class="rounded-lg border border-gray-200 bg-white p-5 mb-6">
  <div class="overflow-x-auto">
    <div class="flex items-start min-w-[30rem]">
      <% steps.each_with_index do |step, i| %>
        <%
          dot, ring, connector, label_class =
            case step[:state]
            when :done
              [ "bg-green-500 text-white", "", "bg-green-500", "text-gray-700" ]
            when :current
              [ "bg-pink-500 text-white ring-4 ring-pink-100", "", "bg-gray-200", "text-pink-600 font-semibold" ]
            when :failed
              [ "bg-red-500 text-white", "", "bg-gray-200", "text-red-600 font-semibold" ]
            else
              [ "bg-gray-100 text-gray-400 border border-gray-300", "", "bg-gray-200", "text-gray-400" ]
            end
        %>
        <div class="flex flex-col items-center text-center w-24 flex-shrink-0">
          <div class="w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 <%= dot %>">
            <% case step[:state] %>
            <% when :done %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <% when :failed %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
            <% when :current %>
              <span class="w-2 h-2 rounded-full bg-white"></span>
            <% else %>
              <span class="text-xs font-semibold"><%= i + 1 %></span>
            <% end %>
          </div>
          <span class="mt-2 text-xs <%= label_class %>"><%= step[:label] %></span>
          <% if step[:at] %>
            <span class="mt-0.5 text-[11px] text-gray-400"><%= step[:at].strftime("%b %-d") %></span>
          <% end %>
        </div>
        <% if i < steps.size - 1 %>
          <div class="flex-1 h-0.5 mt-3.5 rounded <%= connector %>"></div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
