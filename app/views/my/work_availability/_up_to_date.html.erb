<%# Checking in: one button that says "my availability is up to date",
    so the people who schedule you know they can count on it. Once pressed
    it's a green check until the confirmation runs out or anything changes
    (StaffAvailabilityWriter#unconfirm!) — only pressing it counts.
    Locals: confirmed, confirmed_through, onboarding, month. %>
<% if confirmed %>
  <section class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 flex items-start gap-3">
    <span class="flex-shrink-0 mt-0.5 w-5 h-5 rounded-full bg-green-500 text-white flex items-center justify-center">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="m4.5 12.75 6 6 9-13.5"/></svg>
    </span>
    <div class="min-w-0">
      <p class="text-sm font-semibold text-green-800">My availability is up to date</p>
      <p class="text-xs text-green-700 mt-0.5">
        Confirmed through <%= confirmed_through.strftime("%B %-d") %>. If you change anything, you'll need to confirm it again.
      </p>
    </div>
  </section>
<% else %>
  <section class="rounded-lg border border-pink-200 bg-pink-50 px-4 py-3">
    <p class="text-sm font-semibold text-gray-900">Is your availability up to date?</p>
    <p class="text-xs text-gray-600 mt-0.5">
      Check the calendar, then confirm it so the people who schedule you know they can count on it.
    </p>
    <%= render "shared/button", text: "Confirm my availability", variant: "primary", size: "small",
          classes: "w-full mt-3",
          path: my_confirm_work_availability_path(onboarding: onboarding, stay: 1, month: month.iso8601), method: :post %>
  </section>
<% end %>
