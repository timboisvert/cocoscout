<%# One staff member card. Works as a full-width row (list view) or a tile
    (grid view) — the container controls layout, the card stays the same.
    Locals: member, pending (bool). %>
<% person = member.person %>
<% headshot = person.respond_to?(:safe_headshot_variant) ? person.safe_headshot_variant(:thumb) : nil %>
<% onboarding = member.onboarding_state.presence || "added" %>
<% preview = StaffOnboardingInviter.preview(staff_member: member) %>
<% resend_label = onboarding == "invited" ? "Resend email" : "Send email" %>
<% search_key = [ person.name, person.email, member.personal_email, member.title ].compact.join(" ").downcase %>
<div class="group bg-white border border-gray-200 rounded-lg px-3 py-2.5 flex items-center gap-3 hover:border-gray-300 transition-colors"
     data-staff-hub-target="item"
     data-search="<%= search_key %>">
  <% if headshot %>
    <%= image_tag headshot, alt: person.name, class: "w-9 h-9 rounded-lg object-cover flex-shrink-0" %>
  <% else %>
    <div class="w-9 h-9 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-xs flex-shrink-0">
      <%= person.initials %>
    </div>
  <% end %>

  <div class="flex-1 min-w-0">
    <div class="font-medium text-gray-900 text-sm truncate flex items-center gap-1.5">
      <span class="truncate"><%= member.display_name %></span>
      <% case member.onboarding_status %>
      <% when :no_account %>
        <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-gray-200 text-gray-600 text-[10px] font-medium flex-shrink-0"
              title="No CocoScout account yet — they need to accept the invite and sign up.">No account</span>
      <% when :invited %>
        <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-amber-100 text-amber-700 text-[10px] font-medium flex-shrink-0"
              title="Invited — waiting on them to accept onboarding.">Invited</span>
      <% when :awaiting_bank %>
        <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-amber-100 text-amber-700 text-[10px] font-medium flex-shrink-0"
              title="Accepted onboarding — still needs to connect a bank to get paid.">Awaiting bank</span>
      <% when :onboarded %>
        <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-green-100 text-green-700 text-[10px] font-medium flex-shrink-0"
              title="Onboarded — accepted and bank connected, ready to be paid.">Onboarded</span>
      <% end %>
    </div>
    <div class="text-xs text-gray-500 truncate">
      <%= member.title.presence || person.email %>
    </div>
    <% if member.house_roles.any? %>
      <div class="mt-1 flex flex-wrap gap-1">
        <% member.house_roles.first(4).each do |role| %>
          <span class="px-1.5 py-0.5 rounded bg-pink-50 text-pink-700 text-[10px]"><%= role.name %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flex items-center gap-1.5 flex-shrink-0 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity">
    <% if pending && (person.email.present? || member.personal_email.present?) %>
      <%= render "shared/button",
            text: (onboarding == "invited" ? "Resend email" : "Send invite"),
            variant: "primary",
            size: "small",
            type: :button,
            data: {
              action: "click->invite-preview#open",
              "invite-path": manage_invite_staffing_staff_path(member),
              "to-name": person.name,
              "to-email": preview[:to_email],
              "email-subject": preview[:subject],
              "email-body": preview[:body],
              "send-label": resend_label
            } %>
    <% end %>
    <%= render "shared/button", text: "Edit", variant: "outline", size: "small",
          path: manage_edit_staffing_staff_path(member) %>
  </div>
</div>
