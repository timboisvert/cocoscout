<%# This date's discount codes on the follow-or-own pattern (Tim,
    2026-10-17): a strip names the production's codes, which work on this
    date; the switch gives the date its own instead (TicketListing#own_codes),
    and the card below lists them, with a pink modal to add one.
    Locals: listing, setup. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  own = listing.own_codes?
  codes = listing.ticket_discount_codes.where(active: true).order(:code).to_a
  production_codes = listing.organization.ticket_discount_codes.where(production: listing.production, active: true).order(:code).to_a
  followed = production_codes.any? ? production_codes.map { |c| "#{c.code} (#{c.off_words})" }.to_sentence : "none yet"
  modal_id = "add-code-modal"
%>
<div class="space-y-4" data-controller="fieldset-toggle">
  <div class="rounded-lg border border-pink-200 bg-pink-50 px-5 py-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
    <p class="text-sm text-pink-900 min-w-0 flex-1">
      <span class="font-medium"><%= possessive(listing.production.name) %> codes:</span> <%= followed %>. Switch on to give this date its own instead.
    </p>
    <%= form_with url: manage_ticket_listing_path(listing, section: "codes"), method: :patch, data: { controller: "auto-submit" } do %>
      <label class="flex items-center gap-3 text-sm font-medium text-gray-900 whitespace-nowrap">
        This date's own codes
        <%= render "shared/toggle_switch", name: "ticket_listing[own_codes]", checked: own, hidden_false: true,
              id: "ticket_listing_own_codes", aria_label: "This date's own discount codes",
              data: { fieldset_toggle_target: "switch", action: "change->fieldset-toggle#toggle change->auto-submit#submit" } %>
      </label>
    <% end %>
  </div>
  <fieldset <%= "disabled" unless own %> data-fieldset-toggle-target="fields" class="disabled:opacity-50">
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <%= render "shared/section_heading", title: "Discount codes",
            intro: "Codes buyers can enter at checkout, good for this date (#{ticket_listing_date_label(listing)}) only." do %>
        <%= render "shared/button", text: "Add code", variant: "primary", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: modal_id } %>
      <% end %>
      <% if codes.any? %>
        <ul class="divide-y divide-gray-100">
          <% codes.each do |code| %>
            <%= render "manage/ticketing/code_row", code: code, share_form: manage_ticket_listing_code_path(listing, code_id: code.id), remove_modal_id: "confirm-remove-code-#{code.id}" %>
          <% end %>
        </ul>
      <% else %>
        <p class="px-6 py-5 text-sm text-gray-500">No codes of its own yet.</p>
      <% end %>
    </div>
  </fieldset>
</div>
<%= render "manage/ticketing/code_modal", id: modal_id, url: manage_ticket_listing_codes_path(listing), what: "this date only", input_class: input_class %>
<% codes.each do |code| %>
  <%= render "shared/confirm_modal", id: "confirm-remove-code-#{code.id}", title: "Remove #{code.code}?",
        message: "Buyers won't be able to use it anymore. Orders that already used it keep their discount.",
        confirm_text: "Remove code", url: manage_ticket_listing_code_path(listing, code_id: code.id), method: :delete %>
<% end %>
