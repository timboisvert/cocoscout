<%
  setup = @production.production_ticketing
  title = setup&.title.presence || @production.name
  description = setup&.description.presence || @production.description.presence
  notes = setup ? [ setup.door_note, setup.age_note, setup.accessibility_note ].compact_blank : []
  wide = @production.wide_image.attached? ? @production.safe_wide_image_variant : nil
  poster = wide ? nil : @production.safe_poster_variant(:large) || @production.safe_poster_variant(:small)
  image_url = (wide || poster) && url_for(wide || poster)
  page_url = ticket_production_url(@ticketing_profile, @production)
  date_path = ->(listing) { tickets_event_path(org: @ticketing_profile.slug, event: @production.public_key, date: listing.slug, code: @code, **embed_params) }
  selected = @listing
  show = selected&.show
  venue = show && [ show.location&.name, show.location_space&.name ].compact.uniq.join(" · ")
  address = show&.location && [ show.location.address1, show.location.city, show.location.state ].compact_blank.join(", ")
  map_url = address.present? ? "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode([ show.location.name, address ].compact.join(', '))}" : nil
  # A chip's one word about the date: nothing while it's simply on sale.
  chip_note = ->(listing) { public_listing_note(listing) }
%>
<% content_for :title, "#{title} · #{@organization.name}" %>
<% content_for :head do %>
  <meta name="description" content="<%= description.to_s.truncate(160) %>">
  <meta property="og:title" content="<%= title %> · <%= @organization.name %>">
  <meta property="og:description" content="<%= description.to_s.truncate(200) %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= page_url %>">
  <% if image_url %>
    <meta property="og:image" content="<%= image_url %>">
    <meta name="twitter:card" content="summary_large_image">
  <% end %>
<% end %>

<%# Layout A, for a production with many dates: the production, pick a date,
    then that date's tickets, all on one page. %>
<div class="mx-auto max-w-xl space-y-5">
  <% if image_url %>
    <%= image_tag image_url, alt: (wide ? "" : "#{@production.name} poster"),
          class: wide ? "w-full h-auto rounded-2xl" : "mx-auto max-h-[28rem] w-auto h-auto rounded-2xl" %>
  <% end %>

  <div class="text-center space-y-1.5">
    <h1 class="text-3xl sm:text-4xl coustard-regular text-gray-900"><%= title %></h1>
    <p class="text-sm text-gray-600"><%= @organization.name %></p>
    <% if notes.any? %><p class="text-sm text-gray-600"><%= notes.join(" · ") %></p><% end %>
  </div>

  <% if @listings.empty? %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-6 text-center text-gray-700">No dates on sale right now.</div>
  <% else %>
    <%# Pick a date: every upcoming date as a chip, the chosen one in pink. %>
    <nav class="flex flex-wrap justify-center gap-2" aria-label="Pick a date">
      <% @listings.each do |listing| %>
        <% current = listing == selected %>
        <% note = chip_note.call(listing) %>
        <%= link_to date_path.call(listing), aria: { current: current ? "page" : nil },
              class: "flex flex-col items-center min-w-[4.25rem] rounded-xl border px-3 py-2 leading-tight transition-colors #{current ? 'border-pink-500 bg-pink-500 text-white' : 'border-gray-200 bg-white text-gray-900 hover:border-pink-400'}" do %>
          <span class="text-[11px] font-semibold uppercase <%= current ? 'text-pink-100' : 'text-pink-600' %>"><%= listing.show.date_and_time.strftime("%a") %></span>
          <span class="text-xl font-bold"><%= listing.show.date_and_time.day %></span>
          <span class="text-[11px] uppercase <%= current ? 'text-pink-100' : 'text-gray-500' %>"><%= listing.show.date_and_time.strftime("%b") %></span>
          <% if note %><span class="mt-0.5 text-[10px] font-medium <%= current ? 'text-pink-100' : (note == 'Sold out' ? 'text-gray-500' : 'text-amber-700') %>"><%= note %></span><% end %>
        <% end %>
      <% end %>
    </nav>

    <div class="text-center space-y-1">
      <p class="text-base text-gray-800"><%= show.date_and_time.strftime("%A, %B %-d · %-l:%M %p") %></p>
      <% if show.is_online %>
        <p class="text-sm text-gray-600">Online</p>
      <% elsif venue.present? %>
        <p class="text-sm text-gray-600">
          <%= venue %><% if address.present? %> · <%= address %><% end %>
          <% if map_url %> · <%= link_to "Directions", map_url, target: "_blank", rel: "noopener", class: "text-pink-700 hover:text-pink-800" %><% end %>
        </p>
      <% end %>
      <% if selected.display_title != title %><p class="text-sm text-gray-600"><%= selected.display_title %></p><% end %>
    </div>

    <%= render "tickets/picker", listing: selected, tiers: @tiers, inventory: @inventory, tax: @tax, code: @code, preview: @preview,
          profile: @ticketing_profile, code_url: tickets_event_path(org: @ticketing_profile.slug, event: @production.public_key, date: selected.slug, **embed_params) %>
  <% end %>

  <% if description.present? %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
      <h2 class="font-semibold text-gray-900">About the show</h2>
      <div class="mt-2 text-gray-700 space-y-3 leading-relaxed"><%= simple_format(description) %></div>
    </div>
  <% end %>
</div>
