<% content_for :title, "Amend Contract - Financials" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Contracts", manage_contracts_path],
      [@contract.contractor_name, manage_contract_path(@contract)]
    ],
    text: "Amend Contract",
    links: []
  } %>

  <div class="max-w-2xl mx-auto mt-6">
    <p class="text-gray-600 mb-6">Update the deal: who sells the tickets, how it settles, and every payment on this contract.</p>

    <%= render "manage/contracts/amend_steps", current: 3 %>

    <%= render "manage/contracts/financials_fields",
          contract: @contract,
          form_url: save_amend_payments_manage_contract_path(@contract),
          back_path: amend_events_manage_contract_path(@contract),
          existing_payments: @existing_payments,
          existing_payment_structure: @existing_payment_structure,
          existing_payment_config: @existing_payment_config,
          bookings: @bookings,
          bookings_count: @bookings_count,
          offline_payment_methods: @offline_payment_methods %>
  </div>
</div>
