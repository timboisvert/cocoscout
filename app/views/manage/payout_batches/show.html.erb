<% content_for :title, "Payout Run" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Money", manage_money_index_path],
      ["Payout Runs", manage_payout_batches_path]
    ],
    text: @batch.created_at.strftime("%b %-d, %Y"),
    links: []
  } %>

  <div class="max-w-3xl">
    <%= render "manage/payout_batches/status_timeline", batch: @batch %>

    <div class="grid gap-4 grid-cols-1 sm:grid-cols-3 mb-6">
      <div class="rounded-lg border border-gray-200 bg-white p-4">
        <div class="text-xs text-gray-500 uppercase tracking-wide">Total</div>
        <div class="mt-1 text-xl font-bold text-gray-900 tabular-nums"><%= number_to_currency(@batch.total_cents / 100.0) %></div>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white p-4">
        <div class="text-xs text-gray-500 uppercase tracking-wide">Paid so far</div>
        <div class="mt-1 text-xl font-bold text-gray-900 tabular-nums"><%= number_to_currency(@batch.paid_total_cents / 100.0) %></div>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white p-4">
        <div class="text-xs text-gray-500 uppercase tracking-wide">Funding</div>
        <div class="mt-1 text-sm font-medium text-gray-900"><%= @batch.funding_status&.titleize || "—" %></div>
      </div>
    </div>

    <% if @batch.status == "funding" %>
      <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
        We're collecting the funds for this run. Payouts to each person go out automatically once it clears.
      </div>
    <% end %>

    <% if @not_ready_items.any? %>
      <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-amber-900"><%= pluralize(@not_ready_items.size, "person") %> hasn't connected a bank yet</p>
            <p class="text-xs text-amber-800 mt-0.5">You can still pay the run — we'll pay everyone who's ready and skip these until they connect a bank. Their balance stays owed.</p>
            <div class="mt-2 flex flex-wrap gap-1.5">
              <% @not_ready_items.each do |item| %>
                <span class="inline-flex items-center gap-1 rounded-md bg-white/60 border border-amber-200 px-2 py-0.5 text-xs text-amber-900">
                  <%= item.payee&.name %> · <%= number_to_currency(item.amount_cents / 100.0) %>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if @batch.open? && @batch.items.any? %>
      <div class="mb-6 rounded-lg border border-pink-200 bg-pink-50 p-4 flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-sm font-medium text-gray-900">Ready to pay <%= pluralize(@batch.items.count, "person") %> · <%= number_to_currency(@batch.total_cents / 100.0) %></p>
          <p class="text-xs text-gray-600 mt-0.5">We debit your bank via ACH, then pay each person to their connected bank.</p>
        </div>
        <% if Current.organization.funding_payment_method_id.present? %>
          <%= button_to manage_fund_payout_batch_path(@batch), method: :post, class: "inline-block",
                form: { data: { turbo_confirm: "Fund and pay this run? We'll debit #{number_to_currency(@batch.total_cents / 100.0)} from your bank." } } do %>
            <%= render "shared/button", text: "Fund & pay run", variant: "primary", size: "medium" %>
          <% end %>
        <% else %>
          <%= render "shared/button", text: "Connect a bank account first", variant: "primary", size: "small",
                path: manage_connect_payout_funding_path(return_to: manage_payout_batch_path(@batch)), method: :post, form: { data: { turbo: false } } %>
        <% end %>
      </div>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-200">
        <h3 class="font-semibold text-gray-900">Payments</h3>
      </div>
      <div class="divide-y divide-gray-100">
        <% @batch.items.includes(:payee, payout_contributions: :source).each do |item| %>
          <% contributions = item.payout_contributions.to_a %>
          <% if contributions.any? %>
            <%# Click a payee to expand what they're being paid for. %>
            <details class="group">
              <summary class="px-5 py-3 flex items-center justify-between gap-4 cursor-pointer list-none hover:bg-gray-50">
                <div class="flex items-center gap-2 min-w-0">
                  <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-90 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  <span class="text-gray-900 truncate"><%= item.payee&.name %></span>
                  <span class="text-xs text-gray-400 flex-shrink-0"><%= pluralize(contributions.size, "item") %></span>
                </div>
                <div class="flex items-center gap-3 flex-shrink-0">
                  <span class="font-semibold text-gray-900 tabular-nums"><%= number_to_currency(item.amount_cents / 100.0) %></span>
                  <%= render "manage/payout_batches/status_badge", status: item.status %>
                </div>
              </summary>
              <div class="bg-gray-50 border-t border-gray-100 px-5 py-1.5 pl-11">
                <% contributions.each do |c| %>
                  <div class="flex items-center justify-between gap-4 py-1.5 text-sm">
                    <span class="text-gray-600 truncate"><%= c.label %></span>
                    <span class="text-gray-800 tabular-nums flex-shrink-0"><%= number_to_currency(c.amount_cents / 100.0) %></span>
                  </div>
                <% end %>
              </div>
            </details>
          <% else %>
            <div class="px-5 py-3 flex items-center justify-between gap-4">
              <div class="min-w-0">
                <span class="text-gray-900"><%= item.payee&.name %></span>
                <% if item.error.present? %>
                  <div class="text-xs text-red-600 mt-0.5"><%= item.error %></div>
                <% end %>
              </div>
              <div class="flex items-center gap-3 flex-shrink-0">
                <span class="font-semibold text-gray-900 tabular-nums"><%= number_to_currency(item.amount_cents / 100.0) %></span>
                <%= render "manage/payout_batches/status_badge", status: item.status %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
