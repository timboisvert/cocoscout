<%# Goal 1: when do I work. Uses @rows_by_day, @has_any, @people, @expected_by_shift.
    Under the organization, one line per show the shift covers, with how
    many people to expect where the organization shows it (Tim, 2026-10-16:
    just the show time, the show's name and the count; no box, no total). %>
<section class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <%= render "shared/section_heading", padding: "px-5 py-4", title: "Upcoming shifts" %>

  <div class="p-5">
    <% if @has_any %>
      <div class="space-y-5">
        <% @rows_by_day.each do |day, rows| %>
          <div>
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2"><%= day.strftime("%A, %B %-d") %></h3>
            <div class="space-y-2">
              <% rows.each do |row| %>
                <% shift = row[:shift] %>
                <% assignment = row[:assignment] %>
                <% org = shift.organization %>
                <% location_name = shift.source.try(:location).try(:name) %>
                <%
                  # The shows this shift covers: with counts where the organization
                  # shows them; otherwise, for a show-tied shift, just the shows.
                  show_lines = (@expected_by_shift || {})[shift.id]
                  if show_lines.nil? && (shift.house_role&.show_specific? || shift.shows.any?)
                    show_lines = shift.covered_shows.map { |cs| ShiftExpectedAttendance::Line.new(show: cs, expected: nil) }
                  end
                %>
                <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 p-3 rounded-lg border <%= assignment.declined? ? "bg-pink-50 border-pink-200" : "bg-gray-50 border-gray-100" %>">
                  <div class="flex items-start gap-4 flex-1 min-w-0">
                    <div class="flex-shrink-0 w-12 flex items-center gap-1 pt-0.5">
                      <span class="text-lg leading-none font-bold text-gray-900"><%= shift.starts_at.strftime("%-d") %></span>
                      <span class="text-[9px] leading-tight font-semibold text-pink-600 uppercase"><%= shift.starts_at.strftime("%b") %></span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="font-medium text-gray-900 truncate <%= "line-through text-gray-500" if assignment.declined? %>"><%= shift.role_label %></div>
                      <div class="text-sm text-gray-600 tabular-nums"><%= shift.starts_at.strftime("%-l:%M %p") %>–<%= shift.ends_at.strftime("%-l:%M %p") %></div>
                      <div class="text-xs text-gray-500 truncate">
                        <% if org %><%= org.name %><% end %><% if location_name.present? && location_name != org&.name %> · <%= location_name %><% end %>
                        <% if @people.size > 1 %> · <%= row[:person].name %><% end %>
                      </div>
                      <% Array(show_lines).each do |line| %>
                        <div class="text-xs text-gray-600 mt-0.5" data-show-line>
                          <span class="font-semibold text-gray-800"><%= line.words %></span><% if line.expected %> · <span class="tabular-nums"><%= line.expected %> expected</span><% end %>
                        </div>
                      <% end %>
                      <% if assignment.declined? %>
                        <div class="mt-1 text-xs text-pink-700 font-medium">
                          You told them you can't make it<% if assignment.decline_reason.present? %> — “<%= assignment.decline_reason %>”<% end %>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <div class="flex-shrink-0 sm:self-center">
                    <% if assignment.declined? %>
                      <%= button_to "I'm back on", my_undo_decline_shift_path(assignment), method: :post,
                            class: "text-xs text-gray-600 hover:text-gray-900 underline bg-transparent border-0 cursor-pointer p-0" %>
                    <% else %>
                      <% cid = "cant-make-it-#{assignment.id}" %>
                      <%= render "shared/button", text: "I can't make it", variant: "primary", size: "small", type: :button,
                            classes: "w-full sm:w-auto justify-center min-h-[44px] sm:min-h-0",
                            data: { controller: "modal", action: "click->modal#open", modal_id: cid } %>

                      <div id="<%= cid %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
                           data-controller="modal" data-action="click->modal#closeOnBackdrop">
                        <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden text-left"
                             data-action="click->modal#stopPropagation">
                          <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
                            <h3 class="text-lg font-semibold text-white">Can't make this shift?</h3>
                            <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
                              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                            </button>
                          </div>
                          <%= form_with url: my_decline_shift_path(assignment), method: :post do %>
                            <div class="px-6 py-5 space-y-3">
                              <p class="text-sm text-gray-600">
                                We'll let <span class="font-medium text-gray-900"><%= org&.name %></span> know you can't work
                                <span class="font-medium text-gray-900"><%= shift.role_label %></span> on
                                <%= shift.starts_at.strftime("%A, %b %-d") %> so they can plan around it.
                              </p>
                              <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Add a note (optional)</label>
                                <%= text_area_tag :reason, nil, rows: 2, placeholder: "e.g. I'm out of town that weekend",
                                      class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
                              </div>
                            </div>
                            <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
                              <%= render "shared/button", text: "Never mind", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
                              <%= render "shared/button", text: "I can't make it", variant: "primary", size: "medium", type: :submit %>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 text-center py-6">No upcoming shifts. They'll show up here once your schedule is posted.</p>
    <% end %>
  </div>
</section>
