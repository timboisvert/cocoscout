<%#
  One incoming payment in the list. Whole row links to the payment detail page,
  where the QR, reminder, and record-offline actions live.

  Required: payment (ContractPayment, direction incoming)
  Optional: show_production (default true) — show the production name in the meta line
%>
<%
  show_production = local_assigns.fetch(:show_production, true)
  contract = payment.contract
  is_late = payment.overdue?
  amount_tbd = payment.amount_tbd? && payment.amount.to_f.zero?
%>
<%= link_to manage_money_incoming_payment_path(payment),
      class: "flex items-stretch px-3 py-2 border rounded-lg transition-all group #{is_late ? 'bg-red-50 border-red-200 hover:border-red-300' : 'bg-white border-gray-200 hover:border-gray-400'}" do %>
  <div class="flex items-center gap-4 w-full">
    <%# Date box %>
    <div class="flex-shrink-0 w-14 text-center">
      <div class="text-xs font-semibold text-pink-600 uppercase"><%= payment.due_date.strftime("%b") %></div>
      <div class="text-2xl font-bold <%= is_late ? 'text-red-700' : 'text-gray-900' %>"><%= payment.due_date.strftime("%-d") %></div>
      <div class="text-xs <%= is_late ? 'text-red-500' : 'text-gray-500' %>"><%= payment.due_date.strftime("%a") %></div>
    </div>

    <%# Payer + description %>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <% if is_late %>
          <span class="inline-flex items-center rounded-md bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">
            <%= icon("alert-circle", class: "w-3 h-3 mr-1 inline") %>
            Overdue
          </span>
        <% end %>
        <span class="font-medium text-gray-900 truncate"><%= contract.contractor_name.presence || "Payer" %></span>
      </div>
      <div class="text-sm text-gray-600 truncate">
        <% if show_production && contract.production_name.present? %>
          <%= contract.production_name %> &middot;
        <% end %>
        <%= payment.description.presence || "Payment" %>
      </div>
    </div>

    <%# Amount + chevron %>
    <div class="flex items-center gap-3 flex-shrink-0">
      <div class="text-right">
        <div class="text-xl font-bold <%= amount_tbd ? 'text-gray-400' : 'text-green-600' %> tabular-nums">
          <%= amount_tbd ? "TBD" : number_to_currency(payment.amount) %>
        </div>
        <% if is_late %>
          <div class="text-xs text-red-600"><%= distance_of_time_in_words(payment.due_date, Date.current) %> overdue</div>
        <% elsif payment.collectable_online? %>
          <div class="text-xs text-gray-400">Ready to collect</div>
        <% end %>
      </div>
      <svg class="w-5 h-5 text-gray-300 group-hover:text-gray-500 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  </div>
<% end %>
