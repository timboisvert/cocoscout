<% content_for :title, "All Contracts" %>

<%# The whole current book — active contracts and drafts — as the slim list,
    sortable by upcoming start date or by name. The hub only shows what's in
    motion; past contracts have their own page. %>
<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      [ "Contracts", manage_contracts_path ]
    ],
    text: "All Contracts",
    links: [
      { text: "Past Contracts", path: completed_manage_contracts_path }
    ]
  } %>

  <div class="mb-3">
    <%= render "shared/filters/filter_bar", bare: true, filter_groups: [
      {
        label: "Sort",
        filters: [
          { text: "Upcoming", path: all_manage_contracts_path(sort: "upcoming"), active: @sort == "upcoming" },
          { text: "Name",     path: all_manage_contracts_path(sort: "name"),     active: @sort == "name" }
        ]
      }
    ] %>
  </div>

  <% if @contracts.any? %>
    <%= render "contract_slim_list", contracts: @contracts %>
  <% else %>
    <%= render "shared/empty_state", icon: "document", title: "No contracts yet", body: "Create a contract when an external group wants to rent your space or perform at your venue.",
          actions: [ { text: "New contract", path: manage_new_contract_wizard_path } ] %>
  <% end %>
</div>
