<%# The theater's CocoScout balance (ticket money), on the Money hub. Shown only
    while Ticketing is experimental (superadmins) and the org has a box office. %>
<% if Current.user&.superadmin? && Current.organization.ticketing_profile %>
  <% balance = TicketBalance.summary(Current.organization) %>
  <%= link_to manage_ticket_balance_path, class: "mb-8 flex flex-wrap items-center justify-between gap-3 rounded-xl border px-5 py-4 transition-colors hover:border-pink-400 #{balance.available_cents.positive? ? 'bg-green-50 border-green-200' : 'bg-white border-gray-200'}" do %>
    <div>
      <div class="text-sm text-gray-600">Your CocoScout balance</div>
      <div class="text-2xl font-bold tabular-nums text-gray-900"><%= number_to_currency(balance.available_cents / 100.0) %> <span class="text-sm font-normal text-gray-600">available</span></div>
      <p class="text-xs text-gray-600 mt-0.5">Ticket money. Payout runs use it before debiting your bank.</p>
    </div>
    <div class="text-sm text-gray-600 text-right">
      <%= number_to_currency(balance.upcoming_cents / 100.0) %> waiting on upcoming shows<br>
      <span class="font-medium text-pink-600">View balance</span>
    </div>
  <% end %>
<% end %>
