<%#
  Sign-up task row — same 2026 compact design as the availability row.
  Stays visible after signing up or declining (state shown on the buttons)
  so people can change their mind for future events. On phones the buttons
  become a full-width tap bar below the show info.

  Required locals:
    - item: Hash with :show, :entity, :entity_key, :instance,
            :registration (SignUpRegistration or nil), :declined (boolean)
    - has_groups: Boolean — show a small headshot when the user answers
      for multiple profiles/groups
%>
<%
  show = item[:show]
  entity = item[:entity]
  location_name = show.location&.name
  signup_status = if item[:registration].present?
    'signup'
  elsif item[:declined]
    'decline'
  else
    'unset'
  end
%>
<div id="request-item-<%= show.id %>-<%= item[:entity_key] %>"
     class="bg-white border border-gray-200 rounded-lg hover:border-gray-400 transition-all"
     data-controller="signup-button"
     data-signup-button-status-value="<%= signup_status %>">
  <div class="flex flex-wrap sm:flex-nowrap items-center gap-x-3 px-3 py-1.5">
    <%# Inline date: big day + stacked month/weekday %>
    <div class="flex-shrink-0 w-14 flex items-center gap-1.5">
      <span class="text-xl leading-none font-bold text-gray-900"><%= show.date_and_time.strftime("%-d") %></span>
      <span class="text-[10px] leading-tight uppercase">
        <span class="block font-semibold text-pink-600"><%= show.date_and_time.strftime("%b") %></span>
        <span class="block text-gray-500"><%= show.date_and_time.strftime("%a") %></span>
      </span>
    </div>

    <%# Details %>
    <div class="flex-1 min-w-0">
      <div class="text-xs text-gray-400 truncate"><%= show.production.name %></div>
      <div class="text-sm font-medium text-gray-900 truncate"><%= show.display_name %></div>
      <div class="text-xs text-gray-900 truncate">
        <%= show.date_and_time.strftime("%-I:%M %p") %><% if location_name.present? %> &middot; <%= location_name %><% end %>
      </div>
    </div>

    <%# Who this answer is for — only matters with multiple profiles/groups %>
    <% if local_assigns.fetch(:has_groups, false) %>
      <% headshot_variant = entity.safe_headshot_variant(:thumb) %>
      <% if headshot_variant %>
        <%= image_tag headshot_variant, alt: entity.name, class: "w-8 h-8 rounded-lg object-cover flex-shrink-0" %>
      <% else %>
        <div class="w-8 h-8 rounded-lg bg-gray-200 flex items-center justify-center text-gray-700 font-bold text-xs flex-shrink-0">
          <%= entity.respond_to?(:initials) ? entity.initials : entity.name[0..1].upcase %>
        </div>
      <% end %>
    <% end %>

    <%# Sign up / Don't sign up — right-aligned on sm+, full-width tap bar below on phones %>
    <div class="order-last sm:order-none w-full sm:w-auto flex flex-shrink-0 mt-1.5 sm:mt-0 pt-1.5 sm:pt-0 border-t border-gray-100 sm:border-t-0">
      <%
        signup_classes = "w-full sm:w-28 text-xs sm:text-[11px] px-2.5 py-1.5 sm:py-1 text-center border border-gray-200 cursor-pointer flex items-center justify-center whitespace-nowrap rounded-l border-r-0"
        signup_classes += signup_status == 'signup' ? " bg-pink-500 text-white" : " bg-white text-gray-700 hover:bg-gray-50"
      %>
      <%= form_with url: my_task_sign_up_path(show_id: show.id), method: :post, data: { turbo: false }, class: "flex-1 sm:flex-none flex" do |f| %>
        <%= f.hidden_field :person_id, value: entity.id %>
        <button type="submit" class="<%= signup_classes %>" data-signup-button-target="signupButton" data-action="click->signup-button#submitSignup">
          <span data-signup-button-target="signupCheck" class="hidden">&check;</span>
          <span data-signup-button-target="signupText">Sign up</span>
        </button>
      <% end %>
      <%
        decline_classes = "w-full sm:w-28 text-xs sm:text-[11px] px-2.5 py-1.5 sm:py-1 text-center border border-gray-200 cursor-pointer flex items-center justify-center whitespace-nowrap rounded-r"
        decline_classes += signup_status == 'decline' ? " bg-pink-500 text-white" : " bg-white text-gray-700 hover:bg-gray-50"
      %>
      <%= form_with url: my_task_decline_signup_path(show_id: show.id), method: :post, data: { turbo: false }, class: "flex-1 sm:flex-none flex" do |f| %>
        <%= f.hidden_field :person_id, value: entity.id %>
        <button type="submit" class="<%= decline_classes %>" data-signup-button-target="declineButton" data-action="click->signup-button#submitDecline">
          <span data-signup-button-target="declineCheck" class="hidden">&check;</span>
          <span data-signup-button-target="declineText">Don't sign up</span>
        </button>
      <% end %>
    </div>
  </div>
</div>
