<%# The organization's bank rules, from the Rules button: the rules the
    lines suggest (yes makes and runs one, no hides it for good), then the
    rules there are, each with what it does, how many lines waiting it
    would catch now, Apply, Edit and Remove (a confirm modal the page
    renders outside this one); New rule and Apply all at the bottom.
    Yes and No answer with Turbo Streams; closing after a yes that changed
    lines reloads the page (bank_rule_controller.js).
      rules:       the organization's BankRules
      catches:     { rule id => lines waiting it fits now }
      suggestions: BankRuleSuggestions for the organization
      summary:     a BankStatementSummary (for the count waiting) %>
<%
  rules = local_assigns.fetch(:rules, [])
  catches = local_assigns.fetch(:catches, {})
  suggestions = local_assigns.fetch(:suggestions, [])
  modal_close = { action: "click->bank-rule#closeRules" }
%>
<div id="bank-rules-modal"
     class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center sm:p-4"
     data-controller="modal" data-bank-rule-target="rulesModal"
     data-action="click->bank-rule#closeRulesOnBackdrop">
  <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full sm:max-w-3xl sm:mx-4 max-h-[92vh] overflow-y-auto"
       data-action="click->modal#stopPropagation">
    <div class="sticky top-0 z-10 flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white">Rules</h3>
      <button type="button" data-action="click->bank-rule#closeRules" aria-label="Close"
              class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="px-6 py-5 space-y-5">
      <p class="text-sm text-gray-600">A rule reads the bank's description: a line with the phrase in it, going the way the rule says, is recorded as the category and payee you chose, or ignored. Rules run over the lines waiting when you make one, and over every statement brought in later.</p>

      <div id="bank-rule-suggestions" class="<%= 'hidden' if suggestions.empty? %>">
        <h4 class="text-[11px] font-medium uppercase tracking-wide text-gray-500 mb-2">Suggested from your statements</h4>
        <p class="text-xs text-gray-500 mb-2">Payees the bank has named more than once that no rule covers yet. Yes makes the rule and runs it; No puts it away for good.</p>
        <ul class="divide-y divide-gray-100 rounded-lg border border-gray-200">
          <% suggestions.each do |sg| %>
            <li id="bank-rule-suggestion-<%= sg.key %>" class="px-4 py-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
              <span class="flex-1 min-w-[12rem]">
                <span class="font-medium text-gray-900">Has “<%= sg.phrase %>”</span>
                <span class="text-gray-500">· <%= sg.direction == "in" ? "Money in" : "Money out" %></span>
                <span class="block text-gray-600">
                  <% if sg.record? %>Record as <%= sg.category_label %><%= ", #{sg.counterparty}" if sg.counterparty.present? %> <span class="text-gray-500">· what you did <%= sg.times == 1 ? "once" : "#{sg.times} times" %></span>
                  <% elsif sg.ignore? %>Ignore <span class="text-gray-500">· what you did <%= sg.times == 1 ? "once" : "#{sg.times} times" %></span>
                  <% else %>Needs a category <span class="text-gray-500">· such as <%= sg.samples.first %></span><% end %>
                </span>
              </span>
              <span class="text-xs text-gray-500 tabular-nums"><%= sg.waiting_count.zero? ? "None waiting" : "Catches #{pluralize(sg.waiting_count, 'line')} waiting" %> · seen <%= sg.seen_count %> times</span>
              <span class="flex items-center gap-2">
                <% if sg.ready? %>
                  <%= render "shared/button", text: "Yes", variant: "primary", size: "small", path: manage_accept_money_bank_rule_suggestion_path(key: sg.key, contains: sg.phrase, direction: sg.direction, rule_action: sg.action, category_key: sg.category_key, counterparty: sg.counterparty), method: :post %>
                <% else %>
                  <%= render "shared/button", text: "Yes, choose a category", variant: "primary", size: "small", type: :button,
                        data: { action: "click->bank-rule#open", bank_rule_contains_param: sg.phrase, bank_rule_direction_param: sg.direction } %>
                <% end %>
                <%= render "shared/button", text: "No", variant: "secondary", size: "small", path: manage_dismiss_money_bank_rule_suggestion_path(key: sg.key, phrase: sg.phrase, direction: sg.direction), method: :post %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>

      <div>
        <h4 class="text-[11px] font-medium uppercase tracking-wide text-gray-500 mb-2">Your rules</h4>
        <% if rules.empty? %>
          <p class="rounded-lg border border-dashed border-gray-200 px-4 py-4 text-sm text-gray-500">No rules yet. Take a suggestion above, or start one from any line's Rule link, with its words filled in.</p>
        <% else %>
          <ul class="divide-y divide-gray-100 rounded-lg border border-gray-200">
            <% rules.each do |rule| %>
              <% catching = catches.fetch(rule.id, 0) %>
              <li class="px-4 py-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
                <span class="flex-1 min-w-[12rem]">
                  <span class="font-medium text-gray-900">Has <%= rule.phrases.map { |p| "“#{p}”" }.join(" or ") %></span>
                  <span class="text-gray-500">· <%= rule.direction_label %></span>
                  <span class="block text-gray-600"><%= rule.does %><% unless rule.on_import %> · only when applied by hand<% end %></span>
                </span>
                <span class="text-xs text-gray-500 tabular-nums"><%= catching.zero? ? "None waiting" : "Catches #{pluralize(catching, 'line')} waiting" %> · <%= rule.applied_count.zero? ? "not used yet" : "#{pluralize(rule.applied_count, 'line')} so far" %></span>
                <span class="flex items-center gap-2">
                  <% if catching.positive? %>
                    <%= render "shared/button", text: "Apply", variant: "primary", size: "small", path: manage_apply_money_bank_rules_path(id: rule.id), method: :post, form: { data: { turbo: false } } %>
                  <% end %>
                  <%= render "shared/button", text: "Edit", variant: "secondary", size: "small", type: :button,
                        data: { action: "click->bank-rule#open", bank_rule_id_param: rule.id, bank_rule_contains_param: rule.contains, bank_rule_direction_param: rule.direction,
                                bank_rule_kind_param: rule.action, bank_rule_category_param: rule.category_key, bank_rule_counterparty_param: rule.counterparty,
                                bank_rule_production_param: rule.production_id, bank_rule_on_import_param: rule.on_import } %>
                  <%= render "shared/button", text: "Remove", variant: "secondary", size: "small", type: :button,
                        data: { controller: "modal", action: "click->modal#open", modal_id: "remove-rule-#{rule.id}" } %>
                </span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
      <p id="bank-rules-note" class="text-sm text-pink-700 min-h-[1.25rem]"></p>
    </div>
    <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-2">
      <%= render "shared/button", text: "New rule", variant: "secondary", size: "medium", type: :button, data: { action: "click->bank-rule#open" } %>
      <% if rules.any? && summary.open_count.positive? %>
        <%= render "shared/button", text: "Apply every rule to the #{pluralize(summary.open_count, 'line')} waiting", variant: "primary", size: "medium", path: manage_apply_money_bank_rules_path, method: :post, form: { data: { turbo: false } } %>
      <% end %>
    </div>
  </div>
</div>
