<%# This production's own comp rules, or (switch off) the box office's; its
    dates follow it (CompRules). The one override control
    (manage/ticketing/own_switch). Locals: setup, production. %>
<%
  own = setup.own_comps
  profile = ticketing_profile
  rules = own ? setup : profile
  example = own ? "#{comp_rules_sentence(setup, subject: "a #{production.name} date")} A single date can still have its own rules." : nil
%>
<%= form_with url: manage_update_production_ticketing_path(production, section: "comps"), method: :patch do %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle" data-settings-card="comps">
    <%= render "manage/ticketing/own_switch", title: "Comps", follows: "your box office", settings_path: manage_ticketing_settings_section_path(section: "comps"),
          only: production.name, name: "production_ticketing[own_comps]", id: "production_ticketing_own_comps", checked: own %>
    <fieldset <%= "disabled" unless own %> data-fieldset-toggle-target="fields" class="disabled:opacity-50">
      <%= render "manage/ticketing_settings/comp_rules_fields", scope: "production_ticketing", rules: rules, bare: true,
            heading: "Giving comps", off_words: "Turn them off and nobody gives comps on #{production.name}.", example: example %>
    </fieldset>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
    </div>
  </div>
<% end %>
