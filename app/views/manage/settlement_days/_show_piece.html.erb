<%# One show on the day's worksheet. Locals: piece (SettleUp::ShowPiece), day, can_change %>
<%
  money = ->(cents) { cents.negative? ? "−#{number_to_currency(-cents / 100.0)}" : number_to_currency(cents / 100.0) }
  show = piece.show
  fin = piece.financials
  state_words = { ok: "Checked", wait: "Came in, not checked", miss: "Nothing entered" }.fetch(piece.state)
  state_tone = { ok: "text-green-700", wait: "text-amber-700", miss: "text-red-700" }.fetch(piece.state)
  outside_lines = piece.ticket_lines.reject { |l| l[:built_in] }
  online_lines = piece.ticket_lines.select { |l| l[:built_in] }
  line = ->(label, note, value) { "<div class='flex items-baseline justify-between gap-3 py-1.5 text-sm'><span class='text-gray-700'>#{ERB::Util.html_escape(label)}#{note.present? ? " <span class='text-xs text-gray-500'>#{ERB::Util.html_escape(note)}</span>" : ''}</span><span class='tabular-nums text-gray-900'>#{value}</span></div>".html_safe }
  worksheet_path = manage_edit_money_show_financials_path(show, return_to: manage_money_settle_up_day_path(day.param))
%>
<section class="bg-white border border-gray-200 rounded-xl overflow-hidden" id="show-<%= show.id %>">
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3 border-b border-gray-200">
    <h2 class="text-base font-semibold text-gray-900">
      <%= show.display_name %>, <%= show.date_and_time.strftime("%-l:%M %p").sub(":00", "").downcase %>
      <span class="ml-2 text-xs font-medium <%= state_tone %>"><%= state_words %></span>
    </h2>
    <% if can_change && !day.settled? %>
      <%= form_with url: manage_check_show_money_settle_up_day_path(day.param, show_id: show.id), method: :patch, data: { controller: "auto-submit" } do %>
        <%= hidden_field_tag :checked, "0", id: nil %>
        <label class="inline-flex items-center gap-2 text-sm font-medium text-gray-700 cursor-pointer">
          <input type="checkbox" name="checked" value="1" <%= "checked" if piece.confirmed? %> data-action="change->auto-submit#submit"
                 class="h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
          Looks right
        </label>
      <% end %>
    <% end %>
  </div>
  <div class="px-5 py-3 grid grid-cols-1 lg:grid-cols-2 gap-x-8 gap-y-2">
    <div>
      <div class="text-[11px] font-medium uppercase tracking-wide text-gray-500">Tickets</div>
      <% if piece.ticket_lines.empty? %>
        <%= line.call("Tickets", (fin&.flat_fee? ? "a flat fee, not tickets" : "nothing entered yet"), "—") %>
      <% end %>
      <% online_lines.each do |l| %>
        <%= line.call("Sold through CocoScout", "from Ticketing", "#{l[:count]} · #{money.call(l[:cents])}") %>
      <% end %>
      <% if piece.listing && piece.outside_sources.any? %>
        <%= line.call("Outside tickets", outside_lines.map { |l| "#{l[:label]} #{l[:count]}" }.join(", ").presence || piece.outside_sources.map(&:name).join(", "),
              "#{outside_lines.sum { |l| l[:count] }} · #{money.call(outside_lines.sum { |l| l[:cents] })}" +
              (can_change && !day.settled? ? " <a href='##{'outside-' + show.id.to_s}' class='ml-2 text-pink-600 hover:text-pink-700' data-controller='modal' data-action='click->modal#open' data-modal-id='outside-#{show.id}'>Worksheet</a>" : "")) %>
      <% else %>
        <% outside_lines.each do |l| %>
          <%= line.call(l[:label], nil, "#{l[:count]} · #{money.call(l[:cents])}") %>
        <% end %>
      <% end %>
      <% if piece.listing %>
        <% sold = Ticket.where(ticket_order_id: piece.listing.ticket_orders.select(:id), status: Ticket::SOLD_STATUSES) %>
        <%= line.call("Checked in", nil, "#{sold.where(status: 'checked_in').count} of #{sold.count}") %>
      <% end %>
    </div>
    <div>
      <div class="text-[11px] font-medium uppercase tracking-wide text-gray-500">Everything else for this show</div>
      <%= line.call("Products at the door", nil, money.call(piece.products_cents)) %>
      <%= line.call("Other revenue", (fin&.normalized_other_revenue_details&.reject { |i| i.is_a?(Hash) && i["description"] == TicketSalesSync::PRODUCTS_LABEL }&.filter_map { |i| i.is_a?(Hash) ? i["description"] : nil }&.join(", ")), money.call(piece.other_revenue_cents)) %>
      <%= line.call("Expenses", (fin && fin.expense_items.any? ? pluralize(fin.expense_items.size, "item") : nil), money.call(piece.expenses_cents)) %>
      <% if fin&.flat_fee? %>
        <%= line.call("Flat fee instead of tickets", nil, money.call(piece.flat_fee_cents)) %>
      <% end %>
      <% if can_change && !day.settled? %>
        <div class="pt-1 text-sm">
          <%= link_to "Open the worksheet", worksheet_path, class: "text-pink-600 hover:text-pink-700" %>
          <span class="text-gray-400">·</span>
          <%= link_to "This show's page", manage_money_show_financials_path(show), class: "text-pink-600 hover:text-pink-700" %>
        </div>
      <% else %>
        <div class="pt-1 text-sm"><%= link_to "This show's page", manage_money_show_financials_path(show), class: "text-pink-600 hover:text-pink-700" %></div>
      <% end %>
    </div>
  </div>
  <% if piece.confirmed? && fin.updated_at %>
    <div class="px-5 py-2 border-t border-gray-100 text-xs text-gray-500">Checked <%= fin.updated_at.strftime("%b %-d at %-l:%M %p").downcase %>.</div>
  <% end %>
</section>
<% if piece.listing && piece.outside_sources.any? && can_change && !day.settled? %>
  <%= render "manage/ticket_listings/outside_sales_modal", id: "outside-#{show.id}", listing: piece.listing,
        sources: piece.outside_sources, rows: piece.listing.ticket_outside_sales.index_by { |row| [ row.ticket_source_id, row.ticket_tier_id ] },
        return_to: manage_money_settle_up_day_path(day.param) %>
<% end %>
