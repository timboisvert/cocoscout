<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light only, like the iOS app (Tim, 2026-10-12). -->
    <style name="Theme.CocoScout" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/pink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <!-- Opening the app shows pink, never white: the system splash
             (Android 12 and later) is plain pink with no icon, and the window
             stays pink until someone is signed in (MainActivity), so the
             pink landing draws straight onto it (Tim, 2026-11-23, for
             1.4.1). Android's splash can only be a color and one centered
             icon, so the wordmark and Coco arrive with the landing itself. -->
        <item name="android:windowBackground">@color/pink</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/pink</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="toolbarStyle">@style/Widget.CocoScout.Toolbar</item>
    </style>

    <!-- Page titles in Coustard on the left, as on iOS: 18sp, leaving room for the three icons. -->
    <style name="Widget.CocoScout.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="titleTextAppearance">@style/TextAppearance.CocoScout.Title</item>
    </style>

    <style name="TextAppearance.CocoScout.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/coustard_regular</item>
        <item name="fontFamily">@font/coustard_regular</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/gray_900</item>
    </style>
</resources>
