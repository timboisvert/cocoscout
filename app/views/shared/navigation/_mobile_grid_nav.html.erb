<%# App-style mobile navigation shared by every dashboard. A top bar with a
    hamburger opens a full-screen panel where the dashboard's nav items are laid
    out as a grid (the first/Home item full-width, the rest 3-up). Item lists and
    visibility come from the shared dashboard_nav_sections helper, so mobile and
    desktop always agree on who sees what.
    Locals: context, dashboard_label, dashboard_desc, current_dashboard. %>
<div data-controller="mobile-nav" class="fixed inset-x-0 top-0 z-30 border-b border-pink-100 bg-white lg:hidden">
  <%# ===== TOP BAR ===== %>
  <div class="flex items-center justify-between px-4 py-2.5">
    <button type="button" data-action="mobile-nav#toggle" class="p-1">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-pink-500">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
    <div class="absolute left-1/2 transform -translate-x-1/2 flex items-center gap-1.5">
      <%= image_tag "/icon.png", alt: "CocoScout", class: "h-5 w-5" %>
      <span class="text-lg text-pink-500 coustard-regular">CocoScout</span>
    </div>
    <div class="w-6"></div>
  </div>

  <%# ===== FULL-SCREEN PANEL ===== %>
  <%# Pinned dashboard switcher (top) and user info (bottom); the nav grid in
      between scrolls when it's too long. %>
  <div data-mobile-nav-target="panel" class="hidden fixed inset-0 top-[45px] bg-white z-40 flex flex-col">

    <% if impersonating? %>
      <div class="bg-amber-500 px-4 py-3 shrink-0">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 text-white flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
            <div>
              <div class="text-xs font-bold text-white uppercase tracking-wider">Impersonating</div>
              <div class="text-sm font-semibold text-white"><%= Current.user.person&.name || Current.user.email_address %></div>
            </div>
          </div>
          <%= render "shared/button", text: "Stop", variant: "outline", size: "small", path: stop_impersonating_user_path, data: { turbo_method: :post } %>
        </div>
      </div>
    <% end %>

    <%# ===== DASHBOARD SWITCHER (pinned) ===== %>
    <div class="shrink-0 px-4 pt-4 pb-3">
      <button type="button" data-action="mobile-nav#showDashboardPopup" class="w-full flex items-center justify-between hover:bg-gray-50 rounded-lg transition cursor-pointer">
        <div class="flex items-center gap-3 min-w-0 flex-1 text-left">
          <div class="w-9 h-9 rounded-lg bg-pink-100 flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-pink-600">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
            </svg>
          </div>
          <div class="min-w-0">
            <div class="text-base font-bold text-gray-900 truncate"><%= dashboard_label %></div>
            <div class="text-xs text-gray-500 truncate"><%= dashboard_desc %></div>
          </div>
        </div>
        <div class="p-2">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-400">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 15 12 18.75 15.75 15m-7.5-6L12 5.25 15.75 9" />
          </svg>
        </div>
      </button>
    </div>

    <%# ===== NAV GRID (scrolls) ===== %>
    <div class="flex-1 overflow-y-auto px-4 py-4 border-t border-gray-200">
      <% dashboard_nav_sections(context).each do |section| %>
        <% if section[:label].present? %>
          <div class="mt-5 mb-2 text-xs font-semibold uppercase tracking-wider text-gray-400"><%= section[:label] %></div>
        <% end %>
        <div class="grid grid-cols-3 gap-2.5">
          <% section[:items].each do |item| %>
            <%= render "shared/navigation/mobile_grid_tile", item: item, full: false %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# ===== FOOTER (pinned) ===== %>
    <div class="shrink-0 border-t border-gray-200 bg-gray-50 px-4 py-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3 min-w-0 flex-1">
          <% user_headshot_variant = Current.user.person&.safe_headshot_variant(:thumb) %>
          <% if user_headshot_variant %>
            <%= image_tag user_headshot_variant, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
          <% else %>
            <div class="w-10 h-10 rounded-lg bg-pink-100 text-pink-600 flex items-center justify-center font-bold text-sm flex-shrink-0">
              <%= Current.user.person&.initials || Current.user.email_address[0].upcase %>
            </div>
          <% end %>
          <div class="min-w-0">
            <div class="text-sm font-bold text-gray-900 truncate"><%= Current.user.person&.name || "My Account" %></div>
            <div class="text-xs text-gray-500 truncate"><%= Current.user.email_address %></div>
          </div>
        </div>
        <%= render "shared/button", text: "Menu", variant: "secondary", size: "small", type: :button, data: { action: "mobile-nav#showUserPopup" }, icon: "ellipsis-horizontal" %>
      </div>
    </div>

    <%= render "shared/navigation/mobile_dashboard_popup", current_dashboard: current_dashboard %>
    <%= render "shared/navigation/mobile_account_popup" %>
  </div>
</div>
