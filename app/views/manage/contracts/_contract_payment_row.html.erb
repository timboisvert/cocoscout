<%#
  Contract Payment Row

  A show_row-style row for displaying a contract payment.

  Outgoing payments (we pay them) are paid one way: added to the org's
  contractor payout run and sent to their bank via Stripe, alongside
  performers. There is no manual "mark paid" for outgoing money.

  Incoming payments (they pay us) can be recorded by hand for money that
  arrived offline (a check, a bank transfer).

  Required params:
    - payment: ContractPayment object

  Optional params:
    - show_actions: Whether to show action buttons/modals (default: true)
    - deductions: charges that settle by being netted out of THIS payment
      (see Contract#payment_schedule_groups). They're folded in here rather
      than listed as peers, because they're not money anyone has to collect.
%>
<%
  show_actions = local_assigns.fetch(:show_actions) { local_assigns.fetch(:show_mark_received, true) }
  deductions = local_assigns.fetch(:deductions, [])
  deduction_total = deductions.sum { |d| d.amount.to_f }
  contract = payment.contract
  contractor = contract.contractor
  is_late = payment.late?
  is_incoming = payment.direction_incoming?
  is_cancelled = payment.status_cancelled?
  # A settlement that came to exactly nothing — covered to the penny.
  settled_to_nothing = payment.nothing_to_hand_back?
  contractor_person = contractor&.person
  amount_set = !payment.amount_tbd? && payment.amount.to_f.positive?
  in_run = payment.in_payout_run?
  has_bank = contractor_person&.can_receive_payouts?
  # A contractor rides the payout run exactly like a performer: the moment
  # there's a Person to pay, the money can be staged. The run parks them on
  # "Waiting on bank info" and sends it the day their bank lands.
  payable = contractor_person.present?
  # Money that arrived is recorded however it came — the contract's accepted
  # methods are what the PAYER is told, not a gate on recording a fact.
  offline_allowed = true
  # Paying THEM by hand (Zelle/check/cash) — for the contractor who never
  # connected a bank, which is exactly who a payout run can't reach. Offered
  # only for the ways the org said it pays people, in Money settings, and only
  # when there's something left to hand over after services are netted out.
  offline_pay_methods = Current.organization.offline_payout_method_choices
  # Only charges still waiting to be netted — an already-deducted one took its
  # cut long ago (matches Manage::ContractPaymentsController#deductible_services).
  pending_deductions = deductions.select { |d| d.status_pending? && d.deduct_from_payout? }
  pending_deduction_total = pending_deductions.sum { |d| d.amount.to_f }
  net_to_hand_over = payment.amount.to_f - pending_deduction_total
  offline_pay_id = "pay-offline-#{payment.id}"
  # Deliberately only for people a payout run can't reach: if they've connected a
  # bank, the run is the way (same rule as the show payout page).
  can_pay_offline = !is_incoming && payment.status_pending? && !in_run && amount_set &&
    !has_bank && net_to_hand_over.positive? && offline_pay_methods.any?
  # Ticket-linked amounts land on their own once show financials are in.
  awaits_financials = payment.amount_tbd? &&
    (payment.revenue_share? || contract.revenue_share? || contract.ticket_revenue_minus_fee?)
  # A minus-fee settlement waiting on ticket sales isn't a mystery: our fee is
  # ours whatever the night sells (a night that sells under it becomes a
  # shortfall they owe us), and so is anything deducted from the payout. Only
  # the remainder we hand back is unknown — so the row names the money we're
  # sure of instead of a bare "TBD".
  awaiting_amount = payment.awaiting_amount?
  held_back_fee = payment.guaranteed_fee
  our_take = held_back_fee ? (held_back_fee + deduction_total).round(2) : nil
  # Where the payment's title links. Send people to where the money actually
  # lives: incoming money → its Collect/record page; an outgoing amount that was
  # calculated on a show's payout page → back to that payout page; otherwise the
  # contract itself.
  payment_link =
    if is_incoming
      manage_money_incoming_payment_path(payment)
    elsif payment.show_id.present?
      manage_money_show_payout_path(payment.show_id)
    else
      manage_contract_path(contract)
    end
  # Other pending payments this one could absorb (Combine): same direction,
  # nothing settled, committed, or ticket-synced. Offered on incoming money —
  # "several small invoices to pay" is the payer's problem this solves.
  combine_candidates = show_actions && is_incoming && payment.combinable? ?
    contract.contract_payments.status_pending.by_due_date.to_a
            .reject { |p| p.id == payment.id }
            .select { |p| p.combinable? && p.direction == payment.direction } : []
  combine_modal_id = "combine-payment-#{payment.id}"
  split_confirm_id = "confirm-split-payment-#{payment.id}"
  can_split = show_actions && payment.combined? && payment.status_pending? && !in_run
%>

<div data-controller="payment-modal">
<%# No "Late" badge: the pink wash and the "overdue" line under the amount
    already say it. %>
<div class="flex items-stretch px-3 py-2 border rounded-lg transition-all group <%= is_late ? 'bg-pink-50 border-pink-300' : 'bg-white border-gray-200 hover:border-gray-400' %><%= ' opacity-60' if is_cancelled %>">
  <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-0 w-full">
    <%# Left Section: Date & Payment Details %>
    <div class="w-full md:w-1/2 flex items-center gap-4">
      <%# Date Box %>
      <div class="flex-shrink-0 w-14 text-center">
        <div class="text-xs font-semibold <%= is_late ? 'text-pink-600' : 'text-pink-600' %> uppercase"><%= payment.due_date.strftime("%b") %></div>
        <div class="text-2xl font-bold <%= is_late ? 'text-pink-700' : 'text-gray-900' %>"><%= payment.due_date.strftime("%-d") %></div>
        <div class="text-xs <%= is_late ? 'text-pink-500' : 'text-gray-500' %>"><%= payment.due_date.strftime("%a") %></div>
      </div>

      <%# Payment Details %>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <% if is_cancelled %>
            <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/20">
              Cancelled
            </span>
          <% end %>
          <span class="font-medium text-gray-900">
            <%= link_to (contract.production_name.presence || contract.contractor_name), payment_link, class: "hover:text-pink-600" %>
          </span>
        </div>
        <div class="text-sm text-gray-600">
          <% if contract.production_name.present? %>
            <%= contract.contractor_name %> &middot;
          <% end %>
          <%= payment.display_name %><%= " and #{number_to_currency(deduction_total)} services" if deductions.any? %>
          <span class="text-gray-400"><%= is_incoming ? "(they pay us)" : "(we pay them)" %></span>
        </div>
        <% if payment.includes_services? || payment.combined? %>
          <%# Services they pay for on this event — and any payments combined
              into this one — ride inside this one payment: one amount, one
              pay link, not a second row to chase. %>
          <div class="text-xs text-gray-500 mt-0.5">
            <%= number_to_currency(payment.base_amount) %> <%= payment.folded_services_summary %>
          </div>
        <% end %>

        <% if deductions.any? %>
          <%# Netted out of this payment when it settles — never invoiced, so
              they sit inside this row instead of standing beside it. %>
          <details class="mt-1 group/deductions">
            <summary class="text-xs text-purple-700 hover:text-purple-900 cursor-pointer select-none">
              <%= pluralize(deductions.size, "charge") %> deducted from this payment
            </summary>
            <ul class="mt-1 ml-1 space-y-0.5 border-l-2 border-purple-200 pl-3">
              <% deductions.each do |charge| %>
                <li class="text-xs text-gray-600 flex items-baseline justify-between gap-3">
                  <span class="truncate"><%= charge.description %></span>
                  <span class="tabular-nums text-gray-700 flex-shrink-0">−<%= number_to_currency(charge.amount) %></span>
                </li>
              <% end %>
            </ul>
          </details>
        <% end %>
      </div>
    </div>

    <%# Right Section: Amount & Actions %>
    <div class="w-full md:w-1/2 flex items-center justify-between border-t border-gray-100 md:border-t-0 md:border-l md:border-gray-200 mt-2 md:mt-0 pt-2 md:pt-0 md:pl-4">
      <div class="flex-1">
        <div class="text-2xl font-bold <%= is_cancelled ? 'text-gray-400 line-through' : (is_incoming || our_take) ? 'text-green-600' : 'text-red-600' %>">
          <% if our_take %>
            <%= number_to_currency(our_take) %>
          <% elsif awaiting_amount %>
            TBD
          <% elsif deductions.any? %>
            <%# The number that matters is what actually moves: the share net of
                the services deducted from it. The gross is in the line below. %>
            <%= number_to_currency(payment.amount.to_f - deduction_total) %>
          <% else %>
            <%= number_to_currency(payment.amount) %>
          <% end %>
        </div>
        <% if deductions.any? && !awaiting_amount %>
          <div class="text-xs text-gray-500 tabular-nums">
            <%= number_to_currency(payment.amount) %> − <%= number_to_currency(deduction_total) %> services
          </div>
        <% end %>
        <% if our_take %>
          <div class="text-xs text-gray-500">
            our <%= number_to_currency(held_back_fee) %> fee<%= " + #{number_to_currency(deduction_total)} services" if deductions.any? %> — the rest of ticket sales goes back to them
          </div>
        <% elsif payment.amount_tbd? && payment.amount.to_f > 0 %>
          <div class="text-xs text-amber-600">
            Partial — some shows still pending
          </div>
        <% elsif settled_to_nothing %>
          <div class="text-xs text-gray-500">
            Ticket sales covered the fee exactly — nothing to hand back
          </div>
        <% elsif is_late %>
          <div class="text-xs text-pink-600">
            <%= distance_of_time_in_words(payment.due_date, Date.current) %> overdue
          </div>
        <% elsif payment.revenue_share? && !payment.amount_tbd? && payment.notes&.include?("Auto-calculated") %>
          <div class="text-xs text-gray-500">
            from show financials
          </div>
        <% elsif payment.notes&.include?("Auto-synced from course") %>
          <div class="text-xs text-green-600">
            synced from course payout
          </div>
        <% end %>
      </div>

      <% if payment.status_paid? %>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-green-100 px-2 py-1 text-xs font-medium text-green-700">
            <%= icon("check-circle", class: "w-4 h-4 mr-1 inline") %>
            Paid<%= payment.paid_date ? " #{payment.paid_date.strftime('%b %-d')}" : "" %><%= " · #{payment.offline_payment_method_label}" if payment.offline_payment_method_label %>
          </span>
          <%# Money they paid through CocoScout is held for the org until the
              remittance run sends it on — say where it is, right on the row. %>
          <% if show_actions %>
            <% case payment.remittance_stage %>
            <% when :to_pay %>
              <% if Current.organization.can_receive_payouts? %>
                <%= render "shared/button", text: "Add to payout run", variant: "primary", size: "xs",
                      path: manage_remit_money_incoming_payment_path(payment), method: :post %>
              <% else %>
                <%= link_to "Held for you — connect a bank", manage_money_incoming_payment_path(payment),
                      class: "inline-flex items-center rounded-md bg-amber-100 px-2 py-1 text-xs font-medium text-amber-700 hover:bg-amber-200 transition-colors" %>
              <% end %>
            <% when :in_draft %>
              <%= link_to "In payout run", manage_payout_batch_path(payment.payout_contribution.payout_batch),
                    class: "inline-flex items-center rounded-md bg-blue-100 px-2 py-1 text-xs font-medium text-blue-700 hover:bg-blue-200 transition-colors" %>
            <% when :in_flight %>
              <%= link_to "On its way to your bank", manage_payout_batch_path(payment.payout_contribution.payout_batch),
                    class: "inline-flex items-center rounded-md bg-blue-100 px-2 py-1 text-xs font-medium text-blue-700 hover:bg-blue-200 transition-colors" %>
            <% end %>
          <% end %>
          <%# Amounts settled through a payout run are fixed by the transfer. %>
          <% if show_actions && !in_run %>
            <%= render "shared/button", text: (payment.amount_tbd? ? "Set Amount" : "Edit"),
                  variant: "secondary", size: "xs", icon: "pencil", type: :button,
                  data: { action: "click->payment-modal#open" } %>
          <% end %>
        </div>
      <% elsif show_actions && payment.status_pending? %>
        <%
          # The row keeps one status badge and at most ONE primary button;
          # every secondary action lives behind the kebab menu, so the cluster
          # reads the same whether a payment has zero extra actions or five.
          is_deduct = is_incoming && payment.deduct_from_payout?
          can_copy_link = is_incoming && !is_deduct && payment.collectable_online?
          can_record = is_incoming && !is_deduct && offline_allowed
          can_deduct = is_incoming && !is_deduct && contract.contractor.present? && contract.outgoing_settlement?
          can_edit_amount = !is_incoming && amount_set && !in_run
          menu_any = !in_run && (can_copy_link || can_record || can_deduct || is_deduct ||
                                 combine_candidates.any? || can_split || can_edit_amount || can_pay_offline)
          menu_item_classes = "w-full flex items-center gap-2 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer bg-transparent border-0 text-left"
        %>
        <div class="flex items-center gap-1.5">
          <% if in_run %>
            <%= link_to "In payout run", manage_payout_batch_path(payment.payout_contribution.payout_batch),
                  class: "inline-flex items-center rounded-md bg-blue-100 px-2 py-1 text-xs font-medium text-blue-700 hover:bg-blue-200 transition-colors" %>
          <% elsif is_deduct %>
            <%# Settling out of their payout: no pay link, no collecting — it
                nets automatically when their share joins a payout run. %>
            <span class="inline-flex items-center rounded-md bg-purple-100 px-2 py-1 text-xs font-medium text-purple-700"
                  title="Nets against their share automatically when it's added to a payout run.">
              Deducts from payout
            </span>
          <% elsif is_incoming %>
            <%# The Collect page is the one place money they owe gets chased:
                pay link + QR, reminders, recording an offline payment. %>
            <%= link_to manage_money_incoming_payment_path(payment) do %>
              <%= render "shared/button", text: "Collect", variant: "primary", size: "xs", icon: "banknotes" %>
            <% end %>
          <% elsif awaits_financials && !amount_set %>
            <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-500"
                  title="This settles once you enter ticket sales for the shows on this contract.">
              Awaiting ticket sales
            </span>
          <% elsif settled_to_nothing %>
            <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-500">
              Settled
            </span>
          <% elsif !amount_set %>
            <%= render "shared/button", text: "Set amount", variant: "secondary", size: "xs",
                  icon: "pencil", type: :button, data: { action: "click->payment-modal#open" } %>
          <% elsif payable %>
            <% add_to_run_cid = "confirm-add-to-payout-run-#{payment.id}" %>
            <%= render "shared/button", text: "Add to payout run", variant: "primary", size: "xs",
                  icon: "banknotes", type: :button,
                  data: { controller: "modal", action: "click->modal#open", modal_id: add_to_run_cid } %>
            <%# confirm_modal renders `message` as HTML, so the name is escaped here. %>
            <%= render "shared/confirm_modal", id: add_to_run_cid,
                  title: "Add to payout run?",
                  message: has_bank ? "Add this payment to your contractor payout run?" :
                    "Add this payment to your contractor payout run? #{h(contractor&.name)} hasn't connected a bank yet, so their share waits on the run until they do.",
                  confirm_text: "Add to payout run",
                  url: add_to_payout_run_manage_contract_contract_payment_path(contract, payment),
                  method: :post %>
          <% else %>
            <%# Nobody to pay: the contractor has no CocoScout person behind it,
                so there's no payee for a run to carry. Link one and the run
                opens up (a bank can come later). Paying by hand lives in the
                menu meanwhile. %>
            <%= link_to contractor ? manage_contractor_path(contractor) : "#",
                  class: "inline-flex items-center rounded-md bg-amber-100 px-2 py-1 text-xs font-medium text-amber-700 hover:bg-amber-200 transition-colors",
                  title: "Link a CocoScout person to this contractor before a payout run can pay them." do %>
              Needs a person
            <% end %>
          <% end %>

          <% if menu_any %>
            <div class="relative" data-controller="dropdown modal">
              <button type="button" data-action="click->dropdown#toggle" title="More actions"
                      class="p-1.5 text-gray-400 hover:text-gray-600 rounded-md border border-gray-200 hover:border-gray-400 bg-white transition-colors cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/>
                </svg>
              </button>
              <div data-dropdown-target="menu"
                   class="hidden absolute right-0 top-full mt-1 w-56 bg-white rounded-lg shadow-lg border border-gray-200 py-1 z-50">
                <% if can_copy_link %>
                  <%# One pay link, no login needed to pay it. %>
                  <div data-controller="clipboard">
                    <input type="hidden" data-clipboard-target="textField"
                           value="<%= pay_contract_url(token: payment.payment_token!) %>">
                    <button type="button" data-action="click->clipboard#copy" class="<%= menu_item_classes %>">
                      <%= icon("link", class: "w-4 h-4 text-gray-400") %> Copy pay link
                    </button>
                  </div>
                <% end %>
                <% if can_record %>
                  <button type="button" data-action="click->payment-modal#open" class="<%= menu_item_classes %>"
                          title="Record a payment that arrived another way — a check, a bank transfer.">
                    <%= icon("check-circle", class: "w-4 h-4 text-gray-400") %> Record a payment
                  </button>
                <% end %>
                <% if combine_candidates.any? %>
                  <button type="button" data-action="click->modal#open" data-modal-id="<%= combine_modal_id %>" class="<%= menu_item_classes %>"
                          title="Fold other payments they owe into this one — one amount, one pay link.">
                    <%= icon("plus-circle", class: "w-4 h-4 text-gray-400") %> Combine payments
                  </button>
                <% end %>
                <% if can_split %>
                  <button type="button" data-action="click->modal#open" data-modal-id="<%= split_confirm_id %>" class="<%= menu_item_classes %>"
                          title="Put the combined payments back into their own rows.">
                    <%= icon("arrow-up-right", class: "w-4 h-4 text-gray-400") %> Split combined payments
                  </button>
                <% end %>
                <% if can_deduct %>
                  <%= button_to settlement_manage_contract_contract_payment_path(contract, payment, settlement_method: "payout_deduction"),
                        method: :patch, form_class: "w-full", class: menu_item_classes,
                        title: "Stop collecting this — net it out of their payout instead" do %>
                    <%= icon("banknotes", class: "w-4 h-4 text-gray-400") %><span>Deduct from payout</span>
                  <% end %>
                <% end %>
                <% if is_deduct %>
                  <%= button_to settlement_manage_contract_contract_payment_path(contract, payment, settlement_method: "direct"),
                        method: :patch, form_class: "w-full", class: menu_item_classes do %>
                    <%= icon("banknotes", class: "w-4 h-4 text-gray-400") %><span>Have them pay it</span>
                  <% end %>
                <% end %>
                <% if can_edit_amount %>
                  <button type="button" data-action="click->payment-modal#open" class="<%= menu_item_classes %>">
                    <%= icon("pencil", class: "w-4 h-4 text-gray-400") %> Edit amount
                  </button>
                <% end %>
                <% if can_pay_offline %>
                  <button type="button" data-action="click->modal#open" data-modal-id="<%= offline_pay_id %>" class="<%= menu_item_classes %>"
                          title="Record money you sent them outside CocoScout — Zelle, a check, cash.">
                    <%= icon("check-circle", class: "w-4 h-4 text-gray-400") %> Paid another way
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# Fold other payments they owe into this one — one amount, one pay link %>
<% if combine_candidates.any? %>
  <%= render "manage/contracts/combine_payments_modal", id: combine_modal_id,
        payment: payment, contract: contract, candidates: combine_candidates %>
<% end %>

<%# Put combined payments back into their own rows %>
<% if can_split %>
  <%= render "shared/confirm_modal", id: split_confirm_id,
        title: "Split this payment?",
        message: "#{payment.merged_components.size == 1 ? 'The payment folded into this one gets' : "The #{payment.merged_components.size} payments folded into this one get"} their own rows and due dates back, each with a fresh pay link.",
        confirm_text: "Split them out",
        url: split_manage_contract_contract_payment_path(contract, payment),
        method: :post %>
<% end %>

<%# Money we sent them by hand, for a payment no payout run can settle %>
<% if show_actions && can_pay_offline %>
  <%= render "manage/contracts/offline_pay_modal", id: offline_pay_id, payment: payment,
        contract: contract, methods: offline_pay_methods, net_amount: net_to_hand_over,
        deductions: pending_deductions %>
<% end %>

<%# Compute suggested amount for TBD payments (used by both modals) %>
<% suggestion = payment.amount_tbd? ? payment.suggested_amount_from_financials : nil %>

<%# Modal for recording an incoming payment that arrived outside Stripe %>
<% if show_actions && payment.status_pending? && is_incoming && offline_allowed %>
  <div id="mark-payment-received-<%= payment.id %>" class="hidden fixed inset-0 z-50" data-payment-modal-target="modal">
    <div class="fixed inset-0 bg-black/50" data-action="click->payment-modal#close"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full overflow-hidden" data-payment-modal-target="content">
        <div class="flex items-center justify-between px-6 py-4 bg-pink-600">
          <h3 class="text-lg font-bold text-white">Record Payment Received</h3>
          <button type="button" data-action="click->payment-modal#close" class="text-white/80 hover:text-white">
            <%= icon("x-mark", class: "w-5 h-5") %>
          </button>
        </div>

        <div class="p-6">
        <p class="text-sm text-gray-600 mb-4">
          For money that arrived outside CocoScout — a check or a direct bank transfer.
        </p>

        <div class="mb-6">
          <div class="bg-gray-50 rounded-lg p-4 text-center">
            <div class="text-sm text-gray-500 mb-1">Payment Amount</div>
            <% if payment.amount_tbd? && suggestion %>
              <div class="text-3xl font-bold text-green-600"><%= number_to_currency(suggestion[:amount]) %></div>
              <div class="text-xs text-gray-500 mt-1"><%= suggestion[:explanation] %></div>
            <% elsif payment.amount_tbd? && payment.amount.to_f == 0 %>
              <div class="text-3xl font-bold text-gray-400">TBD</div>
            <% else %>
              <div class="text-3xl font-bold text-green-600"><%= number_to_currency(payment.amount) %></div>
            <% end %>
            <div class="text-sm text-gray-600 mt-2">
              <%= contract.contractor_name %> · <%= payment.description.presence || "Payment" %>
            </div>
          </div>
        </div>

        <% if suggestion && suggestion[:shows].present? %>
          <div class="bg-blue-50 rounded-lg p-3 mb-4">
            <div class="text-xs font-medium text-blue-700 mb-1">Show Financials</div>
            <% suggestion[:shows].each do |show| %>
              <div class="flex justify-between text-sm">
                <span class="text-blue-600"><%= show.date_and_time.strftime("%b %-d") %> — <%= show.display_name %></span>
                <span class="font-medium text-blue-900"><%= number_to_currency(show.show_financials.total_revenue) %></span>
              </div>
            <% end %>
            <div class="flex justify-between text-sm font-semibold border-t border-blue-200 mt-1 pt-1">
              <span class="text-blue-700">Total Revenue</span>
              <span class="text-blue-900"><%= number_to_currency(suggestion[:total_revenue]) %></span>
            </div>
          </div>
        <% end %>

        <%= form_with url: mark_paid_manage_contract_contract_payment_path(contract, payment), method: :post, data: { turbo: false } do |f| %>
          <%
            expected_amount = payment.amount.to_f
            prefilled_amount = if suggestion
                                 suggestion[:amount]
                               elsif expected_amount > 0
                                 expected_amount
                               end
          %>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Amount Received</label>
              <div class="relative">
                <span class="absolute left-3 top-2.5 text-gray-500">$</span>
                <%= number_field_tag :payment_amount, prefilled_amount, step: 0.01, min: 0, placeholder: "0.00", class: "block w-full pl-7 pr-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
              </div>
              <% if payment.amount_tbd? && suggestion %>
                <div class="text-xs text-gray-500 mt-1">Pre-filled from contract terms · <%= suggestion[:explanation] %></div>
              <% elsif !payment.amount_tbd? && expected_amount > 0 %>
                <div class="text-xs text-gray-500 mt-1">Expected: <%= number_to_currency(expected_amount) %>. Adjust if a different amount actually arrived.</div>
              <% end %>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Date Received</label>
              <%= date_field_tag :paid_date, Date.current, class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">How it arrived</label>
              <%# Every way money arrives; the ones this contract told them they
                  may use come first. %>
              <%
                allowed = contract.offline_payment_methods
                method_options = ContractPayment::RECEIVED_PAYMENT_METHODS
                  .sort_by { |(_label, value)| allowed.include?(value) ? 0 : 1 }
              %>
              <%= select_tag :payment_method,
                options_for_select([["Select method...", ""]] + method_options),
                class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Reference/Check # (optional)</label>
              <%= text_field_tag :reference_number, nil, placeholder: "e.g., Check #1234", class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
            </div>
          </div>

          <div class="mt-6 flex gap-3">
            <button type="button" data-action="click->payment-modal#close" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
              Cancel
            </button>
            <%= render "shared/button", text: "Record Payment", variant: "primary", size: "medium", type: :submit, classes: "flex-1" %>
          </div>
        <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%# Modal for setting/editing the amount (pending outgoing, or an already-recorded payment) %>
<% if show_actions && ((payment.status_pending? && !is_incoming) || payment.status_paid?) %>
  <div id="set-amount-<%= payment.id %>" class="hidden fixed inset-0 z-50" data-payment-modal-target="modal">
    <div class="fixed inset-0 bg-black/50" data-action="click->payment-modal#close"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full overflow-hidden" data-payment-modal-target="content">
        <div class="flex items-center justify-between px-6 py-4 bg-pink-600">
          <h3 class="text-lg font-bold text-white"><%= payment.amount_tbd? ? "Set Payment Amount" : "Edit Payment Amount" %></h3>
          <button type="button" data-action="click->payment-modal#close" class="text-white/80 hover:text-white">
            <%= icon("x-mark", class: "w-5 h-5") %>
          </button>
        </div>

        <div class="p-6">
        <div class="mb-4 text-sm text-gray-600">
          <%= contract.contractor_name %> · <%= payment.description.presence || "Payment" %>
          <% if payment.paid_date %> · Paid <%= payment.paid_date.strftime("%b %-d") %><% end %>
        </div>

        <% if suggestion && suggestion[:shows].present? %>
          <div class="bg-blue-50 rounded-lg p-3 mb-4">
            <div class="text-xs font-medium text-blue-700 mb-1">Show Financials</div>
            <% suggestion[:shows].each do |show| %>
              <div class="flex justify-between text-sm">
                <span class="text-blue-600"><%= show.date_and_time.strftime("%b %-d") %> — <%= show.display_name %></span>
                <span class="font-medium text-blue-900"><%= number_to_currency(show.show_financials.total_revenue) %></span>
              </div>
            <% end %>
            <div class="flex justify-between text-sm font-semibold border-t border-blue-200 mt-1 pt-1">
              <span class="text-blue-700">Total Revenue</span>
              <span class="text-blue-900"><%= number_to_currency(suggestion[:total_revenue]) %></span>
            </div>
          </div>
          <% if suggestion[:amount] %>
            <div class="bg-green-50 rounded-lg p-3 mb-4">
              <div class="text-xs font-medium text-green-700">Suggested Amount (<%= suggestion[:explanation] %>)</div>
              <div class="text-xl font-bold text-green-800"><%= number_to_currency(suggestion[:amount]) %></div>
            </div>
          <% end %>
        <% end %>

        <%= form_with url: manage_contract_contract_payment_path(contract, payment), scope: :contract_payment, method: :patch, data: { turbo: false } do |f| %>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Amount</label>
              <div class="relative">
                <span class="absolute left-3 top-2.5 text-gray-500">$</span>
                <%= f.number_field :amount, value: (suggestion ? suggestion[:amount] : (payment.amount.to_f > 0 ? payment.amount : nil)), step: 0.01, min: 0, placeholder: "0.00", class: "block w-full pl-7 pr-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
              </div>
              <% if suggestion %>
                <div class="text-xs text-gray-500 mt-1">Pre-filled from contract terms · <%= suggestion[:explanation] %></div>
              <% end %>
            </div>
          </div>

          <%= f.hidden_field :amount_tbd, value: "false" %>

          <div class="mt-6 flex gap-3">
            <button type="button" data-action="click->payment-modal#close" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
              Cancel
            </button>
            <%= render "shared/button", text: "Save Amount", variant: "primary", size: "medium", type: :submit, classes: "flex-1" %>
          </div>
        <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
</div>
