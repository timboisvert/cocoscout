<% content_for :title, @contractor.name %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Money", manage_money_index_path],
      ["Contracts", manage_contracts_path],
      ["Contractors", manage_contractors_path]
    ],
    text: @contractor.name,
    links: [
      { icon: "pencil", text: "Edit", path: edit_manage_contractor_path(@contractor) },
      { icon: "plus", text: "New Contract", path: manage_new_contract_wizard_path(contractor_id: @contractor.id) }
    ]
  } %>

  <%# Contractor Details Card %>
  <div class="border border-gray-200 rounded-lg overflow-hidden mb-8">
    <%= render "shared/card_header", title: "Contact Information" %>
    <div class="p-4">
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% if @contractor.email.present? %>
          <div>
            <dt class="text-sm font-medium text-gray-500">Email</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= mail_to @contractor.email, @contractor.email, class: "text-pink-600 hover:text-pink-700" %>
            </dd>
          </div>
        <% end %>

        <% if @contractor.phone.present? %>
          <div>
            <dt class="text-sm font-medium text-gray-500">Phone</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @contractor.phone %></dd>
          </div>
        <% end %>

        <% if @contractor.address.present? %>
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Address</dt>
            <dd class="mt-1 text-sm text-gray-900 whitespace-pre-line"><%= @contractor.address %></dd>
          </div>
        <% end %>

        <% if @contractor.notes.present? %>
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Notes</dt>
            <dd class="mt-1 text-sm text-gray-900 whitespace-pre-line"><%= @contractor.notes %></dd>
          </div>
        <% end %>
      </dl>

      <% if @contractor.email.blank? && @contractor.phone.blank? && @contractor.address.blank? %>
        <p class="text-sm text-gray-500">No contact information on file.</p>
      <% end %>
    </div>
  </div>

  <%# Associated person — who this contractor IS (search existing or invite new) %>
  <div class="border border-gray-200 rounded-lg overflow-hidden mb-8"
       data-controller="invite-search" data-invite-search-url-value="<%= search_for_invite_manage_people_path %>">
    <%= render "shared/card_header", title: "Associated person" %>
    <div class="p-4">
      <% if @person %>
        <div class="flex items-center justify-between gap-3 mb-3">
          <div class="flex items-center gap-3 min-w-0">
            <% variant = @person.safe_headshot_variant(:thumb) %>
            <% if variant %>
              <%= image_tag variant, alt: @person.name, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
            <% else %>
              <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center text-pink-600 font-bold text-sm flex-shrink-0"><%= @person.initials %></div>
            <% end %>
            <div class="min-w-0">
              <div class="font-medium text-gray-900 truncate"><%= @person.name %></div>
              <div class="text-sm text-gray-500 truncate"><%= @person.email %></div>
            </div>
          </div>
        </div>
      <% else %>
        <p class="text-sm text-gray-600 mb-3">
          This contractor isn't linked to a person yet. Link who they are so they can log in, see their contracts, and get paid.
        </p>
      <% end %>

      <details class="group">
        <summary class="inline-flex items-center gap-1.5 cursor-pointer text-sm font-medium text-pink-600 hover:text-pink-700 list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <%= @person ? "Change person" : "Link a person" %>
        </summary>

        <div class="mt-4 border-t border-gray-100 pt-4">
          <%= form_with url: link_person_manage_contractor_path(@contractor), method: :post do %>
            <input type="hidden" name="person_id" data-invite-search-target="selectedPersonIdInput">

            <%# Step 1: search %>
            <div data-invite-search-target="searchSection">
              <label class="block text-sm font-medium text-gray-700 mb-1">Search CocoScout by name or email</label>
              <input type="text"
                     data-invite-search-target="input"
                     data-action="input->invite-search#search"
                     placeholder="Search by name or email…"
                     class="block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-pink-500 focus:ring-pink-500">
              <div data-invite-search-target="results" class="mt-3"></div>
              <div class="mt-3">
                <button type="button" class="text-sm font-medium text-pink-600 hover:text-pink-700" data-action="invite-search#showInviteForm">
                  <%= icon("user-plus", class: "w-4 h-4 inline mr-1") %> Can't find them? Invite by email
                </button>
              </div>
            </div>

            <%# Selected existing person %>
            <div data-invite-search-target="selectedPerson" class="hidden">
              <div class="flex items-center justify-between gap-3 p-3 bg-pink-50 border border-pink-200 rounded-lg">
                <div class="min-w-0">
                  <div class="font-medium text-gray-900 truncate" data-invite-search-target="selectedPersonName"></div>
                  <div class="text-sm text-gray-500 truncate" data-invite-search-target="selectedPersonEmail"></div>
                </div>
                <button type="button" class="text-sm font-medium text-pink-600 hover:text-pink-700 flex-shrink-0" data-action="invite-search#backToSearch">Change</button>
              </div>
            </div>

            <%# Invite-new details (hidden until "Invite by email" or selecting a person) %>
            <div data-invite-search-target="inviteForm" class="hidden mt-3">
              <div data-invite-search-target="personDetailsSection" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-medium text-gray-500 mb-1">Name</label>
                  <input type="text" name="invite_name" data-invite-search-target="inviteName"
                         class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink-500 focus:ring-pink-500">
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-500 mb-1">Email</label>
                  <input type="email" name="invite_email" data-invite-search-target="inviteEmail" autocapitalize="none"
                         class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink-500 focus:ring-pink-500">
                </div>
              </div>
              <div class="flex justify-end mt-3">
                <%= render "shared/button", text: "Link person", variant: "primary", size: "small", type: :submit %>
              </div>
            </div>
          <% end %>
        </div>
      </details>
    </div>
  </div>

  <%# Getting paid — Stripe bank connection %>
  <div class="border border-gray-200 rounded-lg overflow-hidden mb-8">
    <%= render "shared/card_header", title: "Getting paid" %>
    <div class="p-4">
      <% if @person.nil? %>
        <p class="text-sm text-gray-600">Link a person above first — that's who connects a bank and gets paid.</p>
      <% elsif @person.can_receive_payouts? %>
        <div class="flex items-center gap-2 text-sm text-green-700">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="font-medium">Bank connected.</span>
          <span class="text-gray-600">You can pay this contractor through a payout run, straight to their bank.</span>
        </div>
      <% else %>
        <p class="text-sm text-gray-600 mb-3">
          <% if @person.connect_account_started? %>
            This contractor started bank setup but hasn't finished. Send them the link again to complete it.
          <% else %>
            Send this contractor a secure link to connect their bank, so you can pay them through CocoScout — no account needed on their end.
          <% end %>
        </p>
        <%= render "shared/copy_url",
          url: @payment_setup_url,
          label: "Bank setup link",
          copy_button_text: "Copy link",
          help_text: "Email this to #{@person.email}. The link expires in 30 days." %>
      <% end %>
    </div>
  </div>

  <%# CocoScout access — invite the contractor to log in and see their contracts %>
  <div class="border border-gray-200 rounded-lg overflow-hidden mb-8">
    <%= render "shared/card_header", title: "CocoScout access" %>
    <div class="p-4">
      <% if @person.nil? %>
        <p class="text-sm text-gray-600">Link a person above first — then you can invite them to CocoScout.</p>
      <% elsif @person.user.present? %>
        <div class="flex items-center gap-2 text-sm text-green-700">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="font-medium">Has access.</span>
          <span class="text-gray-600">They can log in to see their contracts and set up payment.</span>
        </div>
      <% else %>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-sm text-gray-600 max-w-md">
            <% if @pending_invitation %>
              Invited <%= @pending_invitation.created_at.strftime("%b %-d") %> — waiting for them to accept. They'll be able to see their contracts and set up payment.
            <% else %>
              Invite this contractor to CocoScout so they can log in, view their contracts, and connect their bank. They only see their own contracts — not your producer views.
            <% end %>
          </p>
          <%= button_to invite_manage_contractor_path(@contractor), method: :post, class: "flex-shrink-0" do %>
            <%= render "shared/button", text: @pending_invitation ? "Resend invite" : "Invite to CocoScout", variant: @pending_invitation ? "secondary" : "primary", size: "small" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Active Contracts %>
  <% if @active_contracts.any? || @draft_contracts.any? %>
    <div class="border border-gray-200 rounded-lg overflow-hidden mb-8">
      <%= render "shared/card_header", title: "Active Contracts" %>
      <div class="p-4 space-y-2">
        <% @active_contracts.each do |contract| %>
          <%= render "manage/contracts/contract_list_row", contract: contract %>
        <% end %>
        <% @draft_contracts.each do |contract| %>
          <%= render "manage/contracts/contract_list_row", contract: contract %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Past Contracts %>
  <% if @completed_contracts.any? %>
    <div class="border border-gray-200 rounded-lg overflow-hidden mb-8">
      <%= render "shared/card_header", title: "Past Contracts" %>
      <div class="p-4 space-y-2">
        <% @completed_contracts.each do |contract| %>
          <%= render "manage/contracts/contract_list_row", contract: contract %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Empty state %>
  <% if @active_contracts.empty? && @draft_contracts.empty? && @completed_contracts.empty? %>
    <div class="bg-gray-50 rounded-lg border border-dashed border-gray-300 p-12 text-center">
      <%= icon("file-text", class: "w-12 h-12 text-gray-400 mx-auto mb-4") %>
      <h3 class="text-lg font-medium text-gray-900 mb-2">No contracts yet</h3>
      <p class="text-gray-600 mb-4">
        Create a contract for this contractor.
      </p>
      <%= link_to manage_new_contract_wizard_path(contractor_id: @contractor.id) do %>
        <%= render "shared/button", text: "New Contract", variant: "primary", icon: "plus" %>
      <% end %>
    </div>
  <% end %>
</div>
