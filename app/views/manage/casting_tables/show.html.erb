<% content_for :title, @casting_table.name %>

<div class="w-full mb-10" data-controller="casting-table modal" data-casting-table-table-id-value="<%= @casting_table.id %>">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <% top_menu_links = [{ text: "Edit", path: manage_edit_casting_table_path(@casting_table) }] %>
  <% if @casting_table.finalized? %>
    <% top_menu_links << { text: "Notifications", path: manage_casting_table_summary_path(@casting_table) } %>
  <% end %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Casting", manage_casting_path],
      ["Casting Tables", manage_casting_tables_path]
    ],
    text: @casting_table.name,
    links: top_menu_links
  } %>

  <% unless @casting_table.draft? %>
    <div class="mb-4 p-3 bg-green-50 border border-green-200 rounded-lg">
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span class="text-sm font-medium text-green-800">Finalized</span>
        </div>
        <span class="text-xs sm:text-sm text-green-700 ml-7 sm:ml-0">Finalized <%= time_ago_in_words(@casting_table.finalized_at) %> ago</span>
      </div>
    </div>
  <% end %>

  <!-- Casting Grid -->
  <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
    <div class="overflow-auto <%= @casting_table.draft? ? 'max-h-[calc(100vh-280px)]' : 'max-h-[calc(100vh-200px)]' %> rounded-lg">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50 sticky top-0 z-20">
          <tr>
            <th class="sticky left-0 z-30 bg-gray-50 px-2 md:px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-[120px] min-w-[120px] max-w-[120px] md:w-[280px] md:min-w-[280px] md:max-w-[280px] after:absolute after:right-0 after:top-0 after:bottom-0 after:w-px after:bg-gray-300 relative">
              Event
            </th>
            <% @members.each do |member| %>
              <th class="px-1 py-2 text-center min-w-[50px] max-w-[50px]">
                <div class="flex flex-col items-center gap-1">
                  <div class="h-20 flex items-end justify-center pb-1">
                    <span class="text-xs text-gray-600 whitespace-nowrap [writing-mode:vertical-rl] rotate-180" title="<%= member.name %>"><%= member.first_name %></span>
                  </div>
                  <% if member.respond_to?(:safe_headshot_variant) %>
                    <% headshot = member.safe_headshot_variant(:thumb) %>
                    <% if headshot %>
                      <%= image_tag headshot, alt: member.name, class: "w-8 h-8 rounded-lg object-cover" %>
                    <% else %>
                      <div class="w-8 h-8 rounded-lg bg-gray-200 flex items-center justify-center">
                        <span class="text-xs font-medium text-gray-500"><%= member.initials[0..1] %></span>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </th>
            <% end %>
            <th class="sticky right-0 z-30 bg-gray-50 px-2 py-2 text-center text-xs font-medium text-gray-500 uppercase tracking-wider min-w-[45px] before:absolute before:left-0 before:top-0 before:bottom-0 before:w-px before:bg-gray-300 relative">
              Cast
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @shows.each do |show| %>
            <%
              show_count = @show_assignment_counts[show.id] || 0
              total_slots = @show_total_slots[show.id] || 0
              is_fully_cast = total_slots > 0 && show_count >= total_slots
            %>
            <tr class="hover:bg-gray-50 group">
              <td class="sticky left-0 z-10 bg-white group-hover:bg-gray-50 px-2 md:px-3 py-2 after:absolute after:right-0 after:top-0 after:bottom-0 after:w-px after:bg-gray-300 relative">
                <%# Mobile: Condensed view %>
                <div class="md:hidden">
                  <div class="text-xs font-semibold text-pink-600"><%= show.date_and_time.strftime("%b %-d") %></div>
                  <div class="text-sm font-bold text-gray-900"><%= show.time_range_display %></div>
                  <div class="text-xs text-gray-500 truncate max-w-[100px]" title="<%= show.display_name %>"><%= show.display_name %></div>
                </div>
                <%# Desktop: Full view %>
                <div class="hidden md:flex items-center gap-3">
                  <%# Date Box - show_row style %>
                  <div class="flex-shrink-0 w-12 flex items-center gap-1">
                    <span class="text-lg leading-none font-bold text-gray-900"><%= show.date_and_time.strftime("%-d") %></span>
                    <span class="text-[9px] leading-tight uppercase">
                      <span class="block font-semibold text-pink-600"><%= show.date_and_time.strftime("%b") %></span>
                      <span class="block text-gray-500"><%= show.date_and_time.strftime("%a") %></span>
                    </span>
                  </div>
                  <%# Show Details %>
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-gray-900 text-sm">
                      <%= show.display_name %>
                    </div>
                    <div class="text-xs text-gray-600">
                      <%= show.time_range_display %> · <%= show.production.name %>
                    </div>
                  </div>
                </div>
              </td>
              <% @members.each do |member| %>
                <%
                  member_type = member.class.name
                  member_id = member.id
                  key = [show.id, member_type, member_id]
                  availability = @availability[key]
                  member_key = "#{member_type}_#{member_id}"
                  conflicted = (@conflicts_by_show[show.id] || {})[member_key].present?
                %>
                <td class="px-1 py-2 text-center relative"
                    data-casting-table-target="cell"
                    data-show-id="<%= show.id %>"
                    data-member-type="<%= member_type %>"
                    data-member-id="<%= member_id %>"
                    data-member-key="<%= member_key %>"
                    <%# Quoted through tag.attributes: the action contains ">", which ends an
                        unquoted attribute and spills the rest of it onto the page. %>
                    <%= tag.attributes(data: { action: "click->casting-table#openRoleSelector" }) if @casting_table.draft? %>>
                  <%= render "manage/casting_tables/cell_content",
                        drafts: (@draft_assignments[key] || []),
                        existing: (@existing_assignments[key] || []),
                        show: show,
                        numbers: (@lineup_numbers[show.id] || {}),
                        availability: availability,
                        conflicted: conflicted,
                        clickable: @casting_table.draft? %>
                </td>
              <% end %>
              <td class="sticky right-0 z-10 bg-white group-hover:bg-gray-50 px-2 py-2 text-center before:absolute before:left-0 before:top-0 before:bottom-0 before:w-px before:bg-gray-300 relative"
                  data-casting-table-target="showCount"
                  data-show-id="<%= show.id %>"
                  data-current-count="<%= show_count %>"
                  data-total-slots="<%= total_slots %>">
                <div class="flex items-center justify-center gap-1">
                  <%# Always rendered so a change can show or hide it without a reload. %>
                  <svg class="w-3.5 h-3.5 text-pink-500 fully-cast-icon<%= " hidden" unless is_fully_cast %>" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-xs font-medium text-gray-500 show-count-text"><%= show_count %>/<%= total_slots %></span>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="sticky bottom-0 z-20 bg-gray-50 border-t-2 border-gray-300 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)]">
          <tr>
            <td class="sticky left-0 z-30 bg-gray-50 px-2 md:px-4 py-3 text-xs md:text-sm font-medium text-gray-700 after:absolute after:right-0 after:top-0 after:bottom-0 after:w-px after:bg-gray-300 relative">
              <span class="md:hidden">Total</span>
              <span class="hidden md:inline">Total Assignments</span>
            </td>
            <% @members.each do |member| %>
              <%
                key = [member.class.name, member.id]
                count = @assignment_counts[key] || 0
              %>
              <td class="px-1 py-2 text-center"
                  data-casting-table-target="memberCount"
                  data-member-key="<%= member.class.name %>_<%= member.id %>"
                  data-current-count="<%= count %>">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full <%= count > 0 ? 'bg-pink-100 text-pink-700' : 'bg-gray-100 text-gray-500' %> text-xs font-medium member-count-text">
                  <%= count %>
                </span>
              </td>
            <% end %>
            <td class="sticky right-0 z-30 bg-gray-50 px-2 py-2 text-center before:absolute before:left-0 before:top-0 before:bottom-0 before:w-px before:bg-gray-300 relative"
                data-casting-table-target="totalCount"
                data-current-count="<%= @assignment_counts.values.sum %>"
                data-total-slots="<%= @show_total_slots.values.sum %>">
              <% total_count = @assignment_counts.values.sum %>
              <% total_slots = @show_total_slots.values.sum %>
              <span class="text-xs font-semibold <%= total_count >= total_slots ? 'text-pink-600' : 'text-gray-700' %> total-count-text">
                <%= total_count %>/<%= total_slots %>
              </span>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <%# The cell panel. Its contents come from the server (casting_tables#cell), so
      it can show the running order, who's in each slot and what this member
      already holds without shipping the whole board to the browser. %>
  <div id="role-selector" class="hidden fixed z-50 bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden"
       data-casting-table-target="roleSelector">
    <div data-casting-table-target="roleOptions">
      <div class="px-6 py-10 text-center text-sm text-gray-400">Loading…</div>
    </div>
  </div>

  <% if @casting_table.draft? %>
    <!-- Floating Action Bar - styled like auditions voting bar -->
    <%# lg:left-[17rem] = the w-64 nav plus the same 16px inset the other edges
        use. This was lg:left-60 (240px), which tucked the bar under the nav. %>
    <div class="fixed bottom-4 left-4 right-4 lg:left-[17rem] lg:right-4 bg-white rounded-lg shadow-lg border border-gray-200 z-40 overflow-hidden">
      <div class="bg-gray-50 px-3 py-2 border-b border-gray-200">
        <h3 class="text-sm font-semibold text-gray-900 coustard-regular">Draft Mode</h3>
      </div>
      <div class="p-3 flex flex-col sm:flex-row sm:items-center gap-3">
        <div class="flex-1 text-sm text-gray-600">
          <span class="font-medium" data-casting-table-target="draftAssignmentCount"><%= @casting_table.casting_table_draft_assignments.count %></span> draft assignments
        </div>
        <div class="flex items-center gap-3">
          <%= render "shared/button", text: "Delete", variant: "secondary", size: "medium", type: :button,
                data: { action: "click->modal#open", "modal-id": "delete-casting-table-modal" } %>
          <%= render "shared/button", text: "Review & Finalize", variant: "primary", size: "medium", path: manage_casting_table_summary_path(@casting_table) %>
        </div>
      </div>
    </div>

    <%# Delete confirmation modal %>
    <div id="delete-casting-table-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
      <div class="fixed inset-0 bg-black/40" data-action="click->modal#close"></div>
      <div class="relative bg-white rounded-xl shadow-xl w-full max-w-md overflow-hidden">
        <div class="px-6 py-4 bg-gradient-to-r from-pink-500 to-pink-600 flex items-center justify-between">
          <h3 class="text-lg font-semibold text-white">Delete this casting table?</h3>
          <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="px-6 py-5 text-sm text-gray-600 space-y-3">
          <p>This deletes <strong><%= @casting_table.name %></strong> and discards its
            <strong><%= pluralize(@casting_table.casting_table_draft_assignments.count, "suggested assignment") %></strong>.</p>
          <p>Everything goes back to how it was before this table. Any casting you've <strong>finalized elsewhere is unaffected</strong> — nothing on the real casting board is removed.</p>
        </div>
        <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex items-center justify-end gap-2">
          <button type="button" data-action="click->modal#close" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</button>
          <%= render "shared/button", text: "Delete casting table", variant: "primary", size: "medium",
                path: manage_casting_table_path(@casting_table), method: :delete %>
        </div>
      </div>
    </div>
  <% end %>
</div>
