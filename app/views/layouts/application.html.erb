<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "CocoScout" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=5">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caprasimo&family=Coustard:wght@400;900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-P198QVDCDH"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-P198QVDCDH');
  </script>

  <body class="inter-regular text-slate-700 bg-[#f9f9f7]" <% if Current.user.present? %>data-controller="user-notifications upgrade-modal" data-user-notifications-user-id-value="<%= Current.user.id %>"<% end %>>

  <div class="flex min-h-screen">

      <% if turbo_native_app? %>

        <main class="flex-1 px-4 pt-4 pb-8 overflow-x-hidden">

      <% elsif @show_manage_sidebar %>

        <%= render "shared/navigation/manage_mobile" %>
        <%= render "shared/navigation/manage" %>
        <main class="flex-1 px-5 pt-14 pb-8 lg:pt-6 lg:ml-56 overflow-x-hidden">

      <% elsif @show_manage_header_only %>

        <%= render "shared/navigation/manage_header" %>
        <%= render "shared/navigation/manage_mobile" %>
        <main class="flex-1 px-5 pt-14 pb-8 lg:pt-20 overflow-x-hidden">

      <% elsif @show_group_sidebar %>

        <%= render "shared/navigation/group_header" %>
        <%= render "shared/navigation/group_mobile" %>
        <%= render "shared/navigation/group" %>
        <main class="flex-1 px-5 pt-14 pb-8 lg:pt-20 lg:ml-56 overflow-x-hidden">

      <% elsif @show_my_sidebar %>

        <%= render "shared/navigation/my_mobile" %>
        <%= render "shared/navigation/my" %>
        <main class="flex-1 px-5 pt-14 pb-8 lg:pt-6 lg:ml-56 overflow-x-hidden">

      <% elsif @show_account_sidebar %>

        <%= render "shared/navigation/account_mobile" %>
        <%= render "shared/navigation/account" %>
        <main class="flex-1 px-5 pt-14 pb-8 lg:pt-6 lg:ml-56 overflow-x-hidden">

      <% else %>

        <main class="flex-1 pb-8 overflow-x-hidden">

      <% end %>

        <div id="flash-messages"></div>
        <%= yield %>
      </main>
    </div>

    <%# Global modal turbo frames %>
    <%= turbo_frame_tag "contact_modal" %>
    <%# Modals teleported here to escape overflow-hidden containers %>
    <%= yield :modals %>

    <%# Pro upgrade modal — content is fetched on demand when a locked feature is clicked %>
    <% if Current.user.present? %>
      <div data-upgrade-modal-target="overlay" class="hidden fixed inset-0 z-[60] items-start justify-center overflow-y-auto p-4 sm:p-6">
        <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" data-action="click->upgrade-modal#close"></div>
        <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-2xl my-8">
          <button type="button" data-action="click->upgrade-modal#close" class="absolute top-4 right-4 z-10 w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500" aria-label="Close">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
          <div data-upgrade-modal-target="content" class="p-6 sm:p-8">
            <div class="py-16 text-center text-gray-400 text-sm">Loading…</div>
          </div>
        </div>
      </div>
    <% end %>
  </body>
</html>
