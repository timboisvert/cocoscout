<%# Unpaid time entries for one person, loaded into the pull-hours modal frame.
    Checkboxes default on; the pay-pull controller sums the checked ones. A
    manager can approve pending (submitted) hours here so the worker sees them
    approved. Locals: entries, person. %>
<%= turbo_frame_tag "pay_time_entries" do %>
  <% pending = entries.select { |e| e.status == "pending" } %>
  <% if pending.any? %>
    <%= form_with url: manage_approve_staffing_pay_time_entries_path(person_id: person.id), method: :patch,
          data: { turbo_frame: "pay_time_entries" }, class: "mb-3" do %>
      <div class="flex items-center justify-between gap-2 rounded-lg bg-amber-50 border border-amber-200 px-3 py-2">
        <span class="text-xs text-amber-900"><%= pluralize(pending.size, "entry") %> pending your approval</span>
        <%= render "shared/button", text: "Approve all", variant: "primary", size: "small", type: :submit %>
      </div>
    <% end %>
  <% end %>

  <% if entries.any? %>
    <div class="space-y-2">
      <% entries.each do |e| %>
        <label class="flex items-center gap-3 px-3 py-2 border border-gray-200 rounded-lg cursor-pointer hover:border-pink-300">
          <input type="checkbox" checked data-entry-id="<%= e.id %>" data-hours="<%= e.hours %>"
                 data-action="change->pay-pull#recalcSubtotal"
                 class="h-4 w-4 rounded border-gray-300 accent-pink-500">
          <div class="min-w-0 flex-1">
            <div class="text-sm font-medium text-gray-900 truncate">
              <%= e.started_at.strftime("%a %b %-d") %>
              <span class="text-gray-400">·</span>
              <%= number_with_precision(e.hours, precision: 2, strip_insignificant_zeros: true) %>h
              <% if e.source == "manual" %><span class="text-[10px] px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">self-logged</span><% end %>
            </div>
            <div class="text-xs text-gray-500 truncate">
              <%= e.started_at.strftime("%-l:%M %p") %>–<%= e.ended_at.strftime("%-l:%M %p") %>
              <% if e.shift&.role_label.present? %> · <%= e.shift.role_label %><% end %>
            </div>
          </div>
          <% if e.status == "approved" %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700 flex-shrink-0">Approved</span>
          <% else %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700 flex-shrink-0">Pending</span>
          <% end %>
        </label>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-400 py-4 text-center">No unpaid hours logged for this person yet.</p>
  <% end %>
<% end %>
