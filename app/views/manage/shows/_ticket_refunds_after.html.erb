<%# A show canceled before its ticket buyers were refunded: refund them now,
    with the email they'll get (editable). Locals: show, listing, summary,
    subject, body. %>
<% input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
<div class="mt-4 bg-white border border-gray-200 rounded-lg overflow-hidden">
  <%= render "shared/card_header", title: "Ticket Buyers" %>
  <div class="p-6 space-y-4">
    <p class="text-sm text-gray-600">
      <%= pluralize(summary.orders.size, "person") %> still <%= summary.orders.one? ? "holds" : "hold" %> tickets for this canceled date.
      Refund them, <%= number_to_currency(summary.refund_cents / 100.0) %> in all, and let them know.
    </p>
    <%= form_with url: manage_ticket_listing_cancel_path(listing), method: :post, id: "refund-ticket-buyers-form", class: "space-y-3" do %>
      <div>
        <label for="subject" class="block text-sm font-medium text-gray-700 mb-1.5">Subject</label>
        <%= text_field_tag :subject, subject, class: input_class %>
      </div>
      <div>
        <label for="body" class="block text-sm font-medium text-gray-700 mb-1.5">Message</label>
        <%= text_area_tag :body, body, rows: 7, class: input_class %>
      </div>
      <%= render "shared/button", text: "Refund #{pluralize(summary.orders.size, 'buyer')}", variant: "primary", size: "medium", type: :button,
            data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-refund-ticket-buyers" } %>
    <% end %>
  </div>
</div>
<div id="confirm-refund-ticket-buyers" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden" data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white">Refund every ticket buyer?</h3>
      <button type="button" data-action="click->modal#close" aria-label="Close"
              class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <div class="px-6 py-5 text-sm text-gray-600">
      <%= pluralize(summary.orders.size, "buyer") %> get <%= number_to_currency(summary.refund_cents / 100.0) %> back in all, and your email. This can't be undone.
    </div>
    <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
      <%= render "shared/button", text: "Go back", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
      <%= render "shared/button", text: "Refund and email them", variant: "primary", size: "medium", type: :submit, form_id: "refund-ticket-buyers-form" %>
    </div>
  </div>
</div>
