<% content_for :title, "Work the door" %>
<%# Several organizations' doors: pick the one you're working, by what's on now. %>
<% if @organizations.empty? %>
  <div class="rounded-2xl border border-dashed border-gray-300 bg-white px-6 py-8 text-center">
    <div class="text-lg font-semibold text-gray-900">Nothing to work right now</div>
    <p class="mt-2 text-sm text-gray-600">An organization's manager can give you door access in Ticketing settings.</p>
  </div>
<% else %>
  <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Whose door?</h2>
  <div class="mt-2 space-y-2">
    <% @organizations.sort_by { |org| [ -(@on_now_by_organization[org.id]&.size || 0), org.name.downcase ] }.each do |org| %>
      <% on_now = @on_now_by_organization[org.id] || [] %>
      <% upcoming = @next_by_organization[org.id] %>
      <%= link_to door_index_path(organization: org.id), class: "block rounded-2xl bg-white px-4 py-3.5 transition-colors #{on_now.any? ? 'border-2 border-pink-500' : 'border border-gray-200 hover:border-pink-400'}" do %>
        <div class="flex items-center gap-3">
          <div class="min-w-0 flex-1">
            <div class="text-lg font-bold leading-tight text-gray-900 truncate"><%= org.name %></div>
            <div class="text-sm text-gray-600 mt-0.5">
              <% if on_now.one? %>
                <%= on_now.first.display_title %> · <%= on_now.first.show.date_and_time.strftime("%-l:%M %p") %>
              <% elsif on_now.any? %>
                <%= on_now.size %> shows on now
              <% elsif upcoming %>
                Nothing on now · next <%= upcoming.show.date_and_time.strftime("%a, %b %-d") %>
              <% else %>
                Nothing on now
              <% end %>
            </div>
          </div>
          <% if on_now.any? %>
            <span class="flex-shrink-0 rounded-full bg-pink-500 px-3 py-1 text-xs font-semibold text-white">On now</span>
          <% end %>
          <svg class="w-5 h-5 flex-shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
