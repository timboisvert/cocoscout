<%#
  Still owed (Tim, 2026-11-22): what the contractor owes once no share is left
  to take it out of — not tied to any one date, so it sits under the list
  rather than on the first date it came from. Collect it, or change the
  amount (to $0 when the organization won't collect it), with a note. One set
  to $0 stays here as a settled row, and can be changed back.

  Locals: money (ContractDatesAndMoney), contract
%>
<% if money.owed.any? %>
  <%
    pending = money.owed_pending
    menu_item = "w-full flex items-center gap-2 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer bg-transparent border-0 text-left"
  %>
  <div id="still-owed" class="mt-3 space-y-2 scroll-mt-24">
    <% if pending.any? %>
      <div class="rounded-xl border border-pink-300 bg-pink-50 p-4 sm:p-5">
        <div class="text-xs font-semibold uppercase tracking-wide text-pink-700">Still owed</div>
        <p class="mt-1 text-lg font-bold text-gray-900">
          <%= contract.contractor_name %> owes <%= Current.organization.name %> <span class="text-green-700"><%= number_to_currency(money.owed_total) %></span>
        </p>
        <div class="mt-3 space-y-3">
          <% pending.each do |payment| %>
            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
              <p class="flex-1 text-sm text-gray-700">
                <%= number_to_currency(payment.amount) %>, <%= ContractDatesAndMoney.owed_label(payment) %>. There's no <%= contract.revenue_share? || contract.ticket_revenue_minus_fee? ? "share" : "payment" %> left to take it out of.
                <% if payment.amount_change_note.present? %>
                  <span class="block text-gray-600 mt-0.5">Changed from <%= number_to_currency(payment.amount_before_change) %>: “<%= payment.amount_change_note %>”</span>
                <% end %>
              </p>
              <div class="flex items-center gap-2">
                <%= link_to manage_money_incoming_payment_path(payment) do %>
                  <%= render "shared/button", text: "Collect", variant: "primary", size: "small", icon: "banknotes" %>
                <% end %>
                <div class="relative" data-controller="dropdown">
                  <button type="button" data-action="click->dropdown#toggle" aria-label="More ways to settle what's owed"
                          class="w-9 h-9 inline-flex items-center justify-center text-gray-500 hover:text-gray-700 rounded-lg border border-pink-300 hover:border-pink-400 bg-white cursor-pointer">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/></svg>
                  </button>
                  <div data-dropdown-target="menu" class="hidden absolute right-0 top-full mt-1 w-60 bg-white rounded-lg shadow-lg border border-gray-200 py-1 z-50">
                    <% if payment.collectable_online? %>
                      <div data-controller="clipboard">
                        <input type="hidden" data-clipboard-target="textField" value="<%= pay_contract_url(token: payment.payment_token!) %>">
                        <button type="button" data-action="click->clipboard#copy" class="<%= menu_item %>">
                          <%= icon("link", class: "w-4 h-4 text-gray-400") %> Copy the pay link
                        </button>
                      </div>
                      <%= link_to manage_money_incoming_payment_path(payment, anchor: "send-invoice"), class: menu_item do %>
                        <%= icon("envelope", class: "w-4 h-4 text-gray-400") %> Send the invoice
                      <% end %>
                    <% end %>
                    <%= link_to manage_money_incoming_payment_path(payment), class: menu_item do %>
                      <%= icon("check-circle", class: "w-4 h-4 text-gray-400") %> Record a payment
                    <% end %>
                    <button type="button" data-action="click->modal#open" data-modal-id="change-amount-<%= payment.id %>" class="<%= menu_item %> border-t border-gray-100">
                      <%= icon("pencil", class: "w-4 h-4 text-gray-400") %> Change the amount
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% money.owed.select(&:set_to_zero?).each do |payment| %>
      <div class="rounded-lg border border-gray-200 bg-white px-3 py-2.5 flex flex-col sm:flex-row sm:items-center gap-3">
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <div class="w-14 text-center flex-shrink-0">
            <div class="text-[11px] font-semibold text-pink-600 uppercase"><%= payment.paid_date.strftime("%b") %></div>
            <div class="text-xl font-bold text-gray-900 leading-tight"><%= payment.paid_date.strftime("%-d") %></div>
            <div class="text-[11px] text-gray-600"><%= payment.paid_date.strftime("%a") %></div>
          </div>
          <div class="min-w-0">
            <div class="text-sm font-semibold text-gray-900"><%= ContractDatesAndMoney.owed_label(payment).upcase_first %>, set to $0</div>
            <div class="text-sm text-gray-600">
              <% if payment.amount_change_note.present? %>“<%= payment.amount_change_note %>”<% end %>
              <%= [ payment.amount_changed_by&.person&.name, payment.amount_changed_at&.strftime("%b %-d") ].compact.join(", ") %>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-3 sm:justify-end">
          <div class="text-right">
            <div class="text-base font-bold text-gray-500 line-through tabular-nums"><%= number_to_currency(payment.amount_before_change) %></div>
            <div class="text-xs text-gray-600">Not collected</div>
          </div>
          <span class="inline-flex items-center rounded-full border border-green-200 bg-green-50 px-2.5 py-0.5 text-xs font-semibold text-green-800">Nothing owed</span>
          <%= render "shared/button", text: "Change", variant: "secondary", size: "small", icon: "pencil", type: :button,
                data: { action: "click->modal#open", modal_id: "change-amount-#{payment.id}" } %>
        </div>
      </div>
    <% end %>
  </div>

  <% money.owed.each do |payment| %>
    <%= render "manage/contracts/change_amount_modal", payment: payment, contract: contract %>
  <% end %>
<% end %>
