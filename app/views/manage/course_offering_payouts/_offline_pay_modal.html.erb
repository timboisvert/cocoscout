<%# Locals: id, line_item, course_offering. Wrapped by a data-controller="modal" div. %>
<div id="<%= id %>" class="hidden fixed inset-0 z-50 overflow-y-auto">
  <div class="flex min-h-full items-center justify-center p-4">
    <div class="fixed inset-0 bg-gray-500/75" data-action="click->modal#close"></div>
    <div class="relative bg-white rounded-xl shadow-xl w-full max-w-md text-left overflow-hidden">
      <div class="flex items-center justify-between px-6 py-4 bg-pink-500">
        <h3 class="text-lg font-semibold text-white">Mark paid another way</h3>
        <button type="button" data-action="click->modal#close" class="text-white/70 hover:text-white cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <%= form_with url: manage_course_offering_payout_mark_line_item_paid_path(course_offering, line_item), method: :post do %>
        <div class="px-6 py-4 space-y-4">
          <p class="text-sm text-gray-600">Record that <span class="font-medium"><%= line_item.payee_name %></span> was paid <%= number_to_currency(line_item.amount_cents / 100.0) %> outside CocoScout.</p>
          <div>
            <label class="block text-sm font-medium text-gray-900 mb-1.5">How were they paid?</label>
            <select name="method" class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
              <% (Current.organization.offline_payout_method_choices.presence || %w[cash check other]).each do |m| %>
                <option value="<%= m %>"><%= m.titleize %></option>
              <% end %>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-900 mb-1.5">Note (optional)</label>
            <input type="text" name="notes" placeholder="e.g. Zelle reference #1234"
                   class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
          </div>
        </div>
        <div class="flex items-center justify-end gap-2 px-6 py-4 border-t border-gray-200">
          <button type="button" data-action="click->modal#close" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">Cancel</button>
          <%= render "shared/button", text: "Mark paid", variant: "primary", size: "small", type: :submit %>
        </div>
      <% end %>
    </div>
  </div>
</div>
