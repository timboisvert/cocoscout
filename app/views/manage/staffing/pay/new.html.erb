<% content_for :title, "Pay People" %>

<div class="w-full mb-10" data-controller="pay-run pay-pull tips-worksheet pay-draft"
     data-pay-draft-url-value="<%= manage_staffing_pay_draft_path %>"
     data-pay-draft-initial-value="<%= @draft %>">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ ["Staffing", manage_staffing_index_path] ],
    text: "Pay People",
    links: []
  } %>

  <% payable = @staff_members.select { |m| m.person.respond_to?(:can_receive_payouts?) && m.person.can_receive_payouts? } %>

  <% unless Current.organization.funding_payment_method_id.present? %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 mt-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-amber-900">Connect a bank or card to fund pay runs first.</p>
      <%= render "shared/button", text: "Connect a funding source", variant: "primary", size: "small",
            path: manage_connect_payout_funding_path, method: :post, form: { data: { turbo: false } } %>
    </div>
  <% end %>

  <% if @staff_members.empty? %>
    <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-6 text-center mt-4">
      <p class="text-sm text-gray-600 mb-3">No staff to pay yet.</p>
      <%= render "shared/button", text: "Add a staff member", variant: "primary", size: "small", path: manage_new_staffing_staff_wizard_path %>
    </div>
  <% else %>
    <%= form_with url: manage_create_staffing_pay_path, method: :post, class: "mt-4",
          data: { "pay-draft-target": "form", action: "input->pay-draft#schedule change->pay-draft#schedule" } do %>
      <div class="flex flex-col sm:flex-row sm:items-end gap-4 mb-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Payday</label>
          <%= date_field_tag :payday, @payday, class: "px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
        </div>
        <%# ACH is the only funding method for now — no card option. %>
        <input type="hidden" name="funding_method" value="ach">
      </div>

      <div class="overflow-x-auto border border-gray-200 rounded-lg bg-white">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
            <tr>
              <th class="text-left font-medium px-3 py-2">Staff</th>
              <th class="text-right font-medium px-3 py-2">Rate</th>
              <th class="text-right font-medium px-3 py-2">Hours</th>
              <th class="text-right font-medium px-3 py-2">Bonus</th>
              <th class="text-right font-medium px-3 py-2">Reimb.</th>
              <th class="text-right font-medium px-3 py-2">Tips</th>
              <th class="text-right font-medium px-3 py-2">Cash tips</th>
              <th class="text-right font-medium px-3 py-2">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @staff_members.each do |member| %>
              <% payee = member.person %>
              <% can_pay = payee.respond_to?(:can_receive_payouts?) && payee.can_receive_payouts? %>
              <tr data-pay-run-target="row" data-rate="<%= member.hourly_rate_cents.to_i %>" data-payable="<%= can_pay %>" class="<%= "opacity-60" unless can_pay %>">
                <td class="px-3 py-2">
                  <div class="font-medium text-gray-900"><%= member.display_name %></div>
                  <% unless can_pay %><span class="text-[11px] text-amber-600">Needs to connect a bank — will be skipped</span><% end %>
                </td>
                <td class="px-3 py-2 text-right text-gray-600"><%= member.hourly_rate_cents ? number_to_currency(member.hourly_rate_cents / 100.0) : "—" %></td>
                <td class="px-3 py-2 text-right align-top">
                  <input id="pay-hours-<%= member.id %>" type="number" step="0.25" min="0" name="lines[<%= member.id %>][hours]" data-pay-field="hours" data-action="input->pay-run#recalc" class="w-20 px-2 py-1.5 border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300">
                  <span id="pay-entries-<%= member.id %>"></span>
                  <% approved = (@approved_hours_by_person[member.person_id] || 0).to_f %>
                  <% if approved.positive? %>
                    <button type="button" data-action="click->pay-pull#open" data-member-id="<%= member.id %>" data-src="<%= manage_staffing_pay_time_entries_path(person_id: member.person_id) %>"
                            class="block ml-auto mt-1 text-[11px] text-pink-600 hover:text-pink-700 cursor-pointer">pull <%= number_with_precision(approved, precision: 2, strip_insignificant_zeros: true) %>h</button>
                  <% end %>
                </td>
                <td class="px-3 py-2 text-right"><input type="text" inputmode="decimal" name="lines[<%= member.id %>][bonus]" data-pay-field="bonus" data-action="input->pay-run#recalc" placeholder="0" class="w-20 px-2 py-1.5 border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300"></td>
                <td class="px-3 py-2 text-right"><input type="text" inputmode="decimal" name="lines[<%= member.id %>][reimbursement]" data-pay-field="reimbursement" data-action="input->pay-run#recalc" placeholder="0" class="w-20 px-2 py-1.5 border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300"></td>
                <td class="px-3 py-2 text-right align-top">
                  <input id="pay-tips-<%= member.id %>" type="text" inputmode="decimal" name="lines[<%= member.id %>][tips]" data-pay-field="tips" data-action="input->pay-run#recalc" placeholder="0" class="w-20 px-2 py-1.5 border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300">
                  <span id="pay-tips-sheet-<%= member.id %>" class="hidden"></span>
                  <button type="button" data-action="click->tips-worksheet#open" data-member-id="<%= member.id %>" data-field-input-id="pay-tips-<%= member.id %>" data-holder-id="pay-tips-sheet-<%= member.id %>" data-field-name="tips_sheet" data-title="Tips worksheet"
                          class="block ml-auto mt-1 text-[11px] text-pink-600 hover:text-pink-700 cursor-pointer">worksheet</button>
                </td>
                <td class="px-3 py-2 text-right align-top">
                  <input id="pay-cashtips-<%= member.id %>" type="text" inputmode="decimal" name="lines[<%= member.id %>][cash_tips]" placeholder="0" class="w-20 px-2 py-1.5 border border-gray-200 rounded text-right focus:outline-none focus:ring-1 focus:ring-pink-300">
                  <span id="pay-cashtips-sheet-<%= member.id %>" class="hidden"></span>
                  <button type="button" data-action="click->tips-worksheet#open" data-member-id="<%= member.id %>" data-field-input-id="pay-cashtips-<%= member.id %>" data-holder-id="pay-cashtips-sheet-<%= member.id %>" data-field-name="cash_tips_sheet" data-title="Cash tips worksheet"
                          class="block ml-auto mt-1 text-[11px] text-pink-600 hover:text-pink-700 cursor-pointer">worksheet</button>
                </td>
                <td class="px-3 py-2 text-right font-medium text-gray-900" data-pay-total>$0.00</td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-gray-50 border-t border-gray-200">
            <tr>
              <td colspan="7" class="px-3 py-3 text-right text-sm text-gray-600">Total to pay (<span data-pay-run-target="count">0</span> people, cash tips excluded)</td>
              <td class="px-3 py-3 text-right text-base font-semibold text-gray-900" data-pay-run-target="grandTotal">$0.00</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <p class="text-xs text-gray-500 mt-2">Only staff with a connected bank are paid. Each staff member gets 2 free payments a month; additional payments are $1 each. Cash tips are recorded for your records but not sent through us.</p>

      <div class="flex items-center justify-end gap-3 mt-4">
        <%= link_to "Cancel", manage_staffing_index_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
        <%= render "shared/button", text: "Pay People", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
  <% end %>

  <%# ---- Pull hours modal (shared; opened per person) ---- %>
  <div data-pay-pull-target="modal" class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->pay-pull#backdropClose keydown.esc@window->pay-pull#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl" data-action="click->pay-pull#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
          <h3 class="text-base font-semibold text-gray-900">Pull worked hours</h3>
          <%= render "shared/button", text: "", icon: "x-mark", variant: "ghost", size: "small", type: :button, data: { action: "click->pay-pull#close" } %>
        </div>
        <div class="px-5 py-4 max-h-96 overflow-y-auto">
          <%= turbo_frame_tag "pay_time_entries", data: { "pay-pull-target": "frame" } do %>
            <p class="text-sm text-gray-400 py-4 text-center">Loading…</p>
          <% end %>
        </div>
        <div class="flex items-center justify-between gap-2 px-5 py-3 border-t border-gray-200">
          <span class="text-sm text-gray-600"><span data-pay-pull-target="subtotal" class="font-semibold text-gray-900">0</span> hours selected</span>
          <div class="flex items-center gap-2">
            <%= render "shared/button", text: "Cancel", variant: "ghost-cancel", size: "small", type: :button, data: { action: "click->pay-pull#close" } %>
            <%= render "shared/button", text: "Include", variant: "primary", size: "small", type: :button, data: { action: "click->pay-pull#include" } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ---- Tips / cash-tips worksheet modal (shared) ---- %>
  <div data-tips-worksheet-target="modal" class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->tips-worksheet#backdropClose keydown.esc@window->tips-worksheet#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl" data-action="click->tips-worksheet#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
          <h3 class="text-base font-semibold text-gray-900" data-tips-worksheet-target="title">Tips worksheet</h3>
          <%= render "shared/button", text: "", icon: "x-mark", variant: "ghost", size: "small", type: :button, data: { action: "click->tips-worksheet#close" } %>
        </div>
        <div class="px-5 py-4">
          <p class="text-sm text-gray-500 mb-3">Enter each day's amount; we'll total them for you.</p>
          <div data-tips-worksheet-target="rows" class="space-y-2"></div>
          <button type="button" data-action="click->tips-worksheet#addRow" class="mt-3 text-sm text-pink-600 hover:text-pink-700 cursor-pointer">+ Add a day</button>
        </div>
        <div class="flex items-center justify-between gap-2 px-5 py-3 border-t border-gray-200">
          <span class="text-sm text-gray-600">Total <span data-tips-worksheet-target="subtotal" class="font-semibold text-gray-900">$0.00</span></span>
          <div class="flex items-center gap-2">
            <%= render "shared/button", text: "Cancel", variant: "ghost-cancel", size: "small", type: :button, data: { action: "click->tips-worksheet#close" } %>
            <%= render "shared/button", text: "Use total", variant: "primary", size: "small", type: :button, data: { action: "click->tips-worksheet#useTotal" } %>
          </div>
        </div>
        <template data-tips-worksheet-target="template">
          <div class="flex items-center gap-2" data-row>
            <input type="date" data-cell="date" class="flex-1 px-2 py-1.5 border border-gray-200 rounded text-sm focus:outline-none focus:ring-1 focus:ring-pink-300">
            <div class="relative w-28">
              <span class="absolute left-2 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
              <input type="text" inputmode="decimal" data-cell="amount" data-action="input->tips-worksheet#recalc" placeholder="0" class="w-full pl-5 pr-2 py-1.5 border border-gray-200 rounded text-sm text-right focus:outline-none focus:ring-1 focus:ring-pink-300">
            </div>
            <button type="button" data-action="click->tips-worksheet#removeRow" class="text-gray-400 hover:text-red-500 cursor-pointer px-1" title="Remove">×</button>
          </div>
        </template>
      </div>
    </div>
  </div>
</div>
