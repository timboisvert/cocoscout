(function () {
  "use strict";
  // CocoScout Tickets embed. Turns each [data-cocoscout-tickets] element on
  // the page into a ticket widget; see TicketEmbedsController.
  var origin = <%= raw request.base_url.to_json %>;

  function pageUrl(el) {
    var org = encodeURIComponent(el.getAttribute("data-cocoscout-tickets"));
    var event = el.getAttribute("data-event");
    var path = "/t/embed/" + org + (event ? "/" + encodeURIComponent(event) : "");
    return origin + path;
  }

  function frame(src) {
    var iframe = document.createElement("iframe");
    iframe.src = src;
    iframe.title = "Tickets";
    iframe.setAttribute("allow", "payment");
    iframe.setAttribute("loading", "lazy");
    iframe.style.cssText = "width:100%;border:0;display:block;min-height:320px;background:transparent";
    return iframe;
  }

  function openOverlay(src) {
    var overlay = document.createElement("div");
    overlay.style.cssText = "position:fixed;inset:0;z-index:2147483000;background:rgba(0,0,0,.6);display:flex;align-items:flex-start;justify-content:center;padding:24px 12px;overflow-y:auto";
    var box = document.createElement("div");
    box.style.cssText = "position:relative;width:100%;max-width:640px;background:#fff;border-radius:16px;padding:16px;box-shadow:0 20px 60px rgba(0,0,0,.3)";
    var close = document.createElement("button");
    close.type = "button";
    close.setAttribute("aria-label", "Close");
    close.innerHTML = "&times;";
    close.style.cssText = "position:absolute;top:6px;right:10px;border:0;background:none;font-size:28px;line-height:1;color:#6b7280;cursor:pointer";
    var iframe = frame(src);
    iframe.style.minHeight = "480px";
    box.appendChild(close);
    box.appendChild(iframe);
    overlay.appendChild(box);
    document.body.appendChild(overlay);
    var shut = function () { overlay.remove(); document.removeEventListener("keydown", onKey); };
    var onKey = function (e) { if (e.key === "Escape") shut(); };
    close.addEventListener("click", shut);
    overlay.addEventListener("click", function (e) { if (e.target === overlay) shut(); });
    document.addEventListener("keydown", onKey);
  }

  function mount(el) {
    if (el.getAttribute("data-cocoscout-mounted")) return;
    el.setAttribute("data-cocoscout-mounted", "1");
    if (el.getAttribute("data-view") === "button") {
      var button = document.createElement("button");
      button.type = "button";
      button.textContent = el.textContent.trim() || "Buy tickets";
      button.style.cssText = "background:#ec4899;color:#fff;border:0;border-radius:8px;padding:10px 18px;font:600 15px/1.2 system-ui,sans-serif;cursor:pointer";
      button.addEventListener("click", function () { openOverlay(pageUrl(el)); });
      el.textContent = "";
      el.appendChild(button);
    } else {
      el.appendChild(frame(pageUrl(el)));
    }
  }

  // Frames report their height so they fit without an inner scrollbar.
  window.addEventListener("message", function (e) {
    if (e.origin !== origin || !e.data || e.data.type !== "cocoscout:height") return;
    var frames = document.querySelectorAll("iframe");
    for (var i = 0; i < frames.length; i++) {
      if (frames[i].contentWindow === e.source) frames[i].style.height = e.data.height + "px";
    }
  });

  function mountAll() {
    var els = document.querySelectorAll("[data-cocoscout-tickets]");
    for (var i = 0; i < els.length; i++) mount(els[i]);
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", mountAll);
  else mountAll();
})();
