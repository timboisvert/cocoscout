<% input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
<% scope = wizard_state[:trigger_scope] || "production" %>
<%= render layout: "manage/ticket_offer_wizard/wizard_layout", locals: { step: :buying } do %>
  <h2 class="text-xl font-bold text-gray-900 mb-2 coustard-regular">Who is it for?</h2>
  <p class="text-gray-600 mb-6">The deal shows to someone while they're buying this, and for a few days after.</p>

  <%= form_with url: manage_ticket_offer_wizard_save_buying_path, method: :post, local: true, data: { controller: "radio-card" } do %>
    <div class="space-y-2">
      <%= render layout: "manage/ticket_offer_wizard/choice_card", locals: { name: "trigger_scope", value: "production", selected: scope,
            title: "Anyone buying a date of a production", hint: "Whichever night they pick." } do %>
        <%= select_tag :trigger_production_id, options_for_select(production_choices, wizard_state[:trigger_production_id]),
              include_blank: "Pick a production", class: input_class %>
      <% end %>
      <%= render layout: "manage/ticket_offer_wizard/choice_card", locals: { name: "trigger_scope", value: "listing", selected: scope,
            title: "Anyone buying one date", hint: "Just that night." } do %>
        <%= select_tag :trigger_listing_id, grouped_options_for_select(listing_choices, wizard_state[:trigger_listing_id]),
              include_blank: "Pick a date", class: input_class %>
      <% end %>
      <%= render layout: "manage/ticket_offer_wizard/choice_card", locals: { name: "trigger_scope", value: "any", selected: scope,
            title: "Anyone buying anything", hint: "Every show you sell." } do %><% end %>
    </div>

    <div class="mt-8 flex justify-end">
      <%= render "shared/button", text: "Next: What they get", variant: "primary", size: "medium", type: :submit %>
    </div>
  <% end %>
<% end %>
