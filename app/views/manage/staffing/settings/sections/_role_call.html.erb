<%# Staffing Settings → Role Call (Tim, 2026-10-16): two boxes, one Save. The
    first is Role Call itself, on or off. The second is the roles every show
    has to have whatever its services (a house manager); what else a show
    needs comes from its services (after-V1 #6). %>
<%= form_with url: manage_staffing_settings_path, method: :patch, class: "space-y-6" do %>
  <%# Markers, so an unchecked switch and an all-unchecked list still save. %>
  <%= hidden_field_tag :updating_coverage, "1" %>
  <%= hidden_field_tag :updating_role_call_roles, "1" %>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <%= render "shared/section_heading", title: "Role Call",
          intro: "Before every show, Role Call checks that each service the show needs has someone on it, and flags the show in the day's list on Scheduling until it does. What a show needs comes from its production's Services tab or its contract; to change one night (a rental running its own booth, say), open the show on Scheduling." %>
    <div class="px-6 py-4 flex items-center justify-between gap-6">
      <div>
        <p class="text-[15px] font-medium text-gray-900">Run Role Call on my shows</p>
        <p class="text-sm text-gray-500">Off, no show gets flagged.</p>
      </div>
      <%= render "shared/toggle_switch", name: "alert_uncovered_show_roles", checked: Current.organization.alert_uncovered_show_roles?,
            id: "alert_uncovered_show_roles", aria_label: "Run Role Call on my shows" %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <%= render "shared/section_heading", title: "More roles every show needs",
          intro: "Roles that aren't a service but every show still has to have, like a house manager. Role Call checks these on every show, whatever its services." %>
    <% if @role_call_roles.present? %>
      <div class="divide-y divide-gray-100">
        <% @role_call_roles.each do |role| %>
          <label class="flex items-center gap-3 px-6 py-3 cursor-pointer">
            <%= check_box_tag "role_call_role_ids[]", role.id, role.include_in_role_call?, id: "role_call_role_#{role.id}",
                  class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
            <span class="text-sm text-gray-900"><%= role.name %></span>
            <%# A venue-scoped role changes what gets checked, so it earns a tag. %>
            <% if role.location %>
              <span class="text-xs px-1.5 py-0.5 rounded bg-blue-50 text-blue-700"><%= role.location.name %></span>
            <% end %>
          </label>
        <% end %>
      </div>
      <p class="px-6 py-3 border-t border-gray-100 text-xs text-gray-500">
        Listed: every role set to "one shift per show" on the
        <%= link_to "roles page", manage_staffing_house_roles_path, class: "text-pink-600 hover:text-pink-700 underline" %>.
        Roles tied to a venue only count for shows at that venue.
      </p>
    <% else %>
      <p class="px-6 py-5 text-sm text-gray-500">
        You don't have any per-show roles yet. Add one on the
        <%= link_to "roles page", manage_staffing_house_roles_path, class: "text-pink-600 hover:text-pink-700 underline" %>.
      </p>
    <% end %>
  </div>

  <div class="flex justify-end">
    <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
  </div>
<% end %>
