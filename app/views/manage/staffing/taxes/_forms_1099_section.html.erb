<%# The 1099-NEC section of Staffing → Taxes: a year switcher, an at-a-glance
    summary, and one row per person who's owed or has been sent a 1099 for the
    year. Editing an amount and delivery live inside per-row modals so the
    page stays a single scroll.

    Locals: tax_year, tax_years, threshold_cents, forms_by_person, earnings,
    members, tax_setting. %>
<% due_date = Tax::Calendar.nec_due_date(tax_year) %>
<% payer_ready = tax_setting&.complete? %>
<% ready_forms_count = forms_by_person.values.count { |f| f.status.in?(%w[ready delivered filed]) } %>

<div>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
    <% base_taxes_path = manage_staffing_taxes_path %>
    <%= select_tag :tax_year_switcher, options_for_select(tax_years.map { |y| [ "Tax year #{y}", y ] }, tax_year),
          class: "px-3 py-1 bg-white border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500",
          onchange: "window.location = '#{j base_taxes_path}?tax_year=' + this.value + '#form_1099s'" %>
    <div class="flex items-center gap-2">
      <% if payer_ready %>
        <% cid = "generate-1099s" %>
        <%= render "shared/button", text: "Generate #{tax_year} 1099s", variant: "secondary", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: cid } %>
        <%= render "shared/confirm_modal", id: cid,
              title: "Generate #{tax_year} 1099s?",
              message: "We'll create a draft 1099 for every contractor paid this year. Anyone with an existing draft keeps it — their amount and W-9 snapshot get refreshed.",
              confirm_text: "Generate drafts",
              url: manage_generate_1099s_staffing_taxes_path, method: :post, params: { tax_year: tax_year } %>
      <% else %>
        <span class="text-xs text-gray-500">
          Add payer details in
          <%= link_to "Tax settings", manage_staffing_settings_section_path(section: "taxes"), class: "text-pink-600" %>
          to generate 1099s.
        </span>
      <% end %>
      <% if ready_forms_count.positive? %>
        <%= render "shared/button", text: "Export IRIS CSV", variant: "outline-pink", size: "small",
              path: manage_iris_export_staffing_taxes_path(format: :csv, tax_year: tax_year) %>
      <% end %>
    </div>
  </div>

  <p class="text-sm text-gray-600 mb-3">
    Due <span class="font-medium text-gray-900"><%= due_date.strftime("%B %-d, %Y") %></span> to each contractor and to the IRS.
    Threshold: <span class="font-medium text-gray-900">$<%= threshold_cents / 100 %></span> paid in the year.
    CocoScout doesn't file for you yet — export the IRIS CSV and upload it to <a href="https://www.irs.gov/filing/e-file-forms-1099-with-iris" target="_blank" rel="noopener" class="text-pink-600 hover:text-pink-700">IRS IRIS</a>,
    then come back and mark them filed.
  </p>

  <% if members.empty? %>
    <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-6 text-center">
      <p class="text-sm text-gray-600">Nobody was paid in <%= tax_year %> yet. 1099s appear here after the first pay run of the year.</p>
    </div>
  <% else %>
    <div class="border border-gray-200 rounded-lg overflow-hidden bg-white">
      <div class="divide-y divide-gray-100">
        <% members.each do |member| %>
          <%= render "manage/staffing/taxes/form_1099_row",
                member: member,
                form: forms_by_person[member.person_id],
                earnings: earnings[member.person_id],
                threshold_cents: threshold_cents %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
