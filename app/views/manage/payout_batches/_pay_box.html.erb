<%#
  The open run's one box: who's being paid, one line on how, Pay now, and
  (for a run that pays from the CocoScout balance first) the Manage payout
  priority link that opens the Pay order window (Tim, 2026-11-22: "SO MUCH
  TEXT"). The rest (the monthly bank debit fee) is in the confirm window.

  Locals: batch, items, breakdown (PayoutBatch#money_by_item_state),
  plan (PayoutBatchService.balance_preview, or nil), balance_first
%>
<%
  org = Current.organization
  money = ->(cents) { number_to_currency(cents / 100.0) }
  ready = breakdown[:ready]
  # Zero when the bank pays the rest at once: the setting is 0, or nothing is
  # on its way into the balance (PayoutBatchService.bank_due_at_for).
  bank_due = PayoutBatchService.bank_due_at_for(org)
  days = bank_due > 1.minute.from_now ? org.payout_bank_after_days.to_i : 0
  bank_day = bank_due.in_time_zone(org.time_zone).strftime("%B %-d")
  _, deposit_by = estimated_deposit_window
  deposit_day = l(deposit_by, format: :long)

  # Whether the bank pays any of it: everything left after held money,
  # funding credit and the balance (PayoutBatchService.rest_bank_cents).
  bank_cents = PayoutBatchService.rest_bank_cents(batch)
  held_cents = batch.held_cents(items)
  people = ->(n) { n == 1 ? "1 payee is" : "#{n} payees are" }
  # A run the bank pays (no balance, or nothing in it): what CocoScout already
  # holds of it (collected contract money, course money) comes off first.
  bank_words = if bank_cents.zero?
    "CocoScout already holds this money, so nothing comes from your bank."
  elsif held_cents.positive?
    "CocoScout already holds #{money.call(held_cents)} of this run, so your bank pays #{money.call(bank_cents)}. Deposits land by about #{deposit_day}."
  else
    "Your bank pays this run, and deposits land by about #{deposit_day}."
  end

  line = if ready[:count].zero?
    "Nobody here has connected a bank yet. Their money waits on this run until they do."
  elsif balance_first && plan
    now, later = plan[:now], plan[:later]
    later_words = "The other #{later.size} (#{money.call(later.sum(&:amount_cents))})"
    if later.empty?
      "Everyone with a connected bank is paid today from your CocoScout balance."
    elsif now.any? && days.positive?
      "#{people.call(now.size)} paid today from your CocoScout balance. #{later_words} #{later.size == 1 ? 'is' : 'are'} paid as ticket money clears, or from your bank on #{bank_day}."
    elsif now.any?
      "#{people.call(now.size)} paid today from your CocoScout balance. #{later_words} #{later.size == 1 ? 'is' : 'are'} paid when your bank debit clears, about #{deposit_day}."
    elsif days.positive?
      "Your balance can't cover anyone yet. Everyone is paid as ticket money clears, or from your bank on #{bank_day}."
    else
      bank_words
    end
  else
    bank_words
  end

  can_pay = bank_cents.zero? || org.funding_payment_method_id.present?
  confirm_message = [ line, (bank_debit_note(org) if bank_cents.positive?) ].compact.join(" ")
%>
<div class="rounded-lg border border-pink-200 bg-pink-50 p-5">
  <h2 class="text-sm font-semibold text-gray-900">
    <% if ready[:count].positive? %>
      Ready to pay <%= pluralize(ready[:count], "payee") %> · <%= money.call(ready[:cents]) %>
    <% else %>
      Fund this run · <%= money.call(batch.total_cents) %>
    <% end %>
  </h2>
  <p class="text-sm text-gray-600 mt-1"><%= line %></p>
  <% if balance_first && plan && plan[:later].any? && days.positive? %>
    <% forecast = PayoutBalanceForecast.rows(batch, bank_day: bank_due.in_time_zone(org.time_zone).to_date, skip: plan[:now]) %>
    <%= render "manage/payout_batches/balance_advice", batch: batch, rows: forecast, bank_day: bank_due.in_time_zone(org.time_zone).to_date, can_move: false %>
  <% end %>
  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
    <% if can_pay %>
      <% pay_cid = "confirm-pay-batch" %>
      <%= render "shared/button", text: "Pay now", variant: "primary", size: "medium", type: :button,
            data: { controller: "modal", action: "click->modal#open", modal_id: pay_cid } %>
      <%= render "shared/confirm_modal", id: pay_cid,
            title: "Pay this run?",
            message: h(confirm_message),
            confirm_text: "Pay now",
            url: manage_fund_payout_batch_path(batch),
            method: :post %>
    <% else %>
      <%= render "shared/button", text: "Connect a bank account first", variant: "primary", size: "medium",
            path: manage_connect_payout_funding_path(return_to: manage_payout_batch_path(batch)), method: :post, form: { data: { turbo: false } } %>
    <% end %>
    <% if balance_first && ready[:count].positive? %>
      <%= render "manage/payout_batches/pay_order_link", batch: batch %>
    <% end %>
  </div>
</div>
<% if balance_first && ready[:count].positive? %>
  <%= render "manage/payout_batches/pay_order_modal", batch: batch, items: items %>
<% end %>
