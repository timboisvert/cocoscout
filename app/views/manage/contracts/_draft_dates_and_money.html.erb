<%#
  Dates and money for a contract that's out for signature or ready to send
  (Tim, 2026-11-23): the dates and payments it was sent with, from its draft,
  drawn like Dates and money. They become real bookings and payments when
  it's signed. See ContractDraftDatesAndMoney.

  Locals: contract
%>
<% draft = ContractDraftDatesAndMoney.new(contract) %>
<div class="border border-gray-200 rounded-xl bg-white">
  <div class="px-4 sm:px-5 py-4 border-b border-gray-200 flex flex-col xl:flex-row xl:items-end xl:justify-between gap-3">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Dates and money</h2>
      <p class="text-sm text-gray-600 mt-1">
        <% if contract.signing_out_for_signature? %>
          The dates and payments sent to <%= contract.contractor_name %> to sign. They're booked and scheduled when <%= contract.contractor_name %> signs.
        <% else %>
          The dates and payments on this contract. They're booked and scheduled when <%= contract.contractor_name %> signs.
        <% end %>
      </p>
    </div>
    <dl class="flex flex-wrap gap-x-6 gap-y-2 text-sm xl:flex-nowrap xl:flex-shrink-0">
      <div>
        <dt class="text-gray-600">Dates</dt>
        <dd class="font-bold text-gray-900 tabular-nums"><%= draft.date_count %></dd>
      </div>
      <div>
        <dt class="text-gray-600">Payments</dt>
        <dd class="font-bold text-gray-900 tabular-nums"><%= draft.payment_count %></dd>
      </div>
    </dl>
  </div>

  <div class="p-2 sm:p-3">
    <% if draft.rows.empty? %>
      <p class="px-2 py-6 text-sm text-gray-600 text-center">No dates or payments yet.</p>
    <% else %>
      <div class="hidden md:grid grid-cols-[3.5rem_minmax(0,1.1fr)_minmax(0,1.6fr)] gap-3 px-3 pb-2 text-xs font-semibold text-gray-600 uppercase tracking-wide">
        <span>Date</span><span>Booking</span><span>Money</span>
      </div>
      <div class="space-y-1.5">
        <% draft.rows.each do |row| %>
          <div class="rounded-lg border border-gray-200 <%= row.night? ? 'bg-white' : 'bg-gray-50' %>">
            <div class="grid grid-cols-[3.5rem_minmax(0,1fr)] md:grid-cols-[3.5rem_minmax(0,1.1fr)_minmax(0,1.6fr)] gap-x-3 gap-y-2 items-center px-3 py-2.5">
              <div class="text-center">
                <div class="text-[11px] font-semibold text-pink-600 uppercase"><%= row.date.strftime("%b") %></div>
                <div class="text-xl font-bold text-gray-900 leading-tight"><%= row.date.strftime("%-d") %></div>
                <div class="text-[11px] text-gray-600"><%= row.date.strftime("%a") %></div>
              </div>

              <div class="min-w-0">
                <% if row.night? %>
                  <div class="flex items-center gap-2 flex-wrap">
                    <%= render "manage/contracts/event_type_badges", event_types: [ row.event_type ] %>
                    <span class="text-sm text-gray-900">
                      <%= row.starts_at.strftime("%-l:%M %p") %><% if row.ends_at %> – <%= row.ends_at.strftime("%-l:%M %p") %><% end %>
                    </span>
                  </div>
                  <div class="text-xs text-gray-600 mt-0.5">
                    <%= [ row.place, row.show_time ].compact.join(" · ") %>
                  </div>
                <% else %>
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="inline-flex items-center rounded-md bg-white px-2 py-0.5 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-300">Payment</span>
                    <span class="text-sm font-semibold text-gray-900"><%= row.title %></span>
                  </div>
                  <div class="text-xs text-gray-600 mt-0.5"><%= row.subtitle %></div>
                <% end %>
              </div>

              <div class="col-span-2 md:col-span-1 md:col-start-3 space-y-1.5 max-md:pl-[4.25rem]">
                <% row.lines.each do |line| %>
                  <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-3 items-start">
                    <p class="text-sm text-gray-700"><%= line.text %></p>
                    <div class="text-right min-w-[5rem] md:min-w-[6.5rem]">
                      <% if line.amount %>
                        <div class="text-base font-bold tabular-nums text-gray-900"><%= line.amount %></div>
                      <% end %>
                      <% if line.note %>
                        <div class="text-xs text-gray-600"><%= line.note %></div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
