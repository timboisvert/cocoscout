<%#
  "Payout calculation" — the box that says which payout calculation a
  production's shows start from, with the picker and the wizard one click
  away. Used on the production's payouts page (Money → Payouts → production),
  under the performer-pay switch. A show can still choose or customize its own
  on its payout page. NOTE: keep ERB tags out of this comment.

  Locals:
    production (required)
    return_to  (required) path to come back to after picking/creating
%>
<%
  production = local_assigns.fetch(:production)
  return_to  = local_assigns.fetch(:return_to)
  organization = production.organization
  current_calculation = PayoutScheme.current_default_for_production(production)
  calculations = organization.payout_schemes.active.order(:name).to_a
  shows_using_current = current_calculation ? ShowPayout.where(payout_scheme: current_calculation, show: production.shows).count : 0
  create_path = manage_money_payout_calculation_wizard_start_path(production_id: production.id, return_to: return_to)
  picker_id = "pick-production-calculation"
  update_url = update_pay_manage_production_path(production)
%>
<div class="mb-6 bg-white rounded-lg border <%= current_calculation ? 'border-gray-200' : 'border-pink-200' %> p-5">
  <div class="mb-3">
    <h3 class="font-semibold text-gray-900">Payout calculation</h3>
    <p class="text-sm text-gray-500 mt-0.5">
      Every show of <%= production.name %> starts from this. A show can choose a different calculation, or customize its amounts, on its own payout page.
    </p>
  </div>

  <% if current_calculation %>
    <div class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="font-semibold text-gray-900"><%= current_calculation.name %></span>
        <% if current_calculation.act_based? %>
          <span class="inline-flex items-center rounded bg-pink-100 px-1.5 py-0.5 text-[10px] font-semibold text-pink-700">Per act</span>
        <% end %>
        <span class="text-xs text-gray-500">
          · <%= shows_using_current.zero? ? "no shows have used it yet" : "used by #{pluralize(shows_using_current, 'show')} so far" %>
        </span>
      </div>
      <% if current_calculation.rules_summary.present? %>
        <p class="text-sm text-gray-600 mt-0.5"><%= current_calculation.rules_summary %></p>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-pink-300 bg-pink-50 px-4 py-3">
      <p class="font-medium text-gray-900">No payout calculation chosen yet</p>
      <p class="text-sm text-gray-600 mt-0.5">
        Nothing can be worked out for these shows until you choose how performers are paid.
        <% if production.act_based? %>This production casts by acts — most like it pay per act.<% end %>
      </p>
    </div>
  <% end %>

  <div class="mt-4 flex flex-wrap gap-2">
    <% if current_calculation %>
      <%= link_to manage_money_payout_calculation_path(current_calculation) do %>
        <%= render "shared/button", text: "View calculation", variant: "secondary", size: "small", type: :button %>
      <% end %>
    <% end %>
    <%= render "shared/button",
          text: (current_calculation ? "Change calculation" : "Choose a calculation"),
          variant: (current_calculation ? "secondary" : "primary"), size: "small", type: :button,
          data: { controller: "modal", action: "click->modal#open", modal_id: picker_id } %>
    <%= link_to create_path do %>
      <%= render "shared/button", text: "Create a new calculation", variant: (current_calculation ? "secondary" : "primary"), size: "small", type: :button %>
    <% end %>
  </div>
</div>

<%= render "manage/payout_calculations/picker_modal",
      id: picker_id,
      url: update_url,
      method: :patch,
      calculations: calculations,
      current: current_calculation,
      title: "Choose #{production.name}'s payout calculation",
      intro: "Every show of this production starts from the calculation you pick. Shows that haven't been calculated yet switch over right away.",
      confirm_text: "Use this calculation",
      hidden_fields: { performers_paid: "1", return_to: return_to },
      create_path: create_path %>
