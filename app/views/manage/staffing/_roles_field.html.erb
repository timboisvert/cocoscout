<%# Role assignment checkboxes + a "Manage roles" modal (Turbo-frame) for
    adding/removing house roles without leaving the page. The modal (which
    contains its own forms) is deferred via content_for :staffing_modals so it
    renders OUTSIDE the surrounding form — the parent view must yield
    :staffing_modals after its form. New roles sync into the checkbox grid when
    the modal closes. Locals: house_roles, assigned_ids (array of ids). %>
<% if house_roles.empty? %>
  <p class="text-sm text-gray-500 mb-3" id="staff-roles-empty">No roles yet — add some so you can mark what this person is qualified for.</p>
<% end %>
<div id="staff-roles-list" class="grid grid-cols-2 sm:grid-cols-3 gap-2">
  <% house_roles.each do |role| %>
    <label class="relative cursor-pointer">
      <input type="checkbox" name="house_role_ids[]" value="<%= role.id %>" <%= "checked" if assigned_ids.include?(role.id) %> class="sr-only peer">
      <span class="block text-center text-sm font-medium px-2 py-3 rounded-lg border bg-white text-gray-700 border-gray-200 hover:border-pink-400 peer-checked:bg-pink-500 peer-checked:text-white peer-checked:border-pink-500 transition-colors"><%= role.name %></span>
    </label>
  <% end %>
</div>

<div class="mt-3" data-controller="modal">
  <%= render "shared/button", text: "Manage roles", variant: "ghost", size: "small", icon: "cog", type: :button,
        data: { action: "click->modal#open", "modal-id": "roles-modal" } %>
</div>

<% content_for :staffing_modals do %>
  <div id="roles-modal" data-controller="modal roles-field"
       data-roles-field-list-value="staff-roles-list" data-roles-field-empty-value="staff-roles-empty"
       class="hidden fixed inset-0 z-[70] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->modal#closeOnBackdrop click->roles-field#sync">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl" data-action="click->modal#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
          <h3 class="text-base font-semibold text-gray-900">House roles</h3>
          <%= render "shared/button", text: "", icon: "x-mark", variant: "ghost", size: "small", type: :button,
                data: { action: "click->modal#close click->roles-field#sync" } %>
        </div>
        <div class="px-5 py-4">
          <%= turbo_frame_tag "house_roles_manager", src: manage_staffing_house_roles_editor_path, loading: :lazy,
                data: { "roles-field-target": "frame" } do %>
            <p class="text-sm text-gray-400 py-2">Loading…</p>
          <% end %>
        </div>
        <div class="flex items-center justify-end px-5 py-3 border-t border-gray-200">
          <%= render "shared/button", text: "Done", variant: "primary", size: "small", type: :button,
                data: { action: "click->modal#close click->roles-field#sync" } %>
        </div>
      </div>
    </div>
  </div>
<% end %>
