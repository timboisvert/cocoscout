<% content_for :title, "For Producers — CocoScout" %>

<div class="min-h-screen bg-[#f9f9f7]">
  <%= render "shared/marketing/header" %>

  <main class="flex flex-col min-w-full">

    <%# ============================ HERO ============================ %>
    <section class="w-full px-6 pt-16 pb-14 sm:pt-24 sm:pb-20 bg-gradient-to-br from-pink-50 via-white to-slate-50">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-pink-500 font-bold text-sm uppercase tracking-wide mb-4">For production companies, theatres &amp; venues</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-900 mb-5 coustard-regular leading-tight">
          The command center for live entertainment.
        </h1>
        <p class="text-lg sm:text-xl max-w-2xl mx-auto text-slate-600 leading-relaxed mb-8">
          Program shows, cast performers, sign contracts, schedule staff, and make payroll — the whole
          operation on one platform, built for how live production actually works.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <%= render "shared/button", text: "See the platform", path: "#platform", variant: "primary", size: "large" %>
          <%= render "shared/button", text: "Compare plans", path: pricing_path, variant: "outline", size: "large" %>
        </div>
      </div>
    </section>

    <%# ==================== THE PATCHWORK ENDS HERE ==================== %>
    <section class="w-full px-6 py-16 sm:py-20 border-t border-slate-100">
      <div class="max-w-6xl mx-auto">
        <div class="max-w-3xl mb-10">
          <p class="text-pink-500 font-bold text-sm uppercase tracking-wide mb-3">One platform, not ten</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 coustard-regular leading-tight">
            Stop running your company on tools that were never built for it.
          </h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <% [
            ["Instead of Gusto", "Payroll for cast, crew, staff, and contractors — one run, paid straight to their bank."],
            ["Instead of DocuSign", "Contracts you send and get e-signed in minutes."],
            ["Instead of Google Forms", "Auditions and sign-ups with reviewing and voting built in."],
            ["Instead of Google Sheets", "Casting boards, schedules, and financials — no more tangled tabs."]
          ].each do |instead, replacement| %>
            <div class="rounded-2xl border border-slate-200 bg-white p-6">
              <div class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1.5"><%= instead %></div>
              <div class="text-slate-800 leading-relaxed"><%= replacement %></div>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <%# ==================== DEEP FEATURE AREAS ==================== %>
    <div id="platform"></div>
    <% [
      { bg: "bg-white", eyebrow: "Program &amp; schedule", title: "Plan every show, rehearsal, and event.",
        desc: "Your whole calendar in one place, per production — so nothing slips and everyone knows what's next.",
        bullets: ["Shows, rehearsals, meetings, and one-off events", "Recurring events and multi-show runs", "Per-production calendars your whole team can see", "Courses and classes with registration built in"] },
      { bg: "bg-[#f9f9f7]", eyebrow: "Cast &amp; crew", title: "Cast your show and fill every role.",
        desc: "From talent pools to the final cast list — plus intake, review, and communication in one flow.",
        bullets: ["Roles and talent pools you reuse across shows", "Multi-show casting tables — every role in every show, on one board", "Auditions and sign-ups with reviewing and voting", "Availability tracking, contacts, groups, and documents", "Message your cast and crew without leaving the platform"] },
      { bg: "bg-white", eyebrow: "Money &amp; contracts", title: "Get paid, and put the deal in writing.",
        desc: "Track the money on every show, pay your performers, and send contracts that get signed.",
        bullets: ["Show and production financials — revenue and expenses", "Payout calculations and splits, worked out for you", "Pay performers straight to their bank", "Booking contracts with native e-signatures", "Revenue, payout, and participation reports"] },
      { bg: "bg-[#f9f9f7]", eyebrow: "Staffing &amp; payroll", title: "Schedule your team and make payroll.",
        desc: "The full staffing stack — from the weekly schedule to the pay run — built for live venues.",
        bullets: ["Build the week and assign shifts", "Staff log their hours; you approve before you pay", "One pay run — hours, bonuses, reimbursements, and tips", "House roles with default rates, departments, and org chart", "Contractor payments with tax handled — W-2 and full payroll with Enterprise"] }
    ].each do |area| %>
      <section class="w-full px-6 py-16 sm:py-20 border-t border-slate-100 <%= area[:bg] %>">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-10 items-start">
          <div>
            <p class="text-pink-500 font-bold text-sm uppercase tracking-wide mb-3"><%= area[:eyebrow].html_safe %></p>
            <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 coustard-regular leading-tight mb-4"><%= area[:title] %></h2>
            <p class="text-lg text-slate-600 leading-relaxed"><%= area[:desc] %></p>
          </div>
          <ul class="space-y-3">
            <% area[:bullets].each do |b| %>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 w-6 h-6 rounded-full bg-pink-100 text-pink-500 flex items-center justify-center flex-shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                </span>
                <span class="text-slate-800 leading-relaxed"><%= b %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </section>
    <% end %>

    <%# ============================ TIERS ============================ %>
    <section class="w-full px-6 py-16 sm:py-20 border-t border-slate-100">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <p class="text-pink-500 font-bold text-sm uppercase tracking-wide mb-3">Three tiers</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 coustard-regular leading-tight">
            From your first show to a full operation.
          </h2>
        </div>
        <%= render "home/tier_cards" %>
        <p class="mt-6 text-center text-sm text-slate-500">
          <%= link_to "See the full feature comparison", pricing_path, class: "text-pink-600 hover:text-pink-700 font-medium" %>
        </p>
      </div>
    </section>

    <%# ============================ CTA BAND ============================ %>
    <section class="w-full bg-pink-500 text-white px-6 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl coustard-regular mb-3">Run your whole production in one place.</h2>
        <p class="text-pink-100 text-lg mb-8 max-w-2xl mx-auto">See how CocoScout fits your company — or start building your first show today.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <%= link_to "Talk to us", "mailto:hello@cocoscout.com",
                class: "inline-flex justify-center items-center px-8 py-3 rounded bg-white text-pink-700 font-semibold hover:bg-pink-50 transition" %>
          <%= link_to "Start free", signup_path(intent: "producer"),
                class: "inline-flex justify-center items-center px-8 py-3 rounded border border-white/70 text-white font-medium hover:bg-white/10 transition" %>
        </div>
      </div>
    </section>

  </main>

  <%= render "shared/marketing/footer" %>
</div>
