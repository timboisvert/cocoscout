<%#
  How Many Acts? — the modal an act-based payout calculation asks for before it can
  calculate. One row per payee on the show (cast + guests), each with an act
  count; submitting posts straight to the calculate action.

  Opens automatically when the calculate action bounced back here because the
  counts were missing (?enter_acts=1), and can be reopened from the payout page.
%>
<%
  distribution = @show_payout.act_distribution
  act_mode = PayoutScheme::ACT_MODES.include?(distribution["act_mode"].to_s) ? distribution["act_mode"].to_s : "tiers"
  per_act_rate = distribution["per_act_rate"].to_f
  tiers = PayoutScheme.act_tiers(distribution)
  act_rates = PayoutScheme.act_rates(distribution)
  additional_act_rate = PayoutScheme.additional_act_rate(distribution)
  payees = @show_payout.act_payees
  auto_open = params[:enter_acts].present?
  # In an act-based production the lineup already says how many acts each
  # person holds — the rows start from that, and a hand-adjusted count can
  # always be put back to it.
  from_lineup = @show_payout.counts_acts_from_lineup?
  lineup_counts = from_lineup ? @show.lineup_act_counts : {}
  saved_counts = @show_payout.act_counts || {}
  # Show roles (MC, Stage Kitten) each payee holds, and what the calculation
  # pays for them — shown per row so the running total matches the calculator.
  role_names_by_payee = from_lineup ? @show.show_role_names_by_payee : {}
  role_stacking = PayoutScheme.role_stacking(distribution)
%>

<div data-controller="payout-acts"
     data-payout-acts-mode-value="<%= act_mode %>"
     data-payout-acts-stacking-value="<%= role_stacking %>"
     data-payout-acts-rate-value="<%= per_act_rate %>"
     data-payout-acts-tiers-value="<%= tiers.to_json %>"
     data-payout-acts-act-rates-value="<%= act_rates.to_json %>"
     data-payout-acts-additional-rate-value="<%= additional_act_rate %>">

  <div data-payout-acts-target="modal" id="payout-acts-modal"
       class="<%= "hidden" unless auto_open %> fixed inset-0 bg-black/60 backdrop-blur-sm overflow-y-auto h-full w-full z-50"
       data-action="click->payout-acts#closeOnBackdrop keydown.esc@window->payout-acts#close">
    <div class="relative top-10 mx-auto mb-16 w-full max-w-2xl shadow-lg rounded-lg bg-white"
         data-action="click->payout-acts#stop">

      <%# Header %>
      <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-lg">
        <h3 class="text-lg font-semibold text-white">How many acts?</h3>
        <button type="button" class="text-white/70 hover:text-white cursor-pointer" data-action="payout-acts#close">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="p-5">
        <% if from_lineup %>
          <p class="text-sm text-gray-600">
            This show pays by acts, and the lineup already says how many each person holds. Adjust a count here only if the night went differently from the lineup.
          </p>
        <% else %>
          <p class="text-sm text-gray-600">
            This show pays by acts. Enter how many acts each person did and we'll apply the calculation's rules.
          </p>
        <% end %>
        <div class="mt-3 rounded-lg bg-gray-50 border border-gray-200 px-4 py-3 text-sm text-gray-700">
          <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">Pay rules</span>
          <div class="mt-1 font-medium text-gray-900"><%= @show_payout.act_rules_description %></div>
          <% if PayoutScheme.role_amounts(distribution).any? %>
            <div class="mt-1 text-xs text-gray-500">Show roles: <%= @show_payout.role_rules_description %></div>
          <% end %>
          <% if act_mode == "schedule" %>
            <div class="mt-1 text-xs text-gray-500">Each act is paid at its own rate and they add up.</div>
          <% elsif act_mode == "tiers" && distribution["additional_act_rate"].present? %>
            <div class="mt-1 text-xs text-gray-500">Each row is the total for that many acts; every act past the last row adds <%= PayoutScheme.act_money(additional_act_rate) %>.</div>
          <% elsif act_mode == "tiers" %>
            <div class="mt-1 text-xs text-gray-500">Each row is the total for that many acts; the last row is the most anyone is paid.</div>
          <% end %>
        </div>

        <% if payees.empty? %>
          <div class="mt-5 text-center py-8 text-gray-500 text-sm">
            Nobody is assigned to this show yet, so there are no acts to record.
          </div>
          <div class="mt-4 flex justify-end">
            <%= render "shared/button", text: "Close", variant: "secondary", size: "medium", type: :button,
                  data: { action: "click->payout-acts#close" } %>
          </div>
        <% else %>
          <%= form_with url: manage_calculate_money_show_payout_path(@show), method: :post, local: true, class: "mt-5" do %>

            <%# Everyone did the same number of acts, the common case %>
            <div class="flex flex-wrap items-center gap-2 pb-3 mb-1 border-b border-gray-200">
              <label class="text-sm text-gray-600" for="payout-acts-apply-all">Everyone did</label>
              <input type="number" id="payout-acts-apply-all" min="0" step="1" value="1"
                     data-payout-acts-target="applyAllInput"
                     class="w-20 rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500">
              <span class="text-sm text-gray-600">acts</span>
              <%= render "shared/button", text: "Apply to all", variant: "secondary", size: "small", type: :button,
                    data: { action: "click->payout-acts#applyAll" } %>
              <% if from_lineup %>
                <span class="ml-auto">
                  <%= render "shared/button", text: "Reset to lineup", variant: "outline", size: "small", type: :button,
                        data: { action: "click->payout-acts#resetToLineup" } %>
                </span>
              <% end %>
            </div>

            <div class="max-h-[45vh] overflow-y-auto divide-y divide-gray-100">
              <% payees.each do |payee| %>
                <%
                  key = ShowPayout.act_key(payee)
                  is_guest = payee.is_a?(ShowPersonRoleAssignment)
                  name = is_guest ? payee.guest_name : payee.name
                  headshot_variant = is_guest ? nil : payee.safe_headshot_variant(:thumb)
                  lineup_count = lineup_counts[key].to_i
                  count = if from_lineup
                    saved_counts.key?(key) ? saved_counts[key].to_i : lineup_count
                  else
                    @show_payout.act_count_for(payee)
                  end
                  held_roles = Array(role_names_by_payee[key])
                  priced_roles = held_roles.filter_map { |n| a = PayoutScheme.role_amount_for(distribution, n); [ n, a ] if a }
                  unpriced_roles = held_roles - priced_roles.map(&:first)
                  role_pay = priced_roles.sum { |_, a| a }
                %>
                <div class="flex items-center gap-3 py-2.5">
                  <% if headshot_variant %>
                    <%= image_tag headshot_variant, alt: name, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
                  <% else %>
                    <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-sm flex-shrink-0">
                      <%= is_guest ? name.to_s.split.map(&:first).first(2).join.upcase : payee.initials %>
                    </div>
                  <% end %>

                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-medium text-gray-900 truncate"><%= name %></div>
                    <% if is_guest %>
                      <div class="text-xs text-gray-500">Guest</div>
                    <% end %>
                    <% if from_lineup %>
                      <div class="text-xs text-gray-500">Counted from the lineup — <%= pluralize(lineup_count, "act") %></div>
                    <% end %>
                    <% if held_roles.any? %>
                      <div class="text-xs text-gray-500">
                        <%= priced_roles.map { |n, a| "#{n} #{PayoutScheme.act_money(a)}" }.join(", ") %><% if priced_roles.any? && unpriced_roles.any? %>, <% end %><%= unpriced_roles.map { |n| "#{n} — not priced" }.join(", ") %>
                      </div>
                    <% end %>
                  </div>

                  <input type="number" name="act_counts[<%= key %>]" value="<%= count %>" min="0" step="1"
                         data-payout-acts-target="input"
                         data-lineup-count="<%= lineup_count %>"
                         data-role-pay="<%= role_pay %>"
                         data-role-priced="<%= priced_roles.any? %>"
                         data-action="input->payout-acts#update"
                         class="w-20 rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500">

                  <span class="w-20 text-right text-sm font-medium text-gray-900 tabular-nums"
                        data-payout-acts-target="amount">$0.00</span>
                </div>
              <% end %>
            </div>

            <div class="flex items-center justify-between pt-3 mt-1 border-t border-gray-200">
              <span class="text-sm text-gray-600">Total</span>
              <span class="text-base font-semibold text-gray-900 tabular-nums" data-payout-acts-target="total">$0.00</span>
            </div>

            <div class="mt-5 flex items-center justify-end gap-3">
              <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button,
                    data: { action: "click->payout-acts#close" } %>
              <%= render "shared/button", text: "Calculate Payouts", variant: "primary", size: "medium", type: :submit %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
