<%
  offering = @course_offering
  registration = @registration
  sessions = offering.sessions.includes(:location, :location_space).to_a
  first = sessions.find { |s| s.date_and_time >= Time.current } || sessions.first
  place = first && [ first.location&.name, first.location_space&.name ].compact.uniq.join(" · ")
  free = registration.total_cents.zero?
  pay_text = free ? "Register" : "Pay #{number_to_currency(registration.total_cents / 100.0)}"
  back_path = my_course_show_path(code: offering.short_code)
  quote = CourseTax.quote(offering)
  lines = [ [ "Course fee", registration.amount_cents, false ] ]
  lines << [ quote.label, registration.tax_cents, true ] if registration.tax_cents.positive?
  wide = @production.wide_image.attached? ? @production.safe_wide_image_variant : nil
  poster = wide ? nil : @production.safe_poster_variant(:small)
%>
<% content_for :title, "Checkout · #{offering.title}" %>
<% content_for :head do %>
  <% unless free || @expired %><script src="https://js.stripe.com/v3/"></script><% end %>
<% end %>

<%# Layout A, like a ticket checkout: the same shared/checkout partials. %>
<div class="mx-auto max-w-xl space-y-5">
  <h1 class="text-center text-3xl sm:text-4xl coustard-regular text-gray-900">Checkout</h1>

  <% if @expired %>
    <%= render "shared/checkout/expired", held: "your spot", back_path: back_path, back_text: "Back to the course" %>
  <% else %>
    <%= form_with url: my_course_checkout_pay_path(code: offering.short_code, token: registration.token), method: :post, class: "space-y-5",
          data: {
            controller: "checkout",
            action: "submit->checkout#submit",
            checkout_target: "form",
            checkout_publishable_key_value: stripe_publishable_key.to_s,
            checkout_amount_value: registration.total_cents,
            checkout_free_value: free,
            checkout_return_url_value: my_course_checkout_done_url(code: offering.short_code, token: registration.token),
            checkout_expires_at_value: registration.expires_at&.iso8601,
            checkout_token_value: registration.token
          } do %>
      <%= render "tickets/bot_trap", id: "checkout_website" %>

      <%# The course, and every cent of it. %>
      <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="flex items-center gap-4 px-5 py-4">
          <% if wide || poster %>
            <%= image_tag (wide || poster), alt: "", class: "#{wide ? 'w-24' : 'w-14'} h-auto rounded-lg flex-shrink-0" %>
          <% end %>
          <div class="min-w-0 flex-1 text-left">
            <div class="font-semibold text-gray-900 truncate"><%= offering.title %></div>
            <% if first %>
              <div class="text-sm text-gray-600">
                <%= sessions.size > 1 ? "Starts " : "" %><%= first.date_and_time.strftime("%a, %b %-d · %-l:%M %p") %><% if sessions.size > 1 %> · <%= pluralize(sessions.size, "session") %><% end %>
              </div>
            <% end %>
            <% if place.present? %><div class="text-sm text-gray-500 truncate"><%= place %></div><% end %>
          </div>
        </div>
        <%= render "shared/checkout/summary", lines: lines, total_cents: registration.total_cents %>
        <%= render "shared/checkout/countdown", back_path: back_path, back_text: "Back to the course" %>
      </div>

      <%# Students keep an account, so who's registering is already known. %>
      <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4 flex items-center gap-3">
        <% headshot = @person.safe_headshot_variant(:thumb) %>
        <% if headshot %>
          <%= image_tag headshot, alt: @person.name, class: "w-10 h-10 rounded-lg object-cover" %>
        <% else %>
          <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-sm"><%= @person.initials %></div>
        <% end %>
        <div class="min-w-0 flex-1 text-sm">
          <div class="text-gray-600">Registering as</div>
          <div class="font-medium text-gray-900 truncate"><%= @person.name %> · <%= Current.user.email_address %></div>
        </div>
      </div>

      <%= render "shared/checkout/payment" unless free %>

      <p data-checkout-target="error" class="hidden text-sm text-red-600 text-center" role="alert"></p>

      <%= render "shared/button", text: pay_text, variant: "primary", size: "jumbo", type: :submit, classes: "disabled:opacity-50",
            data: { checkout_target: "submit", pay_prefix: (free ? "" : "Pay ") } %>
    <% end %>
  <% end %>
</div>
