#!/bin/sh
# The checks GitHub's CI runs on every push, run here first, so a push that
# would turn CI red stops before it leaves (Tim, 2026-11-20: half the pushes
# were failing a GitHub check). The same commands as .github/workflows/ci.yml:
#
#   scan_ruby  bin/brakeman --no-pager     (about a minute)
#   scan_js    bin/importmap audit
#   lint       bin/rails routes:validate_helpers
#              (RuboCop already runs on every commit: .githooks/pre-commit)
#
# The test suite isn't here: the deploy runs it (.kamal/hooks/pre-build).
#
# Enable (one time, per clone):   git config core.hooksPath .githooks
# Bypass for one push:            git push --no-verify

if ! command -v bundle >/dev/null 2>&1; then
  echo "pre-push: 'bundle' not found in PATH — skipping GitHub's checks. (Is RVM/your Ruby loaded in this shell?)"
  exit 0
fi

failed=""

echo "pre-push: route helpers in views…"
bin/rails routes:validate_helpers >/tmp/cocoscout-pre-push-routes.log 2>&1 || { cat /tmp/cocoscout-pre-push-routes.log; failed="$failed route-helpers"; }

echo "pre-push: JavaScript dependencies…"
bin/importmap audit >/tmp/cocoscout-pre-push-importmap.log 2>&1 || { cat /tmp/cocoscout-pre-push-importmap.log; failed="$failed importmap-audit"; }

echo "pre-push: Brakeman (about a minute)…"
# --ensure-latest is in bin/brakeman, as in CI: a newer Brakeman release
# fails here exactly as it would there (bundle update brakeman --conservative).
bin/brakeman --no-pager -q || failed="$failed brakeman"

if [ -n "$failed" ]; then
  echo
  echo "pre-push: GitHub's CI would fail on:$failed — push stopped."
  echo "  • skip the checks this once: git push --no-verify"
  exit 1
fi

echo "pre-push: GitHub's checks pass."
exit 0
