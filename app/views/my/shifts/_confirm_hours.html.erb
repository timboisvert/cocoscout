<%# Needs-attention: recent past shifts the worker hasn't confirmed hours for.
    Rendered only when @unconfirmed_shifts is present, inside the page's
    modal + time-entry-form wrapper. %>
<% dt = ->(t) { t&.strftime("%Y-%m-%dT%H:%M") } %>
<div class="rounded-xl border border-amber-200 bg-amber-50 p-4 mb-6">
  <div class="flex items-center gap-2 mb-1">
    <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
    <h2 class="text-base font-semibold text-amber-900">Confirm your hours</h2>
  </div>
  <p class="text-sm text-amber-800 mb-3">Check the hours you actually worked so they can be paid. Confirm as-is or adjust the times.</p>
  <div class="space-y-2">
    <% @unconfirmed_shifts.each do |a| %>
      <% s = a.shift %>
      <div class="flex items-center justify-between gap-3 bg-white border border-amber-200 rounded-lg px-3 py-2">
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-900 truncate"><%= s.starts_at.strftime("%a %b %-d") %> · <%= s.role_label %></div>
          <div class="text-xs text-gray-500"><%= s.starts_at.strftime("%-l:%M %p") %>–<%= s.ends_at.strftime("%-l:%M %p") %> · <%= s.organization.name %> · <%= number_with_precision(s.scheduled_hours, precision: 2, strip_insignificant_zeros: true) %>h scheduled</div>
        </div>
        <%= render "shared/button", text: "Confirm", variant: "primary", size: "small", type: :button,
              data: { action: "click->modal#open click->time-entry-form#load", "modal-id": "time-entry-modal",
                      mode: "confirm", url: my_time_entries_path, method: "post",
                      "assignment-id": a.id, started: dt.call(s.starts_at), ended: dt.call(s.ends_at),
                      title: "Confirm your hours" } %>
      </div>
    <% end %>
  </div>
</div>
