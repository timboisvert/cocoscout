<%# A bill in a modal: a new one typed in by hand, or an existing one to correct.
    locals: id, expense (CompanyExpense), vendors, title, url, method, submit_text %>
<% form_id = "#{id}-form" %>
<div id="<%= id %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center sm:p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full sm:max-w-4xl overflow-hidden max-h-[90vh] flex flex-col" data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white"><%= title %></h3>
      <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <div class="px-6 py-5 overflow-y-auto">
      <%= form_with url: url, method: method, id: form_id, multipart: true, data: { turbo_action: "replace" } do %>
        <%= render "superadmin/costs/fields", expense: expense, vendors: vendors, key: id %>
        <div class="mt-4">
          <%= label_tag "#{id}-files", expense.persisted? && expense.documents.any? ? "Add another file (a reimbursement form, a second page)" : "The bill or receipt (PDF or a picture)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= file_field_tag "files[]", id: "#{id}-files", multiple: true, accept: "application/pdf,image/*",
                class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-pink-50 file:text-pink-700 hover:file:bg-pink-100" %>
        </div>
      <% end %>
    </div>
    <div class="px-4 sm:px-6 pt-3 pb-[calc(env(safe-area-inset-bottom)+12px)] sm:py-4 bg-gray-50 border-t border-gray-200 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-2 [&>*]:w-full sm:[&>*]:w-auto [&_button]:w-full sm:[&_button]:w-auto">
      <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
      <%= render "shared/button", text: submit_text, variant: "primary", size: "medium", type: :submit, form_id: form_id %>
    </div>
  </div>
</div>
