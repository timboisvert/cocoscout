<% content_for :title, @production ? "#{@production.name} Payouts" : "Payouts" %>

<%
  payouts_actions = [
    { icon: "dollar-sign", text: "Payout Runs", description: "Pay connected banks at once", path: manage_payout_batches_path },
    { icon: "banknotes", text: "Advances", description: "Pre-show payments", path: manage_money_advances_path },
    { icon: "puzzle-piece", text: "Payout Calculations", description: "How performers are paid", path: manage_money_payout_calculations_path }
  ]
%>

<div class="w-full mb-10" data-controller="modal">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <% if @production %>
    <%= render partial: "shared/top_menu", locals: {
      breadcrumbs: [
        ["Money", manage_money_index_path],
        ["Payouts", manage_money_payouts_path]
      ],
      text: @production.name,
      links: []
    } %>

    <%# Does this production pay performers at all? Off hides everything that
        only matters when it does. %>
    <%= render "manage/payout_calculations/production_pay_switch",
          production: @production,
          return_to: manage_money_production_payouts_path(@production) %>

    <% if @production.pays_performers? %>
    <%# Money by state for this production — the same idea as the all-productions
        page, limited to these shows. %>
    <% to_pay = [ @total_awaiting_payout.to_f - @total_awaiting_in_run.to_f, 0 ].max %>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-4 mb-6">
      <div class="rounded-lg border p-3 sm:p-5 <%= @needs_calculation_count.positive? ? "bg-pink-50 border-pink-200" : "bg-white border-gray-200" %>">
        <div class="text-sm text-gray-500 sm:mb-1">Awaiting calculation</div>
        <div class="text-lg sm:text-2xl font-semibold text-pink-600 tabular-nums"><%= @needs_calculation_count %></div>
        <div class="hidden sm:block text-xs text-gray-400 mt-0.5"><%= "show".pluralize(@needs_calculation_count) %> already happened, not worked out yet</div>
      </div>
      <div class="rounded-lg border p-3 sm:p-5 <%= to_pay.positive? ? "bg-pink-50 border-pink-200" : "bg-white border-gray-200" %>">
        <div class="text-sm text-gray-500 sm:mb-1">To pay</div>
        <div class="text-lg sm:text-2xl font-semibold text-pink-600 tabular-nums"><%= number_to_currency(to_pay) %></div>
        <div class="hidden sm:block text-xs text-gray-400 mt-0.5">owed, not in a run yet</div>
      </div>
      <div class="rounded-lg border p-3 sm:p-5 <%= @total_awaiting_in_run.to_f.positive? ? "bg-amber-50 border-amber-200" : "bg-white border-gray-200" %>">
        <div class="text-sm text-gray-500 sm:mb-1">In a payout run</div>
        <div class="text-lg sm:text-2xl font-semibold text-amber-600 tabular-nums"><%= number_to_currency(@total_awaiting_in_run.to_f) %></div>
        <div class="hidden sm:block text-xs text-gray-400 mt-0.5">on its way</div>
      </div>
      <div class="rounded-lg border p-3 sm:p-5 bg-white border-gray-200">
        <div class="text-sm text-gray-500 sm:mb-1">Paid</div>
        <div class="text-lg sm:text-2xl font-semibold text-gray-900 tabular-nums"><%= number_to_currency(@total_paid.to_f) %></div>
        <div class="hidden sm:block text-xs text-gray-400 mt-0.5">to <%= pluralize(@paid_people_count.to_i, "payee") %> across <%= pluralize(@paid_shows_count.to_i, "show") %></div>
      </div>
    </div>

    <%# Which calculation this production's shows start from — set it here;
        a show can choose or customize its own on its payout page. %>
    <%= render "manage/payout_calculations/production_calculation_card",
          production: @production,
          return_to: manage_money_production_payouts_path(@production) %>

    <%# Waiting on payment info — people owed (or about to be owed) who
        can't be paid until they set up their payment info. %>
    <div class="mb-6 bg-white rounded-lg border <%= @missing_payment_info.any? ? 'border-blue-200' : 'border-gray-200' %> p-5" data-controller="show-toggle qr-code" data-qr-code-url-value="<%= my_payments_setup_url %>">
      <div class="mb-3">
        <h3 class="font-semibold text-gray-900">
          <% if @missing_payment_info.any? %>
            Waiting on payment info
          <% else %>
            Payment info
          <% end %>
        </h3>
        <p class="text-sm text-gray-500 mt-0.5">
          <% if @missing_payment_info.any? %>
            <span class="font-semibold text-gray-900"><%= @missing_payment_info.count %></span> talent pool <%= "member".pluralize(@missing_payment_info.count) %> can't be paid until they set up their payment info.
          <% else %>
            Everyone in the talent pool has set up their payment info.
          <% end %>
        </p>
      </div>

      <% if @missing_payment_info.any? %>
        <div class="flex flex-wrap gap-1.5 mb-3">
          <% @missing_payment_info.first(12).each do |person| %>
            <span class="inline-flex items-center px-2 py-0.5 bg-gray-100 text-gray-600 rounded text-xs"><%= person.name %></span>
          <% end %>
          <% if @missing_payment_info.count > 12 %>
            <button type="button" data-action="click->show-toggle#toggle" class="inline-flex items-center px-2 py-0.5 bg-gray-100 text-gray-500 rounded text-xs cursor-pointer hover:bg-gray-200">+<%= @missing_payment_info.count - 12 %> more</button>
          <% end %>
        </div>
        <% if @missing_payment_info.count > 12 %>
          <div data-show-toggle-target="content" class="hidden mb-3">
            <div class="flex flex-wrap gap-1.5">
              <% @missing_payment_info.drop(12).each do |person| %>
                <span class="inline-flex items-center px-2 py-0.5 bg-gray-100 text-gray-600 rounded text-xs"><%= person.name %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

      <div class="flex flex-wrap gap-2">
        <% if @missing_payment_info.any? %>
          <%= render "shared/button", text: "Send Reminders", variant: "primary", size: "small", icon: "mail", data: { action: "click->modal#open", "modal-id": "notify-modal" } %>
        <% end %>
        <%= render "shared/button", text: "QR Code", variant: "secondary", size: "small", icon: "qr-code", data: { action: "click->qr-code#open" } %>
      </div>

      <%# QR Code Modal %>
      <div data-qr-code-target="modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center" data-action="click->qr-code#closeOnBackdrop keydown.esc@window->qr-code#closeOnEscape">
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4" data-action="click->qr-code#stopPropagation">
          <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-semibold text-gray-900">Payment Setup QR Code</h3>
            <button type="button" data-action="click->qr-code#close" class="text-gray-400 hover:text-gray-600 cursor-pointer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <div class="p-6 text-center">
            <p class="text-sm text-gray-600 mb-4">Show this QR code at your venue. When scanned, it takes performers to their payment setup page.</p>
            <div class="inline-block p-4 bg-white border-2 border-gray-200 rounded-lg">
              <canvas data-qr-code-target="canvas" width="200" height="200"></canvas>
            </div>
            <p class="text-xs text-gray-500 mt-4"><%= my_payments_setup_url %></p>
            <button type="button" data-action="click->qr-code#download" class="mt-4 inline-flex items-center gap-1.5 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200 transition cursor-pointer">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              Download
            </button>
          </div>
        </div>
      </div>
    </div>

    <%# Prioritised lists — address these first, then everything. %>
    <div class="pt-6 border-t border-gray-200 space-y-8">
      <% if @awaiting_calculation_shows.any? %>
        <div>
          <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Awaiting Calculation</h3>
          <%= render layout: "shared/slim_list", locals: { label: "Show", columns: [ "Awaiting", "Paid" ] } do %>
            <%= render "manage/money_payouts/payout_show_rows", shows: @awaiting_calculation_shows %>
          <% end %>
        </div>
      <% end %>

      <% if @awaiting_payout_shows.any? %>
        <div>
          <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Awaiting Payout</h3>
          <%= render layout: "shared/slim_list", locals: { label: "Show", columns: [ "Awaiting", "Paid" ] } do %>
            <%= render "manage/money_payouts/payout_show_rows", shows: @awaiting_payout_shows %>
          <% end %>
        </div>
      <% end %>

      <div>
        <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">All Shows</h3>
        <% if @all_payout_shows.any? %>
          <%= render layout: "shared/slim_list", locals: { label: "Show", columns: [ "Awaiting", "Paid" ] } do %>
            <%= render "manage/money_payouts/payout_show_rows", shows: @all_payout_shows %>
          <% end %>
        <% else %>
          <div class="bg-gray-50 rounded-lg border border-dashed border-gray-300 p-8 text-center">
            <p class="text-gray-600">No past revenue events yet.</p>
          </div>
        <% end %>
      </div>
    </div>

    <%# Notify Modal %>
    <div id="notify-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center overflow-y-auto py-8" data-action="click->modal#closeOnBackdrop keydown.esc@window->modal#close">
      <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4" data-action="click->modal#stopPropagation">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Send Payment Setup Reminder</h3>
          <button type="button" data-action="click->modal#close" class="text-gray-400 hover:text-gray-600 cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="p-6">
          <%# Recipients Summary %>
          <div class="mb-4 pb-4 border-b border-gray-100">
            <div class="flex items-center gap-2 text-sm text-gray-600 mb-2">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span><strong><%= @missing_payment_info.count %></strong> <%= "recipient".pluralize(@missing_payment_info.count) %></span>
            </div>
            <div class="flex flex-wrap gap-1.5">
              <% @missing_payment_info.first(8).each do |person| %>
                <span class="inline-flex items-center px-2 py-0.5 bg-gray-100 text-gray-600 rounded text-xs">
                  <%= person.name %>
                </span>
              <% end %>
              <% if @missing_payment_info.count > 8 %>
                <span class="inline-flex items-center px-2 py-0.5 bg-gray-100 text-gray-500 rounded text-xs">
                  +<%= @missing_payment_info.count - 8 %> more
                </span>
              <% end %>
            </div>
          </div>

          <%= form_with url: manage_send_payment_setup_reminders_money_payouts_path(@production), method: :post, local: true, class: "space-y-4" do %>
            <%# Email Editor %>
            <%= fields_for :email_draft, @payment_reminder_email_draft do |email_form| %>
              <div class="space-y-3">
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1">Subject</label>
                  <%= email_form.text_field :title, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 placeholder:text-gray-400 focus:border-pink-500 focus:ring-pink-500 text-sm", placeholder: "Email subject..." %>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1">Message</label>
                  <%= email_form.rich_text_area :body, class: "w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-pink-500 focus:border-transparent" %>
                </div>
              </div>
            <% end %>

            <div class="flex items-center justify-end gap-3 pt-2">
              <%= render "shared/button", text: "Cancel", variant: "ghost-cancel", type: :button, data: { action: "click->modal#close" } %>
              <%= render "shared/button", text: "Send Reminders", variant: "primary", size: "medium", type: :submit, icon: "paper-airplane" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <% else %>
      <%# Performer pay is off. Anything already worked out stays visible as history. %>
      <% past = @all_payout_shows.select { |s| s.show_payout&.calculated_at } %>
      <% if past.any? %>
        <div class="pt-2">
          <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Past payouts</h3>
          <%= render layout: "shared/slim_list", locals: { label: "Show", columns: [ "Awaiting", "Paid" ] } do %>
            <%= render "manage/money_payouts/payout_show_rows", shows: past %>
          <% end %>
        </div>
      <% end %>
    <% end %>

  <% else %>
    <%# All Productions View — breadcrumb like the financials page, then just the
        three action buttons (no big title / description). %>
    <%= render partial: "shared/top_menu", locals: {
      breadcrumbs: [ [ "Money", manage_money_index_path ] ],
      text: "Payouts",
      links: []
    } %>
    <div class="mb-6"><%= render "shared/module_actions", actions: payouts_actions %></div>

    <%# Money by state — what still has to happen to it. The same numbers as the
        sections below: "To pay" is the Awaiting Payout money not yet in a run;
        the other three split the Active Runs money by lifecycle stage, so a
        partially paid run counts only its unpaid remainder. %>
    <% d = @run_state_detail %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-4 mb-8">
      <%# Each box wears its state's color while it holds money; empty ones stay quiet. %>
      <div class="rounded-lg border p-3 sm:p-5 flex items-center justify-between sm:block <%= @todo.payouts.amounts[:to_pay].to_f.positive? ? "bg-pink-50 border-pink-200" : "bg-white border-gray-200" %>">
        <div class="text-sm text-gray-500 sm:mb-1">To pay</div>
        <div class="text-lg sm:text-2xl font-semibold text-pink-600 tabular-nums"><%= number_to_currency(@todo.payouts.amounts[:to_pay].to_f) %></div>
        <div class="hidden sm:block text-xs text-gray-400 mt-0.5">owed, not in a run yet</div>
      </div>
      <div class="rounded-lg border p-3 sm:p-5 flex items-center justify-between sm:block <%= @run_state_cents[:draft].positive? ? "bg-gray-50 border-gray-300" : "bg-white border-gray-200" %>">
        <div class="text-sm text-gray-500 sm:mb-1">In draft</div>
        <div class="text-lg sm:text-2xl font-semibold text-gray-900 tabular-nums"><%= number_to_currency(@run_state_cents[:draft] / 100.0) %></div>
        <div class="hidden sm:block text-xs text-gray-400 mt-0.5">
          <% if d[:draft_nobank_people].positive? %>
            <span class="text-blue-600 font-medium"><%= number_to_currency(d[:draft_nobank_cents] / 100.0) %></span> of it for <%= pluralize(d[:draft_nobank_people], "payee") %> with no bank
          <% else %>
            not submitted yet
          <% end %>
        </div>
      </div>
      <div class="rounded-lg border p-3 sm:p-5 flex items-center justify-between sm:block <%= @run_state_cents[:funding].positive? ? "bg-amber-50 border-amber-200" : "bg-white border-gray-200" %>">
        <div class="text-sm text-gray-500 sm:mb-1">Funding</div>
        <div class="text-lg sm:text-2xl font-semibold text-amber-600 tabular-nums"><%= number_to_currency(@run_state_cents[:funding] / 100.0) %></div>
        <div class="hidden sm:block text-xs text-gray-400 mt-0.5">ACH clearing, pays out automatically</div>
      </div>
      <div class="rounded-lg border p-3 sm:p-5 flex items-center justify-between sm:block <%= @run_state_cents[:waiting].positive? ? "bg-blue-50 border-blue-200" : "bg-white border-gray-200" %>">
        <div class="text-sm text-gray-500 sm:mb-1">Waiting on payees</div>
        <div class="text-lg sm:text-2xl font-semibold text-blue-600 tabular-nums"><%= number_to_currency(@run_state_cents[:waiting] / 100.0) %></div>
        <div class="hidden sm:block text-xs text-gray-400 mt-0.5">
          <% if @run_state_cents[:waiting].positive? %>
            <% bits = [] %>
            <% bits << "#{number_to_currency(d[:waiting_nobank_cents] / 100.0)} · #{pluralize(d[:waiting_nobank_people], 'payee')} with no bank" if d[:waiting_nobank_people].positive? %>
            <% bits << "#{number_to_currency(d[:waiting_ready_cents] / 100.0)} ready — pay remaining" if d[:waiting_ready_people].positive? %>
            <%= bits.join(" · ") %>
          <% else %>
            funded runs, nobody left unpaid
          <% end %>
        </div>
      </div>
    </div>

    <%# Active runs — drafts still being assembled, plus submitted money moving
        through funding/transfers. Each state box above sums rows from here. %>
    <% if @active_runs.any? %>
      <%
        # Same money-state columns as the Payout Runs page: paid / ready to pay /
        # waiting on bank (only the ones with money in them), so a partially
        # paid run says right here what it's stuck on.
        run_cols = run_state_columns(@active_run_breakdowns.values)
        run_col_labels = [ "Total" ] + run_cols.map { |c| Manage::PayoutBatchesHelper::RUN_STATE_COLUMNS[c][:label] }
        run_min_width = { 2 => "min-w-[480px]", 3 => "min-w-[560px]", 4 => "min-w-[700px]", 5 => "min-w-[820px]" }[run_col_labels.size] || "min-w-[820px]"
      %>
      <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Active Runs</h3>
      <div class="mb-8">
        <%= render layout: "shared/slim_list", locals: { label: "Payout run", columns: run_col_labels, min_width: run_min_width } do %>
          <% @active_runs.each do |run| %>
            <%= render "manage/payout_batches/run_row", batch: run, breakdown: @active_run_breakdowns[run.id], columns: run_cols %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# Awaiting Payout — address these first. Productions, courses, and contracts.
        One column per money status ("In draft run" / "In flight" / "Paid" appear
        only when some row has money there), so each row answers "what have I
        actually done about this?" at a glance. %>
    <% if @awaiting_items.any? %>
      <%
        col_meta = Manage::MoneyPayoutsHelper::AWAITING_PAYOUT_COLUMNS
        awaiting_col_labels = @awaiting_columns.map { |c| col_meta[c][:label] }
        list_min_width = { 1 => "min-w-[360px]", 2 => "min-w-[480px]", 3 => "min-w-[560px]", 4 => "min-w-[780px]" }[@awaiting_columns.size]
      %>
      <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Awaiting Payout</h3>
      <div class="mb-8">
        <%= render layout: "shared/slim_list", locals: { label: "To pay", columns: awaiting_col_labels, min_width: list_min_width } do %>
          <%= render "manage/money_payouts/awaiting_payout_rows",
                items: @awaiting_items, columns: @awaiting_columns, total: true %>
        <% end %>
      </div>
    <% end %>

    <%# Blocked on the payee — owed people who haven't set up payment info. %>
    <% if @missing_payment_info.any? %>
      <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Waiting on Payment Info</h3>
      <div class="mb-8 bg-white rounded-lg border border-gray-200 p-5">
        <p class="text-sm text-gray-600 mb-3">
          <span class="font-semibold text-gray-900"><%= @missing_payment_info.count %></span>
          <%= "person".pluralize(@missing_payment_info.count) %> can't be paid yet — no payment info.
          Send reminders from each production's payouts page.
        </p>
        <div class="flex flex-wrap gap-1.5">
          <% @missing_payment_info.first(12).each do |person| %>
            <span class="inline-flex items-center px-2 py-0.5 bg-gray-100 text-gray-600 rounded text-xs"><%= person.name %></span>
          <% end %>
          <% if @missing_payment_info.count > 12 %>
            <span class="inline-flex items-center px-2 py-0.5 bg-gray-100 text-gray-500 rounded text-xs">+<%= @missing_payment_info.count - 12 %> more</span>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# The full every-production grid lives on its own page — this one stays
        focused on action. %>
    <%= link_to manage_money_all_payouts_path, class: "block bg-white rounded-lg border border-gray-200 p-5 hover:bg-gray-50 transition-colors" do %>
      <div class="flex items-center justify-between gap-3">
        <div>
          <h3 class="font-semibold text-gray-900">All payouts</h3>
          <p class="text-sm text-gray-500 mt-0.5">Every production's payout history — awaiting and paid, show by show.</p>
        </div>
        <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </div>
    <% end %>
  <% end %>
</div>
