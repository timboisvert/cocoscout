<%# The one-setting tax form (TicketTaxSetting): a name, a percentage, and
    whether it's added on top or inside the price, with worked examples.
    Locals: tax (TicketTaxSetting::Form), url (where it saves), what
    ("tickets" or "courses"), example_cents (the price in the examples),
    set_aside (optional: the organization, to show the "keep it set aside"
    switch, which covers every tax CocoScout collects for it). %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  example_cents = local_assigns.fetch(:example_cents, 2_000)
  unit = what == "courses" ? "course" : "ticket"
  bps = tax.set? ? (BigDecimal(tax.percent) * 100).round : 1_025
  added_cents = ((example_cents * bps) + 5_000) / 10_000
  included_cents = example_cents - (((example_cents * 10_000) + ((10_000 + bps) / 2)) / (10_000 + bps))
  percent_label = "#{format('%g', bps / 100.0)}%"
  example = number_to_currency(example_cents / 100.0, precision: 0)
  mode_choices = [
    [ "added", "Add it on top of the #{unit} price", "A #{example} #{unit} at #{percent_label}: they pay #{example} plus #{number_to_currency(added_cents / 100.0)} tax." ],
    [ "included", "It's already included in my prices", "A #{example} #{unit} at #{percent_label}: they pay #{example}, which includes #{number_to_currency(included_cents / 100.0)} tax." ]
  ]
%>
<%= form_with url: url, method: :patch, scope: :tax do |f| %>
  <div class="space-y-6">
    <p class="text-sm text-gray-600">If you charge tax on <%= what %>, enter it here. CocoScout collects it at checkout, keeps it with your <%= unit %> money, and lists it on your Sales tax page. You send it to the government. Leave the percentage blank if your <%= what %> carry no tax.</p>

    <div class="space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,1fr)_10rem] gap-4">
        <div>
          <label for="tax_name" class="block text-sm font-medium text-gray-700 mb-1.5">Name on receipts</label>
          <%= f.text_field :name, value: tax.name, placeholder: "Sales tax", class: input_class %>
        </div>
        <div>
          <label for="tax_percent" class="block text-sm font-medium text-gray-700 mb-1.5">Percentage</label>
          <div class="relative">
            <%= f.text_field :percent, value: tax.percent, inputmode: "decimal", placeholder: "10.25", class: "#{input_class} pr-8" %>
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 pointer-events-none">%</span>
          </div>
        </div>
      </div>

      <fieldset>
        <legend class="block text-sm font-medium text-gray-700 mb-1.5">How it's charged</legend>
        <div class="space-y-2">
          <% mode_choices.each do |value, title, explanation| %>
            <label class="flex items-start gap-3 rounded-lg border border-gray-200 px-4 py-3 cursor-pointer has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50">
              <%= f.radio_button :mode, value, checked: tax.mode == value, class: "mt-0.5 h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500" %>
              <span>
                <span class="block text-sm font-medium text-gray-900"><%= title %></span>
                <span class="block text-xs text-gray-600 mt-0.5"><%= explanation %></span>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <% if (org = local_assigns[:set_aside]) %>
        <div class="rounded-lg border border-gray-200 px-4 py-3 flex items-center justify-between gap-4">
          <div>
            <div class="text-sm font-medium text-gray-900">Keep sales tax set aside</div>
            <div class="text-xs text-gray-600 mt-0.5">
              The tax you collect stays in your CocoScout balance, apart from what payout runs and withdrawals can spend, until you mark the period paid on the Sales tax page.
              <% if org.sales_tax_set_aside_since %>Set aside since <%= org.sales_tax_set_aside_since.strftime("%B %-d, %Y") %>.<% else %>Turning it on sets aside tax collected from today on.<% end %>
            </div>
          </div>
          <%= render "shared/toggle_switch", name: "tax[set_aside]", checked: org.sales_tax_set_aside_since.present?, hidden_false: true, id: "tax_set_aside", aria_label: "Keep sales tax set aside" %>
        </div>
      <% end %>
    </div>

    <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
  </div>
<% end %>
