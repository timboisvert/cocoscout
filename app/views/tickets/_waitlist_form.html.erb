<%# Joining a sold-out date's waitlist, under the picker's sold-out note.
    Locals: listing, profile. %>
<% input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
<div class="border-t border-gray-100 px-5 py-4" data-waitlist>
  <h3 class="font-semibold text-gray-900">Join the waitlist</h3>
  <p class="text-sm text-gray-600 mt-1">If seats come back, the first party they fit gets an email with a link to buy them, held for 30 minutes.</p>
  <%= form_with url: tickets_join_waitlist_path(org: profile.slug, event: listing.slug), method: :post, data: { turbo: false }, class: "mt-3 space-y-3" do %>
    <%= hidden_field_tag :embed, "1" if embed? %>
    <%= render "tickets/bot_trap", id: "waitlist_website" %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <%= text_field_tag :name, nil, required: true, placeholder: "Your name", "aria-label": "Your name", class: input_class %>
      <%= email_field_tag :email, nil, required: true, placeholder: "Email", "aria-label": "Email", class: input_class %>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <%= select_tag :quantity, options_for_select((1..[ listing.effective_max_per_order, TicketWaitlistEntry::MAX_QUANTITY ].min).map { |n| [ pluralize(n, "ticket"), n ] }, 2), "aria-label": "How many tickets", class: input_class %>
      <%= select_tag :preference, options_for_select(TicketWaitlistEntry::PREFERENCES.map { |k, v| [ v, k ] }, "any"), "aria-label": "Seats", class: input_class %>
    </div>
    <%= render "shared/button", text: "Put me on the list", variant: "primary", size: "medium", type: :submit %>
  <% end %>
</div>
