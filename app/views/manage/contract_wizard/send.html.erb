<%= render layout: "manage/contract_wizard/wizard_layout", locals: { step_name: "Send" } do %>
  <% org_sig = @contract.organization_signature %>
  <h2 class="text-xl font-bold text-gray-900 mb-2 coustard-regular">Send for signature</h2>
  <p class="text-gray-600 mb-6">You've signed. Here's exactly what's about to happen — review it, then send it to <%= @contract.contractor_name %>.</p>

  <div class="space-y-4">
    <%# You've signed %>
    <div class="flex items-start gap-3 p-4 bg-green-50 border border-green-200 rounded-lg">
      <%= icon("check-circle", class: "w-5 h-5 text-green-600 mt-0.5") %>
      <div class="text-sm">
        <p class="font-medium text-gray-900">You've signed as <%= @contract.organization.name %></p>
        <% if org_sig %>
          <p class="text-gray-600"><%= org_sig.signer_name %> · <%= org_sig.signed_at_long %></p>
        <% end %>
      </div>
    </div>

    <%# Who it goes to %>
    <div class="border border-gray-200 rounded-lg p-4">
      <h3 class="text-sm font-semibold text-gray-700 mb-3">Sending to</h3>
      <dl class="space-y-2 text-sm">
        <div class="flex justify-between">
          <dt class="text-gray-500">Contractor</dt>
          <dd class="text-gray-900 font-medium text-right"><%= @contract.contractor_name %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-500">Email</dt>
          <dd class="text-right">
            <% if @contract.contractor_email.present? %>
              <span class="text-gray-900"><%= @contract.contractor_email %></span>
            <% else %>
              <span class="text-amber-600">No email on file</span>
            <% end %>
          </dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-500">Contract</dt>
          <dd class="text-gray-900 text-right"><%= @contract.production_name.presence || @contract.production&.name || "Contract" %></dd>
        </div>
      </dl>
    </div>

    <%# What they'll be asked to do %>
    <div class="border border-gray-200 rounded-lg p-4">
      <h3 class="text-sm font-semibold text-gray-700 mb-2">What they'll be asked to do</h3>
      <ul class="text-sm text-gray-600 list-disc list-inside space-y-1">
        <li>Open a secure link — no CocoScout account needed</li>
        <% if @contract.signer_is_member? %>
          <li><span class="text-gray-900 font-medium"><%= @contract.contractor_name %> is a CocoScout member</span>, so it'll also appear in their <span class="font-medium">My Contracts</span> to review and sign</li>
        <% end %>
        <li>Review the full contract you just prepared and signed</li>
        <li>Type their name and agree, which signs it electronically (stamped with date + IP)</li>
        <li>As soon as they sign, the contract is executed and everything's created automatically</li>
      </ul>
    </div>

    <div class="rounded-lg bg-blue-50 border border-blue-200 p-4 text-sm text-blue-800">
      <% if @contract.contractor_email.present? %>
        We'll email and message <%= @contract.contractor_name %> a link to review and sign. You'll also get a shareable link + QR on the contract page, and you can revoke it any time before they sign.
      <% else %>
        There's no email on file, so you'll share the signing link yourself — you'll get it (with a QR code) on the contract page after you send. You can revoke it any time before they sign.
      <% end %>
    </div>
  </div>

  <% if @signer_person %>
    <%# CocoScout user attached — confirm who it's going to, then allow send. %>
    <div class="mt-6 flex items-center gap-4 p-4 rounded-xl border border-gray-200 bg-gray-50">
      <% hv = @signer_person.safe_headshot_variant(:thumb) %>
      <% if hv %>
        <%= image_tag hv, alt: @signer_person.name, class: "w-12 h-12 rounded-lg object-cover flex-shrink-0" %>
      <% else %>
        <div class="w-12 h-12 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold flex-shrink-0"><%= @signer_person.initials %></div>
      <% end %>
      <div class="min-w-0">
        <div class="text-xs font-medium uppercase tracking-wide text-gray-400">Sending to</div>
        <div class="font-semibold text-gray-900 truncate"><%= @signer_person.name %></div>
        <div class="text-sm text-gray-500 truncate"><%= @signer_person.email %><% unless @signer_person.user %> · <span class="text-amber-600">invited, hasn't joined yet</span><% end %></div>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-between">
      <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", icon: "arrow-left", path: manage_sign_contract_wizard_path(@contract) %>
      <%= form_with url: manage_send_contract_wizard_path(@contract), method: :post, local: true do %>
        <%= render "shared/button", text: "Send to #{@signer_person.name}", variant: "primary", size: "large", icon: "paper-airplane", type: :submit %>
      <% end %>
    </div>
  <% else %>
    <%# No CocoScout user attached — required before sending. %>
    <div class="mt-6 rounded-xl border border-amber-300 bg-amber-50 p-5"
         data-controller="invite-search" data-invite-search-url-value="<%= search_for_invite_manage_people_path(mode: "link") %>">
      <h3 class="text-sm font-semibold text-amber-900">Attach the CocoScout user this is for</h3>
      <p class="text-sm text-amber-800 mt-0.5 mb-4">Contracts go to a CocoScout user so they can review, sign, and get paid. Search for them or invite them by email — you can't send until one's attached.</p>

      <%= form_with url: manage_link_signer_contract_wizard_path(@contract), method: :post, local: true do %>
        <input type="hidden" name="person_id" data-invite-search-target="selectedPersonIdInput">

        <div data-invite-search-target="searchSection">
          <input type="text" data-invite-search-target="input" data-action="input->invite-search#search"
                 placeholder="Search CocoScout by name or email…"
                 class="block w-full rounded-lg border border-gray-300 px-3 py-2 bg-white focus:border-pink-500 focus:ring-pink-500">
          <div data-invite-search-target="results" class="mt-3"></div>
          <div class="mt-3">
            <button type="button" class="text-sm font-medium text-pink-600 hover:text-pink-700" data-action="invite-search#showInviteForm">
              <%= icon("user-plus", class: "w-4 h-4 inline mr-1") %> Can't find them? Invite by email
            </button>
          </div>
        </div>

        <div data-invite-search-target="selectedPerson" class="hidden">
          <div class="flex items-center justify-between gap-3 p-3 bg-white border border-pink-200 rounded-lg">
            <div class="min-w-0">
              <div class="font-medium text-gray-900 truncate" data-invite-search-target="selectedPersonName"></div>
              <div class="text-sm text-gray-500 truncate" data-invite-search-target="selectedPersonEmail"></div>
            </div>
            <button type="button" class="text-sm font-medium text-pink-600 hover:text-pink-700 flex-shrink-0" data-action="invite-search#backToSearch">Change</button>
          </div>
        </div>

        <div data-invite-search-target="inviteForm" class="hidden mt-3">
          <div data-invite-search-target="personDetailsSection">
            <button type="button" class="inline-flex items-center gap-1 text-sm font-medium text-gray-600 hover:text-gray-900 mb-3" data-action="invite-search#backToSearch">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              Back to search
            </button>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">Name</label>
                <input type="text" name="invite_name" data-invite-search-target="inviteName"
                       class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm bg-white focus:border-pink-500 focus:ring-pink-500">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">Email</label>
                <input type="email" name="invite_email" data-invite-search-target="inviteEmail" autocapitalize="none"
                       value="<%= @contract.contractor_email %>"
                       class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm bg-white focus:border-pink-500 focus:ring-pink-500">
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4">
          <%= render "shared/button", text: "Attach user", variant: "primary", size: "medium", type: :submit %>
        </div>
      <% end %>
    </div>

    <div class="mt-6 flex items-center justify-between">
      <%= render "shared/button", text: "Back", variant: "secondary", size: "medium", icon: "arrow-left", path: manage_sign_contract_wizard_path(@contract) %>
      <span class="text-sm text-gray-400">Attach a CocoScout user to send</span>
    </div>
  <% end %>
<% end %>
