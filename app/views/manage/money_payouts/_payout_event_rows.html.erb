<%#
  Slim per-show payout rows for one production — columns line up with the payouts
  list (Awaiting / Paid). Shared by the inline accordion (Turbo frame) and any
  single-production payout view.

  Locals:
    shows:         array of Show with a calculated show_payout (line_items loaded)
    awaiting_only: when true, show only the Awaiting column (matches the Awaiting
                   Payout section's single column); default shows Awaiting + Paid
    href_data:     optional data attrs for each row link (e.g. { turbo_frame: "_top" })
%>
<% href_data = local_assigns.fetch(:href_data, {}) %>
<% awaiting_only = local_assigns.fetch(:awaiting_only, false) %>
<% if shows.any? %>
  <div class="divide-y divide-gray-100">
    <% shows.each do |show| %>
      <%
        items = show.show_payout.line_items.to_a
        paid_items = items.select(&:paid?)
        awaiting = items.reject(&:paid?).sum(&:net_amount)
        paid = paid_items.sum(&:net_amount)
        title = "#{show.date_and_time.strftime('%b %-d, %Y')} · #{show.display_name}"
        cells = [ { value: number_to_currency(awaiting), class: awaiting > 0 ? "text-pink-600" : "text-gray-400" } ]
        cells << { value: number_to_currency(paid), class: paid > 0 ? "text-green-600" : "text-gray-400" } unless awaiting_only
      %>
      <%= render "shared/slim_list_row",
        title: title,
        subtitle: "#{paid_items.count} of #{items.count} paid",
        href: manage_money_show_payout_path(show),
        href_data: href_data,
        col_labels: [ "Awaiting", "Paid" ],
        cells: cells %>
    <% end %>
  </div>
<% else %>
  <div class="py-3 pl-7 pr-3 text-sm text-gray-500">No calculated payouts yet.</div>
<% end %>
