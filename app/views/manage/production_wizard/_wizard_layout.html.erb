<% content_for :title, "Create Production - #{step_name}" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Productions", manage_productions_path]
    ],
    text: "Create Production",
    links: []
  } %>

  <%
    # Build dynamic steps based on wizard state. Each view names its step by
    # key (current_step: :roles) so optional steps can come and go without
    # renumbering. Legacy integer current_step values still map by position.
    casting_on = @wizard_state[:casting_source] != "none"
    wizard_steps = [
      { key: :name, name: "Name", path: manage_productions_wizard_path },
      { key: :logo, name: "Logo", path: manage_productions_wizard_logo_path },
      { key: :casting, name: "Casting", path: manage_productions_wizard_casting_path }
    ]

    if casting_on
      wizard_steps << { key: :casting_style, name: "Style", path: manage_productions_wizard_casting_style_path }
      wizard_steps << { key: :roles, name: (act_based_wizard? ? "Lineup" : "Roles"), path: manage_productions_wizard_roles_path }
      wizard_steps << { key: :pay, name: "Pay", path: manage_productions_wizard_pay_path } if pay_step_available?
    end

    wizard_steps << { key: :shows, name: "Shows", path: manage_productions_wizard_shows_path }

    # Add Schedule step if user said they have shows
    if @wizard_state[:has_shows] == "yes"
      wizard_steps << { key: :schedule, name: "Schedule", path: manage_productions_wizard_schedule_path }
    end
    wizard_steps << { key: :review, name: "Review", path: manage_productions_wizard_review_path }

    current_index = if current_step.is_a?(Integer)
      current_step - 1
    else
      wizard_steps.index { |s| s[:key] == current_step.to_sym } || 0
    end
  %>
  <%# Full-width step bar, directly below the breadcrumb. %>
  <%= render "shared/wizard_steps", steps: wizard_steps, current_index: current_index %>

  <div class="max-w-2xl mx-auto">
    <!-- Step Content -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <%= yield %>
    </div>

    <!-- Cancel Link -->
    <div class="mt-4 text-center">
      <% cancel_cid = "confirm-#{SecureRandom.hex(6)}" %>
      <button type="button"
              data-controller="modal"
              data-action="click->modal#open"
              data-modal-id="<%= cancel_cid %>"
              class="text-sm text-gray-500 hover:text-gray-700 bg-transparent border-0 cursor-pointer">Cancel</button>
      <%= render "shared/confirm_modal",
            id: cancel_cid,
            title: "Discard this production?",
            message: "Your progress will be lost.",
            confirm_text: "Discard",
            cancel_text: "Keep editing",
            url: manage_productions_wizard_cancel_path,
            method: :delete %>
    </div>
  </div>
</div>
