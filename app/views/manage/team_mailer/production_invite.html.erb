<% if @custom_message.present? %>
  <%= simple_format(@custom_message) %>
  <p style="margin-top: 20px;">
    <%= link_to "Accept Invitation", accept_manage_team_invitations_url(@team_invitation.token), target: "_blank", class: "button", style: EmailButton::STYLE %>
  </p>
<% else %>
  <h1>You've been invited to join <%= @production.name %></h1>
  <p>
    You've been invited to join the production team for <strong><%= @production.name %></strong> on CocoScout.
  </p>
  <p>
    As a team member, you'll be able to help manage this production.
  </p>
  <p style="margin-top: 20px;">
    <%= link_to "Accept Invitation", accept_manage_team_invitations_url(@team_invitation.token), target: "_blank", class: "button", style: EmailButton::STYLE %>
  </p>
<% end %>
