<%# The profile editor's panel: the V1.1 frame (shared/navigation/panel_frame) around its
    own links. No dashboard switcher any more: the wordmark goes back to the
    mode last used, and the account menu holds the mode switch. %>
<%= render layout: "shared/navigation/panel_frame", locals: { production_mode: panel_last_mode_production?, band: false, controller: "profile-nav" } do %>
      <%= render "shared/nav_link", text: "Home", href: "#profile-card" %>
      <%= render "shared/nav_link", text: "Public Profile", href: "#public-profile" %>
      <div data-profile-visibility-target="menuItems" class="<%= 'hidden' unless @person&.public_profile_enabled %>">
        <%= render "shared/nav_link", text: "Basic Information", href: "#basic-info" %>
        <%= render "shared/nav_link", text: "Bio", href: "#bio" %>
        <%= render "shared/nav_link", text: "Social Media & Links", href: "#social-media" %>
        <%= render "shared/nav_link", text: "Headshots", href: "#headshots" %>
        <%= render "shared/nav_link", text: "Videos & Reels", href: "#videos" %>
        <%= render "shared/nav_link", text: "Performance History", href: "#performance-history" %>
        <%= render "shared/nav_link", text: "Training & Education", href: "#training" %>
        <%= render "shared/nav_link", text: "Skills & Talents", href: "#skills" %>
        <%= render "shared/nav_link", text: "Resumes", href: "#resumes" %>
        <%= render "shared/nav_link", text: "Groups", href: "#groups" %>
      </div>
    
<% end %>
