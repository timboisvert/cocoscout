<% content_for :title, "Agreement · #{@production.name}" %>

<%= render "shared/back_button", path: edit_manage_production_path(@production, anchor: "tab-4"), title: "Back to Production Settings" %>

<div class="max-w-4xl mx-auto">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-semibold coustard-regular">Agreement</h1>
      <p class="text-gray-600"><%= @production.name %></p>
    </div>

    <% if @roster_counts[:not_sent].positive? || @roster_counts[:awaiting].positive? %>
      <% send_unsigned_cid = "confirm-send-agreement-unsigned" %>
      <%= render "shared/button", text: "Send to everyone unsigned", variant: "primary", size: "medium", type: :button,
            data: { controller: "modal", action: "click->modal#open", modal_id: send_unsigned_cid } %>
      <%= render "shared/confirm_modal", id: send_unsigned_cid,
            title: "Send to everyone unsigned?",
            message: "Send the agreement to everyone who hasn't signed yet?",
            confirm_text: "Send",
            url: send_agreement_reminders_manage_production_path(@production),
            method: :post %>
    <% end %>
  </div>

  <%# How performers receive it — quick-glance reminder of the current setting. %>
  <div class="mb-6 rounded-lg border border-gray-200 bg-white p-4 flex items-start gap-3">
    <div class="w-8 h-8 rounded-full bg-pink-50 flex items-center justify-center text-pink-600 flex-shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
    </div>
    <div class="text-sm text-gray-700">
      <% if @production.agreement_auto_send? %>
        This agreement is <span class="font-medium text-gray-900">sent automatically</span> when someone is added to the talent pool.
      <% else %>
        This agreement is <span class="font-medium text-gray-900">sent manually</span> — use the buttons below to send it.
      <% end %>
      <%= link_to "Change", edit_manage_production_path(@production, anchor: "tab-4"), class: "text-pink-600 hover:text-pink-700 ml-1" %>
    </div>
  </div>

  <%= render "manage/productions/agreement_roster", production: @production, roster: @roster, roster_counts: @roster_counts %>
</div>
