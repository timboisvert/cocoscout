<%# One register's business day (Square, plan §9.3) on the day's worksheet:
    sales by our category, tips, sales tax, refunds, fees, and the net on
    its way to the bank. Read-only; "Looks right" checks the piece.
    Locals: day, registers, can_change %>
<%
  money = ->(cents) { cents.negative? ? "−#{number_to_currency(-cents / 100.0)}" : number_to_currency(cents / 100.0) }
  state_words = { ok: "Checked", wait: "Came in, not checked" }.fetch(day.registers_state)
  tone = { ok: "text-green-700", wait: "text-amber-700" }.fetch(day.registers_state)
  provider = registers.first.integration.provider.capitalize
%>
<section class="bg-white border border-gray-200 rounded-xl overflow-hidden" id="register">
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3 border-b border-gray-200">
    <h2 class="text-base font-semibold text-gray-900"><%= registers.size == 1 ? "Bar, #{registers.first.location_name}" : "Registers" %>
      <span class="ml-2 text-xs font-medium text-gray-500">from <%= provider %></span>
      <span class="ml-2 text-xs font-medium <%= tone %>"><%= state_words %></span>
    </h2>
    <% if can_change && !day.settled? %>
      <%= form_with url: manage_check_register_money_settle_up_day_path(day.param), method: :patch, data: { controller: "auto-submit" } do %>
        <%= hidden_field_tag :checked, "0", id: nil %>
        <label class="inline-flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
          <input type="checkbox" name="checked" value="1" <%= "checked" if day.record&.register_checked? %> data-action="change->auto-submit#submit"
                 class="h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
          Looks right
        </label>
      <% end %>
    <% end %>
  </div>
  <div class="divide-y divide-gray-100">
    <% registers.each do |register| %>
      <div class="px-5 py-3 grid grid-cols-1 lg:grid-cols-2 gap-x-8 gap-y-1">
        <div>
          <% if registers.size > 1 %><div class="text-sm font-medium text-gray-900 mb-1"><%= register.location_name %></div><% end %>
          <% register.category_rows.each do |label, cents| %>
            <div class="flex items-baseline justify-between gap-3 py-1 text-sm"><span class="text-gray-700"><%= label %></span><span class="tabular-nums text-gray-900"><%= money.call(cents) %></span></div>
          <% end %>
          <% if register.refunds_cents.positive? %>
            <div class="flex items-baseline justify-between gap-3 py-1 text-sm"><span class="text-gray-700">Refunds</span><span class="tabular-nums text-red-700"><%= money.call(-register.refunds_cents) %></span></div>
          <% end %>
          <div class="flex items-baseline justify-between gap-3 py-1 text-sm font-medium border-t border-gray-100 mt-1 pt-1.5"><span class="text-gray-900">Sales, before tax <span class="text-xs font-normal text-gray-500"><%= pluralize(register.orders_count, "order") %></span></span><span class="tabular-nums text-gray-900"><%= money.call(register.gross_cents - register.refunds_cents) %></span></div>
        </div>
        <div>
          <div class="flex items-baseline justify-between gap-3 py-1 text-sm"><span class="text-gray-700">Sales tax collected <span class="text-xs text-gray-500">set aside</span></span><span class="tabular-nums text-gray-900"><%= money.call(register.tax_cents) %></span></div>
          <div class="flex items-baseline justify-between gap-3 py-1 text-sm"><span class="text-gray-700">Tips <span class="text-xs text-gray-500">split below</span></span><span class="tabular-nums text-gray-900"><%= money.call(register.tips_cents) %></span></div>
          <div class="flex items-baseline justify-between gap-3 py-1 text-sm"><span class="text-gray-700"><%= provider %>'s fees</span><span class="tabular-nums text-gray-900"><%= money.call(-register.fees_cents) %></span></div>
          <div class="flex items-baseline justify-between gap-3 py-1 text-sm font-medium border-t border-gray-100 mt-1 pt-1.5"><span class="text-gray-900">On its way to your bank <span class="text-xs font-normal text-gray-500">straight from <%= provider %>, not through CocoScout</span></span><span class="tabular-nums text-gray-900"><%= money.call(register.net_cents) %></span></div>
          <p class="text-xs text-gray-500 mt-1">Read <%= register.pulled_at&.strftime("%b %-d at %-l:%M %P") %>. Change what counts on <%= link_to "Integrations", manage_organization_square_path(day.organization), class: "text-pink-600 hover:text-pink-700" %>.</p>
        </div>
      </div>
    <% end %>
  </div>
</section>
