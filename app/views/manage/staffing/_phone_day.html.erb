<%#
  Scheduling on a phone (Design B, approved 2026-10-24): one day at a time,
  never "week". The day's name opens a calendar to jump anywhere; the strip
  keeps the chosen day in the middle, three days either side, across weeks;
  swipe for the next or previous day. The day's roles run on a timeline
  (each bar opens its shift's menu), and its shows sit at the bottom, one
  line each.
%>
<%
  day = @selected_day
  day_shows = @shows_by_day[day] || []
  day_shifts = @shifts_by_day[day] || []
  stats = shift_slot_stats(day_shifts)
  role_order = @house_roles.each_with_index.to_h { |r, i| [ r.id, i ] }
  busy_day = ->(d) { @week_start <= d && d <= @week_end ? (@shows_by_day[d].present? || @shifts_by_day[d].present?) : @show_dates.include?(d) }
  pct = stats[:total].positive? ? (100.0 * stats[:staffed] / stats[:total]).round : 0
  meter = stats[:declined].positive? ? "bg-red-500" : (pct >= 100 ? "bg-green-500" : "bg-amber-400")
%>
<div class="sm:hidden space-y-3" data-phone-day="<%= day.iso8601 %>"
     data-controller="day-swipe"
     data-day-swipe-prev-url-value="<%= manage_staffing_scheduling_path(day: (day - 1).iso8601) %>"
     data-day-swipe-next-url-value="<%= manage_staffing_scheduling_path(day: (day + 1).iso8601) %>"
     data-action="touchstart->day-swipe#start touchend->day-swipe#end">
  <%= render "shared/day_strip", day: day, id: "scheduling-jump", show_dates: @show_dates, months: @calendar_months, busy: busy_day,
        day_path: ->(d) { manage_staffing_scheduling_path(day: d.iso8601) } %>

  <% if day_shows.any? || day_shifts.any? %>
    <div class="bg-white border border-gray-200 rounded-lg px-3 py-2 flex items-center gap-2.5 text-xs" data-day-summary>
      <span class="text-gray-600 whitespace-nowrap"><%= day_shows.any? ? pluralize(day_shows.size, "show") : "No shows" %></span>
      <% if stats[:total].positive? %>
        <span class="flex-1 h-1.5 rounded-full bg-gray-100 overflow-hidden"><span class="block h-full <%= meter %>" style="width: <%= pct %>%"></span></span>
        <span class="whitespace-nowrap font-semibold <%= stats[:declined].positive? ? 'text-red-700' : (pct >= 100 ? 'text-green-700' : 'text-amber-700') %>">
          <%= stats[:staffed] %> of <%= stats[:total] %><%= " · #{stats[:declined]} can't" if stats[:declined].positive? %>
        </span>
      <% else %>
        <span class="flex-1"></span>
      <% end %>
    </div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <% if day_shifts.any? %>
      <div class="px-2 pt-2 pb-1 overflow-x-auto" data-day-swipe-ignore>
        <%= render "manage/staffing/day_gantt", mode: "roles", day_shifts: day_shifts, day_shows: day_shows,
              role_order: role_order, menu: true, hide_shows: true %>
      </div>
    <% else %>
      <p class="px-3 pt-3 text-sm text-gray-500"><%= day_shows.any? ? "No shifts yet for these shows." : "Nothing scheduled this day." %></p>
    <% end %>
    <% if @house_role_count.positive? %>
      <div class="flex items-center justify-between gap-3 px-3 py-2 border-t border-gray-100">
        <%= render "shared/button", text: "+ Add a shift", variant: "dashed", size: "small", type: :button,
              data: shift_add_data(day, day_shows, @house_roles).merge(action: "click->shift-add#open") %>
        <% open_slots = day_shifts.select(&:needs_assignment?).sum(&:remaining_slots) %>
        <% if open_slots.positive? %><span class="text-xs text-gray-600"><%= open_slots %> open</span><% end %>
      </div>
    <% end %>
  </div>

  <% if day_shows.any? %>
    <div class="bg-white border border-gray-200 rounded-lg px-3 py-2 text-[13px]" data-shows-today>
      <div class="text-[10.5px] font-bold uppercase tracking-wider text-gray-500 mb-1">Shows today</div>
      <% day_shows.each do |show| %>
        <div class="py-0.5"><%= render "manage/staffing/show_line", show: show, popover: false, venue: true %></div>
      <% end %>
    </div>
  <% end %>
</div>
