<% content_for :title, "Sign Up" %>
<%
  # A sign-up form that requires an account, reached by someone without one
  # (or signed out). The strip names the event and the organization; the
  # organization's own instruction text, if any, sits under it. The controller
  # stashed the form as the return path, so creating an account or signing in
  # lands on it.
  sign_up_form = @sign_up_form
  org = sign_up_form.production.organization
%>
<% strip = capture do %>
  <%= render layout: "shared/auth/strip", locals: { image: (org.logo if org.logo.attached?), initial: org.name } do %>
    <strong class="font-semibold text-slate-900"><%= sign_up_form.name %></strong> ·
    <%= org.name %> runs its sign-ups on CocoScout. Create a free account to take a spot.
  <% end %>
  <% if sign_up_form.instruction_text.present? %>
    <div class="prose prose-sm prose-slate mt-3 max-w-none rounded-lg border border-slate-200 bg-white px-4 py-3.5 text-slate-700">
      <%= sign_up_form.instruction_text %>
    </div>
  <% end %>
<% end %>
<% notices = capture do %>
  <% if @authentication_error %>
    <%= render "shared/auth/notice", kind: :error, body: "That password didn't match. Please try again." %>
  <% end %>
  <% if @user_exists_error %>
    <%= render layout: "shared/auth/notice", locals: { title: "You already have an account." } do %>
      <%= link_to "Sign in", signin_path, class: "font-semibold underline" %> to sign up.
    <% end %>
  <% end %>
<% end %>

<%= render layout: "shared/auth/shell",
      locals: { title: "Create your account", strip: strip, notices: notices, legal: "creating an account",
                pill: "Free to join · No card needed",
                lede: "Your account keeps your spot, shows you where you stand, and holds the schedule once you're in." } do %>
  <%= render "shared/auth/signup_form", user: @user, submit_text: "Create account and sign up", email_value: params[:email_address] %>

  <div class="border-t border-slate-200 pt-4 text-center text-sm leading-[1.8] text-slate-600">
    Already have an account? <%= link_to "Sign in", signin_path, class: "font-medium text-pink-600 hover:text-pink-700" %>
  </div>
<% end %>
