<% content_for :title, "Tickets · #{@organization.name}" %>
<% content_for :head do %>
  <meta name="description" content="<%= @ticketing_profile.welcome_line.presence || "Upcoming shows and tickets at #{@organization.name}." %>">
  <meta property="og:title" content="Tickets · <%= @organization.name %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= tickets_box_office_url(org: @ticketing_profile.slug) %>">
  <% if (og = @ticketing_profile.safe_wide_image_variant(:display)) %><meta property="og:image" content="<%= url_for(og) %>"><% end %>
<% end %>
<%
  wide = @ticketing_profile.safe_wide_image_variant(:display)
  address = @venue && [ @venue.address1, @venue.city, @venue.state ].compact_blank.join(", ")
  map_url = address.present? ? "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode([ @venue.name, address ].compact.join(', '))}" : nil
%>

<%# The hero: who this is, a line of welcome, where, and the wide image when there is one. %>
<section class="<%= wide ? 'grid grid-cols-1 sm:grid-cols-[minmax(0,1fr)_20rem] gap-6 items-center' : '' %>">
  <div>
    <% if @preview %>
      <span class="inline-flex items-center rounded-md bg-amber-100 px-2 py-1 text-xs font-medium text-amber-800 mb-2">Preview — not public yet</span>
    <% end %>
    <h1 class="text-3xl sm:text-4xl coustard-regular text-gray-900"><%= @organization.name %></h1>
    <% if @ticketing_profile.welcome_line.present? %>
      <p class="text-base sm:text-lg text-gray-600 mt-2 max-w-xl"><%= @ticketing_profile.welcome_line %></p>
    <% end %>
    <% if @venue %>
      <p class="text-sm text-gray-500 mt-2"><%= [ @venue.name, address.presence ].compact.join(" · ") %><% if map_url %> · <%= link_to "Directions", map_url, class: "text-pink-600 hover:text-pink-700", target: "_blank", rel: "noopener" %><% end %></p>
    <% end %>
  </div>
  <% if wide %>
    <%= image_tag wide, alt: "", class: "w-full h-auto rounded-2xl" %>
  <% end %>
</section>

<% if @passes.any? %>
  <div class="mt-6 space-y-2">
    <% @passes.each do |pass| %>
      <%= render "tickets/pass_card", pass: pass, profile: @ticketing_profile %>
    <% end %>
  </div>
<% end %>
<% if @organization.ticket_membership_levels.on_sale.exists? %>
  <%= link_to tickets_members_path(org: @ticketing_profile.slug, **embed_params), class: "mt-4 block rounded-2xl border border-pink-200 bg-pink-50 px-5 py-4 hover:bg-pink-100" do %>
    <span class="block text-sm font-semibold text-gray-900"><%= current_membership(@organization) ? "Your membership" : "Become a member" %></span>
    <span class="block text-sm text-gray-700"><%= current_membership(@organization) ? "Signed in: your perks apply at checkout." : @organization.ticket_membership_levels.on_sale.in_order.map(&:name).to_sentence + ". Perks on every ticket." %></span>
  <% end %>
<% end %>

<% if @listings.empty? %>
  <p class="mt-6 rounded-xl border border-dashed border-gray-300 px-6 py-10 text-center text-sm text-gray-600">No shows on sale right now. Check back soon.</p>
<% elsif @layout == "posters" %>
  <%= render "tickets/box_office_posters" %>
<% else %>
  <%= render "tickets/box_office_dates" %>
<% end %>
