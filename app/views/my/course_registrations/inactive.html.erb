<% content_for :title, "#{@course_offering.title} · #{@production.organization.name}" %>

<div class="mx-auto max-w-xl space-y-5">
  <div class="text-center space-y-1.5">
    <h1 class="text-3xl sm:text-4xl coustard-regular text-gray-900"><%= @course_offering.title %></h1>
    <p class="text-sm text-gray-600"><%= @production.organization.name %></p>
  </div>
  <div class="rounded-2xl border border-gray-200 bg-white px-5 py-6 text-center">
    <p class="font-medium text-gray-900"><%= @course_offering.cancelled? ? "This course has been canceled" : "Registration isn't open" %></p>
    <p class="mt-1 text-sm text-gray-600">
      <% if @course_offering.cancelled? %>
        This course isn't running. If you were registered, your payment has been refunded.
      <% elsif @course_offering.draft? %>
        This course hasn't opened for registration yet. Check back later.
      <% elsif @course_offering.closed? %>
        Registration for this course has closed.
      <% elsif @course_offering.archived? %>
        This course is no longer available.
      <% else %>
        Registration isn't available right now. Please check back later.
      <% end %>
    </p>
  </div>
</div>
