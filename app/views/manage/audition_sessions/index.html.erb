<% content_for :title, "Plan your Audition Sessions" %>

<div class="w-full" data-controller="location-modal audition-session-modal" data-production-id="<%= @production.id %>" data-audition-cycle-id="<%= @audition_cycle.id %>">
  <%= render partial: "shared/notice", locals: { notice: notice } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Sign-ups", manage_signups_path],
      [@production.name, manage_signups_production_path(@production)],
      ["Auditions", manage_signups_auditions_path(@production)]
    ],
    text: "Sessions",
    links: []
  } %>

  <%= render partial: "manage/auditions/cycle_status_panel" %>
  <%= render partial: "manage/auditions/topical_nav", locals: { current_topic: :sessions } %>

  <div class="w-full">
    <!-- Scheduled sessions -->
    <div class="space-y-2" id="audition_sessions_list">
      <% if @audition_sessions.any? %>
        <% @audition_sessions.each do |session| %>
          <%
            session_auditions = session.auditions
            scheduled_count = session_auditions.size
            run_path = manage_signups_auditions_cycle_session_path(@production, @audition_cycle, session)
            schedule_path = manage_schedule_auditions_signups_auditions_cycle_path(@production, @audition_cycle)
          %>
          <%# Hover-revealed action group sits at the top-right of the
              card. The outer div catches the click so the wrapping link
              never sees it. Edit opens the existing audition-session
              modal (XHR-loaded form); Delete goes through the existing
              destroy route with turbo confirm. Both use shared/button
              for consistent CocoScout styling + rounding. %>
          <div class="relative block bg-white border border-gray-200 rounded-lg hover:border-pink-400 transition-colors">
            <%# Delete confirm modal — kept outside the row link so it doesn't navigate. %>
            <%= render "shared/confirm_modal",
                  id: "confirm-delete-audition-session-#{session.id}",
                  title: "Delete session?",
                  message: "Delete this session? Any scheduled auditionees will be unassigned.",
                  confirm_text: "Delete",
                  url: manage_destroy_signups_auditions_cycle_session_path(@production, @audition_cycle, session),
                  method: :delete %>
            <div class="flex items-stretch">
              <%= link_to run_path, class: "flex-1 min-w-0 block no-underline cursor-pointer [&_*]:cursor-pointer" do %>
              <div class="flex flex-col md:flex-row md:items-stretch h-full">
              <%# Left Panel: Session details %>
              <div class="md:w-1/2 px-4 py-3 flex items-center gap-4">
                <%# Date Box %>
                <div class="flex-shrink-0 w-14 flex items-center gap-1.5">
                  <span class="text-xl leading-none font-bold text-gray-900"><%= session.start_at.strftime("%-d") %></span>
                  <span class="text-[10px] leading-tight uppercase">
                    <span class="block font-semibold text-pink-600"><%= session.start_at.strftime("%b") %></span>
                    <span class="block text-gray-500"><%= session.start_at.strftime("%a") %></span>
                  </span>
                </div>
                <%# Session Details %>
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-gray-900">
                    <%= session.start_at.strftime("%l:%M %p").strip %>
                  </div>
                  <div class="text-sm text-gray-600 truncate">
                    <% if session.location.present? %>
                      <%= session.location.name %>
                    <% else %>
                      No location
                    <% end %>
                  </div>
                </div>
              </div>

              <%# Right Panel: Scheduled auditionees %>
              <div class="md:w-1/2 px-4 py-3 md:border-l border-t md:border-t-0 border-gray-200 flex items-center gap-1 flex-wrap min-w-0">
                <% if scheduled_count.zero? %>
                  <span class="text-sm text-gray-400 italic">Empty</span>
                <% else %>
                  <% session_auditions.each do |audition| %>
                    <%
                      auditionable = audition.auditionable
                      next unless auditionable
                      headshot = auditionable.respond_to?(:safe_headshot_variant) ? auditionable.safe_headshot_variant(:thumb) : nil
                      request_path = audition.audition_request_id ? manage_signups_auditions_cycle_request_path(@production, @audition_cycle, audition.audition_request_id) : nil
                      click_handler = request_path ? "event.stopPropagation(); event.preventDefault(); window.location.href='#{request_path}'" : nil
                      status_dot_class = case audition.response_status
                                         when :accepted then "bg-green-500"
                                         when :pending  then "bg-yellow-400"
                                         end
                      tooltip_text = "#{auditionable.name} (#{audition.response_status.to_s.capitalize})"
                    %>
                    <div class="relative">
                      <% if headshot %>
                        <%= image_tag headshot,
                              class: "w-9 h-9 rounded-md object-cover cursor-pointer",
                              onclick: click_handler,
                              data: { controller: "tooltip", tooltip_text: tooltip_text } %>
                      <% else %>
                        <div class="w-9 h-9 rounded-md bg-gray-200 text-gray-700 flex items-center justify-center font-bold text-xs cursor-pointer"
                             onclick="<%= click_handler %>"
                             data-controller="tooltip"
                             data-tooltip-text="<%= tooltip_text %>">
                          <%= auditionable.respond_to?(:initials) ? auditionable.initials : auditionable.name.to_s[0..1].upcase %>
                        </div>
                      <% end %>
                      <% if status_dot_class %>
                        <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full ring-2 ring-white <%= status_dot_class %>"></span>
                      <% end %>
                    </div>
                  <% end %>
                <% end %>
              </div>
              </div>
              <% end %>
              <%# Always-visible actions on the right — Edit, then Delete. %>
              <div class="flex-shrink-0 flex items-center gap-2 px-3 border-l border-gray-200">
                <%= render "shared/button", text: "Edit", variant: "secondary", size: "small", type: :button, icon: "pencil",
                      data: { action: "click->audition-session-modal#openEditModal", "session-id": session.id } %>
                <button type="button"
                      data-controller="modal" data-action="click->modal#open" data-modal-id="confirm-delete-audition-session-<%= session.id %>"
                      class="inline-flex items-center justify-center gap-2 font-medium rounded transition-colors cursor-pointer whitespace-nowrap bg-pink-500 hover:bg-pink-600 text-white px-3 py-1.5 text-sm border-0">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
                  </svg>
                  <span>Delete</span>
                </button>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-gray-500 text-sm">No sessions scheduled yet.</p>
      <% end %>
    </div>

    <!-- Action Buttons -->
    <div class="mt-3 flex flex-wrap gap-2">
      <% if @audition_sessions.any? %>
        <%= render "shared/button",
          text: "Schedule Auditionees",
          variant: "primary",
          size: "medium",
          icon: "user-group",
          path: manage_schedule_auditions_signups_auditions_cycle_path(@production, @audition_cycle) %>
      <% end %>
      <%= render "shared/button",
        text: "New Audition Sessions",
        variant: "secondary",
        size: "medium",
        type: :button,
        icon: "plus",
        data: {
          action: "click->audition-session-modal#openGenerateModal"
        } %>
    </div>
  </div>

  <%= render "modals" %>
  <%= render "generate_modal" %>

</div>
