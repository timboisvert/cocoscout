<% unless @organization.feature_available?(:agreements) %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <%= render "shared/card_header", title: "Agreement Templates" do %>
      <%= render "shared/pro_marker", kind: :header %>
    <% end %>
    <div class="p-6">
      <%= render "shared/pro_locked_card", feature: :agreements,
            title: "Reusable performer agreement templates",
            description: "Pro feature — write your terms once, collect e-signatures in-app, and track who's signed across your productions." %>
    </div>
  </div>
<% else %>
<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
  <%= render "shared/card_header", title: "Agreement Templates" do %>
    <%= render "shared/pro_marker", kind: :header %>
    <%= link_to new_manage_agreement_template_path do %>
      <%= render "shared/button", text: "New Template", variant: "secondary", size: "small" %>
    <% end %>
  <% end %>
  <div class="p-6">
    <% if @agreement_templates.any? %>
      <div class="space-y-3">
        <% @agreement_templates.each do |template| %>
          <%= link_to edit_manage_agreement_template_path(template), class: "block bg-gray-50 rounded-lg border border-gray-200 p-4 hover:bg-gray-100 hover:border-gray-300 transition-colors" do %>
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <h3 class="font-semibold text-gray-900"><%= template.name %></h3>
                  <% unless template.active? %>
                    <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium bg-gray-200 text-gray-600">Inactive</span>
                  <% end %>
                  <span class="text-xs text-gray-400">v<%= template.version %></span>
                </div>
                <% if template.description.present? %>
                  <p class="text-sm text-gray-600 mt-1"><%= template.description %></p>
                <% end %>
                <div class="flex items-center gap-4 mt-2 text-sm text-gray-500">
                  <span>
                    <% production_count = template.productions.count %>
                    <%= production_count %> <%= "production".pluralize(production_count) %>
                  </span>
                  <span>
                    <% signature_count = template.total_signatures %>
                    <%= signature_count %> <%= "signature".pluralize(signature_count) %>
                  </span>
                </div>
              </div>
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No agreement templates</h3>
        <p class="text-sm text-gray-600 mb-4">Create templates for performer agreements that can be used across productions.</p>
        <%= link_to new_manage_agreement_template_path do %>
          <%= render "shared/button", text: "Create Template", variant: "primary", size: "medium" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
<% end %>
