<%# Checkout's one link, "Any access needs for your visit?", and its pop-up
    (accessibility plan §4): fields only, inside the pay form, so they go up
    with the payment. Seen by the box office and the door for that show
    only. Locals: request (TicketOrderAccessRequest or nil), interpreted
    (true when a show in the order is interpreted). %>
<%
  keys = TicketOrderAccessRequest::KEYS.reject { |k| k == "see_interpreter" && !interpreted }
  chosen = request&.request_keys || []
  mid = "access-needs"
%>
<div class="text-center text-sm text-gray-600" data-access-needs>
  <button type="button" class="text-pink-700 hover:text-pink-800 font-medium" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= mid %>">
    <%= request && !request.empty? ? "Access needs: #{request.words} · Change" : "Any access needs for your visit?" %>
  </button>
</div>
<div id="<%= mid %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center sm:p-4" data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full sm:max-w-md sm:mx-4 overflow-hidden max-h-[90vh] overflow-y-auto text-left" data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white">Your visit</h3>
      <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <div class="px-6 py-5 space-y-3 text-sm text-gray-700">
      <p class="text-gray-600">Optional. Only the box office and the door see this, and it's deleted a month after the show.</p>
      <%= hidden_field_tag "access_request_keys[]", "" %>
      <% keys.each do |key| %>
        <label class="flex items-center gap-3 text-gray-900">
          <%= check_box_tag "access_request_keys[]", key, chosen.include?(key), id: "access_request_#{key}", class: "h-[18px] w-[18px] text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
          <%= TicketOrderAccessRequest::LABELS[key] %>
        </label>
      <% end %>
      <%= text_area_tag "access_note", request&.note, rows: 2, maxlength: 500, placeholder: "Anything else we should know", class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
      <div class="pt-1 flex justify-end">
        <%= render "shared/button", text: "Done", variant: "primary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
      </div>
    </div>
  </div>
</div>
