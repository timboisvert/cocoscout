<%# My Contracts, on a contract's card: what the contractor has requested about
    its dates (ContractDateRequests) and where each request stands, then the
    way to ask. Rows of the card's to-do strip.

    Locals:
      contract — the contract (the viewer is its contractor)
      requests — its requests still showing to the asker, oldest first
      can_ask  — whether a new one can be asked (a live contract) %>
<%
  org = contract.organization.name
  ask_modal = "ask-date-modal-#{contract.id}"
%>
<% requests.each do |request| %>
  <div class="flex items-start justify-between gap-3 px-5 py-3" data-date-request="<%= request.status %>">
    <div class="min-w-0 flex items-start gap-2 text-sm text-gray-700">
      <%= icon("calendar", class: "w-4 h-4 text-pink-500 flex-shrink-0 mt-0.5") %>
      <div class="min-w-0">
        <% case request.status %>
        <% when "open" %>
          <div class="font-medium text-gray-900"><%= request.requested_words %></div>
          <div class="text-xs text-gray-500">Waiting for their answer. Nothing changes until they change the contract.</div>
        <% when "amending" %>
          <div class="font-medium text-gray-900"><%= org %> changed the contract after <%= request.request_phrase %></div>
          <div class="text-xs text-gray-500">It takes effect when you sign.</div>
        <% when "done" %>
          <div class="font-medium text-gray-900"><%= org %> <%= request.outcome_words %>, as you requested</div>
        <% when "kept" %>
          <div class="font-medium text-gray-900"><%= org %> <%= request.kept_words %></div>
          <% if request.answer_note.present? %>
            <div class="text-sm text-gray-600 mt-0.5">"<%= request.answer_note %>"</div>
          <% end %>
        <% end %>
      </div>
    </div>
    <% if request.open? %>
      <%= form_with url: my_contract_date_request_path(contract, request_id: request.id), method: :delete, local: true,
            class: "flex-shrink-0", data: { turbo_action: "replace" } do %>
        <%= render "shared/button", text: "Withdraw", variant: "secondary", size: "xs", type: :submit %>
      <% end %>
    <% elsif !request.waiting? %>
      <%= form_with url: my_dismiss_contract_date_request_path(contract, request_id: request.id), method: :patch, local: true,
            class: "flex-shrink-0", data: { turbo_action: "replace" } do %>
        <%= render "shared/button", text: "Dismiss", variant: "secondary", size: "xs", type: :submit %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if can_ask %>
<div class="flex items-center justify-between gap-3 px-5 py-3">
  <span class="min-w-0 flex items-center gap-2 text-sm text-gray-700">
    <%= icon("calendar", class: "w-4 h-4 text-pink-500 flex-shrink-0") %>
    <span class="truncate">Need a date moved, canceled or added?</span>
  </span>
  <%= render "shared/button", text: "Request date/time change", variant: "outline-pink", size: "small", type: :button,
        classes: "flex-shrink-0", data: { action: "click->modal#open", modal_id: ask_modal } %>
</div>
<div id="<%= ask_modal %>" class="hidden fixed inset-0 z-50 bg-black/50 flex items-start justify-center p-4 overflow-y-auto" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full my-8 overflow-hidden" data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white">Request date/time change</h3>
      <button type="button" data-action="click->modal#close" aria-label="Close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <div class="p-5 max-h-[75vh] overflow-y-auto">
      <turbo-frame id="ask_contract_date_<%= contract.id %>" src="<%= my_ask_contract_date_path(contract) %>" loading="lazy">Loading…</turbo-frame>
    </div>
  </div>
</div>
<% end %>
