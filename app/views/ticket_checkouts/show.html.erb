<%
  show = @listing.show
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  free = @order.total_cents.zero?
  pay_text = free ? "Get my tickets" : "Pay #{number_to_currency(@order.total_cents / 100.0)}"
  image, page_image = ticket_page_image(@listing)
  place = [ show.location&.name, show.location_space&.name ].compact.uniq.join(" · ")
  back_path = tickets_event_path(org: @ticketing_profile.slug, event: @listing.slug, **embed_params)
  # Paying on their own phone at the door: the door picked the tickets, and
  # the buyer's details are optional.
  at_door = @order.channel == "door_card"
  offers = @expired ? [] : @listing.product_offers(at_door: at_door)
%>
<% content_for :title, "Checkout · #{@listing.display_title}" %>
<% content_for :head do %>
  <% unless free || @expired %><script src="https://js.stripe.com/v3/"></script><% end %>
<% end %>

<%# Layout A, like the show's page: one calm centered column. %>
<div class="mx-auto max-w-xl space-y-5">
  <h1 class="text-center text-3xl sm:text-4xl coustard-regular text-gray-900"><%= at_door ? "Pay at the door" : "Checkout" %></h1>

  <% if @expired %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-6 text-center">
      <p class="text-gray-900 font-medium">Your hold on these seats ran out.</p>
      <p class="mt-1 text-sm text-gray-600">Seats are held for ten minutes while you check out. Pick your tickets again to start over.</p>
      <div class="mt-4 flex justify-center">
        <%= render "shared/button", text: "Back to tickets", variant: "primary", size: "medium", path: back_path %>
      </div>
    </div>
  <% else %>
    <%= form_with url: tickets_checkout_pay_path(token: @order.token, **embed_params), method: :post, class: "space-y-5",
          data: {
            controller: "ticket-checkout",
            action: "submit->ticket-checkout#submit",
            ticket_checkout_target: "form",
            ticket_checkout_publishable_key_value: stripe_publishable_key.to_s,
            ticket_checkout_amount_value: @order.total_cents,
            ticket_checkout_free_value: free,
            ticket_checkout_return_url_value: tickets_checkout_done_url(token: @order.token, **embed_params),
            ticket_checkout_expires_at_value: @order.expires_at&.iso8601,
            ticket_checkout_listing_id_value: (@listing.id unless at_door),
            ticket_checkout_token_value: @order.token,
            ticket_checkout_items_url_value: tickets_checkout_items_path(token: @order.token)
          } do %>
      <%= render "tickets/bot_trap", id: "checkout_website" %>

      <%# The show, what they're buying, and every cent of it. %>
      <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="flex items-center gap-4 px-5 py-4">
          <% if image %>
            <%= image_tag image, alt: "", class: "#{page_image.wide? ? 'w-24' : 'w-14'} h-auto rounded-lg flex-shrink-0" %>
          <% end %>
          <div class="min-w-0 flex-1 text-left">
            <div class="font-semibold text-gray-900 truncate"><%= @listing.display_title %></div>
            <div class="text-sm text-gray-600"><%= show.date_and_time.strftime("%a, %b %-d · %-l:%M %p") %></div>
            <% if place.present? %><div class="text-sm text-gray-500 truncate"><%= place %></div><% end %>
          </div>
        </div>
        <div data-ticket-checkout-target="summary"><%= render "ticket_checkouts/summary", order: @order %></div>
        <div class="border-t border-gray-100 bg-gray-50 px-5 py-2.5 flex items-center justify-between gap-3 text-sm">
          <span class="text-gray-600" data-ticket-checkout-target="countdown" aria-live="polite"></span>
          <% unless at_door %>
            <%= link_to "Change tickets", back_path, class: "font-medium text-pink-700 hover:text-pink-800" %>
          <% end %>
        </div>
      </div>

      <% if offers.any? %>
        <%= render "ticket_checkouts/products", order: @order, offers: offers %>
      <% end %>

      <div class="rounded-2xl border border-gray-200 bg-white px-5 py-5 space-y-4">
        <h2 class="font-semibold text-gray-900">Your details<% if at_door %> <span class="font-normal text-gray-500">(optional)</span><% end %></h2>
        <div>
          <label for="buyer_name" class="block text-sm font-medium text-gray-700 mb-1.5">Name</label>
          <%= text_field_tag :buyer_name, @order.buyer_name, autocomplete: "name", required: !at_door, class: input_class %>
        </div>
        <div>
          <label for="buyer_email" class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
          <%= email_field_tag :buyer_email, @order.buyer_email, autocomplete: "email", required: !at_door, class: input_class %>
          <p class="text-xs text-gray-500 mt-1"><%= at_door ? "Add it to get your tickets and receipt by email." : "We'll email your tickets to this address." %></p>
        </div>
        <div>
          <label for="buyer_phone" class="block text-sm font-medium text-gray-700 mb-1.5">Phone <span class="font-normal text-gray-500">(optional)</span></label>
          <%= telephone_field_tag :buyer_phone, @order.buyer_phone, autocomplete: "tel", class: input_class %>
        </div>
      </div>

      <% unless free %>
        <div class="rounded-2xl border border-gray-200 bg-white px-5 py-5">
          <h2 class="font-semibold text-gray-900 mb-4">Payment</h2>
          <div data-ticket-checkout-target="payment" class="min-h-[3rem]"></div>
        </div>
      <% end %>

      <p data-ticket-checkout-target="error" class="hidden text-sm text-red-600 text-center" role="alert"></p>

      <%= render "shared/button", text: pay_text, variant: "primary", size: "jumbo", type: :submit, classes: "disabled:opacity-50",
            data: { ticket_checkout_target: "submit", pay_prefix: (free ? "" : "Pay ") } %>

      <% if @ticketing_profile.support_email.present? %>
        <p class="text-xs text-center text-gray-500">Questions? <%= mail_to @ticketing_profile.support_email, nil, class: "text-pink-700" %></p>
      <% end %>
    <% end %>
  <% end %>
</div>
