<%# What are you changing? (Tim, 2026-10-18): three short groups instead of
    six tall cards, so the small things read as small, the date and service
    changes as recorded-but-unsigned, and amending the deal as the one that
    goes back for a signature. %>
<%
  row = lambda do |path, icon_name, title, words, pink: false|
    link_to path, class: "flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors" do
      concat(content_tag(:span, icon(icon_name, class: "w-4 h-4"),
                         class: "inline-flex items-center justify-center w-8 h-8 rounded-full flex-shrink-0 #{pink ? 'bg-pink-100 text-pink-600' : 'bg-gray-100 text-gray-600'}"))
      concat(content_tag(:span, class: "min-w-0 flex-1") {
        concat content_tag(:span, title, class: "block text-sm font-semibold text-gray-900")
        concat content_tag(:span, words, class: "block text-xs text-gray-600")
      })
      concat content_tag(:span, icon("arrow-right", class: "w-4 h-4"), class: "flex-shrink-0 #{pink ? 'text-pink-500' : 'text-gray-400'}")
    end
  end
  group = lambda do |eyebrow, words, pink: false, &rows|
    concat content_tag(:h3, eyebrow, class: "text-[11px] font-semibold uppercase tracking-wide text-gray-500")
    concat content_tag(:p, words, class: "text-xs text-gray-500 mb-2")
    concat content_tag(:div, capture(&rows), class: "divide-y divide-gray-100 rounded-lg overflow-hidden mb-6 #{pink ? 'border-2 border-pink-300' : 'border border-gray-200'}")
  end
%>
<%= render layout: "manage/contracts/amend_layout", locals: { step_name: "What are you changing?" } do %>
    <h2 class="text-2xl coustard-regular text-gray-900 mb-1">What are you changing?</h2>
    <p class="text-gray-600 mb-6">Small things never touch the deal. Only the deal itself goes back for a signature.</p>

    <% group.call("Small changes", "Nothing on the signed contract moves.") do %>
      <%= row.call(amend_basics_manage_contract_path(@contract), "pencil", "Basic info", "The production's name and description.") %>
      <%= row.call(amend_people_manage_contract_path(@contract), "users", "Who's on it",
                   "The people on #{@contract.contractor_name}'s side who see the dates, the ticket sales and what the contract pays.") %>
      <%= row.call(amend_space_manage_contract_path(@contract), "building", "The room", "A different space at the same venue, for one date or all of them.") %>
    <% end %>

    <% group.call("Dates and services", "Applied right away and recorded on the contract. No new signature.") do %>
      <%= row.call(amend_dates_manage_contract_path(@contract), "calendar", "Dates", "Cancel a date, move one, or add another. Its payments come and go with it.") %>
      <%= row.call(amend_services_manage_contract_path(@contract), "check-circle", "Services and prices",
                   "What each date gets and what it costs, on any date that isn't settled yet.") %>
    <% end %>

    <% group.call("Amend the deal", "A new version of the contract, sent for signature.", pink: true) do %>
      <%= row.call(amend_bookings_manage_contract_path(@contract), "file-text", "The deal",
                   "The split or the fee, for every date or just one, ticketing, or the booking pattern. Rebuilds the payment schedule around what's changed.", pink: true) %>
    <% end %>
<% end %>
