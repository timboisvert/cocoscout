<% content_for :title, "Create Sign-Up Form - #{step_name}" %>

<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Sign-ups", manage_signups_path],
      [@production.name, manage_signups_production_path(@production)],
      ["Forms", manage_signups_forms_path(@production)]
    ],
    text: "Create Sign-Up Form",
    links: []
  } %>

  <%
    # Build steps dynamically based on wizard state
    all_steps = []
    all_steps << { key: "scope", name: "Scope", path: manage_signups_forms_wizard_path(@production) }
    unless @wizard_state && @wizard_state[:scope] == "shared_pool"
      all_steps << { key: "events", name: "Events", path: manage_signups_forms_wizard_events_path(@production) }
    end
    all_steps << { key: "slots", name: "Slots", path: manage_signups_forms_wizard_slots_path(@production) }
    all_steps << { key: "rules", name: "Rules", path: manage_signups_forms_wizard_rules_path(@production) }
    all_steps << { key: "schedule", name: "Schedule", path: manage_signups_forms_wizard_schedule_path(@production) }
    all_steps << { key: "notifications", name: "Notifications", path: manage_signups_forms_wizard_notifications_path(@production) }
    all_steps << { key: "review", name: "Review", path: manage_signups_forms_wizard_review_path(@production) }

    # Assign step numbers
    wizard_steps = all_steps.each_with_index.map { |step, i| step.merge(num: i + 1) }
    current_index = wizard_steps.index { |s| s[:num] == current_step } || 0
  %>
  <%# Full-width step bar, directly below the breadcrumb. %>
  <%= render "shared/wizard_steps", steps: wizard_steps, current_index: current_index %>

  <div class="max-w-2xl mx-auto mt-8">
    <!-- Step Content -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <%= yield %>
    </div>

    <!-- Cancel Link -->
    <div class="mt-4 text-center">
      <% wizard_cancel_cid = "confirm-#{SecureRandom.hex(6)}" %>
      <button type="button"
          data-controller="modal" data-action="click->modal#open" data-modal-id="<%= wizard_cancel_cid %>"
          class="text-sm text-gray-500 hover:text-gray-700 bg-transparent border-0 cursor-pointer">Cancel</button>
      <%= render "shared/confirm_modal", id: wizard_cancel_cid, title: "Cancel?",
            message: "Are you sure you want to cancel? Your progress will be lost.", confirm_text: "Cancel",
            url: manage_signups_forms_wizard_cancel_path(@production), method: :delete %>
    </div>
  </div>
</div>
