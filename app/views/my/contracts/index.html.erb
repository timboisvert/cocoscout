<% content_for :title, "My Contracts" %>

<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [],
    text: "My Contracts",
    links: []
  } %>

  <% if @needs_bank %>
    <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 flex flex-wrap items-center justify-between gap-3">
      <div class="text-sm text-amber-900">
        <span class="font-semibold">Connect your bank to get paid.</span>
        Payments on your contracts are sent straight to your bank account.
      </div>
      <%= render "shared/button", text: "Set up payment", variant: "primary", size: "small", path: my_payments_setup_path %>
    </div>
  <% end %>

  <% if @contracts.any? %>
    <p class="text-sm text-gray-500 mb-3"><%= pluralize(@contracts.size, "contract") %></p>

    <%
      # Group by production (contracts on the same production together); contracts
      # with no production group under their org. Groups needing action come first.
      groups = @contracts.group_by { |c| c.production_id ? [ :prod, c.production_id ] : [ :org, c.organization_id ] }
      sorted_groups = groups.values.sort_by do |cs|
        needs = cs.any? { |c| c.signing_out_for_signature? || c.pending_sales_report? || c.contract_payments.any?(&:collectable_online?) }
        [ needs ? 0 : 1, -cs.map(&:created_at).max.to_i ]
      end
    %>
    <div class="space-y-8">
      <% sorted_groups.each do |group_contracts| %>
        <%
          group_first = group_contracts.first
          group_label = group_first.production_name.presence || group_first.production&.name || group_first.organization.name
          # Within a production: needs-action, then active, then newest first.
          group_sorted = group_contracts.sort_by do |c|
            overdue = c.contract_payments.any? { |p| p.collectable_online? && p.overdue? }
            [ c.signing_out_for_signature? ? 0 : 1, overdue ? 0 : 1, (c.status_active? ? 0 : 1), -c.created_at.to_i ]
          end
        %>
        <section>
          <h2 class="text-base font-semibold text-gray-900 mb-2 flex items-center gap-2">
            <span class="truncate"><%= group_label %></span>
            <% if group_sorted.size > 1 %><span class="text-xs font-normal text-gray-400 flex-shrink-0"><%= group_sorted.size %> contracts</span><% end %>
          </h2>
          <div class="space-y-4">
            <% group_sorted.each do |contract| %>
        <%
          outgoing = contract.contract_payments.select(&:direction_outgoing?)
          received_total = outgoing.select(&:status_paid?).sum { |p| p.amount.to_f }
          pending_total  = outgoing.reject(&:status_paid?).sum { |p| p.amount.to_f }
          to_pay = contract.contract_payments.select(&:collectable_online?).sort_by(&:due_date)
          owed_total = to_pay.sum { |p| p.amount.to_f }
          needs_signature = contract.signing_out_for_signature?
          reports_sales = contract.pending_sales_report?
          has_overdue = to_pay.any?(&:overdue?)
          has_action = needs_signature || reports_sales || to_pay.any?
          # Title from the contractor's POV: the show, else the org they contracted with.
          # Fall back to the live production name — the snapshot column can be blank
          # even when the production is linked — before landing on the org name.
          title = contract.production_name.presence || contract.production&.name || contract.organization.name
          border = needs_signature ? "border-amber-300" : (has_overdue ? "border-pink-300" : "border-gray-200")
          status_class = { "active" => "bg-green-100 text-green-700", "completed" => "bg-blue-100 text-blue-700",
                           "cancelled" => "bg-red-100 text-red-700" }[contract.status] || "bg-gray-100 text-gray-600"
        %>
        <div class="bg-white rounded-xl border <%= border %> overflow-hidden" data-controller="modal">
          <%# Header — click to open the full contract. %>
          <div role="button" tabindex="0"
               class="px-5 py-4 cursor-pointer hover:bg-gray-50 transition focus:outline-none focus:ring-2 focus:ring-inset focus:ring-pink-500"
               data-action="click->modal#open keydown.enter->modal#open keydown.space->modal#open"
               data-modal-id="contract-modal-<%= contract.id %>">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="font-semibold text-gray-900 truncate">
                  <% if contract.contract_start_date && contract.contract_end_date %><%= contract.contract_start_date.strftime("%b %-d") %> – <%= contract.contract_end_date.strftime("%b %-d, %Y") %><% else %>Contract<% end %>
                </h3>
                <p class="text-sm text-gray-500 mt-0.5 truncate">with <%= contract.organization.name %></p>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <% if needs_signature %>
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-amber-100 text-amber-700">Awaiting your signature</span>
                <% else %>
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold <%= status_class %>"><%= contract.status.titleize %></span>
                <% end %>
                <%= icon("chevron-right", class: "w-4 h-4 text-gray-400") %>
              </div>
            </div>

            <%# Money at a glance — only what's real (no misleading "none scheduled"). %>
            <% if received_total > 0 || pending_total > 0 || owed_total > 0 %>
              <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
                <% if received_total > 0 %><span><span class="text-gray-500">Received</span> <span class="font-semibold text-green-600"><%= number_to_currency(received_total) %></span></span><% end %>
                <% if pending_total > 0 %><span><span class="text-gray-500">Upcoming</span> <span class="font-semibold text-gray-900"><%= number_to_currency(pending_total) %></span></span><% end %>
                <% if owed_total > 0 %><span><span class="text-gray-500">You owe</span> <span class="font-semibold text-pink-600"><%= number_to_currency(owed_total) %></span></span><% end %>
              </div>
            <% end %>
          </div>

          <%# Everything you need to DO on this contract, contained in one strip. %>
          <% if has_action %>
            <div class="border-t border-gray-100 divide-y divide-gray-100">
              <% if needs_signature %>
                <div class="flex items-center justify-between gap-3 px-5 py-3 bg-amber-50/60">
                  <span class="min-w-0 flex items-center gap-2 text-sm text-gray-700">
                    <%= icon("pencil", class: "w-4 h-4 text-amber-600 flex-shrink-0") %>
                    <span class="truncate"><span class="font-medium text-gray-900"><%= contract.organization.name %></span> needs you to review and sign.</span>
                  </span>
                  <%= render "shared/button", text: "Review & sign", variant: "primary", size: "small",
                        classes: "flex-shrink-0", path: sign_contract_path(token: contract.signing_token) %>
                </div>
              <% end %>

              <% if reports_sales %>
                <% rs_modal = "report-sales-modal-#{contract.id}" %>
                <div class="flex items-center justify-between gap-3 px-5 py-3">
                  <span class="min-w-0 flex items-center gap-2 text-sm text-gray-700">
                    <%= icon("ticket", class: "w-4 h-4 text-pink-500 flex-shrink-0") %>
                    <span class="truncate">You sell the tickets — report your sales so we can settle up.</span>
                  </span>
                  <%= render "shared/button", text: "Report sales", variant: "outline-pink", size: "small", type: :button,
                        classes: "flex-shrink-0", data: { action: "click->modal#open", modal_id: rs_modal } %>
                </div>

                <%# Report-sales modal — the form lazy-loads into the turbo-frame. %>
                <div id="<%= rs_modal %>" class="hidden fixed inset-0 z-50 bg-black/50 flex items-start justify-center p-4 overflow-y-auto"
                     data-action="click->modal#closeOnBackdrop">
                  <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full my-8 overflow-hidden" data-action="click->modal#stopPropagation">
                    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
                      <h3 class="text-lg font-semibold text-white">Report ticket sales</h3>
                      <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition cursor-pointer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                      </button>
                    </div>
                    <div class="p-5 max-h-[75vh] overflow-y-auto">
                      <turbo-frame id="report_sales_<%= contract.id %>" src="<%= my_report_contract_sales_path(contract) %>" loading="lazy">
                        <div class="py-10 text-center text-sm text-gray-500">Loading…</div>
                      </turbo-frame>
                    </div>
                  </div>
                </div>
              <% end %>

              <% to_pay.each do |payment| %>
                <div class="flex items-center justify-between gap-3 px-5 py-3">
                  <div class="min-w-0">
                    <div class="text-sm font-medium text-gray-900 truncate"><%= payment.description.presence || "Payment due" %></div>
                    <div class="text-xs <%= payment.overdue? ? 'text-pink-600 font-medium' : 'text-gray-500' %>">
                      <%= payment.overdue? ? "Was due" : "Due" %> <%= payment.due_date.strftime("%b %-d, %Y") %>
                    </div>
                  </div>
                  <%= render "shared/button", text: "Pay #{number_to_currency(payment.amount)}", variant: "primary", size: "small",
                        classes: "flex-shrink-0", path: pay_contract_path(token: payment.payment_token!) %>
                </div>
              <% end %>
            </div>
          <% end %>

          <%# Signed PDF, right on the card once it's ready. %>
          <% if (pdf_doc = contract.signed_pdf_document) %>
            <div class="border-t border-gray-100 px-5 py-3 flex justify-end">
              <%= render "shared/button", text: "Download signed PDF", variant: "secondary", size: "small", icon: "download",
                    path: rails_blob_path(pdf_doc.file, disposition: "attachment") %>
            </div>
          <% end %>

          <%= render "my/contracts/contract_summary_modal", contract: contract %>
        </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <div class="bg-gray-50 rounded-lg border border-dashed border-gray-300 p-12 text-center">
      <p class="text-gray-600">You don't have any contracts yet.</p>
      <p class="text-sm text-gray-500 mt-1">When an organization sets up a contract with you, it'll show here.</p>
    </div>
  <% end %>
</div>
