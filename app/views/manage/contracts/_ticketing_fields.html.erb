<%#
  Ticketing fields: ticket tiers (name + price) and any number of discount codes,
  each managed as a list you add to through a modal. Wrapped in the
  `contract-ticketing` Stimulus controller with a hidden JSON input named
  "ticketing". The caller supplies the surrounding <form> and nav buttons.
  Local: ticketing (Hash, e.g. @contract.draft_ticketing or staged amend data).
%>
<% ticketing ||= {} %>

<div data-controller="contract-ticketing" data-contract-ticketing-existing-value="<%= ticketing.to_json %>">
  <%# Ticket tiers %>
  <div class="mb-8">
    <h3 class="text-sm font-semibold text-gray-900 mb-1">Ticket tiers</h3>
    <p class="text-xs text-gray-500 mb-3">The prices people can buy at — General, VIP, and so on.</p>

    <div data-contract-ticketing-target="tierList" class="space-y-2"></div>

    <div class="mt-4">
      <%= render "shared/button", text: "Add a ticket tier", variant: "primary", size: "medium",
            icon: "plus", type: :button,
            data: { action: "click->contract-ticketing#openTierModal" } %>
    </div>
  </div>

  <%# Discount codes %>
  <div class="mb-6 pt-6 border-t border-gray-200">
    <h3 class="text-sm font-semibold text-gray-900 mb-1">Discount codes</h3>
    <p class="text-xs text-gray-500 mb-3">Optional codes people can enter at checkout. Add as many as you like.</p>

    <div data-contract-ticketing-target="discountList" class="space-y-2"></div>

    <div class="mt-4">
      <%= render "shared/button", text: "Add a discount code", variant: "primary", size: "medium",
            icon: "plus", type: :button,
            data: { action: "click->contract-ticketing#openDiscountModal" } %>
    </div>
  </div>

  <input type="hidden" name="ticketing" data-contract-ticketing-target="ticketingJson" value="<%= ticketing.to_json %>">

  <%# Add-a-tier modal %>
  <div data-contract-ticketing-target="tierModal" class="hidden fixed inset-0 z-50">
    <div class="fixed inset-0 bg-black/50" data-action="click->contract-ticketing#closeTierModal"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 bg-pink-600">
          <h3 class="text-lg font-bold text-white">Add a ticket tier</h3>
          <button type="button" data-action="click->contract-ticketing#closeTierModal" class="text-white/80 hover:text-white">
            <%= icon("x-mark", class: "w-5 h-5") %>
          </button>
        </div>
        <div class="p-6 space-y-5">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Name</label>
            <input type="text" data-contract-ticketing-target="tierName" placeholder="e.g. General admission"
                   class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Price</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">$</span>
              <input type="number" step="0.01" min="0" data-contract-ticketing-target="tierPrice" placeholder="0.00"
                     class="block w-full pl-8 pr-4 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
            </div>
          </div>
          <p data-contract-ticketing-target="tierError" class="hidden text-sm text-red-600"></p>
          <div class="flex gap-3 pt-1">
            <button type="button" data-action="click->contract-ticketing#closeTierModal"
                    class="flex-1 px-4 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">Cancel</button>
            <%= render "shared/button", text: "Add tier", variant: "primary", size: "medium", type: :button,
                  classes: "flex-1", data: { action: "click->contract-ticketing#addTier" } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Add-a-discount modal %>
  <div data-contract-ticketing-target="discountModal" class="hidden fixed inset-0 z-50">
    <div class="fixed inset-0 bg-black/50" data-action="click->contract-ticketing#closeDiscountModal"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 bg-pink-600">
          <h3 class="text-lg font-bold text-white">Add a discount code</h3>
          <button type="button" data-action="click->contract-ticketing#closeDiscountModal" class="text-white/80 hover:text-white">
            <%= icon("x-mark", class: "w-5 h-5") %>
          </button>
        </div>
        <div class="p-6 space-y-5">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Code</label>
            <input type="text" data-contract-ticketing-target="discountCode" placeholder="e.g. FRIENDS"
                   class="block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">How much off?</label>
            <div class="flex gap-2">
              <input type="number" step="0.01" min="0" data-contract-ticketing-target="discountAmount" placeholder="0"
                     class="block flex-1 px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
              <select data-contract-ticketing-target="discountType"
                      class="w-28 px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition">
                <option value="percent">% off</option>
                <option value="fixed">$ off</option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Applies to</label>
            <div class="flex gap-4">
              <label class="flex items-center gap-2">
                <input type="radio" name="discount_applies_to" value="all" checked
                       data-action="change->contract-ticketing#onDiscountAppliesToChange"
                       class="h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500">
                <span class="text-sm text-gray-900">All tickets</span>
              </label>
              <label class="flex items-center gap-2">
                <input type="radio" name="discount_applies_to" value="specific"
                       data-action="change->contract-ticketing#onDiscountAppliesToChange"
                       class="h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500">
                <span class="text-sm text-gray-900">Certain tiers only</span>
              </label>
            </div>
            <div data-contract-ticketing-target="discountTierWrapper" class="hidden mt-3 pl-1">
              <div data-contract-ticketing-target="discountTiers"></div>
            </div>
          </div>
          <p data-contract-ticketing-target="discountError" class="hidden text-sm text-red-600"></p>
          <div class="flex gap-3 pt-1">
            <button type="button" data-action="click->contract-ticketing#closeDiscountModal"
                    class="flex-1 px-4 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">Cancel</button>
            <%= render "shared/button", text: "Add code", variant: "primary", size: "medium", type: :button,
                  classes: "flex-1", data: { action: "click->contract-ticketing#addDiscount" } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
