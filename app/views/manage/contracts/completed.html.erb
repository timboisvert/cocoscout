<% content_for :title, "Past Contracts" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Contracts", manage_contracts_path]
    ],
    text: "Past Contracts",
    links: []
  } %>

  <% if @completed_contracts.any? %>
    <div class="border border-gray-200 rounded-lg overflow-hidden mb-8 bg-white">
      <%= render "shared/section_heading", padding: "px-4 py-3", title: "Past Contracts" %>
      <div class="p-4 space-y-2">
        <% @completed_contracts.each do |contract| %>
          <%= render "contract_list_row", contract: contract %>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state", icon: "document", title: "No past contracts", body: "Completed and cancelled contracts show up here." %>
  <% end %>
</div>
