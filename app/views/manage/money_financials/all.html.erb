<% content_for :title, "All Financials" %>

<%# The full every-production financials grid (moved off the financials index,
    which stays action-focused). Summary + type/status filters + slim grid. %>
<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      [ "Money", manage_money_index_path ],
      [ "Financials", manage_money_financials_path ]
    ],
    text: "All Financials",
    links: []
  } %>

  <%= render "shared/money_summary",
    title: "All Financials",
    money_in: @financial_summary[:gross_revenue],
    money_out: @financial_summary[:cost_of_shows],
    profit: @financial_summary[:gross_profit],
    selected_period: @selected_period,
    period_path: manage_money_all_financials_path,
    refresh_url: manage_refresh_money_path %>

  <%# Filter Bar — Type (productions vs courses) first, then Status %>
  <div class="mb-3">
    <%= render "shared/filters/filter_bar", bare: true, filter_groups: [
      {
        label: "Type",
        filters: [
          { text: "All",         path: manage_money_all_financials_path(type: "all", filter: @financials_filter),         active: @type_filter == "all" },
          { text: "Productions", path: manage_money_all_financials_path(type: "productions", filter: @financials_filter), active: @type_filter == "productions" },
          { text: "Courses",     path: manage_money_all_financials_path(type: "courses", filter: @financials_filter),     active: @type_filter == "courses" }
        ]
      },
      { separator: true },
      {
        label: "Status",
        filters: [
          { text: "All",                path: manage_money_all_financials_path(type: @type_filter, filter: "all"),     active: @financials_filter.blank? || @financials_filter == "all" },
          { text: "Pending Financials", path: manage_money_all_financials_path(type: @type_filter, filter: "pending"), active: @financials_filter == "pending" }
        ]
      }
    ] %>
  </div>

  <div class="">
    <% if @production_summaries.any? %>
      <%= render "manage/money/slim_grid", summaries: @production_summaries, events_filter: @financials_filter %>
    <% else %>
      <div class="bg-gray-50 rounded-lg border border-dashed border-gray-300 p-8 text-center">
        <p class="text-gray-600">
          <% if @financials_filter == "pending" %>
            All past revenue shows have financial data entered.
          <% else %>
            No productions yet.
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
</div>
