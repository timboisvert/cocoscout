<%#
  A password field with the show/hide eye and, for a new password, the
  strength meter: five segments plus one line that names what's still
  missing (password_strength_controller.js). The rules are the model's
  (8+, a capital, a lowercase, a number, a symbol).

  The strength controller lives on the FORM, not here, so the submit button
  can be its target too: give the form_with
    data: { controller: "password-strength" }
  and the submit button
    data: { password_strength_target: "submit" }, disabled: true

  Locals:
    form          the form builder (optional; password_field_tag without one)
    name          field name, default :password
    label         default "Password"
    autocomplete  "new-password" (default) or "current-password"
    placeholder
    strength      true for a new password: meter + hint + 8-char minimum
    error         true to draw the pink border
%>
<%
  form         = local_assigns[:form]
  name         = local_assigns[:name] || :password
  label        = local_assigns[:label] || "Password"
  autocomplete = local_assigns[:autocomplete] || "new-password"
  placeholder  = local_assigns[:placeholder] || (autocomplete == "current-password" ? "Your password" : "Choose a password")
  strength     = local_assigns[:strength] || false
  error        = local_assigns[:error] || false
  id           = local_assigns[:id] || (form&.object_name.present? ? "#{form.object_name}_#{name}" : name.to_s)

  data = { password_visibility_target: "input" }
  if strength
    data[:password_strength_target] = "input"
    data[:action] = "input->password-strength#checkStrength paste->password-strength#checkStrength change->password-strength#checkStrength"
  end
  options = {
    id: id, required: true, autocomplete: autocomplete, placeholder: placeholder, maxlength: 72,
    minlength: (8 if strength), class: "#{auth_input_class(error: error)} pr-11", data: data
  }.compact
%>
<div data-controller="password-visibility">
  <label for="<%= id %>" class="mb-1.5 block text-sm font-medium text-slate-700"><%= label %></label>
  <div class="relative">
    <% if form %>
      <%= form.password_field name, options %>
    <% else %>
      <%= password_field_tag name, nil, options %>
    <% end %>
    <button type="button" data-action="password-visibility#toggle" aria-label="Show password"
            class="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 text-slate-500 hover:text-slate-700 focus:outline-none">
      <span data-password-visibility-target="icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </span>
    </button>
  </div>
  <% if strength %>
    <div class="mt-2.5 flex gap-1" aria-hidden="true" data-password-strength-target="meter">
      <% 5.times do %><span class="h-1 flex-1 rounded-full bg-slate-200 transition-colors"></span><% end %>
    </div>
    <p class="mt-2 text-[13px] leading-snug text-slate-500" aria-live="polite" data-password-strength-target="hint">8 or more characters, with a capital, a number and a symbol.</p>
  <% end %>
</div>
