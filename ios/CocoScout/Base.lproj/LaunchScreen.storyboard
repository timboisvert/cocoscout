                            <constraint firstItem="TitleImageView" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="TitleCenterX"/>
                            <constraint firstItem="TaglineLabel" firstAttribute="top" secondItem="TitleImageView" secondAttribute="bottom" constant="8" id="TaglineTop"/>
