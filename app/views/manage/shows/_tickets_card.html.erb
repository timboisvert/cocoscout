<%# Tickets on the show page: where this date's tickets are, as small as the
    Money box, for reading only (Round 9 §3; Tim: the show page shows, the
    edit pages change). Pro, like Money. Nothing is drawn when there's
    nothing to say: the production's answer lives on Production Settings →
    Tickets, a date's own on its Tickets tab. Locals: show, production. %>
<%
  listing = show.ticket_listing
  listing = nil if listing&.status == "canceled"
  link = TicketLink.for(show, listing: listing)
  # Ticketing's pages are the organization's managers'. Everyone else reads
  # the tile, no link. No Door tile here (Tim, 2026-10-10): check-ins live in
  # Ticketing and the Door, not on the show page.
  can_manage_ticketing = Current.user&.superadmin? || Current.organization&.manageable_by?(Current.user)
  tile = lambda do |path, allowed, &block|
    if allowed
      link_to(path, class: "block rounded-lg border border-gray-200 p-3 hover:border-pink-300 hover:bg-gray-50 transition", &block)
    else
      tag.div(class: "rounded-lg border border-gray-200 p-3", &block)
    end
  end
%>
<% if listing || link.outside? %>
  <div class="border border-gray-200 rounded-lg overflow-hidden bg-white">
    <%= render "shared/section_heading", padding: "px-4 py-3", title: "Tickets" do %>
      <%= render "shared/pro_marker" %>
    <% end %>
    <%# Two halves, like the Money box's tiles: how it's selling on the left,
        the link on the right. %>
    <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
      <% if listing %>
        <%
          stats = Ticketing::ListingStats.of(listing)
          label, classes = ticket_listing_status_badge(listing, stats.inventory)
        %>
        <%
          # Every ticket sold, here and on other sites, of the seats there are
          # to sell once comps are set aside, the way a producer reads the
          # night (Tim, 2026-10-10: Clay saw only CocoScout's count). Where
          # another site sold too, a line per place with its money.
          by_site = stats.outside_by_site
          places = by_site.any? ? [ [ "CocoScout", stats.paid_sold, stats.gross_cents ] ] + by_site : []
          sales_cents = stats.gross_cents + by_site.sum { |_, _, cents| cents }
        %>
        <%= tile.call(manage_ticket_listing_path(listing), can_manage_ticketing) do %>
          <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Tickets sold</div>
          <div class="mt-1 text-lg font-semibold text-gray-900 tabular-nums">
            <%= stats.sold_anywhere %><% if stats.seats_to_sell %> <span class="text-sm font-normal text-gray-500">of <%= stats.seats_to_sell %></span><% end %> sold<% if stats.comps.positive? %><span class="text-sm font-normal text-gray-500"> · <%= pluralize(stats.comps, "comp") %></span><% end %>
          </div>
          <% if places.any? %>
            <ul class="mt-1 space-y-0.5 text-xs text-gray-600" data-ticket-places>
              <% places.each do |name, count, cents| %>
                <li class="flex items-baseline justify-between gap-3 tabular-nums">
                  <span class="min-w-0 truncate"><%= count %> on <%= name %></span>
                  <% if cents.positive? %><span class="flex-shrink-0 text-gray-500"><%= number_to_currency(cents / 100.0) %></span><% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
          <div class="text-xs text-gray-500 mt-1.5 flex items-center gap-2">
            <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium <%= classes %>"><%= label %></span>
            <span class="tabular-nums"><%= number_to_currency(sales_cents / 100.0) %> in sales</span>
          </div>
        <% end %>
      <% else %>
        <div class="rounded-lg border border-gray-200 p-3">
          <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Sold on <%= link.site || "another site" %></div>
          <div class="text-xs text-gray-500 mt-1"><%= show.tickets_override? ? "This date's own link" : "The production's link" %></div>
        </div>
      <% end %>

      <% if link.url.present? %>
        <div class="min-w-0">
          <%= render "shared/copy_url", url: link.url, layout: :tile, label: "Ticket link", show_qr: true, qr_title: "Scan for tickets" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
