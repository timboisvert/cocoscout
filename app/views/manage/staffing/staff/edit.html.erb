<% content_for :title, "Edit #{@staff_member.display_name}" %>
<% person = @staff_member.person %>
<% headshot = person.respond_to?(:safe_headshot_variant) ? person.safe_headshot_variant(:thumb) : nil %>
<% onboarding = @staff_member.onboarding_state.presence || "added" %>
<% preview = StaffOnboardingInviter.preview(staff_member: @staff_member) %>
<%# Staff members added before the employment fields existed only have a name on
    the Person. Fall back to splitting that so both name fields prefill. %>
<% name_parts = person.name.to_s.strip.split %>
<% legal_first = @staff_member.first_name.presence || name_parts.first %>
<% legal_last = @staff_member.last_name.presence || name_parts.drop(1).join(" ").presence %>

<div class="w-full mb-10" data-controller="invite-preview staff-edit">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ ["Staffing", manage_staffing_index_path] ],
    text: "Edit #{@staff_member.display_name}",
    links: []
  } %>

  <div class="max-w-4xl mx-auto bg-white rounded-xl border border-gray-200 shadow-sm mt-4">
    <%# ---- Header ---- %>
    <div class="flex items-center gap-5 px-8 py-6 border-b border-gray-200">
      <% if headshot %>
        <%= image_tag headshot, alt: person.name, class: "w-16 h-16 rounded-lg object-cover flex-shrink-0" %>
      <% else %>
        <div class="w-16 h-16 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-xl flex-shrink-0"><%= person.initials %></div>
      <% end %>
      <div class="flex-1 min-w-0">
        <div class="text-2xl font-bold text-gray-900 truncate coustard-regular"><%= @staff_member.display_name %></div>
        <div class="text-sm text-gray-500 truncate mt-0.5">
          <% job_line = [ @staff_member.title.presence, @staff_member.department.presence ].compact.join(" · ") %>
          <%= job_line.presence || person.email %>
        </div>
      </div>
      <% if onboarding == "completed" %>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-medium flex-shrink-0">Onboarded</span>
      <% elsif onboarding == "invited" %>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-amber-100 text-amber-700 text-xs font-medium flex-shrink-0">Invited</span>
      <% else %>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-gray-200 text-gray-600 text-xs font-medium flex-shrink-0">Not invited</span>
      <% end %>
    </div>

    <%# ---- Tabs ---- %>
    <div class="flex gap-1 px-8 border-b border-gray-200 overflow-x-auto">
      <% [ [ "details", "Details" ], [ "job", "Job" ], [ "roles", "Roles &amp; pay" ], [ "onboarding", "Onboarding" ], [ "danger", "Danger Zone" ] ].each do |key, label| %>
        <button type="button" data-staff-edit-target="tab" data-tab="<%= key %>" data-action="click->staff-edit#switch"
                class="px-4 py-3.5 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 cursor-pointer whitespace-nowrap">
          <%= label.html_safe %>
        </button>
      <% end %>
    </div>

    <div class="px-8 py-8">
      <%= form_with url: manage_update_staffing_staff_path(@staff_member), method: :patch do %>
        <%# --- Details --- %>
        <div data-staff-edit-target="panel" data-panel="details" class="space-y-5">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">Name</h2>
            <p class="text-sm text-gray-500 mt-0.5">Their legal name, and the preferred name we show everywhere.</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Legal name</label>
            <div class="grid grid-cols-1 sm:grid-cols-6 gap-5">
              <div class="sm:col-span-3">
                <label class="block text-xs font-medium text-gray-500 mb-1">First name</label>
                <%= text_field_tag :first_name, legal_first, class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
              </div>
              <div class="sm:col-span-1">
                <label class="block text-xs font-medium text-gray-500 mb-1">M.I.</label>
                <%= text_field_tag :middle_initial, @staff_member.middle_initial, maxlength: 1, class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
              </div>
              <div class="sm:col-span-2">
                <label class="block text-xs font-medium text-gray-500 mb-1">Last name</label>
                <%= text_field_tag :last_name, legal_last, class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
              </div>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Preferred first name</label>
            <%= text_field_tag :preferred_first_name, @staff_member.preferred_first_name, placeholder: "If different from their legal first name", class: "block w-full max-w-sm px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
            <p class="mt-1 text-xs text-gray-500">This is what we show for them everywhere in staffing.</p>
          </div>
          <% if person.email.present? %>
            <div class="rounded-lg bg-gray-50 border border-gray-200 p-3 text-sm text-gray-600">
              Linked to CocoScout account <span class="font-medium text-gray-900"><%= person.email %></span>.
            </div>
          <% end %>
        </div>

        <%# --- Job --- %>
        <div data-staff-edit-target="panel" data-panel="job" class="hidden space-y-5">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">Their job</h2>
            <p class="text-sm text-gray-500 mt-0.5">Title, department, who they report to, and when they started.</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
              <%= text_field_tag :title, @staff_member.title, placeholder: "e.g. Bartender", class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Department</label>
              <%= render "manage/staffing/department_field", departments: @departments, selected: @staff_member.department %>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Reports to</label>
            <%= render "manage/staffing/manager_picker", staff: @managers, selected: @staff_member.manager, exclude_id: @staff_member.id %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Start date</label>
            <%= date_field_tag :start_date, @staff_member.start_date, class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
          </div>
        </div>

        <%# --- Roles & pay --- %>
        <div data-staff-edit-target="panel" data-panel="roles" class="hidden space-y-5">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">Roles &amp; pay</h2>
            <p class="text-sm text-gray-500 mt-0.5">The roles they can work and the hourly rate for each.</p>
          </div>
          <% role_rates = @staff_member.staff_role_qualifications.each_with_object({}) { |q, h| h[q.house_role_id] = q.hourly_rate_dollars } %>
          <%# Sentinel so this form ALWAYS submits house_role_ids — lets "uncheck all" clear roles, %>
          <%# and lets the controller tell a full save apart from a partial (exempt-toggle) save. %>
          <%= hidden_field_tag "house_role_ids[]", "" %>
          <%= render "manage/staffing/roles_field", house_roles: @house_roles,
                assigned_ids: @staff_member.house_role_ids,
                role_rates: role_rates %>
        </div>

        <div data-staff-edit-target="saveFooter" class="flex items-center justify-end gap-3 pt-5 mt-5 border-t border-gray-200">
          <%= link_to "Cancel", manage_staffing_index_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
          <%= render "shared/button", text: "Save changes", variant: "primary", size: "medium", type: :submit %>
        </div>
      <% end %>

      <%# --- Onboarding (own actions, outside the edit form) --- %>
      <div data-staff-edit-target="panel" data-panel="onboarding" class="hidden space-y-5">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">Onboarding</h2>
          <p class="text-sm text-gray-500 mt-0.5">Where <%= @staff_member.display_name %> is in getting set up.</p>
        </div>
        <div class="rounded-lg bg-gray-50 border border-gray-200 p-4 space-y-3">
          <% if onboarding == "completed" %>
            <p class="text-sm text-gray-700">✅ <span class="font-medium">Onboarded.</span> <%= @staff_member.display_name %> has created their account and set up how they get paid.</p>
          <% elsif onboarding == "invited" %>
            <p class="text-sm text-gray-700"><span class="font-medium">Invited.</span> We've emailed and messaged <%= @staff_member.display_name %> to complete onboarding — we're waiting on them to finish.</p>
          <% else %>
            <p class="text-sm text-gray-700"><span class="font-medium">Not invited yet.</span> Send the onboarding invite whenever you're ready.</p>
          <% end %>

          <%# Send/resend the invite — only while they still have onboarding to finish;
              no point resending to someone who's already fully onboarded. %>
          <% if onboarding != "completed" && (person.email.present? || @staff_member.personal_email.present?) %>
            <%= render "shared/button",
                  text: (onboarding == "added" ? "Send onboarding invite" : "Resend onboarding invite"),
                  variant: "primary", size: "small", icon: "paper-airplane", type: :button,
                  data: {
                    action: "click->invite-preview#open",
                    "invite-path": manage_invite_staffing_staff_path(@staff_member),
                    "to-name": person.name,
                    "to-email": preview[:to_email],
                    "email-subject": preview[:subject],
                    "email-body": preview[:body]
                  } %>
          <% end %>
        </div>

        <%# Staff agreement — requirement-aware status + per-person exempt toggle. %>
        <% required_agreement = @staff_member.required_agreement_template %>
        <% signed_agreement = @staff_member.staff_agreement_template %>
        <% if required_agreement || @staff_member.effective_agreement_template %>
          <div class="rounded-lg border border-gray-200 p-4 space-y-3">
            <div class="flex items-start gap-3">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900">Staff agreement</p>
                <% if required_agreement %>
                  <p class="text-sm text-gray-600 mt-0.5">Required: <span class="font-medium text-gray-900"><%= required_agreement.name %></span> (current version <%= required_agreement.version %>).</p>
                <% else %>
                  <p class="text-sm text-gray-600 mt-0.5">Optional — this organization doesn't require a signed agreement.</p>
                <% end %>
                <% if @staff_member.agreed_to_agreement? %>
                  <p class="text-sm text-gray-600 mt-0.5">Signed <span class="font-medium text-gray-900"><%= signed_agreement&.name %></span> (version <%= @staff_member.agreed_agreement_version %>).</p>
                <% end %>
              </div>
              <% if @staff_member.agreement_exempt? %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 text-xs font-medium flex-shrink-0">Exempt</span>
              <% elsif required_agreement.nil? %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full <%= @staff_member.agreed_to_agreement? ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600" %> text-xs font-medium flex-shrink-0"><%= @staff_member.agreed_to_agreement? ? "Signed" : "Pending" %></span>
              <% elsif @staff_member.signed_required_agreement? %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-medium flex-shrink-0">Signed</span>
              <% elsif @staff_member.agreed_to_agreement? %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-amber-100 text-amber-700 text-xs font-medium flex-shrink-0">Older version</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-amber-100 text-amber-700 text-xs font-medium flex-shrink-0">Needs to sign</span>
              <% end %>
            </div>

            <%# Exempt toggle — its own tiny form (the edit form closed above); auto-submits on change. %>
            <% if required_agreement %>
              <%= form_with url: manage_update_staffing_staff_path(@staff_member), method: :patch, class: "flex items-center gap-2 pt-3 border-t border-gray-100" do %>
                <%= hidden_field_tag :agreement_exempt, "0" %>
                <%= check_box_tag :agreement_exempt, "1", @staff_member.agreement_exempt?, id: "agreement_exempt_toggle",
                      class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500",
                      onchange: "this.form.requestSubmit()" %>
                <label for="agreement_exempt_toggle" class="text-sm text-gray-700 cursor-pointer">This person doesn't need to sign the staff agreement.</label>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# --- Status (mark inactive / reactivate — reversible, not a delete) --- %>
      <div data-staff-edit-target="panel" data-panel="danger" class="hidden">
        <% if @staff_member.inactive? %>
          <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
            <h3 class="text-sm font-semibold text-gray-800 mb-1">Inactive</h3>
            <p class="text-sm text-gray-600 mb-4"><%= @staff_member.display_name %> is marked inactive — kept in your records with all their history, but not scheduled, paid, counted, or asked for availability. Reactivating restores everything: roles, rates, and manager stay exactly as they were.</p>
            <%= button_to manage_reactivate_staffing_staff_path(@staff_member), method: :post, class: "inline-block" do %>
              <%= render "shared/button", text: "Reactivate", variant: "primary", size: "small", type: :submit %>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
            <h3 class="text-sm font-semibold text-gray-800 mb-1">Mark inactive</h3>
            <p class="text-sm text-gray-600 mb-4">For staff who won't be working for a while: <%= @staff_member.display_name %> stays in your system with all their history, but they drop out of scheduling, the pay grid, staffing counts, and availability prompts. Fully reversible — reactivate anytime.</p>
            <% remove_staff_cid = "confirm-remove-staff-#{@staff_member.id}" %>
            <%= render "shared/button", text: "Mark inactive", variant: "primary", size: "small", type: :button,
                  data: { controller: "modal", action: "click->modal#open", modal_id: remove_staff_cid } %>
            <%= render "shared/confirm_modal", id: remove_staff_cid,
                  title: "Mark #{@staff_member.display_name} inactive?",
                  message: "They'll keep their history and can be reactivated anytime. Heads up: any shifts they're already assigned to stay assigned — unassign those on the schedule if needed.",
                  confirm_text: "Mark inactive",
                  url: manage_destroy_staffing_staff_path(@staff_member), method: :delete %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Manage-departments / manage-roles modals, deferred here so they sit
      OUTSIDE the edit form above (their own forms can't be nested). %>
  <%= yield :staffing_modals %>
  <%= render "manage/staffing/invite_preview_modal" %>
</div>
