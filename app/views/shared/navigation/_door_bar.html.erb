<%# "Work the door", the black bar under the talent menu (black since V1.1;
    the pink bar is the mode switch, Tim 2026-10-20) (Tim, 2026-10-17: the
    Door is never a menu item; it's this bar, on the website as in the app),
    only while a show the person can work is on (NavigationHelper#door_bar_item).
    Locals: item (from door_bar_item), size (:sidebar or :mobile). %>
<% sidebar = local_assigns[:size] != :mobile %>
<%= link_to item[:path], class: "block rounded-lg bg-gray-900 text-white hover:bg-black transition-colors #{sidebar ? 'mx-3 mt-4 px-4 py-3' : 'mt-5 px-4 py-4'}", data: { door_bar: true } do %>
  <div class="flex items-center gap-3">
    <svg class="<%= sidebar ? 'w-5 h-5' : 'w-6 h-6' %> flex-shrink-0 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 6.75h.75v.75h-.75v-.75ZM6.75 16.5h.75v.75h-.75v-.75ZM16.5 6.75h.75v.75h-.75v-.75ZM13.5 13.5h.75v.75h-.75v-.75ZM13.5 19.5h.75v.75h-.75v-.75ZM19.5 13.5h.75v.75h-.75v-.75ZM19.5 19.5h.75v.75h-.75v-.75ZM16.5 16.5h.75v.75h-.75v-.75Z" />
    </svg>
    <div class="min-w-0">
      <div class="<%= sidebar ? 'text-sm' : 'text-base' %> font-semibold leading-tight"><%= item[:title] %></div>
      <div class="text-xs text-gray-300 truncate"><%= item[:subtitle] %></div>
    </div>
  </div>
<% end %>
