<div class="words">
  <%= raw @body_html %>
</div>
<% if @shows.any? %>
  <div style="padding:6px 22px 10px">
    <% @shows.each do |show| %>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e5e7eb;border-radius:8px;margin:0 0 12px">
        <tr>
          <td width="84" valign="top" style="padding:10px">
            <% if show[:poster_url] %>
              <img src="<%= show[:poster_url] %>" alt="" width="72" style="width:72px;height:96px;object-fit:cover;border-radius:6px;display:block" />
            <% else %>
              <div style="width:72px;height:96px;border-radius:6px;background-color:#fce7f3;color:#be185d;font-weight:800;font-size:16px;line-height:96px;text-align:center"><%= show[:initials] %></div>
            <% end %>
          </td>
          <td valign="top" style="padding:10px 12px 10px 2px">
            <div style="font-weight:700;font-size:15px;color:#111827"><%= show[:title] %></div>
            <div style="font-size:13px;color:#6b7280"><%= show[:when] %><%= " · #{show[:place]}" if show[:place].present? %></div>
            <% if show[:url] %>
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:10px"><tr>
                <td style="background-color:<%= @accent %>;border-radius:4px"><a href="<%= show[:url] %>" style="display:inline-block;padding:8px 16px;color:#ffffff;font-weight:600;font-size:14px;text-decoration:none">Buy tickets</a></td>
              </tr></table>
            <% end %>
          </td>
        </tr>
      </table>
    <% end %>
  </div>
<% end %>
