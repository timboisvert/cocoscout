<% content_for :title, "Staffing Settings" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Staffing", manage_staffing_index_path]
    ],
    text: "Settings"
  } %>

  <div class="space-y-4 mt-4">
    <div class="bg-white border border-gray-200 rounded-xl p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-gray-900 mb-1">Staff agreements</h2>
          <p class="text-sm text-gray-600">Reusable agreement wording your staff accept during onboarding — keep as many as you need (e.g. an employee agreement and a contractor agreement). Each staff member sees it with the <code class="bg-gray-100 px-1 rounded text-xs">{{merge fields}}</code> filled in from their own details.</p>
        </div>
        <%= link_to manage_new_staffing_agreement_template_path, class: "shrink-0" do %>
          <%= render "shared/button", text: "New Agreement", variant: "primary", size: "small", icon: "plus" %>
        <% end %>
      </div>

      <%# Require signing: pick which agreement staff must sign (blank = optional). %>
      <% active_templates = @agreement_templates.select(&:active?) %>
      <% if active_templates.any? %>
        <div class="mt-5 pt-5 border-t border-gray-200">
          <%= form_with url: manage_staffing_settings_path, method: :patch, class: "flex flex-wrap items-end gap-3" do %>
            <div class="flex-1 min-w-[16rem]">
              <label for="required_staff_agreement_template_id" class="block text-sm font-medium text-gray-700 mb-1">Require staff to sign an agreement</label>
              <p class="text-xs text-gray-500 mb-2">Everyone on staff must sign the agreement you choose before they can keep working — you can exempt individuals on their staff page.</p>
              <% options = [ [ "Not required — optional", "" ] ] + active_templates.map { |t| [ "#{t.name} (v#{t.version})", t.id ] } %>
              <%= select_tag :required_staff_agreement_template_id,
                    options_for_select(options, Current.organization.required_staff_agreement_template_id),
                    class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
            </div>
            <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @agreement_templates.any? %>
      <div class="space-y-2">
        <% @agreement_templates.each do |template| %>
          <%= link_to manage_edit_staffing_agreement_template_path(template), class: "block bg-white rounded-lg border border-gray-200 p-5 hover:bg-gray-50 transition-colors" do %>
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <h3 class="font-semibold text-gray-900"><%= template.name %></h3>
                  <% if Current.organization.required_staff_agreement_template_id == template.id %>
                    <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium bg-pink-100 text-pink-700">Required</span>
                  <% end %>
                  <% unless template.active? %>
                    <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-600">Inactive</span>
                  <% end %>
                  <span class="text-xs text-gray-500">Version <%= template.version %></span>
                </div>
                <% if template.description.present? %>
                  <p class="text-sm text-gray-600 mt-1"><%= template.description %></p>
                <% end %>
                <div class="flex items-center gap-4 mt-2 text-sm text-gray-500">
                  <% if template.required_for_org? %>
                    <% sum = template.signing_summary %>
                    <% if sum[:pending].zero? %>
                      <span class="text-green-700 font-medium">Everyone's signed</span>
                    <% else %>
                      <span class="text-amber-700 font-medium"><%= sum[:pending] %> still to sign</span>
                    <% end %>
                    <span><%= sum[:signed] %> signed<% if sum[:exempt] > 0 %> · <%= sum[:exempt] %> exempt<% end %></span>
                  <% else %>
                    <% signers = template.applicable_staff_members.size %>
                    <span><%= signers %> <%= "staff member".pluralize(signers) %> signed</span>
                  <% end %>
                  <span>Updated <%= time_ago_in_words(template.updated_at) %> ago</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="bg-gray-50 rounded-lg border border-dashed border-gray-300 p-8 text-center">
        <svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No staff agreements yet</h3>
        <p class="text-gray-600 mb-4">Create one so new staff can review and accept it when they onboard.</p>
        <%= link_to manage_new_staffing_agreement_template_path do %>
          <%= render "shared/button", text: "Create Agreement", variant: "primary", size: "medium" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
