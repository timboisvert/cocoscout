<%# One day on Staffing → Availability, loaded into the page's day modal:
    everyone, grouped by whether they can work, with their hours and their
    shifts that day. Each name opens that person's Availability tab. %>
<turbo-frame id="staff-availability-day">
  <%
    sections = [
      [ :all_day, "Can work all day", "text-green-700" ],
      [ :part, "Part of the day", "text-amber-700" ],
      [ :unknown, "Hasn't said", "text-gray-500" ],
      [ :off, "Can't work", "text-gray-500" ]
    ]
  %>
  <div class="px-6 py-4 max-h-[70vh] overflow-y-auto space-y-5">
    <% if @role %>
      <p class="text-xs text-gray-500">Showing <span class="font-medium text-gray-700"><%= @role.name %></span> staff.</p>
    <% end %>
    <% sections.each do |key, heading, tone| %>
      <% rows = @groups[key] %>
      <% next if rows.empty? %>
      <section>
        <h4 class="text-xs font-semibold uppercase tracking-wide <%= tone %> mb-2"><%= heading %> <span class="text-gray-400 font-normal">(<%= rows.size %>)</span></h4>
        <ul class="divide-y divide-gray-100 border border-gray-200 rounded-lg">
          <% rows.each do |row| %>
            <% member = row[:member] %>
            <% person = member.person %>
            <% variant = person&.safe_headshot_variant(:thumb) %>
            <li>
              <%= link_to manage_edit_staffing_staff_path(member, anchor: "availability"), data: { turbo_frame: "_top" },
                    class: "flex items-center gap-3 px-3 py-2 hover:bg-gray-50" do %>
                <% if variant %>
                  <%= image_tag variant, alt: member.display_name, class: "w-8 h-8 rounded-lg object-cover flex-shrink-0" %>
                <% else %>
                  <span class="w-8 h-8 rounded-lg bg-gray-200 flex items-center justify-center text-[10px] font-bold text-gray-600 flex-shrink-0"><%= person&.initials %></span>
                <% end %>
                <span class="flex-1 min-w-0">
                  <span class="block text-sm font-medium text-gray-900 truncate"><%= staff_name_with_pronouns(member) %></span>
                  <% if key == :part %>
                    <span class="block text-xs text-amber-700"><%= WorkAvailabilityPicture.windows_label(row[:day].windows) %></span>
                  <% end %>
                  <% if row[:shifts].any? %>
                    <span class="block text-xs text-gray-500 truncate">
                      Working <%= row[:shifts].map { |s| "#{s.house_role&.name} #{StaffAvailabilityWording.windows([ [ s.starts_at, s.ends_at ] ])}" }.join(", ") %>
                    </span>
                  <% end %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
    <% if @groups.values.all?(&:empty?) %>
      <p class="py-6 text-center text-sm text-gray-500">No active staff<%= " in this role" if @role %>.</p>
    <% end %>
  </div>
</turbo-frame>
