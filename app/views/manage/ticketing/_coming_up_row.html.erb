<%# A production's next date on Ticketing home (Tim, 2026-10-16: the rows were
    cluttered): when, what, how it's selling, its sales status only when it
    isn't plainly on sale, and Work the door while that show's door is open.
    The title over its time, how it's selling and the button beside them
    from sm up; stacked on a phone. Locals: listing, stats. %>
<%
  starts = listing.show.date_and_time
  when_words = starts.to_date == Date.current ? "Tonight · #{starts.strftime('%-l:%M %p')}" : starts.strftime("%a, %b %-d · %-l:%M %p")
  label, badge_classes = ticket_listing_status_badge(listing, stats.inventory)
  door_open = DoorTonight.door_open?(listing)
%>
<div class="bg-white border border-gray-200 rounded-lg px-4 py-3 sm:px-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
  <div class="flex items-start justify-between gap-3 sm:flex-1 sm:min-w-0 sm:items-center">
    <%= link_to manage_ticket_listing_path(listing), class: "min-w-0 group" do %>
      <span class="block text-sm text-gray-500"><%= when_words %></span>
      <span class="block text-[15px] font-semibold text-gray-900 truncate group-hover:text-pink-700"><%= listing.display_title %></span>
    <% end %>
    <span class="flex-shrink-0 text-right text-sm text-gray-700 tabular-nums whitespace-nowrap">
      <%= stats.sold_words %>
      <% unless label == "On sale" %><span class="block text-xs font-medium <%= badge_classes[/text-\S+/] %>"><%= label %></span><% end %>
    </span>
  </div>
  <% if door_open %>
    <div class="sm:flex-shrink-0">
      <%= render "shared/button", text: "Work the door", variant: "primary", size: "small", path: door_path(listing) %>
    </div>
  <% end %>
</div>
