<% content_for :title, "Join #{@team_invitation.organization.name}" %>
<%
  # An invitation onto an organization's team (managers), a production's
  # team, or a contract (a contract person, docs/contract_people_plan.md).
  # @existing_user is the User with this email, if there is one: they sign
  # in; anyone else chooses a password and the account is created.
  inv = @team_invitation
  org = inv.organization
  existing = @existing_user.present?
  profile = inv.person
  onto_contract = inv.contract_invite?
%>
<% strip = capture do %>
  <%= render layout: "shared/auth/strip", locals: { image: (org.logo if org.logo.attached?), initial: org.name } do %>
    <% if onto_contract %>
      <strong class="font-semibold text-slate-900"><%= org.name %></strong> put you on <%= inv.contract.contractor_name %>'s contract with them, on CocoScout.
    <% else %>
      <strong class="font-semibold text-slate-900"><%= org.name %></strong> invited you to their team on CocoScout.
    <% end %>
  <% end %>
<% end %>
<% notices = capture do %>
  <% if @authentication_error %>
    <%= render layout: "shared/auth/notice", locals: { kind: :error } do %>
      That password didn't match. Try again, or <%= link_to "reset your password", password_path, class: "font-semibold underline" %>.
    <% end %>
  <% elsif @user&.errors&.any? %>
    <%= render "shared/auth/notice", kind: :error, title: "That password didn't work.", body: @user.errors.full_messages.to_sentence + "." %>
  <% end %>
<% end %>
<%
  title = existing ? (onto_contract ? "Sign in to see the contract" : "Sign in to join the team") : "Choose your password"
  lede = if onto_contract && existing
    "Enter the password for #{inv.email} and you're on the contract: its dates, how tickets are selling, who's coming and what it pays, on your My pages."
  elsif onto_contract
    "You're on #{inv.contract.contractor_name}'s contract with #{org.name}. Pick a password and you'll see its dates, how tickets are selling, who's coming and what it pays."
  elsif existing
    "Enter the password for #{inv.email} and you're on #{org.name}'s team: their productions, casting and scheduling, yours to work on too."
  else
    "#{org.name} set you up as part of their team. Pick a password and you're in; their productions, casting and scheduling are yours to work on too."
  end
%>

<%= render layout: "shared/auth/shell", locals: { title: title, lede: lede, strip: strip, notices: notices, legal: "joining" } do %>
  <%= form_with url: do_accept_manage_team_invitations_path(token: inv.token), method: :post, local: true, class: "space-y-4",
        data: (existing ? {} : { controller: "password-strength" }) do |form| %>
    <%= render "shared/auth/account_row", email: inv.email %>

    <% if profile.present? %>
      <div>
        <div class="mb-1.5 block text-sm font-medium text-slate-700">Profile being added</div>
        <div class="flex items-center gap-3 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5">
          <% headshot = profile.safe_headshot_variant(:thumb) %>
          <% if headshot %>
            <%= image_tag headshot, alt: profile.name, class: "h-10 w-10 rounded-lg object-cover" %>
          <% else %>
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gray-200 text-sm font-bold text-gray-600"><%= profile.initials %></div>
          <% end %>
          <div class="min-w-0">
            <div class="truncate font-medium text-slate-900"><%= profile.name %></div>
            <% if profile.organizations.any? %>
              <div class="truncate text-xs text-slate-500">Also in: <%= profile.organizations.pluck(:name).join(", ") %></div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if existing %>
      <%= render "shared/auth/password_field", form: form, autocomplete: "current-password", error: @authentication_error.present? %>
      <div class="pt-1">
        <%= render "shared/button", text: "Join #{org.name}", variant: "primary", size: "jumbo", type: :submit %>
      </div>
    <% else %>
      <%= render "shared/auth/password_field", form: form, strength: true, autocomplete: "new-password",
            error: @user&.errors&.[](:password)&.any? || false %>
      <div class="pt-1">
        <%= render "shared/button",
            text: "Join #{org.name}",
            variant: "primary",
            size: "jumbo",
            type: :submit,
            disabled: true,
            classes: "!opacity-50 !cursor-not-allowed",
            data: { password_strength_target: "submit" } %>
      </div>
    <% end %>
  <% end %>

  <% if existing %>
    <div class="border-t border-slate-200 pt-4 text-center text-sm leading-[1.8] text-slate-600">
      Forgot your password? <%= link_to "Reset it", password_path, class: "font-medium text-pink-600 hover:text-pink-700" %>
    </div>
  <% end %>
<% end %>
