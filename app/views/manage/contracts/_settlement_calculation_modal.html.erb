<%#
  View calculation (Tim, 2026-11-13): how a contract show's pay gets to its
  number, all of it, without leaving the page: each settlement's working
  (ContractSettlementWorking), then any payment that's simply an amount.
  Reading only; the contract is a link from here for changing anything.

  Locals: id, title, workings, other_payments (payments with no working),
          contract
%>
<div id="<%= id %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end justify-center sm:items-center sm:p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full max-w-xl overflow-hidden flex flex-col max-h-[92vh] sm:max-h-[85vh]" data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-5 sm:px-6 py-4 flex-shrink-0">
      <h3 class="text-lg font-semibold text-white"><%= title %></h3>
      <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="px-5 sm:px-6 py-5 space-y-5 overflow-y-auto min-h-0">
      <% if contract %>
        <p class="text-sm text-gray-600">
          <span class="font-medium text-gray-900"><%= contract.contractor_name %>.</span>
          <%= contract.respond_to?(:settlement_cadence_label) ? "Settled: #{contract.settlement_cadence_label.downcase_first}." : "" %>
        </p>
      <% end %>
      <% workings.each do |working| %>
        <div>
          <div class="text-sm font-semibold text-gray-900"><%= working.title %></div>
          <div class="text-xs text-gray-500 mb-2">
            <%= working.shows.map { |s| s.date_and_time.strftime("%a %b %-d") }.to_sentence.presence || "No shows on it yet" %>
          </div>
          <%= render "manage/contracts/settlement_working", working: working %>
        </div>
      <% end %>
      <% other_payments.each do |payment| %>
        <div class="flex items-baseline justify-between gap-3 text-sm">
          <span class="min-w-0 text-gray-600"><%= payment.display_name %><%= payment.due_date ? ", due #{payment.due_date.strftime('%b %-d')}" : "" %></span>
          <span class="tabular-nums font-semibold text-gray-900 whitespace-nowrap"><%= number_to_currency(payment.amount) %></span>
        </div>
      <% end %>
      <% if workings.empty? && other_payments.empty? %>
        <p class="text-sm text-gray-600">The contract has no payment for this show yet.</p>
      <% end %>
    </div>
    <div class="flex items-center justify-between gap-3 px-5 sm:px-6 py-4 border-t border-gray-200 flex-shrink-0">
      <% if contract %>
        <%= link_to manage_contract_path(contract) do %>
          <%= render "shared/button", text: "Open the contract", variant: "secondary", size: "small", type: :button %>
        <% end %>
      <% else %>
        <span></span>
      <% end %>
      <%= render "shared/button", text: "Close", variant: "primary", size: "small", type: :button, data: { action: "click->modal#close" } %>
    </div>
  </div>
</div>
