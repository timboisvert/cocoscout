<% content_for :title, "Cancel #{@listing.display_title}" %>
<%
  d = @draft
  show = @listing.show
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  sample = d.orders.first
  sample_quote = sample && TicketOrderRefund.quote(sample)
  sample_vars = sample && TicketOrderMailer.variables_for(sample, amount_cents: sample_quote.amount_cents, ticket_count: sample_quote.tickets.size)
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Ticketing", manage_ticketing_path ], [ "Shows on sale", manage_ticket_listings_path ], [ @listing.display_title, manage_edit_ticket_listing_path(@listing) ] ],
    text: "Cancel this show",
    links: []
  } %>

  <%= form_with url: manage_ticket_listing_cancel_path(@listing), method: :post, id: "cancel-listing-form", class: "max-w-2xl space-y-6" do %>
    <div class="bg-white border border-gray-200 rounded-xl px-6 py-5">
      <h2 class="text-lg font-semibold text-gray-900"><%= @listing.display_title %> · <%= show.date_and_time.strftime("%A, %B %-d · %-l:%M %p") %></h2>
      <p class="text-sm text-gray-600 mt-1">
        <% if d.orders.any? %>
          Online sales stop now, and <%= pluralize(d.orders.size, "buyer") %> get everything back: <%= number_to_currency(d.refund_cents / 100.0) %> in all, price, tax and fees. It comes from what this show sold, so none of it ever reaches your balance.
        <% else %>
          Nobody has bought tickets online, so there's nothing to refund. Online sales stop now.
        <% end %>
      </p>
      <% unless show.canceled %>
        <label class="mt-4 flex items-center gap-2 text-sm text-gray-700">
          <%= check_box_tag :cancel_show, "1", true, class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
          Also cancel the show on your calendar
        </label>
      <% end %>
    </div>

    <% if d.orders.any? %>
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">The email they'll get</h2>
          <p class="text-sm text-gray-600 mt-1">Each buyer gets their own copy. Words in double braces, like {{first_name}}, are filled in for each person.</p>
        </div>
        <div class="px-6 py-5 space-y-4">
          <div>
            <label for="subject" class="block text-sm font-medium text-gray-700 mb-1.5">Subject</label>
            <%= text_field_tag :subject, d.subject, class: input_class %>
          </div>
          <div>
            <label for="body" class="block text-sm font-medium text-gray-700 mb-1.5">Message</label>
            <%= text_area_tag :body, d.body, rows: 9, class: input_class %>
          </div>
          <% if sample_vars %>
            <div class="rounded-lg bg-gray-50 border border-gray-200 px-4 py-3 text-sm text-gray-700">
              <div class="text-xs font-medium text-gray-500 mb-1">How it reads for <%= sample.buyer_name.presence || sample.buyer_email %></div>
              <div class="font-medium text-gray-900"><%= ContentTemplate.interpolate(d.subject, sample_vars) %></div>
              <div class="mt-1"><%= TicketOrderMailer.paragraphs(ContentTemplate.interpolate(d.body, sample_vars)) %></div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Who gets it</h2>
        </div>
        <ul class="divide-y divide-gray-100 max-h-80 overflow-y-auto">
          <% d.orders.each do |order| %>
            <li class="flex items-center justify-between gap-4 px-6 py-2.5 text-sm">
              <span class="min-w-0 truncate text-gray-900"><%= order.buyer_name.presence || "No name" %> <span class="text-gray-500"><%= order.buyer_email.presence || "no email, refund only" %></span></span>
              <span class="tabular-nums text-gray-700"><%= number_to_currency(TicketOrderRefund.quote(order).amount_cents / 100.0) %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="flex flex-wrap gap-2">
      <%= render "shared/button", text: d.orders.any? ? "Cancel and refund everyone" : "Cancel ticket sales", variant: "primary", size: "medium", type: :button,
            data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-cancel-listing" } %>
      <%= render "shared/button", text: "Keep it on sale", variant: "secondary", size: "medium", path: manage_edit_ticket_listing_path(@listing) %>
    </div>
  <% end %>

  <div id="confirm-cancel-listing" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
       data-controller="modal" data-action="click->modal#closeOnBackdrop">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden" data-action="click->modal#stopPropagation">
      <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
        <h3 class="text-lg font-semibold text-white">Cancel this show?</h3>
        <button type="button" data-action="click->modal#close" aria-label="Close"
                class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="px-6 py-5 text-sm text-gray-600">
        <%= d.orders.any? ? "Every buyer is refunded #{number_to_currency(d.refund_cents / 100.0)} in all and gets your email. This can't be undone." : "Online sales stop. You can't reopen a canceled show." %>
      </div>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
        <%= render "shared/button", text: "Go back", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
        <%= render "shared/button", text: d.orders.any? ? "Cancel and refund" : "Cancel sales", variant: "primary", size: "medium", type: :submit, form_id: "cancel-listing-form" %>
      </div>
    </div>
  </div>
</div>
