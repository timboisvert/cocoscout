<%#
  Pay tab on the production edit page: are performers paid for this
  production, and which payout calculation do its shows start from? "Paid" is
  a production-level default on the calculation (PayoutSchemeDefault effective
  from today); "not paid" clears this production's defaults. Pro only — a free
  org sees the same card locked. NOTE: keep ERB tags out of this comment.

  Locals:
    production (required)
%>
<%
  organization = production.organization
  money_available = organization.feature_available?(:money)
  current_calculation = money_available ? PayoutScheme.current_default_for_production(production) : nil
  performers_paid = current_calculation.present?
  calculations = money_available ? organization.payout_schemes.active.order(:name).to_a : []
  # With no production default, what would a show tonight fall back to?
  org_fallback = (money_available && !performers_paid) ? PayoutScheme.default_for_show(Show.new(production: production, date_and_time: Time.current)) : nil
  needs_per_act_nudge = money_available && production.act_based? && !PayoutScheme.per_act_scheme_exists_for?(organization)
  shows_using_current = current_calculation ? ShowPayout.where(payout_scheme: current_calculation, show: production.shows).count : 0
  return_to = edit_manage_production_path(production, anchor: "tab-6")
  create_path = manage_money_payout_calculation_wizard_start_path(production_id: production.id, return_to: return_to)
  picker_id = "pick-calculation"
%>

<div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6" data-pay-tab>
  <%= render "shared/card_header", title: "Performer pay" do %>
    <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wide text-pink-600 bg-pink-50 border border-pink-200 rounded px-1.5 py-0.5 leading-none">
      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
      Pro feature
    </span>
  <% end %>
  <div class="p-6">
    <% if money_available %>
      <%= form_with url: update_pay_manage_production_path(production), method: :patch, local: true,
            data: { controller: "toggle-section" } do |form| %>
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-medium text-gray-900">Performers are paid for this production</p>
            <p class="text-sm text-gray-500 mt-1">A payout calculation decides how each show's money is split among the people cast in it. Every show starts from the production's calculation; you can still change or override it show by show in Money.</p>
          </div>
          <%= render "shared/toggle_switch", form: form, field: :performers_paid, checked: performers_paid,
                data: { toggle_section_target: "toggle", action: "change->toggle-section#toggle" } %>
        </div>

        <div data-toggle-section-target="content" class="<%= performers_paid ? '' : 'hidden' %> mt-5 ml-4 pl-4 border-l-2 border-pink-200 space-y-4">
          <% if current_calculation %>
            <%# Saving with the toggle left on keeps the current calculation. %>
            <%= hidden_field_tag :payout_scheme_id, current_calculation.id, id: nil %>
            <div class="rounded-lg border border-gray-200 bg-gray-50 p-4" data-current-calculation>
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Current calculation</p>
              <p class="mt-1 font-medium text-gray-900"><%= current_calculation.name %></p>
              <% summary = current_calculation.rules_summary %>
              <% if summary.present? %>
                <p class="mt-0.5 text-sm text-gray-600"><%= summary %></p>
              <% end %>
              <p class="mt-2 text-xs text-gray-500">
                Used by <%= pluralize(shows_using_current, "show") %> so far.
                <%= link_to "View", manage_money_payout_calculation_path(current_calculation), class: "text-pink-500 hover:text-pink-600 font-medium" %>
              </p>
            </div>
          <% else %>
            <p class="text-sm text-gray-700">No calculation chosen yet.</p>
          <% end %>

          <div class="flex flex-wrap items-center gap-2">
            <%= render "shared/button", text: (current_calculation ? "Choose a different calculation" : "Choose a calculation"), variant: "secondary", size: "small", type: :button,
                  data: { controller: "modal", action: "click->modal#open", modal_id: picker_id } %>
            <%= render "shared/button", text: "Create a new calculation", variant: "primary", size: "small", path: create_path %>
          </div>

          <% if needs_per_act_nudge %>
            <p class="text-sm text-gray-600 flex items-start gap-2">
              <svg class="w-4 h-4 text-pink-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
              </svg>
              <span>Act-based productions usually pay per act —
                <%= link_to "set up a per-act calculation", create_path, class: "text-pink-500 hover:text-pink-600 font-medium" %>.
              </span>
            </p>
          <% end %>
        </div>

        <% if !performers_paid && org_fallback %>
          <p class="mt-4 text-xs text-gray-500">
            No calculation is set for this production, so its shows fall back to your organization default, <span class="font-medium text-gray-700"><%= org_fallback.name %></span>.
          </p>
        <% end %>

        <div class="mt-6">
          <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
        </div>
      <% end %>

      <%# The picker posts its own form, so it lives outside the toggle form. %>
      <%= render "manage/payout_calculations/picker_modal",
            id: picker_id,
            url: update_pay_manage_production_path(production),
            method: :patch,
            calculations: calculations,
            current: current_calculation,
            hidden_fields: { performers_paid: "1" },
            title: "Choose a payout calculation",
            intro: "Every show of #{production.name} that hasn't been calculated yet switches to the calculation you pick.",
            confirm_text: "Use this calculation",
            create_path: create_path %>
    <% else %>
      <%# Locked: same card, Pro treatment %>
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-lg bg-pink-100 text-pink-500 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-label="Pro feature"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
        </div>
        <div class="flex-1">
          <p class="font-medium text-gray-900">Performers are paid for this production</p>
          <p class="text-sm text-gray-600 mt-1">Pro feature — performer pay, payout calculations and Stripe payouts are part of CocoScout Pro.</p>
          <div class="mt-4">
            <%= render "shared/button", text: "Upgrade to Pro", variant: "primary", size: "medium",
                  path: manage_billing_upgrade_path(feature: "money"),
                  data: { action: "click->upgrade-modal#open", upgrade_feature: "money" } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
