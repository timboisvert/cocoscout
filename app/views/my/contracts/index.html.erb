<% content_for :title, "My Contracts" %>

<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [],
    text: "My Contracts",
    links: []
  } %>

  <% if @needs_bank %>
    <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 flex flex-wrap items-center justify-between gap-3">
      <div class="text-sm text-amber-900">
        <span class="font-semibold">Connect your bank to get paid.</span>
        Payments on your contracts are sent straight to your bank account.
      </div>
      <%= render "shared/button", text: "Set up payment", variant: "primary", size: "small", path: my_payments_setup_path %>
    </div>
  <% end %>

  <% if @contracts.any? %>
    <div class="space-y-4">
      <% @contracts.each do |contract| %>
        <%
          outgoing = contract.contract_payments.select(&:direction_outgoing?)
          received = outgoing.select(&:status_paid?)
          pending = outgoing.reject(&:status_paid?)
          received_total = received.sum { |p| p.amount.to_f }
          pending_total = pending.sum { |p| p.amount.to_f }
          status_class = { "active" => "bg-green-100 text-green-700", "draft" => "bg-gray-100 text-gray-600",
                           "completed" => "bg-blue-100 text-blue-700", "cancelled" => "bg-red-100 text-red-700" }[contract.status] || "bg-gray-100 text-gray-600"
        %>
        <div class="bg-white rounded-lg border border-gray-200 p-5">
          <div class="flex items-start justify-between gap-3 mb-2">
            <div class="min-w-0">
              <h3 class="font-semibold text-gray-900"><%= contract.production_name.presence || contract.contractor_name %></h3>
              <% if contract.contract_start_date && contract.contract_end_date %>
                <p class="text-sm text-gray-500 mt-0.5"><%= contract.contract_start_date.strftime("%b %-d, %Y") %> – <%= contract.contract_end_date.strftime("%b %-d, %Y") %></p>
              <% end %>
            </div>
            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold <%= status_class %>"><%= contract.status.titleize %></span>
          </div>

          <% if outgoing.any? %>
            <div class="mt-3 flex flex-wrap gap-4 text-sm">
              <div><span class="text-gray-500">Received</span> <span class="font-semibold text-green-600"><%= number_to_currency(received_total) %></span></div>
              <% if pending_total > 0 %>
                <div><span class="text-gray-500">Upcoming</span> <span class="font-semibold text-gray-900"><%= number_to_currency(pending_total) %></span></div>
              <% end %>
            </div>
            <div class="mt-3 divide-y divide-gray-100 border-t border-gray-100">
              <% outgoing.sort_by { |p| p.due_date || Date.current }.each do |payment| %>
                <div class="flex items-center justify-between gap-3 py-2 text-sm">
                  <span class="text-gray-600 truncate"><%= payment.description.presence || "Payment" %> · <span class="text-gray-400"><%= payment.due_date&.strftime("%b %-d, %Y") %></span></span>
                  <span class="flex items-center gap-2 flex-shrink-0">
                    <span class="font-medium text-gray-900"><%= payment.amount_tbd? && payment.amount.to_f.zero? ? "TBD" : number_to_currency(payment.amount) %></span>
                    <% if payment.status_paid? %>
                      <span class="inline-flex items-center rounded-md bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Paid</span>
                    <% else %>
                      <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Scheduled</span>
                    <% end %>
                  </span>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-500 mt-2">No payments scheduled yet.</p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-gray-50 rounded-lg border border-dashed border-gray-300 p-12 text-center">
      <p class="text-gray-600">You don't have any contracts yet.</p>
      <p class="text-sm text-gray-500 mt-1">When an organization sets up a contract with you, it'll show here.</p>
    </div>
  <% end %>
</div>
