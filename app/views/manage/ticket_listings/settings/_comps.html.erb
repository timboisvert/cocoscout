<%# This date's own comp rules, or (switch off) the ones it follows: its
    production's own, else the box office's (CompRules). The one override
    control (manage/ticketing/own_switch). Locals: listing, setup. %>
<%
  own = listing.own_comps
  followed = setup&.own_comps ? setup : ticketing_profile
  rules = own ? listing : followed
  example = own ? comp_rules_sentence(listing, subject: "this date", single: true) : nil
%>
<%= form_with url: manage_ticket_listing_path(listing, section: "comps"), method: :patch do %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle" data-settings-card="comps">
    <%= render "manage/ticketing/own_switch", title: "Comps", follows: (setup&.own_comps ? listing.production.name : "your box office"), followed: followed.comp_rules_words,
          only: "this date", name: "ticket_listing[own_comps]", id: "ticket_listing_own_comps", checked: own %>
    <fieldset <%= "disabled" unless own %> data-fieldset-toggle-target="fields" class="disabled:opacity-50">
      <%= render "manage/ticketing_settings/comp_rules_fields", scope: "ticket_listing", rules: rules, bare: true,
            heading: "Giving comps", off_words: "Off, nobody gives comps on this date.", example: example %>
    </fieldset>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
    </div>
  </div>
<% end %>
