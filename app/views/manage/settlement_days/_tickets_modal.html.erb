<%# The ticket money for a show CocoScout doesn't sell, on the day's
    worksheet (Tim, 2026-11-04: the last things only the old Financials
    worksheet could do). Three ways a show takes money: tickets, by where
    they sold; a flat fee instead; or no revenue at all, which pays nobody
    and can be chosen back. A revenue-share contractor's own collections go
    with the tickets. Locals: id, show, financials, return_to %>
<%
  input = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-base sm:text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition-colors"
  radio = "h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500"
  option = "group/opt rounded-lg border border-gray-200 px-4 py-3 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50/40"
  # A row per place the organization sells tickets (Money settings), plus
  # any line already saved; with none named, a single Tickets row, seeded
  # from figures typed before sources existed.
  sources = Current.organization.ticket_sources.hand_made.active.ordered.to_a
  existing = (financials&.ticket_sales_lines || []).reject { |l| l.ticket_source&.built_in? }
  by_source = existing.group_by(&:ticket_source_id)
  rows = []
  (sources + existing.filter_map(&:ticket_source)).uniq.each do |source|
    lines = by_source.delete(source.id) || []
    if lines.empty?
      rows << { id: nil, source_id: source.id, label: source.name, tickets: nil, amount: nil }
    else
      lines.each { |l| rows << { id: l.id, source_id: source.id, label: source.name, tickets: l.tickets_sold, amount: l.amount } }
    end
  end
  (by_source.delete(nil) || []).each { |l| rows << { id: l.id, source_id: nil, label: (sources.any? ? "Other" : "Tickets"), tickets: l.tickets_sold, amount: l.amount } }
  if rows.empty?
    rows << { id: nil, source_id: nil, label: "Tickets", tickets: financials&.ticket_count, amount: financials&.ticket_revenue }
  end
  choice = if financials&.non_revenue_override? then "none"
  elsif financials&.flat_fee? then "flat_fee"
  else "ticket_sales"
  end
  production = show.production
  contract = show.space_rental&.contract || production.contract
  collects = production.type_third_party? && contract&.revenue_share?
%>
<div id="<%= id %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end justify-center sm:items-center sm:p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col max-h-[92vh] sm:max-h-[85vh]" data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-5 sm:px-6 py-4 flex-shrink-0">
      <h3 class="text-lg font-semibold text-white">Tickets, <%= show.display_name %></h3>
      <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <%= form_with url: manage_update_money_show_financials_path(show), method: :patch, class: "flex flex-col min-h-0 flex-1", data: { turbo_action: "replace" } do %>
      <%= hidden_field_tag :return_to, return_to, id: nil %>
      <div class="px-5 sm:px-6 py-5 space-y-3 overflow-y-auto min-h-0">
        <div class="<%= option %>">
          <label class="flex items-center gap-2.5 cursor-pointer text-sm font-medium text-gray-900">
            <%= radio_button_tag :revenue_choice, "ticket_sales", choice == "ticket_sales", id: nil, class: radio %>
            Tickets
          </label>
          <div class="hidden group-has-[:checked]/opt:block mt-3 space-y-3">
            <div class="border border-gray-200 rounded-lg overflow-hidden bg-white">
              <div class="grid grid-cols-[minmax(0,1fr)_5.5rem_8rem] gap-2 px-3 py-1.5 bg-gray-50 border-b border-gray-200 text-[11px] font-semibold uppercase tracking-wide text-gray-500">
                <span>Sold through</span><span class="text-right">Tickets</span><span class="text-right">Amount</span>
              </div>
              <div class="divide-y divide-gray-100">
                <% rows.each_with_index do |r, i| %>
                  <% field = "show_financials[ticket_sales_lines_attributes][#{i}]" %>
                  <div class="grid grid-cols-[minmax(0,1fr)_5.5rem_8rem] items-center gap-2 px-3 py-2">
                    <% if r[:id] %><%= hidden_field_tag "#{field}[id]", r[:id], id: nil %><% end %>
                    <%= hidden_field_tag "#{field}[ticket_source_id]", r[:source_id], id: nil %>
                    <span class="min-w-0 truncate text-sm font-medium text-gray-900"><%= r[:label] %></span>
                    <%= number_field_tag "#{field}[tickets_sold]", (r[:tickets].to_i.positive? ? r[:tickets].to_i : nil), id: nil, min: 0, placeholder: "0", "aria-label": "#{r[:label]} tickets", class: "#{input} tabular-nums text-right" %>
                    <div class="relative">
                      <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-sm text-gray-500">$</span>
                      <%= number_field_tag "#{field}[amount]", (r[:amount].to_f.positive? ? format("%.2f", r[:amount].to_f) : nil), id: nil, min: 0, step: "0.01", placeholder: "0.00", "aria-label": "#{r[:label]} amount", class: "#{input} pl-7 tabular-nums text-right" %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
            <p class="text-xs text-gray-500">
              <% if sources.empty? %>Name the places you sell tickets and each gets its own row here.<% end %>
              <%= link_to (sources.empty? ? "Name your ticket sources" : "Edit ticket sources"), manage_money_settings_section_path(section: "ticket_sources"), class: "text-pink-600 hover:text-pink-700" %>
            </p>
            <% if collects %>
              <label class="block text-sm">
                <span class="font-medium text-gray-700">Collected by <%= contract.contractor_name %> themselves</span>
                <span class="block text-xs text-gray-500 mb-1">Money they took at the door on their own. It's already in the amounts above; this says how much of it they're holding.</span>
                <span class="relative block w-40">
                  <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-sm text-gray-500">$</span>
                  <%= number_field_tag "show_financials[contractor_collected]", (financials&.contractor_collected.to_f.positive? ? format("%.2f", financials.contractor_collected.to_f) : nil), id: nil, min: 0, step: "0.01", placeholder: "0.00", class: "#{input} pl-7 tabular-nums" %>
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="<%= option %>">
          <label class="flex items-center gap-2.5 cursor-pointer text-sm font-medium text-gray-900">
            <%= radio_button_tag :revenue_choice, "flat_fee", choice == "flat_fee", id: nil, class: radio %>
            A flat fee instead of tickets
          </label>
          <div class="hidden group-has-[:checked]/opt:block mt-3">
            <span class="block text-xs text-gray-500 mb-1">The set amount you were paid for this show.</span>
            <span class="relative block w-40">
              <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-sm text-gray-500">$</span>
              <%= number_field_tag "show_financials[flat_fee]", (financials&.flat_fee.to_f.positive? ? format("%.2f", financials.flat_fee.to_f) : nil), id: nil, min: 0, step: "0.01", placeholder: "0.00", class: "#{input} pl-7 tabular-nums" %>
            </span>
          </div>
        </div>

        <div class="<%= option %>">
          <label class="flex items-center gap-2.5 cursor-pointer text-sm font-medium text-gray-900">
            <%= radio_button_tag :revenue_choice, "none", choice == "none", id: nil, class: radio %>
            This show had no revenue
          </label>
          <p class="hidden group-has-[:checked]/opt:block mt-2 text-xs text-gray-500">Nothing is counted for it and nobody is paid from it. It still gets confirmed with the day, and you can choose again here until the day settles.</p>
        </div>
      </div>
      <div class="px-5 sm:px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2 flex-shrink-0">
        <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
        <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
  </div>
</div>
