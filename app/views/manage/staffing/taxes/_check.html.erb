<%# A to-do marker: green check when done, amber dot while it isn't.
    Local: done (bool). %>
<% if done %>
  <div class="w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0 mt-0.5">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
  </div>
<% else %>
  <div class="w-6 h-6 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0 mt-0.5">
    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
  </div>
<% end %>
