<% content_for :title, "Reports" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%= render "shared/module_header",
    title: "Reports",
    description: "<p>Insights across your productions, cast, events, and finances. Every report can be printed to PDF or downloaded as a spreadsheet.</p>" %>

  <%
    report_paths = {
      revenue_by_production: manage_report_revenue_by_production_path,
      revenue_over_time: manage_report_revenue_over_time_path,
      course_revenue: manage_report_course_revenue_path,
      payouts_summary: manage_report_payouts_summary_path,
      events_summary: manage_report_events_summary_path,
      cast_participation: manage_report_cast_participation_path
    }
  %>

  <% @report_catalog.each do |group| %>
    <div class="mb-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 mb-3"><%= group[:title] %></h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% group[:reports].each do |report| %>
          <% path = report_paths[report[:key]] %>
          <%= link_to path, class: "block bg-white border border-gray-200 rounded-lg p-5 hover:border-pink-300 hover:shadow-sm transition" do %>
            <div class="flex items-start justify-between">
              <h3 class="text-base font-semibold text-gray-900"><%= report[:title] %></h3>
              <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <p class="mt-1.5 text-sm text-gray-500"><%= report[:description] %></p>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
