<%# Staff edit → Availability tab: whether they've confirmed their
    availability lately (and when), their usual week, and a month of how each
    day works out — the same calendar they see on their own page. Read-only;
    they change it themselves. Uses @availability_picture,
    @availability_calendar, @availability_days, @availability_nudge.
    Local: staff_member. %>
<% member = staff_member %>
<% person = member.person %>
<% through = person.availability_confirmed_through %>
<% at = person.availability_confirmed_at %>
<% confirmed = through.present? && through >= Date.current %>
<div data-staff-edit-target="panel" data-panel="availability" class="hidden space-y-5">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">Availability</h2>
    <p class="text-sm text-gray-500 mt-0.5">When <%= member.display_name %> says they can work. They set and confirm it on their own Work Availability page.</p>
  </div>

  <div class="rounded-lg border <%= confirmed ? "border-green-200 bg-green-50" : (at ? "border-amber-200 bg-amber-50" : "border-gray-200 bg-white") %> p-4 flex flex-wrap items-center justify-between gap-3">
    <div class="min-w-0">
      <% if confirmed %>
        <p class="text-sm font-medium text-green-800">Up to date through <%= through.strftime("%B %-d") %></p>
        <p class="text-xs text-green-700 mt-0.5"><%= at ? "They confirmed it on #{at.strftime('%B %-d, %Y')}." : "Confirmed before we started keeping the date." %></p>
      <% elsif at %>
        <p class="text-sm font-medium text-amber-800">Not confirmed since <%= at.strftime("%B %-d, %Y") %></p>
        <p class="text-xs text-amber-700 mt-0.5">Something's changed since, or it's been a while — worth asking them to check it.</p>
      <% else %>
        <p class="text-sm font-medium text-gray-900">Never confirmed</p>
        <p class="text-xs text-gray-500 mt-0.5">They haven't said their availability is up to date yet.</p>
      <% end %>
    </div>
    <% if !confirmed && @availability_nudge %>
      <%= render "shared/button", text: "Ask them to confirm", variant: "primary", size: "small", icon: "paper-airplane", type: :button,
            data: {
              action: "click->invite-preview#open",
              "invite-path": manage_staffing_availability_nudge_path(staff_member_ids: [ member.id ], from: "staff"),
              "modal-title": "Ask them to confirm their availability",
              "to-name": @availability_nudge[:to_name],
              "to-email": @availability_nudge[:to_email],
              "email-subject": @availability_nudge[:subject],
              "email-body": @availability_nudge[:body]
            } %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_16rem] gap-5 items-start">
    <div class="min-w-0 [&>div]:mb-0">
      <%= render "shared/month_calendar",
            **@availability_calendar.month_calendar_locals,
            anchor: "availability",
            month_link: ->(m) { manage_edit_staffing_staff_path(member, availability_month: m.to_date.beginning_of_month.iso8601) },
            today_link: manage_edit_staffing_staff_path(member),
            items_by_date: @availability_days,
            item_partial: "my/work_availability/day_bar",
            dim_past: true,
            min_cell: "min-h-[48px] sm:min-h-[64px]",
            week_starts_on: :monday,
            mobile_grid: true %>
    </div>

    <div class="space-y-4">
      <section class="rounded-lg border border-gray-200 overflow-hidden">
        <h3 class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-gray-500 bg-gray-50 border-b border-gray-200">Their usual week</h3>
        <ul class="divide-y divide-gray-100">
          <% @availability_picture.week.each do |day| %>
            <% answer = day.answer %>
            <li class="flex items-start gap-3 px-3 py-1.5 text-sm">
              <span class="w-10 flex-shrink-0 font-medium text-gray-900"><%= day.short_name %></span>
              <span class="min-w-0 <%= !answer.said ? "text-gray-400" : { anytime: "text-green-700", off: "text-gray-500", hours: "text-gray-900" }[answer.state] %>">
                <%= answer.label %>
                <% if answer.set_by %><span class="block text-xs text-gray-400">Set by <%= answer.set_by.person&.name || "a manager" %></span><% end %>
              </span>
            </li>
          <% end %>
        </ul>
      </section>

      <% changes = @availability_picture.exceptions %>
      <% if changes.any? %>
        <section class="rounded-lg border border-gray-200 overflow-hidden">
          <h3 class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-gray-500 bg-gray-50 border-b border-gray-200">Dates they changed</h3>
          <ul class="divide-y divide-gray-100">
            <% changes.each do |ex| %>
              <li class="px-3 py-1.5 text-sm">
                <span class="font-medium text-gray-900"><%= ex.dates_label %></span>
                <span class="block text-xs text-gray-600"><%= ex.answer.label %><% if ex.note.present? %> <span class="italic text-gray-500">· <%= ex.note %></span><% end %></span>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  </div>
</div>
