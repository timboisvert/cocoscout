<%= render layout: "manage/contract_wizard/wizard_layout", locals: { step_name: "Financials" } do %>
  <h2 class="text-xl font-bold text-gray-900 mb-2 coustard-regular">Financials</h2>
  <p class="text-gray-600 mb-6">Who sells the tickets, and how does the money work?</p>

  <%= render "manage/contracts/financials_fields",
        contract: @contract,
        form_url: manage_payments_contract_wizard_path(@contract),
        back_path: manage_schedule_preview_contract_wizard_path(@contract),
        existing_payments: @existing_payments,
        existing_payment_structure: @existing_payment_structure,
        existing_payment_config: @existing_payment_config,
        bookings: @bookings,
        bookings_count: @bookings_count,
        offline_payment_methods: @offline_payment_methods %>
<% end %>
