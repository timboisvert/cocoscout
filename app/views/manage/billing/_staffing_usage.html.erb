<%# Staffing usage + billing history. $5/month per staff member, billed only in
    months they were notified of a shift (a durable activation). Locals: organization. %>
<% current = StaffBillingService.new(organization) %>
<% billable = current.active_staff_members.includes(:person).to_a %>
<% months = (0..5).map { |i| Date.current.beginning_of_month - i.months } %>

<div class="mt-8 border-t border-gray-200 pt-6">
  <div class="flex items-start justify-between gap-4 flex-wrap mb-4">
    <div>
      <h4 class="text-base font-semibold text-gray-900">Staffing usage</h4>
      <p class="text-sm text-gray-500 mt-1 max-w-lg">$5/month per staff member — only in months they actually work a shift. Someone who doesn't work that month costs nothing.</p>
    </div>
    <div class="text-right">
      <div class="text-2xl font-semibold text-gray-900"><%= number_to_currency(current.monthly_estimate_cents / 100.0) %></div>
      <div class="text-xs text-gray-500">estimated this month</div>
    </div>
  </div>

  <%# This month's breakdown %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
    <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
      <div class="text-xs text-gray-500 uppercase tracking-wider">Active staff</div>
      <div class="text-xl font-semibold text-gray-900 mt-1"><%= current.active_count %></div>
      <div class="text-xs text-gray-400 mt-0.5"><%= number_to_currency(current.active_staff_cents / 100.0) %> at $5 each</div>
    </div>
    <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
      <div class="text-xs text-gray-500 uppercase tracking-wider">Extra-payment fees</div>
      <div class="text-xl font-semibold text-gray-900 mt-1"><%= number_to_currency(current.extra_payment_fee_cents / 100.0) %></div>
      <div class="text-xs text-gray-400 mt-0.5">$1 after 2 free payments/person</div>
    </div>
    <div class="rounded-lg border border-pink-200 bg-pink-50 p-4">
      <div class="text-xs text-pink-600 uppercase tracking-wider">Est. total</div>
      <div class="text-xl font-semibold text-gray-900 mt-1"><%= number_to_currency(current.monthly_estimate_cents / 100.0) %></div>
      <div class="text-xs text-gray-400 mt-0.5">so far this month</div>
    </div>
  </div>

  <%# Who's billable this month %>
  <% if billable.any? %>
    <div class="mb-6">
      <div class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2">Billable this month</div>
      <div class="flex flex-wrap gap-2">
        <% billable.each do |member| %>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-white border border-gray-200 text-sm text-gray-700"><%= member.display_name %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Recent history %>
  <div class="overflow-x-auto border border-gray-200 rounded-lg">
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
        <tr>
          <th class="text-left font-medium px-4 py-2">Month</th>
          <th class="text-right font-medium px-4 py-2">Active staff</th>
          <th class="text-right font-medium px-4 py-2">Staff cost</th>
          <th class="text-right font-medium px-4 py-2">Extra fees</th>
          <th class="text-right font-medium px-4 py-2">Total</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% months.each do |m| %>
          <% svc = StaffBillingService.new(organization, month: m) %>
          <tr>
            <td class="px-4 py-2 text-gray-900"><%= m.strftime("%B %Y") %></td>
            <td class="px-4 py-2 text-right text-gray-700"><%= svc.active_count %></td>
            <td class="px-4 py-2 text-right text-gray-700"><%= number_to_currency(svc.active_staff_cents / 100.0) %></td>
            <td class="px-4 py-2 text-right text-gray-700"><%= number_to_currency(svc.extra_payment_fee_cents / 100.0) %></td>
            <td class="px-4 py-2 text-right font-medium text-gray-900"><%= number_to_currency(svc.monthly_estimate_cents / 100.0) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
