<% content_for :title, "Staffing Roles" %>

<%
  create_url = manage_create_staffing_house_role_path
  # Template containing :id placeholder — the Stimulus controller substitutes
  # in the row's role id when opening the modal in edit mode.
  update_url_template = manage_update_staffing_house_role_path(":id")
  locations = Current.organization.locations.order(:name)
%>

<div class="w-full mb-10"
     data-controller="house-role-modal"
     data-house-role-modal-create-url-value="<%= create_url %>"
     data-house-role-modal-update-url-template-value="<%= update_url_template %>">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Staffing", manage_staffing_index_path]
    ],
    text: "Roles",
    links: [
      { text: "Add role", icon: "plus", type: :button,
        data_action: "click->house-role-modal#openForNew" }
    ]
  } %>

  <p class="text-sm text-gray-600 mb-4">
    Define all the roles you staff for shows — bartender, FOH, tech, security, etc. Each can be a house role (one shift for the whole evening) or a per-show role.
  </p>

  <% if @house_roles.any? %>
    <div class="space-y-2">
      <% @house_roles.each do |role| %>
        <%# Whole row taps to edit (mobile-friendly); delete lives inside the modal. %>
        <div class="bg-white border border-gray-200 rounded-lg px-4 py-3 flex items-center gap-4 hover:border-pink-300 hover:bg-gray-50 transition-colors cursor-pointer"
             role="button" tabindex="0"
             data-action="click->house-role-modal#openForEdit keydown.enter->house-role-modal#openForEdit"
             data-role-id="<%= role.id %>"
             data-role-name="<%= role.name %>"
             data-role-type="<%= role.role_type %>"
             data-role-location-id="<%= role.location_id %>"
             data-role-required-count="<%= role.default_required_count %>"
             data-role-hourly-rate="<%= role.default_hourly_rate_dollars %>"
             data-role-pay-type="<%= role.pay_type %>"
             data-role-flat-rate="<%= role.default_flat_rate_dollars %>">
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline gap-2 flex-wrap">
              <span class="font-medium text-gray-900"><%= role.name %></span>
              <% if role.show_specific? %>
                <span class="text-xs px-2 py-0.5 rounded bg-purple-50 text-purple-700">Per-show</span>
              <% end %>
              <% if role.archived? %>
                <span class="text-xs px-2 py-0.5 rounded bg-gray-100 text-gray-600">Archived</span>
              <% end %>
              <% if role.location %>
                <span class="text-xs px-2 py-0.5 rounded bg-blue-50 text-blue-700"><%= role.location.name %></span>
              <% end %>
            </div>
            <div class="text-xs text-gray-500 mt-1">
              Needs <%= pluralize(role.default_required_count, "person") %> by default ·
              <%= role.show_specific? ? "One shift per show" : "One shift for the evening" %><% if role.rate_label %> ·
              <span class="<%= "text-purple-700 font-medium" if role.flat? %>"><%= role.rate_label %></span><% end %>
            </div>
          </div>
          <svg class="w-4 h-4 text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-6 text-center">
      <p class="text-sm text-gray-600 mb-3">No staffing roles defined yet.</p>
      <button type="button"
              data-action="click->house-role-modal#openForNew"
              class="bg-pink-500 hover:bg-pink-600 text-white inline-flex items-center justify-center font-medium rounded transition-colors cursor-pointer px-3 py-1.5 text-sm">
        Add your first role
      </button>
    </div>
  <% end %>

  <%# Add/Edit House Role modal — opens in either mode from the index. %>
  <div data-house-role-modal-target="modal"
       class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->house-role-modal#backdropClose keydown.esc@window->house-role-modal#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-xl bg-white rounded-xl shadow-2xl"
           data-action="click->house-role-modal#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <h3 class="text-lg font-semibold text-white" data-house-role-modal-target="title">Add role</h3>
          <button type="button" data-action="click->house-role-modal#close" class="text-white/70 hover:text-white cursor-pointer">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <%# JS rewrites this form's action for edits; pass the session CSRF token — the per-form token is minted for the create path and gets rejected elsewhere. %>
        <%= form_with url: create_url, method: :post, local: true,
                      authenticity_token: form_authenticity_token,
                      data: { "house-role-modal-target": "form" },
                      scope: :house_role do |form| %>
          <%# Method override lets one form serve both create (POST) and update (PATCH). %>
          <input type="hidden" name="_method" value="post" data-house-role-modal-target="methodInput">

          <div class="px-5 py-4 space-y-4">
            <div>
              <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :name, required: true, placeholder: "e.g. Bartender",
                    data: { "house-role-modal-target": "nameInput" },
                    class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500" %>
            </div>

            <div>
              <%= form.label :role_type, "Role type", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :role_type,
                    [ [ "House role — one shift for the whole evening", "house" ],
                      [ "Show-specific — one shift per show/rehearsal", "show_specific" ] ],
                    {},
                    data: { "house-role-modal-target": "roleTypeSelect" },
                    class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500" %>
              <p class="text-xs text-gray-500 mt-1">
                House roles (bartender, FOH) get one shift spanning all of a day's shows.
                Show-specific roles (tech) get a separate shift for each show, so staff are tied to a specific one.
              </p>
            </div>

            <div>
              <%= form.label :location_id, "Venue (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :location_id,
                    options_from_collection_for_select(locations, :id, :name),
                    { include_blank: "All venues" },
                    data: { "house-role-modal-target": "locationSelect" },
                    class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500" %>
              <p class="text-xs text-gray-500 mt-1">Leave blank for org-wide.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <%= form.label :default_required_count, "Default count per show", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= form.number_field :default_required_count, min: 1, step: 1, required: true, value: 1,
                      data: { "house-role-modal-target": "requiredCount" },
                      class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500" %>
              </div>
              <div>
                <%= form.label :pay_type, "How it's paid", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= form.select :pay_type,
                      [ [ "By the hour", "hourly" ], [ "Flat rate for the shift", "flat" ] ],
                      {},
                      data: { "house-role-modal-target": "payType", action: "change->house-role-modal#payTypeChanged" },
                      class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500" %>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div data-house-role-modal-target="hourlyRateWrap">
                <%= form.label :default_hourly_rate_dollars, "Default hourly pay", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">$</span>
                  <%= form.text_field :default_hourly_rate_dollars, inputmode: "decimal", placeholder: "0.00",
                        data: { "house-role-modal-target": "hourlyRate" },
                        class: "block w-full shadow-sm rounded-lg border border-gray-300 pl-7 pr-12 py-2 focus:ring-pink-500 focus:border-pink-500" %>
                  <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">/hr</span>
                </div>
                <p class="text-xs text-gray-500 mt-1">Pre-fills each staff member's rate for this role.</p>
              </div>

              <%# Flat: one amount for the shift, whatever hours it runs. %>
              <div data-house-role-modal-target="flatRateWrap" class="hidden">
                <%= form.label :default_flat_rate_dollars, "Flat rate per shift", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">$</span>
                  <%= form.text_field :default_flat_rate_dollars, inputmode: "decimal", placeholder: "0.00",
                        data: { "house-role-modal-target": "flatRate" },
                        class: "block w-full shadow-sm rounded-lg border border-gray-300 pl-7 pr-16 py-2 focus:ring-pink-500 focus:border-pink-500" %>
                  <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">/night</span>
                </div>
                <p class="text-xs text-gray-500 mt-1">Paid once per shift however long it runs. Hours are still logged.</p>
              </div>
            </div>

          </div>

          <div class="flex items-center gap-2 px-5 py-3 border-t border-gray-200">
            <%# Delete lives here in edit mode — shown/hidden by the controller. %>
            <button type="button" data-house-role-modal-target="deleteButton" data-action="click->house-role-modal#destroyRole"
                    class="hidden text-sm text-gray-500 hover:text-red-600 cursor-pointer bg-transparent border-0">
              Remove role
            </button>
            <div class="flex items-center gap-2 ml-auto">
              <button type="button" data-action="click->house-role-modal#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
              <%= render "shared/button",
                    text: "Add role",
                    variant: "primary",
                    size: "small",
                    type: :submit,
                    data: { "house-role-modal-target": "submitButton" } %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
