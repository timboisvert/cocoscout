<div class="bg-white rounded-lg border border-gray-200 overflow-hidden border-l-4 border-l-pink-400">
<%= form_with model: [:manage, contract_template], class: "space-y-6 p-6", data: { turbo: false } do |f| %>
  <% if contract_template.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex">
        <svg class="w-5 h-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">Please fix the following errors:</h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% contract_template.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <h3 class="text-lg font-medium text-gray-900 mb-4">Template Details</h3>
    <div class="space-y-4">
      <div>
        <label for="contract_template_name" class="block text-sm font-medium text-gray-700 mb-1">
          Template Name <span class="text-pink-500">*</span>
        </label>
        <%= f.text_field :name,
            class: "w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500",
            placeholder: "e.g., Venue Rental Agreement" %>
        <p class="mt-1 text-sm text-gray-500">A descriptive name to identify this template (e.g., by deal type).</p>
      </div>

      <div>
        <label for="contract_template_description" class="block text-sm font-medium text-gray-700 mb-1">
          Internal Description
        </label>
        <%= f.text_area :description,
            rows: 2,
            class: "w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-pink-500 focus:ring-2 focus:ring-pink-500",
            placeholder: "e.g., Use for third-party groups renting the main stage" %>
        <p class="mt-1 text-sm text-gray-500">Optional note for your team about when to use this template.</p>
      </div>

      <div class="flex items-center gap-3">
        <%= f.check_box :active,
            class: "h-4 w-4 rounded border-gray-300 text-pink-600 focus:ring-pink-500 accent-pink-500" %>
        <%= f.label :active, "Active", class: "text-sm font-medium text-gray-700" %>
        <span class="text-sm text-gray-500">— Inactive templates won't be offered when sending a contract for signature.</span>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-6">
    <h3 class="text-lg font-medium text-gray-900 mb-4">Contract Content</h3>
    <div class="mb-4 p-4 bg-pink-50 border border-pink-200 rounded-lg">
      <h4 class="text-sm font-medium text-pink-800 mb-2">Available Variables</h4>
      <p class="text-sm text-pink-700 mb-2">Use these placeholders in your contract wording. They're replaced with the real values from each contract when it's sent for signature:</p>
      <div class="grid grid-cols-2 gap-2 text-sm">
        <% ContractTemplate::MERGE_FIELDS.each do |field, label| %>
          <div><code class="bg-pink-100 px-1 rounded">{{<%= field %>}}</code> — <%= label %></div>
        <% end %>
      </div>
      <p class="text-xs text-pink-700 mt-3">The contract's booked dates, financial terms, and services are appended automatically as a "Deal Terms" schedule — you don't need to write those in.</p>
    </div>

    <div>
      <label for="contract_template_content" class="block text-sm font-medium text-gray-700 mb-1">
        Contract Text <span class="text-pink-500">*</span>
      </label>
      <%= f.rich_text_area :content, class: "w-full min-h-[400px]" %>
      <p class="mt-1 text-sm text-gray-500">Use the toolbar to format with headings, bold, lists, and more.</p>
    </div>

    <% if contract_template.persisted? %>
      <div class="mt-4">
        <button type="button"
            data-controller="modal" data-action="click->modal#open" data-modal-id="preview-contract-template-<%= contract_template.id %>"
            class="inline-flex items-center gap-2 text-sm text-pink-600 hover:text-pink-700 bg-transparent border-0 cursor-pointer p-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
          Preview with sample data
        </button>
        <p class="mt-1 text-xs text-gray-400">Previews the last saved version; the “Deal Terms” schedule is added when a real contract is sent.</p>
      </div>
    <% end %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-6 border-t border-gray-200">
    <%= link_to "Cancel", manage_contract_settings_section_path(section: "templates"), class: "text-sm text-gray-600 hover:text-gray-800" %>
    <%= render "shared/button", text: contract_template.persisted? ? "Save Changes" : "Create Template", type: :submit, variant: "primary" %>
  </div>
<% end %>

<%# Delete lives OUTSIDE the edit form on purpose: the confirm modal renders its
    own method: :delete form, and a nested <form> leaks its _method=delete into
    the edit form — turning "Save Changes" into a destroy. Keep it separate. %>
<% if contract_template.persisted? %>
  <div class="px-6 pb-6 border-t border-gray-100 pt-4">
    <% if contract_template.contracts.empty? %>
      <button type="button"
          data-controller="modal" data-action="click->modal#open" data-modal-id="confirm-delete-contract-template-<%= contract_template.id %>"
          class="text-sm text-pink-600 hover:text-pink-700 bg-transparent border-0 cursor-pointer p-0">Delete template</button>
      <%= render "shared/confirm_modal",
          id: "confirm-delete-contract-template-#{contract_template.id}",
          title: "Delete template?",
          message: "Are you sure you want to delete this contract template?",
          confirm_text: "Delete Template",
          url: manage_contract_template_path(contract_template),
          method: :delete %>
    <% else %>
      <span class="text-sm text-gray-500">
        In use by <%= contract_template.contracts.count %> <%= "contract".pluralize(contract_template.contracts.count) %> — cannot delete
      </span>
    <% end %>
  </div>
<% end %>

<%# Preview modal — renders the saved template with sample data (merge fields filled in). %>
<% if contract_template.persisted? %>
  <div id="preview-contract-template-<%= contract_template.id %>"
       class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
       data-controller="modal" data-action="click->modal#closeOnBackdrop">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl mx-4 max-h-[85vh] flex flex-col overflow-hidden"
         data-action="click->modal#stopPropagation">
      <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4 flex-shrink-0">
        <div class="min-w-0">
          <h3 class="text-lg font-semibold text-white truncate"><%= contract_template.name %></h3>
          <p class="text-xs text-pink-100">Preview with sample data</p>
        </div>
        <button type="button" data-action="click->modal#close"
                class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="px-6 py-5 overflow-y-auto prose prose-sm max-w-none [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:my-1">
        <%= contract_template.render_content(
              contractor_name: "Local Comedy Troupe",
              organization_name: contract_template.organization&.name,
              production_name: "Example Production",
              contract_start_date: Date.current.strftime("%B %-d, %Y"),
              contract_end_date: (Date.current + 3.months).strftime("%B %-d, %Y"),
              current_date: Date.current.strftime("%B %-d, %Y")
            ) %>
        <p class="text-xs text-gray-400 mt-4 not-prose">The contract’s real dates, fees, and services are appended as a “Deal Terms” schedule when it’s sent for signature.</p>
      </div>
      <div class="px-6 py-3 bg-gray-50 border-t border-gray-200 flex items-center justify-end flex-shrink-0">
        <%= render "shared/button", text: "Close", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
      </div>
    </div>
  </div>
<% end %>
</div>
