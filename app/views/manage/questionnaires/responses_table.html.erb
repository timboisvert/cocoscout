<% content_for :title, "Response Table - #{@questionnaire.title}" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Contacts", manage_contacts_path],
      ["Questionnaires", manage_contacts_questionnaires_path],
      [@questionnaire.title, manage_contacts_questionnaire_path(@questionnaire)],
      ["Responses", manage_responses_contacts_questionnaire_path(@questionnaire)]
    ],
    text: "Table View",
    links: [
      { text: "List View", path: manage_responses_contacts_questionnaire_path(@questionnaire) }
    ]
  } %>

  <div class="mb-4">
    <p class="text-sm text-gray-600">
      <%= @responses.count %> <%= @responses.count == 1 ? 'response' : 'responses' %> &middot; <%= @questions.count %> <%= @questions.count == 1 ? 'question' : 'questions' %>
    </p>
  </div>

  <% if @responses.any? && @questions.any? %>
    <%# A phone: one card per response, each question's answer under it (the
        table stays for md up and scrolls sideways there). %>
    <div class="md:hidden space-y-3">
      <% @responses.each do |response| %>
        <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden" data-response-card>
          <%= link_to manage_response_contacts_questionnaire_path(@questionnaire, response_id: response.id), class: "flex items-center gap-3 px-4 py-3 border-b border-gray-100 no-underline hover:bg-gray-50" do %>
            <% headshot_variant = response.respondent.respond_to?(:safe_headshot_variant) ? response.respondent.safe_headshot_variant(:thumb) : nil %>
            <% if headshot_variant %>
              <%= image_tag headshot_variant, alt: response.respondent.name, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
            <% else %>
              <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center flex-shrink-0"><span class="text-pink-600 font-bold text-xs"><%= response.respondent.initials %></span></div>
            <% end %>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-medium text-gray-900 truncate"><%= response.respondent.name %></span>
              <span class="block text-xs text-gray-500"><%= response.created_at.strftime("%b %-d, %Y") %></span>
            </span>
            <svg class="w-4 h-4 text-gray-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          <% end %>
          <dl class="px-4 py-2 divide-y divide-gray-100">
            <% @questions.each do |question| %>
              <div class="py-2">
                <dt class="text-xs font-medium text-gray-500"><%= question.text %></dt>
                <dd class="mt-0.5 text-sm text-gray-800"><%= render "manage/questionnaires/answer_cell", answer: @answers_matrix.dig(response.id, question.id), question: question, wrap: true %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      <% end %>
    </div>

    <div class="hidden md:block bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="sticky left-0 z-10 bg-gray-50 px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap border-r border-gray-200">
                Respondent
              </th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap border-r border-gray-100">
                Submitted
              </th>
              <% @questions.each do |question| %>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-r border-gray-100 max-w-[200px]" title="<%= question.text %>">
                  <div class="truncate max-w-[180px]"><%= question.text %></div>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @responses.each do |response| %>
              <tr class="hover:bg-gray-50">
                <td class="sticky left-0 z-10 bg-white px-4 py-3 whitespace-nowrap border-r border-gray-200">
                  <%= link_to manage_response_contacts_questionnaire_path(@questionnaire, response_id: response.id), class: "flex items-center gap-2 no-underline" do %>
                    <% headshot_variant = response.respondent.respond_to?(:safe_headshot_variant) ? response.respondent.safe_headshot_variant(:thumb) : nil %>
                    <% if headshot_variant %>
                      <%= image_tag headshot_variant, alt: response.respondent.name, class: "w-8 h-8 rounded-lg object-cover flex-shrink-0" %>
                    <% else %>
                      <div class="w-8 h-8 rounded-lg bg-pink-100 flex items-center justify-center flex-shrink-0">
                        <span class="text-pink-600 font-bold text-xs"><%= response.respondent.initials %></span>
                      </div>
                    <% end %>
                    <span class="text-sm font-medium text-gray-900"><%= response.respondent.name %></span>
                  <% end %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-xs text-gray-500 border-r border-gray-100">
                  <%= response.created_at.strftime("%b %-d, %Y") %>
                </td>
                <% @questions.each do |question| %>
                  <td class="px-4 py-3 text-sm text-gray-700 border-r border-gray-100 max-w-[250px]">
                    <%= render "manage/questionnaires/answer_cell", answer: @answers_matrix.dig(response.id, question.id), question: question %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% elsif @responses.empty? %>
    <div class="text-center py-12">
      <p class="text-gray-600">No responses yet</p>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-gray-600">No questions have been added to this questionnaire yet</p>
    </div>
  <% end %>
</div>
