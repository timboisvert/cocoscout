<% content_for :title, "#{@booking.name} · #{@listing.display_title}" %>
<% show = @listing.show %>
<% input = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
<div class="mx-auto max-w-2xl space-y-6">
  <% if notice %><div class="rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-800"><%= notice %></div><% end %>
  <div class="text-center space-y-1.5">
    <p class="text-sm font-medium text-pink-600"><%= @booking.name %></p>
    <h1 class="text-3xl coustard-regular text-gray-900"><%= @listing.display_title %></h1>
    <p class="text-base text-gray-800"><%= show.date_and_time.strftime("%A, %B %-d · %-l:%M %p") %></p>
    <% if show.location %><p class="text-sm text-gray-600"><%= public_place_name(show) %></p><% end %>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white px-5 py-5 space-y-3">
    <% case @booking.status %>
    <% when "booked" %>
      <p class="text-lg font-semibold text-gray-900"><%= pluralize(@booking.seats, "seat") %> are held for you</p>
      <p class="text-gray-700"><%= pluralize(@booking.seat_count, "seat") %> at <%= number_to_currency(@booking.price_cents / 100.0) %><%= ", and #{pluralize(@booking.comp_count, 'chaperone seat')} at no charge" if @booking.comp_count.positive? %>. Please pay by <%= @booking.due_on.strftime("%B %-d") %>; the seats are held until <%= @booking.release_on.strftime("%B %-d") %>.</p>
      <% if @invoice&.collectable_online? %>
        <%= link_to pay_invoice_path(token: @invoice.payment_token!), class: "block" do %>
          <%= render "shared/button", text: "Pay #{number_to_currency(@invoice.unpaid_cents / 100.0)}", variant: "primary", size: "jumbo", type: :button %>
        <% end %>
        <p class="text-xs text-gray-500"><%= [ (@invoice.pay_by_card ? "Card" : nil), (@invoice.bank_transfer_allowed? ? "bank transfer" : nil) ].compact.to_sentence %>, processed securely by our payment provider.<% if @invoice.pay_by_check %> Prefer a check? The invoice says where to send it.<% end %></p>
      <% elsif @invoice&.paid? %>
        <p class="text-sm text-gray-600">Paid. Your tickets are on their way.</p>
      <% end %>
    <% when "ticketed" %>
      <p class="text-lg font-semibold text-gray-900">Your tickets are ready</p>
      <p class="text-gray-700"><%= pluralize(@booking.seats, "ticket") %> for <%= @booking.name %>. At the door, the group's name is enough; or print them.</p>
      <div class="flex flex-wrap gap-2">
        <%= link_to tickets_order_pdf_path(token: @booking.ticket_order.token, format: :pdf), target: "_blank", rel: "noopener" do %>
          <%= render "shared/button", text: "All tickets, one PDF", variant: "primary", size: "medium", type: :button %>
        <% end %>
        <%= link_to tickets_order_path(token: @booking.ticket_order.token, **embed_params) do %>
          <%= render "shared/button", text: "See the tickets", variant: "secondary", size: "medium", type: :button %>
        <% end %>
      </div>
      <% if @invoice&.open? %><p class="text-sm text-amber-700">The invoice for <%= number_to_currency(@invoice.unpaid_cents / 100.0) %> is still open. <%= link_to "Pay it", pay_invoice_path(token: @invoice.payment_token!), class: "font-medium underline" %>.</p><% end %>
    <% else %>
      <p class="text-lg font-semibold text-gray-900">These seats were released</p>
      <p class="text-gray-700">They went back on sale and the invoice is cancelled. Tickets may still be available: <%= link_to @listing.display_title, tickets_event_path(org: @ticketing_profile.slug, event: @listing.slug, **embed_params), class: "text-pink-700 hover:text-pink-800 font-medium" %>.</p>
    <% end %>
  </div>

  <% if @booking.live? %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-5 space-y-3">
      <h2 class="font-semibold text-gray-900">Who's coming</h2>
      <p class="text-sm text-gray-600">Paste the names, one a line, in any order; they go on the tickets. You can come back and change them. Tickets without a name read "<%= @booking.name %>" at the door.</p>
      <%= form_with url: tickets_group_names_path(token: @booking.token, **embed_params), method: :patch, data: { turbo: false }, class: "space-y-3" do %>
        <%= text_area_tag :names, @booking.names, rows: [ 8, @booking.seats ].min, placeholder: "Avery Smith\nBlake Jones", class: input %>
        <div class="flex items-center justify-between gap-3">
          <span class="text-xs text-gray-500"><%= pluralize(@booking.names_list.size, "name") %> of <%= @booking.seats %></span>
          <%= render "shared/button", text: "Save names", variant: "primary", size: "medium", type: :submit %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @document %>
    <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <div class="p-4"><%= render "shared/invoice_document", document: @document %></div>
      <div class="px-5 pb-5 flex justify-center">
        <%= link_to pay_invoice_pdf_path(token: @invoice.payment_token!, format: :pdf), target: "_blank", rel: "noopener" do %>
          <%= render "shared/button", text: (@invoice.paid? ? "Download receipt (PDF)" : "Download invoice (PDF)"), variant: "secondary", size: "small", icon: "download", type: :button %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
