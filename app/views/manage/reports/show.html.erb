<% content_for :title, "#{@report[:title]} — Reports" %>

<%
  # Format a cell value according to its column format.
  fmt = ->(value, format) {
    return "" if value.nil?
    case format
    when :currency then number_to_currency(value)
    when :number   then number_with_delimiter(value)
    else value.to_s
    end
  }
  align = ->(format) { format == :text ? "text-left" : "text-right tabular-nums" }
%>

<div class="w-full mb-10 report-printable">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%# Standard breadcrumb header (screen only — hidden when printing). %>
  <% print_button = capture do %>
    <%= render "shared/button", text: "Print / PDF", variant: "secondary", size: "small", type: :button, icon: "print", onclick: "window.print()" %>
  <% end %>
  <div class="no-print">
    <%= render partial: "shared/top_menu", locals: {
      breadcrumbs: [ [ "Reports", manage_reports_path ] ],
      text: @report[:title],
      extra_buttons: print_button,
      links: [
        { text: "Download spreadsheet", icon: "download", path: @report[:csv_path], variant: "primary" }
      ]
    } %>
  </div>

  <%# Title (printed pages only — the breadcrumb carries it on screen) + subtitle. %>
  <div class="mb-6 mt-2">
    <h1 class="report-print-title text-2xl coustard-regular text-gray-900"><%= @report[:title] %></h1>
    <% if @report[:subtitle].present? %>
      <p class="text-sm text-gray-600"><%= @report[:subtitle] %></p>
    <% end %>
  </div>

  <%# Headline stats %>
  <% if @report[:stats].present? %>
    <div class="grid gap-4 grid-cols-2 sm:grid-cols-4 mb-6">
      <% @report[:stats].each do |stat| %>
        <div class="rounded-lg border border-gray-200 bg-white p-4">
          <div class="text-xs uppercase tracking-wide text-gray-500"><%= stat[:label] %></div>
          <div class="mt-1 text-2xl font-bold text-gray-900 tabular-nums"><%= stat[:value] %></div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Standardized table %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-200 bg-gray-50">
          <% @report[:columns].each do |c| %>
            <th class="px-4 py-2.5 font-semibold text-gray-700 <%= align.call(c[:format]) %>"><%= c[:label] %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% if @report[:rows].any? %>
          <% @report[:rows].each do |row| %>
            <tr>
              <% row.each_with_index do |value, i| %>
                <% c = @report[:columns][i] %>
                <td class="px-4 py-2.5 text-gray-900 <%= align.call(c[:format]) %>"><%= fmt.call(value, c[:format]) %></td>
              <% end %>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="<%= @report[:columns].size %>" class="px-4 py-10 text-center text-gray-500">No data for this report yet.</td></tr>
        <% end %>
      </tbody>
      <% if @report[:total_row] %>
        <tfoot>
          <tr class="border-t-2 border-gray-300 bg-gray-50 font-semibold">
            <% @report[:total_row].each_with_index do |value, i| %>
              <% c = @report[:columns][i] %>
              <td class="px-4 py-2.5 text-gray-900 <%= align.call(c[:format]) %>"><%= fmt.call(value, c[:format]) %></td>
            <% end %>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </div>
</div>

<style>
  .report-print-title { display: none; }
  @media print {
    body * { visibility: hidden !important; }
    .report-printable, .report-printable * { visibility: visible !important; }
    .report-printable { position: absolute; left: 0; top: 0; width: 100%; padding: 0; }
    .no-print { display: none !important; }
    .report-print-title { display: block !important; }
  }
</style>
