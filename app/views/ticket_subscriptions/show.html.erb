<% content_for :title, "#{@pass.name} · #{@organization.name}" %>
<div class="mx-auto max-w-xl space-y-5">
  <div class="text-center space-y-1.5">
    <p class="text-sm font-medium text-pink-700"><%= @organization.name %></p>
    <h1 class="text-3xl sm:text-4xl coustard-regular text-gray-900"><%= @pass.name %></h1>
    <p class="text-base text-gray-800">Your <%= "seat".pluralize(@subscription.quantity) %>: <strong><%= @subscription.seat_labels.to_sentence %></strong></p>
    <% if @subscription.buyer_name.present? %><p class="text-sm text-gray-500"><%= @subscription.buyer_name %> · <%= @subscription.status_label %></p><% end %>
  </div>
  <% if flash[:alert] %><div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 text-center"><%= flash[:alert] %></div><% end %>

  <% if @subscription.renewable? && @renewal.nil? %>
    <div class="rounded-2xl border border-pink-200 bg-pink-50 px-5 py-4 space-y-3">
      <p class="text-sm text-gray-800"><strong><%= @subscription.renewal_pass.name %></strong> is here. Your seats are held for you<% if @subscription.renewal_pass.renewal_closes_at %> until <%= @subscription.renewal_pass.renewal_closes_at.strftime("%B %-d") %><% end %>; renew and they're yours again, at every date.</p>
      <%= form_with url: tickets_subscription_renew_path(token: @subscription.token, **embed_params), method: :post, data: { turbo: false } do %>
        <%= render "shared/button", text: "Renew my seats", variant: "primary", size: "medium", type: :submit %>
      <% end %>
      <p class="text-xs text-gray-600">Want different seats? Reply to the renewal email and the box office will sort it before the close.</p>
    </div>
  <% elsif @renewal %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4 text-sm text-gray-700">Renewed: <%= link_to @renewal.ticket_pass.name, tickets_subscription_path(token: @renewal.token, **embed_params), class: "text-pink-700 hover:text-pink-800 font-medium" %>.</div>
  <% end %>

  <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
    <div class="px-5 py-4"><h2 class="font-semibold text-gray-900">Your dates</h2></div>
    <ul class="divide-y divide-gray-100">
      <% @orders.each do |order| %>
        <li class="px-5 py-3 flex items-center justify-between gap-3 text-sm">
          <span><span class="font-medium text-gray-900"><%= order.ticket_listing.display_title %></span> <span class="text-gray-500">· <%= order.ticket_listing.show.date_and_time.strftime("%a %b %-d, %-l:%M %p") %></span></span>
          <%= link_to "Tickets", tickets_order_path(token: order.token, **embed_params), class: "text-pink-700 hover:text-pink-800 font-medium" %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
