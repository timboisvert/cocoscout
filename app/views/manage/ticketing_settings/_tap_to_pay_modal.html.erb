<%# Tap to Pay on iPhone's settings, in a modal from its card on the Door
    tab (Tim, 2026-10-19): the card says how it's set; this changes it.
    Locals: id. %>
<div id="<%= id %>" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden max-h-[90vh] flex flex-col" data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4 flex-shrink-0">
      <h3 class="text-lg font-semibold text-white">Tap to Pay on iPhone</h3>
      <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <%= form_with model: ticketing_profile, url: manage_ticketing_door_tap_to_pay_path, method: :patch, class: "flex flex-col min-h-0" do |f| %>
      <div class="p-6 space-y-5 overflow-y-auto">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <p class="text-sm font-medium text-gray-900">Take cards on iPhones at your door</p>
            <p class="text-sm text-gray-600 mt-0.5">Physical debit and credit cards, Apple Pay and other digital wallets, on the sell screen in the CocoScout app.</p>
          </div>
          <%= render "shared/toggle_switch", form: f, field: :tap_to_pay, unchecked_value: "0" %>
        </div>

        <div>
          <h4 class="text-sm font-medium text-gray-900">Who can use it</h4>
          <p class="text-sm text-gray-600 mt-1">Your organization's managers, and everyone on your door list who can check people in and sell tickets.</p>
        </div>

        <div>
          <h4 class="text-sm font-medium text-gray-900">Setting up an iPhone</h4>
          <ol class="mt-1 list-decimal pl-5 space-y-1 text-sm text-gray-600">
            <li>Open the CocoScout app on the iPhone and sign in.</li>
            <li>Open the menu and choose Tap to Pay on iPhone.</li>
            <li>Tap Set up Tap to Pay on iPhone. The first time takes a minute or two.</li>
          </ol>
          <p class="text-xs text-gray-500 mt-2">It needs an iPhone XS or later on the latest version of iOS.</p>
        </div>

        <%= render "shared/tap_to_pay_terms" %>
      </div>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2 flex-shrink-0">
        <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
        <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
  </div>
</div>
