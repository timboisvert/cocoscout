<% content_for :title, "Scheduling" %>

<%# Assigning someone, adding a shift, splitting one — every action here posts
    and comes straight back to this same URL. Declaring morph means Turbo patches
    only the nodes that actually changed instead of re-rendering the page, and
    preserve keeps the scroll exactly where the manager left it. Scoped to this
    page: the rest of the app still navigates normally. %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<% assign_url_template = manage_assign_staffing_shift_path(":id") %>

<div class="w-full mb-10"
     data-controller="shift-assign shift-edit shift-split shift-add staffing-finalize shift-menu"
     data-shift-assign-staff-by-role-value="<%= @staff_by_role_payload.to_json %>"
     data-shift-assign-assign-url-template-value="<%= assign_url_template %>"
     data-shift-assign-day-windows-value="<%= @staff_day_windows_payload.to_json %>"
     data-shift-assign-cast-by-day-value="<%= @cast_by_day_payload.to_json %>"
     data-shift-edit-update-url-template-value="<%= manage_update_staffing_shift_path(":id") %>"
     data-shift-edit-unassign-url-template-value="<%= manage_unassign_staffing_shift_path(id: "SHIFT_ID", person_id: "PERSON_ID") %>"
     data-shift-split-split-url-template-value="<%= manage_split_staffing_shift_path(":id") %>"
     data-shift-add-create-url-value="<%= manage_create_staffing_shift_path %>"
     data-shift-add-all-staff-value="<%= @all_staff_payload.to_json %>">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%
    top_links = [
      { text: "Availability", icon: "calendar", path: manage_staffing_availability_path },
      { text: "Manage roles", icon: "cog", path: manage_staffing_house_roles_path }
    ]
    top_links.unshift({ text: "Regulars", icon: "star", path: manage_staffing_scheduling_rules_path }) if @regulars_enabled
  %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Staffing", manage_staffing_index_path]
    ],
    text: "Scheduling",
    links: top_links
  } %>

  <%= render "manage/staffing/regulars_apply_modal" if @regulars_enabled %>

  <div class="border-t border-gray-200 pt-4 mt-2">

  <%# === The week (desktop) and Apply regulars. A phone picks a day instead. === %>
  <div class="<%= 'max-sm:hidden' unless @regulars_enabled && @regulars_matches.any? %> flex items-center justify-between mb-3 flex-wrap gap-2">
    <%= render "manage/staffing/week_picker" %>
    <% if @regulars_enabled && @regulars_matches.any? %>
      <%= render "shared/button", text: "Apply regulars (#{@regulars_matches.size})",
            variant: "outline-pink", size: "small", icon: "star", type: :button,
            data: { controller: "modal", action: "click->modal#open", modal_id: "regulars-apply-modal" } %>
    <% end %>
  </div>

  <%= render "manage/staffing/status_bar" %>

  <% if @shows_by_day.empty? && @shifts_by_day.empty? && (@house_role_count.zero? || @staff_count.zero?) %>
    <%= render "shared/empty_state", icon: "calendar", title: "No shows or shifts this week",
          actions: (if @house_role_count.zero? then [ { text: "Set up your staffing roles first", path: manage_staffing_house_roles_path } ]
                    else [ { text: "Add your staff", path: manage_staffing_staff_path } ] end) %>
  <% else %>
    <%= render "manage/staffing/week_grid" if @house_role_count.positive? || @shifts_by_day.any? %>
    <%= render "manage/staffing/phone_day" %>
  <% end %>

  <%# Every show's detail modal and every shift's menu, once each: the week
      grid and the phone's day both open them. %>
  <% (@week_start..@week_end).each do |day| %>
    <% day_shows = @shows_by_day[day] || [] %>
    <% day_shows.each do |show| %>
      <%= render "manage/staffing/show_detail_modal", show: show, day: day, day_shows: day_shows %>
    <% end %>
    <% day_shifts = @shifts_by_day[day] || [] %>
    <% day_shifts.each do |shift| %>
      <%= render "manage/staffing/shift_menu", shift: shift, day: day,
            siblings: day_shifts.select { |s| s.house_role_id == shift.house_role_id && s.id != shift.id }.sort_by(&:starts_at) %>
    <% end %>
  <% end %>

  <%# Phone: Publish, or Notify updates, pinned to the bottom (V1.1 plan §4),
      clear of the Coco button in the app. The status bar above says why. %>
  <% if @shifts_by_day.any? && (!@week_finalized || @comms[:update].any?) %>
    <div class="sm:hidden h-24" aria-hidden="true"></div>
    <div class="sm:hidden fixed inset-x-0 bottom-0 z-30 bg-white/95 backdrop-blur border-t border-gray-200 pl-4 <%= turbo_native_app? ? 'pr-[96px]' : 'pr-4' %> pt-3 pb-[calc(env(safe-area-inset-bottom)+12px)] flex items-center gap-3" data-scheduling-phone-bar>
      <% if !@week_finalized %>
        <span class="text-sm text-gray-600 flex-1 min-w-0 truncate">Draft · <%= pluralize(@comms[:total], "person") %> assigned</span>
        <%= render "shared/button", text: "Publish & notify", variant: "primary", size: "medium", type: :button,
              data: { action: "staffing-finalize#open" } %>
      <% else %>
        <span class="text-sm text-gray-600 flex-1 min-w-0 truncate"><%= pluralize(@comms[:update].size, "update") %> to send</span>
        <%= render "shared/button", text: "Notify updates", variant: "primary", size: "medium", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-notify-updates" } %>
      <% end %>
    </div>
  <% end %>

  <%# === Assign: the shared People Picker (V1.1 plan §5), listing everyone
      qualified for the shift's role, free for all of it first, with the
      Everyone / Can work / Available the whole shift filters. A pick that
      collides (another shift, a show that night, hours they said they can't
      work) goes through the conflict modal below first. %>
  <%= render "shared/people_picker", id: "shift-picker", title: "Assign", scope: "staff",
        filters: [ [ "Everyone", "all" ], [ "Can work", "can_work" ], [ "Available the whole shift", "free" ] ], filter_param: "fit",
        placeholder: "Search by name", pick_action: "people-picker:pick->shift-assign#picked" %>
  <%# JS rewrites this form's action; pass the session CSRF token — the default per-form token is minted for "#" and gets rejected. %>
  <%= form_with url: "#", method: :post, local: true,
                authenticity_token: form_authenticity_token,
                class: "hidden",
                data: { "shift-assign-target": "form" } do %>
    <input type="hidden" name="person_id" data-shift-assign-target="personIdInput">
  <% end %>

  <%# === Scheduling-conflict modal (shown when assigning would double-book) === %>
  <div data-shift-assign-target="collisionModal"
       class="hidden fixed inset-0 z-[80] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->shift-assign#collisionBackdropClose keydown.esc@window->shift-assign#cancelCollision">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl"
           data-action="click->shift-assign#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <h3 class="text-lg font-semibold text-white">Scheduling conflict</h3>
          <button type="button" data-action="click->shift-assign#cancelCollision" class="text-white/70 hover:text-white cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="px-5 py-4" data-shift-assign-target="collisionBody">
          <%# populated by JS %>
        </div>

        <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
          <button type="button" data-action="click->shift-assign#cancelCollision" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
          <button type="button" data-action="click->shift-assign#confirmCollision"
                  class="px-4 py-2 text-sm font-medium rounded bg-pink-500 hover:bg-pink-600 text-white cursor-pointer transition-colors">
            Assign anyway
          </button>
        </div>
      </div>
    </div>
  </div>

  <%# === Edit time modal === %>
  <div data-shift-edit-target="modal"
       class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->shift-edit#backdropClose keydown.esc@window->shift-edit#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-sm bg-white rounded-xl shadow-2xl"
           data-action="click->shift-edit#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <h3 class="text-lg font-semibold text-white" data-shift-edit-target="title">Edit shift</h3>
          <button type="button" data-action="click->shift-edit#close" class="text-white/70 hover:text-white cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <%# JS rewrites this form's action; pass the session CSRF token — the default per-form token is minted for "#" and gets rejected. %>
        <%= form_with url: "#", method: :patch, local: true,
                      authenticity_token: form_authenticity_token,
                      data: { "shift-edit-target": "form" }, scope: :shift do |f| %>
          <div class="px-5 py-4">
            <div class="text-xs text-gray-500 mb-2" data-shift-edit-target="dayLabel"></div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Starts</label>
                <input type="time" step="300"
                       data-shift-edit-target="startTimeInput"
                       data-action="input->shift-edit#syncHiddenFields"
                       class="block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Ends</label>
                <input type="time" step="300"
                       data-shift-edit-target="endTimeInput"
                       data-action="input->shift-edit#syncHiddenFields"
                       class="block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500">
              </div>
            </div>
            <p class="text-[11px] text-gray-500 mt-2">End time can roll past midnight onto the next day.</p>

            <%# Double-up: this one shift can also cover any number of other roles. %>
            <div class="mt-4">
              <label class="block text-xs font-medium text-gray-700 mb-1">Also covers (optional)</label>
              <%# Empty value so unchecking every box still submits the key and clears the set. %>
              <input type="hidden" name="shift[additional_role_ids][]" value="">
              <div class="space-y-1 max-h-60 overflow-y-auto rounded border border-gray-200 p-2">
                <% @house_roles.each do |r| %>
                  <div>
                    <label class="flex items-center gap-2 text-sm text-gray-800 px-1 py-0.5 rounded hover:bg-gray-50 cursor-pointer">
                      <input type="checkbox" name="shift[additional_role_ids][]" value="<%= r.id %>"
                             data-shift-edit-target="additionalRoleCheckbox" data-role-id="<%= r.id %>"
                             data-action="change->shift-edit#toggleRoleShows"
                             class="h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
                      <span class="truncate"><%= r.name %></span>
                    </label>
                    <%# On a shift covering several shows: which of them this role
                        is for. Filled by the controller; the outer div carries
                        `hidden` alone so it never fights the inner flex. %>
                    <div class="hidden" data-shift-edit-target="roleShows" data-role-id="<%= r.id %>">
                      <div class="flex flex-wrap gap-1 pl-7 pt-0.5 pb-1.5" data-role-show-chips></div>
                    </div>
                  </div>
                <% end %>
              </div>
              <p class="text-[11px] text-gray-500 mt-1">Check every extra role this person works this shift (e.g. a bartender who's also managing and on security).</p>
              <p class="hidden text-[11px] text-gray-500 mt-1" data-shift-edit-target="roleShowsHint">
                This shift covers more than one show. An extra role covers all of them unless you untick the ones it doesn't.
              </p>
            </div>

            <%# Hidden full-datetime fields submitted to the server; JS keeps them in sync with the time inputs above. %>
            <%= f.hidden_field :starts_at, data: { "shift-edit-target": "startInput" } %>
            <%= f.hidden_field :ends_at,   data: { "shift-edit-target": "endInput" } %>
          </div>
          <%# Shown only when the modal was opened by clicking a specific person. %>
          <div data-shift-edit-target="removeSection"
               class="hidden border-t border-gray-200 px-5 py-3 flex items-center justify-between gap-3">
            <span class="text-xs text-gray-600">
              Remove <span class="font-medium text-gray-900" data-shift-edit-target="removePersonName"></span> from this shift?
            </span>
            <button type="button"
                    data-shift-edit-target="removeButton"
                    data-action="click->shift-edit#removePerson"
                    class="px-3 py-1.5 text-xs font-medium rounded border border-red-300 text-red-700 bg-white hover:bg-red-50 cursor-pointer transition-colors">
              Remove
            </button>
          </div>
          <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
            <button type="button" data-action="click->shift-edit#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
            <%= render "shared/button", text: "Save time", variant: "primary", size: "small", type: :submit %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# === Split modal === %>
  <div data-shift-split-target="modal"
       class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->shift-split#backdropClose keydown.esc@window->shift-split#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl"
           data-action="click->shift-split#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <div>
            <h3 class="text-lg font-semibold text-white" data-shift-split-target="title">Split shift</h3>
            <div class="text-xs text-white/80" data-shift-split-target="subtitle"></div>
          </div>
          <button type="button" data-action="click->shift-split#close" class="text-white/70 hover:text-white cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <%# JS rewrites this form's action; pass the session CSRF token — the default per-form token is minted for "#" and gets rejected. %>
        <%= form_with url: "#", method: :post, local: true,
                      authenticity_token: form_authenticity_token,
                      data: { "shift-split-target": "form" } do %>
          <%# Per-show split — shown by JS for show-based shifts. Splits back into
              one distinct shift per show; no time slicing for this type. %>
          <div class="hidden" data-shift-split-target="byShowRow">
            <div class="px-5 py-4">
              <p class="text-sm text-gray-600 mb-3">This shift covers these shows. Split it back into a separate shift for each.</p>
              <div class="space-y-1 mb-4" data-shift-split-target="byShowList"></div>
              <div class="bg-amber-50 border border-amber-200 rounded text-xs text-amber-900 p-2.5">
                The people assigned stay on the first show's shift; the others come back empty to staff per show.
              </div>
            </div>
            <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
              <button type="button" data-action="click->shift-split#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
              <button type="submit" name="by_show" value="1"
                      class="px-3 py-1.5 text-sm rounded bg-pink-500 text-white hover:bg-pink-600 font-medium cursor-pointer"
                      data-shift-split-target="byShowLabel">Split into separate shows</button>
            </div>
          </div>

          <%# Time-based split — shown by JS for house (evening) shifts. %>
          <div data-shift-split-target="timeSplitRow">
            <div class="px-5 py-4 space-y-5">
              <%# Big +/- counter %>
              <div class="flex items-center justify-center gap-6">
                <button type="button" data-action="click->shift-split#decrement"
                        class="w-10 h-10 rounded-full border border-gray-300 bg-white hover:bg-gray-50 hover:border-gray-400 text-xl font-medium text-gray-700 cursor-pointer flex items-center justify-center transition-colors">
                  −
                </button>
                <div class="text-center min-w-[80px]">
                  <div class="text-5xl font-bold text-gray-900 tabular-nums leading-none" data-shift-split-target="countDisplay">2</div>
                  <div class="text-[11px] text-gray-500 uppercase tracking-wider mt-1">Segments</div>
                </div>
                <button type="button" data-action="click->shift-split#increment"
                        class="w-10 h-10 rounded-full border border-gray-300 bg-white hover:bg-gray-50 hover:border-gray-400 text-xl font-medium text-gray-700 cursor-pointer flex items-center justify-center transition-colors">
                  +
                </button>
              </div>

              <div class="space-y-4" data-shift-split-target="segmentsContainer">
                <%# Populated by JS — each segment is a dual-handle slider. %>
              </div>

              <div class="bg-amber-50 border border-amber-200 rounded text-xs text-amber-900 p-2.5">
                Existing assignments stay on segment #1. New segments start empty.
              </div>
            </div>
            <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
              <button type="button" data-action="click->shift-split#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
              <%= render "shared/button", text: "Split", variant: "primary", size: "small", type: :submit %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# === Add shift modal — progressive: pick a role, and the rest of the form
      reveals itself already filled in (suggested times you can edit, the show
      for per-show roles, and the qualified people so you can staff it in the
      same breath). %>
  <div data-shift-add-target="modal"
       class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->shift-add#backdropClose keydown.esc@window->shift-add#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-md bg-white rounded-xl shadow-2xl"
           data-action="click->shift-add#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <div>
            <h3 class="text-lg font-semibold text-white">Add shift</h3>
            <div class="text-xs text-white/80" data-shift-add-target="subtitle"></div>
          </div>
          <button type="button" data-action="click->shift-add#close" class="text-white/70 hover:text-white cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <%= form_with url: manage_create_staffing_shift_path, method: :post, local: true,
                      data: { "shift-add-target": "form" }, scope: :shift do |f| %>
          <div class="px-5 py-4 space-y-3">
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">Role</label>
              <%= f.select :house_role_id,
                    @house_roles.map { |r| [r.name, r.id] },
                    { include_blank: "Choose a role…" },
                    data: { "shift-add-target": "roleSelect", action: "change->shift-add#roleChanged" },
                    class: "block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500" %>
              <p class="hidden text-[11px] text-gray-500 mt-1" data-shift-add-target="roleHint"></p>
            </div>

            <%# Everything below reveals once a role is chosen. %>
            <div data-shift-add-target="details" class="hidden space-y-3">
              <%# Which shows — per-show roles only; the day's shows render as a
                  checkbox list so one shift can cover several back-to-back shows
                  (one tech working all three). The first checked show is the
                  anchor (source); the rest ride along as extra covered shows. %>
              <div data-shift-add-target="showRow" class="hidden">
                <label class="block text-xs font-medium text-gray-700 mb-1">Shows</label>
                <div data-shift-add-target="showList"
                     class="space-y-1.5 rounded border border-gray-300 shadow-sm px-3 py-2 max-h-36 overflow-y-auto"></div>
                <p class="text-[11px] text-gray-500 mt-1">Check every show this shift covers.</p>
              </div>

              <%# Suggested times, fully editable. %>
              <div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Starts</label>
                    <input type="time" step="300"
                           data-shift-add-target="startTimeInput"
                           data-action="input->shift-add#timesEdited"
                           class="block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500">
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Ends</label>
                    <input type="time" step="300"
                           data-shift-add-target="endTimeInput"
                           data-action="input->shift-add#timesEdited"
                           class="block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500">
                  </div>
                </div>
                <p class="text-[11px] text-gray-500 mt-1" data-shift-add-target="timeHint"></p>
              </div>

              <%# Staff it now (optional). Qualified people for the chosen role,
                  rendered by JS with busy/unavailable badges. %>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Who's working it <span class="font-normal text-gray-400">(optional — leave blank to staff later)</span></label>
                <div data-shift-add-target="people" class="grid grid-cols-2 gap-1.5 max-h-64 overflow-y-auto"></div>
              </div>
            </div>

            <%# Hidden full datetimes — kept in sync with the time inputs. %>
            <%= f.hidden_field :starts_at, data: { "shift-add-target": "startInput" } %>
            <%= f.hidden_field :ends_at,   data: { "shift-add-target": "endInput" } %>
            <%# Anchors the shift to a show so it groups on that show's day even
                when its hours cross midnight. Blank for no-show days. %>
            <%= f.hidden_field :source_type, data: { "shift-add-target": "sourceTypeInput" } %>
            <%= f.hidden_field :source_id,   data: { "shift-add-target": "sourceIdInput" } %>
            <%# Extra covered shows beyond the source anchor — filled by JS when
                more than one show is checked. %>
            <span data-shift-add-target="showIdsWrap"></span>
            <%= hidden_field_tag :person_id, nil, data: { "shift-add-target": "personIdInput" } %>
            <%# 1 when the person picked is "Someone else", not on this role. %>
            <%= hidden_field_tag :anyone, "0", data: { "shift-add-target": "anyoneInput" } %>
            <%= f.hidden_field :required_count, value: 1 %>
            <%= f.hidden_field :coverage_mode,  value: "needs_assignment" %>
          </div>
          <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
            <button type="button" data-action="click->shift-add#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
            <span data-shift-add-target="submitWrap" class="opacity-40 pointer-events-none">
              <%= render "shared/button", text: "Add shift", variant: "primary", size: "small", type: :submit %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# === Finalize & notify modal === %>
  <div data-staffing-finalize-target="modal"
       class="hidden fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm overflow-y-auto"
       data-action="click->staffing-finalize#backdropClose keydown.esc@window->staffing-finalize#close">
    <div class="flex min-h-full items-start justify-center p-4 py-12">
      <div class="relative w-full max-w-xl bg-white rounded-xl shadow-2xl"
           data-action="click->staffing-finalize#stopPropagation">
        <div class="flex items-center justify-between px-5 py-4 bg-pink-500 rounded-t-xl">
          <div>
            <h3 class="text-lg font-semibold text-white">Publish &amp; notify</h3>
            <div class="text-xs text-white/80">Week of <%= @week_start.strftime("%b %-d, %Y") %></div>
          </div>
          <button type="button" data-action="click->staffing-finalize#close" class="text-white/70 hover:text-white cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <%= form_with url: manage_finalize_staffing_path(week_start: @week_start.to_s), method: :post, local: true do %>
          <div class="px-5 py-4 space-y-4">
            <%# Who's being notified. %>
            <div>
              <div class="text-xs font-semibold text-gray-500 uppercase mb-2">
                Notifying <%= pluralize(@finalize_recipients.count { |r| r[:notifiable] }, "staff member") %>
              </div>
              <% if @finalize_recipients.any? %>
                <div class="border border-gray-200 rounded-lg divide-y divide-gray-100 max-h-44 overflow-y-auto">
                  <% @finalize_recipients.each do |r| %>
                    <div class="flex items-center gap-2.5 px-3 py-2">
                      <% v = r[:person].safe_headshot_variant(:thumb) %>
                      <% if v %>
                        <%= image_tag v, alt: r[:person].name, class: "w-7 h-7 rounded-lg object-cover flex-shrink-0" %>
                      <% else %>
                        <span class="w-7 h-7 rounded-lg bg-gray-200 text-gray-600 flex items-center justify-center text-[10px] font-bold flex-shrink-0"><%= r[:person].initials %></span>
                      <% end %>
                      <span class="text-sm <%= r[:notifiable] ? "text-gray-900" : "text-gray-400" %> flex-1 min-w-0 truncate"><%= r[:person].name %></span>
                      <span class="text-xs text-gray-500 flex-shrink-0"><%= pluralize(r[:shift_count], "shift") %></span>
                      <% unless r[:notifiable] %>
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-gray-200 text-gray-600 flex-shrink-0" title="No CocoScout login — can't be notified. Invite them from the Staff page.">won't be notified</span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
                <% if @finalize_recipients.any? { |r| !r[:notifiable] } %>
                  <p class="text-[11px] text-amber-700 mt-2">
                    Some staff have no CocoScout account, so they won't get this notification.
                    <%= link_to "Invite them from the Staff page", manage_staffing_staff_path, class: "underline hover:text-amber-800" %>.
                  </p>
                <% end %>
              <% else %>
                <p class="text-sm text-gray-500 italic">No staff are assigned this week yet. Finalizing will mark the week ready, but no one will be notified.</p>
              <% end %>
            </div>

            <%# Editable message template. Each person additionally receives their
                own shift list + a My Shifts link appended automatically. %>
            <div>
              <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Subject</label>
              <input type="text" name="subject" value="<%= default_finalize_subject %>"
                     class="block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Message</label>
              <textarea name="message" rows="3"
                        class="block w-full text-sm shadow-sm rounded border border-gray-300 px-3 py-2 focus:ring-pink-500 focus:border-pink-500"><%= default_finalize_intro %></textarea>
              <p class="text-[11px] text-gray-500 mt-1">
                Sent from CocoScout as an automated notification. Each person's own list of shifts and a link to their
                <strong>My Shifts</strong> page are added automatically below your message.
              </p>
            </div>
          </div>
          <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-gray-200">
            <button type="button" data-action="click->staffing-finalize#close" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">Cancel</button>
            <%= render "shared/button", text: "Publish & send", variant: "primary", size: "small", type: :submit %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  </div>
</div>
