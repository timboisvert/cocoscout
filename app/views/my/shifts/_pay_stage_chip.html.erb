<%# A pay stage as a small pill (the Getting paid card's big block): a dot in
    the stage's color, or a check once deposited. Locals: stage
    (:waiting, :approved, :on_its_way, :deposited, :sent). %>
<% chips = {
     waiting: [ "Waiting for approval", "text-amber-800", "bg-amber-600" ],
     approved: [ "Approved", "text-slate-700", "bg-slate-500" ],
     on_its_way: [ "On its way", "text-blue-800", "bg-blue-600" ],
     deposited: [ "Deposited", "text-green-800", nil ],
     sent: [ "Sent", "text-gray-700", "bg-gray-500" ]
   } %>
<% label, text, dot = chips.fetch(stage) %>
<span class="inline-flex items-center gap-1.5 rounded-full bg-white px-2.5 py-0.5 text-xs font-semibold <%= text %>">
  <% if dot %>
    <span class="w-1.5 h-1.5 rounded-full <%= dot %>" aria-hidden="true"></span>
  <% else %>
    <svg class="w-3 h-3 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
  <% end %>
  <%= label %>
</span>
