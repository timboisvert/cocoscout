<%# The QR modal a qr-code Stimulus controller opens. Sits inside an element
    with data-controller="qr-code" and data-qr-code-url-value. Locals: url, title.
    The pink header every modal has. On a phone the button saves or shares
    the image through the phone's share sheet (qr_code_controller#download);
    on a computer it downloads the file. %>
<div data-qr-code-target="modal"
     data-action="click->qr-code#closeOnBackdrop keydown.escape@window->qr-code#closeOnEscape"
     class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-xl max-w-sm w-full overflow-hidden">
    <div class="flex items-center justify-between gap-3 bg-gradient-to-r from-pink-500 to-pink-600 px-5 py-4">
      <h3 class="min-w-0 text-lg font-semibold text-white truncate"><%= title %></h3>
      <button type="button" data-action="click->qr-code#close" aria-label="Close"
              class="flex-shrink-0 rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="p-6">
      <div class="flex flex-col items-center mb-4">
        <canvas data-qr-code-target="canvas" class="rounded-lg max-w-full h-auto"></canvas>
      </div>

      <p class="text-xs text-gray-500 text-center break-all mb-4"><%= url %></p>

      <div class="flex justify-center">
        <%# Wrappers carry the visibility: the button itself is inline-flex. %>
        <span class="pointer-coarse:hidden">
          <%= render "shared/button", text: "Download QR Code", variant: "primary", size: "small", type: :button, icon: "download",
                data: { action: "click->qr-code#download" } %>
        </span>
        <span class="hidden pointer-coarse:inline">
          <%= render "shared/button", text: "Save or share QR code", variant: "primary", size: "small", type: :button, icon: "download",
                data: { action: "click->qr-code#download" } %>
        </span>
      </div>
    </div>
  </div>
</div>
