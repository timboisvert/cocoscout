<%# One person or group the People Picker found. Locals: member, query,
    connected (the organization's own: their email shows), taken (a label
    when they can't be picked), badge, badge_tone ("pink" or "gray"). %>
<%
  person = member.is_a?(Person)
  headshot = member.respond_to?(:safe_headshot_variant) ? member.safe_headshot_variant(:thumb) : nil
  detail = person ? searched_detail(member, query, connected: connected) : "Group"
  pick = {
    type: member.class.name, id: member.id, name: member.name, initials: member.initials,
    email: (person ? searched_email(member.email, query, connected: connected) : nil),
    headshotUrl: (headshot ? url_for(headshot) : nil), userId: (person ? member.user_id : nil),
    outside: !connected, inPool: badge == "In the talent pool"
  }
  tone = badge_tone == "gray" ? "bg-gray-100 text-gray-600" : "bg-pink-50 text-pink-700"
%>
<%= tag.button type: "button", disabled: taken.present?,
      class: "w-full flex items-center gap-3 px-3 min-h-[56px] py-2 text-left #{taken ? 'opacity-60 cursor-default bg-gray-50' : 'cursor-pointer hover:bg-pink-50'}",
      data: { action: ("click->people-picker#pick" unless taken), pick: pick.to_json, people_picker_row: "#{member.class.name}_#{member.id}" }.compact do %>
  <% if headshot %>
    <%= image_tag headshot, alt: member.name, class: "w-10 h-10 rounded-lg object-cover flex-shrink-0" %>
  <% else %>
    <div class="w-10 h-10 rounded-lg <%= person ? 'bg-gray-200 text-gray-600' : 'bg-blue-100 text-blue-600' %> flex items-center justify-center font-bold text-sm flex-shrink-0"><%= member.initials %></div>
  <% end %>
  <span class="flex-1 min-w-0">
    <span class="block text-sm font-medium text-gray-900 truncate"><%= member.name %></span>
    <% if detail.present? %><span class="block text-xs text-gray-500 truncate"><%= detail %></span><% end %>
  </span>
  <% if taken %>
    <span class="text-xs text-gray-500 flex-shrink-0" data-people-picker-taken><%= taken %></span>
  <% elsif badge %>
    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium flex-shrink-0 <%= tone %>"><%= badge %></span>
  <% end %>
  <% unless taken %>
    <svg class="w-4 h-4 text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
  <% end %>
<% end %>
