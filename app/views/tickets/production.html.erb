<%
  setup = @production.production_ticketing
  selected = @listing
  title = setup&.title.presence || @production.name
  # A date with a title of its own (set on its ticketing Page tab, or a name
  # given to the show that isn't just the suggested one) leads with it, and
  # the production's name goes under the place (Tim, 2026-10-08).
  own_title = selected&.own_title
  heading = own_title || title
  share_title = @dated ? heading : title
  # The chosen date's words and notes (its own, else the production's), so a
  # date with its own description says it on its page.
  description = selected ? selected.effective_description.presence : (setup&.description.presence || @production.description.presence)
  notes = if selected then [ selected.effective_door_note, selected.effective_accessibility_note ].compact_blank
  elsif setup then [ setup.door_note, setup.accessibility_note ].compact_blank
  else []
  end
  # A link to the production describes the production; one to a date, that date.
  share_description = @dated ? description : (setup&.description.presence || @production.description.presence || description)
  page_url = @dated && selected ? tickets_event_url(org: @ticketing_profile.slug, event: selected.slug) : ticket_production_url(@ticketing_profile, @production)
  date_path = ->(listing) { tickets_event_path(org: @ticketing_profile.slug, event: @production.public_key, date: listing.slug, code: @code, **embed_params) }
  # The picture is the chosen date's (Show#ticket_page_image: its own wide
  # image, its own poster, then the production's), so each date's page
  # shows that date's art; with no date to show, the production's.
  production_wide = @production.wide_image.attached? ? @production.safe_wide_image_variant : nil
  production_image = production_wide || @production.safe_poster_variant(:large) || @production.safe_poster_variant(:small)
  date_image, date_page_image = selected && ticket_page_image(selected)
  image = date_image || production_image
  wide = date_image ? date_page_image.wide? : production_wide.present?
  image_url = image && url_for(image)
  # A shared link to the production shows the production's picture; one to a
  # date shows that date's.
  share_image_url = @dated ? image_url : (production_image && url_for(production_image)) || image_url
  # The chosen date's ages, which can differ from the production's.
  ages = selected ? selected.age_words : setup&.age_words
  show = selected&.show
  venue = show && [ show.location&.name, show.location_space&.name ].compact.uniq.join(" · ")
  address = show&.location && [ show.location.address1, show.location.city, show.location.state ].compact_blank.join(", ")
  map_url = address.present? ? "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode([ show.location.name, address ].compact.join(', '))}" : nil
  # A date's one word about itself: nothing while it's simply on sale.
  chip_note = ->(listing) { public_listing_note(listing) }
  # Many dates and none in the link: the list is open and nothing is chosen
  # yet, so there's no card, no Close and no tickets until a date is picked
  # (Tim, 2026-10-18, option C).
  picking = @listings.many? && !@dated
  by_month = @listings.group_by { |listing| listing.show.date_and_time.beginning_of_month }.sort_by { |month, _| month }
  open_month = picking ? by_month.first&.first : selected&.show&.date_and_time&.beginning_of_month
%>
<%
  # Search engines read this to list the chosen date (schema.org Event with
  # all-in offers), as the date's own page did.
  structured = if selected && !@preview
    payload = Ticketing::ListingPayload.for(selected)
    pv = payload[:venue]
    {
      "@context" => "https://schema.org", "@type" => "Event", "name" => payload[:title],
      "startDate" => payload[:starts_at], "endDate" => payload[:ends_at],
      "eventStatus" => show.canceled ? "https://schema.org/EventCancelled" : "https://schema.org/EventScheduled",
      "eventAttendanceMode" => show.is_online ? "https://schema.org/OnlineEventAttendanceMode" : "https://schema.org/OfflineEventAttendanceMode",
      "description" => description.to_s.truncate(500).presence, "image" => image_url,
      "typicalAgeRange" => (selected.effective_minimum_age && "#{selected.effective_minimum_age}-"),
      "organizer" => { "@type" => "Organization", "name" => @organization.name, "url" => tickets_box_office_url(org: @ticketing_profile.slug) },
      "performer" => { "@type" => "PerformingGroup", "name" => @production.name },
      "location" => pv && { "@type" => "Place", "name" => pv[:name],
                            "address" => { "@type" => "PostalAddress", "streetAddress" => pv[:address1], "addressLocality" => pv[:city],
                                           "addressRegion" => pv[:state], "postalCode" => pv[:postal_code], "addressCountry" => "US" }.compact },
      "offers" => payload[:tiers].map { |tier|
        { "@type" => "Offer", "name" => tier[:name], "price" => format("%.2f", tier[:all_in_price_cents] / 100.0), "priceCurrency" => "USD",
          "availability" => tier[:remaining]&.zero? ? "https://schema.org/SoldOut" : "https://schema.org/InStock", "url" => page_url }
      }
    }.compact
  end
%>
<% content_for :title, "#{share_title} · #{@organization.name}" %>
<% content_for :head do %>
  <%= canonical_link_tag(URI(page_url).path) unless @preview %>
  <% if structured %><script type="application/ld+json"><%= json_escape(structured.to_json).html_safe %></script><% end %>
  <meta name="description" content="<%= share_description.to_s.truncate(160) %>">
  <meta property="og:title" content="<%= share_title %> · <%= @organization.name %>">
  <meta property="og:description" content="<%= share_description.to_s.truncate(200) %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= page_url %>">
  <% if share_image_url %>
    <meta property="og:image" content="<%= share_image_url %>">
    <meta name="twitter:card" content="summary_large_image">
  <% end %>
<% end %>

<%# Layout A, for a production with many dates: the production, pick a date,
    then that date's tickets, all on one page. %>
<div class="mx-auto max-w-xl space-y-5">
  <% if image_url %>
    <%= image_tag image_url, alt: (wide ? "" : "#{@production.name} poster"),
          class: wide ? "w-full h-auto rounded-2xl" : "mx-auto max-h-[28rem] w-auto h-auto rounded-2xl" %>
  <% end %>

  <%# The name, then the date (when there's one date), where, the notes, and
      the ages last (Tim, 2026-10-18). With many dates the chosen one is the
      card below, said once. %>
  <div class="text-center space-y-1.5">
    <h1 class="text-3xl sm:text-4xl coustard-regular text-gray-900"><%= heading %></h1>
    <% if show && @listings.one? %>
      <p class="text-base text-gray-800"><%= show.date_and_time.strftime("%A, %B %-d · %-l:%M %p") %></p>
    <% end %>
    <% if show && !picking %>
      <% if show.is_online %>
        <p class="text-sm text-gray-600">Online</p>
      <% elsif venue.present? %>
        <p class="text-sm text-gray-600">
          <%= venue %><% if address.present? %> · <%= address %><% end %>
          <% if map_url %> · <%= link_to "Directions", map_url, target: "_blank", rel: "noopener", class: "text-pink-700 hover:text-pink-800" %><% end %>
        </p>
      <% end %>
      <% if own_title %><p class="text-sm text-gray-600"><%= title %></p><% end %>
    <% end %>
    <% if notes.any? %><p class="text-sm text-gray-600"><%= notes.join(" · ") %></p><% end %>
    <% if ages %><p class="text-sm font-semibold text-gray-900"><%= ages %></p><% end %>
  </div>

  <% if @listings.empty? %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-6 text-center text-gray-700">No dates on sale right now.</div>
  <% else %>
    <%# Pick a date (option C, Tim 2026-10-18): the chosen date is a card with
        Change date; the list of every date, by month, takes its place while
        choosing. One date needs no picking. %>
    <% unless @listings.one? %>
      <div data-controller="ticket-dates">
        <% unless picking %>
          <div data-ticket-dates-target="card">
            <div class="rounded-2xl border border-gray-200 bg-white pl-4 pr-2.5 py-2.5 flex items-center gap-3" data-chosen-date>
              <div class="flex-shrink-0 w-10 text-center leading-none">
                <div class="text-[10px] font-semibold uppercase text-pink-600"><%= show.date_and_time.strftime("%a") %></div>
                <div class="text-[22px] font-bold text-gray-900"><%= show.date_and_time.day %></div>
                <div class="text-[10px] uppercase text-gray-500"><%= show.date_and_time.strftime("%b") %></div>
              </div>
              <div class="flex-1 min-w-0 font-semibold text-gray-900 truncate"><%= show.date_and_time.strftime("%a, %b %-d · %-l:%M %p") %></div>
              <%= render "shared/button", text: "Change date", variant: "secondary", size: "small", type: :button, data: { action: "click->ticket-dates#open" } %>
            </div>
          </div>
        <% end %>
        <div data-ticket-dates-target="list" class="<%= 'hidden' unless picking %>">
          <nav class="rounded-2xl border border-gray-200 bg-white overflow-hidden" aria-label="Pick a date">
            <div class="flex items-center justify-between px-4 py-3">
              <h2 class="font-semibold text-gray-900">Select a date</h2>
              <% unless picking %>
                <%= render "shared/button", text: "Close", variant: "ghost", size: "small", type: :button, data: { action: "click->ticket-dates#close" } %>
              <% end %>
            </div>
            <% by_month.each do |month, month_listings| %>
              <%# One month open at a time (Tim, 2026-10-18): the name makes the
                  browser fold the others; ticket-dates#only does it where it won't. %>
              <details name="ticket-months" class="group border-t border-gray-100" data-action="toggle->ticket-dates#only" <%= "open" if month == open_month %>>
                <summary class="flex items-center justify-between px-4 py-2 bg-gray-50 cursor-pointer list-none [&::-webkit-details-marker]:hidden text-[11px] font-semibold uppercase tracking-wide text-gray-500">
                  <span><%= month.strftime("%B") %><%= " #{month.year}" if month.year != Date.current.year %></span>
                  <span class="text-xs font-normal normal-case tracking-normal text-gray-500 group-open:hidden">Show <%= pluralize(month_listings.size, "date") %></span>
                </summary>
                <% month_listings.each do |listing| %>
                  <% current = listing == selected %>
                  <% note = chip_note.call(listing) %>
                  <% sold_out = note == "Sold out" %>
                  <% from = listing_from_price_cents(listing) %>
                  <%= link_to date_path.call(listing), aria: { current: current ? "page" : nil },
                        class: "flex items-center gap-3 px-4 py-2 border-t border-gray-100 whitespace-nowrap #{current ? 'bg-pink-50' : 'hover:bg-gray-50'} #{'text-gray-400' if sold_out}" do %>
                    <span class="flex-shrink-0 w-10 text-center leading-none">
                      <span class="block text-[10px] font-semibold uppercase <%= sold_out ? 'text-gray-400' : 'text-pink-600' %>"><%= listing.show.date_and_time.strftime("%b") %></span>
                      <span class="block text-xl font-bold <%= sold_out ? 'text-gray-400' : 'text-gray-900' %>"><%= listing.show.date_and_time.day %></span>
                      <span class="block text-[10px] uppercase text-gray-500"><%= listing.show.date_and_time.strftime("%a") %></span>
                    </span>
                    <span class="flex-1 min-w-0 text-sm font-semibold <%= sold_out ? 'text-gray-400' : 'text-gray-900' %>"><%= listing.show.date_and_time.strftime("%-l:%M %p") %></span>
                    <span class="flex-shrink-0 flex items-baseline gap-2 text-xs">
                      <% if note %><span class="font-medium <%= sold_out ? 'text-gray-500' : 'text-amber-700' %>"><%= note %></span><% end %>
                      <% if from && !sold_out %><span class="font-semibold text-gray-900"><%= from.zero? ? "Free" : "From #{number_to_currency(from / 100.0)}" %></span><% end %>
                    </span>
                  <% end %>
                <% end %>
              </details>
            <% end %>
          </nav>
        </div>
      </div>
    <% end %>

    <% unless picking %>
    <%= render "tickets/picker", listing: selected, tiers: @tiers, inventory: @inventory, tax: @tax, code: @code, preview: @preview,
          profile: @ticketing_profile, code_url: tickets_event_path(org: @ticketing_profile.slug, event: @production.public_key, date: selected.slug, **embed_params) %>
    <% Array(@passes).each do |pass| %>
      <%= render "tickets/pass_card", pass: pass, profile: @ticketing_profile, save: true %>
    <% end %>
    <% end %>
  <% end %>

  <% if description.present? %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
      <h2 class="font-semibold text-gray-900">About the show</h2>
      <div class="mt-2 text-gray-700 space-y-3 leading-relaxed"><%= simple_format(description) %></div>
    </div>
  <% end %>

  <% if selected && !picking %><%= render "tickets/refund_policy", listing: selected, tiers: @tiers %><% end %>
</div>
