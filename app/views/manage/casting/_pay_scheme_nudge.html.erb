<%# "Pay by act?" — shown on an act-based production's casting page until a
    payout scheme is set for it (see PayoutHelper#production_needs_per_act_scheme_nudge?).

    Locals:
      production (required) %>
<%= render "shared/alert_panel",
      eyebrow: "Pay",
      headline: "Pay by act?",
      body: "This production casts by acts. Set up a per-act payout scheme so each night's pay follows the lineup.",
      actions: [
        { text: "Set up per-act pay",
          path: manage_presets_money_payout_schemes_path(preset: "per_act", production_id: production.id) }
      ] %>
