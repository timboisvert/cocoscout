<%#
  Money box on the show page — a bridge to this show's money pages. Pro-only.
  Three tiles: Financials, Payouts, Advances, each with the headline number and a
  link to the full page.

  Locals: show, production
%>
<% if production.organization.on_paid_plan? %>
  <%
    fin = show.show_financials

    payout = show.show_payout
    if payout&.calculated_at
      pay_items = payout.line_items.to_a
      pay_awaiting = pay_items.reject(&:paid?).sum(&:net_amount)
      pay_paid = pay_items.select(&:paid?).sum(&:net_amount)
    end

    advances = show.person_advances.outstanding.to_a
    adv_to_pay = advances.select(&:unpaid?).sum(&:original_amount)
    adv_to_repay = advances.select(&:paid?).sum(&:remaining_balance)
    adv_total = adv_to_pay + adv_to_repay

    tile_class = "block rounded-lg border border-gray-200 p-3 hover:border-pink-300 hover:bg-gray-50 transition"
  %>
  <div class="border border-gray-200 rounded-lg overflow-hidden">
    <div class="bg-gray-50 px-4 py-3 border-b border-gray-200 flex items-center gap-2">
      <h3 class="text-md font-semibold text-gray-900 coustard-regular">Money</h3>
      <%= render "shared/pro_marker" %>
    </div>

    <div class="p-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
      <%# Financials — total, then a line per revenue source and expenses. %>
      <%= link_to manage_money_show_financials_path(show), class: tile_class do %>
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Financials</div>
        <% if fin&.has_data? %>
          <div class="mt-1 text-lg font-semibold text-gray-900 tabular-nums"><%= number_to_currency(fin.total_revenue) %></div>
          <div class="text-xs text-gray-500 space-y-0.5 mt-0.5">
            <% if fin.ticket_sales? && fin.ticket_count.to_i > 0 %>
              <div><%= pluralize(fin.ticket_count, "ticket") %> · <%= number_to_currency(fin.ticket_revenue) %></div>
            <% elsif fin.flat_fee? && fin.flat_fee.to_f > 0 %>
              <div>Flat fee · <%= number_to_currency(fin.flat_fee) %></div>
            <% end %>
            <% if fin.calculated_other_revenue.to_f > 0 %>
              <div><%= number_to_currency(fin.calculated_other_revenue) %> other revenue</div>
            <% end %>
            <% if fin.calculated_expenses.to_f > 0 %>
              <div><%= number_to_currency(fin.calculated_expenses) %> expenses</div>
            <% end %>
          </div>
        <% else %>
          <div class="mt-1 text-sm font-medium text-pink-600">Add financials →</div>
        <% end %>
      <% end %>

      <%# Payouts — remaining to pay, then simply how much is paid. %>
      <%= link_to manage_money_show_payout_path(show), class: tile_class do %>
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Payouts</div>
        <% if payout&.calculated_at %>
          <div class="mt-1 text-lg font-semibold <%= pay_awaiting > 0 ? 'text-pink-600' : 'text-gray-900' %> tabular-nums"><%= number_to_currency(pay_awaiting) %></div>
          <div class="text-xs text-gray-500"><%= pay_awaiting > 0 ? "#{number_to_currency(pay_paid)} paid" : "all paid" %></div>
        <% else %>
          <div class="mt-1 text-sm font-medium text-pink-600">Calculate payout →</div>
        <% end %>
      <% end %>

      <%# Advances %>
      <% if advances.any? %>
        <%= link_to manage_money_production_advances_path(production), class: tile_class do %>
          <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Advances</div>
          <div class="mt-1 text-lg font-semibold text-amber-600 tabular-nums"><%= number_to_currency(adv_total) %></div>
          <div class="text-xs text-gray-500"><%= pluralize(advances.size, "advance") %> outstanding</div>
        <% end %>
      <% else %>
        <%= link_to manage_new_money_production_advance_path(production), class: tile_class do %>
          <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Advances</div>
          <div class="mt-1 text-sm text-gray-400">None</div>
          <div class="text-sm font-medium text-pink-600">Issue an advance →</div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
