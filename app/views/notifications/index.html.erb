<% content_for :title, "Notifications" %>

<%# Everything automated that reached this person, read or not (V1.1 plan
    §9). A row whose page lives in production mode asks before switching
    there from My, unless they said not to (notification-open controller). %>
<div class="w-full pb-8" data-controller="notification-open"
     data-notification-open-ask-value="<%= @ask_before_switching %>"
     data-notification-open-remember-url-value="<%= notifications_switch_without_asking_path %>">
  <%= render "shared/module_header", title: "Notifications", actions: [
        { icon: "check", text: "Mark all read", path: read_notifications_path(filter: (@filter == "all" ? nil : @filter), area: @area), method: :post,
          form: { data: { turbo_frame: "page" } },
          badge: (Current.user.unread_notification_count if Current.user.unread_notification_count.positive?), disabled: Current.user.unread_notification_count.zero? },
        { icon: "cog", text: "Settings", path: account_notifications_path, variant: "secondary" }
      ] %>

  <div class="mt-4">
    <%= render "shared/filters/filter_bar",
          toggle_label: "Filters",
          filter_groups: [
            { label: "Show", filters: [
              { text: "All", path: notifications_path(area: @area), active: @filter == "all" },
              { text: "Unread", path: notifications_path(filter: "unread", area: @area), active: @filter == "unread" }
            ] },
            (NotificationGroups.areas.size > 1 ? { separator: true } : nil),
            (NotificationGroups.areas.size > 1 ? {
              partial: "shared/filters/dropdown_filter",
              locals: { label: "About", name: "area", selected: @area.to_s,
                        options: [ { value: "", text: "Everything" } ] + NotificationGroups.areas.map { |area| { value: area, text: area } },
                        extra_url_params: { filter: (@filter == "all" ? nil : @filter) } }
            } : nil)
          ].compact %>
  </div>

  <% if @notifications.any? %>
    <% today = Time.zone.today %>
    <% sections = @notifications.group_by { |n| d = n.created_at.in_time_zone.to_date; d == today ? "Today" : (d == today - 1 ? "Yesterday" : "Earlier") } %>
    <div class="mt-4 bg-white border border-gray-200 rounded-lg overflow-hidden">
      <% sections.each_with_index do |(label, rows), section_index| %>
        <div class="px-4 sm:px-5 pt-3 pb-1 text-xs font-semibold uppercase tracking-wider text-gray-500 <%= 'border-t border-gray-100' if section_index.positive? %>"><%= label %></div>
        <ul class="divide-y divide-gray-100">
          <% rows.each do |n| %>
            <li class="relative flex items-start gap-3 sm:gap-4 px-4 sm:px-5 py-3 hover:bg-gray-50 transition-colors">
              <%# On a phone the time sits under the icon (and unread is a dot on it),
                  so the words get the row's width (Tim, 2026-10-29). %>
              <span class="flex flex-col items-center gap-1 flex-shrink-0 w-12 -mx-1.5 sm:w-auto sm:mx-0">
                <span class="relative w-9 h-9 rounded-lg flex items-center justify-center <%= n.read? ? 'bg-gray-100 text-gray-500' : 'bg-pink-50 text-pink-600' %>">
                  <%= render "notifications/icon", category: n.category %>
                  <% unless n.read? %><span class="sm:hidden absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-pink-500 ring-2 ring-white" aria-label="Unread"></span><% end %>
                </span>
                <span class="sm:hidden text-[10px] leading-none text-gray-500 whitespace-nowrap"><%= label == "Earlier" ? n.created_at.in_time_zone.strftime("%b %-d") : n.created_at.in_time_zone.strftime("%-l:%M %p") %></span>
              </span>
              <span class="min-w-0 flex-1">
                <%# The title's link covers the whole row (after:inset-0); Reply sits above it. %>
                <%
                  # A notice whose page lives in production mode asks first from
                  # My, or from another organization's production mode; one for
                  # the organization already open, or a My page, just opens.
                  other_organization = @in_production_mode && n.organization_id && n.organization_id != Current.organization&.id
                  switching = n.production_mode? && (!@in_production_mode || other_organization)
                  switch_words = if switching && @in_production_mode
                    [ "Switch to #{n.organization&.name || 'that organization'}?", "This is #{n.organization&.name || 'another organization'}'s. You'll switch to that organization to open it." ]
                  elsif switching
                    [ "Open in production mode?", "This lives in production mode for #{n.organization&.name || 'your organization'}. You'll switch there to see it, and can exit from the account menu." ]
                  end
                %>
                <a href="<%= open_notification_path(n) %>"
                   class="block text-sm leading-snug text-gray-900 after:absolute after:inset-0 <%= 'font-semibold' unless n.read? %>"
                   data-switch="<%= switching %>"
                   <% if switch_words %>data-switch-title="<%= switch_words[0] %>" data-switch-body="<%= switch_words[1] %>"<% end %>
                   data-organization-name="<%= n.organization&.name %>"
                   data-action="click->notification-open#open"><%= n.title %></a>
                <%# The organization's name gives way first, so the group always shows. %>
                <span class="flex min-w-0 text-xs text-gray-500 mt-0.5 sm:block">
                  <% if n.organization %><span class="truncate sm:whitespace-normal"><%= n.organization.name %></span><span class="flex-shrink-0 whitespace-pre"> · </span><% end %><span class="flex-shrink-0"><%= n.group.label %></span>
                </span>
                <% if n.reply_path.present? %>
                  <span class="relative z-10 inline-flex mt-1.5"><%= render "shared/button", text: "Reply", variant: "secondary", size: "small", path: n.reply_path %></span>
                <% end %>
              </span>
              <span class="hidden sm:flex items-center gap-2 flex-shrink-0 pt-0.5 text-xs text-gray-500 whitespace-nowrap">
                <%= label == "Today" ? "#{time_ago_in_words(n.created_at)} ago" : (label == "Yesterday" ? n.created_at.in_time_zone.strftime("%-l:%M %p") : n.created_at.in_time_zone.strftime("%b %-d")) %>
                <% unless n.read? %><span class="w-2 h-2 rounded-full bg-pink-500" aria-label="Unread"></span><% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-6 flex items-center justify-between">
        <div class="text-sm text-gray-500">Page <%= @pagy.page %> of <%= @pagy.pages %></div>
        <div class="flex gap-2">
          <%= render "shared/button", text: "← Newer", variant: "secondary", size: "small", **(@pagy.previous ? { path: notifications_path(page: @pagy.previous, filter: @filter, area: @area) } : { disabled: true }) %>
          <%= render "shared/button", text: "Older →", variant: "secondary", size: "small", **(@pagy.next ? { path: notifications_path(page: @pagy.next, filter: @filter, area: @area) } : { disabled: true }) %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="mt-6"><%= render "shared/empty_state", icon: "bell", title: (@filter == "unread" ? "Nothing unread" : "Nothing yet"), body: (@filter == "unread" ? nil : "Things that happen, like a ticket selling or a contract being signed, show up here.") %>
    </div>
  <% end %>

  <%# Asked before a notification opens production mode from My. %>
  <%= render "shared/mode_switch_prompt" %>
</div>
