<%# Rules from a file (BankRulesFile): the one Export rules wrote on another
    organization, or this one in development. Rules already here are
    skipped, so bringing the same file twice adds nothing. %>
<div id="bank-rules-import-modal"
     class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center sm:p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full sm:max-w-lg sm:mx-4 max-h-[92vh] overflow-y-auto" data-action="click->modal#stopPropagation">
    <div class="sticky top-0 z-10 flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white">Import rules</h3>
      <button type="button" data-action="click->modal#close" aria-label="Close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <%= form_with url: manage_import_money_bank_rules_path, method: :post, multipart: true, data: { turbo: false } do %>
      <div class="px-6 pt-5 pb-6 space-y-4 text-sm text-gray-600">
        <p>A rules file from Export rules, from this organization elsewhere or another one. Rules you already have are left as they are; a rule for a category you don't offer is skipped.</p>
        <label class="block">
          <span class="block text-sm font-medium text-gray-700 mb-1">The file</span>
          <input type="file" name="file" accept=".json,application/json" required class="block w-full text-sm text-gray-700 file:mr-3 file:rounded file:border-0 file:bg-pink-50 file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-pink-700 hover:file:bg-pink-100">
        </label>
        <p class="text-xs text-gray-500">The rules are added, not run. Apply them to the lines waiting from the Rules page when you're ready.</p>
      </div>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-2">
        <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
        <%= render "shared/button", text: "Import", variant: "primary", size: "medium", type: :submit %>
      </div>
    <% end %>
  </div>
</div>
