<% content_for :title, "Invoice #{@invoice.display_number}" %>
<%
  money = ->(cents) { number_to_currency(cents / 100.0) }
  can_change = module_change?(:bills_invoices)
  input = "mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-lg shadow-sm text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
  pay_url = pay_invoice_url(token: @invoice.payment_token!)
  links = [ { text: "Download PDF", path: manage_pdf_money_invoice_path(@invoice, format: :pdf), data: { turbo: false } } ]
  if can_change && @invoice.open?
    links.unshift({ text: (@invoice.sent_count.zero? ? "Send" : "Send again"), path: manage_send_money_invoice_path(@invoice), method: :post })
    links.unshift({ text: "Record a payment", path: "#", data: { controller: "modal", action: "click->modal#open", modal_id: "record-payment" } })
  end
  badge = { void: [ "Cancelled", "bg-gray-100 text-gray-600" ], paid: [ "Paid", "bg-green-50 text-green-700" ], overdue: [ "Overdue", "bg-red-50 text-red-700" ], due: [ "Due #{@invoice.due_on.strftime('%b %-d')}", "bg-amber-50 text-amber-800" ] }[@invoice.state]
%>
<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: { breadcrumbs: [ [ "Money", manage_money_index_path ], [ "Incoming Payments", manage_money_incoming_path ] ], text: "Invoice #{@invoice.display_number}", links: links } %>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_22rem] gap-6 items-start">
    <div class="space-y-4 min-w-0">
      <%= render "shared/invoice_document", document: @document %>
      <section class="rounded-xl border border-gray-200 bg-white px-5 py-4 text-sm text-gray-700">
        <span class="text-[11px] font-medium uppercase tracking-wide text-gray-500 block mb-1">On the books</span>
        <% if @invoice.void? %>Cancelled: nothing stands on the books.<% else %>
          <%= money.call(@invoice.total_cents) %> of <b><%= @invoice.category_label %></b><%= @invoice.production ? " for #{@invoice.production.name}" : "" %>, dated <%= @invoice.issued_on.strftime("%b %-d") %>. <% if @invoice.unpaid_cents.positive? %><%= money.call(@invoice.unpaid_cents) %> sits in <b>Money owed to you</b> until it is paid.<% end %> If you count money when it moved, it shows up on the day it arrives instead.
        <% end %>
        <%= link_to "See the entries", manage_money_books_section_path(section: "entries", kind: "invoice"), class: "ml-1 text-pink-600 hover:text-pink-700" %>
      </section>
    </div>

    <div class="space-y-4">
      <section class="rounded-xl border border-gray-200 bg-white px-5 py-4">
        <div class="flex items-center gap-2 text-xs"><span class="inline-flex rounded-md px-1.5 py-0.5 font-medium <%= badge[1] %>"><%= badge[0] %></span><span class="text-gray-500">Invoice</span></div>
        <h2 class="mt-1 text-2xl font-bold tabular-nums text-gray-900"><%= money.call(@invoice.total_cents) %></h2>
        <% if @invoice.open? && @invoice.paid_cents.positive? %><p class="text-sm text-gray-600"><%= money.call(@invoice.unpaid_cents) %> still owed</p><% end %>
        <dl class="mt-3 space-y-2 text-sm">
          <div><dt class="text-[11px] font-medium uppercase tracking-wide text-gray-500">Sent</dt><dd class="text-gray-900"><%= @invoice.sent_at ? "#{@invoice.sent_at.strftime('%b %-d, %Y')} to #{@invoice.bill_to_email}#{" (#{@invoice.sent_count} times)" if @invoice.sent_count > 1}" : "Not yet" %></dd></div>
          <div><dt class="text-[11px] font-medium uppercase tracking-wide text-gray-500">Reminders</dt><dd class="text-gray-900"><%= Invoice::REMINDERS[@invoice.reminders] %>
            <% if (next_on = @invoice.next_reminder_on) %><span class="block text-xs text-gray-500">The next one goes by itself <%= next_on == Date.current ? "today" : next_on.strftime("%b %-d") %>.</span>
            <% elsif @invoice.open? && @invoice.reminders != "none" && @invoice.sent_count.zero? %><span class="block text-xs text-gray-500">None go until the invoice is sent.</span><% end %></dd></div>
          <div><dt class="text-[11px] font-medium uppercase tracking-wide text-gray-500">They can pay by</dt><dd class="text-gray-900"><%= @invoice.ways_to_pay.presence || "Nothing chosen" %></dd></div>
          <% if @invoice.created_by %><div><dt class="text-[11px] font-medium uppercase tracking-wide text-gray-500">Made by</dt><dd class="text-gray-900"><%= @invoice.created_by.default_person&.name || @invoice.created_by.email_address %></dd></div><% end %>
          <% if @invoice.void_reason.present? %><div><dt class="text-[11px] font-medium uppercase tracking-wide text-gray-500">Cancelled because</dt><dd class="text-gray-900"><%= @invoice.void_reason %></dd></div><% end %>
        </dl>
        <div class="mt-3 pt-3 border-t border-gray-100">
          <span class="text-[11px] font-medium uppercase tracking-wide text-gray-500 block mb-1">Their page</span>
          <div class="flex items-center gap-2" data-controller="copy-url" data-url="<%= pay_url %>">
            <input type="text" readonly value="<%= pay_url %>" class="flex-1 min-w-0 px-2 py-1.5 text-xs text-gray-600 bg-gray-50 border border-gray-200 rounded-lg">
            <button type="button" data-action="click->copy-url#copy" data-copy-url-target="button" class="text-xs text-pink-600 hover:text-pink-700 cursor-pointer"><span>Copy</span></button>
          </div>
        </div>
      </section>

      <section class="rounded-xl border border-gray-200 bg-white overflow-hidden">
        <%= render "shared/section_heading", padding: "px-5 py-3", title: "Payments" %>
        <% if @payments.empty? %>
          <p class="px-5 py-4 text-sm text-gray-500">Nothing yet.<% if can_change && @invoice.open? %> Record it when a check or transfer comes; online payments record themselves.<% end %></p>
        <% else %>
          <ul class="divide-y divide-gray-100">
            <% @payments.each do |p| %>
              <li class="px-5 py-2.5 text-sm flex items-center gap-3"><span class="text-gray-500 tabular-nums w-20"><%= p.on.strftime("%b %-d") %></span><span class="flex-1 text-gray-900"><%= p.via_label %><% if p.reference.present? %> · <%= p.reference %><% end %></span><span class="tabular-nums"><%= money.call(p.amount_cents) %></span></li>
            <% end %>
          </ul>
        <% end %>
      </section>

      <% if can_change && @invoice.open? %>
        <div class="flex justify-end">
          <%= render "shared/button", text: "Cancel this invoice", variant: "secondary", size: "small", type: :button, data: { controller: "modal", action: "click->modal#open", modal_id: "void-invoice" } %>
        </div>
      <% end %>
    </div>
  </div>

  <% if can_change && @invoice.open? %>
    <div id="record-payment" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center sm:p-4" data-controller="modal" data-action="click->modal#closeOnBackdrop">
      <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full max-w-md overflow-hidden" data-action="click->modal#stopPropagation">
        <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
          <h3 class="text-lg font-semibold text-white">Record a payment</h3>
          <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 cursor-pointer" aria-label="Close"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
        </div>
        <%= form_with url: manage_payments_money_invoice_path(@invoice), method: :post, data: { turbo: false } do %>
          <div class="px-6 py-5 space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <label class="block text-sm font-medium text-gray-700"><span>Arrived on</span><input type="date" name="on" value="<%= Date.current.iso8601 %>" class="<%= input %>"></label>
              <label class="block text-sm font-medium text-gray-700"><span>Amount</span><span class="relative block"><span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 pt-1 text-gray-500">$</span><input type="text" name="amount" inputmode="decimal" value="<%= format('%.2f', @invoice.unpaid_cents / 100.0) %>" class="<%= input %> pl-7 tabular-nums"></span></label>
            </div>
            <label class="block text-sm font-medium text-gray-700"><span>How</span>
              <select name="via" class="<%= input %>"><% InvoicePayment::VIA.except("online").each do |k, name| %><option value="<%= k %>"><%= name %></option><% end %></select></label>
            <label class="block text-sm font-medium text-gray-700"><span>Check number or reference <span class="font-normal text-gray-500">(optional)</span></span><input type="text" name="reference" class="<%= input %>"></label>
            <p class="text-xs text-gray-500">Checks and transfers go on the books in the bank; cash in the door box. Once it is paid in full, they get a receipt by email.</p>
          </div>
          <div class="flex items-center justify-end gap-2 border-t border-gray-200 bg-gray-50 px-6 py-4">
            <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
            <%= render "shared/button", text: "Record it", variant: "primary", size: "medium", type: :submit %>
          </div>
        <% end %>
      </div>
    </div>

    <div id="void-invoice" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center sm:p-4" data-controller="modal" data-action="click->modal#closeOnBackdrop">
      <div class="bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full max-w-md overflow-hidden" data-action="click->modal#stopPropagation">
        <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
          <h3 class="text-lg font-semibold text-white">Cancel this invoice?</h3>
          <button type="button" data-action="click->modal#close" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 cursor-pointer" aria-label="Close"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
        </div>
        <%= form_with url: manage_void_money_invoice_path(@invoice), method: :post, data: { turbo: false } do %>
          <div class="px-6 py-5 space-y-3">
            <p class="text-sm text-gray-700">Its page says Cancelled and the number stays used. Payments already recorded stay as they were. To change what it says, cancel it and send a new one.</p>
            <label class="block text-sm font-medium text-gray-700"><span>Why <span class="font-normal text-gray-500">(optional)</span></span><input type="text" name="reason" class="<%= input %>"></label>
          </div>
          <div class="flex items-center justify-end gap-2 border-t border-gray-200 bg-gray-50 px-6 py-4">
            <%= render "shared/button", text: "Keep it", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
            <%= render "shared/button", text: "Cancel the invoice", variant: "primary", size: "medium", type: :submit %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
