<%# One show on the day's worksheet. Locals: piece (SettleUp::ShowPiece), day, can_change %>
<%
  money = ->(cents) { cents.negative? ? "−#{number_to_currency(-cents / 100.0)}" : number_to_currency(cents / 100.0) }
  show = piece.show
  fin = piece.financials
  state_words = { ok: "Confirmed", wait: (piece.non_revenue? ? "No revenue, not confirmed" : "Automatically pulled in, not confirmed"), miss: "Nothing entered" }.fetch(piece.state)
  state_tone = { ok: "text-green-700", wait: "text-amber-700", miss: "text-red-700" }.fetch(piece.state)
  outside_lines = piece.ticket_lines.reject { |l| l[:built_in] }
  online_lines = piece.ticket_lines.select { |l| l[:built_in] }
  line = ->(label, note, value) { "<div class='flex items-baseline justify-between gap-3 py-1.5 text-sm'><span class='min-w-0 text-gray-700'>#{ERB::Util.html_escape(label)}#{note.present? ? " <span class='text-xs text-gray-500'>#{ERB::Util.html_escape(note)}</span>" : ''}</span><span class='tabular-nums text-gray-900 whitespace-nowrap'>#{value}</span></div>".html_safe }
  editable = can_change && !day.settled?
  return_to = manage_money_settle_up_day_path(day.param)
  pink = "text-pink-600 hover:text-pink-700"
  # The number opens that thing's own worksheet, a modal (Tim, 2026-11-03).
  opens = ->(modal_id, text) { %(<a href="##{modal_id}" class="#{pink}" data-controller="modal" data-action="click->modal#open" data-modal-id="#{modal_id}">#{text}</a>).html_safe }
  # Tickets sold on other sites open one modal for every show, a line per
  # site and ticket type; on a settled day it opens to read (Tim,
  # 2026-11-04). A show CocoScout doesn't sell also says there what it
  # took: tickets, a flat fee, or no revenue.
  typed_tickets = editable && piece.listing.nil?
  tickets_id = "tickets-#{show.id}"
  has_modal = piece.listing.nil? || piece.outside_sources.any? || outside_lines.any?
  typed = ->(text) { has_modal ? opens.call(tickets_id, text) : text }
  # One line per site: the money on the right, where every other number on
  # the card sits, and what it sold beside the name in small words, by type
  # (Tim, 2026-11-04: several types wrapped the whole line badly). Each type
  # moves to the next line whole. The types are named only when they add up
  # to the count.
  sold = lambda do |group|
    count = group.sum { |l| l[:count] }
    types = group.flat_map { |l| l[:types] || [] }.group_by(&:first).map { |name, pairs| [ name, pairs.sum(&:last) ] }.select { |_, n| n.positive? }
    named = types.any? && types.sum(&:last) == count
    { words: (named ? types.map { |name, n| "#{n} #{name}" } : [ pluralize(count, "ticket") ]), money: money.call(group.sum { |l| l[:cents] }) }
  end
  sold_line = lambda do |label, words, value|
    said = words.each_with_index.map { |word, i| "<span class='inline-block max-w-full'>#{ERB::Util.html_escape(word)}#{i < words.size - 1 ? ',' : ''}</span>" }.join(" ")
    "<div class='flex items-baseline justify-between gap-3 py-1.5 text-sm'><span class='min-w-0 text-gray-700'><span class='inline-block max-w-full'>#{ERB::Util.html_escape(label)}</span> <span class='text-xs text-gray-500'>#{said}</span></span><span class='tabular-nums text-gray-900 whitespace-nowrap'>#{value}</span></div>".html_safe
  end
  by_site = outside_lines.group_by { |l| l[:label] }.map { |label, group| { label: label, sold: sold.call(group) } }
  notes = fin&.notes.to_s.strip
%>
<section class="bg-white border border-gray-200 rounded-xl overflow-hidden" id="show-<%= show.id %>">
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3 border-b border-gray-200">
    <h2 class="text-base font-semibold text-gray-900">
      <%= show.display_name %>, <%= show.date_and_time.strftime("%-l:%M %p").sub(":00", "").downcase %>
      <span class="ml-2 text-xs font-medium <%= state_tone %>"><%= state_words %></span>
    </h2>
    <% if can_change && !day.settled? %>
      <%= render "manage/settlement_days/confirm_mark", url: manage_check_show_money_settle_up_day_path(day.param, show_id: show.id),
            checked: piece.confirmed?, at: (piece.confirmed? ? fin&.updated_at : nil), hold_reason: piece.hold_reason %>
    <% end %>
  </div>
  <div class="px-5 py-3 grid grid-cols-1 lg:grid-cols-2 gap-x-8 gap-y-2">
    <div>
      <div class="text-[11px] font-medium uppercase tracking-wide text-gray-500">Tickets</div>
      <% if piece.non_revenue? %>
        <%= line.call("Tickets", "this show had no revenue", (typed_tickets ? typed.call("Change") : "—")) %>
      <% elsif fin&.flat_fee? %>
        <%= line.call("A flat fee instead of tickets", nil, (piece.listing ? money.call(piece.flat_fee_cents) : typed.call(money.call(piece.flat_fee_cents)))) %>
      <% elsif piece.ticket_lines.empty? %>
        <%= line.call("Tickets", "nothing entered yet", (typed_tickets ? typed.call("Enter") : "—")) %>
      <% end %>
      <% online_lines.each do |l| %>
        <% ours = sold.call([ l ]) %>
        <%= sold_line.call("Sold through CocoScout", ours[:words], (piece.listing ? link_to(ours[:money], manage_ticket_listing_path(piece.listing), class: pink) : ours[:money])) %>
      <% end %>
      <% by_site.each do |site| %>
        <%= sold_line.call(site[:label], site[:sold][:words], typed.call(site[:sold][:money])) %>
      <% end %>
      <% if piece.listing && piece.outside_sources.any? && by_site.empty? && editable %>
        <%= line.call("Sold on other sites", "nothing entered", typed.call("Enter")) %>
      <% end %>
      <% if fin && fin.contractor_collected.to_f.positive? && !piece.non_revenue? %>
        <%= line.call("Collected by the contractor", "already in the tickets", typed.call(number_to_currency(fin.contractor_collected))) %>
      <% end %>
      <% if piece.listing %>
        <% sold = Ticket.where(ticket_order_id: piece.listing.ticket_orders.select(:id), status: Ticket::SOLD_STATUSES) %>
        <%= line.call("Checked in", nil, "#{sold.where(status: 'checked_in').count} of #{sold.count}") %>
      <% end %>
    </div>
    <div>
      <div class="text-[11px] font-medium uppercase tracking-wide text-gray-500">Everything else for this show</div>
      <%= line.call("Products at the door", (piece.listing ? "from Ticketing" : nil), (piece.listing ? link_to(money.call(piece.products_cents), manage_ticket_listing_path(piece.listing), class: pink) : money.call(piece.products_cents))) %>
      <%= line.call("Other revenue", (fin&.normalized_other_revenue_details&.reject { |i| i.is_a?(Hash) && i["description"] == TicketSalesSync::PRODUCTS_LABEL }&.filter_map { |i| i.is_a?(Hash) ? i["description"] : nil }&.join(", ")),
            (editable ? opens.call("other-revenue-#{show.id}", money.call(piece.other_revenue_cents)) : money.call(piece.other_revenue_cents))) %>
      <%= line.call("Expenses", (fin && fin.expense_items.any? ? pluralize(fin.expense_items.size, "item") : nil),
            (editable ? opens.call("expenses-#{show.id}", money.call(piece.expenses_cents)) : money.call(piece.expenses_cents))) %>
      <% if editable || notes.present? %>
        <%= line.call("Notes", (notes.present? ? truncate(notes, length: 70) : nil), (editable ? opens.call("notes-#{show.id}", notes.present? ? "Change" : "Add") : "")) %>
      <% end %>
    </div>
  </div>
  <%= render "manage/settlement_days/pay_block", piece: piece, day: day, editable: editable, return_to: return_to, open: (defined?(open_show_id) && open_show_id.to_s == show.id.to_s), open_modal_id: (defined?(open_modal_id) ? open_modal_id.to_s : "") %>
</section>
<% if has_modal %>
  <%= render "manage/settlement_days/outside_tickets_modal", id: tickets_id, show: show, listing: piece.listing, financials: fin, editable: editable, return_to: return_to, settled: day.settled? %>
<% end %>
<% if editable %>
  <%= render "manage/settlement_days/notes_modal", id: "notes-#{show.id}", show: show, financials: fin, return_to: return_to %>
  <%= render "manage/settlement_days/other_revenue_modal", id: "other-revenue-#{show.id}", show: show, financials: fin, return_to: return_to %>
  <%= render "manage/settlement_days/expenses_modal", id: "expenses-#{show.id}", show: show, financials: fin, return_to: return_to %>
<% end %>

