<% content_for :title, "Sign in" %>
<%
  # Who lands here: a performer who clicked a cast message, a producer heading
  # to Manage, someone whose session lapsed, someone bounced from an invitation
  # or a sign-up form. The lede says what's on the other side; the line under
  # the divider catches the person an organization added who has never set a
  # password (their account exists with a random one).
  sent = @password_reset_instructions_sent
  lede =
    if @user_exists_error
      "Your calendar, cast messages, contracts and pay are already waiting in there."
    elsif sent
      "Remembered it after all? Sign in here."
    elsif auth_native_app?
      "Your calendar, cast messages, contracts and pay, and the door scanner when you're working it. Sign in and it's all in your pocket."
    else
      "Everything about your shows lives here: your calendar, cast messages, contracts and pay, and any organization you run."
    end
%>
<% notices = capture do %>
  <% if sent %>
    <%= render "shared/auth/notice", title: "Check your email.",
          body: "If there's an account for that address, a link to choose a new password is on its way. It works for #{password_reset_link_lifetime}. Nothing yet? Check spam." %>
  <% end %>
  <% if @error %>
    <%= render layout: "shared/auth/notice", locals: { kind: :error } do %>
      That email and password don't match. Try again, or <%= link_to "reset your password", password_path, class: "font-semibold underline" %>. Never set one? That link is for you too.
    <% end %>
  <% end %>
  <% if @user_exists_error %>
    <%= render layout: "shared/auth/notice", locals: { title: "You already have an account." } do %>
      There's a CocoScout account for <strong class="font-semibold"><%= @email_address %></strong>, so sign in with its password below. If an organization set it up and you've never chosen a password, <%= link_to "choose one now", password_path, class: "font-semibold underline" %>.
    <% end %>
  <% end %>
  <% if @invitation_link_invalid %>
    <%= render "shared/auth/notice", kind: :error,
          body: "That invitation link isn't valid. Ask whoever sent it for a new one, or sign in if you already have an account." %>
  <% end %>
<% end %>

<%= render layout: "shared/auth/shell", locals: { title: "Sign in", lede: lede, notices: notices } do %>
  <%= form_with url: handle_signin_path, class: "space-y-4" do |form| %>
    <div>
      <label for="email_address" class="mb-1.5 block text-sm font-medium text-slate-700">Email address</label>
      <%= form.email_field :email_address,
          required: true,
          autofocus: !auth_native_app? && !@user_exists_error,
          autocomplete: "email",
          autocapitalize: "none",
          placeholder: "you@example.com",
          value: (@email_address || params[:email_address]),
          class: auth_input_class %>
    </div>

    <%= render "shared/auth/password_field", form: form, autocomplete: "current-password", error: @error.present? %>

    <div class="flex flex-col items-center gap-3.5 pt-1">
      <%= render "shared/button", text: "Sign in", variant: "primary", size: "jumbo", type: :submit %>
      <%= link_to (sent ? "Send the link again" : "Forgot your password?"), password_path,
            class: "p-1 text-[15px] font-medium text-pink-600 hover:text-pink-700" %>
    </div>
  <% end %>

  <div class="border-t border-slate-200 pt-4 text-center text-sm leading-[1.8] text-slate-600">
    New to CocoScout? <%= link_to "Create an account", signup_path, class: "font-medium text-pink-600 hover:text-pink-700" %><br>
    Invited by an organization? <%= link_to "Choose your password", password_path, class: "font-medium text-pink-600 hover:text-pink-700" %>
  </div>
<% end %>
