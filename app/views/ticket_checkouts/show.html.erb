<%
  show = @listing.show
  # Several shows in one checkout (a pass) pay one total.
  total_cents = (@purchase || @order).total_cents
  orders = @purchase ? @purchase.ticket_orders.includes(ticket_listing: { show: %i[location location_space] }).to_a : [ @order ]
  pass = @order.tickets.first&.ticket_pass
  free = total_cents.zero?
  pay_text = free ? "Get my tickets" : "Pay #{number_to_currency(total_cents / 100.0)}"
  image, page_image = ticket_page_image(@listing)
  place = [ show.location&.name, show.location_space&.name ].compact.uniq.join(" · ")
  back_path = pass ? tickets_pass_path(org: @ticketing_profile.slug, pass: pass.slug, **embed_params) : tickets_event_path(org: @ticketing_profile.slug, event: @listing.slug, **embed_params)
  # Paying on their own phone at the door: the door picked the tickets, and
  # the buyer's details are optional.
  at_door = @order.channel == "door_card"
  offers = @expired || pass ? [] : @listing.product_offers(at_door: at_door)
%>
<% content_for :title, "Checkout · #{@listing.display_title}" %>
<% content_for :head do %>
  <% unless free || @expired %><script src="https://js.stripe.com/v3/"></script><% end %>
<% end %>

<%# Layout A, like the show's page: one calm centered column. The pieces
    (summary, countdown, details, payment) are shared/checkout partials, the
    same ones a course registration uses. %>
<div class="mx-auto max-w-xl space-y-5">
  <h1 class="text-center text-3xl sm:text-4xl coustard-regular text-gray-900"><%= at_door ? "Pay at the door" : "Checkout" %></h1>

  <% if @expired %>
    <%= render "shared/checkout/expired", held: "these seats", back_path: back_path, back_text: "Back to tickets" %>
  <% else %>
    <%= form_with url: tickets_checkout_pay_path(token: @order.token, **embed_params), method: :post, class: "space-y-5",
          data: {
            controller: "checkout",
            action: "submit->checkout#submit",
            checkout_target: "form",
            checkout_publishable_key_value: stripe_publishable_key.to_s,
            checkout_amount_value: total_cents,
            checkout_free_value: free,
            checkout_return_url_value: tickets_checkout_done_url(token: @order.token, **embed_params),
            checkout_expires_at_value: @order.expires_at&.iso8601,
            checkout_hold_key_value: ("cocoscout:ticket-hold:#{@listing.id}" unless at_door || pass),
            checkout_token_value: @order.token,
            checkout_items_url_value: tickets_checkout_items_path(token: @order.token)
          } do %>
      <%= render "tickets/bot_trap", id: "checkout_website" %>

      <%# The show, what they're buying, and every cent of it. %>
      <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div class="flex items-center gap-4 px-5 py-4">
          <% if image %>
            <%= image_tag image, alt: "", class: "#{page_image.wide? ? 'w-24' : 'w-14'} h-auto rounded-lg flex-shrink-0" %>
          <% end %>
          <div class="min-w-0 flex-1 text-left">
            <% if orders.size > 1 %>
              <div class="font-semibold text-gray-900 truncate"><%= pass ? pass.name : "#{orders.size} shows" %></div>
              <% orders.each do |order| %>
                <div class="text-sm text-gray-600 truncate"><%= order.ticket_listing.display_title %> · <%= order.ticket_listing.show.date_and_time.strftime("%a, %b %-d · %-l:%M %p") %></div>
              <% end %>
            <% else %>
              <div class="font-semibold text-gray-900 truncate"><%= @listing.display_title %></div>
              <div class="text-sm text-gray-600"><%= show.date_and_time.strftime("%a, %b %-d · %-l:%M %p") %></div>
              <% if place.present? %><div class="text-sm text-gray-500 truncate"><%= place %></div><% end %>
            <% end %>
          </div>
        </div>
        <div data-checkout-target="summary"><%= render "ticket_checkouts/summary", order: @order %></div>
        <%= render "shared/checkout/countdown", back_path: back_path, back_text: (at_door ? nil : (pass ? "Change passes" : "Change tickets")) %>
      </div>

      <% if @deals.any? %>
        <%= render "ticket_checkouts/deals", order: @order, deals: @deals %>
      <% end %>

      <% if offers.any? %>
        <%= render "ticket_checkouts/products", order: @order, offers: offers %>
      <% end %>

      <%= render "shared/checkout/buyer_details", name: @order.buyer_name, email: @order.buyer_email, phone: @order.buyer_phone, required: !at_door,
            email_note: (at_door ? "Add it to get your tickets and receipt by email." : "We'll email your tickets to this address.") %>

      <%= render "shared/checkout/payment" unless free %>

      <p data-checkout-target="error" class="hidden text-sm text-red-600 text-center" role="alert"></p>

      <%= render "shared/button", text: pay_text, variant: "primary", size: "jumbo", type: :submit, classes: "disabled:opacity-50",
            data: { checkout_target: "submit", pay_prefix: (free ? "" : "Pay ") } %>

      <% if @ticketing_profile.support_email.present? %>
        <p class="text-xs text-center text-gray-500">Questions? <%= mail_to @ticketing_profile.support_email, nil, class: "text-pink-700" %></p>
      <% end %>
    <% end %>
  <% end %>
</div>
