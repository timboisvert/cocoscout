<% if @custom_message.present? %>
  <%= simple_format(@custom_message) %>
  <p style="margin-top: 20px;">
    <%= link_to "Accept Invitation", accept_manage_team_invitations_url(@team_invitation.token), target: "_blank", class: "button", style: EmailButton::STYLE %>
  </p>
<% else %>
  <h1>Welcome to CocoScout</h1>
  <p>
      <%= @team_invitation.organization.name%> is using CocoScout to manage its productions.
      You've been invited to join the team.
      <%= link_to "Click here", accept_manage_team_invitations_url(@team_invitation.token), target: "_blank", class: "button", style: EmailButton::STYLE %>
      to accept the invitation and sign in or create an account.
  </p>
<% end %>
