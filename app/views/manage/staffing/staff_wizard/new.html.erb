<% content_for :title, "Add Staff Member" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Staffing", manage_staffing_index_path]
    ],
    text: "Add Staff Member",
    links: []
  } %>

  <div class="max-w-2xl">
    <p class="text-sm text-gray-600 mb-6">
      Add someone to your team. You'll enter their basic details here — they'll get an
      invite to finish onboarding and connect how they get paid.
    </p>

    <% if @staff_member.errors.any? %>
      <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        <%= @staff_member.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <%= form_with url: manage_staffing_staff_wizard_path, method: :post, class: "space-y-8" do %>
      <%# ---- Personal details ---- %>
      <section>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 mb-3">Personal details</h2>
        <div class="grid grid-cols-1 sm:grid-cols-6 gap-4">
          <div class="sm:col-span-3">
            <label class="block text-sm font-medium text-gray-700 mb-1">First name <span class="text-pink-500">*</span></label>
            <%= text_field_tag :first_name, @staff_member.first_name, required: true, class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
          </div>
          <div class="sm:col-span-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">M.I.</label>
            <%= text_field_tag :middle_initial, @staff_member.middle_initial, maxlength: 1, class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
          </div>
          <div class="sm:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Last name <span class="text-pink-500">*</span></label>
            <%= text_field_tag :last_name, @staff_member.last_name, required: true, class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
          </div>
          <div class="sm:col-span-3">
            <label class="block text-sm font-medium text-gray-700 mb-1">Preferred first name</label>
            <%= text_field_tag :preferred_first_name, @staff_member.preferred_first_name, placeholder: "If different from legal first name", class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
          </div>
          <div class="sm:col-span-3">
            <label class="block text-sm font-medium text-gray-700 mb-1">Personal email <span class="text-pink-500">*</span></label>
            <%= email_field_tag :personal_email, @staff_member.personal_email, required: true, class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
            <p class="mt-1 text-xs text-gray-500">Where we'll send their onboarding invite.</p>
          </div>
        </div>
      </section>

      <%# ---- Employment ---- %>
      <section>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 mb-3">Employment</h2>
        <div class="grid grid-cols-1 sm:grid-cols-6 gap-4">
          <div class="sm:col-span-3">
            <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
            <%= text_field_tag :title, @staff_member.title, placeholder: "e.g. Bartender, Stage Manager", class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
          </div>
          <div class="sm:col-span-3">
            <label class="block text-sm font-medium text-gray-700 mb-1">Hourly rate</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">$</span>
              <%= text_field_tag :hourly_rate, @staff_member.hourly_rate_dollars, inputmode: "decimal", placeholder: "0.00", class: "block w-full pl-7 pr-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
            </div>
          </div>
          <div class="sm:col-span-3">
            <label class="block text-sm font-medium text-gray-700 mb-1">Start date</label>
            <%= date_field_tag :start_date, @staff_member.start_date, class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
          </div>
          <div class="sm:col-span-3">
            <label class="block text-sm font-medium text-gray-700 mb-1">Manager</label>
            <%= select_tag :manager_id,
                  options_from_collection_for_select(@managers, :id, :display_name, @staff_member.manager_id),
                  include_blank: "No manager",
                  class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
          </div>
        </div>
      </section>

      <%# ---- Roles ---- %>
      <section>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 mb-3">Roles they can fill</h2>
        <% if @house_roles.any? %>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            <% assigned = @staff_member.house_role_ids %>
            <% @house_roles.each do |role| %>
              <label class="flex items-center gap-2 px-3 py-2.5 border border-gray-200 rounded-lg cursor-pointer hover:border-pink-300">
                <%= check_box_tag "house_role_ids[]", role.id, assigned.include?(role.id), class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
                <span class="text-sm text-gray-700"><%= role.name %></span>
              </label>
            <% end %>
          </div>
        <% else %>
          <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-sm text-amber-800">
            No house roles yet — <%= link_to "add some", manage_staffing_house_roles_path, class: "underline font-medium" %> so you can mark what this person is qualified for.
          </div>
        <% end %>
      </section>

      <div class="flex items-center gap-3 pt-2 border-t border-gray-200">
        <%= render "shared/button", text: "Add staff member", variant: "primary", size: "medium", type: :submit %>
        <%= link_to "Cancel", manage_staffing_index_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
      </div>
    <% end %>
  </div>
</div>
