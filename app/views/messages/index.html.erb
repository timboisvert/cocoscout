<% content_for :title, "Messages" %>

<%#
  The one Messages page (MessagesController): the same list at one address
  in either mode's frame. Production mode adds Send a message (the compose
  modal) and the intro guide; My adds the Contact-the-team card; a V1 app,
  which has no bell, gets the Notifications row.
%>
<div class="w-full pb-8" data-controller="message-density">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%
    actions = []
    if @production_mode
      actions << { icon: "mail", text: "Send a message", path: "#",
                   data: {
                     controller: "compose-message",
                     action: "click->compose-message#openWithSteps",
                     "compose-message-productions-value": @accessible_productions.map { |p| { id: p.id, name: p.name, has_talent_pool: p.effective_talent_pool.present? } }.to_json,
                     "compose-message-production-data-url-value": production_data_manage_messages_path(":production_id"),
                     "compose-message-single-talent-pool-value": Current.organization.talent_pool_single? ? "true" : "false",
                     "compose-message-org-talent-pool-value": Current.organization.talent_pool_single? && Current.organization.organization_talent_pool ? {
                       id: Current.organization.organization_talent_pool.id,
                       name: "#{Current.organization.name} Talent Pool",
                       count: Current.organization.organization_talent_pool.people.distinct.count,
                       members: Current.organization.organization_talent_pool.people.distinct.includes(profile_headshots: { image_attachment: :blob }).first(20).map { |p|
                         { id: p.id, name: p.name, headshot: p.safe_headshot_variant(:thumb) ? url_for(p.safe_headshot_variant(:thumb)) : "", initials: p.initials }
                       }
                     }.to_json : "{}"
                   } }
    end
    actions << { icon: "check", text: "Mark all read", path: read_messages_path, method: :post, variant: (@production_mode ? "secondary" : "primary"),
                 badge: (@unread_count if @unread_count.to_i.positive?), disabled: @unread_count.to_i.zero? }
  %>
  <%= render "shared/module_header", title: "Messages", actions: actions %>

  <% if @production_mode %>
    <%
      messages_guide_body = <<~HTML.html_safe
        <p>Messages keeps production communication out of your personal inbox:</p>
        <ol>
          <li><strong>Send a message</strong> — to one person, a group, a whole talent pool, or everyone on a production.</li>
          <li><strong>People read it in CocoScout</strong> — every recipient sees it in their own account, no email addresses to wrangle.</li>
          <li><strong>Replies land back here</strong> — each conversation stays in its thread, organized by production.</li>
        </ol>
      HTML
    %>
    <div class="hidden sm:block">
      <%= render "shared/intro_guide", guide_key: "messages_intro", title: "How messages work", body: messages_guide_body %>
    </div>
  <% else %>
    <%# Notifications, at the top, for the V1 apps that have no bell (V1.1 plan §9). %>
    <% if turbo_native_app? && !NativeAppVersion.production_mode?(request.user_agent) %>
      <% unread_notifications = Current.user.unread_notification_count %>
      <%= link_to notifications_path, class: "mt-4 flex items-center gap-3 rounded-lg border px-4 py-3 transition-colors #{unread_notifications.positive? ? 'border-pink-200 bg-pink-50 hover:bg-pink-100/70' : 'border-gray-200 bg-white hover:bg-gray-50'}", data: { notifications_row: true } do %>
        <span class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 <%= unread_notifications.positive? ? 'bg-white text-pink-600' : 'bg-gray-100 text-gray-500' %>">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10 21a2 2 0 0 0 4 0"/></svg>
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-sm font-semibold text-gray-900">Notifications</span>
          <span class="block text-xs text-gray-600"><%= unread_notifications.positive? ? "#{unread_notifications} unread: casting, sign-ups, pay, contracts and more" : "Casting, sign-ups, pay, contracts and more" %></span>
        </span>
        <% if unread_notifications.positive? %>
          <span class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 text-xs font-bold text-white bg-pink-500 rounded-full"><%= unread_notifications > 99 ? "99+" : unread_notifications %></span>
        <% end %>
        <svg class="w-4 h-4 text-gray-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
      <% end %>
    <% end %>

    <%# Contact Production Team Card %>
    <% if @contactable_productions.any? %>
      <div class="mt-4" data-controller="contact-production">
        <% if @contactable_productions.size == 1 %>
          <%= render "shared/contact_production_card", production: @contactable_productions.first %>
        <% else %>
          <%= render "shared/contact_production_card", productions: @contactable_productions %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/messages/inbox", base: (@production_mode ? :manage : :my), path: ->(**overrides) { messages_path(**overrides) } %>
</div>

<% if @production_mode %>
  <%= render "shared/compose_message_modal" %>
<% end %>
