<%# "Send reminders": who gets it, what each is owed, and the draft they'll
    get, before anything goes. Everyone who can be reminded is ticked (untick
    to leave someone out); people without a CocoScout login are listed but
    can't be reached here. The draft keeps {{recipient_name}} and {{amount}},
    filled per person when sent (PayoutSetupReminders.send!).
    Locals: id, show, recipients (PayoutSetupReminders::Recipient), draft ({ subject:, body: }). %>
<% input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
<% reachable, unreachable = recipients.partition(&:reachable?) %>
<div id="<%= id %>" class="hidden fixed inset-0 z-[65] bg-black/60 backdrop-blur-sm overflow-y-auto"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="flex min-h-full items-start justify-center p-4 py-12" data-action="click->modal#closeOnBackdrop">
    <div class="relative w-full max-w-2xl bg-white rounded-xl shadow-2xl overflow-hidden" data-action="click->modal#stopPropagation">
      <div class="flex items-center justify-between gap-3 bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
        <h3 class="text-lg font-semibold text-white">Remind them to set up payment</h3>
        <button type="button" data-action="click->modal#close"
                class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <%= form_with url: manage_send_payment_reminders_money_show_payout_path(show), method: :post do %>
        <div class="px-6 py-5 space-y-5">
          <% if reachable.any? %>
            <div>
              <p class="text-sm font-medium text-gray-900 mb-2">
                Sending to <%= pluralize(reachable.size, "person") %>
                <span class="font-normal text-gray-500">— untick anyone to leave them out</span>
              </p>
              <ul class="max-h-56 overflow-y-auto border border-gray-200 rounded-lg divide-y divide-gray-100">
                <% reachable.each do |recipient| %>
                  <li>
                    <label class="flex items-center gap-3 px-3 py-2 cursor-pointer hover:bg-gray-50">
                      <%= check_box_tag "person_ids[]", recipient.person.id, true, id: "setup-remind-#{recipient.person.id}",
                            class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
                      <span class="flex-1 min-w-0">
                        <span class="block text-sm font-medium text-gray-900 truncate"><%= recipient.person.name %></span>
                        <span class="block text-xs text-gray-500 truncate"><%= recipient.email %></span>
                      </span>
                      <span class="flex-shrink-0 text-sm text-gray-700 tabular-nums"><%= number_to_currency(recipient.amount_cents / 100.0) %></span>
                    </label>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <% if unreachable.any? %>
            <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2">
              <p class="text-sm text-amber-900">
                <%= unreachable.map { |r| r.person.name }.to_sentence %>
                <%= unreachable.one? ? "doesn't" : "don't" %> have a CocoScout login yet, so a reminder can't reach them.
                Share the setup link or the QR code with <%= unreachable.one? ? "them" : "them instead" %>.
              </p>
            </div>
          <% end %>

          <% if reachable.any? %>
            <div>
              <label for="setup_reminder_subject" class="block text-sm font-medium text-gray-900 mb-1">Subject</label>
              <%= text_field_tag :reminder_subject, draft[:subject], id: "setup_reminder_subject", class: input_class %>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-900 mb-1">Message</label>
              <input type="hidden" name="reminder_body" id="setup_reminder_body" value="<%= draft[:body] %>">
              <trix-editor input="setup_reminder_body"
                           class="trix-content block w-full bg-white border border-gray-300 rounded-lg shadow-sm min-h-[200px] px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"></trix-editor>
              <p class="mt-1 text-xs text-gray-500">
                {{recipient_name}} becomes each person's first name and {{amount}} what they're owed for this show.
                It arrives as a CocoScout message.
              </p>
            </div>
          <% end %>
        </div>

        <div class="flex items-center justify-end gap-2 px-6 py-4 bg-gray-50 border-t border-gray-200">
          <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button,
                data: { action: "click->modal#close" } %>
          <% if reachable.any? %>
            <%= render "shared/button", text: "Send reminders", variant: "primary", size: "medium", type: :submit %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
