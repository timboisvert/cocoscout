<%# Basic Information: what kind of event it is, its name, and notes for
    the people in it. The type mirrors the wizard's Type step.
    Locals: form, input_class. %>
<%= render layout: "manage/shows/edit/card", locals: { title: "Event Details" } do %>
  <div>
    <p class="block text-sm font-medium text-gray-700 mb-2">Type</p>
    <%= render "shared/radio_card_grid",
          name: "show[event_type]",
          options: EventTypes.for_cards,
          selected: @show.event_type,
          columns: 3,
          action: "change->location-modal#updateEventType" %>
  </div>

  <div>
    <%= form.label :secondary_name, "Name", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
    <%# Pre-filled with the suggestion, so an unnamed event gets a real name
        the moment anyone saves it rather than one derived on every screen. %>
    <%= form.text_field :secondary_name, value: @show.display_name,
          class: "#{input_class} #{'!border-pink-500' if @show.errors[:secondary_name].any?}" %>
    <p class="text-xs text-gray-500 mt-1">We suggest one from the production and the type. Change it to anything, like "Opening Night" or "Special Guest Performance".</p>
  </div>
<% end %>

<%= render layout: "manage/shows/edit/card", locals: { title: "Notes", intro: "For the cast and the production team, on this event's page. The public never sees them." } do %>
  <%= form.label :notes, "Notes", class: "sr-only" %>
  <%= form.text_area :notes, placeholder: "A family is celebrating a birthday in the audience. Bring your own water.", rows: 4, class: input_class %>
<% end %>
