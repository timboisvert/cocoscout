<% content_for :title, "Approved Hours" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ ["Staffing", manage_staffing_index_path], ["Approve Hours", manage_staffing_timesheets_path] ],
    text: "Approved Hours",
    links: []
  } %>

  <% if @months.empty? %>
    <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-10 text-center mt-6">
      <p class="text-sm font-medium text-gray-900">Nothing approved yet</p>
      <p class="text-sm text-gray-500 mt-1">Hours you sign off on in <%= link_to "Approve Hours", manage_staffing_timesheets_path, class: "text-pink-600 hover:text-pink-700 underline" %> will show up here as a running history.</p>
    </div>
  <% else %>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-700 mt-6 mb-4">
      <span class="font-semibold text-gray-900"><%= number_with_precision(@total_hours, precision: 2, strip_insignificant_zeros: true) %> hrs</span>
      approved across <span class="font-semibold text-gray-900"><%= pluralize(@total_entries, "entry") %></span>
    </div>

    <div class="space-y-6">
      <% @months.each do |month, entries| %>
        <% month_hours = entries.sum(&:hours) %>
        <div>
          <div class="flex items-baseline justify-between gap-3 mb-2">
            <h2 class="text-lg coustard-regular text-gray-900"><%= month.strftime("%B %Y") %></h2>
            <span class="text-sm text-gray-500"><%= number_with_precision(month_hours, precision: 2, strip_insignificant_zeros: true) %> hrs · <%= pluralize(entries.size, "entry") %></span>
          </div>

          <div class="bg-white border border-gray-200 rounded-lg divide-y divide-gray-100 overflow-hidden">
            <% entries.each do |e| %>
              <div class="flex items-center gap-3 px-4 py-3">
                <%# Person %>
                <% headshot_variant = e.person.safe_headshot_variant(:thumb) %>
                <% if headshot_variant %>
                  <%= image_tag headshot_variant, alt: e.person.name, class: "w-9 h-9 rounded-lg object-cover flex-shrink-0" %>
                <% else %>
                  <div class="w-9 h-9 rounded-lg bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-xs flex-shrink-0">
                    <%= e.person.initials %>
                  </div>
                <% end %>

                <div class="min-w-0 flex-1">
                  <div class="text-sm font-medium text-gray-900 truncate">
                    <%= e.person.name %>
                    <span class="text-gray-400">·</span>
                    <%= e.started_at.strftime("%a %b %-d") %>
                    <span class="text-gray-400">·</span>
                    <%= number_with_precision(e.hours, precision: 2, strip_insignificant_zeros: true) %>h
                    <% if e.source == "manual" %>
                      <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">self-logged</span>
                    <% end %>
                  </div>
                  <div class="text-xs text-gray-500 truncate">
                    <%= e.started_at.strftime("%-l:%M %p") %>–<%= e.ended_at.strftime("%-l:%M %p") %>
                    <% if e.shift&.role_label.present? %> · <%= e.shift.role_label %><% end %>
                    <% if e.notes.present? %> · <span class="italic">“<%= e.notes %>”</span><% end %>
                  </div>
                </div>

                <%# Status + actions %>
                <div class="flex items-center gap-2 flex-shrink-0">
                  <% if e.paid? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">Paid</span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700">Approved</span>
                    <%= link_to manage_edit_staffing_timesheet_path(e), class: "text-gray-400 hover:text-pink-600", title: "Edit hours" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125"/></svg>
                    <% end %>
                    <%= button_to manage_unapprove_staffing_timesheet_path(e), method: :patch,
                          class: "text-gray-400 hover:text-amber-600", title: "Unapprove — send back for review",
                          form: { data: { turbo_confirm: "Send this entry back to the review queue? You'll need to approve it again." } } do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"/></svg>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
