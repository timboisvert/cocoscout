<%#
  Records money we paid a contractor outside CocoScout — Zelle, a check, cash.

  For an outgoing contract payment that can't ride a payout run (usually because
  they never connected a bank). Nothing moves through CocoScout; the payment
  simply shows paid, and any services this contract nets out of it settle too.

  NOTE: keep ERB tags out of this comment — the first closing token would end it
  early and run the rest as code.

  Locals:
    id             (required) DOM id, matched by the trigger's data-modal-id
    payment        (required) the outgoing ContractPayment
    contract       (required) its Contract
    methods        (required) the offline methods the org turned on
    net_amount     (required) what actually gets handed over, after deductions
    deductions     charges netted out of this payment (default [])
%>
<%
  id = local_assigns.fetch(:id)
  payment = local_assigns.fetch(:payment)
  contract = local_assigns.fetch(:contract)
  methods = local_assigns.fetch(:methods)
  net_amount = local_assigns.fetch(:net_amount)
  deductions = local_assigns.fetch(:deductions, [])
  deduction_total = deductions.sum { |d| d.amount.to_f }
%>
<div id="<%= id %>"
     class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
     data-controller="modal"
     data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden"
       data-action="click->modal#stopPropagation">
    <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
      <h3 class="text-lg font-semibold text-white">Paid another way</h3>
      <button type="button"
              data-action="click->modal#close"
              class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <%= form_with url: pay_offline_manage_contract_contract_payment_path(contract, payment), method: :post,
          data: { turbo: false, controller: "require-choice" } do %>
      <div class="p-6 space-y-4">
        <p class="text-sm text-gray-600">
          Recording <strong><%= number_to_currency(net_amount) %></strong> paid to
          <strong><%= contract.contractor_name %></strong> outside CocoScout. This marks
          <%= payment.description.presence || "the payment" %> paid — no money moves through CocoScout.
        </p>

        <% if deductions.any? %>
          <div class="bg-purple-50 rounded-lg p-3 text-sm">
            <div class="flex justify-between text-gray-700">
              <span><%= payment.description.presence || "Payment" %></span>
              <span class="tabular-nums"><%= number_to_currency(payment.amount) %></span>
            </div>
            <% deductions.each do |charge| %>
              <div class="flex justify-between text-gray-600">
                <span class="truncate"><%= charge.description %></span>
                <span class="tabular-nums">−<%= number_to_currency(charge.amount) %></span>
              </div>
            <% end %>
            <div class="flex justify-between font-semibold text-purple-800 border-t border-purple-200 mt-1 pt-1">
              <span>Hand them</span>
              <span class="tabular-nums"><%= number_to_currency(net_amount) %></span>
            </div>
            <p class="text-xs text-purple-700 mt-2">
              <%= pluralize(deductions.size, "charge") %> totalling <%= number_to_currency(deduction_total) %>
              settles as deducted — there's no payout run left to net it out of.
            </p>
          </div>
        <% end %>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">How did you pay them?</label>
          <div class="grid grid-cols-3 gap-2">
            <% methods.each do |method| %>
              <label class="block cursor-pointer">
                <input type="radio" name="payment_method" value="<%= method %>" class="peer sr-only" data-action="change->require-choice#update">
                <div class="text-center text-sm px-2 py-2 border rounded-lg bg-white border-gray-200 text-gray-700 hover:border-pink-400 peer-checked:border-pink-500 peer-checked:bg-pink-50 peer-checked:text-pink-700 peer-checked:font-medium transition-all">
                  <%= method.titleize %>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Date paid</label>
          <%= date_field_tag "paid_date_#{payment.id}", Date.current, name: "paid_date",
                class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Reference / note <span class="text-gray-400 font-normal">(optional)</span></label>
          <%= text_field_tag "payment_notes_#{payment.id}", nil, name: "payment_notes",
                placeholder: "e.g. Zelle confirmation #, check #1234",
                class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
        </div>
      </div>

      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
        <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button,
              data: { action: "click->modal#close" } %>
        <%= render "shared/button", text: "Mark paid", variant: "primary", size: "medium", type: :submit,
              icon: "check-circle", disabled: true,
              classes: "disabled:opacity-50 disabled:cursor-not-allowed",
              data: { require_choice_target: "submit" } %>
      </div>
    <% end %>
  </div>
</div>
