<%
  contractor = @contract&.contractor
  outgoing = @outgoing_payments || []
  incoming = @incoming_payments || []
  owed_total = outgoing.reject(&:status_paid?).sum { |p| p.amount.to_f }
  due_to_us_total = incoming.reject(&:status_paid?).sum { |p| p.amount.to_f }
%>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <!-- What we owe -->
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-200">
        <h3 class="font-semibold text-gray-900">Contract payout</h3>
        <p class="text-sm text-gray-500 mt-0.5">
          This show is part of a contract<% if @contract %> with <strong><%= @contract.contractor_name %></strong><% end %>.
          It's paid from the contract payments below — no casting needed.
        </p>
      </div>

      <% if outgoing.any? %>
        <div class="divide-y divide-gray-100">
          <% outgoing.each do |payment| %>
            <%
              contribution = payment.payout_contribution
              in_run = contribution.present?
              payee = payment.contract&.contractor&.person
              payable = payee&.can_receive_payouts?
              amount_set = !payment.amount_tbd? && payment.amount.to_f.positive?
            %>
            <div class="px-5 py-4 flex items-center justify-between gap-3">
              <div class="min-w-0">
                <div class="font-medium text-gray-900 truncate"><%= payment.contract&.contractor_name || payment.description || "Contract payment" %></div>
                <div class="text-sm text-gray-500">
                  <%= payment.description.presence || "We owe" %> · due <%= payment.due_date.strftime("%b %-d, %Y") %>
                </div>
              </div>
              <div class="flex items-center gap-3 flex-shrink-0">
                <span class="text-lg font-semibold text-gray-900 tabular-nums text-right">
                  <%= amount_set ? number_to_currency(payment.amount) : "TBD" %>
                  <%# What we hand back waits on ticket sales; our fee doesn't. %>
                  <% if (held_back = payment.guaranteed_fee) %>
                    <span class="block text-xs font-normal text-gray-500">after our <%= number_to_currency(held_back) %> fee</span>
                  <% end %>
                </span>
                <% if payment.status_paid? %>
                  <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-full">Paid</span>
                <% elsif in_run %>
                  <%= link_to manage_payout_batch_path(contribution.payout_batch), class: "inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium bg-blue-100 text-blue-700 rounded-full hover:bg-blue-200" do %>
                    In payout run
                  <% end %>
                <% elsif !amount_set %>
                  <span class="text-xs text-gray-400">Set an amount to pay</span>
                <% elsif payable %>
                  <%= render "shared/button", text: "Add to payout run", variant: "primary", size: "small",
                    path: add_to_payout_run_manage_contract_contract_payment_path(payment.contract, payment),
                    method: :post, form: { data: { turbo: false } } %>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium bg-amber-100 text-amber-700 rounded-full" title="They need to connect a bank before they can be paid.">Needs bank</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-5 py-8 text-center text-sm text-gray-500">
          <% if @contract&.ticket_revenue_minus_fee? && incoming.any? %>
            Nothing to hand back for this show — ticket sales came in under the fee.
          <% else %>
            No outgoing contract payments for this show yet.
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Expected income (money owed to us) -->
    <% if incoming.any? %>
      <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-200">
          <h3 class="font-semibold text-gray-900">Expected income</h3>
          <p class="text-sm text-gray-500 mt-0.5">Money owed to you under this contract for this show.</p>
        </div>
        <div class="divide-y divide-gray-100">
          <% incoming.each do |payment| %>
            <div class="px-5 py-4 flex items-center justify-between gap-3">
              <div class="min-w-0">
                <div class="font-medium text-gray-900 truncate"><%= payment.description.presence || "Payment" %></div>
                <div class="text-sm text-gray-500">due <%= payment.due_date.strftime("%b %-d, %Y") %></div>
                <% if payment.notes.present? %>
                  <div class="text-xs text-gray-500 mt-0.5"><%= payment.notes.lines.first.strip %></div>
                <% end %>
              </div>
              <div class="flex items-center gap-3 flex-shrink-0">
                <span class="text-lg font-semibold text-gray-900 tabular-nums"><%= payment.amount_tbd? ? "TBD" : number_to_currency(payment.amount) %></span>
                <% if payment.status_paid? %>
                  <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full bg-green-100 text-green-700">Paid</span>
                <% else %>
                  <%# Straight to where the money is actually collected or recorded. %>
                  <%= link_to manage_money_incoming_payment_path(payment) do %>
                    <%= render "shared/button", text: "Collect this payment", variant: "secondary", size: "small" %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Sidebar -->
  <div class="space-y-4">
    <div class="bg-white rounded-lg border border-gray-200 p-5">
      <div class="text-sm text-gray-500">Still to pay for this show</div>
      <div class="text-2xl font-bold text-gray-900 mt-1"><%= number_to_currency(owed_total) %></div>
      <p class="text-xs text-gray-500 mt-2">Add each contractor to your payout run to pay them to their bank, alongside your performers.</p>
    </div>

    <% if due_to_us_total > 0 %>
      <div class="bg-white rounded-lg border border-gray-200 p-5">
        <div class="text-sm text-gray-500">Still owed to you for this show</div>
        <div class="text-2xl font-bold text-gray-900 mt-1"><%= number_to_currency(due_to_us_total) %></div>
        <p class="text-xs text-gray-500 mt-2">Ticket revenue you're holding has already been counted against this.</p>
      </div>
    <% end %>

    <% if @contract %>
      <%= link_to manage_contract_path(@contract), class: "block bg-white rounded-lg border border-gray-200 p-4 hover:border-gray-300 transition-colors" do %>
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-gray-900">View full contract</span>
          <%= icon("arrow-right", class: "w-4 h-4 text-gray-400") %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
