<%# What the page says, ages, then seats, limits and fees — for every date
    that doesn't have its own (the page first, Tim, 2026-11-07). Locals:
    setup, production. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  fee_words = { "buyer" => "buyers pay the fees", "org" => "you absorb the fees" }
  cash_words = { "same" => "cash is the same as any other sale", "included" => "cash has tax included in the price" }
  # Its own fees, cash and order limit, or the box office's (one switch).
  own_fees = setup.fee_mode.present? || setup.cash_tax.present? || setup.max_per_order.present?
  box_office_words = "#{fee_words[ticketing_profile.default_fee_mode]}, #{cash_words[ticketing_profile.cash_tax]}, and up to #{ticketing_profile.default_max_per_order} tickets an order"
  tax = TicketTaxSetting.current(production.organization)
  poster = production.safe_poster_variant(:small)
  wide = production.wide_image.attached? ? production.safe_wide_image_variant : nil
%>
<%= form_with model: setup, scope: :production_ticketing, url: manage_update_production_ticketing_path(production, section: "sales"), method: :patch, class: "space-y-6" do |f| %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="page">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">The ticket page</h2>
      <p class="text-sm text-gray-600 mt-1">What buyers read. A box left empty shows the production's own name and description.</p>
    </div>
    <div class="px-6 py-5 space-y-4">
    <div>
      <label for="production_ticketing_title" class="block text-sm font-medium text-gray-700 mb-1.5">Title</label>
      <%= f.text_field :title, placeholder: production.name, class: input_class %>
    </div>
    <div>
      <label for="production_ticketing_page_key" class="block text-sm font-medium text-gray-700 mb-1.5">Address</label>
      <div class="flex flex-wrap items-center gap-x-1 gap-y-1.5">
        <span class="text-sm text-gray-500 break-all"><%= tickets_box_office_url(org: ticketing_profile.slug).sub(%r{\Ahttps?://}, "") %>/</span>
        <%= f.text_field :page_key, placeholder: production.public_key, pattern: "[a-z0-9][a-z0-9\\-]{2,29}", autocapitalize: "none", spellcheck: false,
              class: "#{input_class} sm:w-64 flex-1 sm:flex-none" %>
      </div>
      <p class="text-xs text-gray-500 mt-1.5">Blank means the production's own<%= " (#{production.public_key})" if production.public_key.present? %>. Lowercase letters, numbers and hyphens. Links to the old address keep working.</p>
    </div>
    <div>
      <label for="production_ticketing_description" class="block text-sm font-medium text-gray-700 mb-1.5">Description</label>
      <div data-controller="no-attachments">
        <%= f.rich_text_area :description, placeholder: production.description.to_plain_text.squish.truncate(200), class: "w-full min-h-[150px]" %>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="production_ticketing_door_note" class="block text-sm font-medium text-gray-700 mb-1.5">Doors</label>
        <%= f.text_field :door_note, placeholder: "Doors 30 min before", class: input_class %>
      </div>
      <div>
        <label for="production_ticketing_accessibility_note" class="block text-sm font-medium text-gray-700 mb-1.5">Accessibility</label>
        <%= f.text_field :accessibility_note, placeholder: "Step-free entry", class: input_class %>
      </div>
    </div>
    <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 flex items-center gap-4">
      <% if wide %><%= image_tag wide, alt: "", class: "w-24 h-auto rounded" %><% elsif poster %><%= image_tag poster, alt: "", class: "w-12 h-auto rounded" %><% end %>
      <p class="text-sm text-gray-600 flex-1">
        Images come from the production's Visual Assets: the wide image leads the page, the poster when there isn't one.
        <%= link_to "Open Visual Assets", edit_manage_production_path(production, tab: 1), class: "font-medium text-pink-600 hover:text-pink-700" %>
      </p>
    </div>
    </div>
  </div>

  <%= render "manage/production_ticketings/age_limit_fields", scope: "production_ticketing", age: setup.minimum_age, note: setup.age_note, input_class: input_class %>

  <%# Fees, cash and the order limit: the box office's, or (switch on) this
      production's own, by the one override control (manage/ticketing/own_switch). %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle" data-settings-card="fees">
    <%= render "manage/ticketing/own_switch", title: "Fees, cash, and order limit", follows: "your box office", followed: box_office_words,
          only: production.name, name: "production_ticketing[own_fees]", id: "production_ticketing_own_fees", checked: own_fees %>
    <fieldset <%= "disabled" unless own_fees %> data-fieldset-toggle-target="fields" class="px-6 py-5 disabled:opacity-50">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label for="production_ticketing_fee_mode" class="block text-sm font-medium text-gray-700 mb-1.5">Who pays the fees</label>
          <%= f.select :fee_mode, options_for_select([ [ "Buyers pay the fees", "buyer" ], [ "You absorb the fees", "org" ] ], setup.fee_mode.presence || ticketing_profile.default_fee_mode), {}, class: input_class %>
        </div>
        <div>
          <label for="production_ticketing_cash_tax" class="block text-sm font-medium text-gray-700 mb-1.5">Cash at the door</label>
          <%= f.select :cash_tax, options_for_select([ [ "The same as any other sale", "same" ], [ "Tax is included in the price", "included" ] ], setup.cash_tax.presence || ticketing_profile.cash_tax), {}, class: input_class %>
        </div>
        <div>
          <label for="production_ticketing_max_per_order" class="block text-sm font-medium text-gray-700 mb-1.5">Most tickets in one order</label>
          <%= f.number_field :max_per_order, min: 1, max: 100, value: setup.max_per_order || ticketing_profile.default_max_per_order, class: input_class %>
        </div>
      </div>
    </fieldset>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-settings-card="low-seats">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Low seats and tax</h2>
      <p class="text-sm text-gray-600 mt-1">The "Only N left" note appears beside a ticket type on your ticket page once that few seats remain, for example "Only 3 left". You also get one email when a date gets that low.</p>
    </div>
    <div class="px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="production_ticketing_low_stock_threshold" class="block text-sm font-medium text-gray-700 mb-1.5">Show an "Only N left" note</label>
        <%= f.select :low_stock_threshold, options_for_select(low_stock_choices(setup.low_stock_threshold), setup.low_stock_threshold || TicketListing::LOW_STOCK_DEFAULT), {}, class: input_class %>
      </div>
      <div class="sm:pt-7">
        <p class="text-sm text-gray-600">
          Tax: <%= tax.set? ? "#{tax.percent}% #{tax.name.downcase}, #{tax.mode == 'included' ? 'included in prices' : 'added at checkout'}" : "none" %>.
          <%= link_to "Change in Ticketing settings", manage_ticketing_settings_section_path(section: "tax"), class: "text-pink-600 hover:text-pink-700" %>
        </p>
      </div>
    </div>
  </div>

  <%= render "shared/button", text: "Save", variant: "primary", size: "medium", type: :submit %>
<% end %>
