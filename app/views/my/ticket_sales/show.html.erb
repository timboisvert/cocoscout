<% content_for :title, "#{@listing.display_title} · Ticket Sales" %>
<% show = @listing.show %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [ [ "Ticket Sales", my_ticket_sales_path ] ],
    text: "#{@listing.display_title} · #{show.date_and_time.strftime('%a %b %-d')}",
    links: []
  } %>

  <%# The date and where; the organization's name is the breadcrumb's (Tim, 2026-10-18). %>
  <p class="text-sm text-gray-600 mb-6"><%= show.date_and_time.strftime("%A, %B %-d · %-l:%M %p") %><%= " · #{show.location.name}" if show.location %></p>

  <%
    # Comps for someone on the date's contract (contract people,
    # docs/contract_people_plan.md), within what the date can still give away.
    can_comp = @allowance.present? && (@allowance[:left].nil? || @allowance[:left].positive?)
    comps_note = if @allowance.nil? then nil
                 elsif @allowance[:left].nil? then "Given away free · give tickets"
                 elsif @allowance[:left].positive? then "Given away free · give #{@allowance[:left]} more"
                 else "Given away free · none left to give"
                 end
  %>
  <div class="max-w-4xl space-y-6">
    <%= render "shared/ticketing/show_numbers", stats: @stats, read_only: true, comps_modal: ("comps-modal" if can_comp), comps_note: comps_note %>

    <% if @allowance %>
      <div class="rounded-lg border border-gray-200 bg-white p-3 sm:max-w-sm" data-comps-tile>
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Your comps for this date</div>
        <p class="mt-1 text-sm text-gray-700">
          <% if @allowance[:date_left] %><%= pluralize(@allowance[:date_left], "comp") %> left on this date.<% else %>No limit, up to the seats left.<% end %>
          Each one takes a seat and says it came from you.
        </p>
        <div class="mt-2">
          <% if can_comp %>
            <%= render "shared/button", text: @allowance[:left] ? "Give comps · #{@allowance[:left]} left" : "Give comps",
                  variant: "primary", size: "small", type: :button, data: { controller: "modal", action: "click->modal#open", modal_id: "comps-modal" } %>
          <% else %>
            <span class="text-xs text-gray-500">None left to give.</span>
          <% end %>
        </div>
      </div>
    <% end %>

    <div id="guests" class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-200">
        <h2 class="text-sm font-semibold text-gray-900">Who's coming <span class="font-normal text-gray-500">· <%= pluralize(@stats.sold, "ticket") %></span></h2>
      </div>
      <%= render "shared/ticketing/guest_list", orders: @guest_orders, read_only: true %>
    </div>

    <% if can_comp %>
      <%= render "manage/ticket_listings/comps_modal", id: "comps-modal", listing: @listing,
            url: my_ticket_sale_comps_path(@listing), preview_url: my_ticket_sale_comps_preview_path(@listing), max: @allowance[:left],
            allowance_note: (@allowance[:left] ? "You can give #{@allowance[:left]} more for this date." : nil),
            note_label: "Note for the box office" %>
    <% end %>
  </div>
</div>
