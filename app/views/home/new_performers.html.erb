<% content_for :title, "For Performers & Staff — CocoScout" %>

<div class="min-h-screen bg-[#f9f9f7]">
  <%= render "shared/marketing/header" %>

  <main class="flex flex-col min-w-full">

    <%# ============================ HERO ============================ %>
    <section class="w-full px-6 pt-16 pb-14 sm:pt-24 sm:pb-20 bg-gradient-to-br from-pink-50 via-white to-slate-50">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-pink-500 font-bold text-sm uppercase tracking-wide mb-4">For performers &amp; staff</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-900 mb-5 coustard-regular leading-tight">
          Your whole performing life, in one place.
        </h1>
        <p class="text-lg sm:text-xl max-w-2xl mx-auto text-slate-600 leading-relaxed mb-8">
          Every show, rehearsal, course, and shift — plus your pay and your profile — across every
          company you work with. Free, forever.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <%= render "shared/button", text: "Create your free account", path: signup_path, variant: "primary", size: "large" %>
          <%= render "shared/button", text: "Find a mic", path: mics_home_path, variant: "outline", size: "large" %>
        </div>
        <p class="mt-5 text-sm text-slate-500">Free for performers and staff members. Always.</p>
      </div>
    </section>

    <%# ==================== DEEP FEATURE AREAS ==================== %>
    <% [
      { bg: "bg-white", eyebrow: "Your schedule", title: "Every show, rehearsal, and shift — one calendar.",
        desc: "No more juggling group chats and half a dozen companies' calendars. Everything you're part of lands in one place.",
        bullets: ["A unified calendar across every company you work with", "The shows and events you're cast in", "Confirm your scheduled shifts and log the hours you work", "Auditions and courses on the same timeline"] },
      { bg: "bg-[#f9f9f7]", eyebrow: "Get paid", title: "Paid straight to your bank.",
        desc: "Whether you're performing or on staff, connect your bank once and get paid directly — no chasing checks.",
        bullets: ["Connect your bank one time, get paid every time", "See exactly what you're owed, itemized by what it's for", "Your full pay history in one place", "Hours you log flow straight into your pay"] },
      { bg: "bg-white", eyebrow: "Your profile &amp; bookings", title: "A home base companies can find.",
        desc: "Keep one profile that shows your work and controls how you're reached — and handle the paperwork in the same spot.",
        bullets: ["A profile that shows who you are and what you do", "Availability you control, so you only get asked when you're free", "Audition submissions tracked from sent to cast", "Contracts you review and e-sign in a click"] },
      { bg: "bg-[#f9f9f7]", eyebrow: "Stay in the loop", title: "Never miss a request.",
        desc: "Everything the companies you work with send you, in one inbox — so nothing slips through the cracks.",
        bullets: ["Messages from every company in one place", "Open casting and booking requests awaiting your reply", "Shoutouts from your peers", "Documents and courses shared with you"] }
    ].each do |area| %>
      <section class="w-full px-6 py-16 sm:py-20 border-t border-slate-100 <%= area[:bg] %>">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-10 items-start">
          <div>
            <p class="text-pink-500 font-bold text-sm uppercase tracking-wide mb-3"><%= area[:eyebrow].html_safe %></p>
            <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 coustard-regular leading-tight mb-4"><%= area[:title] %></h2>
            <p class="text-lg text-slate-600 leading-relaxed"><%= area[:desc] %></p>
          </div>
          <ul class="space-y-3">
            <% area[:bullets].each do |b| %>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 w-6 h-6 rounded-full bg-pink-100 text-pink-500 flex items-center justify-center flex-shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                </span>
                <span class="text-slate-800 leading-relaxed"><%= b %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </section>
    <% end %>

    <%# ==================== FREE FOREVER BAND ==================== %>
    <section class="w-full px-6 py-16 sm:py-20 border-t border-slate-100 bg-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 coustard-regular leading-tight mb-4">
          Free for performers and staff. Always.
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
          CocoScout is built for the companies that run live entertainment — and it's a gift to the
          people who make it happen. You never pay to use it.
        </p>
      </div>
    </section>

    <%# ============================ CTA BAND ============================ %>
    <section class="w-full bg-pink-500 text-white px-6 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl coustard-regular mb-3">Make CocoScout your home base.</h2>
        <p class="text-pink-100 text-lg mb-8 max-w-2xl mx-auto">Create your free account and keep your whole performing life in one place.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <%= link_to "Create your free account", signup_path,
                class: "inline-flex justify-center items-center px-8 py-3 rounded bg-white text-pink-700 font-semibold hover:bg-pink-50 transition" %>
          <%= link_to "Find a mic", mics_home_path,
                class: "inline-flex justify-center items-center px-8 py-3 rounded border border-white/70 text-white font-medium hover:bg-white/10 transition" %>
        </div>
      </div>
    </section>

  </main>

  <%= render "shared/marketing/footer" %>
</div>
