<% content_for :title, "Audition Session" %>
<div class="w-full">
  <%= render partial: "shared/notice", locals: { notice: notice } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Sign-ups", manage_signups_path],
      [@production.name, manage_signups_production_path(@production)],
      ["Auditions", manage_signups_auditions_path(@production)],
      ["Sessions", manage_signups_auditions_cycle_sessions_path(@production, @audition_cycle)]
    ],
    text: "#{@audition_session.start_at.strftime("%b %-d, %Y at %-l:%M %p")}",
    links: []
  } %>

  <%= render partial: "manage/auditions/cycle_status_panel" %>
  <%= render partial: "manage/auditions/topical_nav", locals: { current_topic: :sessions } %>

  <% if current_user_has_role?(@production) %>
    <div class="mb-4 p-4 bg-white border border-gray-200 rounded-lg shadow-sm">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="flex-shrink-0">
            <% if @audition_cycle.audition_voting_enabled %>
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
              </span>
            <% else %>
              <span class="relative flex h-3 w-3">
                <span class="relative inline-flex rounded-full h-3 w-3 bg-gray-400"></span>
              </span>
            <% end %>
          </div>
          <div>
            <p class="text-base font-semibold <%= @audition_cycle.audition_voting_enabled ? 'text-green-700' : 'text-gray-700' %>">
              Voting is <%= @audition_cycle.audition_voting_enabled ? 'live' : 'paused' %>
            </p>
            <p class="text-sm text-gray-600">
              <% if @audition_cycle.audition_voting_enabled %>
                <%= @audition_cycle.reviewer_count %> <%= 'reviewer'.pluralize(@audition_cycle.reviewer_count) %> can vote
              <% else %>
                Voting bar is hidden
              <% end %>
            </p>
          </div>
        </div>
        <label class="flex items-center gap-2 cursor-pointer"
               data-controller="toggle-voting"
               data-toggle-voting-cycle-id-value="<%= @audition_cycle.id %>"
               data-toggle-voting-enabled-value="<%= @audition_cycle.audition_voting_enabled %>"
               data-toggle-voting-url-value="<%= manage_toggle_voting_signups_auditions_cycle_path(@production, @audition_cycle) %>"
               data-toggle-voting-voting-type-value="audition">
          <span class="text-sm font-semibold <%= @audition_cycle.audition_voting_enabled ? 'text-gray-700' : 'text-gray-400' %>">
            <%= @audition_cycle.audition_voting_enabled ? 'Enabled' : 'Disabled' %>
          </span>
          <div class="relative inline-block w-10 h-6 transition duration-200 ease-in-out">
            <input type="checkbox"
                   <%= 'checked' if @audition_cycle.audition_voting_enabled %>
                   data-action="change->toggle-voting#change"
                   class="sr-only peer">
            <div class="block w-10 h-6 rounded-full <%= @audition_cycle.audition_voting_enabled ? 'bg-pink-500' : 'bg-gray-300' %> peer-focus:ring-2 peer-focus:ring-pink-300"></div>
            <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform <%= @audition_cycle.audition_voting_enabled ? 'translate-x-4' : 'translate-x-0' %>"></div>
          </div>
        </label>
      </div>
    </div>
  <% end %>

  <div class="space-y-1 mb-4">
    <% if @auditions.any? %>
      <% @auditions.each do |audition| %>
        <% requestable = audition.audition_request&.requestable %>
        <% vote_counts = audition.vote_counts if current_user_can_review?(@production) %>

        <%= link_to manage_signups_auditions_cycle_session_audition_path(@production, @audition_cycle, @audition_session, audition),
            class: "flex items-stretch px-3 py-2 border rounded-lg hover:border-gray-400 transition-all bg-white border-gray-200",
            data: { turbo_prefetch: false } do %>

          <%# The review card, with the RSVP under the name. %>
          <%
            rsvp = if requestable.present?
              tip = audition.accepted? ? "Auditionee confirmed they will attend" : (audition.declined? ? "Auditionee declined the slot" : "Invitation sent — auditionee has not responded yet")
              badge = if audition.accepted? then [ "RSVP'd Yes", "bg-green-100 text-green-800" ]
                      elsif audition.declined? then [ "RSVP'd No", "bg-red-100 text-red-800" ]
                      else [ "RSVP Pending", "bg-amber-100 text-amber-800" ]
                      end
              tag.span(badge[0], class: "inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium #{badge[1]}", data: { controller: "tooltip", tooltip_text: tip })
            end
          %>
          <%= render "shared/review_card", member: requestable, size: :lg, subline: rsvp,
                vote_counts: (current_user_can_review?(@production) ? vote_counts : nil) %>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-gray-500 text-sm pt-2">
        No one is scheduled for this audition session yet.
      </p>
    <% end %>
  </div>
</div>