<%
  has_financials = @show_financials&.has_data?
%>

<!-- Actions -->
<div class="bg-white rounded-lg border border-gray-200 p-5">
  <h3 class="font-semibold text-gray-900 mb-4">Actions</h3>
  <div class="space-y-3">
    <%# Financials entry / view %>
    <%= link_to manage_money_show_financials_path(@show), class: "flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors" do %>
      <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center flex-shrink-0">
        <%= icon("chart-bar", class: "w-5 h-5 text-pink-600") %>
      </div>
      <div class="flex-1">
        <div class="font-medium text-gray-900"><%= has_financials ? "View Financials" : "Enter Financials" %></div>
        <div class="text-xs text-gray-500"><%= has_financials ? "Revenue and expense data" : "Add revenue to see the split" %></div>
      </div>
      <%= icon("chevron-right", class: "w-5 h-5 text-gray-400") %>
    <% end %>

    <%# The contractor is paid on the contract, through the payout run. %>
    <%= link_to manage_contract_path(@contract), class: "flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors" do %>
      <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
        <%= icon("file-text", class: "w-5 h-5 text-gray-600") %>
      </div>
      <div class="flex-1">
        <div class="font-medium text-gray-900">Contract & Payments</div>
        <div class="text-xs text-gray-500">Where this contractor gets paid</div>
      </div>
      <%= icon("chevron-right", class: "w-5 h-5 text-gray-400") %>
    <% end %>
  </div>
</div>
