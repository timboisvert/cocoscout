<%#
  Review the dates (2026-10-16): every date a contract books, with its kind,
  place, terms and cost, each editable for that date alone (down to $0) or
  several ticked together. The wizard's second Financials screen, and the
  same in "Change the deal".

  Locals:
    contract       the contract whose deal the dates follow (in an amendment,
                   a stand-in with the deal as amended so far)
    rows           contract_date_rows(...)
    edit_path      PATCH saves dates' terms; POST moves on
    schedule_path  "Change the schedule"
    deal_path      "Change the deal" and Back
    next_label     the Next button
    footnote       optional line under the list
%>
<%
  kinds = rows.group_by(&:event_type)
  editable_kinds = rows.select(&:field).map(&:event_type).uniq
  fixed_total = rows.sum { |r| r.fixed_amount.to_f }
  # Settled dates count too; they just can't be edited.
  share_rows = rows.select { |r| contract.date_term_field(r.event_type) == :share }
  fee_rows = rows.select { |r| contract.date_term_field(r.event_type) == :amount && !r.fixed_amount }
%>
<div data-controller="contract-dates">
  <h2 class="text-xl font-bold text-gray-900 mb-2 coustard-regular">Review the dates</h2>
  <p class="text-gray-600 mb-6">Every date this contract books, and what the deal means for it. Edit one to change just that date, down to $0.</p>

  <% if rows.any? %>
    <div class="mb-5 rounded-lg border border-pink-200 bg-pink-50 px-4 py-3 flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-[17px] font-semibold text-pink-900"><%= pluralize(rows.size, "date") %> booked</p>
        <p class="text-sm text-pink-700"><%= contract_dates_summary(rows) %></p>
      </div>
      <%= link_to "Change the schedule", schedule_path, class: "text-sm font-medium text-pink-600 hover:text-pink-700" %>
    </div>

    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
      <% if kinds.size > 1 %>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Show">
          <button type="button" data-contract-dates-target="pill" data-kind="" data-action="contract-dates#filter"
                  class="rounded-full border px-3 py-1.5 text-sm font-medium cursor-pointer border-pink-300 bg-pink-50 text-pink-700">All <%= rows.size %></button>
          <% kinds.each do |type, kind_rows| %>
            <button type="button" data-contract-dates-target="pill" data-kind="<%= type %>" data-action="contract-dates#filter"
                    class="rounded-full border px-3 py-1.5 text-sm font-medium cursor-pointer border-gray-300 bg-white text-gray-700"><%= kind_rows.first.kind.pluralize %> <%= kind_rows.size %></button>
          <% end %>
        </div>
      <% else %>
        <span></span>
      <% end %>
      <p class="text-sm text-gray-500">
        <% money_line = contract.deal_summary.detect { |line| line[:label] == "How the money works" }&.dig(:value) %>
        <%= "#{money_line} ·" if money_line %>
        <%= link_to "Change the deal", deal_path, class: "font-medium text-pink-600 hover:text-pink-700" %>
      </p>
    </div>

    <%# A table when the box is wide enough, cards when it isn't (the wizard's
        column is narrow even on a desktop). %>
    <div class="@container rounded-lg border border-gray-200 overflow-hidden bg-white">
      <div class="hidden @3xl:grid grid-cols-[1.25rem_minmax(0,12rem)_6.5rem_minmax(0,1fr)_7rem_4rem] items-center gap-4 px-4 py-2.5 bg-gray-50 border-b border-gray-200 text-xs font-semibold uppercase tracking-wide text-gray-500">
        <% if editable_kinds.any? %>
          <input type="checkbox" aria-label="Select every date" data-contract-dates-target="all" data-action="contract-dates#toggleAll"
                 class="h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
        <% else %>
          <span></span>
        <% end %>
        <span>Date</span><span>Kind</span><span>Terms</span><span class="text-right">Cost</span><span></span>
      </div>
      <div class="divide-y divide-gray-100">
        <% rows.each_with_index do |row, i| %>
          <% modal_id = "date-terms-#{i}" %>
          <div class="px-4 py-3 flex flex-col gap-2 @3xl:grid @3xl:grid-cols-[1.25rem_minmax(0,12rem)_6.5rem_minmax(0,1fr)_7rem_4rem] @3xl:items-center @3xl:gap-4"
               data-contract-dates-target="row" data-kind="<%= row.event_type %>">
            <div class="flex items-center gap-3 @3xl:contents">
              <% if row.field %>
                <input type="checkbox" name="dates[]" value="<%= row.starts_at %>" form="date-terms-several"
                       aria-label="Select <%= row.at.strftime('%b %-d') %>" data-contract-dates-target="check" data-kind="<%= row.event_type %>"
                       data-action="contract-dates#changed" class="h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500">
              <% else %>
                <span class="hidden @3xl:block"></span>
              <% end %>
              <span class="flex-1 min-w-0 flex flex-col">
                <span class="text-sm font-medium text-gray-900"><%= row.at.strftime("%a, %b %-d · %-l:%M %p") %></span>
                <span class="text-xs text-gray-500"><%= [ date_length_words(row.hours), row.place ].compact.join(" · ") %></span>
              </span>
              <span class="@3xl:hidden inline-flex items-center rounded-full bg-pink-100 px-2 py-0.5 text-xs font-medium text-pink-700"><%= row.kind %></span>
            </div>
            <span class="hidden @3xl:inline-flex"><span class="inline-flex items-center rounded-full bg-pink-100 px-2 py-0.5 text-xs font-medium text-pink-700"><%= row.kind %></span></span>
            <span class="flex flex-col min-w-0">
              <span class="text-sm text-gray-900"><%= row.line %></span>
              <% if row.sub %><span class="text-xs <%= row.changed ? 'text-pink-700' : 'text-gray-500' %>"><%= row.sub %></span><% end %>
              <% if row.terms["note"].present? %><span class="text-xs text-gray-500 italic"><%= row.terms["note"] %></span><% end %>
            </span>
            <div class="flex items-center justify-between gap-3 @3xl:contents">
              <span class="text-sm font-semibold text-gray-900 tabular-nums @3xl:text-right"><%= row.cost %></span>
              <span class="@3xl:text-right">
                <% if row.field %>
                  <%= render "shared/button", text: "Edit", variant: "secondary", size: "small", type: :button,
                        data: { controller: "modal", action: "click->modal#open", modal_id: modal_id } %>
                <% elsif row.settled %>
                  <span class="text-xs text-gray-500">Settled</span>
                <% end %>
              </span>
            </div>
          </div>
          <% if row.field %>
            <%= render "manage/contracts/date_terms_modal", id: modal_id, url: edit_path, method: :patch,
                  title: "#{row.at.strftime('%a, %b %-d')} · #{row.kind}", contract: contract,
                  sections: [ { event_type: row.event_type,
                                value: (row.terms[row.field.to_s] || row.usual),
                                copy: date_term_field_copy(contract, row.event_type) } ],
                  dates: [ row.starts_at ], note: row.terms["note"] %>
          <% end %>
        <% end %>
      </div>
      <div class="px-4 py-3 bg-gray-50 border-t border-gray-200 flex flex-wrap items-center justify-between gap-3 text-sm">
        <span class="flex items-center gap-3">
          <% if editable_kinds.any? %>
            <span class="text-gray-600" data-contract-dates-target="hint">Tick dates to edit several at once.</span>
            <span class="hidden" data-contract-dates-target="several">
              <%= render "shared/button", text: "Edit the ticked dates", variant: "primary", size: "small", type: :button,
                    data: { controller: "modal", action: "click->modal#open", modal_id: "date-terms-several-modal" } %>
            </span>
          <% end %>
        </span>
        <span class="text-gray-900">
          <% parts = [] %>
          <% parts << "Fixed charges #{number_to_currency(fixed_total)}" if rows.any?(&:fixed_amount) %>
          <% parts << "plus our share of sales on #{pluralize(share_rows.size, 'show')}" if share_rows.any? %>
          <% parts << "plus our fee on #{pluralize(fee_rows.size, 'show')}" if fee_rows.any? %>
          <%= parts.join(", ").presence || "Terms come from the deal" %>
        </span>
      </div>
    </div>

    <% if editable_kinds.any? %>
      <%= render "manage/contracts/date_terms_modal", id: "date-terms-several-modal", form_id: "date-terms-several",
            url: edit_path, method: :patch, title: "Edit the ticked dates", contract: contract,
            sections: editable_kinds.map { |type| { event_type: type, value: contract.usual_date_term(type),
                                                   copy: date_term_field_copy(contract, type), several: true } },
            dates: [], note: nil %>
    <% end %>

    <% if local_assigns[:footnote] %><p class="mt-4 text-sm text-gray-500"><%= footnote %></p><% end %>
  <% else %>
    <div class="rounded-lg border border-gray-200 bg-white px-5 py-6 text-sm text-gray-600">
      No dates booked yet. <%= link_to "Set the schedule", schedule_path, class: "font-medium text-pink-600 hover:text-pink-700" %> first.
    </div>
  <% end %>

  <%= form_with url: edit_path, method: :post, class: "mt-6 flex items-center justify-between" do %>
    <%= render "shared/button", text: "Back to the deal", variant: "secondary", size: "medium", icon: "arrow-left", path: deal_path %>
    <%= render "shared/button", text: next_label, variant: "primary", size: "medium", type: :submit %>
  <% end %>
</div>
