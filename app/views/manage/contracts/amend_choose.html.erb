<%= render layout: "manage/contracts/amend_layout", locals: { step_name: "What are you changing?" } do %>
    <h2 class="text-2xl coustard-regular text-gray-900 mb-1">What are you changing?</h2>
    <p class="text-gray-600 mb-6">Changing when they're playing is a different job from changing the deal — so they're kept apart.</p>

    <div class="space-y-3">
      <%# The common case, and the safe one: nothing about the money is
          regenerated, so a settled date can't sprout a second payment. %>
      <%= link_to amend_dates_manage_contract_path(@contract),
            class: "block border border-gray-300 rounded-xl p-5 hover:border-pink-400 hover:bg-pink-50/40 transition-colors" do %>
        <div class="flex items-start gap-4">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-pink-100 text-pink-600 flex-shrink-0">
            <%= icon("calendar", class: "w-5 h-5") %>
          </span>
          <div>
            <p class="font-semibold text-gray-900">Change the dates</p>
            <p class="text-sm text-gray-600 mt-0.5">
              Cancel a night, move one, or add another. The payments tied to a date come and go with it;
              everything else about the deal is left alone.
            </p>
          </div>
        </div>
      <% end %>

      <%# Smaller again: the contract names the venue, not the room, so moving
          them between spaces is ours to do without new paper. Always offered —
          a venue with one room today may have two tomorrow. %>
      <%= link_to amend_space_manage_contract_path(@contract),
            class: "block border border-gray-300 rounded-xl p-5 hover:border-pink-400 hover:bg-pink-50/40 transition-colors" do %>
        <div class="flex items-start gap-4">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-pink-100 text-pink-600 flex-shrink-0">
            <%= icon("building", class: "w-5 h-5") %>
          </span>
          <div>
            <p class="font-semibold text-gray-900">Change the room</p>
            <p class="text-sm text-gray-600 mt-0.5">
              Put one night, or all of them, in a different space at the same venue. The dates, the money
              and the paperwork stay exactly as they are.
            </p>
          </div>
        </div>
      <% end %>

      <%= link_to amend_bookings_manage_contract_path(@contract),
            class: "block border border-gray-300 rounded-xl p-5 hover:border-pink-400 hover:bg-pink-50/40 transition-colors" do %>
        <div class="flex items-start gap-4">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-gray-100 text-gray-600 flex-shrink-0">
            <%= icon("dollar-sign", class: "w-5 h-5") %>
          </span>
          <div>
            <p class="font-semibold text-gray-900">Change the deal</p>
            <p class="text-sm text-gray-600 mt-0.5">
              The split or the fee, ticketing, services, or the booking pattern. Walks the full amendment
              and rebuilds the payment schedule around what's changed.
            </p>
          </div>
        </div>
      <% end %>
    </div>

<% end %>
