<%# This production's own refund policy, or (switch off) the box office's;
    its dates follow it (RefundPolicy.of_setup). The one override control
    (manage/ticketing/own_switch). Locals: setup, production. %>
<%
  input_class = "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition"
  own = setup.refund_policy.present?
  box_office_policy = ticketing_profile.refund_policy_object
  policy = RefundPolicy.of_setup(setup, ticketing_profile)
%>
<%= form_with url: manage_update_production_ticketing_path(production, section: "refunds"), method: :patch do %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-controller="fieldset-toggle radio-card" data-settings-card="refunds">
    <%= render "manage/ticketing/own_switch", title: "Refund policy", follows: "your box office", settings_path: manage_ticketing_settings_section_path(section: "refunds"),
          intro: "Buyers see it on the ticket page, at checkout and in their emails. Every date of #{production.name} follows it.",
          only: production.name, name: "production_ticketing[own_refund_policy]", id: "production_ticketing_own_refund_policy", checked: own %>
    <div class="px-6 py-5 space-y-4">
      <fieldset <%= "disabled" unless own %> data-fieldset-toggle-target="fields" class="space-y-3 disabled:opacity-50">
        <%= render "manage/ticketing_settings/refund_policy_fields", scope: "production_ticketing", policy: policy, input_class: input_class %>
      </fieldset>
      <p class="text-sm text-gray-600 rounded-lg bg-gray-50 border border-gray-200 px-3 py-2"><span class="font-medium text-gray-900">Buyers see:</span> <%= policy.words %></p>
    </div>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <%= render "shared/button", text: "Save", variant: "primary", size: "small", type: :submit %>
    </div>
  </div>
<% end %>
