<%#
  A side's comps for one date (Tim, 2026-11-20), where it issues them: a
  production team manager's sales page, a contract person's Tickets page on
  My. A full-width box like By ticket type: for this date, issued, and left
  to issue, with Issue comps and, when the comp rules let the side request
  (CompRequest), Request more comps. A request waiting, or the latest answer,
  is a line in the box; the request window is rendered here too.
  Locals: listing, allowance (TicketSalesAccess.comp_allowance), can_comp,
  comp_request (the side's waiting or latest request, or nil), request_url
  (POST to request, DELETE to withdraw), issued_words (who issued them).
%>
<%
  organization = listing.organization
  zone = organization.time_zone.presence || Time.zone.name
  side = allowance[:side]
  left = allowance[:left]
  given = allowance[:team_given].to_i
  total = allowance[:team_limit] || (left && given + left)
  extra = allowance[:extra].to_i
  waiting = comp_request&.waiting?
  can_request = left && listing.comp_requests_allowed?(side) && !waiting
  total_words = if allowance[:per_day] && allowance[:team_limit] then "Shared by every #{listing.production.name} show on this day"
                elsif extra.positive? then "Includes #{extra} approved on request"
                elsif side == :contract then "Shared by everyone on the contract"
                else "For your production team"
                end
  by = ->(request) { request.requested_by_id == Current.user&.id ? "You" : (request.requested_by.person&.name.presence || "Someone on your side") }
  on_day = ->(time) { time.in_time_zone(zone).strftime("%B %-d") }
  tile = "rounded-lg border border-gray-200 px-4 py-3"
%>
<div id="comps" class="bg-white border border-gray-200 rounded-lg overflow-hidden" data-comps-box>
  <div class="px-4 sm:px-5 py-3 border-b border-gray-200 flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-sm font-semibold text-gray-900">Comps</h2>
    <div class="flex flex-wrap gap-2">
      <% if can_request %>
        <%= render "shared/button", text: "Request more comps", variant: "secondary", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: "comp-request-modal" } %>
      <% end %>
      <% if can_comp %>
        <%= render "shared/button", text: "Issue comps", variant: "primary", size: "small", type: :button,
              data: { controller: "modal", action: "click->modal#open", modal_id: "comps-modal" } %>
      <% end %>
    </div>
  </div>
  <div class="px-4 sm:px-5 py-4 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="<%= tile %>">
        <div class="text-xs text-gray-500"><%= allowance[:per_day] && total ? "For this day" : "For this date" %></div>
        <div class="text-xl font-bold tabular-nums text-gray-900 mt-0.5"><%= total || "No limit" %></div>
        <div class="text-xs text-gray-500 mt-0.5"><%= total ? total_words : "Up to the seats left" %></div>
      </div>
      <div class="<%= tile %>">
        <div class="text-xs text-gray-500">Issued</div>
        <div class="text-xl font-bold tabular-nums text-gray-900 mt-0.5"><%= given %></div>
        <div class="text-xs text-gray-500 mt-0.5"><%= issued_words %></div>
      </div>
      <div class="<%= tile %>">
        <div class="text-xs text-gray-500">Left to issue</div>
        <div class="text-xl font-bold tabular-nums text-gray-900 mt-0.5"><%= left || "No limit" %></div>
        <div class="text-xs text-gray-500 mt-0.5">Each one takes a seat and says who issued it</div>
      </div>
    </div>

    <% if comp_request %>
      <%
        pill, pill_class, words = case comp_request.status
        when "waiting"
          [ "Requested", "bg-amber-100 text-amber-800",
            "#{by.call(comp_request)} requested #{CompRequestNotices.more_comps(comp_request.quantity)} on #{on_day.call(comp_request.created_at)}. #{organization.name} has been notified." ]
        when "approved"
          approved = comp_request.approved_quantity == comp_request.quantity ? "#{CompRequestNotices.more_comps(comp_request.quantity)}" : "#{comp_request.approved_quantity} of the #{CompRequestNotices.more_comps(comp_request.quantity)} requested"
          [ "Approved", "bg-green-100 text-green-700", "#{organization.name} approved #{approved} on #{on_day.call(comp_request.decided_at)}, for this date only." ]
        when "declined"
          [ "Declined", "bg-gray-200 text-gray-700",
            "#{organization.name} declined the request for #{CompRequestNotices.more_comps(comp_request.quantity)} on #{on_day.call(comp_request.decided_at)}. Your comps for this date are unchanged." ]
        else
          [ "Closed", "bg-gray-200 text-gray-700",
            comp_request.closed_reason == "showtime" ? "The request for #{CompRequestNotices.more_comps(comp_request.quantity)} closed when the date started." : comp_request.closed_reason == "canceled" ? "The request for #{CompRequestNotices.more_comps(comp_request.quantity)} closed when the date was canceled." : "The request for #{CompRequestNotices.more_comps(comp_request.quantity)} was closed: #{organization.name} no longer takes comp requests for this date." ]
        end
      %>
      <div class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 flex flex-wrap items-start justify-between gap-3" data-comp-request-status="<%= comp_request.status %>">
        <div class="min-w-0">
          <p class="text-sm text-gray-900"><span class="inline-flex rounded-md px-1.5 py-0.5 text-xs font-medium <%= pill_class %> mr-1.5"><%= pill %></span><%= words %></p>
          <% if comp_request.comment.present? %>
            <p class="text-sm text-gray-600 mt-1">Their comment: <%= comp_request.comment %></p>
          <% end %>
        </div>
        <% if waiting %>
          <%= form_with url: request_url, method: :delete, class: "flex-shrink-0" do %>
            <%= render "shared/button", text: "Withdraw the request", variant: "secondary", size: "small", type: :submit %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% if can_request %>
  <%= render layout: "shared/sheet", locals: { id: "comp-request-modal", title: "Request more comps",
        footer: capture {
          concat render("shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" })
          concat render("shared/button", text: "Send request", variant: "primary", size: "medium", type: :submit, form_id: "comp-request-form")
        } } do %>
    <%= form_with url: request_url, method: :post, id: "comp-request-form", class: "space-y-5" do %>
      <div>
        <div class="text-sm font-semibold text-gray-900"><%= listing.production.name %></div>
        <div class="text-sm text-gray-600"><%= listing.show.date_and_time.in_time_zone(zone).strftime("%A, %B %-d at %-l:%M %p") %></div>
      </div>
      <%= render "shared/ticketing/comp_count_fields", id: "comp_request_quantity", label: "How many more comps?", now: total, value: 2,
            added_words: "requested", total_words: "if approved" %>
      <div>
        <label for="comp_request_note" class="block text-sm font-medium text-gray-700 mb-1.5">Note for <%= organization.name %> <span class="font-normal text-gray-500">(optional)</span></label>
        <%= text_area_tag :note, nil, id: "comp_request_note", rows: 3, maxlength: 2000,
              class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" %>
      </div>
    <% end %>
  <% end %>
<% end %>
