<% content_for :title, @show.canceled ? "Manage Canceled #{@show.event_type.titleize}" : "Cancel #{@show.event_type.titleize}" %>

<div class="w-full"
     data-controller="cancel-show"
     data-cancel-show-event-type-value="<%= @show.event_type.titleize %>"
     data-cancel-show-single-date-value="<%= @show.date_and_time.strftime('%B %-d, %Y') %>"
     data-cancel-show-occurrence-count-value="<%= @show.recurring? ? @show.recurrence_group.count : 1 %>"
     data-cancel-show-future-count-value="<%= @show.recurring? ? @future_count : 1 %>">
  <%= render partial: "shared/notice", locals: { notice: notice } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Shows & Events", manage_shows_path],
      [@production.name, manage_production_shows_path(@production)]
    ],
    text: @show.canceled ? "Manage Canceled Event" : "Cancel or Delete Event",
    links: []
  } %>

  <!-- Event Info Card -->
  <div class="mt-5 bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="p-6">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
          <% if @show.canceled %>
            <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
            </svg>
          <% else %>
            <svg class="w-6 h-6 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          <% end %>
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="text-lg font-semibold text-gray-900">
            <%= @show.event_type.titleize %>
            <% if @show.secondary_name.present? %>
              <span class="text-gray-500 font-normal">- <%= @show.secondary_name %></span>
            <% end %>
            <% if @show.canceled %>
              <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">Canceled</span>
            <% end %>
          </h2>
          <p class="text-sm text-gray-600 mt-1">
            <%= @show.date_and_time.strftime("%A, %B %-d, %Y at %l:%M %p") %>
          </p>
          <% if @show.location.present? %>
            <p class="text-sm text-gray-500 mt-0.5"><%= @show.location.name %></p>
          <% end %>
          <% if @show.recurring? %>
            <p class="text-xs text-pink-600 mt-2">
              <svg class="w-3.5 h-3.5 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
              Part of a recurring series (<%= @show.recurrence_group.count %> occurrences)
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @show.canceled %>
    <!-- Uncancel Section -->
    <div class="mt-4 bg-white border border-gray-200 rounded-lg overflow-hidden">
      <%= render "shared/card_header", title: "Restore This Event" %>
      <div class="p-6">
        <p class="text-sm text-gray-600 mb-4">Remove the canceled status and restore this event to the calendar.</p>

        <% if @show.recurring? %>
          <div class="flex flex-wrap gap-2">
            <%= button_to manage_uncancel_show_path(@production, @show, scope: "this"), method: :patch do %>
              <%= render "shared/button", text: "Uncancel Only This Occurrence", variant: "success", size: "medium", type: :submit %>
            <% end %>

            <% uncancel_future_cid = "confirm-#{SecureRandom.hex(6)}" %>
            <button type="button" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= uncancel_future_cid %>">
              <%= render "shared/button", text: "Uncancel This & Future (#{@future_count})", variant: "success", size: "medium", type: :button %>
            </button>
            <%= render "shared/confirm_modal", id: uncancel_future_cid, title: "Uncancel occurrences?",
                  message: "Uncancel this and #{@future_count - 1} future #{'occurrence'.pluralize(@future_count - 1)}?", confirm_text: "Uncancel",
                  url: manage_uncancel_show_path(@production, @show, scope: "this_and_future"), method: :patch %>

            <%= button_to manage_uncancel_show_path(@production, @show, scope: "all"), method: :patch do %>
              <%= render "shared/button", text: "Uncancel All Canceled Occurrences", variant: "success", size: "medium", type: :submit %>
            <% end %>
          </div>
        <% else %>
          <%= button_to manage_uncancel_show_path(@production, @show), method: :patch do %>
            <%= render "shared/button", text: "Uncancel This #{@show.event_type.titleize}", variant: "success", size: "medium", type: :submit %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% else %>
    <!-- Cancel Section -->
    <div class="mt-4 bg-white border border-gray-200 rounded-lg overflow-hidden">
      <%= render "shared/card_header", title: "Cancel This Event" %>
      <div class="p-6">
        <p class="text-sm text-gray-600 mb-6">Mark as canceled but keep it visible in the calendar. You can uncancel it later if needed.</p>

        <%= form_with url: manage_cancel_show_path(@production, @show), method: :patch, id: "cancel-show-form", data: { "cancel-show-target": "cancelForm" } do |f| %>
          <input type="hidden" name="scope" value="this" data-cancel-show-target="scopeField">
          <input type="hidden" name="notify_cast" value="0" data-cancel-show-target="notifyField">
          <% @role_categories.each do |category| %>
            <input type="hidden" name="role_categories[]" value="<%= category %>" data-cancel-show-target="categoryField" data-category="<%= category %>">
          <% end %>

          <div class="space-y-4">
            <% if @show.recurring? %>
              <!-- Cancel Scope Selector -->
              <div class="py-3 border-b border-gray-100">
                <p class="text-sm font-medium text-gray-700 mb-2">What to cancel:</p>
                <div class="space-y-2">
                  <label class="flex items-center gap-3 cursor-pointer">
                    <input type="radio" name="cancel_scope" value="this" checked
                           data-cancel-show-target="scopeRadio"
                           data-action="change->cancel-show#toggleScope"
                           class="w-4 h-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500">
                    <div>
                      <p class="text-sm text-gray-700">Only this occurrence</p>
                      <p class="text-xs text-gray-500"><%= @show.date_and_time.strftime('%B %-d, %Y') %></p>
                    </div>
                  </label>
                  <label class="flex items-center gap-3 cursor-pointer">
                    <input type="radio" name="cancel_scope" value="this_and_future"
                           data-cancel-show-target="scopeRadio"
                           data-action="change->cancel-show#toggleScope"
                           class="w-4 h-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500">
                    <div>
                      <p class="text-sm text-gray-700">This & future occurrences (<%= @future_count %>)</p>
                      <p class="text-xs text-gray-500">From <%= @show.date_and_time.strftime('%B %-d, %Y') %> onward</p>
                    </div>
                  </label>
                  <label class="flex items-center gap-3 cursor-pointer">
                    <input type="radio" name="cancel_scope" value="all"
                           data-cancel-show-target="scopeRadio"
                           data-action="change->cancel-show#toggleScope"
                           class="w-4 h-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500">
                    <div>
                      <p class="text-sm text-gray-700">All <%= @show.recurrence_group.count %> occurrences</p>
                      <p class="text-xs text-gray-500">Cancel the entire recurring series</p>
                    </div>
                  </label>
                </div>
              </div>
            <% end %>

            <!-- Notify Cast Toggle -->
            <div class="flex items-center justify-between py-3 border-b border-gray-100">
              <div>
                <p class="text-sm font-medium text-gray-700 <%= 'text-gray-400' unless @people_with_email.any? %>">Notify cast members</p>
                <p class="text-xs text-gray-500 mt-1">
                  <% if @people_with_email.any? %>
                    <%= @people_with_email.count %> <%= 'person'.pluralize(@people_with_email.count) %> will receive an email notification
                  <% else %>
                    No cast members to notify
                  <% end %>
                </p>
              </div>
              <label class="relative inline-flex items-center <%= @people_with_email.any? ? 'cursor-pointer' : 'cursor-not-allowed opacity-50' %>">
                <input type="checkbox"
                       data-cancel-show-target="notifyCheckbox"
                       data-action="change->cancel-show#toggleNotifySection"
                       <%= 'disabled' unless @people_with_email.any? %>
                       class="sr-only peer">
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-pink-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-pink-500"></div>
              </label>
            </div>

            <% if @people_with_email.any? %>
              <!-- Notify Cast Section (Hidden by default) -->
              <div data-cancel-show-target="notifySection" class="hidden pt-4">
                <% if @role_categories.size > 1 %>
                  <!-- Category Filter -->
                  <div class="mb-4 p-3 bg-gray-50 border border-gray-200 rounded-lg">
                    <div class="text-sm font-medium text-gray-700 mb-2">Notify roles in these categories:</div>
                    <div class="flex flex-wrap gap-3">
                      <% @role_categories.each do |category| %>
                        <label class="flex items-center gap-2 cursor-pointer">
                          <input type="checkbox"
                                 checked
                                 data-cancel-show-target="categoryCheckbox"
                                 data-category="<%= category %>"
                                 data-action="change->cancel-show#toggleCategory"
                                 class="w-4 h-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500">
                          <span class="text-sm text-gray-700 capitalize"><%= category %></span>
                        </label>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <!-- Cast Members List (styled like contact_cast) -->
                <div class="mb-4">
                  <div class="flex items-center gap-2 mb-3">
                    <span class="text-sm font-medium text-gray-700">Sending to</span>
                    <span class="inline-flex items-center rounded-full bg-pink-100 px-2.5 py-0.5 text-xs font-medium text-pink-800">
                      <%= @cast_people.count + @cast_groups.count %> cast <%= 'member'.pluralize(@cast_people.count + @cast_groups.count) %>
                    </span>
                  </div>

                  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2">
                    <% @cast_people.sort_by(&:name).each do |person| %>
                      <div class="flex items-center gap-2 p-2 bg-gray-50 border border-gray-200 rounded-lg">
                        <% headshot_variant = person.safe_headshot_variant(:thumb) %>
                        <% if headshot_variant %>
                          <%= image_tag headshot_variant, alt: person.name, class: "w-8 h-8 rounded-lg object-cover flex-shrink-0" %>
                        <% else %>
                          <div class="w-8 h-8 rounded-lg bg-pink-100 flex items-center justify-center text-pink-600 font-bold text-xs flex-shrink-0">
                            <%= person.initials %>
                          </div>
                        <% end %>
                        <span class="text-xs font-medium text-gray-700 truncate"><%= person.name %></span>
                      </div>
                    <% end %>

                    <% @cast_groups.sort_by(&:name).each do |group| %>
                      <div class="flex items-center gap-2 p-2 bg-gray-50 border border-gray-200 rounded-lg">
                        <% headshot_variant = group.safe_headshot_variant(:thumb) %>
                        <% if headshot_variant %>
                          <%= image_tag headshot_variant, alt: group.name, class: "w-8 h-8 rounded-lg object-cover flex-shrink-0" %>
                        <% else %>
                          <div class="w-8 h-8 rounded-lg bg-pink-100 flex items-center justify-center text-pink-600 font-bold text-xs flex-shrink-0">
                            <%= group.initials %>
                          </div>
                        <% end %>
                        <span class="text-xs font-medium text-gray-700 truncate"><%= group.name %></span>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <div class="mt-6">
            <%= render "shared/button", text: "Cancel #{@show.event_type.titleize}", variant: "warning", size: "medium", type: :button,
                data: { controller: "modal", action: "click->modal#open", modal_id: "confirm-cancel-show" } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Delete Section -->
  <div class="mt-4 bg-white border border-gray-200 rounded-lg overflow-hidden">
    <%= render "shared/card_header", title: "Permanently Delete" %>
    <div class="p-6">
      <div class="flex items-start gap-3 mb-4">
        <svg class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <div>
          <p class="text-sm text-gray-700 font-medium">This action cannot be undone</p>
          <p class="text-sm text-gray-500 mt-0.5">The event and all associated data will be permanently removed.</p>
        </div>
      </div>

      <% if @show.recurring? %>
        <div class="flex flex-wrap gap-2">
          <% delete_this_cid = "confirm-#{SecureRandom.hex(6)}" %>
          <button type="button" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= delete_this_cid %>">
            <%= render "shared/button", text: "Delete Only This Occurrence", variant: "primary", size: "medium", type: :button %>
          </button>
          <%= render "shared/confirm_modal", id: delete_this_cid, title: "Delete occurrence?",
                message: "Are you sure you want to permanently delete this occurrence on #{@show.date_and_time.strftime('%B %-d, %Y')}? This cannot be undone.", confirm_text: "Delete",
                url: manage_delete_show_path(@production, @show, scope: "this"), method: :delete %>

          <% delete_future_cid = "confirm-#{SecureRandom.hex(6)}" %>
          <button type="button" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= delete_future_cid %>">
            <%= render "shared/button", text: "Delete This & Future (#{@future_count})", variant: "primary", size: "medium", type: :button %>
          </button>
          <%= render "shared/confirm_modal", id: delete_future_cid, title: "Delete occurrences?",
                message: "Are you sure you want to permanently delete this and #{@future_count - 1} future #{'occurrence'.pluralize(@future_count - 1)} (#{@future_count} total)? Past events will be kept. This cannot be undone.", confirm_text: "Delete",
                url: manage_delete_show_path(@production, @show, scope: "this_and_future"), method: :delete %>

          <% delete_all_cid = "confirm-#{SecureRandom.hex(6)}" %>
          <button type="button" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= delete_all_cid %>">
            <%= render "shared/button", text: "Delete All #{@show.recurrence_group.count} Occurrences", variant: "primary", size: "medium", type: :button %>
          </button>
          <%= render "shared/confirm_modal", id: delete_all_cid, title: "Delete all occurrences?",
                message: "Are you sure you want to permanently delete all #{@show.recurrence_group.count} occurrences in this series? This cannot be undone.", confirm_text: "Delete",
                url: manage_delete_show_path(@production, @show, scope: "all"), method: :delete %>
        </div>
      <% else %>
        <% delete_single_cid = "confirm-#{SecureRandom.hex(6)}" %>
        <button type="button" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= delete_single_cid %>">
          <%= render "shared/button", text: "Delete This #{@show.event_type.titleize}", variant: "primary", size: "medium", type: :button %>
        </button>
        <%= render "shared/confirm_modal", id: delete_single_cid, title: "Delete #{@show.event_type.downcase}?",
              message: "Are you sure you want to permanently delete this #{@show.event_type.downcase}? This cannot be undone.", confirm_text: "Delete",
              url: manage_delete_show_path(@production, @show, scope: "this"), method: :delete %>
      <% end %>
    </div>
  </div>

  <%# Confirmation for the cancel form above. The message tracks the selected scope (cancel-show#toggleScope keeps
      confirmMessage in sync); the confirm submits the real cancelForm via form= so its scope/notify/category fields ride along. %>
  <div id="confirm-cancel-show" class="hidden fixed inset-0 bg-black/50 z-[60] flex items-center justify-center p-4"
       data-controller="modal" data-action="click->modal#closeOnBackdrop">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full overflow-hidden" data-action="click->modal#stopPropagation">
      <div class="bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-white">Cancel <%= @show.event_type.downcase %>?</h3>
        <button type="button" class="text-white/80 hover:text-white" data-action="click->modal#close" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <div class="px-6 py-4">
        <p class="text-sm text-gray-600" data-cancel-show-target="confirmMessage">Are you sure you want to cancel this <%= @show.event_type.downcase %> on <%= @show.date_and_time.strftime('%B %-d, %Y') %>?</p>
      </div>
      <div class="px-6 py-4 bg-gray-50 flex justify-end gap-2">
        <%= render "shared/button", text: "Keep it", variant: "secondary", size: "medium", type: :button, data: { action: "click->modal#close" } %>
        <button type="submit" form="cancel-show-form" class="inline-flex items-center justify-center gap-2 font-medium rounded transition-colors cursor-pointer whitespace-nowrap bg-pink-500 hover:bg-pink-600 text-white px-3 py-1.5 text-sm sm:px-5 sm:py-2.5 sm:h-10">Cancel <%= @show.event_type.titleize %></button>
      </div>
    </div>
  </div>
</div>
