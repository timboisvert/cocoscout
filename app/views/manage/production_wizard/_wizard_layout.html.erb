<% content_for :title, "Create Production - #{step_name}" %>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>

  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Productions", manage_productions_path]
    ],
    text: "Create Production",
    links: []
  } %>

  <%
    # Build dynamic steps based on wizard state
    wizard_steps = [
      { num: 1, name: "Name", path: manage_productions_wizard_path },
      { num: 2, name: "Logo", path: manage_productions_wizard_logo_path },
      { num: 3, name: "Casting", path: manage_productions_wizard_casting_path },
      { num: 4, name: "Roles", path: manage_productions_wizard_roles_path },
      { num: 5, name: "Shows", path: manage_productions_wizard_shows_path }
    ]

    # Add Schedule step if user said they have shows
    if @wizard_state[:has_shows] == "yes"
      wizard_steps << { num: 6, name: "Schedule", path: manage_productions_wizard_schedule_path }
      wizard_steps << { num: 7, name: "Review", path: manage_productions_wizard_review_path }
    else
      wizard_steps << { num: 6, name: "Review", path: manage_productions_wizard_review_path }
    end

    current_index = wizard_steps.index { |s| s[:num] == current_step } || 0
  %>
  <%# Full-width step bar, directly below the breadcrumb. %>
  <%= render "shared/wizard_steps", steps: wizard_steps, current_index: current_index %>

  <div class="max-w-2xl mx-auto">
    <!-- Step Content -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <%= yield %>
    </div>

    <!-- Cancel Link -->
    <div class="mt-4 text-center">
      <% cancel_cid = "confirm-#{SecureRandom.hex(6)}" %>
      <button type="button"
              data-controller="modal"
              data-action="click->modal#open"
              data-modal-id="<%= cancel_cid %>"
              class="text-sm text-gray-500 hover:text-gray-700 bg-transparent border-0 cursor-pointer">Cancel</button>
      <%= render "shared/confirm_modal",
            id: cancel_cid,
            title: "Cancel?",
            message: "Are you sure you want to cancel? Your progress will be lost.",
            confirm_text: "Cancel",
            url: manage_productions_wizard_cancel_path,
            method: :delete %>
    </div>
  </div>
</div>
