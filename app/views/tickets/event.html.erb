<%
  show = @listing.show
  payload = Ticketing::ListingPayload.for(@listing)
  venue = payload[:venue]
  place = [ venue&.dig(:name), venue&.dig(:room) ].compact.uniq.join(" · ")
  address = venue && [ venue[:address1], venue[:city], venue[:state] ].compact_blank.join(", ")
  map_url = address.present? ? "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode([ venue[:name], address ].compact.join(', '))}" : nil
  page_url = tickets_event_url(org: @ticketing_profile.slug, event: @listing.slug)
  image, page_image = ticket_page_image(@listing)
  image_url = image && url_for(image)
  description = @listing.effective_description
  notes = [ @listing.effective_door_note, @listing.effective_accessibility_note ].compact_blank
  ages = @listing.age_words
  # Search engines read this to list the show (schema.org Event with all-in offers).
  structured = {
    "@context" => "https://schema.org",
    "@type" => "Event",
    "name" => payload[:title],
    "startDate" => payload[:starts_at],
    "endDate" => payload[:ends_at],
    "eventStatus" => show.canceled ? "https://schema.org/EventCancelled" : "https://schema.org/EventScheduled",
    "eventAttendanceMode" => show.is_online ? "https://schema.org/OnlineEventAttendanceMode" : "https://schema.org/OfflineEventAttendanceMode",
    "description" => description.to_s.truncate(500).presence,
    "image" => image_url,
    "typicalAgeRange" => (@listing.effective_minimum_age && "#{@listing.effective_minimum_age}-"),
    "organizer" => { "@type" => "Organization", "name" => @organization.name, "url" => tickets_box_office_url(org: @ticketing_profile.slug) },
    "location" => venue && { "@type" => "Place", "name" => venue[:name],
                             "address" => { "@type" => "PostalAddress", "streetAddress" => venue[:address1], "addressLocality" => venue[:city],
                                            "addressRegion" => venue[:state], "postalCode" => venue[:postal_code], "addressCountry" => "US" }.compact },
    "offers" => payload[:tiers].map { |tier|
      { "@type" => "Offer", "name" => tier[:name], "price" => format("%.2f", tier[:all_in_price_cents] / 100.0), "priceCurrency" => "USD",
        "availability" => tier[:remaining]&.zero? ? "https://schema.org/SoldOut" : "https://schema.org/InStock", "url" => page_url }
    }
  }.compact
%>
<% content_for :title, "#{@listing.display_title} · #{show.date_and_time.strftime('%b %-d')} · #{@organization.name}" %>
<% content_for :head do %>
  <meta name="description" content="<%= description.to_s.truncate(160) %>">
  <meta property="og:title" content="<%= @listing.display_title %> · <%= show.date_and_time.strftime('%a, %b %-d') %>">
  <meta property="og:description" content="<%= description.to_s.truncate(200) %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= page_url %>">
  <% if image_url %>
    <meta property="og:image" content="<%= image_url %>">
    <meta name="twitter:card" content="summary_large_image">
  <% end %>
  <% unless @preview %>
    <script type="application/ld+json"><%= json_escape(structured.to_json).html_safe %></script>
  <% end %>
<% end %>

<%# Layout A (Tim, 2026-10-01): one calm centered column, the same on a phone and a desktop. %>
<div class="mx-auto max-w-xl space-y-5">
  <%# The whole image at its own shape, never cropped: a wide image spans the
      column, a poster sits centered. %>
  <% if image_url %>
    <%= image_tag image_url, alt: (page_image.wide? ? "" : "#{@listing.production.name} poster"),
          class: page_image.wide? ? "w-full h-auto rounded-2xl" : "mx-auto max-h-[28rem] w-auto h-auto rounded-2xl" %>
  <% end %>

  <div class="text-center space-y-1.5">
    <% if @listing.display_title != @listing.production.name %>
      <%= link_to @listing.production.name, ticket_production_path(@ticketing_profile, @listing.production, **embed_params),
            class: "text-sm font-medium text-pink-700 hover:text-pink-800" %>
    <% end %>
    <h1 class="text-3xl sm:text-4xl coustard-regular text-gray-900"><%= @listing.display_title %></h1>
    <p class="text-base text-gray-800"><%= show.date_and_time.strftime("%A, %B %-d · %-l:%M %p") %></p>
    <% if show.is_online %>
      <p class="text-sm text-gray-600">Online</p>
    <% elsif place.present? %>
      <p class="text-sm text-gray-600">
        <%= place %><% if address.present? %> · <%= address %><% end %>
        <% if map_url %> · <%= link_to "Directions", map_url, target: "_blank", rel: "noopener", class: "text-pink-700 hover:text-pink-800" %><% end %>
      </p>
    <% end %>
    <% if ages %><p class="text-sm font-semibold text-gray-900"><%= ages %></p><% end %>
    <% if notes.any? %><p class="text-sm text-gray-600"><%= notes.join(" · ") %></p><% end %>
    <p class="text-sm">
      <%= link_to "Other dates", ticket_production_path(@ticketing_profile, @listing.production, **embed_params),
            class: "text-pink-700 hover:text-pink-800" %>
    </p>
  </div>

  <%= render "tickets/picker", listing: @listing, tiers: @tiers, inventory: @inventory, tax: @tax, code: @code, preview: @preview,
        profile: @ticketing_profile, code_url: tickets_event_path(org: @ticketing_profile.slug, event: @listing.slug) %>

  <% @passes.each do |pass| %>
    <%= render "tickets/pass_card", pass: pass, profile: @ticketing_profile, save: true %>
  <% end %>

  <% if description %>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
      <h2 class="font-semibold text-gray-900">About the show</h2>
      <div class="mt-2 text-gray-700 space-y-3 leading-relaxed"><%= simple_format(description) %></div>
    </div>
  <% end %>
</div>
