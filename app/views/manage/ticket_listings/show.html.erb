<% content_for :title, @listing.display_title %>
<%
  show = @listing.show
  inventory = @stats.inventory
  status_label, status_classes = ticket_listing_status_badge(@listing, inventory)
  filters = [ [ "all", "Everyone" ], [ "waiting", "Not in yet" ], [ "in", "Checked in" ], [ "comps", "Comps" ], [ "refunded", "Refunded" ] ]
  filter_path = ->(f) { manage_ticket_listing_path(@listing, guests: f == "all" ? nil : f, q: @query.presence, anchor: "guests") }
  live = !@listing.status.in?(%w[canceled]) && !show.canceled
  upcoming = show.date_and_time > Time.current
  short_url = short_link_url(code: ShortLink.canonical_for!(@listing.production).code, date: ShortLink.date_suffix(@listing.show))
  # Heroicons (outline), one per action.
  icons = {
    door: "M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z",
    gift: "M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7",
    orders: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01",
    eye: [ "M15 12a3 3 0 11-6 0 3 3 0 016 0z", "M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" ],
    cog: [ "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z", "M15 12a3 3 0 11-6 0 3 3 0 016 0z" ],
    cancel: "M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z",
    share: "M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z",
    globe: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
  }
  outside = @stats.outside_sold
  actions = [
    ({ text: "Door", description: "Scan tickets and sell at the door", path: door_path(@listing), icon: icons[:door] } if live && @listing.status != "draft"),
    ({ text: "Give tickets", description: "Comps for guests and press", path: manage_new_ticket_listing_comps_path(@listing), icon: icons[:gift] } if live),
    ({ text: "Sold elsewhere", description: outside.positive? ? "#{pluralize(outside, 'ticket')} on other sites" : "Tickets sold on other sites",
       path: "#", icon: icons[:globe], data: { controller: "modal", action: "click->modal#open", modal_id: "outside-sales-modal" } } if live),
    { text: "Orders", description: "Every order for this show", path: manage_ticket_orders_path(listing_id: @listing.id), icon: icons[:orders] },
    { text: "Settings", description: "Prices, seats, sales window, page and image", path: manage_edit_ticket_listing_path(@listing), icon: icons[:cog] },
    { text: "Visibility", description: "Who can see this show's sales", path: manage_ticket_listing_visibility_path(@listing), icon: icons[:share] },
    ({ text: "Cancel this show", description: "In Shows & Events, with refunds for buyers", path: manage_cancel_show_form_path(@listing.production, show), icon: icons[:cancel], tone: :muted } if @listing.status != "canceled" && !show.canceled && upcoming)
  ]
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: ticket_listing_breadcrumbs(@listing, include_date: false),
    text: ticket_listing_date_label(@listing),
    links: []
  } %>

  <%# Where it stands, and the one thing to do next. %>
  <div class="bg-white border border-gray-200 rounded-lg p-5 space-y-4 mb-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2 min-w-0">
        <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium <%= status_classes %>"><%= status_label %></span>
        <span class="text-sm text-gray-900"><%= show.date_and_time.strftime("%A, %B %-d · %-l:%M %p") %></span>
      </div>
      <%= render "manage/ticket_listings/status_actions", listing: @listing %>
    </div>
    <%# Just the short address: the production's code with this date picked. %>
    <%= render "shared/copy_url", url: short_url, show_qr: true, qr_title: "Scan for tickets" %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_20rem] gap-6">
    <div class="space-y-6 min-w-0">
      <% if show.canceled && @listing.status != "canceled" && upcoming && @listing.ticket_orders.paid_like.exists? %>
        <%= render "shared/alert_panel",
              eyebrow: "Show canceled",
              headline: "This show is canceled on your calendar",
              body: "People still hold tickets for it. Cancel its ticket sales to refund them and let them know.",
              actions: [ { text: "Refund buyers", path: manage_cancel_show_form_path(@listing.production, show) } ] %>
      <% end %>
      <% if TicketShowChange.pending?(@listing) %>
        <% told = TicketShowChange.orders(@listing).count %>
        <%= render "shared/alert_panel",
              eyebrow: "The show changed",
              headline: "#{pluralize(told, 'buyer')} #{told == 1 ? 'was' : 'were'} told a different date, time or place",
              body: "It's now #{show.date_and_time.strftime('%A, %B %-d at %-l:%M %p')}. Nothing has gone out to them yet.",
              actions: [ { text: "Tell buyers", path: manage_ticket_listing_change_path(@listing) } ] %>
      <% end %>

      <%= render "shared/ticketing/show_numbers", stats: @stats %>

      <div id="guests" class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-200 flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-sm font-semibold text-gray-900">Guest list <span class="font-normal text-gray-500">· <%= pluralize(@stats.sold, "ticket") %></span></h2>
          <div class="flex flex-wrap gap-2">
            <%= render "shared/button", text: "Download (CSV)", variant: "secondary", size: "small", path: manage_ticket_listing_guests_path(@listing, format: :csv), data: { turbo: false } %>
            <%= render "shared/button", text: "Print door list", variant: "secondary", size: "small", path: manage_ticket_listing_door_list_path(@listing), target: "_blank", rel: "noopener" %>
          </div>
        </div>
        <%= form_with url: manage_ticket_listing_path(@listing, anchor: "guests"), method: :get, class: "px-5 py-3 border-b border-gray-100" do %>
          <%= hidden_field_tag :guests, @guest_filter unless @guest_filter == "all" %>
          <%= render "shared/filters/filter_bar", bare: true, filter_groups: [
            { label: "Find", partial: "shared/filters/search_input", locals: { placeholder: "Name, email or code", value: @query } },
            { separator: true },
            { label: "Show", filters: filters.map { |key, label| { text: label, path: filter_path.call(key), active: @guest_filter == key } } }
          ] %>
        <% end %>
        <%= render "shared/ticketing/guest_list", orders: @guest_orders %>
      </div>
    </div>

    <aside class="space-y-6">
      <%= render "shared/action_list", items: actions %>
      <% if live %>
        <%= render "manage/ticket_listings/outside_sales_modal", id: "outside-sales-modal", listing: @listing,
              sources: @outside_sources, lines: @outside_lines %>
      <% end %>

      <div class="bg-white rounded-lg border border-gray-200 p-5">
        <h3 class="font-semibold text-gray-900 mb-4">Money</h3>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between gap-4">
            <span class="text-gray-600">
              <% if @listing.status == "canceled" %>Going back to buyers<% elsif @listing.released_at %>In your available balance<% else %>Held for this show<% end %>
            </span>
            <span class="font-medium tabular-nums text-gray-900"><%= number_to_currency(@stats.net_cents / 100.0) %></span>
          </div>
          <% if @stats.tax_cents.positive? %>
            <div class="flex justify-between gap-4">
              <span class="text-gray-600">Tax collected, yours to pay</span>
              <span class="tabular-nums text-gray-900"><%= number_to_currency(@stats.tax_cents / 100.0) %></span>
            </div>
          <% end %>
        </div>
        <p class="text-xs text-gray-500 mt-3">
          <% if @listing.released_at %>
            The show happened, so it's yours to spend or withdraw.
          <% elsif @listing.status == "canceled" %>
            The show was canceled, so its money refunds its buyers.
          <% else %>
            It becomes yours to spend the day after the show.
          <% end %>
        </p>
        <div class="mt-4 pt-4 border-t border-gray-100 flex flex-wrap gap-x-4 gap-y-1 text-sm">
          <%= link_to "Show financials", manage_money_show_financials_path(show), class: "font-medium text-pink-600 hover:text-pink-700" %>
          <%= link_to "Your balance", manage_ticket_balance_path, class: "font-medium text-pink-600 hover:text-pink-700" %>
        </div>
      </div>
    </aside>
  </div>
</div>
