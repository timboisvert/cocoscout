<% content_for :title, "Payout: #{show_display_name(@show)} - #{@production.name}" %>

<%
  has_financials = @show_financials&.complete?
  # Per-act pay never reads revenue, so it can be worked out before ticket
  # numbers are in; every other method waits on complete financials.
  can_calculate = has_financials || @show_payout.act_based?
  has_line_items = @line_items&.any? || false
  is_calculated = @show_payout.calculated_at.present?
  # When the org has an automatic payout cadence, show the real next run date
  # instead of the generic "next payout run".
  next_payout_on = @production.organization.next_payout_date

  # Determine payout status with new terminology
  if @show_payout.paid?
    payout_status = :paid
    payout_label = "Paid"
    payout_class = "bg-pink-100 text-pink-700"
  elsif is_calculated
    payout_status = :awaiting_payout
    payout_label = "Awaiting Payout"
    payout_class = "bg-pink-100 text-pink-700"
  elsif can_calculate
    payout_status = :ready
    payout_label = "Ready to Calculate"
    payout_class = "bg-gray-100 text-gray-700"
  else
    payout_status = :awaiting_calculation
    payout_label = "Awaiting Calculation"
    payout_class = "bg-pink-100 text-pink-700"
  end

  # Check for missing cast (non-guest people in show who aren't in payout)
  non_guest_assignments = @show.show_person_role_assignments.where.not(assignable_id: nil)
  current_cast_ids = non_guest_assignments.pluck(:assignable_id).compact
  # Exclude individual allocations (e.g. producer/director percentages) — those payees
  # are paid via the payout calculation and are not expected to be in the show's cast.
  payout_payee_ids = @show_payout.line_items.where(payee_type: "Person").where(is_guest: false).where.not(is_individual_allocation: true).pluck(:payee_id)
  missing_cast_count = (current_cast_ids - payout_payee_ids).size
  has_missing_cast = is_calculated && missing_cast_count > 0

  # Check for stale cast (people in payout who are no longer in the show's cast)
  stale_cast_ids = payout_payee_ids - current_cast_ids
  stale_cast_count = stale_cast_ids.size
  has_stale_cast = is_calculated && stale_cast_count > 0

  # Check for guests in cast who aren't in payout yet
  guest_assignments = @show.show_person_role_assignments.where(assignable_id: nil).where.not(guest_name: nil)
  current_guest_names = guest_assignments.pluck(:guest_name).compact
  payout_guest_names = @show_payout.line_items.where(is_guest: true).pluck(:guest_name).compact
  missing_guests_count = (current_guest_names - payout_guest_names).size
  has_missing_guests = is_calculated && missing_guests_count > 0

  # Guests need to be promoted to a real payee (a Person who can connect a bank)
  # before they can be paid on a run — an unpaid guest always needs setup.
  guest_line_items = @show_payout.line_items.where(is_guest: true)
  guests_without_payment = guest_line_items.reject(&:paid?)
  has_guests_needing_payment = guests_without_payment.any?

  # Check for regular performers (non-guests) who can't be paid on a run yet
  # because they haven't connected a bank.
  regular_line_items = @show_payout.line_items.where(payee_type: "Person").where(is_guest: [false, nil])
  performers_without_payment = regular_line_items.reject(&:paid?).select { |li| li.payee && !li.auto_payout? }

  # Check for people with unpaid advances who haven't connected a bank
  show_advances_for_setup = @production.person_advances.for_show(@show).unpaid.includes(:person)
  people_with_advances_needing_setup = show_advances_for_setup.reject { |a| a.person.can_receive_payouts? }.map(&:person).uniq

  # Combine: performers from payout + people with unpaid advances, without duplication
  payout_people_ids = performers_without_payment.map { |li| li.payee&.id }.compact
  all_people_needing_payment_setup = performers_without_payment.map(&:payee).compact +
    people_with_advances_needing_setup.reject { |p| payout_people_ids.include?(p.id) }
  has_people_needing_payment = all_people_needing_payment_setup.any?

  # Get list of people in production for add person dropdown
  production_people = @production.effective_talent_pool&.people&.order(:name) || []

  # Page title: secondary_name if present, otherwise "[event type]: [full date] at [time]"
  page_title = @show.secondary_name.presence || "#{@show.event_type.titleize}: #{@show.date_and_time.strftime('%B %-d, %Y')} at #{@show.date_and_time.strftime('%-I:%M %p')}"
%>

<div class="w-full mb-10">
  <%= render partial: "shared/notice", locals: { notice: notice, alert: alert } %>
  <%= render partial: "shared/top_menu", locals: {
    breadcrumbs: [
      ["Money", manage_money_index_path],
      ["Payouts", manage_money_payouts_path],
      [@production.name, manage_money_production_payouts_path(@production)]
    ],
    text: page_title,
    links: []
  } %>

  <!-- Show Summary Row - uses same partial as money index -->
  <div class="mb-6">
    <%= render partial: "manage/payouts/money_show_row", locals: { show: @show, production: @production } %>
  </div>

  <% if @contract&.revenue_share? %>
    <!-- Revenue-share contractor payout — display only; settled on the contract -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-6">
        <%= render "manage/show_payouts/contractor_payout" %>
      </div>

      <!-- Sidebar -->
      <div class="space-y-4">
        <%= render "manage/show_payouts/contractor_payout_sidebar" %>
      </div>

    </div><%# close grid %>

  <% elsif @contract_payout %>
    <%= render "manage/show_payouts/contract_payments_payout" %>

  <% else %>
  <% line_items = @line_items || [] %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6"
       data-controller="payment-actions">

    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">

      <% if has_stale_cast || has_missing_guests %>
        <!-- Cast Has Changed Alert - needs recalculation -->
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <div class="flex gap-3">
            <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div class="flex-1">
              <p class="text-sm text-red-800 font-medium">
                Cast has changed since this payout was calculated
              </p>
              <p class="text-sm text-red-700 mt-1">
                <% if has_stale_cast && has_missing_guests %>
                  <%= stale_cast_count %> performer<%= stale_cast_count == 1 ? " is" : "s are" %> no longer in the cast, and <%= missing_guests_count %> guest<%= missing_guests_count == 1 ? " is" : "s are" %> missing from this payout.
                <% elsif has_stale_cast %>
                  <%= stale_cast_count %> performer<%= stale_cast_count == 1 ? " is" : "s are" %> no longer in the show's cast.
                <% else %>
                  <%= missing_guests_count %> guest<%= missing_guests_count == 1 ? " is" : "s are" %> missing from this payout.
                <% end %>
                Recalculate to update the payout.
              </p>
              <div class="mt-3">
                <%= render "shared/button",
                      text: "Recalculate Payout",
                      variant: "secondary",
                      size: "small",
                      icon: "arrow-path",
                      path: manage_calculate_money_show_payout_path(@show),
                      method: :post %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <% if has_missing_cast %>
        <!-- Missing Cast Alert -->
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
          <div class="flex gap-3">
            <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div class="flex-1">
              <p class="text-sm text-amber-800 font-medium">
                <%= missing_cast_count %> cast member<%= missing_cast_count == 1 ? " is" : "s are" %> not in this payout
              </p>
              <p class="text-sm text-amber-700 mt-1">
                The show's cast has changed since this payout was calculated. You can add the missing people now.
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                <button type="button"
                        data-action="click->payment-actions#showAddMissingCastModal"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium bg-amber-100 text-amber-800 hover:bg-amber-200 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                  </svg>
                  Add Missing Cast
                </button>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <% if has_guests_needing_payment %>
        <!-- Guests: set up as payees so we can pay them by bank -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
          <div class="flex gap-3 mb-3">
            <svg class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            <div class="flex-1">
              <p class="text-sm text-blue-800 font-medium">
                <%= guests_without_payment.size %> guest<%= guests_without_payment.size == 1 ? "" : "s" %> to pay
              </p>
              <p class="text-sm text-blue-700 mt-1">
                <% if Current.organization.offline_payout_method_choices.any? %>
                  For a one-off guest, pay them however you like and use “Mark paid another way” on their line below. Or, if you'll pay them again, add their email to set them up as a payee — they'll get a link to connect their bank so you can pay them on a payout run.
                <% else %>
                  Add each guest's email to set them up as a payee. They'll get a link to connect their bank, then you can add them to a payout run.
                <% end %>
              </p>
            </div>
          </div>
          <div class="space-y-2">
            <% guests_without_payment.each do |gli| %>
              <%= form_with url: manage_promote_guest_money_show_payout_path(@show), method: :post, class: "flex flex-wrap items-center gap-2" do %>
                <input type="hidden" name="line_item_id" value="<%= gli.id %>">
                <span class="text-sm font-medium text-gray-800 w-36 truncate"><%= gli.guest_name %></span>
                <input type="email" name="email" required placeholder="their@email.com"
                       class="flex-1 min-w-[180px] rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:border-pink-500 focus:ring-pink-500">
                <%= render "shared/button", text: "Set up to pay by bank", variant: "primary", size: "small", type: :submit %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if has_people_needing_payment %>
        <!-- Payment Setup Section (matches /manage/money/payouts style) -->
        <div class="bg-white rounded-lg border border-gray-200 p-5" data-controller="show-toggle qr-code" data-qr-code-url-value="<%= my_payments_setup_url %>">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h3 class="font-semibold text-gray-900">Payment Setup</h3>
              <p class="text-sm text-gray-500 mt-0.5">
                <%= all_people_needing_payment_setup.size %> <%= all_people_needing_payment_setup.size == 1 ? "person hasn't" : "people haven't" %> set up their payment info
              </p>
            </div>
            <div class="flex items-center gap-2">
              <%= render "shared/button", text: "QR Code", variant: "outline", size: "small", icon: "qr-code", data: { action: "click->qr-code#open" } %>
              <%= render "shared/button", text: "Send Reminders", variant: "primary", size: "small", icon: "paper-airplane", path: manage_send_payment_reminders_money_show_payout_path(@show), method: :post %>
            </div>
          </div>

          <button type="button" data-action="click->show-toggle#toggle" class="flex items-center gap-1 text-xs text-gray-500 hover:text-gray-700 cursor-pointer">
            <svg data-show-toggle-target="icon" class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Show names
          </button>
          <div data-show-toggle-target="content" class="hidden mt-3 pt-3 border-t border-gray-100">
            <div class="flex flex-wrap gap-1.5">
              <% all_people_needing_payment_setup.each do |person| %>
                <span class="inline-flex items-center px-2 py-0.5 bg-gray-100 text-gray-600 rounded text-xs">
                  <%= person.name %>
                </span>
              <% end %>
            </div>
          </div>

          <%# QR Code Modal %>
          <div data-qr-code-target="modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center" data-action="click->qr-code#closeOnBackdrop keydown.esc@window->qr-code#closeOnEscape">
            <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4" data-action="click->qr-code#stopPropagation">
              <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-900">Payment Setup QR Code</h3>
                <button type="button" data-action="click->qr-code#close" class="text-gray-400 hover:text-gray-600 cursor-pointer">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </button>
              </div>
              <div class="p-6 text-center">
                <p class="text-sm text-gray-600 mb-4">Show this QR code at your venue. When scanned, it takes performers to their payment setup page.</p>
                <div class="inline-block p-4 bg-white border-2 border-gray-200 rounded-lg">
                  <canvas data-qr-code-target="canvas" width="200" height="200"></canvas>
                </div>
                <p class="text-xs text-gray-500 mt-4"><%= my_payments_setup_url %></p>
                <button type="button" data-action="click->qr-code#download" class="mt-4 inline-flex items-center gap-1.5 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200 transition cursor-pointer">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                  </svg>
                  Download
                </button>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <% if @show.canceled? && !@show_payout.paid? %>
        <!-- Canceled Show Notice -->
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <div class="flex gap-3">
            <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/>
            </svg>
            <div>
              <p class="text-sm text-red-800 font-medium">This show was canceled</p>
              <p class="text-sm text-red-700 mt-1">You can still process payouts for this show. Choose how you'd like to handle compensation:</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <%= form_with url: manage_close_as_non_paying_money_show_payout_path(@show), method: :post, local: true do %>
                  <%= render "shared/button", text: "Close as Non-Paying", variant: "secondary", size: "small", type: :submit %>
                <% end %>
                <% if @show_payout.payout_scheme || @show_payout.has_overrides? %>
                  <%= form_with url: manage_calculate_money_show_payout_path(@show), method: :post, local: true do %>
                    <%= render "shared/button", text: "Pay as Originally Planned", variant: "secondary", size: "small", type: :submit %>
                  <% end %>
                <% end %>
                <% if @show_payout.payout_scheme || @production_scheme %>
                  <%= render "shared/button", text: "Set custom amounts", variant: "secondary", size: "small", type: :button,
                        data: { controller: "modal", action: "click->modal#open", modal_id: "customize-calculation" } %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <% unless has_financials %>
        <!-- Need Financial Data Notice -->
        <div class="bg-pink-50 border border-pink-200 rounded-lg p-4">
          <div class="flex gap-3">
            <svg class="w-5 h-5 text-pink-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <% if @show_financials&.has_data? %>
                <p class="text-sm text-pink-800 font-medium">Financial data needs confirmation</p>
                <p class="text-sm text-pink-700 mt-1">Review and confirm your financial data to calculate payouts.</p>
                <div class="mt-3">
                  <%= link_to manage_money_show_financials_path(@show) do %>
                    <%= render "shared/button", text: "View & Confirm Financials", variant: "primary", size: "small" %>
                  <% end %>
                </div>
              <% elsif @show_payout.act_based? %>
                <p class="text-sm text-pink-800 font-medium">Financial data not entered yet</p>
                <p class="text-sm text-pink-700 mt-1">Per-act pay doesn't need it to calculate, but ticket sales and revenue still feed this show's profit and loss.</p>
                <div class="mt-3">
                  <%= link_to manage_money_show_financials_path(@show) do %>
                    <%= render "shared/button", text: "Enter Financial Data", variant: "secondary", size: "small" %>
                  <% end %>
                </div>
              <% else %>
                <p class="text-sm text-pink-800 font-medium">Financial data needed</p>
                <p class="text-sm text-pink-700 mt-1">Enter ticket sales and revenue data to calculate payouts for this show.</p>
                <div class="mt-3">
                  <%= link_to manage_money_show_financials_path(@show) do %>
                    <%= render "shared/button", text: "Enter Financial Data", variant: "primary", size: "small" %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Payout calculation: what this show's pay is worked out from -->
      <%
        # The show's calculation is the production's, or one chosen for this
        # show — or there is none. Choosing a different one from the
        # production's is the only case with a way "back".
        card_scheme = @show_payout.payout_scheme || @production_scheme
        chosen_here = card_scheme.present? && @production_scheme.present? && card_scheme.id != @production_scheme.id
        customized = card_scheme.present? && @show_payout.has_overrides?
      %>
      <div class="bg-white rounded-lg border border-gray-200 p-5">
        <h3 class="font-semibold text-gray-900 mb-3">Payout calculation</h3>

        <% if card_scheme.nil? && !@production.pays_performers? %>
          <p class="text-sm text-gray-600 mb-3">
            Performer pay is off for <%= @production.name %> — nobody is paid for its shows.
            <%= link_to "Turn it on", manage_money_production_payouts_path(@production), class: "text-pink-500 hover:text-pink-600 font-medium" %>
            on the production's payouts page to choose a calculation.
          </p>
        <% elsif card_scheme.nil? %>
          <p class="text-sm text-gray-600 mb-3">This show doesn't have a payout calculation yet. Choose one and we'll work out what everyone is paid.</p>
          <% if @show_payout.can_edit? %>
            <%= render "shared/button", text: "Choose a calculation", variant: "primary", size: "small", type: :button,
                  data: { controller: "modal", action: "click->modal#open", modal_id: "choose-calculation" } %>
          <% end %>
        <% else %>
          <div class="flex flex-wrap items-center gap-2">
            <p class="text-base font-medium text-gray-900"><%= card_scheme.name %></p>
            <% if customized %>
              <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide leading-none bg-pink-500 text-white">Customized for this event</span>
            <% end %>
          </div>
          <p class="text-sm text-gray-500 mt-0.5"><%= card_scheme.rules_summary %></p>
          <% if customized %>
            <p class="text-sm text-pink-700 mt-1"><%= @show_payout.customization_summary %></p>
          <% end %>

          <% if @show_payout.can_edit? %>
            <div class="mt-3 flex flex-wrap gap-2">
              <% if customized %>
                <%= render "shared/button", text: "Edit customization", variant: "primary", size: "small", type: :button,
                      data: { controller: "modal", action: "click->modal#open", modal_id: "customize-calculation" } %>
                <%= form_with url: manage_clear_override_money_show_payout_path(@show), method: :delete, local: true, class: "inline" do %>
                  <%= render "shared/button", text: "Remove customization", variant: "secondary", size: "small", type: :submit %>
                <% end %>
              <% else %>
                <%= render "shared/button", text: "Customize for this event", variant: "primary", size: "small", type: :button,
                      data: { controller: "modal", action: "click->modal#open", modal_id: "customize-calculation" } %>
                <%= render "shared/button", text: "Choose a different calculation", variant: "secondary", size: "small", type: :button,
                      data: { controller: "modal", action: "click->modal#open", modal_id: "choose-calculation" } %>
              <% end %>
              <% if chosen_here && !customized %>
                <%= form_with url: manage_use_default_money_show_payout_path(@show), method: :patch, local: true, class: "inline" do %>
                  <%= render "shared/button", text: "Back to the production's calculation", variant: "ghost", size: "small", type: :submit %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>

      <% if @show_payout.can_edit? %>
        <%# The two modals the card opens: pick a calculation, or customize this event's. %>
        <% scope_fields = nil %>
        <% if @future_shows_count.to_i > 0 %>
          <% scope_fields = capture do %>
            <div class="mt-4 rounded-lg bg-gray-50 border border-gray-200 px-4 py-3">
              <p class="text-sm font-medium text-gray-900">
                <%= @future_shows_count == 1 ? "1 later show uses" : "#{@future_shows_count} later shows use" %> the same calculation as this one.
              </p>
              <div class="mt-2 space-y-2">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="apply_to_future" value="0" checked class="h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500">
                  <span class="text-sm text-gray-700">Just this show</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="apply_to_future" value="1" class="h-4 w-4 text-pink-600 border-gray-300 focus:ring-pink-500 accent-pink-500">
                  <span class="text-sm text-gray-700">This show and all <%= pluralize(@future_shows_count, "future show") %></span>
                </label>
              </div>
            </div>
          <% end %>
        <% end %>
        <%= render "manage/payout_calculations/picker_modal",
              id: "choose-calculation",
              url: manage_apply_choice_money_show_payout_path(@show),
              calculations: @available_schemes,
              current: card_scheme,
              intro: "This show pays whoever is cast on it by the calculation you pick.",
              hidden_fields: (@future_shows_count.to_i > 0 ? {} : { apply_to_future: "0" }),
              extra_fields: scope_fields,
              create_path: manage_money_payout_calculation_wizard_start_path(production_id: @production.id, return_to: manage_money_show_payout_path(@show)) %>
        <% if card_scheme %>
          <%= render "manage/show_payouts/customize_modal" %>
        <% end %>
      <% end %>

      <!-- Advances for This Show -->
      <% show_advances = @production.person_advances.for_show(@show).includes(:person).by_issued_at %>
      <% if show_advances.any? %>
        <%
          # Advances issued into a payout run are paid via that run — keep them
          # out of the old offline "Pay Advances" walkthrough.
          unpaid_advances = show_advances.unpaid.reject(&:in_payout_run?)
          paid_advances = show_advances.paid
          total_amount = show_advances.sum(:original_amount)
          unpaid_amount = unpaid_advances.sum(&:original_amount)
        %>
        <div class="bg-white rounded-lg border border-gray-200 p-5"
             data-controller="advance-payments"
             data-advance-payments-advances-value="<%= unpaid_advances.map { |a| { id: a.id, name: a.person.name, amount: a.original_amount } }.to_json %>">

          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-gray-900">Advances</h3>
            <span class="text-lg font-semibold text-pink-600">
              <%= number_to_currency(total_amount) %>
            </span>
          </div>

          <% if unpaid_advances.any? %>
            <!-- Pay Advances Button -->
            <div class="bg-pink-50 rounded-lg p-4 mb-4">
              <div class="flex items-center justify-between flex-wrap gap-3">
                <div class="text-sm text-gray-700">
                  <span class="font-semibold text-pink-600"><%= unpaid_advances.count %></span>
                  advance<%= unpaid_advances.count == 1 ? '' : 's' %> to pay
                  <span class="text-gray-500">•</span>
                  <span class="font-medium"><%= number_to_currency(unpaid_amount) %></span>
                </div>
                <%= render "shared/button",
                      text: "Pay Advances",
                      variant: "primary",
                      size: "small",
                      icon: "currency-dollar",
                      type: :button,
                      data: { action: "click->advance-payments#openModal" } %>
              </div>
            </div>
          <% elsif paid_advances.any? %>
            <!-- All Paid Banner -->
            <div class="bg-green-50 rounded-lg p-4 mb-4">
              <div class="flex items-center gap-2 text-green-700">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
                </svg>
                <span class="font-medium">All advances paid!</span>
              </div>
            </div>
          <% end %>

          <!-- Advance List (grouped by person) -->
          <%
            # Group advances by person
            advances_by_person = show_advances.group_by(&:person)
          %>
          <div class="space-y-2">
            <% advances_by_person.each do |person, person_advances| %>
              <% headshot_variant = person.safe_headshot_variant(:thumb) %>
              <% person_total = person_advances.sum(&:original_amount) %>
              <% all_paid = person_advances.all?(&:paid?) %>
              <% any_unpaid = person_advances.any?(&:unpaid?) %>

              <div class="rounded-lg <%= all_paid ? 'bg-gray-50' : 'bg-white border border-gray-200' %>">
                <%# Main person row %>
                <div class="flex items-center gap-3 p-3">
                  <% if headshot_variant %>
                    <%= image_tag headshot_variant, alt: person.name, class: "w-10 h-10 rounded-lg object-cover" %>
                  <% else %>
                    <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center text-pink-600 text-sm font-medium">
                      <%= person.initials %>
                    </div>
                  <% end %>

                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-gray-900"><%= person.name %></div>
                    <div class="text-xs flex items-center gap-1">
                      <% if person.can_receive_payouts? %>
                        <span class="inline-flex items-center gap-0.5 text-green-600">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                          </svg>
                          <span>Bank connected</span>
                        </span>
                      <% else %>
                        <span class="text-gray-400">(no bank connected)</span>
                      <% end %>
                    </div>
                  </div>

                  <% if person_advances.size == 1 %>
                    <%# Single advance - show amount and status on main row %>
                    <% advance = person_advances.first %>
                    <div class="text-right mr-2">
                      <div class="font-semibold text-gray-900"><%= number_to_currency(advance.original_amount) %></div>
                      <% if advance.paid? %>
                        <div class="text-xs text-green-600 flex items-center justify-end gap-1">
                          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                          </svg>
                          Paid via <%= advance.payment_method&.titleize %>
                        </div>
                      <% else %>
                        <div class="text-xs text-gray-500">Not yet paid</div>
                      <% end %>
                    </div>

                    <%# Delete button for single advance - only if unpaid %>
                    <% if advance.unpaid? %>
                      <% delete_advance_cid = "confirm-delete-advance-#{advance.id}" %>
                      <button type="button" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= delete_advance_cid %>" class="p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded transition-colors cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                      </button>
                      <%= render "shared/confirm_modal", id: delete_advance_cid, title: "Remove advance?",
                            message: "Remove this #{number_to_currency(advance.original_amount)} advance for #{person.name}?", confirm_text: "Remove",
                            url: manage_destroy_money_advance_path(@production, advance), method: :delete %>
                    <% end %>
                  <% else %>
                    <%# Multiple advances - show total on main row %>
                    <div class="text-right">
                      <div class="font-semibold text-gray-900"><%= number_to_currency(person_total) %></div>
                      <div class="text-xs text-gray-500"><%= person_advances.size %> advances</div>
                    </div>
                  <% end %>
                </div>

                <% if person_advances.size > 1 %>
                  <%# Multiple advances - show each one in a sub-list %>
                  <div class="border-t border-gray-100 px-3 pb-2 pt-1 ml-13 space-y-1">
                    <% person_advances.each do |advance| %>
                      <div class="flex items-center gap-2 py-1.5 pl-10">
                        <div class="flex-1 flex items-center gap-2">
                          <span class="text-sm font-medium text-gray-700"><%= number_to_currency(advance.original_amount) %></span>
                          <% if advance.paid? %>
                            <span class="inline-flex items-center gap-1 text-xs text-green-600">
                              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                              </svg>
                              Paid via <%= advance.payment_method&.titleize %>
                            </span>
                          <% else %>
                            <span class="text-xs text-gray-400">Not yet paid</span>
                          <% end %>
                          <% if advance.notes.present? %>
                            <span class="text-xs text-gray-400 italic"><%= advance.notes %></span>
                          <% end %>
                        </div>

                        <%# Delete button for each advance - only if unpaid %>
                        <% if advance.unpaid? %>
                          <% delete_advance_multi_cid = "confirm-delete-advance-multi-#{advance.id}" %>
                          <button type="button" data-controller="modal" data-action="click->modal#open" data-modal-id="<%= delete_advance_multi_cid %>" class="p-1 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded transition-colors cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                          </button>
                          <%= render "shared/confirm_modal", id: delete_advance_multi_cid, title: "Remove advance?",
                                message: "Remove this #{number_to_currency(advance.original_amount)} advance for #{person.name}?", confirm_text: "Remove",
                                url: manage_destroy_money_advance_path(@production, advance), method: :delete %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Pay Advances Modal (walkthrough style) -->
          <div data-advance-payments-target="modal"
               class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center"
               data-action="click->advance-payments#closeOnBackdrop">
          <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full mx-4 overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-white">Pay Advances</h3>
                <button type="button"
                        data-action="click->advance-payments#closeModal"
                        class="text-white/80 hover:text-white">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </button>
              </div>
              <!-- Progress -->
              <div class="mt-3 flex items-center gap-2">
                <div class="flex-1 h-1.5 bg-white/30 rounded-full overflow-hidden">
                  <div data-advance-payments-target="progressBar" class="h-full bg-white rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <span data-advance-payments-target="progressText" class="text-sm text-white/90">0 of <%= unpaid_advances.count %></span>
              </div>
            </div>

            <!-- Current Person Card -->
            <div class="p-6">
              <% unpaid_advances.each_with_index do |advance, idx| %>
                <div data-advance-payments-target="card"
                     data-advance-id="<%= advance.id %>"
                     class="<%= idx == 0 ? '' : 'hidden' %>">
                  <% headshot_variant = advance.person.safe_headshot_variant(:thumb) %>

                  <div class="flex items-center gap-4 mb-6">
                    <% if headshot_variant %>
                      <%= image_tag headshot_variant, alt: advance.person.name, class: "w-16 h-16 rounded-xl object-cover" %>
                    <% else %>
                      <div class="w-16 h-16 rounded-xl bg-pink-100 flex items-center justify-center text-pink-600 text-xl font-medium">
                        <%= advance.person.initials %>
                      </div>
                    <% end %>
                    <div>
                      <div class="text-xl font-semibold text-gray-900"><%= advance.person.name %></div>
                    </div>
                  </div>

                  <div class="text-center mb-6">
                    <div class="text-4xl font-bold text-pink-600"><%= number_to_currency(advance.original_amount) %></div>
                    <div class="text-gray-500 mt-1">Advance amount</div>
                  </div>

                  <div class="grid grid-cols-2 gap-2">
                    <% PersonAdvance::MANUAL_PAYMENT_METHODS.each do |method| %>
                      <%= form_with url: manage_mark_paid_money_advance_path(@production, advance), method: :post do %>
                        <input type="hidden" name="payment_method" value="<%= method %>">
                        <%= render "shared/button",
                              text: method.titleize,
                              variant: "secondary",
                              size: "small",
                              classes: "w-full",
                              type: :submit,
                              data: { action: "click->advance-payments#markPaid" } %>
                      <% end %>
                    <% end %>
                  </div>

                  <%= render "shared/button",
                        text: "Skip for now",
                        variant: "ghost",
                        size: "small",
                        classes: "w-full mt-3",
                        type: :button,
                        data: { action: "click->advance-payments#skipPerson" } %>
                </div>
              <% end %>

              <!-- Done State -->
              <div data-advance-payments-target="doneCard" class="hidden text-center py-8">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div class="text-xl font-semibold text-gray-900 mb-2">All done!</div>
                <p class="text-gray-500 mb-6">You've gone through all the advances.</p>
                <%= render "shared/button",
                      text: "Close",
                      variant: "primary",
                      size: "medium",
                      type: :button,
                      data: { action: "click->advance-payments#closeModal" } %>
              </div>
            </div>
          </div>
        </div>
        <%# End of bg-white card with advance-payments controller %>
      </div>
      <% end %>

      <%# Only show Payout Breakdown for past shows or if already calculated %>
      <% show_payout_breakdown = is_calculated || @show.date_and_time < Time.current %>
      <% if show_payout_breakdown %>
      <!-- Payout Breakdown -->
      <div class="bg-white rounded-lg border border-gray-200 p-5">
        <div class="flex items-center justify-between gap-3 mb-3">
          <h3 class="font-semibold text-gray-900">Payout Breakdown</h3>
          <% if @show_payout.act_based? && !@show_payout.paid? %>
            <%# Act pay: reopen the "How many acts?" modal to adjust a count and recalculate. %>
            <%= render "shared/button", text: "Adjust act counts", variant: "secondary", size: "small", type: :button,
                  data: { controller: "modal", action: "click->modal#open", modal_id: "payout-acts-modal" } %>
          <% end %>
        </div>
        <% if @show_payout.total_payout %>
          <%
            items = @line_items || []
            paid_amount = items.select(&:paid?).sum(&:net_amount)
            # The money for this show at a glance: what's queued in the payout run,
            # the full total, and what's already been paid.
            in_run_amount = items.select { |li| !li.paid? && li.in_payout_run? }.sum(&:net_amount)
            run = @show_payout.payout_run
            run_path = run ? manage_payout_batch_path(run) : manage_payout_batches_path
            stat_box = "flex-1 min-w-[140px] rounded-lg border p-4"
          %>
          <div class="flex flex-wrap gap-3 mb-4">
            <% if in_run_amount > 0 %>
              <%= link_to run_path, class: "#{stat_box} border-gray-200 bg-gray-50 hover:bg-gray-100 transition-colors" do %>
                <div class="text-2xl font-bold text-gray-900 tabular-nums"><%= number_to_currency(in_run_amount) %></div>
                <div class="text-sm text-gray-500 mt-1">In the payout run</div>
              <% end %>
            <% end %>
            <div class="<%= stat_box %> border-gray-200 bg-gray-50">
              <div class="text-2xl font-bold text-gray-900 tabular-nums"><%= number_to_currency(@show_payout.total_net_payout) %></div>
              <div class="text-sm text-gray-500 mt-1">Total payout</div>
            </div>
            <% if paid_amount > 0 %>
              <div class="<%= stat_box %> border-green-200 bg-green-50">
                <div class="text-2xl font-bold text-green-700 tabular-nums"><%= number_to_currency(paid_amount) %></div>
                <div class="text-sm text-green-600 mt-1">Already paid</div>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# Add these performer payouts to the open performer payout run. Gated on
            ADDABLE lines existing — not on "nothing added yet": a line that
            joined late (or was unchecked in the picker) must still be stageable
            after the rest of the show is already on a run. %>
        <%
          # EVERYONE payable-by-Stripe-someday gets added (same model as
          # staffing): bank-connected people are paid when the run pays;
          # no-bank people's money rides the funded run until they connect.
          run_candidates = if @show_payout.total_payout && has_line_items && !@show_payout.paid?
            (@line_items || []).select do |li|
              !li.paid? && !li.in_payout_run? && li.payee.present? &&
                li.payee.respond_to?(:can_receive_payouts?) && li.amount.to_f > 0
            end
          else
            []
          end
        %>
        <% if run_candidates.any? %>
          <div class="mb-4">
              <%
                run_ready = run_candidates.select { |li| li.payee.can_receive_payouts? }
                run_needs_bank = run_candidates.reject { |li| li.payee.can_receive_payouts? }
                run_total = run_candidates.sum(&:net_amount)
              %>
              <div data-controller="modal">
                <%= render "shared/button", text: "Add to payout run", variant: "primary", size: "small", type: :button,
                      data: { action: "click->modal#open", "modal-id": "add-to-run-modal" } %>
                <p class="text-xs text-gray-500 mt-1">Review who gets added, then pay everyone at once from your payout run — no need to leave this page.</p>

                <%# Preview / confirm modal (the "add to cart" step, before the run). %>
                <div id="add-to-run-modal" class="hidden fixed inset-0 z-50 overflow-y-auto">
                  <div class="flex min-h-full items-center justify-center p-4">
                    <div class="fixed inset-0 bg-gray-500/75" data-action="click->modal#close"></div>
                    <div class="relative bg-white rounded-xl shadow-xl w-full max-w-lg">
                      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-semibold text-gray-900">Add to payout run</h3>
                        <button type="button" data-action="click->modal#close" class="text-gray-400 hover:text-gray-600">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                      </div>
                      <%= form_with url: manage_add_to_run_money_show_payout_path(@show), method: :post, data: { controller: "run-picker" } do %>
                        <div class="px-6 py-4">
                          <p class="text-sm text-gray-600 mb-4">Checked people get added to your open performer payout run — funding covers all of them up front. Uncheck anyone you plan to pay another way; they stay owed on this show instead.</p>
                          <% if run_candidates.any? %>
                            <div class="divide-y divide-gray-100 border border-gray-200 rounded-lg mb-3">
                              <% run_candidates.each do |li| %>
                                <% bank_ready = run_ready.include?(li) %>
                                <label class="flex items-center justify-between gap-3 px-3 py-2 text-sm cursor-pointer hover:bg-gray-50">
                                  <span class="flex items-center gap-2 min-w-0">
                                    <%= check_box_tag "line_item_ids[]", li.id, true,
                                          id: "run-pick-#{li.id}",
                                          data: { "run-picker-target": "checkbox", action: "change->run-picker#recalc",
                                                  cents: (li.net_amount.to_d * 100).round, "bank-ready": bank_ready },
                                          class: "h-4 w-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500 accent-pink-500" %>
                                    <span class="text-gray-900 truncate"><%= li.payee_name %></span>
                                    <% if bank_ready %>
                                      <span class="inline-flex items-center rounded bg-green-100 px-1.5 py-0.5 text-[10px] font-medium text-green-700 flex-shrink-0">Bank ready</span>
                                    <% else %>
                                      <span class="inline-flex items-center rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-medium text-amber-700 flex-shrink-0">No bank yet</span>
                                    <% end %>
                                  </span>
                                  <span class="font-medium text-gray-900 tabular-nums flex-shrink-0"><%= number_to_currency(li.net_amount) %></span>
                                </label>
                              <% end %>
                            </div>
                            <div class="flex items-center justify-between text-sm font-semibold mb-3">
                              <span class="text-gray-700">Total to add</span>
                              <span class="text-gray-900 tabular-nums" data-run-picker-target="total"><%= number_to_currency(run_total) %></span>
                            </div>
                            <%# The acknowledgment line — what funding this run will actually commit. %>
                            <div class="rounded-lg bg-amber-50 border border-amber-200 px-3 py-2">
                              <p class="text-xs text-amber-800" data-run-picker-target="ack"></p>
                            </div>
                          <% else %>
                            <p class="text-sm text-gray-500 mb-4">No one here to add yet.</p>
                          <% end %>
                        </div>
                        <div class="flex items-center justify-end gap-2 px-6 py-4 border-t border-gray-200">
                          <button type="button" data-action="click->modal#close" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">Cancel</button>
                          <% if run_candidates.any? %>
                            <%= render "shared/button", text: "Add to run", variant: "primary", size: "small", type: :submit,
                                  classes: "disabled:opacity-50 disabled:cursor-not-allowed",
                                  data: { "run-picker-target": "submit" } %>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
          </div>
        <% end %>

        <%# Show stale calculation warning if there are outstanding advances not reflected %>
        <% if @show_payout.advance_deductions_stale? && !@show_payout.paid? %>
          <div class="bg-pink-50 border border-pink-200 rounded-lg p-3 mb-4">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-start gap-2">
                <svg class="w-5 h-5 text-pink-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <p class="text-sm font-medium text-pink-800">Outstanding advances not applied</p>
                  <p class="text-xs text-pink-700 mt-0.5">Some performers have paid advances that haven't been deducted from this payout.</p>
                </div>
              </div>
              <%= button_to manage_calculate_money_show_payout_path(@show),
                  method: :post,
                  class: "flex-shrink-0" do %>
                <%= render "shared/button", text: "Recalculate", variant: "primary", size: "small" %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if has_line_items %>
          <%# Phones: each payee stacks as a card (name, amount, calculation,
              status top-to-bottom). lg+: the classic four-column table. %>
          <div class="lg:overflow-x-auto">
            <%
              # Group line items by payee to consolidate multiple cuts (performer payout + individual allocation)
              grouped_payees = line_items.group_by do |item|
                if item.is_guest?
                  [:guest, item.guest_name]
                else
                  [item.payee_type, item.payee_id]
                end
              end.values
            %>
            <table class="block lg:table w-full">
              <thead class="hidden lg:table-header-group">
                <tr class="border-b border-gray-200">
                  <th class="text-left text-xs font-medium text-gray-500 uppercase tracking-wide py-2">Payee</th>
                  <th class="text-right text-xs font-medium text-gray-500 uppercase tracking-wide py-2">Amount</th>
                  <% if is_calculated || @show_payout.paid? %>
                    <th class="text-right text-xs font-medium text-gray-500 uppercase tracking-wide py-2">Status</th>
                  <% end %>
                </tr>
              </thead>
              <tbody class="block lg:table-row-group divide-y divide-gray-100">
                <% grouped_payees.each do |items| %>
                  <%
                    # Use first item for payee info, aggregate amounts from all items
                    item = items.first
                    total_amount = items.sum(&:amount)
                    total_net_amount = items.sum(&:net_amount)
                    total_advance_deduction = items.sum { |i| i.advance_deduction.to_f }
                    all_paid = items.all?(&:paid?)
                    any_pending = items.any?(&:payout_pending?)
                    any_failed = items.any?(&:payout_failed?)
                  %>
                  <tr class="flex flex-wrap items-start gap-x-3 py-3 lg:py-0 lg:table-row">
                    <td class="flex-1 min-w-0 lg:table-cell lg:py-3">
                      <div class="flex items-center gap-2">
                        <% if item.is_guest? %>
                          <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600 font-medium text-sm">
                            <%= item.guest_name[0].upcase rescue "?" %>
                          </div>
                        <% else %>
                          <% headshot_variant = item.payee.respond_to?(:safe_headshot_variant) ? item.payee.safe_headshot_variant(:thumb) : nil %>
                          <% if headshot_variant %>
                            <%= image_tag headshot_variant, alt: item.payee_name, class: "w-8 h-8 rounded-lg object-cover" %>
                          <% else %>
                            <div class="w-8 h-8 rounded-lg bg-pink-100 flex items-center justify-center text-pink-600 font-medium text-sm">
                              <%= item.payee_name[0].upcase %>
                            </div>
                          <% end %>
                        <% end %>
                        <div class="min-w-0">
                          <div class="font-medium text-gray-900 flex items-center gap-1.5 flex-wrap">
                            <span class="truncate"><%= item.payee_name %></span>
                            <% if !item.paid? && !item.is_guest? && !item.auto_payout? %>
                              <%# They haven't connected a bank yet — a QR they can scan
                                  to set it up, right by the name where you look first. %>
                                <span data-controller="qr-code" data-qr-code-url-value="<%= my_payments_setup_url %>" class="text-xs font-normal">
                                  <button type="button"
                                          data-action="click->qr-code#open"
                                          class="text-pink-500 hover:text-pink-600 underline cursor-pointer">(show payment QR)</button>
                                  <div data-qr-code-target="modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center" data-action="click->qr-code#closeOnBackdrop keydown.esc@window->qr-code#closeOnEscape">
                                    <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4" data-action="click->qr-code#stopPropagation">
                                      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
                                        <h3 class="text-lg font-semibold text-gray-900">Set up payment</h3>
                                        <button type="button" data-action="click->qr-code#close" class="text-gray-400 hover:text-gray-600 cursor-pointer">
                                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                        </button>
                                      </div>
                                      <div class="p-6 text-center">
                                        <p class="text-sm text-gray-600 mb-4">Have <span class="font-medium"><%= item.payee_name %></span> scan this with their phone camera to set up how they get paid — they'll connect a bank so payments land automatically.</p>
                                        <div class="inline-block p-4 bg-white border-2 border-gray-200 rounded-lg">
                                          <canvas data-qr-code-target="canvas" width="220" height="220"></canvas>
                                        </div>
                                        <p class="text-xs text-gray-500 mt-4">Or send them to <%= my_payments_setup_url %></p>
                                      </div>
                                    </div>
                                  </div>
                                </span>
                            <% end %>
                          </div>
                          <%# How the number was arrived at — secondary info, lives under the name. %>
                          <div class="text-xs text-gray-500">
                            <% items.each_with_index do |li, i| %><%= "; " if i.positive? %><%= li.calculation_explanation %><% if @show.act_based? && li.calculation_details.is_a?(Hash) && (li.calculation_details["inputs"] || {}).key?("acts") %> (from lineup)<% end %><% end %>
                          </div>
                          <%# Show advance information for this person %>
                          <% if item.payee_type == "Person" && @advances_by_person[item.payee_id]&.any? %>
                            <div class="mt-1 flex flex-wrap gap-1">
                              <% @advances_by_person[item.payee_id].each do |advance| %>
                                <% if advance.unpaid? %>
                                  <%= link_to manage_money_advance_path(advance.production, advance),
                                      class: "inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-medium bg-pink-100 text-pink-700 hover:bg-pink-200" do %>
                                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V7m0 1v8m0 0v1"/>
                                    </svg>
                                    Advance <%= number_to_currency(advance.original_amount) %> unpaid
                                  <% end %>
                                <% else %>
                                  <%= link_to manage_money_advance_path(advance.production, advance),
                                      class: "inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-medium bg-amber-100 text-amber-700 hover:bg-amber-200" do %>
                                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    −<%= number_to_currency(advance.remaining_balance) %> advance
                                  <% end %>
                                <% end %>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </td>
                    <td class="flex-shrink-0 text-right lg:table-cell lg:py-3">
                      <% if total_advance_deduction > 0 %>
                        <div class="text-right">
                          <span class="text-xs text-gray-400 line-through"><%= number_to_currency(total_amount) %></span>
                          <div class="font-semibold <%= all_paid ? 'text-green-700' : 'text-gray-900' %>"><%= number_to_currency(total_net_amount) %></div>
                          <span class="text-[10px] text-amber-600">−<%= number_to_currency(total_advance_deduction) %> advance repaid</span>
                        </div>
                      <% else %>
                        <span class="font-semibold <%= all_paid ? 'text-green-700' : 'text-gray-900' %>"><%= number_to_currency(total_amount) %></span>
                      <% end %>
                    </td>
                    <% if is_calculated || @show_payout.paid? %>
                      <td class="w-full mt-1 text-right lg:w-auto lg:mt-0 lg:table-cell lg:py-3 lg:text-right">
                        <% if all_paid %>
                          <%# One line: "Paid via Cash · Jul 31" (method + date only when known). %>
                          <div class="flex items-center justify-end gap-2">
                            <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700">
                              Paid<% if item.payment_method_label && item.payment_method_label != "Paid" %> via <%= item.payment_method_label %><% end %><% if item.paid_at %> · <%= item.paid_at.strftime("%b %-d") %><% end %>
                            </span>
                            <% unless @show_payout.paid? %>
                              <% items.each do |li| %>
                                <% unmark_li_cid = "confirm-unmark-li-#{li.id}" %>
                                <button type="button"
                                    data-controller="modal" data-action="click->modal#open" data-modal-id="<%= unmark_li_cid %>"
                                    class="text-gray-400 hover:text-gray-600 bg-transparent border-0 cursor-pointer"
                                    title="Unmark as paid">
                                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                  </svg>
                                </button>
                                <%= render "shared/confirm_modal", id: unmark_li_cid, title: "Unmark as paid?",
                                      message: "Unmark #{li.payee_name} as paid?", confirm_text: "Unmark",
                                      url: manage_unmark_line_item_paid_money_show_payout_path(@show, li), method: :delete %>
                              <% end %>
                            <% end %>
                          </div>
                        <% elsif any_pending %>
                          <div class="text-right" title="Being paid via <%= item.payment_method_label || 'payout run' %>.">
                            <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-700">
                              Processing
                            </span>
                          </div>
                        <% elsif any_failed %>
                          <div class="text-right">
                            <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700">
                              Failed
                            </span>
                            <% failed_item = items.find(&:payout_failed?) %>
                            <% if failed_item&.payout_error.present? %>
                              <div class="text-xs text-red-500 mt-0.5" title="<%= failed_item.payout_error %>">Error</div>
                            <% end %>
                          </div>
                        <% elsif total_net_amount <= 0 %>
                          <%# Calculated to nothing owed (a custom calculation, or fully offset by an
                              advance). No money moves — one click clears the line, no method needed. %>
                          <div class="text-right" title="This payout came out to nothing owed. Marking it done just clears the line — no payment is recorded.">
                            <%= button_to manage_mark_line_item_paid_money_show_payout_path(@show, items.map(&:id).join(",")),
                                  method: :post, class: "inline-block" do %>
                              <%= render "shared/button", text: "Mark done", variant: "primary", size: "small", type: :submit %>
                            <% end %>
                            <div class="text-xs text-gray-400 mt-0.5">nothing owed</div>
                          </div>
                        <% elsif item.settled_via_payout_run? %>
                          <%# Bank connected and their balance has been paid by a completed run. %>
                          <div class="text-right" title="Paid automatically on a payout run.">
                            <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700">Paid · payout run</span>
                          </div>
                        <% elsif !item.paid? && item.in_payout_run? %>
                          <%# Added to an open payout run — with or without a bank
                              connected. A no-bank payee's money rides the run and
                              pays out the moment they connect. %>
                          <%# Chip + ✕, mirroring the Paid row: the ✕ always undoes the chip
                              it sits next to (here: remove from the run). Confirm via modal. %>
                          <% item_bank_ready = item.payee.respond_to?(:can_receive_payouts?) && item.payee.can_receive_payouts? %>
                          <div class="text-right">
                          <div class="flex items-center justify-end gap-2" title="<%= item_bank_ready ? "Added to a payout run — pay the run to send this to their bank." : "On the payout run without a bank connected — the run holds their money and pays them the moment they connect." %>">
                            <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium bg-blue-100 text-blue-700">In payout run<% unless item_bank_ready %> · awaiting their bank<% end %></span>
                            <div data-controller="modal">
                              <button type="button"
                                      data-action="click->modal#open"
                                      data-modal-id="remove-from-run-modal-<%= item.id %>"
                                      class="text-gray-400 hover:text-gray-600 bg-transparent border-0 cursor-pointer align-middle"
                                      title="Remove from run">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                              </button>
                              <div id="remove-from-run-modal-<%= item.id %>" class="hidden fixed inset-0 z-50 overflow-y-auto">
                                <div class="flex min-h-full items-center justify-center p-4">
                                  <div class="fixed inset-0 bg-gray-500/75" data-action="click->modal#close"></div>
                                  <div class="relative bg-white rounded-xl shadow-xl w-full max-w-md text-left overflow-hidden">
                                    <%# Solid-pink header, matching the standard confirmation modal. %>
                                    <div class="flex items-center justify-between px-6 py-4 bg-pink-500">
                                      <h3 class="text-lg font-semibold text-white">Remove from payout run</h3>
                                      <button type="button" data-action="click->modal#close" class="text-white/70 hover:text-white cursor-pointer">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                      </button>
                                    </div>
                                    <div class="px-6 py-4">
                                      <p class="text-sm text-gray-600">Remove <span class="font-medium"><%= item.payee_name %></span> from the payout run for this show? They'll stay owed and can be added back to a run anytime — this only cancels the pending transfer.</p>
                                    </div>
                                    <div class="flex items-center justify-end gap-2 px-6 py-4 border-t border-gray-200">
                                      <button type="button" data-action="click->modal#close" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">Cancel</button>
                                      <%= button_to manage_remove_line_item_from_run_money_show_payout_path(@show, item), method: :delete, class: "inline-block" do %>
                                        <%= render "shared/button", text: "Remove from run", variant: "primary", size: "small", type: :submit %>
                                      <% end %>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                          <% if Current.organization.offline_payout_method_choices.any? %>
                            <%# Escape hatch, tucked right under the chip: hand-paying
                                them takes the line off the run — on a funded run the
                                freed money becomes credit toward the next funding debit.
                                Same label as the needs-setup branch, one vocabulary. %>
                            <div class="-mt-0.5">
                              <button type="button"
                                      data-action="click->payment-actions#showMarkPaidModal"
                                      data-item-id="<%= items.map(&:id).join(",") %>"
                                      data-item-name="<%= item.payee_name %>"
                                      data-item-amount="<%= number_to_currency(total_net_amount) %>"
                                      class="text-[11px] text-gray-400 hover:text-pink-600 underline cursor-pointer"
                                      title="Record an offline payment — this also takes them off the payout run; already-funded money becomes credit for your next run.">Mark paid another way</button>
                            </div>
                          <% end %>
                          </div>
                        <% elsif item.auto_payout? %>
                          <%# Bank connected but not yet added — adding to a run is a manual step. %>
                          <div class="text-right" title="This person connected a bank, so they're paid through a payout run. Use “Add to payout run” above to include them.">
                            <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-600">Bank connected</span>
                          </div>
                        <% else %>
                          <%# No connected bank — they can't be paid on a payout run. If
                              the org has declared offline methods in Money settings, a
                              manager can record that they were already paid another way
                              (cash/check/Zelle/Venmo/other): the payee shows as paid with
                              no money moving through CocoScout. Otherwise they stay owed
                              until they connect a bank. Guests (one-off performers with
                              no CocoScout account) get the same offline option — for
                              them it's usually the whole story, since we only set a
                              guest up as a real payee when there's an ongoing deal. %>
                          <div class="text-right" title="<%= item.is_guest? ? "Guests aren't set up to be paid through CocoScout. If you've paid them another way, you can record it." : "This person hasn't connected a bank, so they can't be paid on a payout run. If you've already paid them another way, you can record it." %>">
                            <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium bg-amber-100 text-amber-700"><%= item.is_guest? ? "Guest — unpaid" : "Needs payment setup" %></span>
                            <% if Current.organization.offline_payout_method_choices.any? %>
                              <div class="mt-0.5">
                                <button type="button"
                                        data-action="click->payment-actions#showMarkPaidModal"
                                        data-item-id="<%= items.map(&:id).join(",") %>"
                                        data-item-name="<%= item.payee_name %>"
                                        data-item-amount="<%= number_to_currency(total_net_amount) %>"
                                        class="text-xs text-gray-400 hover:text-pink-600 underline cursor-pointer">Mark paid another way</button>
                              </div>
                            <% else %>
                              <div class="text-xs text-gray-400 mt-0.5">not payable yet</div>
                            <% end %>
                          </div>
                        <% end %>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <%# ===== Individual "Mark paid another way" modal ==========================
              Mirrors the "Mark payment received" modal on incoming payments, just for
              a payout instead of a payment in: pink header, lined-up method radios
              (not a dropdown), date + reference. One shared form; the JS points its
              action at the right line item(s) and fills in the payee name + amount. %>
          <div data-payment-actions-target="markPaidModal"
               class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
               data-action="click->payment-actions#closeOnBackdrop">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden">
              <div class="flex items-center justify-between bg-gradient-to-r from-pink-500 to-pink-600 px-6 py-4">
                <h3 class="text-lg font-semibold text-white">Mark paid another way</h3>
                <button type="button" data-action="click->payment-actions#hideMarkPaidModal" class="rounded-full p-1 text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
              </div>
              <%# authenticity_token: the JS points this form's action at a per-line
                  URL after render, so the default per-form CSRF token (minted for
                  "#") would be rejected with a 422. Embed the global session token,
                  which is valid for any path. %>
              <%= form_with url: "#", method: :post, local: true, authenticity_token: form_authenticity_token,
                    data: { "payment-actions-target": "markPaidForm", turbo: false, controller: "require-choice" } do %>
                <div class="p-6 space-y-4">
                  <p class="text-sm text-gray-600">
                    Recording <strong data-payment-actions-target="markPaidAmount"></strong> paid to
                    <strong data-payment-actions-target="markPaidName"></strong> outside CocoScout. This marks
                    it paid — no money moves through CocoScout.
                  </p>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">How did you pay them?</label>
                    <div class="grid grid-cols-3 gap-2">
                      <% Current.organization.offline_payout_method_choices.each do |method| %>
                        <label class="block cursor-pointer">
                          <input type="radio" name="payment_method" value="<%= method %>" class="peer sr-only" data-action="change->require-choice#update">
                          <div class="text-center text-sm px-2 py-2 border rounded-lg bg-white border-gray-200 text-gray-700 hover:border-pink-400 peer-checked:border-pink-500 peer-checked:bg-pink-50 peer-checked:text-pink-700 peer-checked:font-medium transition-all">
                            <%= method.titleize %>
                          </div>
                        </label>
                      <% end %>
                    </div>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Date paid</label>
                    <%= date_field_tag :paid_date, Date.current,
                          class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Reference / note <span class="text-gray-400 font-normal">(optional)</span></label>
                    <%= text_field_tag :payment_notes, nil, placeholder: "e.g. Zelle confirmation #, paid at the till",
                          class: "block w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition" %>
                  </div>
                </div>
                <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
                  <%= render "shared/button", text: "Cancel", variant: "secondary", size: "medium", type: :button, data: { action: "click->payment-actions#hideMarkPaidModal" } %>
                  <%= render "shared/button", text: "Mark paid", variant: "primary", size: "medium", type: :submit, icon: "check-circle",
                        disabled: true, classes: "disabled:opacity-50 disabled:cursor-not-allowed",
                        data: { require_choice_target: "submit" } %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Bulk Mark Offline Modal -->
          <div data-payment-actions-target="bulkModal"
               class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center"
               data-action="click->payment-actions#closeOnBackdrop">
            <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 p-6">
              <h3 class="text-lg font-semibold text-gray-900 mb-4">Mark All as Paid</h3>
              <p class="text-sm text-gray-600 mb-4">This will mark all unpaid performers as paid via the selected method. Use this for historical records or when payments were made outside of CocoScout.</p>
              <%= form_with url: manage_mark_all_offline_money_show_payout_path(@show), method: :post, local: true do |f| %>
                <div class="mb-4">
                  <label class="block text-sm font-medium text-gray-700 mb-1">Payment Method</label>
                  <select name="payment_method" class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-pink-500 focus:ring-pink-500">
                    <option value="cash">Cash</option>
                    <option value="check">Check</option>
                    <option value="historical">Historical (pre-CocoScout)</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div class="mb-4">
                  <label class="block text-sm font-medium text-gray-700 mb-1">Notes (optional)</label>
                  <input type="text" name="payment_notes" class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-pink-500 focus:ring-pink-500" placeholder="e.g., Paid at venue after show">
                </div>
                <div class="flex items-center justify-end gap-3">
                  <%= render "shared/button", text: "Cancel", variant: "ghost", size: "medium", type: :button, data: { action: "click->payment-actions#hideBulkModal" } %>
                  <%= render "shared/button", text: "Mark All Paid", variant: "primary", size: "medium", type: :submit %>
                </div>
              <% end %>
            </div>
          </div>

        <% elsif can_calculate %>
          <%
            # Check if show has any performers assigned
            assignments = @show.show_person_role_assignments.includes(:assignable)
            show_performers = assignments.map(&:assignable).compact.uniq.select { |p| p.is_a?(Person) }
            has_cast = show_performers.any?
          %>
          <div class="text-center py-6">
            <% if has_cast %>
              <% if @show_payout.act_based? && @show_payout.counts_acts_from_lineup? %>
                <p class="text-gray-500 mb-3">This show pays by acts. Each person's act count comes straight from the lineup — adjust it only if the night went differently.</p>
              <% elsif @show_payout.act_based? %>
                <p class="text-gray-500 mb-3">This show pays by acts. We'll ask how many acts each person did, then work out what they're owed.</p>
              <% else %>
                <p class="text-gray-500 mb-3">Ready to calculate payouts based on the financial data.</p>
              <% end %>
              <div class="flex flex-wrap items-center justify-center gap-3">
                <%= form_with url: manage_calculate_money_show_payout_path(@show), method: :post, local: true do %>
                  <%= render "shared/button", text: "Calculate Payouts", variant: "primary", size: "medium", type: :submit %>
                <% end %>
                <% if @show_payout.act_based? %>
                  <%= render "shared/button", text: "Adjust act counts", variant: "secondary", size: "medium", type: :button,
                        data: { controller: "modal", action: "click->modal#open", modal_id: "payout-acts-modal" } %>
                <% end %>
              </div>
            <% else %>
              <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 text-left mb-4">
                <div class="flex gap-3">
                  <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <p class="text-sm text-amber-800 font-medium">No performers assigned</p>
                    <p class="text-sm text-amber-700 mt-1">This show has no cast members to pay. You can either:</p>
                    <ul class="text-sm text-amber-700 mt-2 ml-4 list-disc space-y-1">
                      <li><%= link_to "Add cast members", manage_show_path(@production, @show), class: "underline hover:text-amber-900" %> to this show</li>
                      <li>Close this show as non-paying (no payouts needed)</li>
                    </ul>
                  </div>
                </div>
              </div>
              <%= form_with url: manage_close_as_non_paying_money_show_payout_path(@show), method: :post, local: true do %>
                <%= render "shared/button", text: "Close as Non-Paying", variant: "secondary", size: "medium", type: :submit %>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-6">
            <p class="text-gray-500">Enter financial data first to calculate payouts.</p>
          </div>
        <% end %>
      </div>
      <% end %>

    </div>

    <!-- Sidebar -->
    <div class="space-y-4">

      <!-- Actions -->
      <div class="bg-white rounded-lg border border-gray-200 p-5">
        <h3 class="font-semibold text-gray-900 mb-4">Actions</h3>
        <div class="space-y-3">
          <% if @show_payout.paid? %>
            <div class="flex items-center gap-3 p-3 bg-pink-50 rounded-lg">
              <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-pink-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="flex-1">
                <div class="font-medium text-pink-600">All Paid</div>
              </div>
            </div>

            <%# Reopen and Add Person options for paid payouts %>
            <% reopen_payout_cid = "confirm-reopen-payout-#{@show.id}" %>
            <button type="button"
                    data-controller="modal" data-action="click->modal#open" data-modal-id="<%= reopen_payout_cid %>"
                    class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors w-full text-left cursor-pointer">
              <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/>
                </svg>
              </div>
              <div class="flex-1">
                <div class="font-medium text-gray-900">Reopen Payout</div>
                <div class="text-xs text-gray-500">Add more people or make changes</div>
              </div>
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
            <%= render "shared/confirm_modal", id: reopen_payout_cid, title: "Reopen payout?",
                  message: "Reopen this payout? You'll be able to add more people or make changes.", confirm_text: "Reopen",
                  url: manage_reopen_money_show_payout_path(@show), method: :post %>

            <button type="button"
                    data-action="click->payment-actions#showAddPersonModal"
                    class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors w-full text-left cursor-pointer">
              <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                </svg>
              </div>
              <div class="flex-1">
                <div class="font-medium text-gray-900">Add Person</div>
                <div class="text-xs text-gray-500">Add someone who was missed</div>
              </div>
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          <% elsif is_calculated %>
            <%# Awaiting Payout - has been calculated %>
            <button type="button"
                    data-action="click->payment-actions#showBulkModal"
                    class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors w-full text-left cursor-pointer">
              <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div class="flex-1">
                <div class="font-medium text-gray-900">Mark All Paid</div>
                <div class="text-xs text-gray-500">Record payments as complete</div>
              </div>
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>

            <%= form_with url: manage_calculate_money_show_payout_path(@show), method: :post, local: true, class: "block" do %>
              <button type="submit"
                      class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors w-full text-left cursor-pointer">
                <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="font-medium text-gray-900">Recalculate</div>
                  <div class="text-xs text-gray-500">Update payout amounts</div>
                </div>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            <% end %>

            <%# Reset Calculation - for future shows where calculation was accidental %>
            <% if @show.date_and_time >= Time.current %>
              <% reset_calc_cid = "confirm-reset-calculation-#{@show.id}" %>
              <button type="button"
                      data-controller="modal" data-action="click->modal#open" data-modal-id="<%= reset_calc_cid %>"
                      class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors w-full text-left cursor-pointer">
                <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="font-medium text-gray-900">Reset Calculation</div>
                  <div class="text-xs text-gray-500">Clear line items, keep advances</div>
                </div>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
              <%= render "shared/confirm_modal", id: reset_calc_cid, title: "Reset calculation?",
                    message: "Are you sure? This will delete all payout line items and reset the calculation. Advances will not be affected.", confirm_text: "Reset",
                    url: manage_reset_calculation_money_show_payout_path(@show), method: :delete %>
            <% end %>

            <button type="button"
                    data-action="click->payment-actions#showAddPersonModal"
                    class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors w-full text-left cursor-pointer">
              <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                </svg>
              </div>
              <div class="flex-1">
                <div class="font-medium text-gray-900">Add Person</div>
                <div class="text-xs text-gray-500">Add someone not in the calculation</div>
              </div>
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>

            <%# Issue Advances - only for future shows %>
            <% if @show.date_and_time >= Time.current %>
              <button type="button"
                      data-action="click->payment-actions#showIssueAdvancesModal"
                      class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors w-full text-left cursor-pointer">
                <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="font-medium text-gray-900">Issue Advances</div>
                  <div class="text-xs text-gray-500">Give pre-show payments to cast</div>
                </div>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            <% end %>
          <% elsif can_calculate %>
            <%# Ready to calculate %>
            <%= form_with url: manage_calculate_money_show_payout_path(@show), method: :post, local: true, class: "block" do %>
              <button type="submit"
                      class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors w-full text-left cursor-pointer">
                <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="font-medium text-gray-900">Calculate Payouts</div>
                  <div class="text-xs text-gray-500">Generate payout amounts from financials</div>
                </div>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            <% end %>

            <%# Issue Advances - for future shows %>
            <% if @show.date_and_time >= Time.current %>
              <button type="button"
                      data-action="click->payment-actions#showIssueAdvancesModal"
                      class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors w-full text-left cursor-pointer">
                <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="font-medium text-gray-900">Issue Advances</div>
                  <div class="text-xs text-gray-500">Give pre-show payments to cast</div>
                </div>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            <% end %>
          <% else %>
            <%# Awaiting calculation - needs financial data %>
            <%= link_to manage_money_show_financials_path(@show), class: "flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors" do %>
              <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
              </div>
              <div class="flex-1">
                <div class="font-medium text-gray-900">Enter Financials</div>
                <div class="text-xs text-gray-500">Add financial data to calculate payouts</div>
              </div>
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            <% end %>

            <%# Issue Advances - for future shows %>
            <% if @show.date_and_time >= Time.current %>
              <button type="button"
                      data-action="click->payment-actions#showIssueAdvancesModal"
                      class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors w-full text-left cursor-pointer">
                <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="font-medium text-gray-900">Issue Advances</div>
                  <div class="text-xs text-gray-500">Give pre-show payments to cast</div>
                </div>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            <% end %>
          <% end %>
        </div>
      </div>

    </div>

    <!-- Add Person Modal (always available) -->
    <div data-payment-actions-target="addPersonModal"
         class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center"
         data-action="click->payment-actions#closeOnBackdrop">
      <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Add Person to Payout</h3>
        <p class="text-sm text-gray-600 mb-4">Add someone who was missed from the original calculation. This will <%= @show_payout.paid? ? "reopen the payout" : "add them to the payout" %>.</p>
        <%= form_with url: manage_add_line_item_money_show_payout_path(@show), method: :post, local: true do |f| %>
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Person</label>
            <select name="payee_id" required class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-pink-500 focus:ring-pink-500">
              <option value="">Select a person...</option>
              <% production_people.each do |person| %>
                <% unless payout_payee_ids.include?(person.id) %>
                  <option value="<%= person.id %>"><%= person.name %></option>
                <% end %>
              <% end %>
            </select>
            <input type="hidden" name="payee_type" value="Person">
          </div>
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Amount</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">$</span>
              <input type="number" name="amount" step="0.01" min="0" value="0" required
                     class="w-full rounded-lg border border-gray-300 pl-7 pr-3 py-2 focus:border-pink-500 focus:ring-pink-500">
            </div>
            <p class="text-xs text-gray-500 mt-1">Enter the payout amount for this person</p>
          </div>
          <div class="flex items-center justify-end gap-3">
            <%= render "shared/button", text: "Cancel", variant: "ghost", size: "medium", type: :button, data: { action: "click->payment-actions#hideAddPersonModal" } %>
            <%= render "shared/button", text: "Add to Payout", variant: "primary", size: "medium", type: :submit %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Add Missing Cast Modal (always available) -->
    <% if missing_cast_count > 0 %>
      <div data-payment-actions-target="addMissingCastModal"
           class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center"
           data-action="click->payment-actions#closeOnBackdrop">
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Add Missing Cast</h3>
          <p class="text-sm text-gray-600 mb-4">
            <%= missing_cast_count %> cast member<%= missing_cast_count == 1 ? " is" : "s are" %> in this show's cast but not in the payout.
            <% if @show_payout.paid? %>This will reopen the payout.<% end %>
          </p>
          <%= form_with url: manage_add_missing_cast_money_show_payout_path(@show), method: :post, local: true do |f| %>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">Amount per person</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">$</span>
                <input type="number" name="amount" step="0.01" min="0" value="0" required
                       class="w-full rounded-lg border border-gray-300 pl-7 pr-3 py-2 focus:border-pink-500 focus:ring-pink-500">
              </div>
              <p class="text-xs text-gray-500 mt-1">Enter the payout amount for each missing person</p>
            </div>
            <div class="flex items-center justify-end gap-3">
              <%= render "shared/button", text: "Cancel", variant: "ghost", size: "medium", type: :button, data: { action: "click->payment-actions#hideAddMissingCastModal" } %>
              <%= render "shared/button", text: "Add #{missing_cast_count} #{missing_cast_count == 1 ? 'Person' : 'People'}", variant: "primary", size: "medium", type: :submit %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Issue Advances Modal %>
    <%
      # Get cast members for advances modal
      cast_assignments = @show.show_person_role_assignments.includes(:assignable).where(assignable_type: "Person")
      advance_cast_members = cast_assignments.map(&:assignable).compact.uniq

      # Get existing advances for these cast members for this show (grouped by person_id)
      # A person can have multiple advances, so we group them into arrays
      existing_show_advances = @production.person_advances
        .for_show(@show)
        .not_settled
        .where(person_id: advance_cast_members.map(&:id))
        .group_by(&:person_id)
    %>
    <%= render "manage/show_payouts/issue_advances_modal",
               show: @show,
               cast_members: advance_cast_members,
               existing_advances: existing_show_advances %>

    <%# "How many acts?" — act-based calculations can't calculate without the counts,
        so calculate bounces back here with this modal open. %>
    <% if @show_payout.act_based? %>
      <%= render "manage/show_payouts/acts_modal" %>
    <% end %>

  </div>
  <% end %><%# end of third_party vs performer conditional %>
</div>

