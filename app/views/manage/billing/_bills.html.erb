<%# The bills CocoScout sent and the monthly statements. locals: organization %>
<% bills = organization.billing_invoices.newest_first.limit(12) %>
<% statements = organization.org_statements.newest_first.limit(12) %>
<% if bills.any? || statements.any? %>
  <div class="mt-8 border-t border-gray-200 pt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div>
      <h4 class="text-base font-semibold text-gray-900">Bills</h4>
      <p class="text-sm text-gray-500 mt-1">What CocoScout charged your card or bank, and whether it went through.</p>
      <% if bills.empty? %>
        <p class="mt-3 text-sm text-gray-500">No bills yet.</p>
      <% else %>
        <ul class="mt-3 divide-y divide-gray-100 border border-gray-200 rounded-lg text-sm">
          <% bills.each do |bill| %>
            <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-2.5">
              <span class="text-gray-900"><%= bill.label %><%= " · #{bill.period_start.strftime('%B %Y')}" if bill.period_start %>
                <% if bill.hosted_invoice_url %><%= link_to "View", bill.hosted_invoice_url, target: "_blank", rel: "noopener", class: "ml-1 text-xs text-pink-600 hover:underline" %><% end %>
              </span>
              <span class="tabular-nums <%= bill.failed? ? 'text-red-600 font-medium' : 'text-gray-700' %>">
                <%= number_to_currency(bill.amount_due_cents / 100.0) %> · <%= bill.status_label %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <div>
      <h4 class="text-base font-semibold text-gray-900">Monthly statements</h4>
      <p class="text-sm text-gray-500 mt-1">Everything you paid CocoScout each month, ticket and course fees included, and what happened to your CocoScout balance.</p>
      <% if statements.empty? %>
        <p class="mt-3 text-sm text-gray-500">Your first statement arrives on the 1st.</p>
      <% else %>
        <ul class="mt-3 divide-y divide-gray-100 border border-gray-200 rounded-lg text-sm">
          <% statements.each do |statement| %>
            <li class="flex items-center justify-between gap-4 px-4 py-2.5">
              <span class="text-gray-900"><%= statement.label %></span>
              <span class="flex items-center gap-3">
                <span class="tabular-nums text-gray-700"><%= number_to_currency(statement.total_paid_cents / 100.0) %> paid</span>
                <% if statement.pdf.attached? %><%= link_to "PDF", manage_billing_statement_path(statement), target: "_blank", rel: "noopener", class: "text-xs text-pink-600 hover:underline" %><% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
<% end %>
